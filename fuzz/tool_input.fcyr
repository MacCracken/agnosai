# =========================================================================
# tool_input.fcyr — fuzz_tool_input.rs
#
# Oracle: rust-old/fuzz/fuzz_targets/fuzz_tool_input.rs
#
# Run with `cyrius fuzz` (discovers both fuzz/*.fcyr and tests/*.fcyr).
#
# ⚠ **`tests/agnosai.fcyr` — the harness `cyrius port` scaffolded on 2026-07-28 —
# had a `fuzz_main` that returned 0 without touching its input, and
# `cyrius fuzz` had been reporting `1 passed` for it ever since.** These four
# files are what it was a placeholder for.
#
# ## The shape
#
# `fuzz_main(data, len)` mirrors libfuzzer's `fuzz_target!(|data: &[u8]|)`. The
# oracle's body is one line — hand the bytes to a parser and **discard the
# result**; it asserts nothing about what comes back. The property is *no panic*,
# so a harness that reaches its final `syscall(60, 0)` has passed.
#
# `cyrius fuzz` does not generate input, so the corpus is generated here and is
# **deterministic on purpose**: a fuzz failure CI cannot reproduce is a failure
# nobody fixes. The two generators are the ones that actually break parsers —
# a truncation sweep (every prefix of a valid document, which walks every length
# check and look-ahead straight off its boundary) and a byte-substitution sweep
# (each offset x NUL, quote, backslash, brace, bracket, 0xFF).
#
# ⚠ **0xFF cannot reach the oracle.** libfuzzer's harness guards with
# `if let Ok(s) = std::str::from_utf8(data)`, so the Rust targets only ever see
# valid UTF-8. A Cyrius `Str` is bytes and `bayan_json_v_parse_buf` takes
# (ptr, len), so invalid UTF-8 reaches the parser here.
#
# ⚠ The pristine seed is re-parsed at the end. A parser can survive malformed
# input by leaving a scratch buffer or a global error slot in a state that breaks
# the NEXT caller, and that never shows up as a crash during the sweep.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/strcase.cyr"
include "src/telemetry/mod.cyr"
include "src/core/mod.cyr"
include "src/llm/retry.cyr"
include "src/llm/hoosh.cyr"
include "src/tools/native.cyr"

# The six substitution bytes: NUL (a C terminator that is legal mid-buffer),
# quote (opens/closes a string mid-token), backslash (starts an escape, possibly
# at the last byte), brace (opens a container with no closer), bracket (closes
# one never opened), 0xFF (never valid UTF-8).
fn _f_sub_byte(i): i64 {
    if (i == 0) { return 0; }
    if (i == 1) { return 34; }
    if (i == 2) { return 92; }
    if (i == 3) { return 123; }
    if (i == 4) { return 93; }
    return 255;
}

# The oracle's `fuzz_target!` body: parse, discard, never assert.
fn fuzz_main(data, len): i64 {
    # `let _ = serde_json::from_str::<ToolInput>(s);` — a parse plus the
    # value-to-input step, which is where the oracle's Deserialize lands.
    var v = bayan_json_v_parse_buf(data, len);
    if (v == 0) { return 0; }
    if (agnosai_tool_input_from_value(v) != 0) { return 1; }
    return 0;
}

# Every prefix of the seed, including the empty one.
fn _f_truncation_sweep(seed: Str): i64 {
    var data = str_data(seed);
    var len = str_len(seed);
    for (var cut = 0; cut <= len; cut = cut + 1) { fuzz_main(data, cut); }
    return len + 1;
}

# Every (offset, substitution) pair over a copy, restoring each byte after so the
# mutations stay one at a time rather than accumulating into noise.
fn _f_substitution_sweep(seed: Str): i64 {
    var len = str_len(seed);
    var buf = alloc(len + 1);
    var src = str_data(seed);
    for (var i = 0; i < len; i = i + 1) { store8(buf + i, load8(src + i)); }
    for (var off = 0; off < len; off = off + 1) {
        var original = load8(buf + off);
        for (var s = 0; s < 6; s = s + 1) {
            store8(buf + off, _f_sub_byte(s));
            fuzz_main(buf, len);
        }
        store8(buf + off, original);
    }
    return len * 6;
}

# The shapes that kill JSON parsers specifically, seed-independent.
#
# Nesting is capped at 64: `bayan_json_v_parse_buf` recurses on containers, so an
# unbounded depth would be testing the process stack rather than the parser, and
# a stack overflow is a finding about the INPUT LIMIT — which belongs to whatever
# accepts bytes off the wire, not here.
fn _f_adversarial(): i64 {
    var cases = vec_new();
    vec_push(cases, str_from(""));
    vec_push(cases, str_from(" "));
    vec_push(cases, str_from("\n\t\r "));
    vec_push(cases, str_from("null"));
    vec_push(cases, str_from("[]"));
    vec_push(cases, str_from("{}"));
    vec_push(cases, str_from("\""));
    vec_push(cases, str_from("\"unterminated"));
    vec_push(cases, str_from("{\"a\":"));
    vec_push(cases, str_from("{\"a\":}"));
    vec_push(cases, str_from("[1,2,"));
    vec_push(cases, str_from("{,}"));
    vec_push(cases, str_from("1e999999"));
    vec_push(cases, str_from("-0"));
    vec_push(cases, str_from("9223372036854775808"));
    vec_push(cases, str_from("-9223372036854775809"));
    vec_push(cases, str_from("\"\\u\""));
    vec_push(cases, str_from("\"\\uD800\""));
    vec_push(cases, str_from("{\"a\":1,\"a\":2}"));
    vec_push(cases, str_from("[[[[[[[[[[]]]]]]]]]]"));

    var deep = str_builder_new();
    for (var d = 0; d < 64; d = d + 1) { str_builder_add_cstr(deep, "["); }
    for (var e = 0; e < 64; e = e + 1) { str_builder_add_cstr(deep, "]"); }
    vec_push(cases, str_builder_build(deep));

    var open = str_builder_new();
    for (var o = 0; o < 64; o = o + 1) { str_builder_add_cstr(open, "{\"a\":"); }
    vec_push(cases, str_builder_build(open));

    for (var i = 0; i < vec_len(cases); i = i + 1) {
        var c = vec_get(cases, i);
        fuzz_main(str_data(c), str_len(c));
    }

    # A NUL mid-document: legal in a (ptr, len) buffer, fatal to anything that
    # reaches for strlen.
    var nul = alloc(16);
    store8(nul + 0, 123); store8(nul + 1, 34); store8(nul + 2, 97);
    store8(nul + 3, 0);   store8(nul + 4, 34); store8(nul + 5, 58);
    store8(nul + 6, 49);  store8(nul + 7, 125);
    fuzz_main(nul, 8);

    return vec_len(cases) + 1;
}

# A tool input parameter map.
fn _f_seed(): Str {
    return str_from("{\"name\":\"world\",\"count\":3,\"deep\":{\"a\":[1,2,{\"b\":null}]}}");
}

fn main(): i64 {
    alloc_init();
    var seed = _f_seed();

    # The seed must parse, or every sweep below is exercising a broken document
    # rather than a broken parser.
    if (fuzz_main(str_data(seed), str_len(seed)) != 1) { return 1; }

    var t = _f_truncation_sweep(seed);
    var s = _f_substitution_sweep(seed);
    var a = _f_adversarial();
    if (t != str_len(seed) + 1) { return 2; }
    if (s != str_len(seed) * 6) { return 3; }
    if (a != 23) { return 4; }

    # No corrupted shared state.
    if (fuzz_main(str_data(seed), str_len(seed)) != 1) { return 5; }

    var msg = str_builder_new();
    str_builder_add_cstr(msg, "tool_input: ");
    str_builder_add_int(msg, t + s + a);
    str_builder_add_cstr(msg, " inputs, no faults");
    println_str(str_builder_build(msg));
    return 0;
}

var _f_rc = main();
syscall(60, _f_rc);
