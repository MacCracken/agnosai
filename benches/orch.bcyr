# The prompt guard's scan: 31 anchored-anywhere patterns, each a sliding
# case-blind window. The worst case is CLEAN input, which tries all 31 and
# matches none — and every user-supplied field pays it on every task.
fn _b_prompt_scan_clean(): i64 {
    var n = 50000;
    var text = str_from("Summarize the quarterly revenue report and highlight any anomalies.");

    var b = bench_new("prompt_scan_clean_67b");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_prompt_scan_input(text); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# The same over a 4 KB field, which is where the O(len x patterns) window scan
# starts to show.
fn _b_prompt_scan_4k(): i64 {
    var n = 2000;
    var sb = str_builder_new();
    for (var f = 0; f < 64; f = f + 1) {
        str_builder_add_cstr(sb, "the quick brown fox jumps over the lazy dog. ");
    }
    var text = str_builder_build(sb);

    var b = bench_new("prompt_scan_clean_4k");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_prompt_scan_input(text); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# The audit chain's record path: a uuid, a JSON build, a SHA-256 and an
# HMAC-SHA256 per entry. Every sequential task pays one.
fn _b_audit_record(): i64 {
    var n = 20000;
    var chain = agnosai_audit_chain_new();
    var event = str_from("task_completed");
    var level = str_from("info");
    var msg = str_from("summarize the quarterly revenue report");

    var b = bench_new("audit_record");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_audit_record(chain, event, level, msg, 0, 0, 0); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# Verifying a full 256-entry chain — the operation an auditor runs, which
# re-hashes and re-signs every entry.
fn _b_audit_verify(): i64 {
    var n = 200;
    var chain = agnosai_audit_chain_with_key(alloc(AGNOSAI_AUDIT_KEY_BYTES), 256);
    for (var f = 0; f < 256; f = f + 1) {
        agnosai_audit_record(chain, str_from("task_completed"), str_from("info"),
        str_from("done"), 0, 0, 0);
    }

    var b = bench_new("audit_verify_256");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_audit_verify(chain); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

