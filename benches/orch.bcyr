# An agent with two tools, a complexity and a domain — the shape scoring reads.
fn _b_agent(key: Str): i64 {
    var a = agnosai_agent_new(key, str_from("worker"), str_from("do work"));
    agnosai_agent_with_complexity(a, str_from("medium"));
    agnosai_agent_with_domain(a, str_from("quality"));
    var tools = vec_new();
    vec_push(tools, str_from("lint"));
    vec_push(tools, str_from("test"));
    agnosai_agent_with_tools(a, tools);
    return a;
}

# A task whose context exercises all three scoring signals.
fn _b_task(): i64 {
    var t = agnosai_task_new(str_from("review the changed files and report defects"));
    var required = bayan_json_v_arr_new();
    bayan_json_v_arr_push(required, bayan_json_v_str_new(str_from("lint")));
    bayan_json_v_arr_push(required, bayan_json_v_str_new(str_from("test")));
    agnosai_task_with_context(t, str_from("required_tools"), required);
    agnosai_task_with_context(t, str_from("complexity"), bayan_json_v_str_new(str_from("medium")));
    agnosai_task_with_context(t, str_from("domain"), bayan_json_v_str_new(str_from("quality")));
    return t;
}

# `n` agents with distinct keys.
fn _b_agents(n): i64 {
    var v = vec_new();
    for (var i = 0; i < n; i = i + 1) {
        vec_push(v, _b_agent(str_cat(str_from("agent-"), str_from_int(i))));
    }
    return v;
}

# `n` tasks.
fn _b_tasks(n): i64 {
    var v = vec_new();
    for (var i = 0; i < n; i = i + 1) { vec_push(v, _b_task()); }
    return v;
}

# One event send with a single reader keeping pace — the steady state when an
# SSE client is connected and consuming.
fn _b_event_round_trip(): i64 {
    var n = 200000;
    var bus = agnosai_event_bus_new();
    var tx = agnosai_event_bus_sender(bus, agnosai_uuid_v4_str());
    var rx = agnosai_event_sender_subscribe(tx);
    var ev = agnosai_crew_event_new(str_from("crew"), str_from("task_started"),
    bayan_json_v_null());

    var b = bench_new("event_round_trip_1_sub");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_event_sender_send(tx, ev);
        agnosai_event_sub_try_recv(rx);
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# The same, fanned out to 64 subscribers each of which reads.
fn _b_event_fanout_64(): i64 {
    var n = 5000;
    var bus = agnosai_event_bus_new();
    var tx = agnosai_event_bus_sender(bus, agnosai_uuid_v4_str());
    var subs = vec_new();
    for (var s = 0; s < 64; s = s + 1) { vec_push(subs, agnosai_event_sender_subscribe(tx)); }
    var ev = agnosai_crew_event_new(str_from("crew"), str_from("task_started"),
    bayan_json_v_null());

    var b = bench_new("event_fanout_64_subs");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_event_sender_send(tx, ev);
        for (var j = 0; j < 64; j = j + 1) { agnosai_event_sub_try_recv(vec_get(subs, j)); }
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# A send into a subscriber that has stopped reading — the eviction path.
fn _b_event_send_evicting(): i64 {
    var n = 200000;
    var bus = agnosai_event_bus_new();
    var tx = agnosai_event_bus_sender(bus, agnosai_uuid_v4_str());
    agnosai_event_sender_subscribe(tx);
    var ev = agnosai_crew_event_new(str_from("crew"), str_from("task_started"),
    bayan_json_v_null());

    # Fill the ring first, so every timed send takes the evict-and-retry branch
    # rather than the first 256 measuring the cheap one.
    for (var f = 0; f < AGNOSAI_SSE_CHANNEL_CAPACITY; f = f + 1) {
        agnosai_event_sender_send(tx, ev);
    }

    var b = bench_new("event_send_evicting");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_event_sender_send(tx, ev); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# A publish across four patterns, one of which matches, with the reader keeping
# pace — the shape a crew's own event topics take.
fn _b_pubsub_publish(): i64 {
    var n = 100000;
    var ps = agnosai_pubsub_new();
    var rx = agnosai_pubsub_subscribe(ps, str_from("task.#"));
    agnosai_pubsub_subscribe(ps, str_from("agent.*"));
    agnosai_pubsub_subscribe(ps, str_from("crew.started"));
    agnosai_pubsub_subscribe(ps, str_from("tool.*.failed"));
    var topic = str_from("task.completed");
    var payload = bayan_json_v_null();

    var b = bench_new("pubsub_publish_4_patterns");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_pubsub_publish(ps, topic, payload);
        chan_try_recv(rx);
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# The wildcard matcher on its own, against a pattern that only fails on the
# last segment — the worst case that still returns false.
fn _b_pattern_match(): i64 {
    var n = 500000;
    var pattern = str_from("tool.*.*.failed");
    var topic = str_from("tool.http.request.succeeded");

    var b = bench_new("pattern_match_wildcard");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_matches_pattern(pattern, topic); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# ── scoring.rs — the oracle's seven ids ──────────────
#
# Added 2026-08-11. These are the six gaps `fleet.analysis.md` routed here and
# that the M12 bench fan-out then shipped nowhere; the audit
# (docs/development/m12-bench-audit-2026-08-10.md, fleet finding 3) caught it.
#
# ⚠ **`rank_agents_varied_*` price a REAL complexity divergence from the oracle.**
# The oracle sorts with `scored.sort_by(...)` — Rust's pdqsort, O(n log n)
# (rust-old/src/orchestrator/scoring.rs:212). The port hand-rolls an **insertion
# sort** (src/orchestrator/scoring.cyr:294-303), O(n^2) on unsorted input.
#
# **Measured at three sizes, and the quadratic is confirmed rather than inferred:**
#
#     rank_agents_varied_100     127.8us
#     rank_agents_varied_300     626.0us
#     rank_agents_varied_1000   5093.0us
#
# Fitting `total(n) = a*n + b*n^2` to the 100 and 1000 points gives a = 0.863us
# (the linear scoring) and b = 0.00421us (the sort). That model predicts
# **637.8us** at n = 300; the independent third point measured **626.0us**,
# within 2%. So:
#
#   * the sort overtakes the scoring at **n ~ 205**,
#   * at n = 1000 it is **83%** of the call.
#
# ⚠ **This is a performance note, NOT a DoS vector, and an earlier draft of this
# comment said otherwise.** The claim that the agent count is
# "attacker-influenceable" does not survive checking: `AGNOSAI_CREW_MAX_AGENTS`
# is **100** and `src/server/routes/crews.cyr:353` rejects anything larger, so
# nothing reachable over HTTP gets past n = 100 — where the sort is 33% of a
# 128us call. The crossover at 205 is beyond the cap. A direct library caller is
# unbounded, which is what the 1000 row is for.
#
# Three sizes rather than two because two points can be *fitted* by a quadratic
# but not *tested* against one. And the agents must be VARIED: identical agents
# tie on every score, and a stable insertion sort walks a tied list in O(n) since
# the shift loop breaks on the first comparison. That is exactly why
# `rank_agents_16` — 16 identical agents — never showed this in two weeks of
# history.
#
# The agents must also be VARIED. Identical agents tie on every score, and a
# stable insertion sort walks a tied list in O(n): the shift loop breaks on the
# first comparison. `_b_scoring_agents` cycles tools, complexity and domain so
# adjacent scores genuinely differ.

# The oracle's `make_rich_task` — all four context signals populated.
fn _b_rich_task(): i64 {
    var t = agnosai_task_new(str_from("complex analytics task"));
    var required = bayan_json_v_arr_new();
    bayan_json_v_arr_push(required, bayan_json_v_str_new(str_from("sql_query")));
    bayan_json_v_arr_push(required, bayan_json_v_str_new(str_from("chart_gen")));
    bayan_json_v_arr_push(required, bayan_json_v_str_new(str_from("report_writer")));
    bayan_json_v_arr_push(required, bayan_json_v_str_new(str_from("data_clean")));
    agnosai_task_with_context(t, str_from("required_tools"), required);
    agnosai_task_with_context(t, str_from("complexity"), bayan_json_v_str_new(str_from("high")));
    agnosai_task_with_context(t, str_from("domain"), bayan_json_v_str_new(str_from("finance")));
    agnosai_task_with_context(t, str_from("gpu_required"), bayan_json_v_bool_new(1));
    return t;
}

# The oracle's `make_agent(tools, complexity, domain)`.
fn _b_scoring_agent(tools, complexity, domain): i64 {
    var a = agnosai_agent_new(str_from("bench-agent"), str_from("bench"),
    str_from("benchmark"));
    agnosai_agent_with_name(a, str_from("Bench Agent"));
    agnosai_agent_with_tools(a, tools);
    agnosai_agent_with_complexity(a, complexity);
    if (domain != 0) { agnosai_agent_with_domain(a, domain); }
    return a;
}

fn _b_tool_list(n): i64 {
    var v = vec_new();
    if (n > 0) { vec_push(v, str_from("sql_query")); }
    if (n > 1) { vec_push(v, str_from("chart_gen")); }
    if (n > 2) { vec_push(v, str_from("data_clean")); }
    if (n > 3) { vec_push(v, str_from("report_writer")); }
    return v;
}

fn _b_scoring_complexity(i): i64 {
    if (i % 3 == 0) { return str_from("low"); }
    if (i % 3 == 1) { return str_from("medium"); }
    return str_from("high");
}

fn _b_scoring_domain(i): i64 {
    if (i % 5 == 0) { return str_from("finance"); }
    if (i % 5 == 1) { return str_from("devops"); }
    if (i % 5 == 2) { return str_from("quality"); }
    return 0;
}

# `n` agents whose tool count, complexity and domain all cycle — the oracle's
# 1000-agent fixture, generalised. Adjacent scores differ, so the insertion sort
# actually shifts.
fn _b_scoring_agents(n): i64 {
    var v = vec_new();
    for (var i = 0; i < n; i = i + 1) {
        vec_push(v, _b_scoring_agent(_b_tool_list((i % 5) + 1),
        _b_scoring_complexity(i), _b_scoring_domain(i)));
    }
    return v;
}

fn _b_score_case(agent, task, n, name): i64 {
    var b = bench_new(name);
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_score_agent(agent, task); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# Oracle: `score_agent (rich context)` — every signal populated on both sides,
# so all five weighted terms do real work.
fn _b_score_rich(): i64 {
    var tools = vec_new();
    vec_push(tools, str_from("sql_query"));
    vec_push(tools, str_from("chart_gen"));
    vec_push(tools, str_from("report_writer"));
    return _b_score_case(_b_scoring_agent(tools, str_from("high"), str_from("finance")),
    _b_rich_task(), 200000, "score_agent_rich_context");
}

# Oracle: `score_agent (no context)` — the floor. No tools, no domain, an empty
# task context, so every extractor takes its absent branch. Read against
# `rich_context` it isolates what the context actually costs.
fn _b_score_minimal(): i64 {
    return _b_score_case(_b_scoring_agent(vec_new(), str_from("medium"), 0),
    agnosai_task_new(str_from("simple task")), 500000, "score_agent_no_context");
}

# Oracle: `score_agent (GPU required)` — the one path where the agent's hardware
# requirement is consulted.
fn _b_score_gpu(): i64 {
    var a = _b_scoring_agent(vec_new(), str_from("medium"), 0);
    agnosai_agent_with_gpu(a, 1, 0, 0);
    var t = agnosai_task_new(str_from("gpu task"));
    agnosai_task_with_context(t, str_from("gpu_required"), bayan_json_v_bool_new(1));
    return _b_score_case(a, t, 300000, "score_agent_gpu_required");
}

# Oracle: `score_agent (domain mismatch)` — devops agent, quality task. The
# domain term takes its penalty branch rather than its credit branch.
fn _b_score_domain_mismatch(): i64 {
    var tools = vec_new();
    vec_push(tools, str_from("lint"));
    var t = agnosai_task_new(str_from("quality task"));
    agnosai_task_with_context(t, str_from("domain"), bayan_json_v_str_new(str_from("quality")));
    var required = bayan_json_v_arr_new();
    bayan_json_v_arr_push(required, bayan_json_v_str_new(str_from("lint")));
    bayan_json_v_arr_push(required, bayan_json_v_str_new(str_from("test")));
    agnosai_task_with_context(t, str_from("required_tools"), required);
    return _b_score_case(_b_scoring_agent(tools, str_from("high"), str_from("devops")),
    t, 200000, "score_agent_domain_mismatch");
}

fn _b_rank_varied(count, n, name): i64 {
    var agents = _b_scoring_agents(count);
    var task = _b_rich_task();
    var b = bench_new(name);
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_rank_agents(agents, task); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# Oracle: `rank_agents (100 agents)` and `rank_agents (1000 agents)`.
#
# ⚠ **Read these three as a CURVE, not as three numbers.** The scoring is linear,
# so anything above 10x per 10x of agents is the sort. Measured 39.5x from 100 to
# 1000 — between O(n log n)'s ~15x and a pure O(n^2)'s 100x, because the linear
# scoring still dominates at the low end. See the header for the fit.
fn _b_rank_agents_varied_100(): i64 {
    return _b_rank_varied(100, 2000, "rank_agents_varied_100");
}

fn _b_rank_agents_varied_300(): i64 {
    return _b_rank_varied(300, 600, "rank_agents_varied_300");
}

fn _b_rank_agents_varied_1000(): i64 {
    return _b_rank_varied(1000, 100, "rank_agents_varied_1000");
}

# Ranking 16 agents for one task — what hierarchical mode pays per task.
#
# ⚠ Its 16 agents are IDENTICAL, so every score ties and the insertion sort
# performs zero shifts. Kept for its history, but it is a scoring number, not a
# sort number — `rank_agents_varied_*` above are the sort.
fn _b_rank_agents(): i64 {
    var n = 20000;
    var agents = _b_agents(16);
    var task = _b_task();

    var b = bench_new("rank_agents_16");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_rank_agents(agents, task); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# A whole delegation pass: 16 tasks over 16 agents, one ranking each.
fn _b_delegate(): i64 {
    var n = 2000;
    var manager = _b_agent(str_from("manager"));
    var agents = _b_agents(16);
    var tasks = _b_tasks(16);

    var b = bench_new("delegate_16_tasks_16_agents");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_delegate_tasks(manager, agents, tasks); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# The scheduler's topological sort over a 64-node chain-of-pairs DAG: every odd
# node depends on the even one before it, so half the nodes seed the first wave.
fn _b_kahn_sort(): i64 {
    var n = 5000;
    var keys = vec_new();
    var dependents = map_new_str();
    var dependencies = map_new_str();
    for (var k = 0; k < 64; k = k + 1) {
        var key = str_cat(str_from("task-"), str_from_int(k));
        vec_push(keys, key);
        map_set(dependents, key, vec_new());
        map_set(dependencies, key, vec_new());
    }
    for (var e = 1; e < 64; e = e + 2) {
        var from = vec_get(keys, e - 1);
        var to = vec_get(keys, e);
        vec_push(map_get(dependents, from), to);
        vec_push(map_get(dependencies, to), from);
    }

    var b = bench_new("kahn_sort_64_nodes");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_scheduler_kahn_sort(keys, dependents, dependencies);
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# The plan-cache key over a 16-agent, 16-task crew — two sorts plus the FNV walk.
fn _b_plan_key(): i64 {
    var n = 20000;
    var agent_keys = vec_new();
    var descriptions = vec_new();
    for (var k = 0; k < 16; k = k + 1) {
        vec_push(agent_keys, str_cat(str_from("agent-"), str_from_int(k)));
        vec_push(descriptions, str_cat(str_from("do the thing numbered "), str_from_int(k)));
    }
    var mode = str_from("sequential");

    var b = bench_new("plan_key_16x16");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_plan_key(agent_keys, descriptions, mode); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# A cache hit, including the TTL check and the LRU touch.
fn _b_plan_cache_get(): i64 {
    var n = 200000;
    var cache = agnosai_plan_cache_new();
    var keys = vec_new();
    for (var k = 0; k < 64; k = k + 1) {
        var one = vec_new();
        vec_push(one, str_cat(str_from("agent-"), str_from_int(k)));
        var key = agnosai_plan_key(one, one, str_from("sequential"));
        vec_push(keys, key);
        agnosai_plan_cache_insert(cache, key, agnosai_cached_plan_empty());
    }

    var b = bench_new("plan_cache_get_hit");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_plan_cache_get(cache, vec_get(keys, i % 64));
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# A push into a full sliding-window buffer — the trim runs on every push, so
# this is the steady-state cost of a long tool-use loop.
fn _b_conv_buffer_push(): i64 {
    var n = 200000;
    var buf = agnosai_conv_buffer_with_sliding_window(str_from("agent-a"), 32);
    var content = str_from("call the tool again with the corrected arguments");
    for (var f = 0; f < 32; f = f + 1) { agnosai_conv_buffer_add_user(buf, content); }

    var b = bench_new("conv_buffer_push_sliding_32");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_conv_buffer_add_user(buf, content); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# A crew state in the oracle's sample_state() shape.
fn _b_crew_state(): i64 {
    return agnosai_crew_state_new(agnosai_uuid_v4_str(), AGNOSAI_CREW_RUNNING);
}

# The pretty-print that produces a snapshot.
fn _b_serialize_state(): i64 {
    var n = 50000;
    var st = _b_crew_state();

    var b = bench_new("durable_serialize_crew_state");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_serialize_crew_state(st); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# Parsing a snapshot back, including the required-field gate.
fn _b_deserialize_state(): i64 {
    var n = 50000;
    var doc = agnosai_serialize_crew_state(_b_crew_state());
    var out = 0;
    store64(&out, 0);

    var b = bench_new("durable_deserialize_crew_state");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_deserialize_crew_state(str_data(doc), str_len(doc), &out);
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# A full save: mkdir_p over an existing tree, then the atomic write. This one is
# fsync-bound by construction — file_write_atomic writes a temp, fsyncs it, and
# renames — so the iteration count is low on purpose and the number is a disk
# measurement, not a CPU one.
fn _b_state_save(): i64 {
    var n = 300;
    var store = agnosai_state_store_new(str_from("/tmp/agnosai-bench-durable"));
    var doc = agnosai_serialize_crew_state(_b_crew_state());
    var cid = str_from("bench-crew");

    var b = bench_new("durable_save_atomic");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_state_store_save(store, cid, str_data(doc), str_len(doc));
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# A hit: open, seek for the size, one read, close.
fn _b_state_load(): i64 {
    var n = 20000;
    var store = agnosai_state_store_new(str_from("/tmp/agnosai-bench-durable"));
    var cid = str_from("bench-crew");
    var bytes = 0;
    var len = 0;
    store64(&bytes, 0);
    store64(&len, 0);

    var b = bench_new("durable_load_hit");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_state_store_load(store, cid, &bytes, &len);
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# A miss — the open fails ENOENT and nothing is allocated. This is the path a
# crew takes on every cold start, so it wants to be cheap.
fn _b_state_load_miss(): i64 {
    var n = 20000;
    var store = agnosai_state_store_new(str_from("/tmp/agnosai-bench-durable"));
    var cid = str_from("no-such-crew");
    var bytes = 0;
    var len = 0;
    store64(&bytes, 0);
    store64(&len, 0);

    var b = bench_new("durable_load_miss");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_state_store_load(store, cid, &bytes, &len);
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# The hand-rolled create_dir_all over a tree that already exists: every save
