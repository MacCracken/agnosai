    str_from("ensure zero defects"));
    agnosai_agent_with_name(a, str_from("QA Lead"));
    agnosai_agent_with_backstory(a, str_from("ten years in QA"));
    agnosai_agent_with_domain(a, str_from("testing"));
    var tools = vec_new();
    vec_push(tools, str_from("selenium"));
    vec_push(tools, str_from("pytest"));
    agnosai_agent_with_tools(a, tools);

    var b = bench_new("crew_build_system_prompt");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { _agnosai_crew_build_system_prompt(a); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

