    var chain = agnosai_audit_chain_with_key(alloc(AGNOSAI_AUDIT_KEY_BYTES), 256);
    for (var f = 0; f < 256; f = f + 1) {
        agnosai_audit_record(chain, str_from("task_completed"), str_from("info"),
        str_from("done"), 0, 0, 0);
    }

