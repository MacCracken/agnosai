# An agent with two tools, a complexity and a domain — the shape scoring reads.
fn _b_agent(key: Str): i64 {
    var a = agnosai_agent_new(key, str_from("worker"), str_from("do work"));
    agnosai_agent_with_complexity(a, str_from("medium"));
    agnosai_agent_with_domain(a, str_from("quality"));
    var tools = vec_new();
    vec_push(tools, str_from("lint"));
    vec_push(tools, str_from("test"));
    agnosai_agent_with_tools(a, tools);
    return a;
}

# A task whose context exercises all three scoring signals.
fn _b_task(): i64 {
    var t = agnosai_task_new(str_from("review the changed files and report defects"));
    var required = bayan_json_v_arr_new();
    bayan_json_v_arr_push(required, bayan_json_v_str_new(str_from("lint")));
    bayan_json_v_arr_push(required, bayan_json_v_str_new(str_from("test")));
    agnosai_task_with_context(t, str_from("required_tools"), required);
    agnosai_task_with_context(t, str_from("complexity"), bayan_json_v_str_new(str_from("medium")));
    agnosai_task_with_context(t, str_from("domain"), bayan_json_v_str_new(str_from("quality")));
    return t;
}

# `n` agents with distinct keys.
fn _b_agents(n): i64 {
    var v = vec_new();
    for (var i = 0; i < n; i = i + 1) {
        vec_push(v, _b_agent(str_cat(str_from("agent-"), str_from_int(i))));
    }
    return v;
}

# `n` tasks.
fn _b_tasks(n): i64 {
    var v = vec_new();
    for (var i = 0; i < n; i = i + 1) { vec_push(v, _b_task()); }
    return v;
}

# One event send with a single reader keeping pace — the steady state when an
# SSE client is connected and consuming.
fn _b_event_round_trip(): i64 {
    var n = 200000;
    var bus = agnosai_event_bus_new();
    var tx = agnosai_event_bus_sender(bus, agnosai_uuid_v4_str());
    var rx = agnosai_event_sender_subscribe(tx);
    var ev = agnosai_crew_event_new(str_from("crew"), str_from("task_started"),
    bayan_json_v_null());

    var b = bench_new("event_round_trip_1_sub");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_event_sender_send(tx, ev);
        agnosai_event_sub_try_recv(rx);
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# The same, fanned out to 64 subscribers each of which reads.
fn _b_event_fanout_64(): i64 {
    var n = 5000;
    var bus = agnosai_event_bus_new();
    var tx = agnosai_event_bus_sender(bus, agnosai_uuid_v4_str());
    var subs = vec_new();
    for (var s = 0; s < 64; s = s + 1) { vec_push(subs, agnosai_event_sender_subscribe(tx)); }
    var ev = agnosai_crew_event_new(str_from("crew"), str_from("task_started"),
    bayan_json_v_null());

    var b = bench_new("event_fanout_64_subs");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_event_sender_send(tx, ev);
        for (var j = 0; j < 64; j = j + 1) { agnosai_event_sub_try_recv(vec_get(subs, j)); }
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# A send into a subscriber that has stopped reading — the eviction path.
fn _b_event_send_evicting(): i64 {
    var n = 200000;
    var bus = agnosai_event_bus_new();
    var tx = agnosai_event_bus_sender(bus, agnosai_uuid_v4_str());
    agnosai_event_sender_subscribe(tx);
    var ev = agnosai_crew_event_new(str_from("crew"), str_from("task_started"),
    bayan_json_v_null());

    # Fill the ring first, so every timed send takes the evict-and-retry branch
    # rather than the first 256 measuring the cheap one.
    for (var f = 0; f < AGNOSAI_SSE_CHANNEL_CAPACITY; f = f + 1) {
        agnosai_event_sender_send(tx, ev);
    }

    var b = bench_new("event_send_evicting");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_event_sender_send(tx, ev); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# A publish across four patterns, one of which matches, with the reader keeping
# pace — the shape a crew's own event topics take.
fn _b_pubsub_publish(): i64 {
    var n = 100000;
    var ps = agnosai_pubsub_new();
    var rx = agnosai_pubsub_subscribe(ps, str_from("task.#"));
    agnosai_pubsub_subscribe(ps, str_from("agent.*"));
    agnosai_pubsub_subscribe(ps, str_from("crew.started"));
    agnosai_pubsub_subscribe(ps, str_from("tool.*.failed"));
    var topic = str_from("task.completed");
    var payload = bayan_json_v_null();

    var b = bench_new("pubsub_publish_4_patterns");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_pubsub_publish(ps, topic, payload);
        chan_try_recv(rx);
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# The wildcard matcher on its own, against a pattern that only fails on the
# last segment — the worst case that still returns false.
fn _b_pattern_match(): i64 {
    var n = 500000;
    var pattern = str_from("tool.*.*.failed");
    var topic = str_from("tool.http.request.succeeded");

    var b = bench_new("pattern_match_wildcard");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_matches_pattern(pattern, topic); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# Ranking 16 agents for one task — what hierarchical mode pays per task.
fn _b_rank_agents(): i64 {
    var n = 20000;
    var agents = _b_agents(16);
    var task = _b_task();

    var b = bench_new("rank_agents_16");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_rank_agents(agents, task); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# A whole delegation pass: 16 tasks over 16 agents, one ranking each.
fn _b_delegate(): i64 {
    var n = 2000;
    var manager = _b_agent(str_from("manager"));
    var agents = _b_agents(16);
    var tasks = _b_tasks(16);

    var b = bench_new("delegate_16_tasks_16_agents");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_delegate_tasks(manager, agents, tasks); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# The scheduler's topological sort over a 64-node chain-of-pairs DAG: every odd
# node depends on the even one before it, so half the nodes seed the first wave.
fn _b_kahn_sort(): i64 {
    var n = 5000;
    var keys = vec_new();
    var dependents = map_new_str();
    var dependencies = map_new_str();
    for (var k = 0; k < 64; k = k + 1) {
        var key = str_cat(str_from("task-"), str_from_int(k));
        vec_push(keys, key);
        map_set(dependents, key, vec_new());
        map_set(dependencies, key, vec_new());
    }
    for (var e = 1; e < 64; e = e + 2) {
        var from = vec_get(keys, e - 1);
        var to = vec_get(keys, e);
        vec_push(map_get(dependents, from), to);
        vec_push(map_get(dependencies, to), from);
    }

    var b = bench_new("kahn_sort_64_nodes");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_scheduler_kahn_sort(keys, dependents, dependencies);
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# The plan-cache key over a 16-agent, 16-task crew — two sorts plus the FNV walk.
fn _b_plan_key(): i64 {
    var n = 20000;
    var agent_keys = vec_new();
    var descriptions = vec_new();
    for (var k = 0; k < 16; k = k + 1) {
        vec_push(agent_keys, str_cat(str_from("agent-"), str_from_int(k)));
        vec_push(descriptions, str_cat(str_from("do the thing numbered "), str_from_int(k)));
    }
    var mode = str_from("sequential");

    var b = bench_new("plan_key_16x16");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_plan_key(agent_keys, descriptions, mode); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# A cache hit, including the TTL check and the LRU touch.
fn _b_plan_cache_get(): i64 {
    var n = 200000;
    var cache = agnosai_plan_cache_new();
    var keys = vec_new();
    for (var k = 0; k < 64; k = k + 1) {
        var one = vec_new();
        vec_push(one, str_cat(str_from("agent-"), str_from_int(k)));
        var key = agnosai_plan_key(one, one, str_from("sequential"));
        vec_push(keys, key);
        agnosai_plan_cache_insert(cache, key, agnosai_cached_plan_empty());
    }

    var b = bench_new("plan_cache_get_hit");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_plan_cache_get(cache, vec_get(keys, i % 64));
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# A push into a full sliding-window buffer — the trim runs on every push, so
# this is the steady-state cost of a long tool-use loop.
fn _b_conv_buffer_push(): i64 {
    var n = 200000;
    var buf = agnosai_conv_buffer_with_sliding_window(str_from("agent-a"), 32);
    var content = str_from("call the tool again with the corrected arguments");
    for (var f = 0; f < 32; f = f + 1) { agnosai_conv_buffer_add_user(buf, content); }

    var b = bench_new("conv_buffer_push_sliding_32");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_conv_buffer_add_user(buf, content); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# A crew state in the oracle's sample_state() shape.
fn _b_crew_state(): i64 {
    return agnosai_crew_state_new(agnosai_uuid_v4_str(), AGNOSAI_CREW_RUNNING);
}

# The pretty-print that produces a snapshot.
fn _b_serialize_state(): i64 {
    var n = 50000;
    var st = _b_crew_state();

    var b = bench_new("durable_serialize_crew_state");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_serialize_crew_state(st); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# Parsing a snapshot back, including the required-field gate.
fn _b_deserialize_state(): i64 {
    var n = 50000;
    var doc = agnosai_serialize_crew_state(_b_crew_state());
    var out = 0;
    store64(&out, 0);

    var b = bench_new("durable_deserialize_crew_state");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_deserialize_crew_state(str_data(doc), str_len(doc), &out);
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# A full save: mkdir_p over an existing tree, then the atomic write. This one is
# fsync-bound by construction — file_write_atomic writes a temp, fsyncs it, and
# renames — so the iteration count is low on purpose and the number is a disk
# measurement, not a CPU one.
fn _b_state_save(): i64 {
    var n = 300;
    var store = agnosai_state_store_new(str_from("/tmp/agnosai-bench-durable"));
    var doc = agnosai_serialize_crew_state(_b_crew_state());
    var cid = str_from("bench-crew");

    var b = bench_new("durable_save_atomic");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_state_store_save(store, cid, str_data(doc), str_len(doc));
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# A hit: open, seek for the size, one read, close.
fn _b_state_load(): i64 {
    var n = 20000;
    var store = agnosai_state_store_new(str_from("/tmp/agnosai-bench-durable"));
    var cid = str_from("bench-crew");
    var bytes = 0;
    var len = 0;
    store64(&bytes, 0);
    store64(&len, 0);

    var b = bench_new("durable_load_hit");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_state_store_load(store, cid, &bytes, &len);
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# A miss — the open fails ENOENT and nothing is allocated. This is the path a
# crew takes on every cold start, so it wants to be cheap.
fn _b_state_load_miss(): i64 {
    var n = 20000;
    var store = agnosai_state_store_new(str_from("/tmp/agnosai-bench-durable"));
    var cid = str_from("no-such-crew");
    var bytes = 0;
    var len = 0;
    store64(&bytes, 0);
    store64(&len, 0);

    var b = bench_new("durable_load_miss");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_state_store_load(store, cid, &bytes, &len);
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# The hand-rolled create_dir_all over a tree that already exists: every save
# pays this, and every component costs one mkdir that returns EEXIST plus an
# is_dir stat to confirm it really is a directory.
fn _b_mkdir_p(): i64 {
    var n = 20000;
    var path = str_from("/tmp/agnosai-bench-durable/a/b/c");
    _agnosai_mkdir_p(path);

    var b = bench_new("durable_mkdir_p_existing_4deep");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { _agnosai_mkdir_p(path); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

