# Rounds of batch/`_BR`, as every `.bcyr` runs them (*Settled decisions*).
var _BR = 5;

fn _b_o_tools(t1, t2): i64 {
    var v = vec_new();
    vec_push(v, str_from(t1));
    if (t2 != 0) { vec_push(v, str_from(t2)); }
    return v;
}

fn _b_o_agent(key: Str, complexity: Str, domain, tools): i64 {
    var a = agnosai_agent_new(key, str_from("worker"), str_from("execute tasks"));
    agnosai_agent_with_name(a, str_cat(str_from("Agent "), key));
    agnosai_agent_with_tools(a, tools);
    agnosai_agent_with_complexity(a, complexity);
    if (domain != 0) { agnosai_agent_with_domain(a, domain); }
    return a;
}

fn _b_o_task(i): i64 {
    var t = agnosai_task_new(str_cat(str_from("task-"), str_from_int(i)));
    agnosai_task_with_context(t, str_from("complexity"),
      bayan_json_v_str_new(str_from("medium")));
    var req = bayan_json_v_arr_new();
    bayan_json_v_arr_push(req, bayan_json_v_str_new(str_from("sql_query")));
    bayan_json_v_arr_push(req, bayan_json_v_str_new(str_from("report_writer")));
    agnosai_task_with_context(t, str_from("required_tools"), req);
    return t;
}

# `orch.bcyr`'s `_b_o_spec`: three agents and `n_tasks` alike tasks, under `process`.
fn _b_spec(n_tasks, process): i64 {
    var c = agnosai_crew_new(str_from("bench-manager"));
    agnosai_crew_with_agents(c, _b_agents());
    var tasks = vec_new();
    for (var i = 0; i < n_tasks; i = i + 1) { vec_push(tasks, _b_o_task(i)); }
    agnosai_crew_with_tasks(c, tasks);
    agnosai_crew_with_process(c, process);
    return c;
}

fn _b_agents(): i64 {
    var agents = vec_new();
    vec_push(agents, _b_o_agent(str_from("a1"), str_from("medium"), str_from("finance"),
        _b_o_tools("sql_query", "report_writer")));
    vec_push(agents, _b_o_agent(str_from("a2"), str_from("high"), str_from("devops"),
        _b_o_tools("docker", "kubectl")));
    vec_push(agents, _b_o_agent(str_from("a3"), str_from("low"), 0,
        _b_o_tools("sql_query", 0)));
    return agents;
}

# The gateway every bench client talks to, already read: three models, so a run measures the
# selection a task really makes and never a GET.
fn _b_catalog_get(client, a, path: Str, out_body): i64 {
    store64(out_body, str_from("{\"data\":[\
{\"id\":\"bench-fast\",\"owned_by\":\"openai\",\"pricing\":{\"input_micro_usd_per_1k\":1,\
\"output_micro_usd_per_1k\":1}},\
{\"id\":\"bench-capable\",\"owned_by\":\"openai\",\"pricing\":{\"input_micro_usd_per_1k\":5,\
\"output_micro_usd_per_1k\":5}},\
{\"id\":\"bench-premium\",\"owned_by\":\"openai\",\"pricing\":{\"input_micro_usd_per_1k\":9,\
\"output_micro_usd_per_1k\":9}}]}"));
    return 200;
}

fn _b_catalog_client(): i64 {
    return agnosai_hoosh_client_with_get(agnosai_hoosh_client_new(str_from("http://127.0.0.1:1"),
        str_from("")), &_b_catalog_get);
}

var _b_stub_body = 0;

fn _b_stub_chat(client, request, out_response, parent_sc): i64 {
    store64(out_response, agnosai_hoosh_response_from_body(_b_stub_body));
    return 0;
}

# A four-task crew under the process `hierarchical` picks, on the stub model.
fn _b_run(name, hierarchical, n): i64 {
    var client = agnosai_hoosh_client_with_chat(
      agnosai_hoosh_client_new(str_from("http://127.0.0.1:1"), str_from("")), &_b_stub_chat);
    var err: i64[1];
    store64(&err, 0);
    var b = bench_new(name);
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            var process = agnosai_process_sequential();
            if (hierarchical == 1) { process = agnosai_process_hierarchical(str_from("a1")); }
            var r = agnosai_crew_runner_new(_b_spec(4, process));
            agnosai_crew_runner_with_llm(r, client);
            var st = agnosai_crew_runner_run(r, &err);
            # A crew that did not complete measured nothing it names.
            if (st == 0 || agnosai_crew_state_status(st) != AGNOSAI_CREW_COMPLETED) { syscall(60, 1); }
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# The workers of a crew of four, each a copy within its manager's tools, in an arena reset each time.
fn _b_workers(): i64 {
    var n = 50000;
    var agents = _b_agents();
    vec_push(agents, _b_o_agent(str_from("a4"), str_from("medium"), 0, _b_o_tools("report_writer", "docker")));
    var manager = vec_get(agents, 0);
    var ar = arena_allocator_growable(16384);
    var b = bench_new("hierarchical_workers_3_of_4");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            if (vec_len(agnosai_hierarchical_workers_a(ar, agents, manager)) != 3) { syscall(60, 1); }
            reset_via(ar);
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

fn main(): i64 {
    alloc_init();
    sakshi_set_level(SK_FATAL);
    # A catalog to choose models from, as `orch.bcyr` has: without one every task fails at once, and
    # a crew row measures that failure (2.4.3 found 2.4.2's hand-off row doing so).
    agnosai_model_catalog_of(_b_catalog_client());
    _b_stub_body = str_cat(str_cat(
        str_from("{\"model\":\"gpt-4o-mini\",\"choices\":[{\"message\":{\"content\":\"done\"}}],"),
        str_from("\"usage\":{\"prompt_tokens\":1000,\"completion_tokens\":500,\"total_tokens\":1500,")),
      str_from("\"cost_micro_usd\":450,\"provider\":\"openai\"}}"));
    # The crews first, on a heap no other row has moved, sequential before managed.
    _b_run("run_crew_4_task_sequential", 0, 1000);
    _b_run("run_crew_4_task_hierarchical", 1, 1000);
    _b_workers();
    return 0;
}

var r = main();
syscall(60, r);
