# =========================================================================
# core.bcyr — benchmarks for the core group.
#
# Oracle bench files: rust-old/benches/resource.rs (6 ids) and the two
# core-typed groups of rust-old/benches/serde_types.rs. There is no `core.rs` —
# the oracle splits this group across those files — so the uuid, crew and
# message shapes here have no oracle id at all and exist because they are the
# paths core actually gets hammered on: UUID minting and rendering, and the JSON
# serialize/parse round trips every request boundary crosses. The oracle's own
# ids are reproduced below under their headings.
#
# These numbers start the CYRIUS baseline. They are NOT comparable to
# rust-old/bench-history.csv. See CLAUDE.md.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/id.cyr"
include "src/core/mod.cyr"

# A representative populated task: an assigned agent, a dependency, and one
# context entry.
fn _b_sample_task(): i64 {
    var t = agnosai_task_new(str_from("analyze quarterly revenue trends"));
    agnosai_task_with_expected_output(t, str_from("a markdown table"));
    agnosai_task_with_priority(t, AGNOSAI_PRIORITY_HIGH);
    # ids are canonical strings; the uuid_* benchmarks below deliberately keep
    # the byte form, since that is the primitive they measure.
    agnosai_task_with_agent(t, agnosai_uuid_v4_str());
    agnosai_task_with_dependency(t, agnosai_uuid_v4_str());
    agnosai_task_with_context(t, str_from("quarter"), bayan_json_v_str_new(str_from("Q4")));
    return t;
}

# A representative agent definition with tools and hardware requirements.
fn _b_sample_agent(): i64 {
    var a = agnosai_agent_new(str_from("analyst"), str_from("data analyst"), str_from("analyze data"));
    agnosai_agent_with_name(a, str_from("Analyst"));
    agnosai_agent_with_backstory(a, str_from("ten years in financial reporting"));
    agnosai_agent_with_domain(a, str_from("quality"));
    var tools = vec_new();
    vec_push(tools, str_from("sql"));
    vec_push(tools, str_from("plot"));
    agnosai_agent_with_tools(a, tools);
    var accels = vec_new();
    vec_push(accels, AGNOSAI_ACCEL_CUDA);
    agnosai_agent_with_hardware(a, agnosai_hw_requirement_with_min_memory(
    agnosai_hw_requirement_for_accelerators(accels), 16384));
    return a;
}

# A crew of `n` agents and `n` tasks — the shape a crew-spec POST carries.
fn _b_sample_crew(n): i64 {
    var c = agnosai_crew_new(str_from("analysis-crew"));
    var agents = vec_new();
    var tasks = vec_new();
    for (var i = 0; i < n; i = i + 1) {
        vec_push(agents, _b_sample_agent());
        vec_push(tasks, _b_sample_task());
    }
    agnosai_crew_with_agents(c, agents);
    agnosai_crew_with_tasks(c, tasks);
    return c;
}

# The resource.rs oracle's `large_inventory()` — 8 CUDA + 1 TPU + 1 ROCm on a
# 128-core, 1 TiB node.
#
# ⚠ Device NAMES are never read by satisfies / devices_of_type /
# total_memory_mb, so one constant literal stands in for the oracle's
# `format!("NVIDIA H100 #{i}")`. `str_from` borrows a static cstr rather than
# copying, so this keeps string work out of setup and changes nothing the
# benched paths can observe.
fn _b_large_inventory(): i64 {
    var devices = vec_new();
    for (var i = 0; i < 8; i = i + 1) {
        vec_push(devices,
        agnosai_compute_device_new(i, str_from("NVIDIA H100"), AGNOSAI_ACCEL_CUDA, 81920));
    }
    vec_push(devices,
    agnosai_compute_device_new(8, str_from("TPU v4"), AGNOSAI_ACCEL_TPU, 32768));
    vec_push(devices,
    agnosai_compute_device_new(9, str_from("AMD MI300X"), AGNOSAI_ACCEL_ROCM, 196608));
    return agnosai_hw_inventory_new(128, 1048576, devices);
}

# The serde_types.rs oracle's inventory — 8 HOMOGENEOUS CUDA devices, no TPU and
# no ROCm. Deliberately not `_b_large_inventory`: the two oracle files use
# different fixtures and the JSON rows must match theirs, not each other's.
#
# ⚠ One constant 6-byte name for all eight is byte-identical in length to the
# oracle's `format!("GPU #{i}")` output, so the emitted document is the same
# size. The `index` field still varies, as it does upstream.
fn _b_json_inventory(): i64 {
    var devices = vec_new();
    for (var i = 0; i < 8; i = i + 1) {
        vec_push(devices,
        agnosai_compute_device_new(i, str_from("GPU #0"), AGNOSAI_ACCEL_CUDA, 81920));
    }
    return agnosai_hw_inventory_new(128, 1048576, devices);
}

# UUID v4 minting — every task, message and crew pays this once.
fn _b_uuid_v4(): i64 {
    var n = 200000;
    var b = bench_new("uuid_v4_generate");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_uuid_v4(); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# UUID rendering — on every serialize of every id-bearing struct.
fn _b_uuid_to_str(): i64 {
    var u = agnosai_uuid_v4();
    var n = 500000;
    var b = bench_new("uuid_to_str");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_uuid_to_str(u); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# UUID parsing — on every deserialize.
fn _b_uuid_parse(): i64 {
    var s = agnosai_uuid_to_str(agnosai_uuid_v4());
    var n = 500000;
    var b = bench_new("uuid_parse");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_uuid_parse(s); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

