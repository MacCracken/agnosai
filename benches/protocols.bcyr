# =========================================================================
# protocols.bcyr — MCP 2026-07-28 and A2A 1.0 (2.6.0, ADRs 039 and 040).
#
# No oracle, and no earlier tree: 2.5.x has neither. A file of its own, as the roadmap's 2.7.1 asks
# of crew rows. MCP's rows run the same method under both revisions, so a pair says what the newer
# revision's checks and fields cost; A2A's run the card, a task sent and read, and a stream, with
# the registry's cap at 8 so every task past it evicts a crew, which goes back. Every request is
# in a request arena reset after it, as the server's are.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/arena_pool.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/strcase.cyr"
include "src/telemetry/mod.cyr"
include "src/core/mod.cyr"
include "src/learning/mod.cyr"
include "src/llm/mod.cyr"
include "src/server/ssrf.cyr"
include "src/server/prompt_guard.cyr"
include "src/server/output_filter.cyr"
include "src/server/prometheus.cyr"
include "src/server/auth.cyr"
include "src/guarded_fetch.cyr"
include "src/chan_lossy.cyr"
include "src/server/sse.cyr"
include "src/sandbox/mod.cyr"
include "src/tools/mod.cyr"
include "src/orchestrator/mod.cyr"
