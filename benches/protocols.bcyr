include "src/server/routes/mod.cyr"
include "src/server/routes/crews.cyr"
include "src/server/routes/a2a.cyr"
include "src/server/routes/mcp.cyr"
include "src/a2a_v1.cyr"

# Rounds of batch/`_BR`, as every `.bcyr` runs them (*Settled decisions*).
var _BR = 5;

fn _b_state(): i64 {
    var bus = agnosai_event_bus_new();
    var o = agnosai_orchestrator_new(agnosai_resource_budget_default());
    agnosai_orchestrator_with_audit(o, 0);
    agnosai_orchestrator_with_events(o, bus);
    var reg = agnosai_tool_registry_new();
    agnosai_tool_registry_register(reg, agnosai_echo_tool());
    return agnosai_app_state_new(o, reg, agnosai_auth_config_new(), bus, 0, agnosai_orchestrator_approval_gate(o));
}

# A 2026-07-28 body for `method` with params `extra` (fields ending in a comma, or "").
fn _b_modern(method, extra): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"");
    str_builder_add_cstr(sb, method);
    str_builder_add_cstr(sb, "\",\"params\":{");
    str_builder_add_cstr(sb, extra);
    str_builder_add_cstr(sb, "\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",");
    str_builder_add_cstr(sb, "\"io.modelcontextprotocol/clientCapabilities\":{}}}}");
    return str_builder_build(sb);
}

# A request's text: the request line, `headers` and `body`.
fn _b_text(headers, body: Str): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "POST /mcp HTTP/1.1\r\nHost: bench\r\n");
    str_builder_add_cstr(sb, headers);
    str_builder_add_cstr(sb, "\r\n");
    str_builder_add(sb, body);
    return str_builder_build(sb);
}

fn _b_mcp_row(name, state, ra, body: Str, text: Str, n): i64 {
    var b = bench_new(name);
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            agnosai_route_mcp_h_a(ra, state, body, 0, agnosai_http_headers_of_a(ra, text));
            reset_via(ra);
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

fn _b_mcp_rows(state, ra): i64 {
    var ll = str_from("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}");
    _b_mcp_row("mcp_tools_list_2025_03_26", state, ra, ll, _b_text("", ll), 50000);
    var ml = _b_modern("tools/list", "");
    _b_mcp_row("mcp_tools_list_2026_07_28", state, ra, ml,
      _b_text("MCP-Protocol-Version: 2026-07-28\r\nMcp-Method: tools/list\r\n", ml), 50000);
    var lc = str_cat(str_from("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\","),
      str_from("\"params\":{\"name\":\"echo\",\"arguments\":{\"message\":\"hi\"}}}"));
    _b_mcp_row("mcp_tools_call_2025_03_26", state, ra, lc, _b_text("", lc), 20000);
    var mc = _b_modern("tools/call", "\"name\":\"echo\",\"arguments\":{\"message\":\"hi\"},");
    _b_mcp_row("mcp_tools_call_2026_07_28", state, ra, mc,
      _b_text("MCP-Protocol-Version: 2026-07-28\r\nMcp-Method: tools/call\r\nMcp-Name: echo\r\n", mc), 20000);
    var md = _b_modern("server/discover", "");
    _b_mcp_row("mcp_server_discover", state, ra, md,
      _b_text("MCP-Protocol-Version: 2026-07-28\r\nMcp-Method: server/discover\r\n", md), 50000);
    return 0;
}

fn _b_card_row(name, state, ra, n): i64 {
    var b = bench_new(name);
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            var r = agnosai_route_a2a_card_a(ra, state, 0);
            bayan_json_v_build_a(ra, agnosai_route_body(r));
            reset_via(ra);
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# The P-256 test key `tests/a2a_v1.tcyr` signs with, for the signed rows: a test key, which signs nothing
# outside the suite and this file.
fn _b_ec_pem(): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "-----BEGIN PRIVATE KEY-----\n");
    str_builder_add_cstr(sb, "MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgMuwBo/ntg8yaLVNb\n");
    str_builder_add_cstr(sb, "SRZGRaXRHQkUtmnEnwJLvHpS/62hRANCAATJaE1VtpDhETYbFR9JzPNZtsrvkxdv\n");
    str_builder_add_cstr(sb, "2ZK1HWKX2EyUGPxCtGdxbysBARlHsrZRKH0AwJt+q2wSyA+4WH8YBg7r\n");
    str_builder_add_cstr(sb, "-----END PRIVATE KEY-----\n");
    return str_builder_build(sb);
}

fn _b_card_rows(state, ra): i64 {
    _b_card_row("a2a_agent_card_per_request", state, ra, 20000);
    var cfg = agnosai_a2a_config_with_public_url(agnosai_a2a_config_new(), str_from("https://agents.example.com"));
    var signer = agnosai_a2a_signer_from_pem(_b_ec_pem(), str_from("bench"), 0);
    agnosai_a2a_config_with_signer(cfg, signer);
    agnosai_a2a_config_seal(cfg, 0);
    agnosai_app_state_with_a2a(state, cfg);
    _b_card_row("a2a_agent_card_sealed_signed", state, ra, 20000);
    agnosai_app_state_with_a2a(state, 0);

    var card = agnosai_a2a_card_a(default_alloc(), 0, str_from("https://agents.example.com"));
    var b = bench_new("jcs_agent_card");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < 20000 / _BR; i = i + 1) {
            agnosai_jcs_a(ra, card);
            reset_via(ra);
        }
        bench_batch_stop(b, 20000 / _BR);
    }
    bench_report(b);

    var s = bench_new("a2a_card_sign_es256");
    for (var _r2 = 0; _r2 < _BR; _r2 = _r2 + 1) {
        bench_batch_start(s);
        for (var j = 0; j < 500 / _BR; j = j + 1) {
            agnosai_a2a_card_sign_a(ra, card, signer);
            reset_via(ra);
        }
        bench_batch_stop(s, 500 / _BR);
    }
    bench_report(s);
    return 0;
}

fn _b_rpc(method, params): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"");
    str_builder_add_cstr(sb, method);
    str_builder_add_cstr(sb, "\",\"params\":");
    str_builder_add_cstr(sb, params);
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

fn _b_a2a_text(body: Str): Str {
    return str_cat(str_from("POST /a2a HTTP/1.1\r\nA2A-Version: 1.0\r\n\r\n"), body);
}

fn _b_a2a_rows(state, ra): i64 {
    var send = _b_rpc("SendMessage",
      "{\"message\":{\"messageId\":\"m\",\"role\":\"ROLE_USER\",\"parts\":[{\"text\":\"run it\"}]}}");
    var stext = _b_a2a_text(send);
    for (var w = 0; w < 1100; w = w + 1) {
        agnosai_route_a2a_rpc_h_a(ra, state, send, 0, agnosai_http_headers_of_a(ra, stext));
        reset_via(ra);
    }
    var b = bench_new("a2a_send_message_1_task");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < 2000 / _BR; i = i + 1) {
            agnosai_route_a2a_rpc_h_a(ra, state, send, 0, agnosai_http_headers_of_a(ra, stext));
            reset_via(ra);
        }
        bench_batch_stop(b, 2000 / _BR);
    }
    bench_report(b);

    # A task to read: sent once, its id copied out of the request arena.
    var ka = arena_allocator_growable(4096);
    var r = agnosai_route_a2a_rpc_h_a(ra, state, send, 0, agnosai_http_headers_of_a(ra, stext));
    var task = bayan_json_v_obj_get_by_cstr(bayan_json_v_obj_get_by_cstr(agnosai_route_body(r), "result"), "task");
    var id = str_clone_a(ka, bayan_json_v_str(bayan_json_v_obj_get_by_cstr(task, "id")));
    reset_via(ra);
    var get = _b_rpc("GetTask", str_cstr(str_cat(str_cat(str_from("{\"id\":\""), id), str_from("\"}"))));
    var gtext = _b_a2a_text(get);
    var g = bench_new("a2a_get_task");
    for (var _r2 = 0; _r2 < _BR; _r2 = _r2 + 1) {
        bench_batch_start(g);
        for (var j = 0; j < 20000 / _BR; j = j + 1) {
            agnosai_route_a2a_rpc_h_a(ra, state, get, 0, agnosai_http_headers_of_a(ra, gtext));
            reset_via(ra);
        }
        bench_batch_stop(g, 20000 / _BR);
    }
    bench_report(g);

    var stream = _b_rpc("SendStreamingMessage",
      "{\"message\":{\"messageId\":\"m\",\"role\":\"ROLE_USER\",\"parts\":[{\"text\":\"stream it\"}]}}");
    var sttext = _b_a2a_text(stream);
    var null_fd = file_open("/dev/null", O_WRONLY, 0);
    var st = bench_new("a2a_send_streaming_message_1_task");
    for (var _r3 = 0; _r3 < _BR; _r3 = _r3 + 1) {
        bench_batch_start(st);
        for (var k = 0; k < 200 / _BR; k = k + 1) {
            agnosai_route_stream_run(agnosai_route_a2a_rpc_h_a(ra, state, stream, 0, agnosai_http_headers_of_a(ra,
                  sttext)),
              null_fd);
            reset_via(ra);
        }
        bench_batch_stop(st, 200 / _BR);
    }
    bench_report(st);
    file_close(null_fd);
    return 0;
}

fn main(): i64 {
    alloc_init();
    sakshi_set_level(SK_FATAL);
    AGNOSAI_MAX_RETAINED_CREWS = 8;
    AGNOSAI_CREWS_LOW_WATER = 4;
    var state = _b_state();
    var ra = arena_allocator_growable(65536);
    _b_mcp_rows(state, ra);
    _b_card_rows(state, ra);
    _b_a2a_rows(state, ra);
    return 0;
}

var r = main();
syscall(60, r);
