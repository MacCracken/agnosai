# How many crews, pending approvals and agent definitions the fixture carries.
#
# **Eight, not one.** Three of the four routes below render one object per
# registered crew, so a single-crew fixture would time the loop's setup rather
# than its body — and the arena's advantage is proportional to what a request
# builds. Eight is enough for the shape to show and small enough that the
# global arm does not exhaust the bump over 20,000 iterations.
var AGN_B_FIXTURE_N = 8;

# The application state every benchmark below dispatches against: eight finished
# crews carrying agent metadata, eight pending approvals, one agent definition,
# one registered tool.
fn _b_state(): i64 {
    var o = agnosai_orchestrator_new(0);
    var reg = agnosai_tool_registry_new();
    agnosai_tool_registry_register(reg, agnosai_echo_tool());
    var s = agnosai_app_state_new(o, reg, agnosai_auth_config_new(),
    agnosai_event_bus_new(), agnosai_audit_chain_new(), agnosai_approval_gate_new());

    for (var i = 0; i < AGN_B_FIXTURE_N; i = i + 1) {
        var spec = agnosai_crew_new(str_from("bench"));
        var tasks = vec_new();
        vec_push(tasks, agnosai_task_new(str_from("do the thing")));
        agnosai_crew_with_tasks(spec, tasks);
        agnosai_orchestrator_run_crew(o, spec);

        # `dashboard/agents` only emits an object for a result whose metadata
        # names an agent. Without this the route renders `[]` over eight crews
        # and times its guard, not its body.
        var st = agnosai_orchestrator_crew(o, agnosai_crew_id(spec));
        var r = agnosai_task_result_new(agnosai_uuid_v4_str(), str_from("out"),
        AGNOSAI_STATUS_COMPLETED);
        var ksb = str_builder_new();
        str_builder_add_cstr(ksb, "agent-");
        str_builder_add_int(ksb, i);
        agnosai_task_result_with_metadata(r, str_from("agent"),
        bayan_json_v_str_new(str_builder_build(ksb)));
        agnosai_task_result_with_metadata(r, str_from("agent_name"),
        bayan_json_v_str_new(str_from("The Agent")));
        agnosai_task_result_with_metadata(r, str_from("agent_role"),
        bayan_json_v_str_new(str_from("writer")));
        agnosai_crew_state_with_result(st, r);

        var tsb = str_builder_new();
        str_builder_add_cstr(tsb, "task-");
        str_builder_add_int(tsb, i);
        agnosai_approval_request(agnosai_app_state_approval_gate(s),
        str_builder_build(tsb));
    }

    agnosai_app_state_definition_insert(s, str_from("researcher"),
    agnosai_agent_new(str_from("researcher"), str_from("Researcher"),
    str_from("research things")));
    return s;
}

# Time `n` dispatches of `path` on the **global** allocator — the un-threaded
# arm, and what a caller outside a sandhi worker still gets.
fn _b_dispatch_global(s, name, path: Str, n): i64 {
    var empty = str_from("");
    agnosai_route_dispatch(s, AGNOSAI_METHOD_GET, path, empty, 0, empty);

    var b = bench_new(name);
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_route_dispatch(s, AGNOSAI_METHOD_GET, path, empty, 0, empty);
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# Time `n` dispatches of `path` through a per-request arena, reset between each
# — the path a sandhi worker takes.
#
# The `reset_via` is **inside** the timed loop on purpose: it is work sandhi
# does per request, so excluding it would flatter the arena arm by hiding its
# only per-request cost.
fn _b_dispatch_arena(s, name, path: Str, n): i64 {
    var empty = str_from("");
    var ar = arena_allocator(1048576);
    agnosai_route_dispatch_a(ar, s, AGNOSAI_METHOD_GET, path, empty, 0, empty);
    reset_via(ar);

    var b = bench_new(name);
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_route_dispatch_a(ar, s, AGNOSAI_METHOD_GET, path, empty, 0, empty);
        reset_via(ar);
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# Time `n` POSTs of `body` to `path` on the global allocator.
fn _b_post_global(s, name, path: Str, body: Str, n): i64 {
    var empty = str_from("");
    agnosai_route_dispatch(s, AGNOSAI_METHOD_POST, path, empty, 0, body);

    var b = bench_new(name);
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_route_dispatch(s, AGNOSAI_METHOD_POST, path, empty, 0, body);
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# The same through a per-request arena, reset between each.
fn _b_post_arena(s, name, path: Str, body: Str, n): i64 {
    var empty = str_from("");
    var ar = arena_allocator(1048576);
    agnosai_route_dispatch_a(ar, s, AGNOSAI_METHOD_POST, path, empty, 0, body);
    reset_via(ar);

    var b = bench_new(name);
    bench_batch_start(b);
    for (var j = 0; j < n; j = j + 1) {
        agnosai_route_dispatch_a(ar, s, AGNOSAI_METHOD_POST, path, empty, 0, body);
        reset_via(ar);
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# Dispatch `body` once and stop the whole run if the handler did not answer 200.
#
# `_b_post_global` and `_b_post_arena` discard the response, so a body that
# fails validation would time the 422 path with nothing to show for it. This is
# `syscall(60, 1)` rather than a return: `main` discards every `_b_*` return
# value, so a returned failure would exit 0 and merely omit a report line —
# the quietest possible way for a benchmark to stop measuring what it names.
fn _b_assert_post_ok(s, path: Str, body: Str): i64 {
    var empty = str_from("");
    var r = agnosai_route_dispatch(s, AGNOSAI_METHOD_POST, path, empty, 0, body);
    if (agnosai_route_status(r) != HTTP_OK) { syscall(60, 1); }
    return 0;
}

# The oracle's crew request body (`rust-old/benches/server.rs:133-146`): one
# agent, one task, no optional fields.
#
# Built through a `str_builder` rather than one `str_from` only because the
# escaped literal is past the 120-byte line limit. `agent_key`/`name`/`role`/
# `goal` are all four required by `agnosai_agent_from_value_a`
# (`core/agent.cyr:295-302`) and `description` by `agnosai_task_req_from_value_a`
# (`routes/crews.cyr:94-106`); every key must also be known to
# `agnosai_route_no_unknown_fields` or the request is 422 before the handler.
fn _b_crew_body(): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"name\":\"bench-crew\",\"agents\":[{");
    str_builder_add_cstr(sb, "\"agent_key\":\"worker\",\"name\":\"Worker\",");
    str_builder_add_cstr(sb, "\"role\":\"worker\",\"goal\":\"execute tasks\"}],");
    str_builder_add_cstr(sb, "\"tasks\":[{\"description\":\"Run a benchmark task\",");
    str_builder_add_cstr(sb, "\"expected_output\":\"task result\"}]}");
    return str_builder_build(sb);
}

# The JSON-RPC `initialize` envelope (`rust-old/benches/server.rs:186`).
#
# `params` is kept even though `_agnosai_mcp_initialize` ignores it entirely:
# parsing it is part of what the oracle measured, and dropping it would make the
# row cheaper than the request a real client sends.
fn _b_mcp_init_body(): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",");
    str_builder_add_cstr(sb, "\"params\":{\"protocolVersion\":\"2024-11-05\",");
    str_builder_add_cstr(sb, "\"clientInfo\":{\"name\":\"bench\",\"version\":\"0.1.0\"}}}");
    return str_builder_build(sb);
}

# The oracle's clean corpus: `"…lazy dog. ".repeat(12)` trimmed to 500 bytes
# (`rust-old/benches/prompt_guard.rs:10-12`). The repeat unit is **45** bytes,
# so the untrimmed build is 540.
fn _b_clean_500(): Str {
    var sb = str_builder_new();
    for (var f = 0; f < 12; f = f + 1) {
        str_builder_add_cstr(sb, "The quick brown fox jumps over the lazy dog. ");
    }
    return str_sub(str_builder_build(sb), 0, 500);
}

# The prompt guard's WORST case: 31 sliding case-blind window walks over clean
# text, none matching. Every user-supplied field pays it on every task, and
# `execute_task` sanitizes four of them per task.
#
# 500 bytes because that is the oracle's fixture, and because `orch.bcyr`'s two
# existing clean rows sit at 67 B and 2,880 B — this lands between them, so the
# three together give the O(len) slope three points instead of two.
#
# n=10000, not the 50000 the two `orch.bcyr` rows use: interpolating those
# (8.0 µs at 67 B, ~273 µs at 2,880 B — both quoted in `prompt_guard.cyr:83-84`)
# puts a clean 500 B scan near 50 µs, so 50000 would be ~2.5 s for one row.
fn _b_prompt_scan_clean_500(): i64 {
    var n = 10000;
    var text = _b_clean_500();

    var b = bench_new("prompt_scan_clean_500b");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_prompt_scan_input(text); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# The EARLY-EXIT arm, which nothing else in `benches/` measures — both existing
# `prompt_scan_*` rows are clean, and clean is the only case that runs all 31
# patterns. `"ignore previous instructions"` is the FIRST table entry
# (`prompt_guard.cyr:107`), so a match returns after one pattern.
#
# Measured, the pair comes out at **30.2x** (62.1 µs clean vs 2.06 µs here),
# which is the 31-pattern ratio almost exactly — and that is worth writing down
# because it is a statement about `agnosai_str_contains_ci`, not about the
# patterns. The folded first-byte guard (`strcase.cyr:74-76`) rejects nearly
# every offset in one compare in BOTH corpora, so each pattern costs ~O(len)
# either way and the early exit simply removes 30 of the 31 passes. If that
# ratio ever falls, the guard has stopped filtering and the inner loop is
# running — which is the regression this row exists to catch.
#
# The corpus is the oracle's `"a".repeat(460)` (`prompt_guard.rs:27-28`), so it
# is 489 bytes with the tail, not 500. The oracle's own name says 500; matching
# the fixture beats matching the label.
#
# The guard below is load-bearing, not decoration: the pattern table's order is
# contractual (`prompt_guard.cyr:42-48`), and a reorder would otherwise turn
# this row silently into a second, slower clean row.
fn _b_prompt_scan_suspicious_500(): i64 {
    var n = 50000;
    var sb = str_builder_new();
    for (var f = 0; f < 46; f = f + 1) { str_builder_add_cstr(sb, "aaaaaaaaaa"); }
    str_builder_add_cstr(sb, " ignore previous instructions");
    var text = str_builder_build(sb);
    if (agnosai_prompt_scan_input(text) == AGNOSAI_SCAN_CLEAN) { syscall(60, 1); }

    var b = bench_new("prompt_scan_suspicious_500b");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_prompt_scan_input(text); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# The full sanitize path on the same 500 B corpus, so the two rows subtract:
# the difference is exactly the four-fragment `<user_input field="…">` wrap,
# since the truncation guard is not taken at 500 B (the limit is 50,000,
# `prompt_guard.cyr:59`) and the warn path is not reached on clean input.
#
# ⚠ `field` is hoisted out of the loop deliberately. The oracle passes a
# `&'static str`; leaving `str_from("description")` inside would fold a 16-byte
# `str` header allocation per iteration into the very delta this row isolates.
fn _b_prompt_sanitize_clean_500(): i64 {
    var n = 10000;
    var text = _b_clean_500();
    var field = str_from("description");

    var b = bench_new("prompt_sanitize_clean_500b");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { agnosai_prompt_sanitize(text, field); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# The router's own cost, in both arms and removable from neither.
fn _b_resolve(): i64 {
    var n = 200000;
    var path = str_from("/api/v1/dashboard/crews");
    var b = bench_new("route_resolve");
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) {
        agnosai_route_resolve(AGNOSAI_METHOD_GET, path);
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

fn main(): i64 {
    alloc_init();
    # Every route logs on at least one path, and `crew_runner` emits per task.
    # Left at the default level these would time sakshi writing to a pipe.
    sakshi_set_level(SK_FATAL);

    var s = _b_state();
    # The crew id has to come from the registry — `/api/v1/crews/{id}` rejects a
    # non-UUID at 422 without ever reaching the handler being measured.
    var cid = vec_get(agnosai_orchestrator_crew_ids(
    agnosai_app_state_orchestrator(s)), 0);
    var csb = str_builder_new();
    str_builder_add_cstr(csb, "/api/v1/crews/");
    str_builder_add_str(csb, cid);
    var crew_path = str_builder_build(csb);

    _b_resolve();

    # The three public probes — no auth branch at all (`agnosai_route_needs_auth`
    # returns 0 for all three, `router.cyr:450-451`), so these are the floor:
    # body-limit check, resolve, handler, response. Single-arm by construction —
    # see the header.
    #
    # ⚠ `/metrics` reads the **process-global** registry
    # (`prometheus.cyr:54`), not a fixture-owned one, and the rendered body's
    # length therefore depends on what ran before it. `_b_state` runs eight
    # crews, and `crew_runner.cyr:1210/1254-1255` record `crew_started`,
    # `crew_completed` and `tasks_completed` on every one, so this row renders
    # 8/0/8/0/0/0.000000. It is placed **before** the `POST /crews` rows at the
    # bottom for that reason: those add 4,000 more crews and would widen three
    # of the six counters. Any new row that runs a crew belongs after this one.
    _b_dispatch_global(s, "route_health_global", str_from("/health"), 100000);
    _b_dispatch_global(s, "route_ready_global", str_from("/ready"), 100000);
    _b_dispatch_global(s, "route_metrics_global", str_from("/metrics"), 50000);

    # The B2 orchestrator group — the four routes threaded last.
    _b_dispatch_global(s, "route_dashboard_crews_global",
    str_from("/api/v1/dashboard/crews"), 20000);
    _b_dispatch_arena(s, "route_dashboard_crews_arena",
    str_from("/api/v1/dashboard/crews"), 20000);
    _b_dispatch_global(s, "route_dashboard_agents_global",
    str_from("/api/v1/dashboard/agents"), 20000);
    _b_dispatch_arena(s, "route_dashboard_agents_arena",
    str_from("/api/v1/dashboard/agents"), 20000);
    _b_dispatch_global(s, "route_approvals_global",
    str_from("/api/v1/approvals"), 50000);
    _b_dispatch_arena(s, "route_approvals_arena",
    str_from("/api/v1/approvals"), 50000);
    _b_dispatch_global(s, "route_get_crew_global", crew_path, 20000);
    _b_dispatch_arena(s, "route_get_crew_arena", crew_path, 20000);

    # The two groups threaded before it, which shipped with allocation numbers
    # and no timing. Back-filled here so all six threaded routes carry both.
    _b_dispatch_global(s, "route_definitions_global",
    str_from("/api/v1/agents/definitions"), 50000);
    _b_dispatch_arena(s, "route_definitions_arena",
    str_from("/api/v1/agents/definitions"), 50000);
    _b_dispatch_global(s, "route_tools_global", str_from("/api/v1/tools"), 20000);
    _b_dispatch_arena(s, "route_tools_arena", str_from("/api/v1/tools"), 20000);

    # The two **write** routes that retain nothing, and so are threaded parse
    # tree and all. The other three retain data borrowed from the parse tree
    # and are deliberately un-threaded — see `routes/agents.cyr`'s header — so
    # timing them against an arena would measure nothing.
    var appr = str_from(
    "{\"task_id\":\"00000000-0000-0000-0000-000000000000\",\"decision\":\"approved\"}");
    _b_post_global(s, "route_approvals_post_global", str_from("/api/v1/approvals"),
    appr, 20000);
    _b_post_arena(s, "route_approvals_post_arena", str_from("/api/v1/approvals"),
    appr, 20000);

    var mcp = str_from("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}");
    _b_post_global(s, "route_mcp_global", str_from("/mcp"), mcp, 20000);
    _b_post_arena(s, "route_mcp_arena", str_from("/mcp"), mcp, 20000);

    # The `initialize` arm of the same route, which the two rows above do NOT
    # cover despite the matching name: they post a `tools/list` body and take
    # `mcp.cyr:540`, walking every registered tool's schema and every parameter
    # under it. `initialize` takes `mcp.cyr:537` and builds a fixed six-object
    # result with no registry walk. Same count as the pair above so the four
    # rows sit against each other and the delta is the registry walk.
    #
    # ⚠ It measured **slower** than `tools/list` (4.64 µs vs 3.95 µs), which
    # inverts the expectation and is a fact about the fixture, not the handlers:
    # `_b_state` registers exactly ONE tool, so `tools/list`'s registry walk is
    # a single schema, while this row parses a 135-byte nested envelope against
    # `tools/list`'s 46 and then builds six objects. Register a second tool and
    # the order flips. Read the pair as "envelope parse vs one-tool walk".
    #
    # No status guard is possible here — every arm of the method ladder,
    # including "method not found", answers HTTP_OK inside the JSON-RPC
    # envelope, so `agnosai_route_status` cannot tell them apart.
    #
    # ⚠ Not comparable in kind to the Rust number: the port's `initialize`
    # advertises `prompts` and `resources` capabilities the oracle has no
    # equivalent for (ADR 015, ADR 016), so this result tree is larger.
    var mcp_init = _b_mcp_init_body();
    _b_post_global(s, "route_mcp_initialize_global", str_from("/mcp"), mcp_init, 20000);
    _b_post_arena(s, "route_mcp_initialize_arena", str_from("/mcp"), mcp_init, 20000);

    # The prompt guard, which no route row reaches: `execute_task` calls it only
    # after the LLM-client check, and every crew here runs on the placeholder
    # arm (`crew_runner.cyr:556-560`). Timed directly instead.
    _b_prompt_scan_clean_500();
    _b_prompt_scan_suspicious_500();
    _b_prompt_sanitize_clean_500();

    # ── POST /api/v1/crews — LAST, and on states of its own ────────────────
    #
    # The heaviest route in the file: parse, validate, build the spec, then a
    # BLOCKING full crew run (the oracle awaits it inline) — two mutex pairs,
    # the DAG sort, one placeholder result, and an audit record. Fully offline:
    # `agnosai_orchestrator_new(0)` leaves the LLM URL at 0
    # (`orchestrator.cyr:63`), so `execute_task` returns the placeholder before
    # any inference.
    #
    # ⚠ **Three reasons this cannot share `s`, and none of them fails loudly.**
    #   1. `_agnosai_orch_finish` does `map_set` on the crew registry
    #      (`orchestrator.cyr:326`) and never prunes. Three pairs above render
    #      one object per REGISTERED crew — that is why `AGN_B_FIXTURE_N` is 8 —
    #      so running this against `s` would re-time them against 8 + n.
    #   2. The two arms cannot share a state either, or the arena arm starts
    #      with ~2,000 crews in the registry the global arm never saw, and the
    #      pair stops being a comparison. Hence `s2` and `s3`.
    #   3. `_agnosai_orch_audit` fires twice per run (`orchestrator.cyr:234`
    #      and `:322`) and the chain evicts at `AGNOSAI_AUDIT_MAX_ENTRIES`
    #      (10000, `audit.cyr:55`) with `vec_remove(entries, 0)` — an O(n) shift
    #      over 10,000 pointers PLUS an extra SHA-256. n=2000 puts each arm at
    #      ~4,000 records, comfortably under the cliff. **Do not raise n past
    #      ~4,900 without minting a fresh state**, or the row starts measuring
    #      the ring's memmove and reads as a regression in the handler.
    #
    # ⚠ Expect a far smaller arena win than the read routes show, and do not
    # read that as a defect: most of what this route allocates is the crew
    # *execution*, which is retained state and stays on the global bump in both
    # arms (`crews.cyr:593-598`). What moves to the arena is the parse tree and
    # the response.
    var crew_body = _b_crew_body();
    var crews_path = str_from("/api/v1/crews");
    var s2 = _b_state();
    var s3 = _b_state();
    _b_assert_post_ok(s2, crews_path, crew_body);
    _b_post_global(s2, "route_create_crew_global", crews_path, crew_body, 2000);
    _b_post_arena(s3, "route_create_crew_arena", crews_path, crew_body, 2000);

    return 0;
}

var r = main();
syscall(60, r);
