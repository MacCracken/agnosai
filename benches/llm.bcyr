# =========================================================================
# llm.bcyr — benchmarks for the llm group.
#
# Oracle bench file: rust-old/benches/llm_router.rs — three criterion groups
# (`llm_router_route`, `llm_router_default_model`, `llm_router_parse_complexity`),
# **none of which had a Cyrius counterpart**. `benches/` held six `.bcyr` and
# not one of them touched `src/llm/`, so the routing matrix — which every crew
# task crosses once — had no number at all.
#
# The oracle's shapes are reproduced, then `inference_queue`'s enqueue/dequeue
# is added because it is new in this milestone and because the priority queue is
# the one llm path with a lock on it.
#
# ⚠ **`route` and `model_for_tier` are a few compares and loads each**, so a
# single call lands under timer resolution. Each is
# therefore batched over many iterations and reported per-op, exactly as
# `core.bcyr`'s uuid shapes are. The oracle gets the same effect from
# criterion's own sampling.
#
# ⚠ **`parse_complexity` is measured on all seven of the oracle's inputs**, not
# a representative one: the ladder folds ASCII case, so `"HIGH"` walks a
# different path from `"high"`, and `"unknown"` is the only input that runs
# every comparison before falling through. Those are the interesting ends.
#
# These numbers start the CYRIUS baseline. They are NOT comparable to
# rust-old/bench-history.csv. See CLAUDE.md.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/telemetry/mod.cyr"
include "src/core/mod.cyr"
include "src/strcase.cyr"
include "src/llm/retry.cyr"
include "src/llm/router.cyr"
# The chat transport takes its per-call arena from a pool (2.1.6).
include "src/arena_pool.cyr"
include "src/llm/hoosh.cyr"
include "src/model_catalog.cyr"
include "src/llm/inference_queue.cyr"

# All 21 (task_type, complexity) profiles, built once so the loop measures the
# routing and not the construction — the oracle pre-builds them for the same
# reason.
# ────────────
# Every row in this file used to call `bench_batch_start`/`bench_batch_stop`
# EXACTLY ONCE, so `bench_batch_stop`'s per-op value was the only sample it ever
# saw and `min == max == avg` by construction — the dispersion column carried no
# information at all. `lib/bench.cyr`'s `bench_batch_stop` already folds each
# call's per-op figure into min/max, so N rounds give N real samples for free.
#
# ⚠ **Total work is UNCHANGED**: the inner loop bound and the batch size are both
# divided by `_BR`, so `rounds x batch` equals the old single batch. Integer
# division can shave a few iterations off a batch that does not divide evenly;
# `bench_iterations` reports the true accumulated count either way.
#
# ⚠ **This RE-BASELINES every row in this file.** `_bench_net` subtracts the
# measured clock floor once per `bench_batch_stop`, so five stops subtract it
# five times where one subtracted it once. Rows are not comparable across
# 2026-08-13. See roadmap D4.
var _BR = 5;

fn _b_all_profiles(): i64 {
    var types = vec_new();
    vec_push(types, AGNOSAI_TASKTYPE_SUMMARIZE);
    vec_push(types, AGNOSAI_TASKTYPE_CLASSIFY);
    vec_push(types, AGNOSAI_TASKTYPE_CODE);
    vec_push(types, AGNOSAI_TASKTYPE_PLAN);
    vec_push(types, AGNOSAI_TASKTYPE_REASON);
    vec_push(types, AGNOSAI_TASKTYPE_RESEARCH);
    vec_push(types, AGNOSAI_TASKTYPE_MULTI_STEP);

    var cx = vec_new();
    vec_push(cx, AGNOSAI_COMPLEXITY_SIMPLE);
    vec_push(cx, AGNOSAI_COMPLEXITY_MEDIUM);
    vec_push(cx, AGNOSAI_COMPLEXITY_COMPLEX);

    var profiles = vec_new();
    for (var i = 0; i < vec_len(types); i = i + 1) {
        for (var j = 0; j < vec_len(cx); j = j + 1) {
            vec_push(profiles, agnosai_task_profile_new(vec_get(types, i), vec_get(cx, j)));
        }
    }
    return profiles;
}

# The oracle's `route (all 21 combinations)` — one iteration is a full sweep.
fn _b_route_all(): i64 {
    var profiles = _b_all_profiles();
    var n = 100000;
    var b = bench_new("route_all_21_combinations");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            for (var j = 0; j < 21; j = j + 1) { agnosai_route(vec_get(profiles, j)); }
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# The oracle's `route (Summarize × Simple)` — the ladder's FIRST arm.
fn _b_route_fast(): i64 {
    var p = agnosai_task_profile_new(AGNOSAI_TASKTYPE_SUMMARIZE, AGNOSAI_COMPLEXITY_SIMPLE);
    var n = 2000000;
    var b = bench_new("route_summarize_simple");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) { agnosai_route(p); }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# The oracle's `route (Research × Complex)` — the deepest arm, so the pair
# brackets the ladder rather than sampling one point on it.
fn _b_route_premium(): i64 {
    var p = agnosai_task_profile_new(AGNOSAI_TASKTYPE_RESEARCH, AGNOSAI_COMPLEXITY_COMPLEX);
    var n = 2000000;
    var b = bench_new("route_research_complex");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) { agnosai_route(p); }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# A 200-model list, the size of a gateway with several live routes, in hoosh's shape.
fn _b_catalog_body(): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"object\":\"list\",\"data\":[");
    for (var i = 0; i < 200; i = i + 1) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "{\"id\":\"model-");
        str_builder_add_int(sb, i);
        str_builder_add_cstr(sb, "\",\"object\":\"model\",\"owned_by\":\"anthropic\",\"source\":\"live\",");
        str_builder_add_cstr(sb, "\"routes\":[\"https://api.anthropic.com\"],\"context_window\":1000000,");
        str_builder_add_cstr(sb, "\"capabilities\":{\"vision\":true,\"thinking\":[\"adaptive\"],");
        str_builder_add_cstr(sb, "\"effort\":[\"low\",\"medium\",\"high\"]},\"pricing\":{");
        str_builder_add_cstr(sb, "\"input_micro_usd_per_1k\":");
        str_builder_add_int(sb, 100 + i * 10);
        str_builder_add_cstr(sb, ",\"output_micro_usd_per_1k\":");
        str_builder_add_int(sb, 500 + i * 50);
        str_builder_add_cstr(sb, "}}");
    }
    str_builder_add_cstr(sb, "]}");
    return str_builder_build(sb);
}

var _B_CATALOG_BODY = 0;

fn _b_catalog_get(client, a, path: Str, out_body): i64 {
    store64(out_body, _B_CATALOG_BODY);
    return 200;
}

# The gateway every catalog row reads, already read.
var _B_CATALOG_CLIENT = 0;

fn _b_catalog_client(): i64 {
    if (_B_CATALOG_CLIENT == 0) {
        _B_CATALOG_BODY = _b_catalog_body();
        _B_CATALOG_CLIENT = agnosai_hoosh_client_with_get(agnosai_hoosh_client_new(
            str_from("http://bench-gw"), str_from("")), &_b_catalog_get);
        agnosai_model_catalog_of(_B_CATALOG_CLIENT);
    }
    return _B_CATALOG_CLIENT;
}

# What every task with no `llm_model` pays once a catalog is held: a walk to its gateway's slot, one
# atomic load and an array read, and no allocation at all.
fn _b_model_for_tier(tier, name): i64 {
    var n = 1000000;
    var client = _b_catalog_client();
    var out: i64[1];
    var a = default_alloc();
    var b = bench_new(name);
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) { agnosai_model_for_tier_a(a, client, tier, &out); }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# A read of a list that changed: the parse, a copy of every entry, and the three picks. Rare, and
# worth having a number for because a task waits on it.
fn _b_catalog_parse(): i64 {
    var n = 200;
    var body = _b_catalog_body();
    var ar = arena_allocator_growable(1048576);
    var b = bench_new("model_catalog_parse_200");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            agnosai_model_catalog_parse_a(ar, body);
            reset_via(ar);
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# A lookup by id, for attribution and for a prefixed `llm_model`: the worst case, the last entry.
fn _b_catalog_owner(): i64 {
    var n = 200000;
    var client = _b_catalog_client();
    var model = str_from("model-199");
    var b = bench_new("model_catalog_owner_200_last");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) { agnosai_model_catalog_owner(client, model); }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# The oracle's `parse_complexity("…")` across all seven inputs.
fn _b_parse_complexity(input, name): i64 {
    var s = str_from(input);
    var n = 1000000;
    var b = bench_new(name);
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) { agnosai_parse_complexity(s); }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# ── inference_queue: no oracle bench file ──────────────

# Enqueue throughput — the cost a request handler pays to hand work off: mint a
# majra `QueueItem` and push onto a tier vec, under `cpq_enqueue`'s own mutex.
#
# ⚠ **This row got cheaper on 2026-08-12 for a reason that is not a code
# optimisation.** Through cyrius 6.5.18 the queue carried its own mutex here as
# well, held across `queue_item_new` because majra builds the item with
# `fl_alloc` and `fl_alloc` was not thread-safe. 6.5.19 fixed the allocator, the
# lock was deleted, and `InferenceQueue` went 16 bytes -> 8. A step down in this
# row across that boundary is the lock leaving, not the enqueue getting smarter.
fn _b_iq_enqueue(): i64 {
    var q = agnosai_inference_queue_new();
    var req = agnosai_inference_request_new(str_from("bench-model"));
    var label = str_from("bench");
    var n = 200000;
    var b = bench_new("inference_queue_enqueue");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            agnosai_inference_queue_enqueue(q, req, PRIORITY_NORMAL, label);
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# Dequeue at the WORST tier: everything queued at Background, so `pq_dequeue`
# walks all five tiers on every pop rather than hitting the first one.
#
# ⚠ **Measured at TWO depths on purpose, and the two numbers are not supposed to
# match.** majra's `pq_dequeue` pops with `vec_remove(tier, 0)`, which shifts
# every remaining element down a slot — so one pop is O(n) in the tier depth and
# a full drain is **O(n²)**. Measured 2k/4k/8k/16k, the per-pop cost doubles
# every time the depth does (2.00µs → 4.02µs → 7.92µs → 15.56µs), which is the
# signature of a linear pop rather than cache noise.
#
# ✅ **FIXED in majra 2.6.2 (2026-08-11), and the two rows converged exactly as
# this comment predicted they would.** Measured here, same host, same run:
#
#     majra 2.6.1:   2k = 4.431us    16k = 35.335us    slope 8.0x
#     majra 2.6.2:   2k = 168ns      16k = 175ns       slope 1.04x
#
# ✅ **Confirmed in `bench-history.csv` on 2026-08-12**, the first committed
# sweep carrying 2.6.2 — and the sweep/standalone gap below reproduced exactly:
#
#     majra 2.6.1:   2k = 1.931us    16k = 15.646us    slope 8.1x
#     majra 2.6.2:   2k = 88ns       16k = 89ns        slope 1.01x
#
# Those are the ONLY two rows of 199 that moved more than 25% across that bump;
# everything else stayed inside +/-12% host noise. A quadratic drain is now flat
# across an 8x depth range.
#
# That is the whole argument for measuring at two depths rather than one. The
# ABSOLUTE numbers move with run conditions — the same 2.6.1 build reads
# 1.9/15.6us inside a full `bench-history` sweep and 4.4/35.3us standalone,
# because a sweep warms the allocator for whatever runs after it. **The SLOPE
# does not move**: 8.1x in the sweep, 8.0x standalone. A single-depth row would
# have been noise; the ratio was the signal.
#
# ⚠ Same trap caught `inference_queue_enqueue` on this bump: it read 1.24us in
# the committed sweep and 2.4us standalone, which looks like a 2x regression from
# majra and is not — a real 2.6.1-vs-2.6.2 bisect through the manifest shows
# **2.394us vs 2.40us, unchanged**. Do not compare a standalone run against a
# committed sweep row.
#
# ⚠ And bisecting a dep by hand-copying a bundle into `lib/` does NOT work:
# `cyrius bench` performs an implicit resolve, and `path = "../majra"` overwrites
# the file before compiling. Change the tag in `cyrius.cyml` and drop `path`.
#
# This is also the design case, not the pathological one: the queue exists so
# that background work is ALLOWED to accumulate behind interactive work.
fn _b_iq_dequeue_background(n, name): i64 {
    var q = agnosai_inference_queue_new();
    var req = agnosai_inference_request_new(str_from("bench-model"));
    var label = str_from("bench");
    for (var i = 0; i < n; i = i + 1) {
        agnosai_inference_queue_enqueue(q, req, PRIORITY_BACKGROUND, label);
    }
    var cpq = agnosai_inference_queue_cpq(q);
    var b = bench_new(name);
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var j = 0; j < n / _BR; j = j + 1) { cpq_dequeue(cpq); }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# The priority mapping — one call per enqueue from a task, and a five-arm
# ladder that must NOT be replaced by arithmetic (see the module header).
fn _b_map_priority(): i64 {
    var n = 5000000;
    var b = bench_new("map_priority_ladder");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) { agnosai_map_priority(AGNOSAI_PRIORITY_CRITICAL); }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# `_agnosai_hoosh_pool`'s fast path: the one load every chat call pays to reach its arena. No other
# row reaches this function, as the crew benches answer through the client's stub and a real chat
# needs a network. The build runs once, before the clock starts, and its fence with it. A fence
# moved onto this path reads 21 ns here against 4 (x86, measured on a mutant).
fn _b_hoosh_pool_fast_path(): i64 {
    _agnosai_hoosh_pool();
    var n = 5000000;
    var b = bench_new("hoosh_pool_fast_path");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) { _agnosai_hoosh_pool(); }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

fn main(): i64 {
    alloc_init();

    _b_route_all();
    _b_route_fast();
    _b_route_premium();

    _b_model_for_tier(AGNOSAI_TIER_FAST, "model_for_tier_fast");
    _b_model_for_tier(AGNOSAI_TIER_CAPABLE, "model_for_tier_capable");
    _b_model_for_tier(AGNOSAI_TIER_PREMIUM, "model_for_tier_premium");
    _b_catalog_parse();
    _b_catalog_owner();

    _b_parse_complexity("low", "parse_complexity_low");
    _b_parse_complexity("simple", "parse_complexity_simple");
    _b_parse_complexity("medium", "parse_complexity_medium");
    _b_parse_complexity("high", "parse_complexity_high");
    _b_parse_complexity("complex", "parse_complexity_complex");
    _b_parse_complexity("HIGH", "parse_complexity_HIGH");
    _b_parse_complexity("unknown", "parse_complexity_unknown");

    _b_iq_enqueue();
    _b_iq_dequeue_background(2000, "inference_queue_dequeue_background_2k");
    _b_iq_dequeue_background(16000, "inference_queue_dequeue_background_16k");
    _b_map_priority();

    # ⚠ Last, on purpose: this builds a pool of 2 MiB, and a row's position moves the rows after it
    # (roadmap B20, B27).
    _b_hoosh_pool_fast_path();

    return 0;
}

var r = main();
syscall(60, r);
