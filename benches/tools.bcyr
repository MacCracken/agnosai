# =========================================================================
# tools.bcyr — benchmarks for the tool path, principally the load_testing
# aggregation that runs after the worker threads join.
#
# `benches/order.bcyr` already covers the sort and the selects in isolation.
# What is measured here is the part load_testing adds on top: the cross-worker
# merge of per-arena latency vectors and status-count pair vectors, and the
# serialisation of the result.
#
# Two design choices are on trial:
#
#   * **status counts as a pair vec, not a map.** There is no map_u64_keys in
#     the stdlib, so the codes live in a vec of [code, count] pairs scanned
#     linearly. That is only defensible because a real run sees a handful of
#     distinct status codes; the `_many_codes` case measures what happens when
#     that assumption is wrong, so the cost of being wrong is a number rather
#     than a guess.
#   * **the merge copies.** Each worker owns an arena that is freed with it, so
#     aggregate copies every latency out rather than aliasing worker memory.
#     At the 100k cap that copy is measured here, not assumed cheap.
#
# The tool-dispatch cases exist so the vtable overhead is on record: every
# tool call in the system pays it.
#
# ── The ToolRegistry family (oracle: rust-old/benches/tools.rs) ───────────
#
# The oracle's `tools.rs` has nine criterion ids; only two had a counterpart
# here (`tool_registry_get` and `tool_execute_echo`). The EIGHT added below are
# `get` at 5, 50 and 500 entries, `has` hit and miss, `list` at 50 and 500, and
# `register` throughput. That is seven oracle gaps plus a `get` at 5 — the
# oracle's `get_5` is 5 stub tools on a cycled key and the pre-existing
# `tool_registry_get` is 3 real builtins on a fixed one, so mapping one onto the
# other would have been a claim, not a port. They are what says the map behind
# the registry mutex stays O(1) as a deployment grows, and what puts a number on
# `GET /api/v1/tools` — the one registry operation that is linear.
#
# Four divergences from the oracle, all deliberate:
#
#   * **Keys are prebuilt, and the lookup arms pad them to a fixed width.** The
#     oracle spends a heap allocation and an integer format per iteration;
#     keeping that in would bury the hash+probe this family exists to show, and
#     str_builder cost is `core.bcyr`'s subject. The padding is a second, separate
#     decision with its own rationale at `_b_tool_names`. Arms that never hash a
#     key (`list`) or report a single amortised figure (`register`) have no sweep
#     to protect and keep the oracle's natural widths.
#   * **`list` runs through `agnosai_tool_registry_list_a` with a request arena
#     and `reset_via` INSIDE the timed body.** That is the production path
#     (`src/server/routes/tools.cyr:22`) and the `_b_dispatch_arena` idiom in
#     `benches/server.bcyr`. The global form would put 152,176 bytes per call at
#     500 tools onto a no-free bump — 2000 calls is 304 MB of first-touch page
#     faults, which is what the arm would then be measuring.
#   * **`get` cycles its key over the whole registry; `has` uses one fixed key.**
#     That is the oracle's own split. Cycling defeats a single hot cache line so
#     the 5/50/500 slope is real; the fixed key isolates hit-probe from
#     miss-probe, which is the entire reason the oracle has both `has` arms.
#   * **The miss key is `"tool_999"`, not the oracle's `"nonexistent"`.** Same
#     byte length and same probe depth as the hit key, so the pair varies one
#     thing. The oracle's key varied three — see `_b_registry_has_pair`.
#
# `get` is measured at 5/50/500 through ONE helper, at ONE key width, so the
# three points divide against each other. The older `tool_registry_get` keeps
# its own id so its bench-history series survives, but it is NOT a fourth point
# of that sweep and is not on its scale: 3 real builtins, one 14-byte key, no
# cycling, and it measures a median 125ns against the sweep's 112-119ns.
#
# ⚠ Every "measured" figure in this file is a MEDIAN over ten runs, and the
# absolute levels are load-sensitive: those ten put `tool_registry_get` across
# 121-131ns, and one run with the machine busy threw `tool_registry_get_500` to
# 139ns against a 119ns median. Read the DIFFERENCES instead — they held across
# all ten, including that run: hit minus miss stayed inside 25-27ns and the
# 5-to-500 step inside 6-7ns. An absolute number that has moved 10% is probably
# the machine; a DIFFERENCE that has moved 10% is worth opening.
#
# ⚠ `tool_execute_echo` below is unchanged but no longer measures what it did:
# `src/tools/native.cyr:400` now mints a GenAI tool span and takes two
# `clock_epoch_ns` readings per dispatch (ADR 017) before the exporter check
# short-circuits. The 3.9-4.1µs is dispatch + instrumentation the oracle has no
# counterpart for. Not a regression — a wider scope.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
# id + telemetry — `tools/native` records a GenAI tool span per execute
# (ADR 017). Both were missing and this file did not compile.
include "src/id.cyr"
include "src/arena_pool.cyr"
include "src/telemetry/mod.cyr"
include "src/core/error.cyr"
include "src/core/json.cyr"
include "src/llm/retry.cyr"
include "src/server/ssrf.cyr"
include "src/tools/native.cyr"
include "src/tools/registry.cyr"
include "src/tools/builtin/basic.cyr"
include "src/tools/builtin/load_testing.cyr"
include "src/tools/agnos.cyr"
include "src/tools/builtin/mneme.cyr"

# A fixture guard for the registry arms. Every registry op that FAILS returns 0
# — `get` a null tool, `has` a zero — and every one of them costs about what
# success costs; the hit/miss pair below is the measurement that proves it. So a
# registry that silently stopped containing what an arm looks up would keep
# reporting a healthy ~110ns while measuring nothing at all. Checked once per
# fixture, always outside the timed region.
# ────────────
# Every row in this file used to call `bench_batch_start`/`bench_batch_stop`
# EXACTLY ONCE, so `bench_batch_stop`'s per-op value was the only sample it ever
# saw and `min == max == avg` by construction — the dispersion column carried no
# information at all. `lib/bench.cyr`'s `bench_batch_stop` already folds each
# call's per-op figure into min/max, so N rounds give N real samples for free.
#
# ⚠ **Total work is UNCHANGED**: the inner loop bound and the batch size are both
# divided by `_BR`, so `rounds x batch` equals the old single batch. Integer
# division can shave a few iterations off a batch that does not divide evenly;
# `bench_iterations` reports the true accumulated count either way.
#
# ⚠ **This RE-BASELINES every row in this file.** `_bench_net` subtracts the
# measured clock floor once per `bench_batch_stop`, so five stops subtract it
# five times where one subtracted it once. Rows are not comparable across
# 2026-08-13. See roadmap D4.
var _BR = 5;

fn _b_require(ok, msg): i64 {
    if (ok != 0) { return 0; }
    syscall(1, 2, msg, strlen(msg));
    syscall(60, 1);
    return 0;
}

# `workers` workers holding `per` pseudo-random latencies each, via xorshift —
# the same generator order.bcyr uses, so the shapes are comparable.
#
# `codes` distinct status codes are spread across the samples. A real run sees
# 1–3; the high-cardinality case is what proves the linear scan's limit.
fn _b_workers(workers, per, codes, seed): i64 {
    var v = vec_new();
    var x = seed;
    for (var w = 0; w < workers; w = w + 1) {
        # `per` as max_requests, so the worker's persistent arena is sized the
        # way a real run of this shape would size it. Passing 0 here gives an
        # arena of slack only, and the pushes below silently truncate.
        var worker = agnosai_lt_worker_new(str_from("http://example.com/"), 0, per, 0, w);
        var lat = agnosai_lt_worker_latencies(worker);
        var st = agnosai_lt_worker_status_counts(worker);
        var arena = agnosai_lt_worker_arena(worker);
        for (var i = 0; i < per; i = i + 1) {
            x = x ^ (x << 13);
            x = x ^ (x >> 7);
            x = x ^ (x << 17);
            var val = x % 1000000;
            if (val < 0) { val = 0 - val; }
            vec_push_a(arena, lat, val);
            _agnosai_lt_status_bump(arena, st, 200 + (i % codes), 1);
        }
        vec_push(v, worker);
    }
    return v;
}

# The full post-join aggregation at the 100k request cap, spread over 10
# workers — the shape a `concurrent_users=10` run at the cap produces. This is
# the merge plus order.cyr's sort plus the three percentile indices.
fn _b_aggregate_100k_10workers(): i64 {
    var n = 5;
    var b = bench_new("lt_aggregate_100k_10workers");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            var ws = _b_workers(10, 10000, 3, 88172645463325252);
            agnosai_lt_aggregate(ws, str_from("http://example.com/"), 10, 10);
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# The same total sample count spread over 500 workers — the user cap. The merge
# is O(total) either way, so this must not diverge from the 10-worker case; if
# it does, the per-worker overhead is the thing to look at.
fn _b_aggregate_100k_500workers(): i64 {
    var n = 5;
    var b = bench_new("lt_aggregate_100k_500workers");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            var ws = _b_workers(500, 200, 3, 88172645463325252);
            agnosai_lt_aggregate(ws, str_from("http://example.com/"), 500, 10);
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# The pathological case for the pair vec: 200 distinct status codes, so every
# bump scans a 200-entry list. If this is not catastrophically worse than the
# 3-code case, the vec was the right call and a map would have been premature.
fn _b_aggregate_many_codes(): i64 {
    var n = 5;
    var b = bench_new("lt_aggregate_100k_200codes");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            var ws = _b_workers(10, 10000, 200, 88172645463325252);
            agnosai_lt_aggregate(ws, str_from("http://example.com/"), 10, 10);
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# Serialising a finished result — 14 scalar fields plus the status-code object.
# This runs once per tool call, so it only matters that it is not accidentally
# quadratic in the code count.
fn _b_result_to_value(): i64 {
    var ws = _b_workers(4, 1000, 3, 88172645463325252);
    var r = agnosai_lt_aggregate(ws, str_from("http://example.com/"), 4, 10);
    var n = 20000;
    var b = bench_new("lt_result_to_value");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) { agnosai_lt_result_to_value(r); }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# The SSRF guard, which every load test pays before it does anything. It is on
# the critical path of a tool call, so its cost is worth knowing.
fn _b_is_safe_url(): i64 {
    var url = str_from("https://api.example.com:8443/v1/endpoint?q=1");
    var n = 200000;
    var b = bench_new("is_safe_url_public_host");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) { agnosai_is_safe_url(url); }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# The numeric-host path, which is the one that has to do real parsing work
# across four spellings before it can decide.
fn _b_is_safe_url_numeric(): i64 {
    var url = str_from("http://0300.0250.0.1/");
    var n = 200000;
    var b = bench_new("is_safe_url_octal_host");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) { agnosai_is_safe_url(url); }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# Registry lookup — a hashmap hit behind the futex mutex.
#
# The 3-real-builtins point, on a fixed key. Kept under its original id so its
# bench-history series survives; the comparable sweep is `tool_registry_get_5`
# / `_50` / `_500` below, which cycle keys through one shared helper.
fn _b_registry_get(): i64 {
    var reg = agnosai_register_basic_builtins(agnosai_tool_registry_new());
    agnosai_register_load_testing_builtin(reg);
    var name = str_from("json_transform");
    _b_require(agnosai_tool_registry_get(reg, name),
    "tools.bcyr: json_transform is not registered — arm would time a miss\n");
    var n = 500000;
    var b = bench_new("tool_registry_get");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) { agnosai_tool_registry_get(reg, name); }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# The Cyrius form of the oracle's `NamedEcho` wrapper (tools.rs:16-46): one
# vtable shared by every stub, with the stub's own name handed to it as `ctx`,
# so the schema callback reads a distinct name per tool. N stubs therefore
# build N distinct schemas and cost what N real tools cost — the shortcut of
# registering the same schema N times would make `list` look free.
fn _b_named_schema(a, ctx): i64 {
    var s = agnosai_tool_schema_new_a(a, ctx, str_from_a(a, "Named echo stub for benchmarking"));
    agnosai_tool_schema_param_a(a, s, str_from_a(a, "message"),
    str_from_a(a, "The message to echo back"), str_from_a(a, "string"), 1);
    return s;
}

# Append `i` to `sb` zero-padded to `width` digits. Callers pick a width that
# covers their largest index, so every key in one fixture is the same length.
fn _b_add_padded(sb, i, width): i64 {
    var limit = 10;
    for (var d = 1; d < width; d = d + 1) {
        if (i < limit) { str_builder_add_cstr(sb, "0"); }
        limit = limit * 10;
    }
    str_builder_add_int(sb, i);
    return 0;
}

# "tool_000" … "tool_{n-1}" zero-padded to `width` digits — the oracle's
# `format!("tool_{}", i)` keys, built once so no timed loop pays for them.
# Returned as a vec so a lookup arm can cycle keys with a vec_get instead of a
# str_builder.
#
# ⚠ The padding is a divergence from the oracle and it is what makes the sweep
# a sweep. `hash_str_v` (`lib/hashmap.cyr:84`) is a per-byte FNV loop, so with
# `format!`'s natural widths the mean key would be 6.00 bytes at n=5, 6.80 at
# n=50 and 7.78 at n=500 — registry size and hashed length would move together
# and no arithmetic on the three numbers could separate them. Padded to width 3
# every key is exactly 8 bytes at all three sizes, so `n` is the only variable.
# This is not a hypothetical: unpadded, the sweep read medians 103/110/113ns and
# that 9% slope was written up as cache residency. Padded it reads 112/113/119,
# so the 5-to-50 step of +7ns disappears outright while the 5-to-500 slope only
# falls from 9.5ns to 7ns. The padding is the only change that CAN have done
# that — the other edit here, dropping the modulo, is the same constant in all
# three arms and moves the level, never the slope.
#
# `width = 1` disables padding, which is the oracle's own shape. Arms with no
# sweep to protect pass it.
fn _b_tool_names(n, width): i64 {
    var names = vec_new();
    for (var i = 0; i < n; i = i + 1) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "tool_");
        _b_add_padded(sb, i, width);
        vec_push(names, str_builder_build(sb));
    }
    return names;
}

# A registry holding one named stub per name. `nm` is passed twice on purpose:
# once as the tool's name, once as its `ctx` — that is the whole NamedEcho trick.
fn _b_registry_of(names): i64 {
    var reg = agnosai_tool_registry_new();
    var desc = str_from("Named echo stub for benchmarking");
    for (var i = 0; i < vec_len(names); i = i + 1) {
        var nm = vec_get(names, i);
        agnosai_tool_registry_register(reg,
        agnosai_tool_new(nm, desc, &_b_named_schema, &_agnosai_echo_execute, nm));
    }
    return reg;
}

# The oracle's `ToolRegistry::get` family (tools.rs:58-82, :152-163) at one
# size. Called at 5, 50 and 500 so the three numbers divide against each other:
# a hashmap that has grown through ~6 doublings must not lose to one that never
# grew, and this is the arm that would show it if it did.
#
# The key cycles across the whole registry, so consecutive iterations land in
# different buckets. The `vec_get` that costs is a bounds-check and a load,
# inside the timed body for all three arms equally.
#
# The cursor is a wrapping increment rather than `i % n_tools`. `n_tools` is a
# runtime parameter, so that modulo was a genuine 64-bit divide on every
# iteration — the same constant in all three arms, so it never touched the
# slope, but it padded all three absolute numbers and shrank the very
# percentage this family exists to report.
#
# Medians over ten runs: 112ns at 5, 113ns at 50, 119ns at 500 (whole-sample
# ranges 109-118, 109-117, 115-139 — they overlap, and only the medians separate
# them, which is itself the headline). Five and fifty do not differ AT ALL; five
# hundred costs ~7ns more.
#
# That ~7ns is PROBE LENGTH, not cache — the opposite of what this comment said
# before the keys were padded. A doubling table cannot hold its load factor
# fixed while `n` moves by powers of ten: 5/16 = 0.31, 50/128 = 0.39,
# 500/1024 = 0.49. Simulating `lib/hashmap.cyr`'s own insert order over these
# exact fixtures puts the mean hit at 1.00 probes for both 5 and 50, and 1.23 at
# 500. An extra probe costs a slot load plus a key comparison, and the has-pair
# below prices a comparison at ~26ns, so 0.23 x 26 ≈ 6ns against a measured ~7ns
# step — accounted for, with nothing left over needing a working-set
# explanation. Call that order-of-magnitude, not a decomposition; the point is
# that no term is missing.
#
# So the answer the family was asked for is "flat" — but flat BECAUSE the load
# factor barely moves, which is the assumption to re-check if the 70% ceiling or
# the growth factor in `lib/hashmap.cyr` ever changes.
fn _b_registry_get_n(name, n_tools, iters): i64 {
    var names = _b_tool_names(n_tools, 3);
    var reg = _b_registry_of(names);
    _b_require(agnosai_tool_registry_get(reg, vec_get(names, 0)),
    "tools.bcyr: get sweep misses on its first key — timing lookup failures\n");
    _b_require(agnosai_tool_registry_get(reg, vec_get(names, n_tools - 1)),
    "tools.bcyr: get sweep misses on its last key — timing lookup failures\n");

    var k = 0;
    var b = bench_new(name);
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < iters / _BR; i = i + 1) {
            agnosai_tool_registry_get(reg, vec_get(names, k));
            k = k + 1;
            if (k == n_tools) { k = 0; }
        }
        bench_batch_stop(b, iters / _BR);
    }
    bench_report(b);
    return 0;
}

# One arm of the oracle's `ToolRegistry::has` pair (tools.rs:111-129).
fn _b_registry_has(name, reg, key: Str, iters): i64 {
    var b = bench_new(name);
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < iters / _BR; i = i + 1) { agnosai_tool_registry_has(reg, key); }
        bench_batch_stop(b, iters / _BR);
    }
    bench_report(b);
    return 0;
}

# Hit and miss over ONE 50-entry registry, as the oracle does. The pair is the
# point: an open-addressed probe stops at the key on a hit but has to walk to
# the first empty slot on a miss, so in general the two are different probe
# lengths and a single number would hide whichever is worse.
#
# Both keys are 8 bytes, and both land on their home bucket in exactly ONE
# probe, so the arms differ in one thing only: the hit runs a successful
# `str_eq`, the miss finds an empty slot and runs none. `tool_999` is not a
# rigged pick — simulating `lib/hashmap.cyr`'s insert order over this fixture
# puts 622 of the 950 absent `tool_NNN` keys at a single probe, so one probe is
# the modal miss, and every one of the 50 hit keys is at one probe too.
#
# Medians over ten runs: 107ns hit against 81ns miss (ranges 102-111 and
# 77-84). The miss is a fifth CHEAPER, and the ~26ns gap is the price of one
# 8-byte `str_eq` — a fifth of a whole registry lookup, which is a larger share
# than the futex pair. That gap is the most reproducible number in the file: it
# held at 25-27ns across all ten runs while both levels themselves drifted 8%.
#
# ⚠ This comment used to read "107ns hit / 109ns miss — indistinguishable, and
# that is the finding." It was not a finding, it was two confounds cancelling.
# The key was the oracle's `"nonexistent"`: 11 bytes against a fixture of 6-7,
# and 4 probes against the hit's 2. The extra probes cost nothing, because
# `str_eq` (`lib/str.cyr:163`) compares lengths first and rejects an 11-byte key
# against a 7-byte one without ever reaching `memeq`. Longer walk, free
# comparisons, and the two errors landed on top of the real ~26ns difference.
#
# What the pair does NOT measure is the mean miss: absent keys average 1.91
# probes over this fixture against the hit's 1.00. A fixed key buys a stable
# series at the price of standing for one probe sequence. A registry that ever
# ran hot enough to make hit and miss diverge the OTHER way would be one where
# the probe, not the lock, had become the cost — that inversion is what the pair
# is here to detect.
fn _b_registry_has_pair(): i64 {
    var reg = _b_registry_of(_b_tool_names(50, 3));
    var hit = str_from("tool_025");
    var miss = str_from("tool_999");
    _b_require(agnosai_tool_registry_has(reg, hit),
    "tools.bcyr: has hit key is absent — both arms would be measuring a miss\n");
    _b_require(agnosai_tool_registry_has(reg, miss) == 0,
    "tools.bcyr: has miss key is present — both arms would be measuring a hit\n");
    _b_registry_has("tool_registry_has_50_hit", reg, hit, 500000);
    _b_registry_has("tool_registry_has_50_miss", reg, miss, 500000);
    return 0;
}

# The oracle's `ToolRegistry::list` family (tools.rs:86-92, :165-171) — the
# `GET /api/v1/tools` response body. Every entry's `schema_fp` is re-invoked per
# call, so this is `n_tools` schema structs, `n_tools` parameter structs and four
# `Str` HEADERS each, per request.
#
# Headers, not copies: `str_from_a` (`lib/str.cyr:24`) allocates 16 bytes and
# BORROWS the literal — no bytes move. Per tool the arena takes 24 (schema) +
# 152 (the parameter vec: a 24-byte header plus a 16-slot backing array) + 32
# (the one parameter) + 64 (four Str headers) = 272 B. The parameter VEC, not
# the strings, is the term that dominates — a fact worth having, because it says
# a schema with one parameter and a schema with sixteen cost the same arena.
#
# At 500 tools that is 500 x 272 = 136,000 B, plus 16,176 B for the doubling
# chains of the two outer vecs in `agnosai_tool_registry_list_a`, = 152,176 B.
# `arena_used` confirms 152,176 exactly, and 15,440 at 50 tools. The 4 MB arena
# is 27x the 500-tool high-water — one mmap at setup, and the headroom is free
# because `arena_allocator` is fixed capacity (`lib/alloc.cyr:740`) and returns 0
# rather than growing.
#
# The `reset_via` sits inside the timed body because a request pays it; hoisting
# it would flatter the arena arm by hiding its only per-request cost. One untimed
# warm-up call first, so the first-touch page faults on the fresh arena land
# outside the measurement — and that call is where the schema count is checked,
# because a `list` that had silently stopped returning anything would still time
# perfectly cleanly.
#
# Medians over ten runs: 12.57µs at 50 and 122.8µs at 500 (ranges 12.25-13.13
# and 120.2-128.1) — 251ns and 246ns per tool. Linear to within 2%, with no fixed
# overhead worth naming, which says the whole cost is the per-tool schema rebuild
# and none of it is the lock or the vecs. It also sets the scale of the route: a
# 500-tool deployment pays ~123µs of pure CPU on every `GET /api/v1/tools`. That
# is the number that would justify caching the listing, and it did not exist
# before this arm.
fn _b_registry_list_n(name, n_tools, iters): i64 {
    var reg = _b_registry_of(_b_tool_names(n_tools, 1));
    var ar = arena_allocator(4194304);
    var warm = agnosai_tool_registry_list_a(ar, reg);
    _b_require(vec_len(warm) == n_tools,
    "tools.bcyr: list returned the wrong schema count — arm would time an empty walk\n");
    reset_via(ar);

    var b = bench_new(name);
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < iters / _BR; i = i + 1) {
            agnosai_tool_registry_list_a(ar, reg);
            reset_via(ar);
        }
        bench_batch_stop(b, iters / _BR);
    }
    bench_report(b);
    return 0;
}

# The oracle's `ToolRegistry::register` throughput (tools.rs:96-107): repeated
# insert into an ever-growing registry, so the reported per-op figure is the
# AMORTISED insert including every rehash — 100k entries is 14 doublings, cap 16
# through 262144.
#
# The tools and their names are built before the timer starts. The oracle builds
# an `Arc<NamedEcho>` with a `format!`ed name inside its loop and therefore
# reports insert+allocate; here the loop is insert only, which is the number the
# registry can actually be held to. What remains inside the window and is the
# port's own cost, not the oracle's, is the `str_clone(name)` at
# `src/tools/registry.cyr:46` — Cyrius has no move, so the key is copied.
#
# Median 619ns amortised over ten runs (range 596-673), so ~62ms for the 100k
# inserts — far under the O(n²) a per-insert linear scan would produce, which is
# the thing this arm is really asserting: grow is amortised O(1).
#
# ⚠ Read it as "roughly 620ns, ±6%", and do NOT read a 5% move as a regression.
# This is the widest band in the file — the lookup arms hold ±4% — because it is
# the only arm whose TIMED body faults in fresh pages. `_map_grow` allocates
# `new_cap*24` on the no-free global bump at every doubling, 12.6 MB in total and
# each block freshly memset, on top of ~3.2 MB of `str_clone` buffers and Str
# headers. The grow work is legitimately part of an amortised insert. The
# first-touch page-fault cost is not, and it is what moves run to run.
#
# ⚠ The reported min/max are NOT a variance estimate. `bench_batch_stop` runs
# once per arm, here and everywhere else in this file, so min == max == avg by
# construction. The band above is six separate process runs, which is the only
# way this harness can show spread.
#
# Registration happens at startup, so this is a boot-cost number, not a
# steady-state one; it is here so a regression in `_map_grow` has somewhere to
# show up. It is ~5x a `get`, but on a 262144-slot table against the sweep's
# 1024 — an order of magnitude, not a ratio, and not a comparison this file
# actually measures.
fn _b_registry_register(): i64 {
    var n = 100000;
    var names = _b_tool_names(n, 1);
    var desc = str_from("Named echo stub for benchmarking");
    var tools = vec_new();
    for (var i = 0; i < n; i = i + 1) {
        var nm = vec_get(names, i);
        vec_push(tools,
        agnosai_tool_new(nm, desc, &_b_named_schema, &_agnosai_echo_execute, nm));
    }

    # ⚠ **Deliberately NOT rounds x batch (D4), and this is the one row in the
    # tree where rounds would be WRONG rather than merely different.** The
    # registry ACCUMULATES: each insert grows the map the next insert hashes
    # into. Splitting the batch into rounds either re-registers the same slice
    # (which the `_b_require` below caught immediately — the count came back
    # n/_BR, not n) or measures five samples at five different fill levels, so
    # the min/max would report map growth rather than run-to-run dispersion.
    #
    # A single batch over a monotonically growing structure is the honest shape
    # here. `min == max == avg` on this row is therefore expected and correct,
    # not the artefact D4 removed everywhere else.
    var reg = agnosai_tool_registry_new();
    var b = bench_new("tool_registry_register");
    bench_batch_start(b);
    for (var k = 0; k < n; k = k + 1) {
        agnosai_tool_registry_register(reg, vec_get(tools, k));
    }
    bench_batch_stop(b, n);
    _b_require(agnosai_tool_registry_count(reg) == n,
    "tools.bcyr: register left the wrong count — inserts collided or no-opped\n");
    bench_report(b);
    return 0;
}

# A full tool call through the vtable: input build, dispatch, output. Echo is
# the cheapest possible body, so what this measures is the dispatch itself.
fn _b_tool_execute_echo(): i64 {
    var tool = agnosai_echo_tool();
    var msg = bayan_json_v_str_new(str_from("hello"));
    var key = str_from("message");
    var n = 200000;
    var b = bench_new("tool_execute_echo");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            var input = agnosai_tool_input_new();
            agnosai_tool_input_set(input, key, msg);
            agnosai_tool_execute(tool, input);
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# The form-urlencoded serialiser the stdlib does not have. It runs once per
# mneme_search over a user-supplied query, so its cost is bounded by query
# length — but it is a per-byte branch chain, so the number is worth having.
fn _b_form_encode(): i64 {
    var q = str_from("distributed systems consensus & raft: a survey (2024)");
    var n = 200000;
    var b = bench_new("agnos_form_encode_52b");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            var sb = str_builder_new();
            agnosai_agnos_form_encode(sb, q);
            str_builder_build(sb);
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# The path-traversal guard, which every path-interpolating ecosystem tool pays
# before it builds a URL.
fn _b_segment_ok(): i64 {
    var seg = str_from("note-8f3a21c0-4b7e");
    var n = 500000;
    var b = bench_new("agnos_segment_ok");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) { agnosai_agnos_segment_ok(seg); }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

fn main() {
    alloc_init();
    # Hygiene, not a fix: nothing on the paths below logs at or above the stock
    # `SK_INFO`. `_agnosai_registry_log` (`src/tools/registry.cyr:163`) guards on
    # `sakshi_get_level() < SK_DEBUG`, which is already true by default, and
    # load_testing's only ≤INFO logger sits inside `_agnosai_load_testing_execute`,
    # which no arm here calls. So this moves NO existing number — it is here so a
    # future default-level change cannot silently start timing a pipe write.
    sakshi_set_level(SK_FATAL);

    _b_aggregate_100k_10workers();
    _b_aggregate_100k_500workers();
    _b_aggregate_many_codes();
    _b_result_to_value();
    _b_is_safe_url();
    _b_is_safe_url_numeric();
    _b_registry_get();

    _b_registry_get_n("tool_registry_get_5", 5, 500000);
    _b_registry_get_n("tool_registry_get_50", 50, 500000);
    _b_registry_get_n("tool_registry_get_500", 500, 500000);
    _b_registry_has_pair();
    _b_registry_list_n("tool_registry_list_50", 50, 20000);
    # 10x the work per call, so 1/10th the iterations: both arms build 1e6
    # schemas in total and the two numbers divide cleanly into a per-tool cost.
    _b_registry_list_n("tool_registry_list_500", 500, 2000);
    _b_registry_register();

    _b_tool_execute_echo();
    _b_form_encode();
    _b_segment_ok();

    return 0;
}

var r = main();
syscall(60, r);
