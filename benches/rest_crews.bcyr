# =========================================================================
# rest_crews.bcyr — the server's own crews through its routes (ADR 037).
#
# No oracle. A file of its own, as the roadmap's 2.7.1 asks of crew rows. A two-task DAG crew with
# no gateway, so the placeholder path, posted, read and listed through the route functions in a
# request arena reset after each, with the registry's cap at 8 so every post past it evicts, and
# since 2.5.1 gives a crew back. The rows use only route functions 2.5.0 had, so the file runs on
# either tree; on 2.5.0 the crews stay on the global heap, and `rest_post_crew_2_tasks_kept_bytes`
# says how many bytes each leaves there.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/arena_pool.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/strcase.cyr"
include "src/telemetry/mod.cyr"
include "src/core/mod.cyr"
include "src/learning/mod.cyr"
include "src/llm/mod.cyr"
include "src/server/ssrf.cyr"
include "src/server/prompt_guard.cyr"
include "src/server/output_filter.cyr"
include "src/server/prometheus.cyr"
include "src/server/auth.cyr"
include "src/guarded_fetch.cyr"
include "src/chan_lossy.cyr"
include "src/server/sse.cyr"
include "src/sandbox/mod.cyr"
include "src/tools/mod.cyr"
include "src/orchestrator/mod.cyr"
include "src/server/state.cyr"
include "src/server/routes/mod.cyr"
include "src/server/routes/dashboard.cyr"
include "src/server/routes/crews.cyr"

# Rounds of batch/`_BR`, as every `.bcyr` runs them (*Settled decisions*).
var _BR = 5;

fn _b_body(): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"name\":\"rest-crew\",\"agents\":[{\"agent_key\":\"tester\",");
    str_builder_add_cstr(sb, "\"name\":\"Tester\",\"role\":\"tester\",\"goal\":\"test things\"}],");
    str_builder_add_cstr(sb, "\"tasks\":[{\"description\":\"one\"},{\"description\":\"two\",");
    str_builder_add_cstr(sb, "\"dependencies\":[0]}],\"process\":\"dag\"}");
    return str_builder_build(sb);
}

fn _b_state(): i64 {
    var bus = agnosai_event_bus_new();
    var o = agnosai_orchestrator_new(agnosai_resource_budget_default());
    agnosai_orchestrator_with_audit(o, 0);
    agnosai_orchestrator_with_events(o, bus);
    return agnosai_app_state_new(o, agnosai_tool_registry_new(), agnosai_auth_config_new(), bus, 0,
      agnosai_orchestrator_approval_gate(o));
}

# Post one crew; its id, copied into `ka`, for the reads.
fn _b_post(state, ra, body, ka): i64 {
    var r = agnosai_route_create_crew_tp_a(ra, state, body, 0);
    if (agnosai_route_status(r) != HTTP_OK) { syscall(60, 1); }
    var id = str_clone_a(ka, bayan_json_v_str(bayan_json_v_obj_get_by_cstr(agnosai_route_body(r), "crew_id")));
    reset_via(ra);
    return id;
}

fn _b_post_row(state, ra, body): i64 {
    var n = 2000;
    var ka = arena_allocator_growable(4096);
    var b = bench_new("rest_post_crew_2_tasks");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            _b_post(state, ra, body, ka);
            reset_via(ka);
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

fn _b_get_row(state, ra, body): i64 {
    var n = 20000;
    var ka = arena_allocator_growable(4096);
    var id = _b_post(state, ra, body, ka);
    var b = bench_new("rest_get_crew_2_tasks");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            if (agnosai_route_status(agnosai_route_get_crew_a(ra, state, id)) != HTTP_OK) { syscall(60, 1); }
            reset_via(ra);
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

fn _b_history_row(state, ra): i64 {
    var n = 5000;
    var b = bench_new("rest_crew_history_8_crews");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            agnosai_route_crew_history_a(ra, state);
            reset_via(ra);
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# What a posted crew leaves on the global heap, once the registry is past its cap: the row's
# number is bytes, not nanoseconds.
fn _b_kept_row(state, ra, body): i64 {
    var ka = arena_allocator_growable(4096);
    for (var w = 0; w < 1100; w = w + 1) {
        _b_post(state, ra, body, ka);
        reset_via(ka);
    }
    var n = 500;
    var before = alloc_used();
    for (var i = 0; i < n; i = i + 1) {
        _b_post(state, ra, body, ka);
        reset_via(ka);
    }
    var kept = (alloc_used() - before) / n;
    var sb = str_builder_new_a(ka);
    str_builder_add_cstr_a(ka, sb, "  rest_post_crew_2_tasks_kept_bytes: ");
    str_builder_add_int_a(ka, sb, kept);
    str_builder_add_cstr_a(ka, sb, " B a crew, for good\n");
    var line = str_builder_build_a(ka, sb);
    sys_write(1, str_data(line), str_len(line));
    return 0;
}

fn main(): i64 {
    alloc_init();
    sakshi_set_level(SK_FATAL);
    AGNOSAI_MAX_RETAINED_CREWS = 8;
    AGNOSAI_CREWS_LOW_WATER = 4;
    var state = _b_state();
    var ra = arena_allocator_growable(65536);
    var body = _b_body();
    _b_post_row(state, ra, body);
    _b_get_row(state, ra, body);
    _b_history_row(state, ra);
    _b_kept_row(state, ra, body);
    return 0;
}

var r = main();
syscall(60, r);
