# =========================================================================
# telemetry.bcyr — benchmarks for the telemetry group.
#
# ⚠ **No bench had ever timed `src/telemetry/`.** `grep 'agnosai_otlp_'
# benches/*.bcyr` came back empty on 2026-08-12, so the span encoder — which
# every instrumented operation crosses — had no number at all, and the arena
# threading landed that day could have regressed it invisibly.
#
# There is NO oracle bench file to reproduce: `rust-old/benches/` has nothing
# for telemetry, because the oracle hands the whole transport to
# `hoosh::telemetry::init_otel` (`rust-old/src/telemetry/mod.rs:50`). ADR 003
# keeps hoosh a remote seam rather than linking it, so `otlp.cyr` is
# port-original and these shapes are chosen from what it actually does.
#
# ⚠ **What the threading change was expected to cost.** Every builder call now
# passes an allocator and dispatches through its vtable, where before it went
# straight to `default_alloc()`. That is real indirection on a hot path, and the
# reason `encode_span` and `ring_enqueue` are measured separately: the first
# isolates the encoder, the second adds the lock and the arena.
#
# ⚠ **`drain` is measured at two ring depths** so the slope stays legible. It
# concatenates every queued fragment, so it is linear in queue depth by
# construction; a single depth could hide a change in the constant.
#
# These numbers start the CYRIUS baseline. They are NOT comparable to
# rust-old/bench-history.csv. See CLAUDE.md.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/core/mod.cyr"
include "src/telemetry/genai.cyr"
include "src/telemetry/otlp.cyr"

# One fully-populated inference span. Built once so the loops measure encoding
# rather than construction.
# ────────────
# Every row in this file used to call `bench_batch_start`/`bench_batch_stop`
# EXACTLY ONCE, so `bench_batch_stop`'s per-op value was the only sample it ever
# saw and `min == max == avg` by construction — the dispersion column carried no
# information at all. `lib/bench.cyr`'s `bench_batch_stop` already folds each
# call's per-op figure into min/max, so N rounds give N real samples for free.
#
# ⚠ **Total work is UNCHANGED**: the inner loop bound and the batch size are both
# divided by `_BR`, so `rounds x batch` equals the old single batch. Integer
# division can shave a few iterations off a batch that does not divide evenly;
# `bench_iterations` reports the true accumulated count either way.
#
# ⚠ **This RE-BASELINES every row in this file.** `_bench_net` subtracts the
# measured clock floor once per `bench_batch_stop`, so five stops subtract it
# five times where one subtracted it once. Rows are not comparable across
# 2026-08-13. See roadmap D4.
var _BR = 5;

fn _b_tel_span(): i64 {
    # A `chat` span since ADR 023 — the old inference span's agent name and task
    # id belong to its `invoke_agent` parent now, so the encoded fragment is
    # shorter and these rows re-baseline on 2026-10-03.
    var s = agnosai_genai_chat_span(str_from("gpt-4o"), str_from("hoosh"));
    agnosai_genai_record_usage(s, 1234, 567, str_from("gpt-4o"));
    return s;
}

fn _b_tel_ctx(): i64 {
    return agnosai_otlp_ctx_new(0x0123456789abcdef, 0xfedcba9876543210,
      0x1122334455667788, 1000000, 2000000, AGNOSAI_OTLP_STATUS_OK);
}

# The encoder alone, on the global allocator — the `agnosai_otlp_span_json`
# convenience form the encoder tests use.
fn _b_tel_encode_span(): i64 {
    var span = _b_tel_span();
    var ctx = _b_tel_ctx();
    var n = 20000;
    var b = bench_new("otlp_encode_span");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) { agnosai_otlp_span_json(span, ctx); }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# Encode + queue through the ring: the production path, so it carries the mutex
# and the arena-threaded builders.
fn _b_tel_ring_enqueue(): i64 {
    var r = agnosai_otlp_ring_new();
    var span = _b_tel_span();
    var ctx = _b_tel_ctx();
    var svc = str_from("bench-svc");
    var n = 20000;
    var b = bench_new("otlp_ring_enqueue");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            agnosai_otlp_ring_enqueue(r, span, ctx);
            # Drain on the ring's own capacity so the arena is recycled rather than
            # spilling — spilling measures the global allocator, not this path.
            if (i % AGNOSAI_OTLP_RING_MAX == 0) { agnosai_otlp_ring_drain(r, svc); }
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# Drain at a fixed queue depth. `depth` spans are queued, then one drain is
# timed; repeated so the mean is stable.
fn _b_tel_ring_drain(depth, name): i64 {
    var r = agnosai_otlp_ring_new();
    var span = _b_tel_span();
    var ctx = _b_tel_ctx();
    var svc = str_from("bench-svc");
    var rounds = 200;
    var b = bench_new(name);
    for (var k = 0; k < rounds; k = k + 1) {
        for (var i = 0; i < depth; i = i + 1) { agnosai_otlp_ring_enqueue(r, span, ctx); }
        bench_start(b);
        agnosai_otlp_ring_drain(r, svc);
        bench_stop(b);
    }
    bench_report(b);
    return 0;
}

# The JSON escaper, on a value that actually escapes. The clean path and the
# escaping path are different loops, so both are worth a number.
fn _b_tel_json_escape(clean, name): i64 {
    var a = default_alloc();
    var v = str_from("plain agent name");
    if (clean == 0) { v = str_from("quote\" backslash\\ newline\n tab\t ctl\x01"); }
    var n = 50000;
    var b = bench_new(name);
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            var sb = str_builder_new_a(a);
            _agnosai_otlp_json_str_a(a, sb, v);
            str_builder_build_a(a, sb);
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# The POST URL construction added when the missing `/v1/traces` was fixed. It
# runs once per export, so it only has to be not-slow — but it allocates, and an
# unmeasured allocation on the export path is how the last one got missed.
fn _b_tel_post_url(): i64 {
    var a = default_alloc();
    var bare = str_from("http://localhost:4318");
    var pathed = str_from("http://localhost:4318/v1/traces");
    var n = 50000;
    var b = bench_new("otlp_post_url_append");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) { _agnosai_otlp_post_url(a, bare); }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);

    var b2 = bench_new("otlp_post_url_passthrough");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b2);
        for (var j = 0; j < n / _BR; j = j + 1) { _agnosai_otlp_post_url(a, pathed); }
        bench_batch_stop(b2, n / _BR);
    }
    bench_report(b2);
    return 0;
}

# ADR 023 — parsing an inbound `traceparent`. Runs once per crew that carries
# one, in the request arena on the HTTP path; measured on a reset arena so the
# row is the parse, not the allocator's growth.
fn _b_tel_span_context_parse(): i64 {
    var a = arena_allocator(4096);
    var tp = str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01");
    var n = 50000;
    var b = bench_new("otlp_span_context_parse");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            agnosai_otlp_span_context_parse_a(a, tp);
            reset_via(a);
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# ADR 023 — a child span context, which every span takes when telemetry is on.
# ⚠ Includes one `getrandom(2)` for the 8-byte span id: that syscall is the
# floor, and it replaced the 16-byte one `agnosai_uuid_v4` drew per span.
fn _b_tel_span_context_child(): i64 {
    var parent = agnosai_otlp_span_context_new(0x4bf92f3577b34da6, 0x0e0e4736a3ce929d,
      0x00f067aa0ba902b7, 1);
    var n = 20000;
    var b = bench_new("otlp_span_context_child");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) { agnosai_otlp_span_context_child(parent); }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

# The encoder on a CHILD span (ADR 023): `parentSpanId` plus the composed
# `chat gpt-4o` name, against `otlp_encode_span`'s root.
fn _b_tel_encode_span_child(): i64 {
    var span = _b_tel_span();
    var ctx = agnosai_otlp_ctx_new_child(0x0123456789abcdef, 0xfedcba9876543210,
      0x1122334455667788, 0x0aabbccddeeff001, 1000000, 2000000, AGNOSAI_OTLP_STATUS_OK);
    var n = 20000;
    var b = bench_new("otlp_encode_span_child");
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) { agnosai_otlp_span_json(span, ctx); }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    return 0;
}

fn main(): i64 {
    alloc_init();

    _b_tel_encode_span();
    _b_tel_encode_span_child();
    _b_tel_span_context_parse();
    _b_tel_span_context_child();
    _b_tel_ring_enqueue();
    _b_tel_ring_drain(16, "otlp_ring_drain_16");
    _b_tel_ring_drain(256, "otlp_ring_drain_256");
    _b_tel_json_escape(1, "otlp_json_escape_clean");
    _b_tel_json_escape(0, "otlp_json_escape_escaping");
    _b_tel_post_url();

    return 0;
}
