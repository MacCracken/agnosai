# =========================================================================
# load_test.bcyr — what one load-test request costs, on a loopback server (2.3.6).
#
# The two rows differ only in whether the server keeps the connection: `kept` is a request on a
# connection the worker already has, and `new_connection` answers `Connection: close`, so each
# request connects again. That is what a load test measured every time through 2.3.5, on loopback,
# where a handshake is at its cheapest and TLS is not involved.
#
# Its own file, not rows in `tools.bcyr`: including a server thread there would move every row
# already recorded, by the position effects `bench-history.csv` cannot tell from a change.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/arena_pool.cyr"
include "src/id.cyr"
include "src/telemetry/mod.cyr"
include "src/order.cyr"
include "src/core/error.cyr"
include "src/core/json.cyr"
include "src/core/message.cyr"
include "src/core/resource.cyr"
include "src/core/task.cyr"
include "src/strcase.cyr"
include "src/llm/retry.cyr"
include "src/server/ssrf.cyr"
include "src/server/output_filter.cyr"
include "src/tools/native.cyr"
include "src/tools/registry.cyr"
include "src/tool_call.cyr"
include "src/tools/builtin/load_testing.cyr"

# Rounds per row, each a batch of `n / _BR` calls.
var _BR = 5;

var _B_LFD = 0;
var _B_PORT = 0;
var _B_ANSWER = 0;

var _B_KEEP = "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok";
var _B_CLOSES = "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Length: 2\r\n\r\nok";

fn _b_conn(cfd): i64 {
    var buf[2048];
    while (sys_read(cfd, &buf, 2048) > 0) {
        var r = _B_ANSWER;
        sys_write(cfd, r, strlen(r));
        if (r == _B_CLOSES) { break; }
    }
    sock_close(cfd);
    return 0;
}

fn _b_server(arg): i64 {
    while (1 == 1) {
        var at, cfd = sock_accept(_B_LFD);
        if (is_err_result(at) == 0) { thread_create_detached(&_b_conn, cfd); }
    }
    return 0;
}

fn _b_server_start(): i64 {
    var lt, lfd = tcp_socket();
    sock_reuse(lfd);
    var lp = 47981;
    while (lp < 48013 && _B_PORT == 0) {
        var bt, bv = sock_bind(lfd, INADDR_LOOPBACK(), lp);
        if (is_err_result(bt) == 0) { _B_PORT = lp; }
        lp = lp + 1;
    }
    if (_B_PORT == 0) { return 0; }
    var st, sv = sock_listen(lfd, 64);
    if (is_err_result(st) == 1) { return 0; }
    _B_LFD = lfd;
    thread_create_detached(&_b_server, 0);
    return 1;
}

fn _b_url(): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "http://127.0.0.1:");
    str_builder_add_int(sb, _B_PORT);
    str_builder_add_cstr(sb, "/");
    return str_builder_build(sb);
}

fn _b_request(name, answer, n): i64 {
    _B_ANSWER = answer;
    var w = agnosai_lt_worker_new(_b_url(), clock_now_ns() + 600000000000, n, &agnosai_lt_http_executor, 0);
    var scratch = agnosai_lt_worker_scratch(w);
    # One outside the timing, so the first row is not the arenas' first touch.
    agnosai_lt_http_executor(w);
    reset_via(scratch);
    var b = bench_new(name);
    for (var _r = 0; _r < _BR; _r = _r + 1) {
        bench_batch_start(b);
        for (var i = 0; i < n / _BR; i = i + 1) {
            agnosai_lt_http_executor(w);
            reset_via(scratch);
        }
        bench_batch_stop(b, n / _BR);
    }
    bench_report(b);
    agnosai_lt_worker_release(w);
    return 0;
}

fn main() {
    alloc_init();
    sakshi_set_level(SK_FATAL);
    if (_b_server_start() == 0) { return 1; }
    _b_request("load_test_request_kept", _B_KEEP, 20000);
    _b_request("load_test_request_new_connection", _B_CLOSES, 5000);
    return 0;
}

var r = main();
sys_exit_group(r);
