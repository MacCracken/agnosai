# =========================================================================
# llm/hoosh — the hoosh seam client.
#
# No single oracle file. This replaces the `pub use hoosh::…` facade in
# rust-old/src/llm/mod.rs, which cannot survive the port: hoosh in Cyrius is a
# BINARY (no `dist/`, no `[lib]` stanza), so it is consumed as a **remote HTTP
# seam** rather than linked. The reference implementation is
# `thoth/src/hoosh.cyr`, and the ADR behind that shape is thoth's
# `docs/architecture/001-consumer-only-no-domain-logic.md`.
#
# What this module provides is the OpenAI-compatible chat-completions round
# trip plus the inference types the rest of agnosai consumes — `Message`,
# `Role`, `ProviderType`, `InferenceRequest`, `InferenceResponse`, and the
# client itself (`HooshClient`).
#
# Deliberately NOT here, because an HTTP seam has no client-side equivalent:
# AuditChain, ResponseCache, CostTracker, TokenBudget, DlpScanner,
# RateLimitRegistry and the metrics registry. hoosh implements those
# server-side. Every agnosai consumer of them is in orchestrator (M5) or
# server (M6) — see the header of src/llm/mod.cyr for the measured reference counts
# and why that decision belongs to those milestones.
#
# Naming: LLM chat messages are `agnosai_chat_*`, NOT `agnosai_message_*` —
# the latter is core_message's inter-agent Message, and Cyrius has ONE flat
# namespace.
#
# Everything here is pure except `agnosai_hoosh_chat` and `agnosai_hoosh_get_a`, the two I/O
# call. That split is deliberate: it is what lets the builders and extractors
# be unit-tested with no gateway running.
# =========================================================================

# Message role in an OpenAI-compatible conversation.
#
# This is the LLM role, not fleet's consensus `Role` (Coordinator / Follower /
# Candidate) — the oracle has two unrelated enums by that name.
enum AgnosaiChatRole {
    AGNOSAI_ROLE_SYSTEM = 0;
    AGNOSAI_ROLE_USER = 1;
    AGNOSAI_ROLE_ASSISTANT = 2;
    AGNOSAI_ROLE_TOOL = 3;
}

# LLM provider. These are the seven variants agnosai actually references.
#
# NOTE: the wire spellings below are the conventional `rename_all = "snake_case"`
# forms, but agnosai never puts a ProviderType on any wire it controls — the
# gateway is addressed by model string, and hoosh owns the provider mapping. If
# a caller ever needs these to match hoosh byte-for-byte, verify against hoosh
# rather than trusting this comment.
enum AgnosaiProviderType {
    AGNOSAI_PROVIDER_OPENAI = 0;
    AGNOSAI_PROVIDER_ANTHROPIC = 1;
    AGNOSAI_PROVIDER_GOOGLE = 2;
    AGNOSAI_PROVIDER_MISTRAL = 3;
    AGNOSAI_PROVIDER_DEEPSEEK = 4;
    AGNOSAI_PROVIDER_GROK = 5;
    AGNOSAI_PROVIDER_OLLAMA = 6;
}

# ChatMessage heap layout — 32 bytes. `TOOL_CALLS` is an assistant turn's vec of calls and
# `TOOL_CALL_ID` the call a `tool` turn answers, each 0 on every other message (ADR 029).
enum AgnosaiChatMessageOff {
    AGN_CHAT_ROLE = 0;
    AGN_CHAT_CONTENT = 8;
    AGN_CHAT_TOOL_CALLS = 16;
    AGN_CHAT_TOOL_CALL_ID = 24;
    AGN_CHAT_SIZE = 32;
}

# One tool call a model asked for, as the wire carries it — 24 bytes. `ARGUMENTS` is a Str of
# JSON, as OpenAI's shape has it, so it is not parsed until something means to use it.
enum AgnosaiChatToolCallOff {
    AGN_TCALL_ID = 0;
    AGN_TCALL_NAME = 8;
    AGN_TCALL_ARGUMENTS = 16;
    AGN_TCALL_SIZE = 24;
}

# InferenceRequest heap layout — 56 bytes.
enum AgnosaiInferenceReqOff {
    AGN_REQ_MODEL = 0;
    AGN_REQ_MESSAGES = 8;
    AGN_REQ_MAX_TOKENS = 16;
    AGN_REQ_TEMPERATURE_MILLI = 24;
    AGN_REQ_STREAM = 32;
    # The allocator this request and its answer come from (ADR 028).
    AGN_REQ_ALLOC = 40;
    # The bayan array of tool definitions offered to the model, or 0 (ADR 029).
    AGN_REQ_TOOLS = 48;
    AGN_INFER_REQ_SIZE = 56;
}

# InferenceResponse heap layout — 72 bytes.
enum AgnosaiInferenceRespOff {
    AGN_RESP_CONTENT = 0;
    AGN_RESP_MODEL = 8;
    AGN_RESP_PROMPT_TOKENS = 16;
    AGN_RESP_COMPLETION_TOKENS = 24;
    AGN_RESP_FINISH_REASON = 32;
    AGN_RESP_COST_MICRO_USD = 40;
    AGN_RESP_PROVIDER = 48;
    AGN_RESP_CACHE = 56;
    # The vec of tool calls the model asked for, or 0 for a final answer (ADR 029).
    AGN_RESP_TOOL_CALLS = 64;
    # How long the model call took, in milliseconds, as this process measured it.
    AGN_RESP_LATENCY_MS = 72;
    AGN_RESP_SIZE = 80;
}

# The default gateway base URL — a local `hoosh serve 8088`.
fn agnosai_hoosh_default_url(): i64 {
    return str_from("http://127.0.0.1:8088");
}

# The OpenAI-compatible chat-completions path.
fn agnosai_hoosh_chat_path(): i64 {
    return str_from("/v1/chat/completions");
}

# The OpenAI-compatible model-list path.
fn agnosai_hoosh_models_path(): i64 {
    return str_from("/v1/models");
}

# What hoosh lists each provider as serving now, with prices and capabilities (hoosh ADR 012).
fn agnosai_hoosh_catalog_path(): i64 {
    return str_from("/v1/models/catalog");
}

# Join a gateway base URL and a path, trimming exactly one trailing '/' from the
# base — the same convention thoth's `_hoosh_endpoint_url` uses, so a base
# configured with or without a trailing slash yields the same endpoint.
fn agnosai_hoosh_join_url(base: Str, path: Str): i64 {
    var blen = str_len(base);
    if (blen > 0) {
        if (load8(str_data(base) + blen - 1) == 47) { blen = blen - 1; }
    }
    var sb = str_builder_new();
    str_builder_add(sb, str_new(str_data(base), blen));
    str_builder_add(sb, path);
    return str_builder_build(sb);
}

# The chat-completions endpoint for a gateway base URL.
fn agnosai_hoosh_endpoint(base: Str): i64 {
    return agnosai_hoosh_join_url(base, agnosai_hoosh_chat_path());
}

# The model-list endpoint for a gateway base URL.
fn agnosai_hoosh_models_endpoint(base: Str): i64 {
    return agnosai_hoosh_join_url(base, agnosai_hoosh_models_path());
}

# The wire spelling of a chat role.
fn agnosai_chat_role_to_wire_a(a, role): i64 {
    if (role == AGNOSAI_ROLE_SYSTEM) { return str_from_a(a, "system"); }
    if (role == AGNOSAI_ROLE_ASSISTANT) { return str_from_a(a, "assistant"); }
    if (role == AGNOSAI_ROLE_TOOL) { return str_from_a(a, "tool"); }
    return str_from_a(a, "user");
}

# Global-allocator form of `agnosai_chat_role_to_wire_a`.
#
# **The wire spellings were the whole residual.** With every JSON node threaded,
# `to_json_a` still grew the global bump because each role rendered through a
# bare `str_from` — four literals per request, invisible against the tree until
# the tree stopped allocating. Same shape core hit, and the arena-flat assertion
# in `llm_hoosh.tcyr` is what caught it here.
fn agnosai_chat_role_to_wire(role): i64 {
    return agnosai_chat_role_to_wire_a(default_alloc(), role);
}

# A chat role from its wire spelling. Unknown spellings read as User.
fn agnosai_chat_role_from_wire(s: Str): i64 {
    if (str_eq_cstr(s, "system") == 1) { return AGNOSAI_ROLE_SYSTEM; }
    if (str_eq_cstr(s, "assistant") == 1) { return AGNOSAI_ROLE_ASSISTANT; }
    if (str_eq_cstr(s, "tool") == 1) { return AGNOSAI_ROLE_TOOL; }
    return AGNOSAI_ROLE_USER;
}

# The snake_case spelling of a provider. See the enum's note on wire fidelity.
fn agnosai_provider_to_wire(provider): i64 {
    return agnosai_provider_to_wire_a(default_alloc(), provider);
}

# `agnosai_provider_to_wire`, in allocator `a`.
fn agnosai_provider_to_wire_a(a, provider): i64 {
    if (provider == AGNOSAI_PROVIDER_ANTHROPIC) { return str_from_a(a, "anthropic"); }
    if (provider == AGNOSAI_PROVIDER_GOOGLE) { return str_from_a(a, "google"); }
    if (provider == AGNOSAI_PROVIDER_MISTRAL) { return str_from_a(a, "mistral"); }
    if (provider == AGNOSAI_PROVIDER_DEEPSEEK) { return str_from_a(a, "deep_seek"); }
    if (provider == AGNOSAI_PROVIDER_GROK) { return str_from_a(a, "grok"); }
    if (provider == AGNOSAI_PROVIDER_OLLAMA) { return str_from_a(a, "ollama"); }
    return str_from_a(a, "open_ai");
}

# A provider from its spelling. Unknown spellings read as OpenAi.
fn agnosai_provider_from_wire(s: Str): i64 {
    if (str_eq_cstr(s, "anthropic") == 1) { return AGNOSAI_PROVIDER_ANTHROPIC; }
    if (str_eq_cstr(s, "google") == 1) { return AGNOSAI_PROVIDER_GOOGLE; }
    if (str_eq_cstr(s, "mistral") == 1) { return AGNOSAI_PROVIDER_MISTRAL; }
    if (str_eq_cstr(s, "deep_seek") == 1) { return AGNOSAI_PROVIDER_DEEPSEEK; }
    if (str_eq_cstr(s, "grok") == 1) { return AGNOSAI_PROVIDER_GROK; }
    if (str_eq_cstr(s, "ollama") == 1) { return AGNOSAI_PROVIDER_OLLAMA; }
    return AGNOSAI_PROVIDER_OPENAI;
}

# Create a chat message.
fn agnosai_chat_message_new(role, content: Str): i64 {
    return agnosai_chat_message_new_a(default_alloc(), role, content);
}

# `agnosai_chat_message_new`, in allocator `a`.
fn agnosai_chat_message_new_a(a, role, content: Str): i64 {
    var m = alloc_via(a, AGN_CHAT_SIZE);
    store64(m + AGN_CHAT_ROLE, role);
    store64(m + AGN_CHAT_CONTENT, content);
    store64(m + AGN_CHAT_TOOL_CALLS, 0);
    store64(m + AGN_CHAT_TOOL_CALL_ID, 0);
    return m;
}

# The message's role.
fn agnosai_chat_message_role(m): i64 {
    return load64(m + AGN_CHAT_ROLE);
}

# The message's content.
fn agnosai_chat_message_content(m): i64 {
    return load64(m + AGN_CHAT_CONTENT);
}

# The tool calls an assistant message carries, or 0.
fn agnosai_chat_message_tool_calls(m): i64 {
    return load64(m + AGN_CHAT_TOOL_CALLS);
}

# The call a `tool` message answers, or 0.
fn agnosai_chat_message_tool_call_id(m): i64 {
    return load64(m + AGN_CHAT_TOOL_CALL_ID);
}

# Create a tool call. `arguments` is the Str of JSON the model wrote.
fn agnosai_chat_tool_call_new_a(a, id: Str, name: Str, arguments: Str): i64 {
    var c = alloc_via(a, AGN_TCALL_SIZE);
    store64(c + AGN_TCALL_ID, id);
    store64(c + AGN_TCALL_NAME, name);
    store64(c + AGN_TCALL_ARGUMENTS, arguments);
    return c;
}

# The call's id, which the `tool` message answering it repeats. 0 when the model sent none.
fn agnosai_chat_tool_call_id(c): i64 {
    return load64(c + AGN_TCALL_ID);
}

# The name of the tool the model asked for. Model output: nothing has checked it.
fn agnosai_chat_tool_call_name(c): i64 {
    return load64(c + AGN_TCALL_NAME);
}

# The arguments the model wrote, a Str of JSON. Model output: nothing has parsed it.
fn agnosai_chat_tool_call_arguments(c): i64 {
    return load64(c + AGN_TCALL_ARGUMENTS);
}

# A tool call as its OpenAI wire form:
# `{"id":"...","type":"function","function":{"name":"...","arguments":"..."}}`.
fn agnosai_chat_tool_call_to_value_a(a, c): i64 {
    var fun = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, fun, str_from_a(a, "name"),
      bayan_json_v_str_new_a(a, load64(c + AGN_TCALL_NAME)));
    bayan_json_v_obj_set_a(a, fun, str_from_a(a, "arguments"),
      bayan_json_v_str_new_a(a, load64(c + AGN_TCALL_ARGUMENTS)));

    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "id"),
      bayan_json_v_str_new_a(a, load64(c + AGN_TCALL_ID)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "type"),
      bayan_json_v_str_new_a(a, str_from_a(a, "function")));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "function"), fun);
    return obj;
}

# A chat message as a bayan JSON value: `{"role":"user","content":"..."}`, with `tool_calls`
# on an assistant turn that made some and `tool_call_id` on the turn that answers one. Both
# keys are absent otherwise, so a request with no tools is byte for byte what it was, and
# hoosh keys its cache on those bytes.
fn agnosai_chat_message_to_value_a(a, m): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "role"),
      bayan_json_v_str_new_a(a, agnosai_chat_role_to_wire_a(a, load64(m + AGN_CHAT_ROLE))));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "content"),
      bayan_json_v_str_new_a(a, load64(m + AGN_CHAT_CONTENT)));

    var calls = load64(m + AGN_CHAT_TOOL_CALLS);
    if (calls != 0) {
        var arr = bayan_json_v_arr_new_a(a);
        for (var i = 0; i < vec_len(calls); i = i + 1) {
            bayan_json_v_arr_push_a(a, arr, agnosai_chat_tool_call_to_value_a(a, vec_get(calls, i)));
        }
        bayan_json_v_obj_set_a(a, obj, str_from_a(a, "tool_calls"), arr);
    }
    var call_id = load64(m + AGN_CHAT_TOOL_CALL_ID);
    if (call_id != 0) {
        bayan_json_v_obj_set_a(a, obj, str_from_a(a, "tool_call_id"),
          bayan_json_v_str_new_a(a, call_id));
    }
    return obj;
}

# Global-allocator form of `agnosai_chat_message_to_value_a`.
fn agnosai_chat_message_to_value(m): i64 {
    return agnosai_chat_message_to_value_a(default_alloc(), m);
}

# Create an inference request for a model. `max_tokens` and `temperature` start
# unset; streaming starts off.
fn agnosai_inference_request_new(model: Str): i64 {
    return agnosai_inference_request_new_a(default_alloc(), model);
}

# `agnosai_inference_request_new`, in allocator `a`. The request remembers `a`, so
# the chat call's contract stays `fn(client, request, out_response, parent_sc)` and
# the answer lands where the request lives: a suite's stub reads it the same way.
fn agnosai_inference_request_new_a(a, model: Str): i64 {
    var r = alloc_via(a, AGN_INFER_REQ_SIZE);
    store64(r + AGN_REQ_MODEL, model);
    store64(r + AGN_REQ_MESSAGES, vec_new_a(a));
    store64(r + AGN_REQ_MAX_TOKENS, AGNOSAI_NO_LIMIT);
    store64(r + AGN_REQ_TEMPERATURE_MILLI, AGNOSAI_NO_LIMIT);
    store64(r + AGN_REQ_STREAM, 0);
    store64(r + AGN_REQ_ALLOC, a);
    store64(r + AGN_REQ_TOOLS, 0);
    return r;
}

# The allocator this request and its answer come from.
fn agnosai_inference_request_alloc(r): i64 {
    return load64(r + AGN_REQ_ALLOC);
}

# Append a message. Returns the request so calls chain.
fn agnosai_inference_request_with_message(r, m): i64 {
    vec_push_a(load64(r + AGN_REQ_ALLOC), load64(r + AGN_REQ_MESSAGES), m);
    return r;
}

# Append a message built from a role and content. Returns the request.
fn agnosai_inference_request_say(r, role, content: Str): i64 {
    var a = load64(r + AGN_REQ_ALLOC);
    vec_push_a(a, load64(r + AGN_REQ_MESSAGES), agnosai_chat_message_new_a(a, role, content));
    return r;
}

# Append the assistant turn that asked for `calls`, a vec of tool calls. Returns the request.
#
# The model's text goes with them, which is often empty. It stays a string rather than a null:
# hoosh's providers all take "" here, and one shape is one thing to get right.
fn agnosai_inference_request_say_tool_calls(r, content: Str, calls): i64 {
    var a = load64(r + AGN_REQ_ALLOC);
    var m = agnosai_chat_message_new_a(a, AGNOSAI_ROLE_ASSISTANT, content);
    store64(m + AGN_CHAT_TOOL_CALLS, calls);
    vec_push_a(a, load64(r + AGN_REQ_MESSAGES), m);
    return r;
}

# Append the `tool` turn answering call `call_id`. Returns the request.
fn agnosai_inference_request_say_tool_result(r, call_id: Str, content: Str): i64 {
    var a = load64(r + AGN_REQ_ALLOC);
    var m = agnosai_chat_message_new_a(a, AGNOSAI_ROLE_TOOL, content);
    store64(m + AGN_CHAT_TOOL_CALL_ID, call_id);
    vec_push_a(a, load64(r + AGN_REQ_MESSAGES), m);
    return r;
}

# Offer the model `tools`, a bayan array of OpenAI tool definitions (`agnosai_tool_definition_a`).
# Returns the request. 0 or an empty array offers none, and the key is left off the body.
fn agnosai_inference_request_with_tools(r, tools): i64 {
    store64(r + AGN_REQ_TOOLS, tools);
    return r;
}

# The tool definitions offered, or 0.
fn agnosai_inference_request_tools(r): i64 {
    return load64(r + AGN_REQ_TOOLS);
}

# Set the completion token ceiling. Returns the request.
fn agnosai_inference_request_with_max_tokens(r, max_tokens): i64 {
    store64(r + AGN_REQ_MAX_TOKENS, max_tokens);
    return r;
}

# Set the sampling temperature, in **thousandths** — 700 is 0.7. Integer
# milli-units for the same reason money is micro-USD: exact, and it leaves
# AGNOSAI_NO_LIMIT free to mean "unset" without colliding with a real 0.0.
# Returns the request.
fn agnosai_inference_request_with_temperature_milli(r, temperature_milli): i64 {
    store64(r + AGN_REQ_TEMPERATURE_MILLI, temperature_milli);
    return r;
}

# Turn streaming on (1) or off (0). Returns the request.
fn agnosai_inference_request_with_stream(r, stream): i64 {
    store64(r + AGN_REQ_STREAM, stream);
    return r;
}

# The model identifier the request targets.
fn agnosai_inference_request_model(r): i64 {
    return load64(r + AGN_REQ_MODEL);
}

# Vec of the request's messages.
fn agnosai_inference_request_messages(r): i64 {
    return load64(r + AGN_REQ_MESSAGES);
}

# The completion token ceiling, or AGNOSAI_NO_LIMIT.
fn agnosai_inference_request_max_tokens(r): i64 {
    return load64(r + AGN_REQ_MAX_TOKENS);
}

# The sampling temperature in thousandths, or AGNOSAI_NO_LIMIT.
fn agnosai_inference_request_temperature_milli(r): i64 {
    return load64(r + AGN_REQ_TEMPERATURE_MILLI);
}

# Whether the request asks for a streamed response.
fn agnosai_inference_request_stream(r): i64 {
    return load64(r + AGN_REQ_STREAM);
}

# The request as a bayan JSON value — the OpenAI-compatible chat-completions
# body. Unset optional fields are **omitted**, not sent as null: a gateway
# reading `"max_tokens": null` may reject it, and omission is what every
# OpenAI-compatible client does.
#
# When streaming, `stream_options.include_usage` is set so the gateway appends a
# final usage frame — without it a streamed turn carries no token count at all.
fn agnosai_inference_request_to_value_a(a, r): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "model"),
      bayan_json_v_str_new_a(a, load64(r + AGN_REQ_MODEL)));

    var msgs = load64(r + AGN_REQ_MESSAGES);
    var arr = bayan_json_v_arr_new_a(a);
    for (var i = 0; i < vec_len(msgs); i = i + 1) {
        bayan_json_v_arr_push_a(a, arr, agnosai_chat_message_to_value_a(a, vec_get(msgs, i)));
    }
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "messages"), arr);

    # Omitted when there are none, like every other unset field. OpenAI refuses an empty
    # `tools`, and a request that offers nothing must stay the bytes hoosh has cached.
    var tools = load64(r + AGN_REQ_TOOLS);
    if (tools != 0) {
        if (bayan_json_v_arr_len(tools) > 0) {
            bayan_json_v_obj_set_a(a, obj, str_from_a(a, "tools"), tools);
        }
    }

    var max_tokens = load64(r + AGN_REQ_MAX_TOKENS);
    if (max_tokens != AGNOSAI_NO_LIMIT) {
        bayan_json_v_obj_set_a(a, obj, str_from_a(a, "max_tokens"),
          bayan_json_v_int_new_a(a, max_tokens));
    }

    var temp = load64(r + AGN_REQ_TEMPERATURE_MILLI);
    if (temp != AGNOSAI_NO_LIMIT) {
        var tv = f64_div(f64_from(temp), f64_from(1000));
        bayan_json_v_obj_set_a(a, obj, str_from_a(a, "temperature"),
          bayan_json_v_float_new_a(a, tv));
    }

    var stream = load64(r + AGN_REQ_STREAM);
    if (stream == 1) {
        bayan_json_v_obj_set_a(a, obj, str_from_a(a, "stream"), bayan_json_v_bool_new_a(a, 1));
        var opts = bayan_json_v_obj_new_a(a);
        bayan_json_v_obj_set_a(a, opts, str_from_a(a, "include_usage"),
          bayan_json_v_bool_new_a(a, 1));
        bayan_json_v_obj_set_a(a, obj, str_from_a(a, "stream_options"), opts);
    } else {
        bayan_json_v_obj_set_a(a, obj, str_from_a(a, "stream"), bayan_json_v_bool_new_a(a, 0));
    }
    return obj;
}

# Global-allocator form of `agnosai_inference_request_to_value_a`.
fn agnosai_inference_request_to_value(r): i64 {
    return agnosai_inference_request_to_value_a(default_alloc(), r);
}

# The request serialized to the JSON body to POST.
fn agnosai_inference_request_to_json_a(a, r): Str {
    return bayan_json_v_build_a(a, agnosai_inference_request_to_value_a(a, r));
}

# Global-allocator form of `agnosai_inference_request_to_json_a`.
fn agnosai_inference_request_to_json(r): Str {
    return agnosai_inference_request_to_json_a(default_alloc(), r);
}

# Create an inference response.
fn agnosai_inference_response_new(content: Str, model: Str): i64 {
    return agnosai_inference_response_new_a(default_alloc(), content, model);
}

# `agnosai_inference_response_new`, in allocator `a`.
fn agnosai_inference_response_new_a(a, content: Str, model: Str): i64 {
    var r = alloc_via(a, AGN_RESP_SIZE);
    store64(r + AGN_RESP_CONTENT, content);
    store64(r + AGN_RESP_MODEL, model);
    store64(r + AGN_RESP_PROMPT_TOKENS, 0);
    store64(r + AGN_RESP_COMPLETION_TOKENS, 0);
    store64(r + AGN_RESP_FINISH_REASON, 0);
    store64(r + AGN_RESP_COST_MICRO_USD, AGNOSAI_NO_LIMIT);
    store64(r + AGN_RESP_PROVIDER, 0);
    store64(r + AGN_RESP_CACHE, AGNOSAI_HOOSH_CACHE_UNKNOWN);
    store64(r + AGN_RESP_TOOL_CALLS, 0);
    store64(r + AGN_RESP_LATENCY_MS, 0);
    return r;
}

# Copy of `r` in allocator `a`, every string its own, so it outlives an arena `r` lives in. The
# tool calls stay behind: a response is carried out of a conversation only once it has ended.
fn agnosai_inference_response_clone_a(a, r): i64 {
    var c = agnosai_inference_response_new_a(a, str_clone_a(a, load64(r + AGN_RESP_CONTENT)),
      str_clone_a(a, load64(r + AGN_RESP_MODEL)));
    store64(c + AGN_RESP_PROMPT_TOKENS, load64(r + AGN_RESP_PROMPT_TOKENS));
    store64(c + AGN_RESP_COMPLETION_TOKENS, load64(r + AGN_RESP_COMPLETION_TOKENS));
    store64(c + AGN_RESP_LATENCY_MS, load64(r + AGN_RESP_LATENCY_MS));
    store64(c + AGN_RESP_COST_MICRO_USD, load64(r + AGN_RESP_COST_MICRO_USD));
    store64(c + AGN_RESP_CACHE, load64(r + AGN_RESP_CACHE));
    var fin = load64(r + AGN_RESP_FINISH_REASON);
    if (fin != 0) { store64(c + AGN_RESP_FINISH_REASON, str_clone_a(a, fin)); }
    var provider = load64(r + AGN_RESP_PROVIDER);
    if (provider != 0) { store64(c + AGN_RESP_PROVIDER, str_clone_a(a, provider)); }
    return c;
}

# The tool calls the model asked for, a vec, or 0 when this is a final answer.
fn agnosai_inference_response_tool_calls(r): i64 {
    return load64(r + AGN_RESP_TOOL_CALLS);
}

# Set the tool calls on a response. Returns it. **For a suite's chat stub**: the live path reads
# them off the body.
fn agnosai_inference_response_with_tool_calls(r, calls): i64 {
    store64(r + AGN_RESP_TOOL_CALLS, calls);
    return r;
}

# The assistant's reply text.
fn agnosai_inference_response_content(r): i64 {
    return load64(r + AGN_RESP_CONTENT);
}

# The model that produced the reply.
fn agnosai_inference_response_model(r): i64 {
    return load64(r + AGN_RESP_MODEL);
}

# Prompt tokens consumed.
fn agnosai_inference_response_prompt_tokens(r): i64 {
    return load64(r + AGN_RESP_PROMPT_TOKENS);
}

# Completion tokens produced.
fn agnosai_inference_response_completion_tokens(r): i64 {
    return load64(r + AGN_RESP_COMPLETION_TOKENS);
}

# Total tokens for the turn.
fn agnosai_inference_response_total_tokens(r): i64 {
    return load64(r + AGN_RESP_PROMPT_TOKENS) + load64(r + AGN_RESP_COMPLETION_TOKENS);
}

# Add what an earlier call cost to `r`, so one answer can say what getting it took.
#
# A validation retry replaces the response it retried, and its tokens and cost
# went with it, so a task that took three calls reported one. The cost keeps its
# sentinel rule: a call that reported none adds nothing, and `r` keeps
# `AGNOSAI_NO_LIMIT` only when neither reported one.
fn agnosai_inference_response_carry_usage(r, prior): i64 {
    store64(r + AGN_RESP_PROMPT_TOKENS,
      load64(r + AGN_RESP_PROMPT_TOKENS) + load64(prior + AGN_RESP_PROMPT_TOKENS));
    store64(r + AGN_RESP_COMPLETION_TOKENS,
      load64(r + AGN_RESP_COMPLETION_TOKENS) + load64(prior + AGN_RESP_COMPLETION_TOKENS));
    var earlier = load64(prior + AGN_RESP_COST_MICRO_USD);
    if (earlier != AGNOSAI_NO_LIMIT) {
        var cost = load64(r + AGN_RESP_COST_MICRO_USD);
        if (cost == AGNOSAI_NO_LIMIT) { cost = 0; }
        store64(r + AGN_RESP_COST_MICRO_USD, cost + earlier);
    }
    return r;
}

# Why generation stopped ("stop", "length", ...), or 0 when absent.
fn agnosai_inference_response_finish_reason(r): i64 {
    return load64(r + AGN_RESP_FINISH_REASON);
}

# `choices[0]` of a parsed response body, or 0 when the shape does not match.
fn _agnosai_hoosh_first_choice(v): i64 {
    if (v == 0) { return 0; }
    var choices = bayan_json_v_obj_get_by_cstr(v, "choices");
    if (choices == 0) { return 0; }
    if (bayan_json_v_is_arr(choices) == 0) { return 0; }
    if (bayan_json_v_arr_len(choices) == 0) { return 0; }
    return bayan_json_v_arr_get(choices, 0);
}

# Parse a response body. Returns the bayan value tree, or 0 on a parse error.
#
# Calls `bayan_json_v_parse_buf` rather than the bare entry for the reason
# documented in core_message.cyr — switch at the bayan 1.3.0 fold-in.
fn agnosai_hoosh_parse_body(body: Str): i64 {
    return bayan_json_v_parse_buf(str_data(body), str_len(body));
}

# Pull `choices[0].message.content` out of a non-streaming response body, or 0
# when absent or malformed.
fn agnosai_hoosh_extract_content(body: Str): i64 {
    var first = _agnosai_hoosh_first_choice(agnosai_hoosh_parse_body(body));
    if (first == 0) { return 0; }
    var msg = bayan_json_v_obj_get_by_cstr(first, "message");
    if (msg == 0) { return 0; }
    var content = bayan_json_v_obj_get_by_cstr(msg, "content");
    if (content == 0) { return 0; }
    if (bayan_json_v_is_str(content) == 0) { return 0; }
    return bayan_json_v_str(content);
}

# Pull `choices[0].delta.content` out of ONE SSE frame's JSON, or 0 when absent
# — which is the normal case for the role-only opening delta and the finish
# frame, not an error.
fn agnosai_hoosh_extract_delta(body: Str): i64 {
    var first = _agnosai_hoosh_first_choice(agnosai_hoosh_parse_body(body));
    if (first == 0) { return 0; }
    var delta = bayan_json_v_obj_get_by_cstr(first, "delta");
    if (delta == 0) { return 0; }
    var content = bayan_json_v_obj_get_by_cstr(delta, "content");
    if (content == 0) { return 0; }
    if (bayan_json_v_is_str(content) == 0) { return 0; }
    return bayan_json_v_str(content);
}

# Pull `choices[0].finish_reason`, or 0 when absent or null.
fn agnosai_hoosh_extract_finish_reason(body: Str): i64 {
    var first = _agnosai_hoosh_first_choice(agnosai_hoosh_parse_body(body));
    if (first == 0) { return 0; }
    var fr = bayan_json_v_obj_get_by_cstr(first, "finish_reason");
    if (fr == 0) { return 0; }
    if (bayan_json_v_is_str(fr) == 0) { return 0; }
    return bayan_json_v_str(fr);
}

# Pull `error.message` out of an error body, or 0 when not present.
fn agnosai_hoosh_extract_error(body: Str): i64 {
    return _agnosai_hoosh_error_of(agnosai_hoosh_parse_body(body));
}

# `error.message` of a parsed body `v`, or 0 when not present. Borrowed from `v`.
fn _agnosai_hoosh_error_of(v): i64 {
    if (v == 0) { return 0; }
    var err = bayan_json_v_obj_get_by_cstr(v, "error");
    if (err == 0) { return 0; }
    var m = bayan_json_v_obj_get_by_cstr(err, "message");
    if (m == 0) { return 0; }
    if (bayan_json_v_is_str(m) == 0) { return 0; }
    return bayan_json_v_str(m);
}

# Pull the `model` field of a response body, or 0 when absent.
fn agnosai_hoosh_extract_model(body: Str): i64 {
    var v = agnosai_hoosh_parse_body(body);
    if (v == 0) { return 0; }
    var m = bayan_json_v_obj_get_by_cstr(v, "model");
    if (m == 0) { return 0; }
    if (bayan_json_v_is_str(m) == 0) { return 0; }
    return bayan_json_v_str(m);
}

# What the gateway said about its response cache — hoosh 2.6.0's `X-Hoosh-Cache`.
#
# UNKNOWN means the header was absent, which is what a pre-2.6.0 gateway sends.
# It is deliberately distinct from MISS: "this was a real inference" and "this
# gateway cannot tell me" are different facts, and only the first justifies
# billing the call.
var AGNOSAI_HOOSH_CACHE_UNKNOWN = 0;
var AGNOSAI_HOOSH_CACHE_MISS = 1;
var AGNOSAI_HOOSH_CACHE_HIT = 2;
var AGNOSAI_HOOSH_CACHE_SEMANTIC = 3;

# Map an `X-Hoosh-Cache` value to its constant. Unrecognised values — including
# anything a future hoosh adds — read as UNKNOWN rather than as a MISS, so a new
# cache tier can never be mistaken for a billable inference.
fn agnosai_hoosh_cache_from_header(v: Str): i64 {
    if (str_eq_cstr(v, "HIT") == 1) { return AGNOSAI_HOOSH_CACHE_HIT; }
    if (str_eq_cstr(v, "SEMANTIC") == 1) { return AGNOSAI_HOOSH_CACHE_SEMANTIC; }
    if (str_eq_cstr(v, "MISS") == 1) { return AGNOSAI_HOOSH_CACHE_MISS; }
    return AGNOSAI_HOOSH_CACHE_UNKNOWN;
}

# The response's cost in integer micro-USD, or `AGNOSAI_NO_LIMIT` when the
# gateway did not report one.
#
# **0 is a real cost**, not an absence — a local model served through Ollama is
# genuinely free — so the absent sentinel has to be -1. A caller that treats 0
# as "unknown" under-reports every local inference.
fn agnosai_inference_response_cost_micro_usd(r): i64 {
    return load64(r + AGN_RESP_COST_MICRO_USD);
}

# The provider that actually served the response, or 0 when unreported.
#
# This is the **serving route**, not a guess from the model name — the two
# differ whenever hoosh's DLP re-routes a confidential request to a local
# provider, in which case hoosh bills nothing and a name-based guess would
# price it as remote.
fn agnosai_inference_response_provider(r): i64 {
    return load64(r + AGN_RESP_PROVIDER);
}

# How long the model call took, in milliseconds, or 0 for a response this process did not time.
fn agnosai_inference_response_latency_ms(r): i64 {
    return load64(r + AGN_RESP_LATENCY_MS);
}

# Say how long the model call took. Returns the response.
fn agnosai_inference_response_with_latency_ms(r, ms): i64 {
    store64(r + AGN_RESP_LATENCY_MS, ms);
    return r;
}

# Say which provider served the response, for one the gateway did not name. Returns `r`.
fn agnosai_inference_response_with_provider(r, provider: Str): i64 {
    store64(r + AGN_RESP_PROVIDER, provider);
    return r;
}

# Whether the response came from hoosh's cache — one of the
# `AGNOSAI_HOOSH_CACHE_*` constants.
fn agnosai_inference_response_cache(r): i64 {
    return load64(r + AGN_RESP_CACHE);
}

# Pull `usage.cost_micro_usd` / `usage.provider` into the out-params — hoosh
# 2.6.0. Returns 1 when a cost was reported, 0 otherwise.
#
# Both fields are absent on a pre-2.6.0 gateway, which is not an error: the
# caller then simply has no cost to report, which is more honest than
# re-deriving one from a copy of hoosh's pricing table that would drift.
fn agnosai_hoosh_extract_cost(body: Str, out_cost, out_provider): i64 {
    store64(out_cost, AGNOSAI_NO_LIMIT);
    store64(out_provider, 0);

    var v = agnosai_hoosh_parse_body(body);
    if (v == 0) { return 0; }
    var usage = bayan_json_v_obj_get_by_cstr(v, "usage");
    if (usage == 0) { return 0; }
    if (bayan_json_v_is_obj(usage) == 0) { return 0; }

    var prov = bayan_json_v_obj_get_by_cstr(usage, "provider");
    if (prov != 0 && bayan_json_v_is_str(prov) == 1) {
        store64(out_provider, bayan_json_v_str(prov));
    }

    var cost = bayan_json_v_obj_get_by_cstr(usage, "cost_micro_usd");
    if (cost == 0) { return 0; }
    if (bayan_json_v_is_int(cost) == 0) { return 0; }
    store64(out_cost, bayan_json_v_int(cost));
    return 1;
}

# Pull `usage.prompt_tokens` / `usage.completion_tokens` into the out-params.
# Returns 1 when a usage block was present, 0 otherwise — a streamed turn
# without `stream_options.include_usage` has none.
fn agnosai_hoosh_extract_usage(body: Str, out_prompt, out_completion): i64 {
    var v = agnosai_hoosh_parse_body(body);
    if (v == 0) { return 0; }
    var usage = bayan_json_v_obj_get_by_cstr(v, "usage");
    if (usage == 0) { return 0; }
    if (bayan_json_v_is_obj(usage) == 0) { return 0; }
    store64(out_prompt, _agnosai_int_field(usage, "prompt_tokens", 0));
    store64(out_completion, _agnosai_int_field(usage, "completion_tokens", 0));
    return 1;
}

# The `data` array of an OpenAI `/v1/models` body, or 0 when the shape does not
# match. The caller walks it with `bayan_json_v_arr_*`.
fn agnosai_hoosh_extract_models(body: Str): i64 {
    return agnosai_hoosh_extract_models_a(default_alloc(), body);
}

# `agnosai_hoosh_extract_models`, with the parse tree in allocator `a`. `/v1/models/catalog` has
# the same shape, with more on each entry.
fn agnosai_hoosh_extract_models_a(a, body: Str): i64 {
    var v = bayan_json_v_parse_buf_a(a, str_data(body), str_len(body));
    if (v == 0) { return 0; }
    var data = bayan_json_v_obj_get_by_cstr(v, "data");
    if (data == 0) { return 0; }
    if (bayan_json_v_is_arr(data) == 0) { return 0; }
    return data;
}

# Build a full InferenceResponse from a non-streaming body, or 0 when the body
# carries no content.
#
# One parse, not five (2.1.6): each `agnosai_hoosh_extract_*` re-parses the
# whole body, so building a response from them parsed it five times on the
# global bump. The fields are read off one tree by `_agnosai_hoosh_response_of`.
fn agnosai_hoosh_response_from_body(body: Str): i64 {
    return agnosai_hoosh_response_from_body_a(default_alloc(), body);
}

# `agnosai_hoosh_response_from_body`, in allocator `a`.
fn agnosai_hoosh_response_from_body_a(a, body: Str): i64 {
    return _agnosai_hoosh_response_of_a(a,
      bayan_json_v_parse_buf_a(a, str_data(body), str_len(body)));
}

# A string field of `obj`, cloned into allocator `a`, or 0 when absent or not a
# string. A response outlives the tree it was read from, which on the chat path is
# an arena reset as soon as the call returns.
fn _agnosai_hoosh_str_clone_a(a, obj, key): i64 {
    if (obj == 0) { return 0; }
    var f = bayan_json_v_obj_get_by_cstr(obj, key);
    if (f == 0) { return 0; }
    if (bayan_json_v_is_str(f) == 0) { return 0; }
    return str_clone_a(a, bayan_json_v_str(f));
}

# One entry of `message.tool_calls` as a tool call in `a`, or 0 when it names no tool.
#
# ⚠ **`arguments` may be an object.** OpenAI's shape is a Str of JSON, which is what hoosh
# forwards, but until hoosh 2.6.1 an Ollama route handed clients the object, and an
# OpenAI-compatible gateway other than hoosh may yet. Either way the caller gets a Str. A
# missing one is the empty Str, which a tool with no parameters may well send.
#
# An id may be missing too, and stays 0: only the loop knows what else this turn holds.
fn _agnosai_hoosh_tool_call_of_a(a, entry): i64 {
    if (bayan_json_v_is_obj(entry) == 0) { return 0; }
    var fun = bayan_json_v_obj_get_by_cstr(entry, "function");
    if (fun == 0) { return 0; }
    if (bayan_json_v_is_obj(fun) == 0) { return 0; }
    var name = _agnosai_hoosh_str_clone_a(a, fun, "name");
    if (name == 0) { return 0; }
    if (str_len(name) == 0) { return 0; }

    var args = _agnosai_hoosh_str_clone_a(a, fun, "arguments");
    if (args == 0) {
        var raw = bayan_json_v_obj_get_by_cstr(fun, "arguments");
        if (raw != 0 && bayan_json_v_is_obj(raw) == 1) { args = bayan_json_v_build_a(a, raw); }
        else { args = str_from_a(a, ""); }
    }
    return agnosai_chat_tool_call_new_a(a, _agnosai_hoosh_str_clone_a(a, entry, "id"), name, args);
}

# The vec of tool calls in `msg`, a parsed `choices[0].message`, or 0 when it holds none. An
# entry that names no tool is dropped, as nothing could answer it.
fn _agnosai_hoosh_tool_calls_of_a(a, msg): i64 {
    if (msg == 0) { return 0; }
    var arr = bayan_json_v_obj_get_by_cstr(msg, "tool_calls");
    if (arr == 0) { return 0; }
    if (bayan_json_v_is_arr(arr) == 0) { return 0; }

    var calls = 0;
    for (var i = 0; i < bayan_json_v_arr_len(arr); i = i + 1) {
        var c = _agnosai_hoosh_tool_call_of_a(a, bayan_json_v_arr_get(arr, i));
        if (c != 0) {
            if (calls == 0) { calls = vec_new_a(a); }
            vec_push_a(a, calls, c);
        }
    }
    return calls;
}

# An InferenceResponse from a parsed body `v`, or 0 when it carries neither content nor a tool
# call — the same fields, defaults and sentinels as the `agnosai_hoosh_extract_*` readers.
# Every string it keeps is a COPY in `a`, so `v` may live in an arena.
#
# ⚠ **A tool call may come with no `content`, or a null one** (ADR 029). OpenAI's API sends
# null, and this refused it as a body with no content. hoosh sends `""`, which is why nothing
# noticed. It reads as the empty Str, so a caller never holds a 0 there.
fn _agnosai_hoosh_response_of_a(a, v): i64 {
    var first = _agnosai_hoosh_first_choice(v);
    if (first == 0) { return 0; }
    var msg = bayan_json_v_obj_get_by_cstr(first, "message");
    var calls = _agnosai_hoosh_tool_calls_of_a(a, msg);
    var content = _agnosai_hoosh_str_clone_a(a, msg, "content");
    if (content == 0) {
        if (calls == 0) { return 0; }
        content = str_from_a(a, "");
    }

    var model = _agnosai_hoosh_str_clone_a(a, v, "model");
    if (model == 0) { model = str_from_a(a, ""); }

    var resp = agnosai_inference_response_new_a(a, content, model);
    store64(resp + AGN_RESP_TOOL_CALLS, calls);
    store64(resp + AGN_RESP_FINISH_REASON, _agnosai_hoosh_str_clone_a(a, first, "finish_reason"));

    var cost = AGNOSAI_NO_LIMIT;
    var provider = 0;
    var usage = bayan_json_v_obj_get_by_cstr(v, "usage");
    if (usage != 0 && bayan_json_v_is_obj(usage) == 1) {
        store64(resp + AGN_RESP_PROMPT_TOKENS, _agnosai_int_field(usage, "prompt_tokens", 0));
        store64(resp + AGN_RESP_COMPLETION_TOKENS, _agnosai_int_field(usage, "completion_tokens", 0));
        provider = _agnosai_hoosh_str_clone_a(a, usage, "provider");
        var c = bayan_json_v_obj_get_by_cstr(usage, "cost_micro_usd");
        if (c != 0 && bayan_json_v_is_int(c) == 1) { cost = bayan_json_v_int(c); }
    }
    store64(resp + AGN_RESP_COST_MICRO_USD, cost);
    store64(resp + AGN_RESP_PROVIDER, provider);
    return resp;
}

# The payload of one SSE `data:` line, or 0 when the line is not a data line.
#
# Handles both `data:{...}` and `data: {...}` (one optional space, per the SSE
# spec's field-value parsing). The terminal `data: [DONE]` sentinel returns 0 —
# it is a control marker, not a frame to parse.
fn agnosai_hoosh_sse_data(line: Str): i64 {
    var len = str_len(line);
    if (len < 5) { return 0; }
    var d = str_data(line);
    if (memeq(d, "data:", 5) == 0) { return 0; }

    var start = 5;
    if (start < len) {
        if (load8(d + start) == 32) { start = start + 1; }
    }
    if (start >= len) { return 0; }

    var payload = str_new(d + start, len - start);
    if (str_eq_cstr(payload, "[DONE]") == 1) { return 0; }
    return payload;
}

# Whether an SSE line is the terminal `data: [DONE]` sentinel.
fn agnosai_hoosh_sse_is_done(line: Str): i64 {
    var len = str_len(line);
    if (len < 5) { return 0; }
    var d = str_data(line);
    if (memeq(d, "data:", 5) == 0) { return 0; }
    var start = 5;
    if (start < len) {
        if (load8(d + start) == 32) { start = start + 1; }
    }
    return str_eq_cstr(str_new(d + start, len - start), "[DONE]");
}

# The request headers for a chat-completions POST, as a **sandhi headers
# object** — `sandhi_http_post` takes the structured form from
# `sandhi_headers_new`, not a raw CRLF string. Handing it a string makes sandhi
# dereference text as a struct, which segfaults rather than erroring.
#
# `api_key` may be 0, which is the usual case: the gateway holds the provider
# credentials and agnosai never sees them.
fn agnosai_hoosh_headers(api_key: Str): i64 {
    var h = sandhi_headers_new();
    sandhi_headers_set(h, "Content-Type", "application/json");
    if (api_key != 0) {
        if (str_len(api_key) > 0) {
            var sb = str_builder_new();
            str_builder_add_cstr(sb, "Bearer ");
            str_builder_add(sb, api_key);
            sandhi_headers_set(h, "Authorization", str_cstr(str_builder_build(sb)));
        }
    }
    return h;
}

# Close a chat span and hand it to the exporter. `ok` is 1 for success, and
# `err_type` is the `error.type` of a failure, or 0.
#
# One helper rather than the same lines on five exit paths — and it keeps the
# clock read next to the record, so a path that forgets to stop the timer
# cannot report a bogus duration. `span` is 0 with telemetry off, and then
# this records nothing.
fn _agnosai_hoosh_span_done(span, self_sc, parent_sc, t0, ok, err_type): i64 {
    if (span == 0) { return 0; }
    if (err_type != 0) { agnosai_genai_span_set_error_type(span, err_type); }
    return agnosai_telemetry_record_span_in(span, self_sc, parent_sc, t0, clock_epoch_ns(),
      agnosai_telemetry_status_of(ok));
}

# An `error.type` from a cstring, or 0 when there is no span to carry it — so
# a failure with telemetry off allocates nothing it would throw away.
fn _agnosai_hoosh_error_type(span, name): i64 {
    if (span == 0) { return 0; }
    return str_from(name);
}

# A transport failure's `error.type`: sandhi's error-kind name LOWERCASED —
# `connect`, `tls`, `timeout`, `protocol` (ADR 023).
#
# ⚠ sandhi spells its kinds in capitals, and every other value agnosai emits is
# lowercase, the workflow's `timeout` among them. Sent as-is, a backend grouping
# by `error.type` would count `timeout` and `TIMEOUT` as two classes. Lowered
# only for a span that will be recorded, so telemetry off allocates nothing.
fn _agnosai_hoosh_kind_error_type(span, kind): i64 {
    if (span == 0) { return 0; }
    return str_from(str_lower_cstr(sandhi_err_kind_name(kind)));
}

# A failed HTTP status as its `error.type`: the decimal status, `"503"`, which
# is the spec's own example of a low-cardinality error class. Built only for a
# span that will be recorded.
fn _agnosai_hoosh_status_error_type(span, status): i64 {
    if (span == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_int(sb, status);
    return str_builder_build(sb);
}

# POST a chat-completions request to the gateway. **The one chat I/O call here.**
#
# `agnosai_hoosh_chat_in` with no parent span: the chat span, when telemetry is
# on, is the root of its own trace.
fn agnosai_hoosh_chat(base_url: Str, api_key: Str, request, out_response): i64 {
    return agnosai_hoosh_chat_in(base_url, api_key, request, out_response, 0);
}

# --- the chat transport: bounded in memory and in time (2.1.6) ------------
#
# Through 2.1.5 every chat call used the bare `sandhi_http_post`: the no-free
# global bump, and no options. Each inference therefore left behind its URL,
# its headers, its request body, sandhi's 256 KiB receive buffer — allocated at
# the full cap before a byte arrives — and five parse trees of the response
# (one per `extract_*` reader): ~256 KiB of RSS per inference for good, ~0.9 GB
# an hour for a crew runner making one call a second. With no timeouts, a
# gateway that accepted and never answered held the task's thread forever; the
# crew's deadline is cooperative and is read only between tasks.
#
# Now each call takes an arena from `_AGNOSAI_HOOSH_POOL`, builds and sends the
# request and parses the answer in it — once — copies out the strings the
# response keeps, and gives the arena back. What still reaches the global bump
# per call is sandhi's own connect path (a few hundred bytes, filed with sandhi)
# and the response the caller keeps.
#
# The pool is sized for the concurrent inferences a process runs — crews ×
# their parallel tasks — and an empty pool mints rather than blocks (see
# `arena_pool.cyr`), so 32 parked arenas is a memory bound, not a cap on work.
#
# ⚠ **Built on the FIRST call, not at load — unlike the other pools here.** Built
# eagerly, its 32 × 64 KiB came to ~2 MB on the global bump before `main`, in
# every program that links the chat path whether it ever calls a model or not —
# and that alone made `crew_runner_10_tasks_parallel_4_{quiet,watched}` ~35%
# slower (404 → 550 µs, A/B against 2.1.5 on one host; the runs never touch the
# pool, so it is where the bump's later allocations land, not work). Smaller
# arenas were not a fix: 16 KiB measured 423 to 681 µs run to run.
#
# `arena_pool.cyr`'s rule against a lazy build is about the RACE — two threads
# both seeing 0 and both building, the loser's arenas leaked. That is closed
# here by double-checked locking: the pool is built under a mutex that is created
# at load (one small allocation), published only once it is whole, and read with
# `atomic_load`. A process that never calls a model never builds the pool.
#
# ⚠ **Publication is a fence and then a store.** `atomic_store` is a plain store,
# so on aarch64, which ships, the fast path could otherwise see the pointer before
# the pool's fields and fault on them. The `mutex_unlock` does not help, as it comes
# after the store. The readers' own loads follow the pointer, so they need no fence
# of their own, and only the one build pays for this. x86 cannot show this, and no
# suite here would.
var _AGNOSAI_HOOSH_ARENA_SLOTS = 32;
var _AGNOSAI_HOOSH_ARENA_BYTES = 65536;
var _AGNOSAI_HOOSH_POOL = 0;
var _AGNOSAI_HOOSH_POOL_LOCK = mutex_new();

# The chat call's arena pool, built on first use. 0 only when it cannot be built.
fn _agnosai_hoosh_pool(): i64 {
    var p = atomic_load(&_AGNOSAI_HOOSH_POOL);
    if (p != 0) { return p; }
    mutex_lock(_AGNOSAI_HOOSH_POOL_LOCK);
    p = atomic_load(&_AGNOSAI_HOOSH_POOL);
    if (p == 0) {
        p = agnosai_arena_pool_new(_AGNOSAI_HOOSH_ARENA_SLOTS, _AGNOSAI_HOOSH_ARENA_BYTES);
        if (p != 0) {
            atomic_fence();
            atomic_store(&_AGNOSAI_HOOSH_POOL, p);
        }
    }
    mutex_unlock(_AGNOSAI_HOOSH_POOL_LOCK);
    return p;
}

# The chat call's ceilings, in ms: connect; each read or write; the whole
# exchange. Generous on purpose — a long non-streaming completion is legitimate
# and slow — and finite on purpose. `agnosai_hoosh_set_timeouts` changes them.
var AGNOSAI_HOOSH_CONNECT_MS = 10000;
var AGNOSAI_HOOSH_IO_MS = 300000;
var AGNOSAI_HOOSH_TOTAL_MS = 600000;

# The options every chat call posts with — one block, built at load, read-only
# once the process serves. The response cap is sandhi's default (256 KiB), as
# it was in 2.1.5.
fn _agnosai_hoosh_opts_new(): i64 {
    var o = sandhi_http_options_new();
    if (o == 0) { return 0; }
    sandhi_http_options_connect_ms(o, AGNOSAI_HOOSH_CONNECT_MS);
    sandhi_http_options_read_ms(o, AGNOSAI_HOOSH_IO_MS);
    sandhi_http_options_write_ms(o, AGNOSAI_HOOSH_IO_MS);
    sandhi_http_options_total_ms(o, AGNOSAI_HOOSH_TOTAL_MS);
    return o;
}
var _AGNOSAI_HOOSH_OPTS = _agnosai_hoosh_opts_new();

# Set the chat call's connect, per-read/-write and whole-exchange ceilings, in
# ms. Process-wide. ⚠ **Call at start-up, before any crew runs** — the block is
# read without a lock on every call. Returns 0, or -1 for a value of 0 or less.
fn agnosai_hoosh_set_timeouts(connect_ms, io_ms, total_ms): i64 {
    if (connect_ms <= 0 || io_ms <= 0 || total_ms <= 0) { return 0 - 1; }
    var o = _AGNOSAI_HOOSH_OPTS;
    if (o == 0) { return 0 - 1; }
    sandhi_http_options_connect_ms(o, connect_ms);
    sandhi_http_options_read_ms(o, io_ms);
    sandhi_http_options_write_ms(o, io_ms);
    sandhi_http_options_total_ms(o, total_ms);
    return 0;
}

# The chat call's whole-exchange ceiling, in ms.
fn agnosai_hoosh_total_timeout_ms(): i64 {
    return sandhi_http_options_get_total_ms(_AGNOSAI_HOOSH_OPTS);
}

# `base` + `path` as a NUL-terminated C string in `a` — what sandhi takes — with
# one trailing `/` of `base` dropped, as `agnosai_hoosh_join_url` does. 0 when
# `a` runs out.
fn _agnosai_hoosh_url_cstr_a(a, base: Str, path, plen): i64 {
    var blen = str_len(base);
    if (blen > 0) {
        if (load8(str_data(base) + blen - 1) == 47) { blen = blen - 1; }
    }
    var buf = alloc_via(a, blen + plen + 1);
    if (buf == 0) { return 0; }
    memcpy(buf, str_data(base), blen);
    memcpy(buf + blen, path, plen);
    store8(buf + blen + plen, 0);
    return buf;
}

# The chat-completions endpoint of `base`, as `_agnosai_hoosh_url_cstr_a` gives it.
fn _agnosai_hoosh_endpoint_cstr_a(a, base: Str): i64 {
    var path = "/v1/chat/completions";
    return _agnosai_hoosh_url_cstr_a(a, base, path, strlen(path));
}

# `agnosai_hoosh_headers` in `a`: the same two headers, nothing on the global bump.
fn _agnosai_hoosh_headers_a(a, api_key: Str): i64 {
    var h = sandhi_headers_new_a(a);
    if (h == 0) { return 0; }
    sandhi_headers_set_a(a, h, "Content-Type", "application/json");
    if (api_key != 0) {
        var klen = str_len(api_key);
        if (klen > 0) {
            var v = alloc_via(a, 7 + klen + 1);
            if (v == 0) { return 0; }
            memcpy(v, "Bearer ", 7);
            memcpy(v + 7, str_data(api_key), klen);
            store8(v + 7 + klen, 0);
            sandhi_headers_set_a(a, h, "Authorization", v);
        }
    }
    return h;
}

# What a failed chat's body says, for its error text, or 0. `tree` is the parsed body, 0 if it did not
# parse.
#
# ⚠ **hoosh's error body is not always JSON.** With no `message` key in a provider's answer it passes
# the raw body on, unescaped, inside a JSON string (`_provider_err_capture`, `_resp_err`), so Ollama's
# `{"error":"model 'x' not found"}` arrives as `{"error":{"message":"upstream provider returned HTTP
# 404: {"error": …`, which parses to nothing. That is a retired model on the provider that has no
# other way to say so, and `agnosai_hoosh_refused_model` has to see it. So those words are carried over
# and no others: the rest is a provider's text that nothing here has read.
fn _agnosai_hoosh_detail_a(a, tree, body, body_len): i64 {
    if (tree != 0) { return _agnosai_hoosh_error_of(tree); }
    if (body == 0 || body_len <= 0) { return 0; }
    var needle = "upstream provider returned HTTP 404";
    if (agnosai_str_contains_ci_cstr(str_new_a(a, body, body_len), needle) == 1) {
        return str_from_a(a, needle);
    }
    return 0;
}

# POST a chat-completions request to the gateway, as a child of `parent_sc`.
#
# Returns 0 on success, having written the InferenceResponse to `out_response`.
# On failure returns an error-message Str — the same contract llm_retry's driver
# expects, so `agnosai_with_retry` wraps this directly.
#
# Error text deliberately includes the HTTP status and the gateway's own
# `error.message` where present, because `agnosai_is_retryable` classifies on
# that text: a bare "request failed" would make a 503 look non-retryable.
#
# Records a GenAI `chat` span around the whole round trip (ADR 017, ADR 023).
# `parent_sc` is the calling task's span context — the crew runner passes its
# `invoke_agent` span's — or 0 for a root span.
#
# ⚠ **No outbound `traceparent` header.** hoosh 2.7.1 honours one, but exports
# its own span with the inbound parent-id as its spanId, which would duplicate
# this chat span's id inside one trace. It waits on a hoosh fix (roadmap,
# *Upstream*), then hoosh's server span can be this span's child.
fn agnosai_hoosh_chat_in(base_url: Str, api_key: Str, request, out_response, parent_sc): i64 {
    # ADR 017 — the oracle defines the GenAI span helpers and never calls them;
    # this port must, or the OTLP exporter has no producers. Built before the
    # request goes out so `start_ns` covers the whole round trip, and handed to
    # the recorder on every exit path below.
    #
    # ⚠ Built ONLY when the exporter is on (ADR 023). With telemetry off the
    # span is 0, nothing is allocated, no random bytes are drawn, the clock is
    # not read, and `_agnosai_hoosh_span_done` returns at once on all five exits.
    var _span = 0;
    var _self = 0;
    var _t0 = 0;
    if (agnosai_telemetry_exporter() != 0) {
        _span = agnosai_genai_chat_span(agnosai_inference_request_model(request),
          str_from("hoosh"));
        _self = agnosai_telemetry_span_ctx(parent_sc);
        _t0 = clock_epoch_ns();
    }

    # One arena per call, from the pool, given back on every exit (2.1.6).
    var pool = _agnosai_hoosh_pool();
    var a = agnosai_arena_pool_acquire(pool);
    if (a == 0) {
        _agnosai_hoosh_span_done(_span, _self, parent_sc, _t0, 0,
          _agnosai_hoosh_error_type(_span, "no_response"));
        return str_from_a(agnosai_inference_request_alloc(request),
          "hoosh transport error: no arena for the request");
    }
    var rc = _agnosai_hoosh_chat_a(a, base_url, api_key, request, out_response,
      _span, _self, parent_sc, _t0);
    agnosai_arena_pool_release(pool, a);
    return rc;
}

# Which gateway `url`, a C string, names, for a log line, in arena `a`: its scheme, host and port
# as sandhi parses them, or `(withheld)`. 0 when `a` runs out.
#
# ⚠ **Rebuilt from what the parser found, never cut from the URL's text.** Cutting cannot be made
# safe: sandhi has no userinfo form to ask, so the text gives no reliable place to cut. A password
# may hold a `/`, `?` or `#`, which end the authority early, and an `@` in a query moves a cut
# past the query it was meant to drop. So only three parsed fields are ever written, and a URL
# holding an `@` anywhere is withheld, as is a host holding anything a host name does not. The
# path goes too, which costs an operator nothing the failure kind and the host do not give.
fn agnosai_hoosh_log_url_a(a, url): i64 {
    var n = strlen(url);
    for (var i = 0; i < n; i = i + 1) {
        if (load8(url + i) == 64) { return str_from_a(a, "(withheld)"); }
    }
    var parsed = sandhi_url_parse_a(a, url);
    if (parsed == 0) { return str_from_a(a, "(withheld)"); }

    var host = sandhi_url_host(parsed);
    var hlen = strlen(host);
    for (var j = 0; j < hlen; j = j + 1) {
        var c = load8(host + j);
        var ok = 0;
        if (c >= 97 && c <= 122) { ok = 1; }
        if (c >= 65 && c <= 90) { ok = 1; }
        if (c >= 48 && c <= 57) { ok = 1; }
        if (c == 45 || c == 46 || c == 58 || c == 95) { ok = 1; }
        if (ok == 0) { return str_from_a(a, "(withheld)"); }
    }

    var sb = str_builder_new_a(a);
    if (sb == 0) { return 0; }
    if (sandhi_url_scheme(parsed) == SANDHI_URL_HTTPS) {
        str_builder_add_cstr_a(a, sb, "https://");
    } else {
        str_builder_add_cstr_a(a, sb, "http://");
    }
    str_builder_add_cstr_a(a, sb, host);
    str_builder_add_cstr_a(a, sb, ":");
    str_builder_add_int_a(a, sb, sandhi_url_port(parsed));
    return str_builder_build_a(a, sb);
}

# Log a failed exchange with the gateway: the kind, and which gateway as
# `agnosai_hoosh_log_url_a` gives it. In arena `a`, which the caller resets.
fn _agnosai_hoosh_log_transport_a(a, url, kind): i64 {
    if (sakshi_get_level() < SK_WARN) { return 0; }
    var shown = agnosai_hoosh_log_url_a(a, url);
    var sb = str_builder_new_a(a);
    if (shown == 0 || sb == 0) { return 0; }
    str_builder_add_cstr_a(a, sb, "hoosh transport error: ");
    str_builder_add_cstr_a(a, sb, sandhi_err_kind_name(kind));
    var msg = str_builder_build_a(a, sb);
    if (msg == 0) { return 0; }
    sakshi_log_kv(SK_WARN, str_data(msg), str_len(msg), "url", 3, str_data(shown), str_len(shown));
    return 0;
}

# The body of `agnosai_hoosh_chat_in`, in arena `a`. ⚠ **Nothing it returns may
# point into `a`**: the caller resets it. Error strings and the response are built
# where the request lives (`ra`), so a crew in an arena gets them back with the rest
# of it, and a request on the global heap keeps what it always had.
fn _agnosai_hoosh_chat_a(a, base_url: Str, api_key: Str, request, out_response,
  _span, _self, parent_sc, _t0): i64 {
    var began_ns = clock_now_ns();
    var ra = agnosai_inference_request_alloc(request);
    var url = _agnosai_hoosh_endpoint_cstr_a(a, base_url);
    var headers = _agnosai_hoosh_headers_a(a, api_key);
    var body = agnosai_inference_request_to_json_a(a, request);
    if (url == 0 || headers == 0 || body == 0) {
        _agnosai_hoosh_span_done(_span, _self, parent_sc, _t0, 0,
          _agnosai_hoosh_error_type(_span, "no_response"));
        return str_from_a(ra, "hoosh transport error: could not build the request");
    }

    var r = sandhi_http_post_opts_a(a, url, headers, str_data(body), str_len(body), _AGNOSAI_HOOSH_OPTS);
    if (r == 0) {
        _agnosai_hoosh_span_done(_span, _self, parent_sc, _t0, 0,
          _agnosai_hoosh_error_type(_span, "no_response"));
        return str_from_a(ra, "hoosh transport error: no response allocated");
    }
    var kind = sandhi_http_err_kind(r);
    if (kind != SANDHI_OK) {
        # ⚠ **The kind, and never the URL (2.2.4).** This text becomes a task's `output` and
        # `error`, so a consumer's API serves it to any reader and stores it for good. It
        # named the gateway's URL through 2.2.3, password included for a URL with userinfo.
        # The log line says which gateway instead, and that line is the operator's.
        _agnosai_hoosh_log_transport_a(a, url, kind);
        var sb = str_builder_new_a(a);
        str_builder_add_cstr_a(a, sb, "hoosh transport error: ");
        str_builder_add_cstr_a(a, sb, sandhi_err_kind_name(kind));
        _agnosai_hoosh_span_done(_span, _self, parent_sc, _t0, 0,
          _agnosai_hoosh_kind_error_type(_span, kind));
        return str_builder_build_a(ra, sb);
    }

    var status = sandhi_http_status(r);
    # Parsed ONCE, in the arena: the error detail and every response field are
    # read off this one tree.
    var tree = bayan_json_v_parse_buf_a(a, sandhi_http_body(r), sandhi_http_body_len(r));

    if (status < 200 || status >= 300) {
        var esb = str_builder_new_a(a);
        str_builder_add_cstr_a(a, esb, "hoosh returned HTTP ");
        str_builder_add_int_a(a, esb, status);
        var detail = _agnosai_hoosh_detail_a(a, tree, sandhi_http_body(r), sandhi_http_body_len(r));
        if (detail != 0) {
            str_builder_add_cstr_a(a, esb, ": ");
            str_builder_add_a(a, esb, detail);
        }
        _agnosai_hoosh_span_done(_span, _self, parent_sc, _t0, 0,
          _agnosai_hoosh_status_error_type(_span, status));
        return str_builder_build_a(ra, esb);
    }

    var parsed = _agnosai_hoosh_response_of_a(ra, tree);
    if (parsed == 0) {
        _agnosai_hoosh_span_done(_span, _self, parent_sc, _t0, 0,
          _agnosai_hoosh_error_type(_span, "invalid_response"));
        return str_from_a(ra, "hoosh returned a body with no choices[0].message.content");
    }

    # hoosh 2.6.0's cache signal. A HIT replays the cached body verbatim, cost
    # included — that is what the ORIGINAL inference cost, not this request — so
    # the header, not the body, is what a caller bills on.
    var cache_hdr = sandhi_headers_get(sandhi_http_headers(r), "X-Hoosh-Cache");
    if (cache_hdr != 0) {
        store64(parsed + AGN_RESP_CACHE, agnosai_hoosh_cache_from_header(str_from_a(a, cache_hdr)));
    }

    # The success path is the only one with usage to record: the responding
    # model may differ from the requested one, which is exactly what
    # `gen_ai.response.model` is for.
    agnosai_genai_record_usage(_span, agnosai_inference_response_prompt_tokens(parsed),
      agnosai_inference_response_completion_tokens(parsed),
      agnosai_inference_response_model(parsed));
    _agnosai_hoosh_span_done(_span, _self, parent_sc, _t0, 1, 0);

    store64(parsed + AGN_RESP_LATENCY_MS, (clock_now_ns() - began_ns) / AGNOSAI_NS_PER_MS);
    store64(out_response, parsed);
    return 0;
}

# Whether a chat failure says the id does not exist, as opposed to the gateway or the provider
# being unwell (ADR 030). `err` is what `agnosai_hoosh_chat_in` returned.
#
# ⚠ **Two spellings, and the second is a 502.** hoosh answers 404 only when no route matches the id
# (`no provider for model`). A provider's own 404, which is what a retired id gets, reaches here as
# `hoosh returned HTTP 502: upstream provider returned HTTP 404: …`, so a test for 404 alone would
# miss the case a held catalog goes stale on. Anchored to those words, as a 404 in the provider's
# prose or in a model's id says nothing.
fn agnosai_hoosh_refused_model(err: Str): i64 {
    if (err == 0) { return 0; }
    if (agnosai_str_contains_ci_cstr(err, "hoosh returned HTTP 404") == 1) { return 1; }
    return agnosai_str_contains_ci_cstr(err, "upstream provider returned HTTP 404");
}

# --- the gateway's lists: short, and bigger than a chat answer ---------------
#
# A GET here is a list, not a completion, and a task waits on it, so its ceilings are a tenth of the
# chat call's. The body cap is not sandhi's 256 KiB: an entry is about 350 bytes,
# and a gateway with OpenRouter on a live catalog lists several hundred models for that route alone.
# Too big is a transport failure (`PROTOCOL`), which is the catalog not being read.
var AGNOSAI_HOOSH_GET_CONNECT_MS = 5000;
var AGNOSAI_HOOSH_GET_IO_MS = 10000;
var AGNOSAI_HOOSH_GET_TOTAL_MS = 15000;
var AGNOSAI_HOOSH_GET_MAX_BYTES = 2097152;

# The options every GET goes out with — one block, built at load, never written after.
fn _agnosai_hoosh_get_opts_new(): i64 {
    var o = sandhi_http_options_new();
    if (o == 0) { return 0; }
    sandhi_http_options_connect_ms(o, AGNOSAI_HOOSH_GET_CONNECT_MS);
    sandhi_http_options_read_ms(o, AGNOSAI_HOOSH_GET_IO_MS);
    sandhi_http_options_write_ms(o, AGNOSAI_HOOSH_GET_IO_MS);
    sandhi_http_options_total_ms(o, AGNOSAI_HOOSH_GET_TOTAL_MS);
    sandhi_http_options_max_response_bytes(o, AGNOSAI_HOOSH_GET_MAX_BYTES);
    return o;
}
var _AGNOSAI_HOOSH_GET_OPTS = _agnosai_hoosh_get_opts_new();

# GET `path` from the gateway, all of it in arena `a`, which sandhi's receive buffer is sized into.
#
# Returns the HTTP status, with the body through `out_body` as a Str in `a`, or a transport failure
# as a negative sandhi error kind. The kind is what a task may repeat: the URL is for the log alone,
# as on the chat path.
fn agnosai_hoosh_get_a(a, base_url: Str, api_key: Str, path: Str, out_body): i64 {
    var url = _agnosai_hoosh_url_cstr_a(a, base_url, str_data(path), str_len(path));
    var headers = _agnosai_hoosh_headers_a(a, api_key);
    if (url == 0 || headers == 0) { return 0 - SANDHI_ERR_INTERNAL; }

    var r = sandhi_http_get_opts_a(a, url, headers, _AGNOSAI_HOOSH_GET_OPTS);
    if (r == 0) { return 0 - SANDHI_ERR_INTERNAL; }
    var kind = sandhi_http_err_kind(r);
    if (kind != SANDHI_OK) {
        _agnosai_hoosh_log_transport_a(a, url, kind);
        return 0 - kind;
    }
    store64(out_body, str_new_a(a, sandhi_http_body(r), sandhi_http_body_len(r)));
    return sandhi_http_status(r);
}

# A configured hoosh endpoint — base URL plus optional API key.
#
# The oracle's `execute_task` takes `Option<&Arc<HooshClient>>`, where `None`
# selects the placeholder path, so the port needs something for 0 to be the
# absence of. This is the minimum that shape requires: hoosh's own client is a
# provider registry, a cache and a cost tracker, all of which live on the far
# side of the HTTP seam here.
#
# `AGN_HC_CHAT_FP` is the chat call the crew runner makes through this client —
# see `agnosai_hoosh_client_with_chat` for why it is a pointer. `AGN_HC_GET_FP` is
# the same for a read of the gateway's model lists.
enum AgnosaiHooshClientOff {
    AGN_HC_BASE_URL = 0;
    AGN_HC_API_KEY = 8;
    AGN_HC_CHAT_FP = 16;
    AGN_HC_GET_FP = 24;
    AGN_HC_SIZE = 32;
}

# The live chat call — every client's default `AGN_HC_CHAT_FP`.
#
# `fn(client, request, out_response, parent_sc) -> i64`: 0 on success with the
# response stored through `out_response`, otherwise the error Str. That is
# `agnosai_hoosh_chat_in`'s contract with the client's two fields folded in.
# `parent_sc` is the calling task's span context, or 0 (ADR 023) — a suite's
# stub receives it too, which is how the threading is tested offline.
# Defined here, ahead of the constructor that takes its address, and reads the
# fields directly because the accessors below are not defined yet.
fn _agnosai_hoosh_client_chat_live(client, request, out_response, parent_sc): i64 {
    return agnosai_hoosh_chat_in(load64(client + AGN_HC_BASE_URL),
      load64(client + AGN_HC_API_KEY), request, out_response, parent_sc);
}

# The live GET — every client's default `AGN_HC_GET_FP`.
#
# `fn(client, a, path, out_body) -> i64`, `agnosai_hoosh_get_a`'s contract with the client's two
# fields folded in.
fn _agnosai_hoosh_client_get_live(client, a, path: Str, out_body): i64 {
    return agnosai_hoosh_get_a(a, load64(client + AGN_HC_BASE_URL),
      load64(client + AGN_HC_API_KEY), path, out_body);
}

# Create a client over a base URL and an API key. Pass `str_from("")` for the
# key when the gateway is unauthenticated.
fn agnosai_hoosh_client_new(base_url: Str, api_key: Str): i64 {
    return agnosai_hoosh_client_new_a(default_alloc(), base_url, api_key);
}

# `agnosai_hoosh_client_new`, in allocator `a`.
fn agnosai_hoosh_client_new_a(a, base_url: Str, api_key: Str): i64 {
    var c = alloc_via(a, AGN_HC_SIZE);
    store64(c + AGN_HC_BASE_URL, base_url);
    store64(c + AGN_HC_API_KEY, api_key);
    store64(c + AGN_HC_CHAT_FP, &_agnosai_hoosh_client_chat_live);
    store64(c + AGN_HC_GET_FP, &_agnosai_hoosh_client_get_live);
    return c;
}

# The client's gateway base URL.
fn agnosai_hoosh_client_base_url(c): i64 {
    return load64(c + AGN_HC_BASE_URL);
}

# The client's API key.
fn agnosai_hoosh_client_api_key(c): i64 {
    return load64(c + AGN_HC_API_KEY);
}

# The client's chat call — `_agnosai_hoosh_client_chat_live` unless a suite
# swapped it.
fn agnosai_hoosh_client_chat_fp(c): i64 {
    return load64(c + AGN_HC_CHAT_FP);
}

# Replace the client's chat call. Returns the client. **Called only by suites.**
#
# ⚠ **The transport is a function pointer for the reason
# `llm/inference_queue.cyr`'s and `tools/agnos.cyr`'s are.** The crew runner's
# LLM success arm needs a gateway that answers, so with the call hard-wired the
# only arm reachable offline was the failure one — and a mutant could unwire
# anything that happens only on success (the `token` event, the result's
# `agent` metadata, ADR 020's output filter) and still pass every assertion.
# ADR 022 records the change that needed this.
#
# Nothing is injected in production: `agnosai_hoosh_client_new` stores the live
# call, and there is no settable global to get out of step.
#
# `chat_fp` is `fn(client, request, out_response, parent_sc) -> i64`, the live
# call's contract. ⚠ The fourth argument arrived with ADR 023 — a stub written
# for B17's three-argument form must take it too.
fn agnosai_hoosh_client_with_chat(c, chat_fp): i64 {
    store64(c + AGN_HC_CHAT_FP, chat_fp);
    return c;
}

# The client's GET — `_agnosai_hoosh_client_get_live` unless a suite swapped it.
fn agnosai_hoosh_client_get_fp(c): i64 {
    return load64(c + AGN_HC_GET_FP);
}

# Replace the client's GET. Returns the client. **Called only by suites**, for the reason
# `agnosai_hoosh_client_with_chat` is: a catalog can only be canned offline if the read is a pointer.
#
# `get_fp` is `fn(client, a, path, out_body) -> i64`, the live call's contract.
fn agnosai_hoosh_client_with_get(c, get_fp): i64 {
    store64(c + AGN_HC_GET_FP, get_fp);
    return c;
}
