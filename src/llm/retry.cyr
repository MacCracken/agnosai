# =========================================================================
# llm/retry — exponential-backoff retry for LLM inference calls.
#
# Parity oracle: rust-old/src/llm/retry.rs
#
# Port notes (divergences from the Rust shape, all deliberate):
#   * `Duration` is an i64 **nanosecond** count, matching learning_profile and
#     core_error.
#   * The oracle's `with_retry` is an async generic over a `FnMut() -> Future`.
#     Cyrius has neither futures nor closures-over-generics, so the call becomes
#     a **function pointer plus an opaque context**, with a zero-allocation
#     result contract shared by the callback and the driver:
#
#         fn callback(ctx, out_value): i64
#             returns 0 on success, having written the result to `out_value`
#             returns an error-message Str on failure
#
#     `agnosai_with_retry` has that same signature-shape and contract, so a
#     retried call is a drop-in for a direct one. A tagged `Result` per attempt
#     would have been closer to the oracle's text but allocates on every retry,
#     on the bump allocator, on the hot inference path.
#   * `tokio::time::sleep` becomes `sleep_ms`. The driver blocks the calling
#     thread, which is correct under `sandhi_server_run_pooled` — every worker
#     is its own thread (port plan, the concurrency decision).
#   * `compute_delay` doubles with an early exit instead of the oracle's
#     `saturating_mul(1u32.checked_shl(attempt))`. Both compute
#     `min(base * 2^attempt, max)`; doubling-with-exit cannot overflow, so the
#     oracle's `checked_shl` / `saturating_mul` guards have no work to do.
# =========================================================================

# RetryConfig heap layout — 32 bytes.
enum AgnosaiRetryConfigOff {
    AGN_RETRY_MAX_RETRIES = 0;
    AGN_RETRY_BASE_DELAY_NS = 8;
    AGN_RETRY_MAX_DELAY_NS = 16;
    AGN_RETRY_JITTER = 24;
    AGN_RETRY_SIZE = 32;
}

# Create a retry config. Delays are nanoseconds; `jitter` is 1 or 0.
fn agnosai_retry_config_new(max_retries, base_delay_ns, max_delay_ns, jitter): i64 {
    var c = alloc(AGN_RETRY_SIZE);
    store64(c + AGN_RETRY_MAX_RETRIES, max_retries);
    store64(c + AGN_RETRY_BASE_DELAY_NS, base_delay_ns);
    store64(c + AGN_RETRY_MAX_DELAY_NS, max_delay_ns);
    store64(c + AGN_RETRY_JITTER, jitter);
    return c;
}

# The oracle's `Default`: 3 retries, 500ms base, 30s cap, jitter on.
fn agnosai_retry_config_default(): i64 {
    return agnosai_retry_config_new(3, 500 * AGNOSAI_NS_PER_MS, 30 * AGNOSAI_NS_PER_SEC, 1);
}

# No retries — fail immediately on the first error. Every other field keeps its
# default, as the oracle's `..Default::default()` does.
fn agnosai_retry_config_none(): i64 {
    var c = agnosai_retry_config_default();
    store64(c + AGN_RETRY_MAX_RETRIES, 0);
    return c;
}

# Aggressive retry for high-priority tasks: 5 retries, 250ms base, 60s cap.
fn agnosai_retry_config_aggressive(): i64 {
    return agnosai_retry_config_new(5, 250 * AGNOSAI_NS_PER_MS, 60 * AGNOSAI_NS_PER_SEC, 1);
}

# Maximum number of retry attempts (0 = no retries).
fn agnosai_retry_config_max_retries(c): i64 {
    return load64(c + AGN_RETRY_MAX_RETRIES);
}

# Base delay before the first retry, in nanoseconds.
fn agnosai_retry_config_base_delay_ns(c): i64 {
    return load64(c + AGN_RETRY_BASE_DELAY_NS);
}

# Maximum delay between retries, in nanoseconds.
fn agnosai_retry_config_max_delay_ns(c): i64 {
    return load64(c + AGN_RETRY_MAX_DELAY_NS);
}

# Whether random jitter is added to delays.
fn agnosai_retry_config_jitter(c): i64 {
    return load64(c + AGN_RETRY_JITTER);
}

# Compute the delay for a retry attempt, in nanoseconds.
#
# `min(base_delay * 2^attempt, max_delay)`, plus 0-25% jitter when enabled.
# The jitter range is computed from the *capped* delay in whole milliseconds,
# exactly as the oracle does — so a sub-4ms capped delay gets no jitter at all.
fn agnosai_compute_delay(config, attempt): i64 {
    var max_delay = load64(config + AGN_RETRY_MAX_DELAY_NS);
    var delay = load64(config + AGN_RETRY_BASE_DELAY_NS);
    for (var i = 0; i < attempt; i = i + 1) {
        if (delay >= max_delay) { break; }
        delay = delay * 2;
    }
    if (delay > max_delay) { delay = max_delay; }

    if (load64(config + AGN_RETRY_JITTER) == 0) { return delay; }

    var jitter_range = (delay / AGNOSAI_NS_PER_MS) / 4;
    if (jitter_range <= 0) { return delay; }

    # The oracle draws inclusively from 0..=jitter_range; scaling a [0,1)
    # uniform by (range + 1) and truncating gives the same closed range.
    var pick = f64_to(f64_mul(rng_uniform(), f64_from(jitter_range + 1)));
    if (pick > jitter_range) { pick = jitter_range; }
    return delay + pick * AGNOSAI_NS_PER_MS;
}

# `_agnosai_to_ascii_lower` moved to src/units.cyr at 2.0.7 — a generic ASCII helper that the
# [lib.guard] profile also needs, and which cannot live behind the LLM layer for that reason.

# Whether the already-lowercased `hay` contains `needle`.
fn _agnosai_lower_contains(hay: Str, needle) : i64 {
    return str_contains(hay, str_from(needle));
}

# Whether an error message indicates a transient, retryable failure.
#
# The needle list is the oracle's, in its order. Matching is substring-based
# after ASCII-lowercasing, so "HTTP 429 Too Many Requests" retries and
# "invalid API key" does not.
fn agnosai_is_retryable(error_msg: Str): i64 {
    var lower = _agnosai_to_ascii_lower(error_msg);
    if (_agnosai_lower_contains(lower, "rate limit") == 1) { return 1; }
    if (_agnosai_lower_contains(lower, "429") == 1) { return 1; }
    if (_agnosai_lower_contains(lower, "503") == 1) { return 1; }
    if (_agnosai_lower_contains(lower, "502") == 1) { return 1; }
    if (_agnosai_lower_contains(lower, "timeout") == 1) { return 1; }
    if (_agnosai_lower_contains(lower, "timed out") == 1) { return 1; }
    if (_agnosai_lower_contains(lower, "connection reset") == 1) { return 1; }
    if (_agnosai_lower_contains(lower, "connection refused") == 1) { return 1; }
    if (_agnosai_lower_contains(lower, "temporarily unavailable") == 1) { return 1; }
    if (_agnosai_lower_contains(lower, "service unavailable") == 1) { return 1; }
    if (_agnosai_lower_contains(lower, "server error") == 1) { return 1; }
    if (_agnosai_lower_contains(lower, "500") == 1) { return 1; }
    if (_agnosai_lower_contains(lower, "overloaded") == 1) { return 1; }
    if (_agnosai_lower_contains(lower, "capacity") == 1) { return 1; }
    return 0;
}

# Emit the retry trace the oracle's `warn!`/`debug!` calls carry. Guarded on
# the live level so formatting is only paid when it would be emitted.
fn _agnosai_retry_log(level, msg, msg_len, task_id: Str, attempt, err): i64 {
    if (sakshi_get_level() < level) { return 0; }
    var sb = str_builder_new();
    str_builder_add(sb, task_id);
    str_builder_add_cstr(sb, " attempt=");
    str_builder_add_int(sb, attempt);
    if (err != 0) {
        str_builder_add_cstr(sb, " error=");
        str_builder_add(sb, err);
    }
    var line = str_builder_build(sb);
    sakshi_log_kv(level, msg, msg_len, "task", 4, str_data(line), str_len(line));
    return 0;
}

# Execute a call with retry, returning the first success or the last error.
#
# `fp` is a function pointer with the contract described at the top of this
# module: `fn(ctx, out_value)` returning 0 on success (having written to
# `out_value`) or an error-message Str on failure. `agnosai_with_retry` returns
# the same way.
#
# A non-retryable error short-circuits immediately without consuming attempts —
# the oracle's behaviour, and the reason its `with_retry_skips_non_retryable`
# test asserts the callback ran exactly once.
fn agnosai_with_retry(config, task_id: Str, fp, ctx, out_value): i64 {
    var max_retries = load64(config + AGN_RETRY_MAX_RETRIES);
    var last_err = 0;

    for (var attempt = 0; attempt <= max_retries; attempt = attempt + 1) {
        var err = callptr(fp, ctx, out_value);
        if (err == 0) {
            if (attempt > 0) {
                _agnosai_retry_log(SK_DEBUG, "inference succeeded after retry", 31, task_id, attempt, 0);
            }
            return 0;
        }
        last_err = err;

        if (attempt >= max_retries) {
            _agnosai_retry_log(SK_WARN, "inference failed, retries exhausted", 35, task_id, attempt, err);
            return err;
        }
        if (agnosai_is_retryable(err) == 0) {
            _agnosai_retry_log(SK_WARN, "inference failed with non-retryable error", 41, task_id, attempt, err);
            return err;
        }

        _agnosai_retry_log(SK_WARN, "inference failed, retrying", 26, task_id, attempt, err);
        sleep_ms(agnosai_compute_delay(config, attempt) / AGNOSAI_NS_PER_MS);
    }

    # Unreachable: the loop runs at least once and every path returns. Kept as
    # a total function rather than a panic, mirroring the oracle's comment that
    # its `unreachable!` cannot fire.
    return last_err;
}
