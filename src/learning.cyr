# =========================================================================
# learning — adaptive learning and reinforcement learning for agent
# optimization.
#
# Parity oracle: rust-old/src/learning/mod.rs
#
# Pure Cyrius implementations of RL primitives — no Python ML libraries:
#
#   * agnosai_profile_*            — success rate and duration tracking per agent
#   * agnosai_ucb1_*               — multi-armed bandit for strategy selection
#   * agnosai_replay_buffer_*      — prioritized experience replay
#   * agnosai_capability_scorer_*  — dynamic confidence scoring with trend detection
#   * agnosai_qlearner_*           — tabular Q-learning
#
# This module is the hub mirroring mod.rs: it carries no logic of its own, only
# the include order. The five submodules are mutually independent, so the order
# below is the oracle's declaration order rather than a dependency constraint.
#
# Every f64 in this group is carried as its IEEE-754 bit pattern in an i64 —
# compare with f64_lt / f64_gt / f64_eq, never with the integer operators.
# =========================================================================

include "src/learning_capability.cyr"
include "src/learning_optimizer.cyr"
include "src/learning_profile.cyr"
include "src/learning_replay.cyr"
include "src/learning_strategy.cyr"
