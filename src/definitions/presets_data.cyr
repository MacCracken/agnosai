# The `i`th embedded preset document as a NUL-terminated C string, or 0 when
# `i` is out of range.
#
# A chain rather than a table because a `var` array of string literals has no
# spelling in Cyrius, and the caller is a one-shot loop.
fn agnosai_preset_json(i): i64 {
    if (i == 0) { return _AGNOSAI_PRESET_JSON_00; }
    if (i == 1) { return _AGNOSAI_PRESET_JSON_01; }
    if (i == 2) { return _AGNOSAI_PRESET_JSON_02; }
    return 0;
}
