# =========================================================================
# definitions/mod — the group hub.
#
# Parity oracle: rust-old/src/definitions/mod.rs
#
# Agent definition loading, crew assembly, and versioning: the declarative side
# of AgnosAI. The oracle's mod.rs is declarations and two re-exports and carries
# no logic; this hub is the same, holding only the include order.
#
# That order is a dependency constraint and Cyrius resolves in a single pass,
# callees before callers:
#
#   versioning — needs only core_agent
#   assembler  — needs core_agent, core_crew, core_task, and `src/strcase.cyr`
#   k8s_crd      — needs core_agent, core_crew, core_task
#   presets_data — GENERATED, needs nothing; `loader` reads it
#   loader       — needs core_agent, core_error, `src/strcase.cyr`, presets_data
#
# `src/core/mod.cyr` and `src/strcase.cyr` must precede this hub; `src/main.cyr`
# does both.
#
# `presets_data.cyr` is written by `./scripts/gen-presets.sh` from
# `src/presets/*.json` and committed; the script's `--check` mode fails on
# drift. Do not edit it by hand.
# =========================================================================

include "src/definitions/versioning.cyr"
include "src/definitions/assembler.cyr"
include "src/definitions/k8s_crd.cyr"
include "src/definitions/presets_data.cyr"
include "src/definitions/loader.cyr"
