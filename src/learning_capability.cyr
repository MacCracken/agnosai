# =========================================================================
# learning_capability — dynamic capability confidence scoring with trend
# detection.
#
# Parity oracle: rust-old/src/learning/capability.rs
#
# Port notes (divergences from the Rust shape, all deliberate):
#   * `CapabilityScorer::all_scores() -> Vec<(&str, &CapabilityScore)>` has no
#     zero-allocation Cyrius equivalent. It is split into
#     `agnosai_capability_scorer_keys` (the Str keys) plus
#     `agnosai_capability_scorer_score` (key -> score pointer), which together
#     express the same capability without minting a pair per entry.
#   * f64 values are carried as their IEEE-754 bit patterns in an i64, per the
#     language's float model. Compare with f64_lt / f64_gt, never with `<`.
# =========================================================================

# Direction the capability confidence is moving.
enum AgnosaiTrend {
    AGNOSAI_TREND_IMPROVING = 0;
    AGNOSAI_TREND_STABLE = 1;
    AGNOSAI_TREND_DECLINING = 2;
}

# CapabilityScore heap layout — 40 bytes.
enum AgnosaiCapScoreOff {
    AGN_CAP_CONFIDENCE = 0;
    AGN_CAP_SUCCESSES = 8;
    AGN_CAP_FAILURES = 16;
    AGN_CAP_TREND = 24;
    AGN_CAP_RECENT = 32;
    AGN_CAP_SIZE = 40;
}

# Maximum number of recent observations kept for trend detection.
# Mirrors CapabilityScore::MAX_RECENT.
var AGNOSAI_CAP_MAX_RECENT = 64;

# Number of trailing observations the trend verdict is computed over.
var AGNOSAI_CAP_TREND_WINDOW = 5;

# 0.1 as an f64 bit pattern — the trend threshold either side of zero.
# Written as a literal for the same reason tyche writes `_f64_2p53`: the
# value is a constant of the algorithm, not a computation.
fn _agnosai_f64_tenth(): i64 {
    return 0x3FB999999999999A;
}

# Allocate a CapabilityScore with the neutral prior: confidence 0.5, no
# outcomes recorded, Stable. Mirrors the private CapabilityScore::new.
fn _agnosai_cap_score_new(): i64 {
    var s = alloc(AGN_CAP_SIZE);
    store64(s + AGN_CAP_CONFIDENCE, F64_HALF);
    store64(s + AGN_CAP_SUCCESSES, 0);
    store64(s + AGN_CAP_FAILURES, 0);
    store64(s + AGN_CAP_TREND, AGNOSAI_TREND_STABLE);
    store64(s + AGN_CAP_RECENT, vec_new());
    return s;
}

# Recompute confidence as successes / (successes + failures). A score with no
# outcomes keeps its 0.5 prior — matching the Rust `if total > 0` guard.
fn _agnosai_cap_update_confidence(s): i64 {
    var succ = load64(s + AGN_CAP_SUCCESSES);
    var fail = load64(s + AGN_CAP_FAILURES);
    var total = succ + fail;
    if (total > 0) {
        store64(s + AGN_CAP_CONFIDENCE, f64_div(f64_from(succ), f64_from(total)));
    }
    return 0;
}

# Recompute the trend from the trailing window, after trimming `recent` back to
# AGNOSAI_CAP_MAX_RECENT. Call AFTER _agnosai_cap_update_confidence: the verdict
# is the recent rate measured against the *fresh* confidence.
fn _agnosai_cap_update_trend(s): i64 {
    var recent = load64(s + AGN_CAP_RECENT);

    # Trim to the bounded window to prevent unbounded growth.
    var len = vec_len(recent);
    while (len > AGNOSAI_CAP_MAX_RECENT) {
        vec_remove(recent, 0);
        len = len - 1;
    }

    if (len < AGNOSAI_CAP_TREND_WINDOW) {
        store64(s + AGN_CAP_TREND, AGNOSAI_TREND_STABLE);
        return 0;
    }

    var hits = 0;
    for (var i = len - AGNOSAI_CAP_TREND_WINDOW; i < len; i = i + 1) {
        if (vec_get(recent, i) == 1) { hits = hits + 1; }
    }
    var rate = f64_div(f64_from(hits), f64_from(AGNOSAI_CAP_TREND_WINDOW));
    var diff = f64_sub(rate, load64(s + AGN_CAP_CONFIDENCE));
    var tenth = _agnosai_f64_tenth();

    if (f64_gt(diff, tenth) == 1) {
        store64(s + AGN_CAP_TREND, AGNOSAI_TREND_IMPROVING);
    } elif (f64_lt(diff, f64_neg(tenth)) == 1) {
        store64(s + AGN_CAP_TREND, AGNOSAI_TREND_DECLINING);
    } else {
        store64(s + AGN_CAP_TREND, AGNOSAI_TREND_STABLE);
    }
    return 0;
}

# Look up the score for `capability`, inserting a fresh one when absent.
# The key is cloned on insert, matching the Rust `capability.to_string()`.
fn _agnosai_cap_entry(sc, capability: Str): i64 {
    var scores = load64(sc);
    var s = map_get(scores, capability);
    if (s != 0) { return s; }
    s = _agnosai_cap_score_new();
    map_set(scores, str_clone(capability), s);
    return s;
}

# Emit the debug trace Rust's `debug!(capability, confidence, trend)` carries.
# Guarded on the live level so the formatting cost is only paid when the
# message would actually be emitted — the Cyrius equivalent of the macro's
# lazy field evaluation.
fn _agnosai_cap_log(msg, msg_len, capability: Str, s): i64 {
    if (sakshi_get_level() < SK_DEBUG) { return 0; }
    var pct = f64_to(f64_mul(load64(s + AGN_CAP_CONFIDENCE), f64_from(100)));
    var sb = str_builder_new();
    str_builder_add(sb, capability);
    str_builder_add_cstr(sb, " confidence_pct=");
    str_builder_add_int(sb, pct);
    str_builder_add_cstr(sb, " trend=");
    str_builder_add_int(sb, load64(s + AGN_CAP_TREND));
    var line = str_builder_build(sb);
    sakshi_log_kv(SK_DEBUG, msg, msg_len, "capability", 10, str_data(line), str_len(line));
    return 0;
}

# Create a new scorer with no recorded capabilities.
fn agnosai_capability_scorer_new(): i64 {
    var sc = alloc(8);
    store64(sc, map_new_str());
    return sc;
}

# Record a successful outcome for the given capability.
fn agnosai_capability_scorer_record_success(sc, capability: Str): i64 {
    var s = _agnosai_cap_entry(sc, capability);
    store64(s + AGN_CAP_SUCCESSES, load64(s + AGN_CAP_SUCCESSES) + 1);
    vec_push(load64(s + AGN_CAP_RECENT), 1);
    _agnosai_cap_update_confidence(s);
    _agnosai_cap_update_trend(s);
    _agnosai_cap_log("capability success", 18, capability, s);
    return 0;
}

# Record a failed outcome for the given capability.
fn agnosai_capability_scorer_record_failure(sc, capability: Str): i64 {
    var s = _agnosai_cap_entry(sc, capability);
    store64(s + AGN_CAP_FAILURES, load64(s + AGN_CAP_FAILURES) + 1);
    vec_push(load64(s + AGN_CAP_RECENT), 0);
    _agnosai_cap_update_confidence(s);
    _agnosai_cap_update_trend(s);
    _agnosai_cap_log("capability failure", 18, capability, s);
    return 0;
}

# Confidence for a capability, as an f64 bit pattern.
# Returns 0.5 for capabilities that have never been recorded.
fn agnosai_capability_scorer_confidence(sc, capability: Str): i64 {
    var s = map_get(load64(sc), capability);
    if (s == 0) { return F64_HALF; }
    return load64(s + AGN_CAP_CONFIDENCE);
}

# Trend for a capability. Returns AGNOSAI_TREND_STABLE for unknown capabilities.
fn agnosai_capability_scorer_trend(sc, capability: Str): i64 {
    var s = map_get(load64(sc), capability);
    if (s == 0) { return AGNOSAI_TREND_STABLE; }
    return load64(s + AGN_CAP_TREND);
}

# The CapabilityScore pointer for a capability, or 0 when it has never been
# recorded. Paired with agnosai_capability_scorer_keys this covers the Rust
# `all_scores()` surface.
fn agnosai_capability_scorer_score(sc, capability: Str): i64 {
    return map_get(load64(sc), capability);
}

# A vec of the Str keys of every recorded capability.
fn agnosai_capability_scorer_keys(sc): i64 {
    return map_keys(load64(sc));
}

# Number of distinct capabilities recorded.
fn agnosai_capability_scorer_count(sc): i64 {
    return map_size(load64(sc));
}

# Current confidence of a score, as an f64 bit pattern.
fn agnosai_capability_score_confidence(s): i64 {
    return load64(s + AGN_CAP_CONFIDENCE);
}

# Total number of successful outcomes recorded against a score.
fn agnosai_capability_score_successes(s): i64 {
    return load64(s + AGN_CAP_SUCCESSES);
}

# Total number of failed outcomes recorded against a score.
fn agnosai_capability_score_failures(s): i64 {
    return load64(s + AGN_CAP_FAILURES);
}

# Direction a score's confidence is trending.
fn agnosai_capability_score_trend(s): i64 {
    return load64(s + AGN_CAP_TREND);
}

# Number of observations currently held in a score's trend window. Bounded by
# AGNOSAI_CAP_MAX_RECENT.
fn agnosai_capability_score_recent_len(s): i64 {
    return vec_len(load64(s + AGN_CAP_RECENT));
}
