# =========================================================================
# id — UUID v4 and v5.
#
# Parity oracle: the `uuid` crate's `Uuid::new_v4` / `Uuid::new_v5`, as used by
# rust-old/src/core/{message,agent}.rs. RFC 4122 layout.
#
# Why this exists rather than a dependency: **mneme cannot be used.** It has no
# lib block, ships no `dist/` bundle, and is AGPL-3.0 against agnosai's
# GPL-3.0-only. The port plan's Phase 0 calls for reimplementing v4/v5 over the
# stdlib's `random_bytes` + `sha1` instead, which is what this is. No mneme text
# was copied.
#
# A UUID is a bare 16-byte heap buffer — there is no wrapper struct, so it
# passes to memcpy/memeq directly. Render with `agnosai_uuid_to_str`.
#
# v4 draws from `random_bytes`, which is kernel entropy (getrandom), NOT tyche.
# tyche is a statistical PRNG and would make ids predictable.
# =========================================================================

# A UUID is 16 bytes.
var AGNOSAI_UUID_BYTES = 16;

# A rendered UUID is 36 characters: 32 hex digits plus 4 hyphens.
var AGNOSAI_UUID_STR_LEN = 36;

# Apply the RFC 4122 version and variant bits in place: the high nibble of byte
# 6 becomes `version`, and the top two bits of byte 8 become 0b10.
fn _agnosai_uuid_stamp(u, version): i64 {
    store8(u + 6, (load8(u + 6) & 0x0F) | (version << 4));
    store8(u + 8, (load8(u + 8) & 0x3F) | 0x80);
    return 0;
}

# The lowercase hex digit for a nibble.
fn _agnosai_hex_digit(n): i64 {
    if (n < 10) { return 48 + n; }
    return 87 + n;
}

# Generate a random (version 4) UUID.
fn agnosai_uuid_v4(): i64 {
    var u = alloc(AGNOSAI_UUID_BYTES);
    random_bytes(u, AGNOSAI_UUID_BYTES);
    _agnosai_uuid_stamp(u, 4);
    return u;
}

# Generate a name-based (version 5, SHA-1) UUID: SHA-1 over the 16-byte
# namespace UUID followed by `name`, truncated to 16 bytes and stamped.
# Deterministic — the same namespace and name always yield the same UUID.
fn agnosai_uuid_v5(namespace, name: Str): i64 {
    var name_len = str_len(name);
    var buf = alloc(AGNOSAI_UUID_BYTES + name_len);
    memcpy(buf, namespace, AGNOSAI_UUID_BYTES);
    memcpy(buf + AGNOSAI_UUID_BYTES, str_data(name), name_len);

    var digest = alloc(20);
    sha1(buf, AGNOSAI_UUID_BYTES + name_len, digest);

    var u = alloc(AGNOSAI_UUID_BYTES);
    memcpy(u, digest, AGNOSAI_UUID_BYTES);
    _agnosai_uuid_stamp(u, 5);
    return u;
}

# The all-zero (nil) UUID.
fn agnosai_uuid_nil(): i64 {
    var u = alloc(AGNOSAI_UUID_BYTES);
    memset(u, 0, AGNOSAI_UUID_BYTES);
    return u;
}

# Whether two UUIDs hold the same 16 bytes.
fn agnosai_uuid_eq(a, b): i64 {
    return memeq(a, b, AGNOSAI_UUID_BYTES);
}

# The RFC 4122 version nibble — 4 for v4, 5 for v5, 0 for nil.
fn agnosai_uuid_version(u): i64 {
    return (load8(u + 6) >> 4) & 0x0F;
}

# Render a UUID in the canonical lowercase 8-4-4-4-12 hyphenated form.
fn agnosai_uuid_to_str(u): i64 {
    var out = alloc(AGNOSAI_UUID_STR_LEN + 1);
    var pos = 0;
    for (var i = 0; i < AGNOSAI_UUID_BYTES; i = i + 1) {
        if (i == 4) { store8(out + pos, 45); pos = pos + 1; }
        if (i == 6) { store8(out + pos, 45); pos = pos + 1; }
        if (i == 8) { store8(out + pos, 45); pos = pos + 1; }
        if (i == 10) { store8(out + pos, 45); pos = pos + 1; }
        var b = load8(u + i);
        store8(out + pos, _agnosai_hex_digit((b >> 4) & 0x0F));
        store8(out + pos + 1, _agnosai_hex_digit(b & 0x0F));
        pos = pos + 2;
    }
    store8(out + pos, 0);
    return str_new(out, AGNOSAI_UUID_STR_LEN);
}

# Walk a canonical hyphenated UUID string, writing the decoded bytes through
# `out` when it is non-zero and validating only when it is 0. Answers 1 for a
# well-formed input, 0 otherwise.
#
# One scan, two callers, so `agnosai_uuid_is_valid` cannot drift from what
# `agnosai_uuid_parse` accepts — which matters because the routes decide **404
# versus 422** on the validator and the oracle's `Path<Uuid>` extractor decided
# it on the parser.
fn _agnosai_uuid_scan(s: Str, out): i64 {
    if (str_len(s) != AGNOSAI_UUID_STR_LEN) { return 0; }
    var data = str_data(s);
    var pos = 0;
    for (var i = 0; i < AGNOSAI_UUID_BYTES; i = i + 1) {
        if (i == 4 || i == 6 || i == 8 || i == 10) {
            if (load8(data + pos) != 45) { return 0; }
            pos = pos + 1;
        }
        # **Inlined rather than two calls to `_agnosai_hex_value`.** This runs
        # 32 times per validation, and at 36 bytes the call/return overhead was
        # most of the cost — 219 ns to scan 36 bytes, ~6 ns/byte. Still one
        # decoder: `_agnosai_hex_value` had no other caller, so there is no
        # second implementation to drift from.
        var hc = load8(data + pos) & 255;
        var hi = 0 - 1;
        if (hc >= 48 && hc <= 57) { hi = hc - 48; }
        elif (hc >= 97 && hc <= 102) { hi = hc - 87; }
        elif (hc >= 65 && hc <= 70) { hi = hc - 55; }
        if (hi < 0) { return 0; }

        var lc = load8(data + pos + 1) & 255;
        var lo = 0 - 1;
        if (lc >= 48 && lc <= 57) { lo = lc - 48; }
        elif (lc >= 97 && lc <= 102) { lo = lc - 87; }
        elif (lc >= 65 && lc <= 70) { lo = lc - 55; }
        if (lo < 0) { return 0; }
        if (out != 0) { store8(out + i, (hi << 4) | lo); }
        pos = pos + 2;
    }
    return 1;
}

# Whether `s` is a canonical hyphenated UUID. **Allocates nothing.**
#
# Every caller of `agnosai_uuid_parse` in `src/` was throwing the parsed buffer
# away — all five were `if (agnosai_uuid_parse(x) == 0)`, a validity test — so a
# request carrying an id paid 16 bytes of garbage on the no-free global bump,
# on the 404 arm as much as the 200 one. This is that test without the buffer.
fn agnosai_uuid_is_valid(s: Str): i64 {
    return _agnosai_uuid_scan(s, 0);
}

# Parse a canonical hyphenated UUID string. Returns the 16-byte UUID, or 0 when
# the input is not 36 characters of the expected shape.
#
# **Decodes into a stack buffer and allocates only on success**, which is a fix
# rather than a tidy-up: the previous shape allocated first and returned 0 from
# inside the loop, leaking the buffer on every rejection.
# `agnosai_uuid_canonical` is called from the `*_from_json` deserialisers and
# from `routes/sse.cyr`, so those rejections are attacker-controlled and
# unauthenticated — a body full of malformed ids leaked 16 bytes each with
# nothing to reclaim them.
#
# **The obvious spelling — validate with one scan, then decode with a second —
# was measured and rejected at 258 → 472 ns (+83%).** `agnosai_uuid_canonical`
# runs on every id in a deserialised crew, so that is not free. One scan into
# `tmp` plus a 16-byte `memcpy` keeps the leak fixed and the cost flat.
fn agnosai_uuid_parse(s: Str): i64 {
    # **16, not `AGNOSAI_UUID_BYTES`** — an array size must be a compile-time
    # literal or an enum constant, and that name is a `var`. `tests/id.tcyr`
    # asserts the two agree so the duplication cannot drift silently.
    var tmp[16];
    if (_agnosai_uuid_scan(s, &tmp) == 0) { return 0; }
    var u = alloc(AGNOSAI_UUID_BYTES);
    memcpy(u, &tmp, AGNOSAI_UUID_BYTES);
    return u;
}

# A fresh v4 identifier in canonical string form.
#
# This is what every `*_id` field in the port stores. See the note on
# `agnosai_uuid_canonical` for why ids are strings rather than the 16-byte
# buffers `agnosai_uuid_v4` returns.
fn agnosai_uuid_v4_str(): i64 {
    return agnosai_uuid_to_str(agnosai_uuid_v4());
}

# Validate and canonicalise a UUID string, or 0 when it is not a UUID.
#
# **Identifiers are stored as canonical strings, not as raw 16-byte buffers.**
# The buffer form is the natural one — it is what `uuid::Uuid` is in the oracle,
# it is half the size, and `agnosai_uuid_eq` is a 16-byte memcmp. It was also a
# standing trap: Cyrius has no types to stop a buffer reaching `str_eq` or a
# `map_new_str` key, where its first eight bytes are read as a string length.
# That is not a compile error and not a clean crash — it is a segfault three
# call layers away, and it cost a real debugging session in `orch_scheduler`.
#
# Storing the canonical string removes the trap rather than documenting it: ids
# compare with `str_eq`, key a `map_new_str` directly, and serialise without a
# conversion. The wire form is unchanged, because that was already the canonical
# string. The byte-level verbs remain for callers who genuinely want bytes.
#
# Parsing and re-rendering also normalises case, which matches the oracle: the
# `uuid` crate parses hex of either case into bytes and its Display always emits
# lowercase.
fn agnosai_uuid_canonical(s: Str): i64 {
    var u = agnosai_uuid_parse(s);
    if (u == 0) { return 0; }
    return agnosai_uuid_to_str(u);
}
