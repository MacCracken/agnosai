# =========================================================================
# learning_replay — prioritized experience replay buffer.
#
# Parity oracle: rust-old/src/learning/replay.rs
#
# Port notes (divergences from the Rust shape, all deliberate):
#   * `rand::rng().random_range(0.0..1.0)` becomes tyche's `rng_uniform()`.
#     tyche is STATISTICAL, not cryptographic — correct for replay sampling,
#     and never to be reused for the audit key or any token path.
#   * `Vec::swap_remove` has no stdlib equivalent, so `_agnosai_replay_swap_remove`
#     reproduces it exactly (move the last element into the hole, pop). The
#     resulting element ORDER is observable through
#     `agnosai_replay_buffer_get`, so it is held to the oracle's behaviour
#     rather than to the simpler shift-remove.
#   * Tie-breaking follows Rust's iterator contract: `min_by` returns the FIRST
#     of several equal minima, so the eviction scan updates only on a strictly
#     smaller priority.
# =========================================================================

# Experience heap layout — 40 bytes.
enum AgnosaiExperienceOff {
    AGN_EXP_STATE = 0;
    AGN_EXP_ACTION = 8;
    AGN_EXP_REWARD = 16;
    AGN_EXP_NEXT_STATE = 24;
    AGN_EXP_PRIORITY = 32;
    AGN_EXP_SIZE = 40;
}

# ReplayBuffer heap layout — 16 bytes.
enum AgnosaiReplayOff {
    AGN_REPLAY_EXPERIENCES = 0;
    AGN_REPLAY_MAX_SIZE = 8;
    AGN_REPLAY_SIZE = 16;
}

# Whether an f64 bit pattern is NaN. NaN is the only value that compares
# unequal to itself.
fn _agnosai_f64_is_nan(x): i64 {
    if (f64_eq(x, x) == 1) { return 0; }
    return 1;
}

# Vec::swap_remove — move the last element into `idx`, then drop the tail.
# A no-op for an out-of-range index.
fn _agnosai_replay_swap_remove(v, idx): i64 {
    var len = vec_len(v);
    if (idx < 0) { return 0; }
    if (idx >= len) { return 0; }
    var last = vec_pop(v);
    if (idx < vec_len(v)) { vec_set(v, idx, last); }
    return 0;
}

# Index of the lowest-priority experience, or -1 for an empty buffer.
# Ties resolve to the FIRST such index, matching Rust's `min_by`.
fn _agnosai_replay_min_priority_idx(experiences): i64 {
    var len = vec_len(experiences);
    if (len == 0) { return 0 - 1; }
    var best_i = 0;
    var best = load64(vec_get(experiences, 0) + AGN_EXP_PRIORITY);
    for (var i = 1; i < len; i = i + 1) {
        var p = load64(vec_get(experiences, i) + AGN_EXP_PRIORITY);
        if (f64_gt(best, p) == 1) {
            best = p;
            best_i = i;
        }
    }
    return best_i;
}

# Create a new experience tuple. `reward` and `priority` are f64 bit patterns.
fn agnosai_experience_new(state: Str, action: Str, reward, next_state: Str, priority): i64 {
    var e = alloc(AGN_EXP_SIZE);
    store64(e + AGN_EXP_STATE, state);
    store64(e + AGN_EXP_ACTION, action);
    store64(e + AGN_EXP_REWARD, reward);
    store64(e + AGN_EXP_NEXT_STATE, next_state);
    store64(e + AGN_EXP_PRIORITY, priority);
    return e;
}

# State before the action was taken.
fn agnosai_experience_state(e): i64 {
    return load64(e + AGN_EXP_STATE);
}

# Action that was taken.
fn agnosai_experience_action(e): i64 {
    return load64(e + AGN_EXP_ACTION);
}

# Reward received after the action, as an f64 bit pattern.
fn agnosai_experience_reward(e): i64 {
    return load64(e + AGN_EXP_REWARD);
}

# State after the action was taken.
fn agnosai_experience_next_state(e): i64 {
    return load64(e + AGN_EXP_NEXT_STATE);
}

# Sampling priority, as an f64 bit pattern. Higher means more likely replayed.
fn agnosai_experience_priority(e): i64 {
    return load64(e + AGN_EXP_PRIORITY);
}

# Create a new replay buffer with the given maximum capacity.
fn agnosai_replay_buffer_new(max_size): i64 {
    var b = alloc(AGN_REPLAY_SIZE);
    store64(b + AGN_REPLAY_EXPERIENCES, vec_new());
    store64(b + AGN_REPLAY_MAX_SIZE, max_size);
    return b;
}

# Number of experiences currently in the buffer.
fn agnosai_replay_buffer_len(b): i64 {
    return vec_len(load64(b + AGN_REPLAY_EXPERIENCES));
}

# Whether the buffer contains no experiences.
fn agnosai_replay_buffer_is_empty(b): i64 {
    if (vec_len(load64(b + AGN_REPLAY_EXPERIENCES)) == 0) { return 1; }
    return 0;
}

# The experience at `idx`, or 0 when out of range.
fn agnosai_replay_buffer_get(b, idx): i64 {
    var experiences = load64(b + AGN_REPLAY_EXPERIENCES);
    if (idx < 0) { return 0; }
    if (idx >= vec_len(experiences)) { return 0; }
    return vec_get(experiences, idx);
}

# Push an experience. At capacity, evicts the lowest-priority experience — but
# only when the incoming one outranks it; otherwise the push is dropped.
fn agnosai_replay_buffer_push(b, exp): i64 {
    var experiences = load64(b + AGN_REPLAY_EXPERIENCES);
    if (vec_len(experiences) < load64(b + AGN_REPLAY_MAX_SIZE)) {
        vec_push(experiences, exp);
        return 0;
    }

    var min_idx = _agnosai_replay_min_priority_idx(experiences);
    if (min_idx < 0) { return 0; }
    var min_priority = load64(vec_get(experiences, min_idx) + AGN_EXP_PRIORITY);
    if (f64_gt(load64(exp + AGN_EXP_PRIORITY), min_priority) == 1) {
        _agnosai_replay_swap_remove(experiences, min_idx);
        vec_push(experiences, exp);
    }
    return 0;
}

# Update the priority of the experience at `index`. Out-of-range is ignored.
fn agnosai_replay_buffer_update_priority(b, index, new_priority): i64 {
    var e = agnosai_replay_buffer_get(b, index);
    if (e == 0) { return 0; }
    store64(e + AGN_EXP_PRIORITY, new_priority);
    return 0;
}

# Sample a batch of experiences weighted by priority, without replacement.
# Returns a vec of up to `batch_size` experience pointers — fewer when the
# buffer holds fewer. Remaining priority is recomputed each round to avoid bias,
# and a non-positive or NaN total falls back to filling from unselected in
# index order, exactly as the oracle does.
fn agnosai_replay_buffer_sample(b, batch_size): i64 {
    var experiences = load64(b + AGN_REPLAY_EXPERIENCES);
    var result = vec_new();
    var len = vec_len(experiences);
    if (len == 0) { return result; }

    var n = batch_size;
    if (n > len) { n = len; }

    var selected = vec_new();
    for (var s = 0; s < len; s = s + 1) { vec_push(selected, 0); }

    for (var round = 0; round < n; round = round + 1) {
        var remaining = f64_from(0);
        for (var i = 0; i < len; i = i + 1) {
            if (vec_get(selected, i) == 0) {
                remaining = f64_add(remaining, f64_abs(load64(vec_get(experiences, i) + AGN_EXP_PRIORITY)));
            }
        }

        if (f64_le(remaining, f64_from(0)) == 1) {
            _agnosai_replay_fill_unselected(experiences, selected, result, n);
            return result;
        }
        if (_agnosai_f64_is_nan(remaining) == 1) {
            _agnosai_replay_fill_unselected(experiences, selected, result, n);
            return result;
        }

        var r = f64_mul(rng_uniform(), remaining);
        var chosen = 0;
        for (var j = 0; j < len; j = j + 1) {
            if (vec_get(selected, j) == 1) { continue; }
            r = f64_sub(r, f64_abs(load64(vec_get(experiences, j) + AGN_EXP_PRIORITY)));
            chosen = j;
            if (f64_le(r, f64_from(0)) == 1) { break; }
        }
        vec_set(selected, chosen, 1);
        vec_push(result, vec_get(experiences, chosen));
    }

    return result;
}

# Fallback path for sample(): top `result` up to `n` from the unselected
# experiences in index order.
fn _agnosai_replay_fill_unselected(experiences, selected, result, n): i64 {
    var len = vec_len(experiences);
    for (var i = 0; i < len; i = i + 1) {
        if (vec_len(result) >= n) { break; }
        if (vec_get(selected, i) == 0) {
            vec_set(selected, i, 1);
            vec_push(result, vec_get(experiences, i));
        }
    }
    return 0;
}
