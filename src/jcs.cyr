# =========================================================================
# jcs — the JSON Canonicalization Scheme, RFC 8785, over a bayan value (2.6.0).
#
# Port-local: no `rust-old/` counterpart. A signature over JSON is a signature
# over bytes, so a signer and a verifier must serialize a value the same way:
# RFC 8785 says how. An A2A Agent Card is signed over its canonical form (A2A
# §8.4, ADR 040).
#
# What canonical means here, the RFC's rules for what a bayan value can hold:
#
# - **No whitespace**, and members separated by `,` and `:` alone.
# - **An object's members sorted by their names' UTF-16 code units**, as
#   ECMAScript sorts strings. For an ASCII name that is byte order; past it, a
#   character outside the Basic Multilingual Plane sorts by its surrogates, so
#   by UTF-16 rather than by code point. A name twice in one object is refused,
#   as the RFC's input has none.
# - **A string as ECMAScript's `JSON.stringify` writes it**: `"` and `\`
#   escaped, U+0008, U+0009, U+000A, U+000C and U+000D as `\b`, `\t`, `\n`,
#   `\f` and `\r`, any other control character as `\u00xx` in lower-case hex,
#   and everything else as it is, in UTF-8.
# - **An integer in decimal.** A float would need ECMAScript's shortest
#   round-trip form (RFC 8785 §3.2.2.3), which this does not write: a value
#   holding one is refused rather than written wrong.
#
# A refusal is 0, so a signer signs nothing rather than something a verifier
# would compute differently.
# =========================================================================

# The canonical form of `v`, a Str in `a`, or 0 when `v` holds what this cannot write canonically:
# a float, or an object with a name twice.
fn agnosai_jcs_a(a, v): i64 {
    var sb = str_builder_new_a(a);
    if (_agnosai_jcs_value(a, sb, v) != 0) { return 0; }
    return str_builder_build_a(a, sb);
}

# Write `v` to `sb`. 0, or -1 when it cannot be written canonically.
fn _agnosai_jcs_value(a, sb, v): i64 {
    if (v == 0 || bayan_json_v_is_null(v) == 1) {
        str_builder_add_cstr_a(a, sb, "null");
        return 0;
    }
    if (bayan_json_v_is_bool(v) == 1) {
        if (bayan_json_v_bool(v) == 1) { str_builder_add_cstr_a(a, sb, "true"); }
        else { str_builder_add_cstr_a(a, sb, "false"); }
        return 0;
    }
    if (bayan_json_v_is_int(v) == 1) {
        str_builder_add_int_a(a, sb, bayan_json_v_int(v));
        return 0;
    }
    if (bayan_json_v_is_str(v) == 1) {
        _agnosai_jcs_string(a, sb, bayan_json_v_str(v));
        return 0;
    }
    if (bayan_json_v_is_arr(v) == 1) {
        str_builder_add_cstr_a(a, sb, "[");
        for (var i = 0; i < bayan_json_v_arr_len(v); i = i + 1) {
            if (i > 0) { str_builder_add_cstr_a(a, sb, ","); }
            if (_agnosai_jcs_value(a, sb, bayan_json_v_arr_get(v, i)) != 0) { return 0 - 1; }
        }
        str_builder_add_cstr_a(a, sb, "]");
        return 0;
    }
    if (bayan_json_v_is_obj(v) == 1) { return _agnosai_jcs_object(a, sb, v); }
    # A float, or a kind this does not know.
    return 0 - 1;
}

# An object's members, by their names' UTF-16 code units.
fn _agnosai_jcs_object(a, sb, v): i64 {
    var n = bayan_json_v_obj_len(v);
    var order = vec_new_a(a);
    for (var i = 0; i < n; i = i + 1) { vec_push_a(a, order, i); }
    # An insertion sort on indices, by name: a card's objects hold a dozen members at most, and the
    # comparator needs the object, which a sort's two-argument comparator does not carry.
    for (var j = 1; j < n; j = j + 1) {
        var x = vec_get(order, j);
        var k = j - 1;
        while (k >= 0 && agnosai_jcs_cmp(bayan_json_v_obj_key(v, vec_get(order, k)), bayan_json_v_obj_key(v, x)) > 0) {
            vec_set(order, k + 1, vec_get(order, k));
            k = k - 1;
        }
        vec_set(order, k + 1, x);
    }
    str_builder_add_cstr_a(a, sb, "{");
    for (var m = 0; m < n; m = m + 1) {
        var at = vec_get(order, m);
        var name = bayan_json_v_obj_key(v, at);
        if (m > 0) {
            if (agnosai_jcs_cmp(bayan_json_v_obj_key(v, vec_get(order, m - 1)), name) == 0) { return 0 - 1; }
            str_builder_add_cstr_a(a, sb, ",");
        }
        _agnosai_jcs_string(a, sb, name);
        str_builder_add_cstr_a(a, sb, ":");
        if (_agnosai_jcs_value(a, sb, bayan_json_v_obj_val(v, at)) != 0) { return 0 - 1; }
    }
    str_builder_add_cstr_a(a, sb, "}");
    return 0;
}

fn _agnosai_jcs_hex(d): i64 {
    if (d < 10) { return 48 + d; }
    return 87 + d;
}

# `s` as ECMAScript's `JSON.stringify` writes it.
fn _agnosai_jcs_string(a, sb, s: Str): i64 {
    var d = str_data(s);
    var n = str_len(s);
    str_builder_add_cstr_a(a, sb, "\"");
    var start = 0;
    for (var i = 0; i < n; i = i + 1) {
        var c = load8(d + i);
        var esc = 0;
        if (c == 34) { esc = "\\\""; }
        if (c == 92) { esc = "\\\\"; }
        if (c == 8) { esc = "\\b"; }
        if (c == 9) { esc = "\\t"; }
        if (c == 10) { esc = "\\n"; }
        if (c == 12) { esc = "\\f"; }
        if (c == 13) { esc = "\\r"; }
        if (esc != 0 || c < 32) {
            if (i > start) { str_builder_add_a(a, sb, str_new_a(a, d + start, i - start)); }
            if (esc != 0) { str_builder_add_cstr_a(a, sb, esc); }
            else {
                var u[8];
                store8(&u, 92);
                store8(&u + 1, 117);
                store8(&u + 2, 48);
                store8(&u + 3, 48);
                store8(&u + 4, _agnosai_jcs_hex(c / 16));
                store8(&u + 5, _agnosai_jcs_hex(c % 16));
                store8(&u + 6, 0);
                str_builder_add_cstr_a(a, sb, &u);
            }
            start = i + 1;
        }
    }
    if (n > start) { str_builder_add_a(a, sb, str_new_a(a, d + start, n - start)); }
    str_builder_add_cstr_a(a, sb, "\"");
    return 0;
}

# The code point at `p[*at]` in UTF-8, moving `*at` past it. A byte that starts no sequence is
# taken as itself, so a malformed name still sorts, the same way every time.
fn _agnosai_jcs_cp(p, n, at): i64 {
    var i = load64(at);
    var c = load8(p + i);
    var len = 1;
    var cp = c;
    if (c >= 0xF0 && i + 3 < n) {
        len = 4;
        cp = ((c & 7) << 18) | ((load8(p + i + 1) & 63) << 12) | ((load8(p + i + 2) & 63) << 6)
        | (load8(p + i + 3) & 63);
    } elif (c >= 0xE0 && i + 2 < n) {
        len = 3;
        cp = ((c & 15) << 12) | ((load8(p + i + 1) & 63) << 6) | (load8(p + i + 2) & 63);
    } elif (c >= 0xC0 && i + 1 < n) {
        len = 2;
        cp = ((c & 31) << 6) | (load8(p + i + 1) & 63);
    }
    store64(at, i + len);
    return cp;
}

# The UTF-16 code units of code point `cp`: the one, or the pair's high in the upper 16 bits.
fn _agnosai_jcs_units(cp): i64 {
    if (cp < 0x10000) { return cp; }
    var v = cp - 0x10000;
    var hi = 0xD800 + (v >> 10);
    var lo = 0xDC00 + (v & 0x3FF);
    return (hi << 16) | lo;
}

# How two names compare by their UTF-16 code units, as RFC 8785 §3.2.3 sorts them: below 0, 0, or
# above 0.
fn agnosai_jcs_cmp(x: Str, y: Str): i64 {
    var px = str_data(x);
    var nx = str_len(x);
    var py = str_data(y);
    var ny = str_len(y);
    var ix: i64[1];
    var iy: i64[1];
    store64(&ix, 0);
    store64(&iy, 0);
    # A unit left over from a surrogate pair, compared before the next code point is read.
    var px_pending = 0 - 1;
    var py_pending = 0 - 1;
    while (1 == 1) {
        var ux = px_pending;
        if (ux < 0) {
            if (load64(&ix) >= nx) { ux = 0 - 1; }
            else {
                var cx = _agnosai_jcs_units(_agnosai_jcs_cp(px, nx, &ix));
                if (cx > 0xFFFF) {
                    ux = cx >> 16;
                    px_pending = cx & 0xFFFF;
                } else { ux = cx; }
            }
        } else { px_pending = 0 - 1; }
        var uy = py_pending;
        if (uy < 0) {
            if (load64(&iy) >= ny) { uy = 0 - 1; }
            else {
                var cy = _agnosai_jcs_units(_agnosai_jcs_cp(py, ny, &iy));
                if (cy > 0xFFFF) {
                    uy = cy >> 16;
                    py_pending = cy & 0xFFFF;
                } else { uy = cy; }
            }
        } else { py_pending = 0 - 1; }
        if (ux < 0 && uy < 0) { return 0; }
        if (ux < 0) { return 0 - 1; }
        if (uy < 0) { return 1; }
        if (ux != uy) { return ux - uy; }
    }
    return 0;
}
