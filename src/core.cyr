# =========================================================================
# core — core types and error handling for AgnosAI.
#
# Parity oracle: rust-old/src/core/mod.rs
#
# The foundational types shared across every other group: agents, tasks, crews,
# messages, resources, and errors. No I/O — pure data, with JSON support via
# bayan where the oracle used serde.
#
# This module is the hub mirroring mod.rs: it carries no logic of its own, only
# the include order. That order IS a dependency constraint here (unlike the
# learning hub's): core_message reads AGNOSAI_NS_PER_SEC from core_error and
# the UUID surface from src/id.cyr, and Cyrius resolution is single-pass, so
# callees must precede callers.
#
# PORT IN PROGRESS — the oracle's six submodules land one bite at a time:
#   * error    — done
#   * message  — done
#   * task     — not started
#   * agent    — not started (gated on bhava/`personality` being feature-gated
#                out; bhava is post-v2 by user decree)
#   * crew     — not started
#   * resource — not started (carries the cost path: integer micro-USD)
# =========================================================================

include "src/core_error.cyr"
include "src/core_message.cyr"
