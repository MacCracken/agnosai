# =========================================================================
# tools/remote_registry — fetch a remote tool package over a guarded HTTP GET.
#
# Parity oracle: rust-old/src/tools/remote_registry.rs
#
# **The oracle's module doc overstates what the oracle does.** It says the
# module "fetches `.agpkg` ZIP bundles or raw WASM modules from a remote URL,
# validates them, and registers the contained tools in the `ToolRegistry`". The
# code does none of the last three: there is no ZIP reader, no WASM parser and
# no registration anywhere in the file. `fetch_package` downloads bytes, checks
# the URL against the SSRF guard, enforces a 10 MB cap, and returns the buffer.
# `remote_registry` is also `pub mod` with **zero consumers** — nothing in the
# Rust tree calls `fetch_package` or names `FetchResult`.
#
# So this is a **complete** port of the unit, not a partial one waiting on
# `.agpkg` and WASM support. Those formats gate the *unwritten* half of the
# oracle's doc comment, not any behaviour that exists to be matched. The port
# plan's "can only deliver a guarded fetch" was right about the outcome and
# wrong about the reason.
#
# The one deliberate divergence is the redirect handling required by
# [ADR 007](../docs/adr/007-audit-redirect-revalidation.md), and it matters more
# here than it did in security_audit: this fetches a **payload**, and the
# oracle's own doc says that payload is meant to become executable WASM. The
# oracle checks `is_safe_url` once and then lets reqwest follow up to ten
# redirects unvalidated, so a URL that passes the guard can hand back bytes from
# `169.254.169.254`. `src/guarded_fetch.cyr` re-runs the guard on every hop.
# =========================================================================

# The oracle's `MAX_DOWNLOAD_SIZE`: 10 MB, written as `10 * 1024 * 1024`.
var AGNOSAI_REMOTE_MAX_DOWNLOAD = 10485760;

# The oracle's reqwest client timeout, 30 seconds.
var AGNOSAI_REMOTE_TIMEOUT_MS = 30000;

# Scratch arena for one exchange. Sized for a full-cap payload plus the response
# struct, header table and request line around it; the guarded fetch resets it
# between hops, so this bounds one exchange rather than a whole redirect chain.
var AGNOSAI_REMOTE_ARENA_BYTES = 12582912;

# Pool for the download arena. See `src/arena_pool.cyr`.
#
# ⚠ **Was `arena_allocator(AGNOSAI_REMOTE_ARENA_BYTES)` per fetch** — 12 MiB + 112
# bytes on the no-free global bump, per remote package, never returned. The
# largest of the five per-operation sites.
#
# **2 slots**: a package fetch is an operator-initiated, rare operation, not a
# request-path one. The fallback covers a burst without pinning 12 MiB x N.
var _AGNOSAI_REMOTE_ARENA_SLOTS = 2;
var _AGNOSAI_REMOTE_POOL = agnosai_arena_pool_new(_AGNOSAI_REMOTE_ARENA_SLOTS,
  AGNOSAI_REMOTE_ARENA_BYTES);

# FetchResult — the oracle's two-variant enum flattened into one struct.
#
# Cyrius has no sum types, so `Ok { size_bytes, content_type, data }` and
# `Error(String)` share a record discriminated by `AGN_RR_OK`. `content_type`
# is `Option<String>`: 0 means the header was absent, which is distinct from an
# empty value and stays distinct on the wire.
enum AgnosaiRemoteOff {
    AGN_RR_OK = 0;
    AGN_RR_SIZE_BYTES = 8;
    AGN_RR_CONTENT_TYPE = 16;
    AGN_RR_DATA = 24;
    AGN_RR_ERROR = 32;
    AGN_REMOTE_REG_SIZE = 40;
}

# Whether the fetch succeeded — the oracle's `FetchResult::Ok` arm.
fn agnosai_fetch_result_ok(r): i64 {
    return load64(r + AGN_RR_OK);
}

# Bytes downloaded. Meaningful only on the Ok arm.
fn agnosai_fetch_result_size(r): i64 {
    return load64(r + AGN_RR_SIZE_BYTES);
}

# The response's `content-type`, or 0 when the header was absent.
fn agnosai_fetch_result_content_type(r): i64 {
    return load64(r + AGN_RR_CONTENT_TYPE);
}

# The downloaded bytes as a Str, or 0 on the Error arm.
fn agnosai_fetch_result_data(r): i64 {
    return load64(r + AGN_RR_DATA);
}

# The failure message, or 0 on the Ok arm.
fn agnosai_fetch_result_error(r): i64 {
    return load64(r + AGN_RR_ERROR);
}

# Build the Error arm.
fn _agnosai_remote_err(msg: Str): i64 {
    var r = alloc(AGN_REMOTE_REG_SIZE);
    store64(r + AGN_RR_OK, 0);
    store64(r + AGN_RR_SIZE_BYTES, 0);
    store64(r + AGN_RR_CONTENT_TYPE, 0);
    store64(r + AGN_RR_DATA, 0);
    store64(r + AGN_RR_ERROR, msg);
    return r;
}

# The oracle's `format!("package too large: {len} bytes (max {MAX})")`.
#
# Emitted from two places in the oracle with the same wording — once against
# `content_length()` before the body is read, once against the actual byte count
# after. Both are reproduced, because a lying `Content-Length` is exactly the
# case the second check exists for.
fn agnosai_remote_too_large_err(len): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "package too large: ");
    str_builder_add_int(sb, len);
    str_builder_add_cstr(sb, " bytes (max ");
    str_builder_add_int(sb, AGNOSAI_REMOTE_MAX_DOWNLOAD);
    str_builder_add_cstr(sb, ")");
    return str_builder_build(sb);
}

# The oracle's `format!("HTTP {}", response.status())`.
#
# Rust's `StatusCode` Display renders code *and* reason — `404 Not Found` — so
# the oracle's message is "HTTP 404 Not Found". sandhi carries only the numeric
# code on the response, and inventing a reason table to match would be guessing
# at what the server actually sent. The code is emitted alone and the divergence
# is recorded here rather than papered over.
fn agnosai_remote_status_err(status): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "HTTP ");
    str_builder_add_int(sb, status);
    return str_builder_build(sb);
}

# The oracle's `status().is_success()` — the 2xx class.
fn agnosai_remote_is_success(status): i64 {
    if (status >= 200 && status < 300) { return 1; }
    return 0;
}

# Trace the two `info!` calls the oracle carries.
fn _agnosai_remote_log(msg, msg_len, url: Str, size): i64 {
    if (sakshi_get_level() < SK_INFO) { return 0; }
    var sb = str_builder_new();
    str_builder_add(sb, url);
    if (size >= 0) {
        str_builder_add_cstr(sb, " size_bytes=");
        str_builder_add_int(sb, size);
    }
    var line = str_builder_build(sb);
    sakshi_log_kv(SK_INFO, msg, msg_len, "remote_registry", 15, str_data(line), str_len(line));
    return 0;
}

# Request options matching the oracle's client: a 30s budget and a cap one byte
# above the package limit.
#
# The cap is `MAX + 1` on purpose. sandhi treats an over-cap response as a hard
# protocol error, so setting it *at* the limit would turn an exactly-10 MB
# package — which the oracle accepts, since its check is `>` — into a transport
# failure. One byte of headroom lets a package at the limit through and lets an
# over-limit one be rejected by the size check below, with the oracle's wording
# rather than sandhi's.
fn _agnosai_remote_options(): i64 {
    var opts = sandhi_http_options_new();
    if (opts == 0) { return 0; }
    sandhi_http_options_total_ms(opts, AGNOSAI_REMOTE_TIMEOUT_MS);
    sandhi_http_options_max_response_bytes(opts, AGNOSAI_REMOTE_MAX_DOWNLOAD + 1);
    sandhi_http_options_tls_policy(opts, SANDHI_TLS_POLICY_DEFAULT);
    return opts;
}

# Fetch a tool package from a remote URL.
#
# The oracle's `fetch_package`, arm for arm: the SSRF check first, then the GET,
# then a 2xx check, then the `Content-Length` pre-check, then the content type,
# then the body with a second size check against what actually arrived.
#
# `transport_fp` is `fn(arena, method, url, headers, opts, timeout_ms) -> resp`
# — normally `&agnosai_guarded_fetch`. It is a parameter so the tests can drive
# every arm above without a network, the same seam `load_testing` and
# `tools_agnos` use.
fn agnosai_fetch_package_via(url: Str, transport_fp): i64 {
    # The guard runs before anything touches the network, and again on every
    # redirect hop inside the transport.
    if (agnosai_is_safe_url(url) == 0) {
        return _agnosai_remote_err(str_from("URL rejected: private/internal network"));
    }

    _agnosai_remote_log("fetching remote tool package", 28, url, 0 - 1);

    var arena = agnosai_arena_pool_acquire(_AGNOSAI_REMOTE_POOL);
    if (arena == 0) { return _agnosai_remote_err(str_from("download failed")); }
    var opts = _agnosai_remote_options();
    if (opts == 0) {
        agnosai_arena_pool_release(_AGNOSAI_REMOTE_POOL, arena);
        return _agnosai_remote_err(str_from("download failed"));
    }

    var resp = callptr(transport_fp, arena, "GET", url, sandhi_headers_new(), opts,
      AGNOSAI_REMOTE_TIMEOUT_MS);

    if (resp == AGNOSAI_FETCH_BLOCKED) {
        agnosai_arena_pool_release(_AGNOSAI_REMOTE_POOL, arena);
        # Not one of the oracle's messages: the oracle cannot reach this state,
        # because it never re-checks a redirect target. It reads like the
        # up-front rejection because it is the same rejection, one hop later.
        return _agnosai_remote_err(
          str_from("URL rejected: private/internal network (via redirect)"));
    }
    if (resp == 0 || sandhi_http_err_kind(resp) != SANDHI_OK) {
        agnosai_arena_pool_release(_AGNOSAI_REMOTE_POOL, arena);
        return _agnosai_remote_err(str_from("download failed"));
    }

    var status = sandhi_http_status(resp);
    if (agnosai_remote_is_success(status) == 0) {
        agnosai_arena_pool_release(_AGNOSAI_REMOTE_POOL, arena);
        return _agnosai_remote_err(agnosai_remote_status_err(status));
    }

    # The oracle's `content_length()` pre-check, before the body is read.
    var headers = sandhi_http_headers(resp);
    var declared = sandhi_headers_get(headers, "content-length");
    if (declared != 0) {
        var declared_len = str_to_int(str_from(declared));
        if (declared_len > AGNOSAI_REMOTE_MAX_DOWNLOAD) {
            agnosai_arena_pool_release(_AGNOSAI_REMOTE_POOL, arena);
            return _agnosai_remote_err(agnosai_remote_too_large_err(declared_len));
        }
    }

    # Copied out before the arena goes — `str_clone` and `str_from_buf` both
    # allocate through the default allocator, so the result outlives the reset.
    var ctype = 0;
    var ctype_raw = sandhi_headers_get(headers, "content-type");
    if (ctype_raw != 0) { ctype = str_clone(str_from(ctype_raw)); }

    var body_len = sandhi_http_body_len(resp);

    # The second size check. A server that under-declares `Content-Length`, or
    # omits it entirely, gets caught here — which is the whole reason the oracle
    # checks twice.
    if (body_len > AGNOSAI_REMOTE_MAX_DOWNLOAD) {
        agnosai_arena_pool_release(_AGNOSAI_REMOTE_POOL, arena);
        return _agnosai_remote_err(agnosai_remote_too_large_err(body_len));
    }

    # ⚠ **Same null-body read as `tools/agnos.cyr`, and with a WIDER window.**
    # sandhi's `_sandhi_resp_frame_a` (`lib/sandhi.cyr:3345`) assigns
    # `body_ptr = _sandhi_resp_body_copy_a(...)` unchecked and still reports
    # `SANDHI_OK`; that copy answers 0 when the arena cannot fit it. sandhi
    # allocates the receive buffer eagerly at the full cap
    # (`lib/sandhi.cyr:4644`) — 10,485,761 + 1 here — out of a 12 MiB arena,
    # leaving only ~2 MiB for the second copy. So **any package between roughly
    # 2 MiB and the 10 MiB ceiling** yields a null `body_ptr`, and
    # `str_from_buf` (`lib/str.cyr:609`) is `alloc` + `memcpy` — it would copy
    # FROM address 0. Fixed upstream in **sandhi 1.9.10**; the guard stays,
    # because a transport's internal invariant must not be what stands between
    # this and a segfault.
    if (body_len > 0 && sandhi_http_body(resp) == 0) {
        agnosai_arena_pool_release(_AGNOSAI_REMOTE_POOL, arena);
        return _agnosai_remote_err(str_from("download failed: response body could not be buffered"));
    }

    # ⚠ No `str_clone` here — `str_from_buf` ALREADY allocates on the global
    # bump and memcpies (`lib/str.cyr:609-614`). The clone that used to follow
    # duplicated the whole package: ~2N bumped for an N-byte download, with the
    # first N+16 orphaned immediately on a no-free allocator.
    var data = str_from_buf(sandhi_http_body(resp), body_len);
    agnosai_arena_pool_release(_AGNOSAI_REMOTE_POOL, arena);

    _agnosai_remote_log("remote tool package downloaded", 30, url, body_len);

    var r = alloc(AGN_REMOTE_REG_SIZE);
    store64(r + AGN_RR_OK, 1);
    store64(r + AGN_RR_SIZE_BYTES, body_len);
    store64(r + AGN_RR_CONTENT_TYPE, ctype);
    store64(r + AGN_RR_DATA, data);
    store64(r + AGN_RR_ERROR, 0);
    return r;
}

# Fetch a tool package over the real, guard-revalidating transport.
fn agnosai_fetch_package(url: Str): i64 {
    return agnosai_fetch_package_via(url, &agnosai_guarded_fetch);
}
