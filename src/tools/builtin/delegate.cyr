# =========================================================================
# tools/builtin/delegate — hand a task to an agnosai crew, as a model-callable
# tool.
#
# **No rust-old origin.** `rust-old/` has no equivalent: its tool
# registry is echo, json_transform, load_testing and security_audit, and its
# crews are driven by `POST /api/v1/crews` from a human client. This is the
# piece that lets the *model* drive delegation instead — the Claude Code shape,
# where one tool takes the subagent as a parameter rather than the surface
# growing one tool per agent.
#
# ## It is library surface, not binary surface
#
# `agnosai_register_delegate_builtin` exists but `src/main.cyr` does NOT call
# it, so the default binary's `tools/list` stays byte-identical to the oracle's
# four and the wire is undisturbed. That mirrors `synapse`, `delta` and
# `mneme`, which both trees carry and neither binary registers. A deployment
# that wants model-driven delegation — thoth, in the case this was built for —
# opts in with one call.
#
# ## Asynchronous, because a crew is not a function call
#
# `execute` returns a `crew_id` the moment the crew is registered, not when it
# finishes. A crew can run for minutes; a tool call that blocked for that long
# would hold the model's turn open and, through it, the caller's. The id is
# immediately usable — the crew is in the orchestrator map as `pending` before
# this returns — so the caller polls `GET /api/v1/crews/{id}` and can
# `cancel_crew` mid-run. Both are existing surface; this adds no polling
# API of its own.
# =========================================================================

# The delegate tool's parameter schema.
#
# `agent` and `task` only. A crew request carries more (process, expected
# output, priority), and every one of those is a thing the *model* would have to
# invent — so they are deliberately not exposed. The tool is "give this job to
# that agent", and the orchestrator's defaults decide the rest.
fn _agnosai_delegate_schema(a, ctx): i64 {
    var s = agnosai_tool_schema_new_a(a, str_from_a(a, "delegate"),
      str_from_a(a, "Delegate a task to an agnosai agent. Returns a crew_id immediately; \
    poll GET /api/v1/crews/{crew_id} for status and results."));
    agnosai_tool_schema_param_a(a, s, str_from_a(a, "agent"),
      str_from_a(a, "The name of the agent definition to delegate to"), str_from_a(a, "string"), 1);
    agnosai_tool_schema_param_a(a, s, str_from_a(a, "task"),
      str_from_a(a, "What the agent should do, in plain language"), str_from_a(a, "string"), 1);
    return s;
}

# Submit a one-task crew for `agent` and answer with its id.
#
# The crew for one delegation.
#
# ⚠ **`task` is cloned, and that is the whole point of this being a function.** The crew runs after
# the call returns, and an input lasts only as long as its call: through the tool loop it lives in
# the conversation's arena, which goes back with the task. A task keeps its description by pointer,
# so the delegated agent would read whatever the next conversation wrote there.
fn _agnosai_delegate_spec(def, agent_name: Str, task: Str): i64 {
    return _agnosai_delegate_spec_in(0, def, agent_name, task);
}

# `_agnosai_delegate_spec`, in crew arena `ca` (2.5.1, ADR 037), or on the global heap for 0.
fn _agnosai_delegate_spec_in(ca, def, agent_name: Str, task: Str): i64 {
    var a = ca;
    if (a == 0) { a = default_alloc(); }
    var agents = vec_new_a(a);
    vec_push_a(a, agents, def);
    var tasks = vec_new_a(a);
    vec_push_a(a, tasks, agnosai_task_new_a(a, str_clone_a(a, task)));

    var name = str_cat_a(a, str_from_a(a, "delegate:"), agent_name);
    var spec = 0;
    if (ca != 0) { spec = agnosai_crew_new_in(ca, name); }
    else { spec = agnosai_crew_new(name); }
    agnosai_crew_with_agents(spec, agents);
    agnosai_crew_with_tasks(spec, tasks);
    return spec;
}

# The crew for one delegation, bounded by who delegates (2.4.3, ADR 035): `caller` is the agent
# delegating and `budget` its task's tracker, either 0. Returns the spec, or 0 when the task has no
# budget left to hand on. `out_held` gets the vec of tools withheld, in `a`, or 0.
#
# **Authority only narrows.** The agent delegated to holds at most the caller's tools, and its crew
# at most what the caller's task has left. Nothing here widens either: a need beyond them is the
# crew author's to grant, and the model is told what was withheld. ⚠ **The budget is what was left
# when it delegated**, a ceiling and not a share: the crew runs past this call and its task, and a
# tracker under the task's would outlive it, so what the crew spends is not recorded above it.
fn _agnosai_delegate_bounded_spec_a(a, def, agent_name: Str, task: Str, caller, budget, out_held): i64 {
    return _agnosai_delegate_bounded_spec_in_a(a, 0, def, agent_name, task, caller, budget, out_held);
}

# `_agnosai_delegate_bounded_spec_a`, the crew in crew arena `ca`, or on the global heap for 0.
fn _agnosai_delegate_bounded_spec_in_a(a, ca, def, agent_name: Str, task: Str, caller, budget, out_held): i64 {
    store64(out_held, 0);
    var tokens = AGNOSAI_NO_LIMIT;
    var cost = AGNOSAI_NO_LIMIT;
    if (budget != 0) {
        tokens = agnosai_budget_tracker_tokens_left(budget);
        cost = agnosai_budget_tracker_cost_left_micro_usd(budget);
        if (tokens == 0 || cost == 0) { return 0; }
    }
    var worker = def;
    if (caller != 0) {
        var held = agnosai_tools_withheld_a(a, def, caller);
        store64(out_held, held);
        if (vec_len(held) > 0) { agnosai_log_withheld(caller, def, held); }
        var wa = ca;
        if (wa == 0) { wa = default_alloc(); }
        worker = agnosai_worker_within_a(wa, def, caller);
    }
    var spec = _agnosai_delegate_spec_in(ca, worker, agent_name, task);
    if (budget != 0) { agnosai_crew_with_budget(spec, tokens, cost); }
    return spec;
}

# `ctx` is the app state, which is what carries both the definitions map (to
# resolve `agent`) and the orchestrator (to submit against).
fn _agnosai_delegate_execute(ctx, input): i64 {
    # Only the answer goes here. The crew outlives this call, so what it holds stays off this
    # allocator, in the crew's own arena (ADR 037).
    var a = agnosai_tool_input_alloc(input);
    var agent_v = agnosai_tool_input_get(input, str_from_a(a, "agent"));
    if (agent_v == 0 || bayan_json_v_is_str(agent_v) == 0) {
        return agnosai_tool_output_err_a(a, str_from_a(a, "missing required parameter: agent"));
    }
    var task_v = agnosai_tool_input_get(input, str_from_a(a, "task"));
    if (task_v == 0 || bayan_json_v_is_str(task_v) == 0) {
        return agnosai_tool_output_err_a(a, str_from_a(a, "missing required parameter: task"));
    }
    var agent_name = bayan_json_v_str(agent_v);

    # **An unknown agent is an error, not an empty crew.** Submitting one would
    # register a crew that can only fail, and the model would have to poll to
    # discover a mistake it could have been told about synchronously.
    var def = agnosai_app_state_definition_get(ctx, agent_name);
    if (def == 0) {
        return agnosai_tool_output_err_a(a, str_cat_a(a, str_from_a(a, "no such agent definition: "),
            agent_name));
    }

    # ⚠ **The crew lives in an arena of its orchestrator's, which gives it back when its registry
    # lets it go (2.5.1, ADR 037).** Through 2.5.0 it, and the copy of the agent it runs, were on the
    # global heap for good.
    var orch = agnosai_app_state_orchestrator(ctx);
    var ca = agnosai_orchestrator_crew_arena(orch);
    var held = 0;
    var spec = _agnosai_delegate_bounded_spec_in_a(a, ca, def, agent_name, bayan_json_v_str(task_v),
      agnosai_tool_input_agent(input), agnosai_tool_input_budget(input), &held);
    if (spec == 0) {
        agnosai_crew_arena_give_back(ca);
        return agnosai_tool_output_err_a(a, str_from_a(a, "the delegating task has no budget left to hand on"));
    }

    # The crew stays in the trace of the call that started it. It runs past this call's return,
    # which a span may do: only the id is handed on. 0 with telemetry off (ADR 029).
    var sc = agnosai_tool_input_span_ctx(input);
    if (sc != 0) {
        agnosai_crew_with_trace_parent(spec, agnosai_otlp_span_context_format_a(ca, sc));
        agnosai_crew_with_delegated(spec, 1);
    }

    # Nothing here reads the crew after it starts, so the hold goes as soon as its id is copied.
    var hold = agnosai_orchestrator_own_crew(orch, spec);
    var crew_id = agnosai_orchestrator_submit_crew(orch, spec);
    if (crew_id == 0) {
        agnosai_orchestrator_let_go(orch, hold);
        return agnosai_tool_output_err_a(a, str_from_a(a, "could not start the delegated crew"));
    }
    var id = str_clone_a(a, crew_id);
    agnosai_orchestrator_let_go(orch, hold);

    var o = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, o, str_from_a(a, "crew_id"), bayan_json_v_str_new_a(a, id));
    # `pending`, not `running` — the crew is registered and the thread is
    # started, but nothing here waits to see it picked up, so claiming `running`
    # would be a guess. It is the same wire spelling the crew map holds.
    bayan_json_v_obj_set_a(a, o, str_from_a(a, "status"), bayan_json_v_str_new_a(a, str_from_a(a, "pending")));
    if (held != 0 && vec_len(held) > 0) {
        var arr = bayan_json_v_arr_new_a(a);
        for (var i = 0; i < vec_len(held); i = i + 1) {
            bayan_json_v_arr_push_a(a, arr, bayan_json_v_str_new_a(a, vec_get(held, i)));
        }
        bayan_json_v_obj_set_a(a, o, str_from_a(a, "withheld_tools"), arr);
    }
    return agnosai_tool_output_ok_a(a, o);
}

# The delegate tool, bound to an app state.
fn agnosai_delegate_tool(state): i64 {
    return agnosai_tool_new(str_from("delegate"),
      str_from("Delegate a task to an agnosai agent. Returns a crew_id immediately; \
    poll GET /api/v1/crews/{crew_id} for status and results."),
      &_agnosai_delegate_schema, &_agnosai_delegate_execute, state);
}

# Opt in to model-driven delegation.
#
# **Deliberately not called by `src/main.cyr`** — see the module header. Calling
# it adds a fifth entry to `tools/list`, which is a wire change against the
# oracle's four.
fn agnosai_register_delegate_builtin(registry, state): i64 {
    agnosai_tool_registry_register(registry, agnosai_delegate_tool(state));
    return 0;
}
