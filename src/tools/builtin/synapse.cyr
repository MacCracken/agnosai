# =========================================================================
# tools/builtin/synapse — the three Synapse LLM Controller tools.
#
# Origin: rust-old/src/tools/builtin/synapse.rs
#
# Synapse exposes an OpenAI-compatible API for local and remote model
# inference; the oracle's default base URL is `http://localhost:8420`. The HTTP
# shape lives in `src/tools/agnos.cyr` — see that module's header for why the
# SSRF guard does not run here and why the transport is a function pointer.
#
# Each tool is a constructor taking a client, rather than the oracle's
# `new()` / `with_base_url()` pair. `with_base_url` is the only one of those
# that carries information: `new()` is `with_base_url(DEFAULT_BASE_URL)`, and
# `Default` is `new()`. `agnosai_synapse_*_tool(client)` plus
# `agnosai_synapse_client()` covers all three without the indirection.
# =========================================================================

# A client pointed at the default Synapse base URL.
fn agnosai_synapse_client(): i64 {
    return agnosai_agnos_client(str_from(AGNOSAI_SYNAPSE_BASE_URL), str_from("synapse"));
}

# ---------------------------------------------------------------------------
# synapse_infer
# ---------------------------------------------------------------------------

# The synapse_infer parameter schema.
fn _agnosai_synapse_infer_schema(a, ctx): i64 {
    var s = agnosai_tool_schema_new_a(a, str_from_a(a, "synapse_infer"),
      str_from_a(a, "Run inference through the Synapse LLM controller (OpenAI-compatible chat completions)"));
    agnosai_tool_schema_param_a(a, s, str_from_a(a, "model"), str_from_a(a, "Model identifier"),
      str_from_a(a, "string"), 1);
    agnosai_tool_schema_param_a(a, s, str_from_a(a, "prompt"), str_from_a(a, "User prompt text"),
      str_from_a(a, "string"), 1);
    agnosai_tool_schema_param_a(a, s, str_from_a(a, "max_tokens"), str_from_a(a, "Maximum tokens to generate"),
      str_from_a(a, "number"), 0);
    agnosai_tool_schema_param_a(a, s, str_from_a(a, "temperature"),
      str_from_a(a, "Sampling temperature (0.0-2.0)"), str_from_a(a, "number"), 0);
    return s;
}

# Pull the completion text out of an OpenAI-compatible response.
#
# The oracle's chain is `data["choices"][0]["message"]["content"].as_str()` with
# `.unwrap_or("")` at the end, so **every** step failing yields an empty string
# rather than an error: a missing `choices`, an empty array, a missing `message`,
# a `content` that is not a string. A response that is not an object at all
# takes the same path. That tolerance is deliberate on the oracle's part — the
# raw response ships alongside — and is reproduced exactly.
fn agnosai_synapse_completion_text_a(a, data): i64 {
    if (bayan_json_v_is_obj(data) == 0) { return str_from_a(a, ""); }
    var choices = bayan_json_v_obj_get_by_cstr(data, "choices");
    if (choices == 0 || bayan_json_v_is_arr(choices) == 0) { return str_from_a(a, ""); }
    if (bayan_json_v_arr_len(choices) == 0) { return str_from_a(a, ""); }
    var first = bayan_json_v_arr_get(choices, 0);
    if (first == 0 || bayan_json_v_is_obj(first) == 0) { return str_from_a(a, ""); }
    var message = bayan_json_v_obj_get_by_cstr(first, "message");
    if (message == 0 || bayan_json_v_is_obj(message) == 0) { return str_from_a(a, ""); }
    var content = bayan_json_v_obj_get_by_cstr(message, "content");
    if (content == 0 || bayan_json_v_is_str(content) == 0) { return str_from_a(a, ""); }
    return bayan_json_v_str(content);
}

# Global-allocator form of `agnosai_synapse_completion_text_a`.
fn agnosai_synapse_completion_text(data): i64 {
    return agnosai_synapse_completion_text_a(default_alloc(), data);
}

# The oracle's `json!({ "completion": text, "raw": data })`, in allocator `a`.
fn _agnosai_synapse_shape_infer_a(a, data): i64 {
    var out = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, out, str_from_a(a, "completion"),
      bayan_json_v_str_new_a(a, agnosai_synapse_completion_text_a(a, data)));
    bayan_json_v_obj_set_a(a, out, str_from_a(a, "raw"), data);
    return out;
}

# Build the chat-completions request body.
#
# `max_tokens` and `temperature` are inserted only when present, matching the
# oracle's `if let Some(..)` guards — sending `"max_tokens": null` to an
# OpenAI-compatible endpoint is not the same request as omitting the key.
fn agnosai_synapse_infer_body_a(a, model: Str, prompt: Str, max_tokens, temperature, has_temp): i64 {
    var body = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, body, str_from_a(a, "model"), bayan_json_v_str_new_a(a, model));

    var msg = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, msg, str_from_a(a, "role"), bayan_json_v_str_new_a(a, str_from_a(a, "user")));
    bayan_json_v_obj_set_a(a, msg, str_from_a(a, "content"), bayan_json_v_str_new_a(a, prompt));
    var messages = bayan_json_v_arr_new_a(a);
    bayan_json_v_arr_push_a(a, messages, msg);
    bayan_json_v_obj_set_a(a, body, str_from_a(a, "messages"), messages);

    if (max_tokens != AGNOSAI_NO_LIMIT) {
        bayan_json_v_obj_set_a(a, body, str_from_a(a, "max_tokens"), bayan_json_v_int_new_a(a, max_tokens));
    }
    if (has_temp == 1) {
        bayan_json_v_obj_set_a(a, body, str_from_a(a, "temperature"), bayan_json_v_float_new_a(a, temperature));
    }
    return body;
}

# Global-allocator form of `agnosai_synapse_infer_body_a`.
fn agnosai_synapse_infer_body(model: Str, prompt: Str, max_tokens, temperature, has_temp): i64 {
    return agnosai_synapse_infer_body_a(default_alloc(), model, prompt, max_tokens, temperature, has_temp);
}

# Run inference through Synapse's chat-completions endpoint.
fn _agnosai_synapse_infer_execute(ctx, input): i64 {
    var a = agnosai_tool_input_alloc(input);
    var model = agnosai_tool_input_get_str(input, str_from_a(a, "model"));
    if (model == 0) {
        return agnosai_tool_output_err_a(a, str_from_a(a, "missing required parameter: model"));
    }
    var prompt = agnosai_tool_input_get_str(input, str_from_a(a, "prompt"));
    if (prompt == 0) {
        return agnosai_tool_output_err_a(a, str_from_a(a, "missing required parameter: prompt"));
    }

    var has_temp = 0;
    var temperature = agnosai_tool_input_get_f64(input, str_from_a(a, "temperature"), &has_temp);
    var body = agnosai_synapse_infer_body_a(a, model, prompt,
      agnosai_tool_input_get_int(input, str_from_a(a, "max_tokens")), temperature, has_temp);

    return agnosai_agnos_call_a(a, ctx, "POST", str_from_a(a, "/v1/chat/completions"), body,
      &_agnosai_synapse_shape_infer_a);
}

# The synapse_infer tool, bound to a client.
fn agnosai_synapse_infer_tool(client): i64 {
    return agnosai_tool_new(str_from("synapse_infer"),
      str_from("Run inference through the Synapse LLM controller (OpenAI-compatible chat completions)"),
      &_agnosai_synapse_infer_schema, &_agnosai_synapse_infer_execute, client);
}

# ---------------------------------------------------------------------------
# synapse_list_models
# ---------------------------------------------------------------------------

# The synapse_list_models parameter schema — no parameters.
fn _agnosai_synapse_list_models_schema(a, ctx): i64 {
    return agnosai_tool_schema_new_a(a, str_from_a(a, "synapse_list_models"),
      str_from_a(a, "List models available through the Synapse LLM controller"));
}

# List the models Synapse can serve.
fn _agnosai_synapse_list_models_execute(ctx, input): i64 {
    var a = agnosai_tool_input_alloc(input);
    return agnosai_agnos_call_a(a, ctx, "GET", str_from_a(a, "/v1/models"), 0, 0);
}

# The synapse_list_models tool, bound to a client.
fn agnosai_synapse_list_models_tool(client): i64 {
    return agnosai_tool_new(str_from("synapse_list_models"),
      str_from("List models available through the Synapse LLM controller"),
      &_agnosai_synapse_list_models_schema, &_agnosai_synapse_list_models_execute, client);
}

# ---------------------------------------------------------------------------
# synapse_status
# ---------------------------------------------------------------------------

# The synapse_status parameter schema — no parameters.
fn _agnosai_synapse_status_schema(a, ctx): i64 {
    return agnosai_tool_schema_new_a(a, str_from_a(a, "synapse_status"),
      str_from_a(a, "Get Synapse system status: loaded models, backends, and hardware info"));
}

# Report Synapse's loaded models, backends and hardware.
fn _agnosai_synapse_status_execute(ctx, input): i64 {
    var a = agnosai_tool_input_alloc(input);
    return agnosai_agnos_call_a(a, ctx, "GET", str_from_a(a, "/system/status"), 0, 0);
}

# The synapse_status tool, bound to a client.
fn agnosai_synapse_status_tool(client): i64 {
    return agnosai_tool_new(str_from("synapse_status"),
      str_from("Get Synapse system status: loaded models, backends, and hardware info"),
      &_agnosai_synapse_status_schema, &_agnosai_synapse_status_execute, client);
}

# Register all three Synapse tools against a live client. Returns the registry.
fn agnosai_register_synapse_builtins(registry): i64 {
    var client = agnosai_synapse_client();
    agnosai_tool_registry_register(registry, agnosai_synapse_infer_tool(client));
    agnosai_tool_registry_register(registry, agnosai_synapse_list_models_tool(client));
    agnosai_tool_registry_register(registry, agnosai_synapse_status_tool(client));
    return registry;
}
