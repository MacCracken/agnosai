# =========================================================================
# tools/builtin/load_testing — HTTP load generation and latency measurement.
#
# Origin: rust-old/src/tools/builtin/load_testing.rs
#
# Port notes (divergences from the Rust shape, all deliberate):
#   * **Concurrency is real.** The oracle spawns one tokio task per simulated
#     user; this spawns one OS thread per user via `thread_create`. A load
#     generator that ran sequentially would not be one, so this is not a place
#     to take the easy shape.
#   * **Every worker owns THREE arenas and allocates only through them.** This
#     is port plan blocker #3's prescribed pattern, applied here for the first
#     time. The global bump allocator is not thread-safe (and never frees), so
#     a worker calling bare `alloc` / `vec_push` / `sandhi_http_get` would race
#     every other worker. Each worker uses `alloc_via` / `vec_new_a` /
#     `vec_push_a` / `sandhi_http_get_a` against its own arenas instead.
#
#     The split matters: a **persistent** arena holds the latency vector and
#     status pairs for the whole run, while a **scratch** arena holds one
#     request's response and is `reset_via`'d after every request. A single
#     arena would accumulate every response body for the worker's lifetime —
#     at 25,000 requests per worker that is unbounded growth the oracle does
#     not have, because Rust drops each response as it goes.
#
#     The third holds the worker's **connection**: see `agnosai_lt_http_executor`.
#
#     Nothing that outlives the run is allocated from a worker arena;
#     `agnosai_lt_aggregate` copies every latency and status count out.
#   * **The request executor is a function pointer.** That is what makes the
#     fan-out testable: the tests inject a synthetic executor and exercise the
#     threading and aggregation with no network at all. `is_safe_url` correctly
#     rejects loopback, so the real executor cannot be pointed at a local
#     server, and driving a public host from a test suite is not acceptable.
#   * **The percentile index is the oracle's, not the textbook one.** The
#     oracle does `all_latencies[(len * p / 100).min(len - 1)]` over a sorted
#     vector. That is NOT the nearest-rank convention `src/order.cyr`'s
#     `agnosai_percentile_i64` implements — for n=100 the oracle's p50 is
#     index 50 where nearest-rank gives 49. The reported numbers are the
#     oracle's, so this module computes the index itself.
#   * `Duration` is i64 nanoseconds; latency output is f64 milliseconds,
#     rounded exactly as the oracle rounds.
#
# `src/order.cyr` is what makes the sort affordable: the oracle sorts the whole
# latency vector, and at the 100k cap an O(n^2) sort measured 52.6 s.
# =========================================================================

include "src/done_word.cyr"

# Maximum total requests across all users, preventing unbounded memory growth.
# Mirrors the oracle's MAX_TOTAL_REQUESTS.
var AGNOSAI_LT_MAX_TOTAL_REQUESTS = 100000;

# Ceiling on simulated users, and the duration clamp, both the oracle's.
var AGNOSAI_LT_MAX_USERS = 500;
var AGNOSAI_LT_MIN_DURATION_SECS = 1;
var AGNOSAI_LT_MAX_DURATION_SECS = 300;

# Per-worker scratch arena, reset after every request. One response body plus
# sandhi's per-request bookkeeping fits comfortably in 1 MiB; sandhi's own
# default request cap is 64 KiB.
var AGNOSAI_LT_SCRATCH_BYTES = 1048576;

# Every request gets a 30 s budget. ⚠ **As a total AND as a read and write limit.** sandhi checks
# `total_ms` between reads, so on its own it cannot end a read that is already blocked, and through
# 2.3.5 a target that accepted and never answered held the worker, and the run behind it, for good.
var AGNOSAI_LT_REQUEST_TIMEOUT_MS = 30000;

# Bodies are read and discarded, so this only has to be large enough that an
# ordinary page is not misreported: at sandhi's 256 KiB default, every request
# against a larger page counted as a transport failure. The scratch arena is
# growable and reset after every request, so a large body is transient.
var AGNOSAI_LT_MAX_RESPONSE_BYTES = 16777216;

# Pools for the worker's three arenas. See `src/arena_pool.cyr`.
#
# ⚠ **Was `arena_allocator(...)` twice PER USER**, in the spawn loop — the only
# one of the five sites whose cost scaled with a caller-supplied number. Neither
# was ever returned.
#
# **A pool each, because the arenas have different roles and sizes.** The
# persistent one holds every latency for the run and is sized
# `max_requests * 40 + slack`, which VARIES with the user count
# (`max_requests = 100000 / users`): ~4 MiB at one user, ~73 KiB at 500. A pool
# cannot pick one number for that — but it does not need to, because pooled
# arenas are **growable** and converge on whatever each run actually needs. The
# initial size below is the floor, not the ceiling.
#
# **16 slots each.** A worker on a real target holds all three for the whole run, so a 16-user run is
# served entirely from the pools and anything larger falls back — which is
# correct behaviour, not degradation. ⚠ Sizing them equally matters: pools
# drawn in a fixed order by every worker cannot deadlock, because acquire never
# blocks. That is the property that makes two-resource-per-holder safe here.
var _AGNOSAI_LT_POOL_SLOTS = 16;
var _AGNOSAI_LT_PERSISTENT_POOL = agnosai_arena_pool_new(_AGNOSAI_LT_POOL_SLOTS,
  AGNOSAI_LT_SCRATCH_BYTES);
var _AGNOSAI_LT_SCRATCH_POOL = agnosai_arena_pool_new(_AGNOSAI_LT_POOL_SLOTS,
  AGNOSAI_LT_SCRATCH_BYTES);
var _AGNOSAI_LT_CONN_POOL = agnosai_arena_pool_new(_AGNOSAI_LT_POOL_SLOTS,
  AGNOSAI_LT_SCRATCH_BYTES);

# How long a worker's idle connection stays usable, in milliseconds: for good, in effect (34
# years). ⚠ **Not a tuning knob.** A connection this calls stale is closed inside sandhi and a new
# one opens in the arena the worker had picked for a reused one, which `agnosai_lt_http_executor`
# is not prepared for. A worker has nothing to do between one request and the next, so nothing
# should be stale, and a paused process must not change that.
var _AGNOSAI_LT_IDLE_FOR_GOOD_MS = 1 << 40;

# Slack on the persistent arena, over and above the latency vector.
var AGNOSAI_LT_PERSISTENT_SLACK = 65536;

# Bytes of persistent arena per budgeted request. A vec grows by doubling and
# an arena never reclaims the old buffer, so the total consumed across all
# grows for n elements is about 4x the final size: 8 bytes a slot, so 40 gives
# the vector its ~32 plus room for the status pairs.
var AGNOSAI_LT_PERSISTENT_PER_REQUEST = 40;

# Worker context heap layout. One per simulated user. `CONN` is the arena its connection lives in,
# `POOL` is sandhi's pool holding that connection between requests, both taken on the first real
# request, and `DONE` turns 1 as its thread's last act (`src/done_word.cyr`).
enum AgnosaiLtWorkerOff {
    AGN_LT_URL = 0;
    AGN_LT_DEADLINE_NS = 8;
    AGN_LT_MAX_REQUESTS = 16;
    AGN_LT_EXECUTOR_FP = 24;
    AGN_LT_ARENA = 32;
    AGN_LT_SCRATCH = 40;
    AGN_LT_LATENCIES = 48;
    AGN_LT_STATUS_COUNTS = 56;
    AGN_LT_ERRORS = 64;
    AGN_LT_WORKER_ID = 72;
    AGN_LT_CONN = 80;
    AGN_LT_POOL = 88;
    AGN_LT_DONE = 96;
    AGN_LT_SIZE = 104;
}

# LoadTestResult heap layout — 120 bytes. Latencies are nanoseconds; the
# rendering step converts to the oracle's rounded milliseconds.
enum AgnosaiLtResultOff {
    AGN_LTR_TARGET_URL = 0;
    AGN_LTR_CONCURRENT_USERS = 8;
    AGN_LTR_DURATION_SECS = 16;
    AGN_LTR_TOTAL_REQUESTS = 24;
    AGN_LTR_SUCCESSFUL = 32;
    AGN_LTR_FAILED = 40;
    AGN_LTR_AVG_NS = 48;
    AGN_LTR_P50_NS = 56;
    AGN_LTR_P95_NS = 64;
    AGN_LTR_P99_NS = 72;
    AGN_LTR_MIN_NS = 80;
    AGN_LTR_MAX_NS = 88;
    AGN_LTR_THROUGHPUT_MILLI = 96;
    AGN_LTR_ERROR_RATE_PPM = 104;
    AGN_LTR_STATUS_CODES = 112;
    AGN_LTR_SIZE = 120;
}

# Give a worker's arenas back. Nothing a run reports points into one: `agnosai_lt_aggregate` copies.
fn agnosai_lt_worker_release(w): i64 {
    agnosai_arena_pool_release(_AGNOSAI_LT_PERSISTENT_POOL, load64(w + AGN_LT_ARENA));
    agnosai_arena_pool_release(_AGNOSAI_LT_SCRATCH_POOL, load64(w + AGN_LT_SCRATCH));
    agnosai_arena_pool_release(_AGNOSAI_LT_CONN_POOL, load64(w + AGN_LT_CONN));
    return 0;
}

# Create a worker context. `executor_fp` is `fn(ctx): i64` returning the HTTP
# status code, or 0 to record a transport error.
fn agnosai_lt_worker_new_a(a, url: Str, deadline_ns, max_requests, executor_fp, worker_id): i64 {
    var w = alloc_via(a, AGN_LT_SIZE);

    # Both arenas come from pools now, so nothing here computes a size: a pooled
    # arena is GROWABLE and converges on what the run actually needs. The old
    # `max_requests * AGNOSAI_LT_PERSISTENT_PER_REQUEST + AGNOSAI_LT_PERSISTENT_SLACK`
    # is what that convergence lands near, and the constants are kept for that
    # reason — but computing it here would be dead arithmetic.
    #
    # (The prior note about `arena_allocator` vs `arena_new` still holds for
    # anyone reaching for the raw form: the `_a` family takes an Allocator
    # vtable, and `arena_new` returns the bare struct — passing that to
    # `alloc_via` dereferences it as a vtable and segfaults.)
    var arena = agnosai_arena_pool_acquire(_AGNOSAI_LT_PERSISTENT_POOL);
    var scratch = agnosai_arena_pool_acquire(_AGNOSAI_LT_SCRATCH_POOL);
    if (w == 0 || arena == 0 || scratch == 0) {
        agnosai_arena_pool_release(_AGNOSAI_LT_PERSISTENT_POOL, arena);
        agnosai_arena_pool_release(_AGNOSAI_LT_SCRATCH_POOL, scratch);
        return 0;
    }

    # A copy, as a C string is what a request takes: `str_cstr` per request is a global
    # allocation per request, up to 100k a run.
    store64(w + AGN_LT_URL, str_clone_a(arena, url));
    store64(w + AGN_LT_DEADLINE_NS, deadline_ns);
    store64(w + AGN_LT_MAX_REQUESTS, max_requests);
    store64(w + AGN_LT_EXECUTOR_FP, executor_fp);
    store64(w + AGN_LT_ARENA, arena);
    store64(w + AGN_LT_SCRATCH, scratch);
    store64(w + AGN_LT_CONN, 0);
    store64(w + AGN_LT_POOL, 0);
    store64(w + AGN_LT_DONE, 0);

    var latencies = vec_new_a(arena);
    var statuses = vec_new_a(arena);
    if (latencies == 0 || statuses == 0) {
        agnosai_lt_worker_release(w);
        return 0;
    }
    store64(w + AGN_LT_LATENCIES, latencies);
    store64(w + AGN_LT_STATUS_COUNTS, statuses);

    store64(w + AGN_LT_ERRORS, 0);
    store64(w + AGN_LT_WORKER_ID, worker_id);
    return w;
}

# Global-allocator form of `agnosai_lt_worker_new_a`.
fn agnosai_lt_worker_new(url: Str, deadline_ns, max_requests, executor_fp, worker_id): i64 {
    return agnosai_lt_worker_new_a(default_alloc(), url, deadline_ns, max_requests, executor_fp, worker_id);
}

# The worker's per-request scratch arena, reset after every request.
fn agnosai_lt_worker_scratch(w): i64 {
    return load64(w + AGN_LT_SCRATCH);
}

# The worker's arena — every allocation it makes comes from here.
fn agnosai_lt_worker_arena(w): i64 {
    return load64(w + AGN_LT_ARENA);
}

# Vec of the worker's recorded latencies, in nanoseconds.
fn agnosai_lt_worker_latencies(w): i64 {
    return load64(w + AGN_LT_LATENCIES);
}

# Vec of [status_code, count] pairs seen by this worker.
#
# A vec of pairs rather than a map: `lib/hashmap.cyr`'s u64 map exposes no key
# enumeration, and an HTTP load test sees a handful of distinct status codes,
# where a linear scan beats hashing anyway.
fn agnosai_lt_worker_status_counts(w): i64 {
    return load64(w + AGN_LT_STATUS_COUNTS);
}

# Increment `code`'s count in a [code, count] pair vec, appending if new.
# Allocates through `arena` so a worker never touches the global bump.
fn _agnosai_lt_status_bump(arena, pairs, code, by): i64 {
    for (var i = 0; i < vec_len(pairs); i = i + 1) {
        var pair = vec_get(pairs, i);
        if (load64(pair) == code) {
            store64(pair + 8, load64(pair + 8) + by);
            return 0;
        }
    }
    var fresh = alloc_via(arena, 16);
    store64(fresh, code);
    store64(fresh + 8, by);
    vec_push_a(arena, pairs, fresh);
    return 0;
}

# The count recorded for `code`, or 0.
fn agnosai_lt_status_count(pairs, code): i64 {
    for (var i = 0; i < vec_len(pairs); i = i + 1) {
        var pair = vec_get(pairs, i);
        if (load64(pair) == code) { return load64(pair + 8); }
    }
    return 0;
}

# Number of transport errors this worker saw.
fn agnosai_lt_worker_errors(w): i64 {
    return load64(w + AGN_LT_ERRORS);
}

# This worker's index, 0-based.
fn agnosai_lt_worker_id(w): i64 {
    return load64(w + AGN_LT_WORKER_ID);
}

# One GET against the worker's target, its response in `arena`, on the worker's connection when it
# has one. The response, or 0.
fn _agnosai_lt_get(w, arena): i64 {
    # Headers and options through the same arena: `sandhi_headers_new()` on the global bump was one
    # permanent allocation per request, up to 100k a run.
    var headers = sandhi_headers_new_a(arena);
    var opts = sandhi_http_options_new_a(arena);
    if (opts == 0) { return 0; }
    sandhi_http_options_total_ms(opts, AGNOSAI_LT_REQUEST_TIMEOUT_MS);
    sandhi_http_options_read_ms(opts, AGNOSAI_LT_REQUEST_TIMEOUT_MS);
    sandhi_http_options_write_ms(opts, AGNOSAI_LT_REQUEST_TIMEOUT_MS);
    sandhi_http_options_max_response_bytes(opts, AGNOSAI_LT_MAX_RESPONSE_BYTES);
    sandhi_http_options_pool(opts, load64(w + AGN_LT_POOL));
    return sandhi_http_get_opts_a(arena, str_data(load64(w + AGN_LT_URL)), headers, opts);
}

# A response's status code, or 0 for a transport error.
fn _agnosai_lt_status(r): i64 {
    if (r == 0) { return 0; }
    if (sandhi_http_err_kind(r) != SANDHI_OK) { return 0; }
    return sandhi_http_status(r);
}

# A worker's connection arena and pool, on its first real request. Here and not in the constructor,
# as a worker on a synthetic executor has no use for them, and past the pool's 16 slots each arena
# is a new mapping. Returns the pool, or 0.
fn _agnosai_lt_worker_connect(w): i64 {
    if (load64(w + AGN_LT_CONN) == 0) {
        var conn = agnosai_arena_pool_acquire(_AGNOSAI_LT_CONN_POOL);
        if (conn == 0) { return 0; }
        store64(w + AGN_LT_CONN, conn);
    }
    var pool = sandhi_http_pool_new_a(load64(w + AGN_LT_ARENA), 1, _AGNOSAI_LT_IDLE_FOR_GOOD_MS);
    store64(w + AGN_LT_POOL, pool);
    return pool;
}

# The real HTTP executor: one GET against the worker's target URL. Returns the status code, or 0 on
# a transport error.
#
# Each simulated user keeps one connection, so a latency measures the target and not a handshake
# per request, and a TLS target is not spent mostly on those.
#
# ⚠ **Which arena a request runs in is what keeps the connection alive.** sandhi allocates a
# connection from the request's allocator, and the pool only keeps the pointer, so a connection
# opened in the scratch arena would be overwritten by the next request. A request that will open one
# (the pool is empty, so no connection is alive in the `CONN` arena) resets that arena and runs
# there. A request that will reuse one runs in scratch.
#
# That rests on a request finding an idle connection opening no other. sandhi follows no redirect
# here, has no retry at this level, and cannot call the connection stale
# (`_AGNOSAI_LT_IDLE_FOR_GOOD_MS`). `tests/tools_builtin_load_testing.tcyr` holds it to that.
#
# **A reused connection that fails is tried once on a fresh one.** A server may close a keep-alive
# connection without warning, and that says nothing about the target. A timeout is not retried: that
# would double the 30 s, and it is a finding.
#
# ⚠ **A request can fail before it reaches the connection**, as a name that stopped resolving or an
# allocation does, and then the pool still holds it, alive in the `CONN` arena. So the arena is reset
# only with the pool seen empty, and never on the strength of a failure alone.
fn agnosai_lt_http_executor(w): i64 {
    var pool = load64(w + AGN_LT_POOL);
    if (pool == 0) {
        pool = _agnosai_lt_worker_connect(w);
        if (pool == 0) { return 0; }
    }
    if (sandhi_http_pool_idle_count(pool) != 0) {
        var reused = _agnosai_lt_get(w, load64(w + AGN_LT_SCRATCH));
        var status = _agnosai_lt_status(reused);
        if (status != 0) { return status; }
        if (reused != 0 && sandhi_http_err_kind(reused) == SANDHI_ERR_TIMEOUT) { return 0; }
        if (sandhi_http_pool_idle_count(pool) != 0) { return 0; }
    }
    var conn = load64(w + AGN_LT_CONN);
    reset_via(conn);
    return _agnosai_lt_status(_agnosai_lt_get(w, conn));
}

# The worker loop — the body of one simulated user.
#
# Runs until the deadline or the per-user request budget, whichever comes
# first. A latency is recorded for **every** attempt, successful or not, which
# is the oracle's behaviour and the reason `total_requests` counts errors.
fn agnosai_lt_worker_run(w): i64 {
    var arena = load64(w + AGN_LT_ARENA);
    var latencies = load64(w + AGN_LT_LATENCIES);
    var statuses = load64(w + AGN_LT_STATUS_COUNTS);
    var deadline = load64(w + AGN_LT_DEADLINE_NS);
    var budget = load64(w + AGN_LT_MAX_REQUESTS);
    var executor = load64(w + AGN_LT_EXECUTOR_FP);

    while (1 == 1) {
        if (clock_now_ns() >= deadline) { break; }
        if (vec_len(latencies) >= budget) { break; }

        var start = clock_now_ns();
        var status = callptr(executor, w);
        var elapsed = clock_now_ns() - start;
        if (elapsed < 0) { elapsed = 0; }

        if (status == 0) {
            store64(w + AGN_LT_ERRORS, load64(w + AGN_LT_ERRORS) + 1);
        } else {
            _agnosai_lt_status_bump(arena, statuses, status, 1);
        }

        # A bump arena cannot fail here with the sizing above — 40 bytes per
        # request against the ~16 a doubling vec's abandoned buffers actually
        # need — but the check is not optional. `vec_push_a` returns -1 and
        # does NOT push when the arena is exhausted, and the loop's exit
        # condition is `vec_len(latencies) >= budget`. Ignoring the failure
        # would mean spinning until the deadline issuing real HTTP requests
        # whose results are all discarded: maximum load generated, nothing
        # measured. Stopping is the only honest response.
        if (vec_push_a(arena, latencies, elapsed) != 0) { break; }

        # Drop this request's response before starting the next one. Without
        # this the worker's memory grows with every request it makes.
        reset_via(load64(w + AGN_LT_SCRATCH));
    }

    # Its connection goes with the worker. Only when there is one: a close allocates on the global
    # heap, and a run that opened nothing should leave nothing.
    var pool = load64(w + AGN_LT_POOL);
    if (pool != 0 && sandhi_http_pool_idle_count(pool) != 0) { sandhi_http_pool_close(pool); }
    return 0;
}

# Thread entry point. A thread passes exactly one argument, so the worker context pointer is it.
# Nothing after the set may read `w`, as the run may have moved on (`src/done_word.cyr`).
fn _agnosai_lt_thread_main(w): i64 {
    agnosai_lt_worker_run(w);
    agnosai_done_word_set(w + AGN_LT_DONE);
    return 0;
}

# Aggregate finished workers into a result, or 0 when no request completed.
#
# `duration_secs` is the **configured** duration, not the measured elapsed
# time — the oracle computes throughput against the requested window, so a run
# that finishes early still divides by what was asked for.
fn agnosai_lt_aggregate_a(a, workers, url: Str, users, duration_secs): i64 {
    var latencies = vec_new_a(a);
    var statuses = vec_new_a(a);
    var errors = 0;

    for (var i = 0; i < vec_len(workers); i = i + 1) {
        var w = vec_get(workers, i);
        var wl = load64(w + AGN_LT_LATENCIES);
        for (var j = 0; j < vec_len(wl); j = j + 1) {
            vec_push_a(a, latencies, vec_get(wl, j));
        }
        var ws = load64(w + AGN_LT_STATUS_COUNTS);
        for (var k = 0; k < vec_len(ws); k = k + 1) {
            var pair = vec_get(ws, k);
            _agnosai_lt_status_bump(a, statuses, load64(pair), load64(pair + 8));
        }
        errors = errors + load64(w + AGN_LT_ERRORS);
    }

    var total = vec_len(latencies);
    if (total == 0) { return 0; }

    # The oracle sorts the whole vector, then indexes it. src/order.cyr is what
    # makes that affordable at the 100k cap.
    agnosai_sort_i64(latencies);

    var sum = 0;
    for (var s = 0; s < total; s = s + 1) { sum = sum + vec_get(latencies, s); }

    var successful = total - errors;
    if (successful < 0) { successful = 0; }

    var r = alloc_via(a, AGN_LTR_SIZE);
    store64(r + AGN_LTR_TARGET_URL, url);
    store64(r + AGN_LTR_CONCURRENT_USERS, users);
    store64(r + AGN_LTR_DURATION_SECS, duration_secs);
    store64(r + AGN_LTR_TOTAL_REQUESTS, total);
    store64(r + AGN_LTR_SUCCESSFUL, successful);
    store64(r + AGN_LTR_FAILED, errors);
    store64(r + AGN_LTR_AVG_NS, sum / total);
    store64(r + AGN_LTR_P50_NS, vec_get(latencies, _agnosai_lt_pct_index(total, 50)));
    store64(r + AGN_LTR_P95_NS, vec_get(latencies, _agnosai_lt_pct_index(total, 95)));
    store64(r + AGN_LTR_P99_NS, vec_get(latencies, _agnosai_lt_pct_index(total, 99)));
    store64(r + AGN_LTR_MIN_NS, vec_get(latencies, 0));
    store64(r + AGN_LTR_MAX_NS, vec_get(latencies, total - 1));

    # Throughput in thousandths of a request/second, and error rate in parts
    # per million — integer carriers, converted at the wire boundary the same
    # way money is. `duration_secs` is clamped >= 1 by the caller.
    store64(r + AGN_LTR_THROUGHPUT_MILLI, (total * 1000) / duration_secs);
    store64(r + AGN_LTR_ERROR_RATE_PPM, (errors * 1000000) / total);
    store64(r + AGN_LTR_STATUS_CODES, statuses);
    return r;
}

# Global-allocator form of `agnosai_lt_aggregate_a`.
fn agnosai_lt_aggregate(workers, url: Str, users, duration_secs): i64 {
    return agnosai_lt_aggregate_a(default_alloc(), workers, url, users, duration_secs);
}

# The oracle's percentile index: `(len * p / 100).min(len - 1)`.
#
# Deliberately NOT `agnosai_percentile_i64`'s nearest-rank index — for n=100
# this gives 50 where nearest-rank gives 49, and the reported figure is the
# oracle's.
fn _agnosai_lt_pct_index(len, p): i64 {
    var idx = (len * p) / 100;
    if (idx > len - 1) { idx = len - 1; }
    if (idx < 0) { idx = 0; }
    return idx;
}

# Nanoseconds as the oracle's milliseconds: a float rounded to 2 decimals.
fn _agnosai_lt_ms_value_a(a, ns): i64 {
    var ms = f64_div(f64_from(ns), f64_from(1000000));
    var rounded = f64_div(f64_round(f64_mul(ms, f64_from(100))), f64_from(100));
    return bayan_json_v_float_new_a(a, rounded);
}

# Total requests per second as the oracle's float, rounded to 2 decimals.
fn _agnosai_lt_rps_value_a(a, milli): i64 {
    var rps = f64_div(f64_from(milli), f64_from(1000));
    var rounded = f64_div(f64_round(f64_mul(rps, f64_from(100))), f64_from(100));
    return bayan_json_v_float_new_a(a, rounded);
}

# Error rate as the oracle's float, rounded to 4 decimals.
fn _agnosai_lt_rate_value_a(a, ppm): i64 {
    var rate = f64_div(f64_from(ppm), f64_from(1000000));
    var rounded = f64_div(f64_round(f64_mul(rate, f64_from(10000))), f64_from(10000));
    return bayan_json_v_float_new_a(a, rounded);
}

# Total requests recorded, errors included.
fn agnosai_lt_result_total_requests(r): i64 {
    return load64(r + AGN_LTR_TOTAL_REQUESTS);
}

# Requests that did not report a transport error.
fn agnosai_lt_result_successful(r): i64 {
    return load64(r + AGN_LTR_SUCCESSFUL);
}

# Requests that reported a transport error.
fn agnosai_lt_result_failed(r): i64 {
    return load64(r + AGN_LTR_FAILED);
}

# The p50 latency in nanoseconds.
fn agnosai_lt_result_p50_ns(r): i64 {
    return load64(r + AGN_LTR_P50_NS);
}

# The p95 latency in nanoseconds.
fn agnosai_lt_result_p95_ns(r): i64 {
    return load64(r + AGN_LTR_P95_NS);
}

# The p99 latency in nanoseconds.
fn agnosai_lt_result_p99_ns(r): i64 {
    return load64(r + AGN_LTR_P99_NS);
}

# The minimum latency in nanoseconds.
fn agnosai_lt_result_min_ns(r): i64 {
    return load64(r + AGN_LTR_MIN_NS);
}

# The maximum latency in nanoseconds.
fn agnosai_lt_result_max_ns(r): i64 {
    return load64(r + AGN_LTR_MAX_NS);
}

# The mean latency in nanoseconds.
fn agnosai_lt_result_avg_ns(r): i64 {
    return load64(r + AGN_LTR_AVG_NS);
}

# Vec of [status_code, count] pairs across every worker.
fn agnosai_lt_result_status_codes(r): i64 {
    return load64(r + AGN_LTR_STATUS_CODES);
}

# The result as a bayan JSON value, fields in the oracle's declaration order.
fn agnosai_lt_result_to_value_a(a, r): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "target_url"),
      bayan_json_v_str_new_a(a, load64(r + AGN_LTR_TARGET_URL)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "concurrent_users"),
      bayan_json_v_int_new_a(a, load64(r + AGN_LTR_CONCURRENT_USERS)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "duration_seconds"),
      bayan_json_v_int_new_a(a, load64(r + AGN_LTR_DURATION_SECS)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "total_requests"),
      bayan_json_v_int_new_a(a, load64(r + AGN_LTR_TOTAL_REQUESTS)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "successful_requests"),
      bayan_json_v_int_new_a(a, load64(r + AGN_LTR_SUCCESSFUL)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "failed_requests"),
      bayan_json_v_int_new_a(a, load64(r + AGN_LTR_FAILED)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "avg_latency_ms"),
      _agnosai_lt_ms_value_a(a, load64(r + AGN_LTR_AVG_NS)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "p50_latency_ms"),
      _agnosai_lt_ms_value_a(a, load64(r + AGN_LTR_P50_NS)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "p95_latency_ms"),
      _agnosai_lt_ms_value_a(a, load64(r + AGN_LTR_P95_NS)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "p99_latency_ms"),
      _agnosai_lt_ms_value_a(a, load64(r + AGN_LTR_P99_NS)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "min_latency_ms"),
      _agnosai_lt_ms_value_a(a, load64(r + AGN_LTR_MIN_NS)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "max_latency_ms"),
      _agnosai_lt_ms_value_a(a, load64(r + AGN_LTR_MAX_NS)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "throughput_rps"),
      _agnosai_lt_rps_value_a(a, load64(r + AGN_LTR_THROUGHPUT_MILLI)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "error_rate"),
      _agnosai_lt_rate_value_a(a, load64(r + AGN_LTR_ERROR_RATE_PPM)));

    var codes = load64(r + AGN_LTR_STATUS_CODES);
    var codes_v = bayan_json_v_obj_new_a(a);
    for (var i = 0; i < vec_len(codes); i = i + 1) {
        var pair = vec_get(codes, i);
        bayan_json_v_obj_set_a(a, codes_v, str_from_int_a(a, load64(pair)),
          bayan_json_v_int_new_a(a, load64(pair + 8)));
    }
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "status_codes"), codes_v);
    return obj;
}

# Global-allocator form of `agnosai_lt_result_to_value_a`.
fn agnosai_lt_result_to_value(r): i64 {
    return agnosai_lt_result_to_value_a(default_alloc(), r);
}

# Run a load test: spawn `users` worker threads, join them, aggregate.
#
# Returns the result, or 0 when no request completed. `duration_secs` must
# already be clamped by the caller.
fn agnosai_load_test_run_a(a, url: Str, users, duration_secs, executor_fp): i64 {
    # ⚠ **`.max(1)` HERE, at the divide — this is where the oracle puts it.**
    # `load_testing.rs:135` is `MAX_TOTAL_REQUESTS / concurrent_users.max(1)`,
    # and it is the ONLY floor the oracle applies: `concurrent_users` itself is
    # only `.min(500)`'d, so 0 is a legal value that spawns nothing.
    #
    # The port used to floor the count in `agnosai_lt_clamp_users` instead, which
    # made 0 run a real one-worker load test. Removing that floor to match the
    # oracle without also porting THIS guard left `100000 / 0` reachable from an
    # unauthenticated `POST /mcp` — an i64 divide by a runtime zero raises SIGFPE,
    # which is not per-thread recoverable, so the whole server dies. The two
    # halves are one change and must move together.
    var divisor = users;
    if (divisor < 1) { divisor = 1; }
    var per_user = AGNOSAI_LT_MAX_TOTAL_REQUESTS / divisor;
    if (per_user < 1) { per_user = 1; }
    var deadline = clock_now_ns() + duration_secs * AGNOSAI_NS_PER_SEC;

    var workers = vec_new_a(a);
    for (var i = 0; i < users; i = i + 1) {
        var w = agnosai_lt_worker_new_a(a, url, deadline, per_user, executor_fp, i);
        # A worker that could not get its arenas is skipped rather than run —
        # every allocation in its loop would return 0 and be dereferenced.
        if (w != 0) {
            vec_push_a(a, workers, w);
            # Detached, so a run leaves no handle or TLS behind. With no thread to be had, the user
            # runs here: its deadline is absolute, so the run still ends on time and says what it
            # measured.
            if (thread_create_detached(&_agnosai_lt_thread_main, w) == 0) { _agnosai_lt_thread_main(w); }
        }
    }
    if (vec_len(workers) == 0) { return 0; }
    for (var j = 0; j < vec_len(workers); j = j + 1) {
        agnosai_done_word_wait(vec_get(workers, j) + AGN_LT_DONE);
    }

    var result = agnosai_lt_aggregate_a(a, workers, url, users, duration_secs);

    # Every worker arena is released here — nothing in the aggregate points
    # into one, because agnosai_lt_aggregate copies each latency and status
    # count into `a`.
    for (var k = 0; k < vec_len(workers); k = k + 1) {
        agnosai_lt_worker_release(vec_get(workers, k));
    }
    return result;
}

# Global-allocator form of `agnosai_load_test_run_a`.
fn agnosai_load_test_run(url: Str, users, duration_secs, executor_fp): i64 {
    return agnosai_load_test_run_a(default_alloc(), url, users, duration_secs, executor_fp);
}

# The load_testing tool's parameter schema.
fn _agnosai_load_testing_schema(a, ctx): i64 {
    var s = agnosai_tool_schema_new_a(a, str_from_a(a, "load_testing"),
      str_from_a(a, "Generate HTTP load against a target URL with concurrent users and measure performance metrics."));
    agnosai_tool_schema_param_a(a, s, str_from_a(a, "target_url"), str_from_a(a, "URL to load test"),
      str_from_a(a, "string"), 1);
    agnosai_tool_schema_param_a(a, s, str_from_a(a, "concurrent_users"),
      str_from_a(a, "Number of concurrent users (default: 10)"), str_from_a(a, "number"), 0);
    agnosai_tool_schema_param_a(a, s, str_from_a(a, "duration_seconds"),
      str_from_a(a, "Test duration in seconds (default: 10)"), str_from_a(a, "number"), 0);
    return s;
}

# Clamp the user count to the oracle's ceiling of 500.
#
# ⚠ **There is no LOWER clamp.** The oracle applies only `.min(500)`, so
# `concurrent_users: 0` is legal, spawns nothing, and the tool answers
# `"load test failed: no requests completed"`. The port raised 0 to 1 and ran a
# real one-worker load test against the target for the full duration — traffic
# the caller explicitly asked not to send, and a success where the oracle
# reports a failure.
fn agnosai_lt_clamp_users(users): i64 {
    if (users > AGNOSAI_LT_MAX_USERS) { return AGNOSAI_LT_MAX_USERS; }
    return users;
}

# Clamp the duration to [1, 300] seconds, the oracle's range.
fn agnosai_lt_clamp_duration(secs): i64 {
    if (secs < AGNOSAI_LT_MIN_DURATION_SECS) { return AGNOSAI_LT_MIN_DURATION_SECS; }
    if (secs > AGNOSAI_LT_MAX_DURATION_SECS) { return AGNOSAI_LT_MAX_DURATION_SECS; }
    return secs;
}

# Emit the two traces the oracle's `tracing::info!` calls carry. Guarded on
# the live level so the formatting is only paid when it would be emitted.
#
# Both call sites are on the main thread — before the fan-out and after the
# join. Nothing logs from inside a worker: sakshi's ring buffer is a process
# global, and the worker loop is the one place in this codebase where several
# OS threads run at once.
#
# `c_key` is optional: 0 omits the third pair.
fn _agnosai_lt_log_a(a, msg, msg_len, url: Str, a_key, a_val, b_key, b_val, c_key, c_val): i64 {
    if (sakshi_get_level() < SK_INFO) { return 0; }
    var sb = str_builder_new_a(a);
    str_builder_add_a(a, sb, url);
    str_builder_add_cstr_a(a, sb, " ");
    str_builder_add_cstr_a(a, sb, a_key);
    str_builder_add_cstr_a(a, sb, "=");
    str_builder_add_int_a(a, sb, a_val);
    str_builder_add_cstr_a(a, sb, " ");
    str_builder_add_cstr_a(a, sb, b_key);
    str_builder_add_cstr_a(a, sb, "=");
    str_builder_add_int_a(a, sb, b_val);
    if (c_key != 0) {
        str_builder_add_cstr_a(a, sb, " ");
        str_builder_add_cstr_a(a, sb, c_key);
        str_builder_add_cstr_a(a, sb, "=");
        str_builder_add_int_a(a, sb, c_val);
    }
    var line = str_builder_build_a(a, sb);
    sakshi_log_kv(SK_INFO, msg, msg_len, "load_test", 9, str_data(line), str_len(line));
    return 0;
}

# Execute a load test from tool input.
#
# The target check runs **before** anything else touches the network, and with no gate its
# rejection message is the oracle's. So the tool cannot be pointed at loopback unless a gate
# admits it (ADR 025), which is deliberate. Its requests follow no redirect, as sandhi's
# default has it, so the target is the only URL this tool ever reaches.
fn _agnosai_load_testing_execute(ctx, input): i64 {
    var a = agnosai_tool_input_alloc(input);
    var target = agnosai_tool_input_get_str(input, str_from_a(a, "target_url"));
    if (target == 0) {
        return agnosai_tool_output_err_a(a, str_from_a(a, "missing required parameter: target_url"));
    }
    var refused = agnosai_tool_target_refused(input, target);
    if (refused != 0) { return refused; }

    var users = agnosai_tool_input_get_int(input, str_from_a(a, "concurrent_users"));
    if (users == AGNOSAI_NO_LIMIT) { users = 10; }
    users = agnosai_lt_clamp_users(users);

    var duration = agnosai_tool_input_get_int(input, str_from_a(a, "duration_seconds"));
    if (duration == AGNOSAI_NO_LIMIT) { duration = 10; }
    duration = agnosai_lt_clamp_duration(duration);

    _agnosai_lt_log_a(a, "load test starting", 18, target, "concurrent_users", users,
      "duration_secs", duration, 0, 0);

    var result = agnosai_load_test_run_a(a, target, users, duration, &agnosai_lt_http_executor);
    if (result == 0) {
        return agnosai_tool_output_err_a(a, str_from_a(a, "load test failed: no requests completed"));
    }

    # Throughput is logged in thousandths of a request per second — the integer
    # carrier the result already holds, which keeps a float out of the log path.
    # p99 is in milliseconds.
    _agnosai_lt_log_a(a, "load test completed", 19, target,
      "total_requests", load64(result + AGN_LTR_TOTAL_REQUESTS),
      "p99_latency_ms", load64(result + AGN_LTR_P99_NS) / AGNOSAI_NS_PER_MS,
      "throughput_milli_rps", load64(result + AGN_LTR_THROUGHPUT_MILLI));

    return agnosai_tool_output_ok_a(a, agnosai_lt_result_to_value_a(a, result));
}

# The load_testing tool.
fn agnosai_load_testing_tool(): i64 {
    return agnosai_tool_new(str_from("load_testing"),
      str_from("Generate HTTP load against a target URL with concurrent users and measure performance metrics."),
      &_agnosai_load_testing_schema, &_agnosai_load_testing_execute, 0);
}

# Register the load_testing built-in. Returns the registry.
fn agnosai_register_load_testing_builtin(registry): i64 {
    agnosai_tool_registry_register(registry, agnosai_load_testing_tool());
    return registry;
}
