# =========================================================================
# tools/builtin/delta — the three Delta code-platform tools.
#
# Origin: rust-old/src/tools/builtin/delta.rs
#
# Delta is the AGNOS code platform; the oracle's default base URL is
# `http://localhost:8070`. The HTTP shape lives in `src/tools/agnos.cyr`.
#
# Two of the three tools interpolate caller-supplied segments into the path, and
# both guard them with the oracle's `contains('/') || contains("..")` check. The
# guard order matters and is preserved: the oracle iterates a fixed array, so
# with both `owner` and `repo` invalid it reports `owner` — the first — and the
# message names which segment was rejected.
# =========================================================================

# A client pointed at the default Delta base URL.
fn agnosai_delta_client(): i64 {
    return agnosai_agnos_client(str_from(AGNOSAI_DELTA_BASE_URL), str_from("delta"));
}

# ---------------------------------------------------------------------------
# delta_list_repos
# ---------------------------------------------------------------------------

# The delta_list_repos parameter schema — no parameters.
fn _agnosai_delta_list_repos_schema(a, ctx): i64 {
    return agnosai_tool_schema_new_a(a, str_from_a(a, "delta_list_repos"),
      str_from_a(a, "List repositories on the Delta code platform"));
}

# List the repositories Delta knows about.
fn _agnosai_delta_list_repos_execute(ctx, input): i64 {
    var a = agnosai_tool_input_alloc(input);
    return agnosai_agnos_call_a(a, ctx, "GET", str_from_a(a, "/api/v1/repos"), 0, 0);
}

# The delta_list_repos tool, bound to a client.
fn agnosai_delta_list_repos_tool(client): i64 {
    return agnosai_tool_new(str_from("delta_list_repos"),
      str_from("List repositories on the Delta code platform"),
      &_agnosai_delta_list_repos_schema, &_agnosai_delta_list_repos_execute, client);
}

# ---------------------------------------------------------------------------
# delta_trigger_pipeline
# ---------------------------------------------------------------------------

# The delta_trigger_pipeline parameter schema.
fn _agnosai_delta_trigger_schema(a, ctx): i64 {
    var s = agnosai_tool_schema_new_a(a, str_from_a(a, "delta_trigger_pipeline"),
      str_from_a(a, "Trigger a CI/CD pipeline for a repository on the Delta code platform"));
    agnosai_tool_schema_param_a(a, s, str_from_a(a, "owner"), str_from_a(a, "Repository owner"),
      str_from_a(a, "string"), 1);
    agnosai_tool_schema_param_a(a, s, str_from_a(a, "repo"), str_from_a(a, "Repository name"),
      str_from_a(a, "string"), 1);
    agnosai_tool_schema_param_a(a, s, str_from_a(a, "branch"),
      str_from_a(a, "Branch to build (defaults to main)"), str_from_a(a, "string"), 0);
    return s;
}

# `/api/v1/<owner>/<repo>/pipelines`, with an optional trailing segment.
fn _agnosai_delta_pipeline_path_a(a, owner: Str, repo: Str, run_id): i64 {
    var sb = str_builder_new_a(a);
    str_builder_add_cstr_a(a, sb, "/api/v1/");
    agnosai_agnos_add_segment_a(a, sb, owner);
    str_builder_add_cstr_a(a, sb, "/");
    agnosai_agnos_add_segment_a(a, sb, repo);
    str_builder_add_cstr_a(a, sb, "/pipelines");
    if (run_id != 0) {
        str_builder_add_cstr_a(a, sb, "/");
        agnosai_agnos_add_segment_a(a, sb, run_id);
    }
    return str_builder_build_a(a, sb);
}

# Trigger a pipeline run.
#
# The body is `{}` when no branch is given, **not** `{"branch": "main"}`. The
# `branch` parameter's own description says "defaults to main", but the oracle
# only inserts the key when the caller supplies one — the defaulting happens
# server-side, if at all. Reproducing the description instead of the code would
# send a request the oracle never sends.
fn _agnosai_delta_trigger_execute(ctx, input): i64 {
    var a = agnosai_tool_input_alloc(input);
    var owner = agnosai_tool_input_get_str(input, str_from_a(a, "owner"));
    if (owner == 0) {
        return agnosai_tool_output_err_a(a, str_from_a(a, "missing required parameter: owner"));
    }
    var repo = agnosai_tool_input_get_str(input, str_from_a(a, "repo"));
    if (repo == 0) {
        return agnosai_tool_output_err_a(a, str_from_a(a, "missing required parameter: repo"));
    }

    # Guarded in the oracle's array order, so the reported name matches.
    if (agnosai_agnos_segment_ok(owner) == 0) {
        return agnosai_agnos_segment_err_a(a, str_from_a(a, "owner"));
    }
    if (agnosai_agnos_segment_ok(repo) == 0) {
        return agnosai_agnos_segment_err_a(a, str_from_a(a, "repo"));
    }

    var body = bayan_json_v_obj_new_a(a);
    var branch = agnosai_tool_input_get_str(input, str_from_a(a, "branch"));
    if (branch != 0) {
        bayan_json_v_obj_set_a(a, body, str_from_a(a, "branch"), bayan_json_v_str_new_a(a, branch));
    }

    return agnosai_agnos_call_a(a, ctx, "POST", _agnosai_delta_pipeline_path_a(a, owner, repo, 0), body, 0);
}

# The delta_trigger_pipeline tool, bound to a client.
fn agnosai_delta_trigger_pipeline_tool(client): i64 {
    return agnosai_tool_new(str_from("delta_trigger_pipeline"),
      str_from("Trigger a CI/CD pipeline for a repository on the Delta code platform"),
      &_agnosai_delta_trigger_schema, &_agnosai_delta_trigger_execute, client);
}

# ---------------------------------------------------------------------------
# delta_get_pipeline
# ---------------------------------------------------------------------------

# The delta_get_pipeline parameter schema.
fn _agnosai_delta_get_pipeline_schema(a, ctx): i64 {
    var s = agnosai_tool_schema_new_a(a, str_from_a(a, "delta_get_pipeline"),
      str_from_a(a, "Get the status of a CI/CD pipeline run on the Delta code platform"));
    agnosai_tool_schema_param_a(a, s, str_from_a(a, "owner"), str_from_a(a, "Repository owner"),
      str_from_a(a, "string"), 1);
    agnosai_tool_schema_param_a(a, s, str_from_a(a, "repo"), str_from_a(a, "Repository name"),
      str_from_a(a, "string"), 1);
    agnosai_tool_schema_param_a(a, s, str_from_a(a, "pipeline_id"), str_from_a(a, "Pipeline run identifier"),
      str_from_a(a, "string"), 1);
    return s;
}

# Report one pipeline run's status.
fn _agnosai_delta_get_pipeline_execute(ctx, input): i64 {
    var a = agnosai_tool_input_alloc(input);
    var owner = agnosai_tool_input_get_str(input, str_from_a(a, "owner"));
    if (owner == 0) {
        return agnosai_tool_output_err_a(a, str_from_a(a, "missing required parameter: owner"));
    }
    var repo = agnosai_tool_input_get_str(input, str_from_a(a, "repo"));
    if (repo == 0) {
        return agnosai_tool_output_err_a(a, str_from_a(a, "missing required parameter: repo"));
    }
    var pipeline_id = agnosai_tool_input_get_str(input, str_from_a(a, "pipeline_id"));
    if (pipeline_id == 0) {
        return agnosai_tool_output_err_a(a, str_from_a(a, "missing required parameter: pipeline_id"));
    }

    # Guarded in the oracle's array order: owner, repo, pipeline_id.
    if (agnosai_agnos_segment_ok(owner) == 0) {
        return agnosai_agnos_segment_err_a(a, str_from_a(a, "owner"));
    }
    if (agnosai_agnos_segment_ok(repo) == 0) {
        return agnosai_agnos_segment_err_a(a, str_from_a(a, "repo"));
    }
    if (agnosai_agnos_segment_ok(pipeline_id) == 0) {
        return agnosai_agnos_segment_err_a(a, str_from_a(a, "pipeline_id"));
    }

    return agnosai_agnos_call_a(a, ctx, "GET", _agnosai_delta_pipeline_path_a(a, owner, repo, pipeline_id),
      0, 0);
}

# The delta_get_pipeline tool, bound to a client.
fn agnosai_delta_get_pipeline_tool(client): i64 {
    return agnosai_tool_new(str_from("delta_get_pipeline"),
      str_from("Get the status of a CI/CD pipeline run on the Delta code platform"),
      &_agnosai_delta_get_pipeline_schema, &_agnosai_delta_get_pipeline_execute, client);
}

# Register all three Delta tools against a live client. Returns the registry.
fn agnosai_register_delta_builtins(registry): i64 {
    var client = agnosai_delta_client();
    agnosai_tool_registry_register(registry, agnosai_delta_list_repos_tool(client));
    agnosai_tool_registry_register(registry, agnosai_delta_trigger_pipeline_tool(client));
    agnosai_tool_registry_register(registry, agnosai_delta_get_pipeline_tool(client));
    return registry;
}
