# =========================================================================
# tools/registry — tool registration, lookup, and allow-list gating.
#
# Origin: rust-old/src/tools/registry.rs
#
# Port notes (divergences from the Rust shape, all deliberate):
#   * **The oracle uses `DashMap` for lock-free concurrency. Cyrius has no
#     concurrent map, so this is a hashmap behind a futex mutex** — and the
#     mutex is mandatory, not optional. `sandhi_server_run_pooled` makes every
#     worker its own OS thread (port plan, the concurrency decision), so an
#     unguarded `map_set` during a concurrent `map_get` is a live data race
#     that would corrupt the table. Every entry point below takes the lock.
#     On Linux `lib/sync.cyr` gives a real 2-state futex mutex; the agnos
#     build's no-op is correct there because agnos threads run serially.
#   * Lock granularity is the whole registry. That is right for this workload:
#     registration happens at startup and lookups are a hash plus a pointer
#     read, so the critical sections are nanoseconds. A sharded or read-biased
#     lock would be speculative until a benchmark says otherwise.
#   * `Arc<dyn NativeTool>` becomes the plain tool-vtable pointer from
#     tools_native. Tools are process-lifetime and shared-immutable, which the
#     port plan already established is a raw pointer rather than a refcount
#     ("52 `Arc<` in src/, of which 49 are process-lifetime shared-immutable").
# =========================================================================

include "src/order.cyr"

# ToolRegistry heap layout. `ORDER` is the tools by name, a vec on the global heap kept for good and
# rebuilt only when `STALE` says the set has changed (`_agnosai_registry_order`).
enum AgnosaiToolRegistryOff {
    AGN_REG_TOOLS = 0;
    AGN_REG_MUTEX = 8;
    AGN_REG_GATE = 16;
    AGN_REG_ORDER = 24;
    AGN_REG_STALE = 32;
    AGN_REG_SIZE = 40;
}

# Create an empty registry with its own lock.
fn agnosai_tool_registry_new(): i64 {
    var r = alloc(AGN_REG_SIZE);
    store64(r + AGN_REG_TOOLS, map_new_str());
    store64(r + AGN_REG_MUTEX, mutex_new());
    store64(r + AGN_REG_GATE, 0);
    store64(r + AGN_REG_ORDER, 0);
    store64(r + AGN_REG_STALE, 1);
    return r;
}

# Register a tool, keyed by its name. An existing tool of the same name is
# replaced, matching the oracle's `insert`, and let go (`agnosai_tool_drop`), so what it
# staged goes once no registry holds it (2.3.5).
fn agnosai_tool_registry_register(r, tool): i64 {
    var name = agnosai_tool_name(tool);
    _agnosai_registry_log(SK_DEBUG, "registering tool", 16, name);
    # Held before the old one is dropped, so a tool registered over itself never reaches 0.
    agnosai_tool_hold(tool);
    mutex_lock(load64(r + AGN_REG_MUTEX));
    var gate = load64(r + AGN_REG_GATE);
    if (gate != 0) { agnosai_tool_with_gate(tool, gate); }
    var tools = load64(r + AGN_REG_TOOLS);
    var old = map_get(tools, name);
    map_set(tools, str_clone(name), tool);
    store64(r + AGN_REG_STALE, 1);
    mutex_unlock(load64(r + AGN_REG_MUTEX));
    if (old != 0) { agnosai_tool_drop(old); }
    return 0;
}

# Hold every tool in the registry to `gate`, now and as tools are registered later (ADR 025).
# 0 lifts it from the tools held here.
#
# A tool object may be shared between registries, and it holds one gate: the last set wins.
fn agnosai_tool_registry_set_gate(r, gate): i64 {
    mutex_lock(load64(r + AGN_REG_MUTEX));
    store64(r + AGN_REG_GATE, gate);
    var tools = load64(r + AGN_REG_TOOLS);
    var keys = map_keys(tools);
    for (var i = 0; i < vec_len(keys); i = i + 1) {
        agnosai_tool_with_gate(map_get(tools, vec_get(keys, i)), gate);
    }
    mutex_unlock(load64(r + AGN_REG_MUTEX));
    return r;
}

# Look up a tool by name, or 0 when not registered.
fn agnosai_tool_registry_get(r, name: Str): i64 {
    mutex_lock(load64(r + AGN_REG_MUTEX));
    var tool = map_get(load64(r + AGN_REG_TOOLS), name);
    mutex_unlock(load64(r + AGN_REG_MUTEX));
    return tool;
}

# Whether a tool with the given name is registered.
fn agnosai_tool_registry_has(r, name: Str): i64 {
    mutex_lock(load64(r + AGN_REG_MUTEX));
    var present = map_has(load64(r + AGN_REG_TOOLS), name);
    mutex_unlock(load64(r + AGN_REG_MUTEX));
    return present;
}

# Remove a tool by name. Returns 1 if it was present, 0 otherwise.
#
# The tool is let go (`agnosai_tool_drop`) outside the lock, so its release, a tool's own
# code, stalls no other worker's lookup. A call already holding the tool keeps running: a
# WASM tool's module, for one, goes when its last run ends.
fn agnosai_tool_registry_remove(r, name: Str): i64 {
    mutex_lock(load64(r + AGN_REG_MUTEX));
    var tools = load64(r + AGN_REG_TOOLS);
    var present = map_has(tools, name);
    var old = 0;
    if (present == 1) {
        old = map_get(tools, name);
        map_delete(tools, name);
        store64(r + AGN_REG_STALE, 1);
    }
    mutex_unlock(load64(r + AGN_REG_MUTEX));
    if (old != 0) { agnosai_tool_drop(old); }
    return present;
}

# Number of currently registered tools.
fn agnosai_tool_registry_count(r): i64 {
    mutex_lock(load64(r + AGN_REG_MUTEX));
    var n = map_size(load64(r + AGN_REG_TOOLS));
    mutex_unlock(load64(r + AGN_REG_MUTEX));
    return n;
}

# Two tools by name, for `agnosai_sort`.
fn _agnosai_tool_cmp_name(a, b): i64 {
    return agnosai_order_str_cmp(agnosai_tool_name(a), agnosai_tool_name(b));
}

# The tools by name, rebuilt only when the set has changed. The caller holds the lock.
#
# A sort per list more than doubled it: `tool_registry_list_500` went from 123 to 295 µs. A tool set
# changes rarely and is read on every `GET /api/v1/tools`, and the sort is over pointers and names
# with no tool's own code in it, so it is safe under the lock.
fn _agnosai_registry_order(r): i64 {
    var order = load64(r + AGN_REG_ORDER);
    if (load64(r + AGN_REG_STALE) == 0) { return order; }
    if (order == 0) {
        order = vec_new();
        store64(r + AGN_REG_ORDER, order);
    }
    vec_truncate(order, 0);
    var tools = load64(r + AGN_REG_TOOLS);
    var n = _agnosai_map_slots(tools);
    for (var i = 0; i < n; i = i + 1) {
        if (_agnosai_map_slot_live(tools, i) == 1) { vec_push(order, _agnosai_map_slot_val(tools, i)); }
    }
    agnosai_sort(order, &_agnosai_tool_cmp_name);
    store64(r + AGN_REG_STALE, 0);
    return order;
}

# Vec of the schemas of all registered tools, **by name** (2.3.6).
#
# The map's own order is random per process (`lib/hashmap.cyr` seeds it), and this is what
# `GET /api/v1/tools` and MCP `tools/list` send, so a client reading the list twice across a restart
# saw two different lists. The Rust line's was random too.
#
# The schema callbacks run **outside** the lock: a tool's `schema_fp` is
# arbitrary user code, and calling it while holding the registry lock would let
# one tool stall every other worker's lookups. The key snapshot is taken under
# the lock, then released.
fn agnosai_tool_registry_list_a(a, r): i64 {
    mutex_lock(load64(r + AGN_REG_MUTEX));
    var order = _agnosai_registry_order(r);
    var found = vec_new_a(a);
    for (var i = 0; i < vec_len(order); i = i + 1) { vec_push_a(a, found, vec_get(order, i)); }
    mutex_unlock(load64(r + AGN_REG_MUTEX));

    var schemas = vec_new_a(a);
    for (var j = 0; j < vec_len(found); j = j + 1) {
        vec_push_a(a, schemas, agnosai_tool_schema_a(a, vec_get(found, j)));
    }
    return schemas;
}

# Global-allocator form of `agnosai_tool_registry_list_a`.
#
# **The vecs and the schemas inside them are all the arena's now.**
# `agnosai_tool_schema_a` passes `a` through to the tool's own `schema_fp`,
# which the vtable takes as its first parameter — so the per-call schema build
# lands in the request arena rather than on the global bump. This comment used
# to say the opposite, and correctly: before the callback took an allocator,
# `/api/v1/tools` floored at 288 bytes per request for exactly that reason.
#
# The kept order rather than `map_keys` (standing rule 5), which is what makes the
# vec allocation actually land in `a`.
fn agnosai_tool_registry_list(r): i64 {
    return agnosai_tool_registry_list_a(default_alloc(), r);
}

# Vec of the names of all registered tools, in order.
fn agnosai_tool_registry_names(r): i64 {
    mutex_lock(load64(r + AGN_REG_MUTEX));
    var keys = map_keys(load64(r + AGN_REG_TOOLS));
    mutex_unlock(load64(r + AGN_REG_MUTEX));
    agnosai_sort(keys, &agnosai_order_str_cmp);
    return keys;
}

# Whether a tool name is permitted by an agent's allow-list.
#
# **An empty list means no restriction** — every tool is allowed. That is the
# oracle's rule and it is security-relevant in both directions: callers must
# not treat an empty list as "deny all", and must not pass an empty list
# expecting a default-deny.
fn agnosai_is_tool_allowed(tool_name: Str, allowed_tools): i64 {
    if (vec_len(allowed_tools) == 0) { return 1; }
    for (var i = 0; i < vec_len(allowed_tools); i = i + 1) {
        if (str_eq(vec_get(allowed_tools, i), tool_name) == 1) { return 1; }
    }
    return 0;
}

# Look up a tool by name, enforcing an agent's allow-list.
#
# Returns 0 when the tool is not registered **or** not permitted. A blocked
# lookup is logged at WARN, as the oracle does — a silently-empty result on a
# denied tool call is exactly the thing an audit trail needs to see.
fn agnosai_tool_registry_get_allowed(r, name: Str, allowed_tools): i64 {
    if (agnosai_is_tool_allowed(name, allowed_tools) == 0) {
        _agnosai_registry_log(SK_WARN, "tool call blocked: not in agent allow-list", 42, name);
        return 0;
    }
    return agnosai_tool_registry_get(r, name);
}

# Emit a registry trace. Guarded on the live level so the formatting cost is
# only paid when the message would actually be emitted.
fn _agnosai_registry_log(level, msg, msg_len, tool_name: Str): i64 {
    if (sakshi_get_level() < level) { return 0; }
    sakshi_log_kv(level, msg, msg_len, "tool", 4, str_data(tool_name), str_len(tool_name));
    return 0;
}
