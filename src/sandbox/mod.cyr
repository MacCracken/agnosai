# =========================================================================
# sandbox — tool execution isolation.
#
# Parity oracle: rust-old/src/sandbox/mod.rs
#
# **M7.** The oracle's `mod.rs` is 35 lines: one constant and the module
# declarations plus re-exports. Cyrius has no `pub use`, and the flat namespace
# means a symbol defined anywhere is visible everywhere, so the re-export half
# has no counterpart — the include list below is the whole of it.
#
# ## What M7 ships, and what it does not
#
# ⚠ This paragraph used to say `wasm.rs` (521 lines, 11 tests) was "**excluded**
# rather than postponed … WASM as a format is an explicit cyrius non-goal".
# **Retired.** [ADR 006](../../docs/adr/006-cx-tool-sandbox.md)'s own 2026-08-07
# correction overturned it — kavach ships a wasmtime backend, so an existing
# `.wasm` artifact never had to be rewritten — and the full-port mandate settles
# the rest. ✅ **`wasm.rs` shipped in M11** (`src/sandbox/wasm.cyr`, 2026-08-10)
# and is **not** replaced by cx: the two are complementary backends, cx for
# Cyrius-authored tools and WASM for everything already compiled to it. The path
# first executed a real module on 2026-08-11, once wasmtime was installed and
# three latent defects it had been hiding were fixed.
#
# ⚠ It DOES port onto kavach's backend, but only from **kavach 3.11.8**. In
# 3.11.7 that backend was hardcoded unavailable, had no stdin channel and
# discarded the guest's exit code — and the oracle's whole contract is JSON on
# stdin and a meaningful exit code. All three were filed and fixed;
# [ADR 019](../../docs/adr/019-wasm-tools-spawn-wasmtime-directly.md) records
# the round trip and why 3.11.8 is a floor rather than a preference.
#
# ## The env-sanitization constant is shared, so it lives here
#
# `SANITIZED_ENV_VARS` is stripped by **both** subprocess backends. The oracle
# puts it in `mod.rs` for that reason and this does the same, rather than
# duplicating the list into `process` and `python` where the two copies could
# drift apart — which for a security control is the failure that matters.
# =========================================================================

include "src/sandbox/policy.cyr"
include "src/sandbox/kavach_bridge.cyr"
include "src/sandbox/spawn.cyr"
include "src/sandbox/oci.cyr"
include "src/sandbox/process.cyr"
include "src/sandbox/python.cyr"
include "src/sandbox/cx.cyr"
include "src/sandbox/wasm.cyr"
include "src/sandbox/manager.cyr"

# Environment variables removed from every child process the subprocess
# sandboxes spawn — `rust-old/src/sandbox/mod.rs:14-19`.
#
# All four are loader-injection vectors: `LD_PRELOAD` and `LD_LIBRARY_PATH` on
# ELF, `DYLD_INSERT_LIBRARIES` and `DYLD_LIBRARY_PATH` on Mach-O. Left in place
# they let a caller load arbitrary code into the sandboxed child *before* its
# `main` runs, which defeats the sandbox without touching it.
#
# The macOS pair is stripped even on Linux, and deliberately: the cost is two
# string compares, and the alternative — a per-platform list — is a control that
# silently narrows on whichever platform the author was not testing.
var AGNOSAI_SANITIZED_ENV_COUNT = 4;

# The `i`-th sanitized variable name, or 0 past the end.
#
# A function rather than an array because Cyrius has no slice-of-string-literals
# and the list is walked, never indexed randomly.
fn agnosai_sanitized_env_var(i): i64 {
    if (i == 0) { return "LD_PRELOAD"; }
    if (i == 1) { return "LD_LIBRARY_PATH"; }
    if (i == 2) { return "DYLD_INSERT_LIBRARIES"; }
    if (i == 3) { return "DYLD_LIBRARY_PATH"; }
    return 0;
}

# Whether `name` is one of the variables a sandboxed child must not inherit.
#
# Case-sensitive, matching the oracle's `&str` equality — the loader itself
# matches these names exactly, so a case-insensitive test here would strip
# variables the loader would have ignored while implying a protection that
# does not exist.
fn agnosai_is_sanitized_env_var(name: Str): i64 {
    var i = 0;
    while (i < AGNOSAI_SANITIZED_ENV_COUNT) {
        if (str_eq_cstr(name, agnosai_sanitized_env_var(i)) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}
