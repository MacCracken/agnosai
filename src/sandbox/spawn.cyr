# =========================================================================
# sandbox/spawn — the subprocess primitive the sandbox backends share.
#
# Origin: the spawn halves of rust-old/src/sandbox/{process,python,oci}.rs
#
# **M7 bites 4-6.** No oracle file corresponds to this module: in Rust the work
# is `Command::env_remove` plus tokio's `Stdio::piped()` and `kill_on_drop`,
# spread across three call sites. Cyrius has none of that, so the three backends
# need one primitive underneath them rather than three hand-rolled `fork` loops.
#
# It landed in pieces because the whole thing is large and each piece is
# separately provable: sanitized `envp` and the CLOEXEC bit (bite 4, the only
# part testable without forking), then fork/pipes/exec/status (bite 5), then the
# stdin feed (bite 6), then the deadline, SIGKILL and reap (bite 7).
#
# ## The exec-errno pipe — proven before it was designed in
#
# The rest of this module rests on one thing being possible: telling **"spawn
# failed"** apart from **"the child ran and exited 127"**. `fork` + `execve`
# cannot, because a failed `execve` leaves the child alive and every stdlib path
# resolves that to `sys_exit(127)` — indistinguishable from a program that
# legitimately exits 127. Three oracle sites require the distinction:
# `oci.rs:219` (`missing_runtime_returns_error`), `process.rs:331`
# (`invalid_executable`), and `python.rs:87` ("failed to spawn python process").
#
# The answer is a fourth pipe carrying **`FD_CLOEXEC` on its write end**, so the
# kernel closes it exactly when `execve` succeeds. The parent then reads: bytes
# mean the exec failed, EOF means it worked.
#
# **Verified on this box before committing to it** (2026-08-03). `pipe2` is not
# wrapped on x86_64, but `sys_pipe` + `syscall(SYS_FCNTL, wfd, F_SETFD,
# FD_CLOEXEC)` is; `SYS_FCNTL` (72) and `O_CLOEXEC` (524288) are both defined. A
# probe forking `/bin/sh -c 'exit 127'` and `/nonexistent/binary` reported
# **spawned, exit 127** for the first and **spawn failed** for the second.
#
# ## The loop sleeps when idle, and that is not a nicety
#
# Both read ends are `O_NONBLOCK`, so a read with nothing available returns at
# once. A loop that just retries therefore **burns a core** for as long as the
# child is thinking. Measured on the version that shipped in bite 5, against a
# child running `sleep 2`: **100% CPU for 2.006 s**. A short sleep on an
# iteration that moved no bytes drops that to nothing, and doubles as the tick
# the deadline is checked on.
#
# ## There is no `kill_on_drop`, so every exit path kills and reaps explicitly
#
# The oracle gets teardown free from tokio (`process.rs:112`, `:192`,
# `python.rs:76`, `oci.rs:149`). Cyrius has no RAII: a child left behind after a
# timeout keeps its pipe ends open, so the parent's next drain never sees EOF,
# and the process table fills with zombies. `_agnosai_spawn_kill_and_reap` is
# the single place that does it, called from the one path that can end early.
#
# ## Three pipes are not enough either — the stdin WRITE must interleave too
#
# The oracle writes its entire input before it ever reads
# (`process.rs:133-139`, `python.rs:92-101`), which tokio survives only because
# its reader is a separate task. Reproduced literally on a blocking write it is
# a second deadlock, and a nastier one: the parent fills the child's 64 KiB
# stdin pipe and blocks, while the child — having filled its own stdout pipe
# that nobody is draining — blocks too. Neither moves.
#
# So the write is non-blocking and takes its turn in the same loop as the two
# reads. The stdin write end is closed as soon as the input is exhausted,
# because a child reading to EOF never finishes otherwise.
#
# ## Two pipes are not enough — the drain must interleave
#
# The oracle reads `stdout` and `stderr` through tokio's `wait_with_output`,
# which polls both. A port that drains stdout to EOF and *then* reads stderr
# **deadlocks**: once the stderr pipe fills (64 KiB), the child blocks writing to
# it, so it never closes stdout, so the parent never finishes its first read.
#
# Both read ends are therefore `O_NONBLOCK` and drained round-robin. **Verified
# before it was written**: a child emitting 70,700 bytes to *each* stream — both
# past the pipe buffer — is captured whole, where the drain-then-drain shape
# hangs.
#
# ## Env sanitization is the security control, and it is subtractive
#
# `SANITIZED_ENV_VARS` (`src/sandbox/mod.cyr`) names four loader-injection
# vectors. The oracle removes them from an inherited environment with
# `Command::env_remove`; here the inherited block is read and rebuilt without
# them, which is the same operation spelled out.
#
# **Matching is on the NAME only — everything before the first `=`.** An entry
# is `KEY=VALUE`, and a value that happens to contain the string `LD_PRELOAD`
# is not a variable named `LD_PRELOAD`. Testing the whole entry would drop
# innocent variables and, worse, would make the filter's behaviour depend on
# data an attacker supplies.
# =========================================================================

# `F_SETFD` — the `fcntl` op that sets file-descriptor flags.
var AGNOSAI_F_SETFD = 2;

# `FD_CLOEXEC` — close this descriptor on a successful `execve`.
#
# The whole exec-errno mechanism is this one bit: the write end disappears iff
# the exec worked, which turns "did it work?" into "did I read anything?".
var AGNOSAI_FD_CLOEXEC = 1;

# The name half of a `KEY=VALUE` environ entry, as a `Str` borrowing the entry.
#
# An entry with no `=` is malformed; the whole entry is treated as the name,
# which is what makes such an entry testable against the sanitized list rather
# than silently passed through.
fn _agnosai_env_entry_name(entry): Str {
    var i = 0;
    while (load8(entry + i) != 0) {
        if (load8(entry + i) == 61) { return str_new(entry, i); }
        i = i + 1;
    }
    return str_new(entry, i);
}

# The `NAME` half of a `NAME=value` **Str**.
#
# The sibling above walks a raw `char*` from `environ`; this one walks a `Str`,
# whose bytes carry no NUL and whose first eight bytes are a length, not text.
# Handing a `Str` to the cstr version reads the header as characters.
fn _agnosai_env_str_name(s: Str): Str {
    var d = str_data(s);
    var n = str_len(s);
    var i = 0;
    while (i < n) {
        if (load8(d + i) == 61) { return str_new(d, i); }
        i = i + 1;
    }
    return s;
}

# Whether this environ entry must not reach a sandboxed child.
#
# Compares the **name only** — see the module header on why the value must not
# participate.
fn agnosai_env_entry_is_sanitized(entry): i64 {
    if (entry == 0) { return 0; }
    return agnosai_is_sanitized_env_var(_agnosai_env_entry_name(entry));
}

# The sanitized environment, once built. See `agnosai_sanitized_envp`.
var _AGNOSAI_SANITIZED_ENVP = 0;

# Build a NULL-terminated `envp` for a sandboxed child: the parent's environment
# with every `SANITIZED_ENV_VARS` entry removed.
#
# Returns an array of cstring pointers terminated by 0, never 0 itself — a child
# with no environment at all is still a valid child, and returning 0 would push
# a null check into every caller for a case that is not an error.
#
# The entries point into the same heap blob `_read_environ_envp` allocated, so
# the array survives `fork` without copying strings.
#
# **Built once and shared** (2.3.4). The block it filters is the stdlib's, read once and
# cached (`env_block`), so the filtered array cannot change either, and every caller only
# reads it. Built per call, it was two pointer arrays on the global heap for every spawn.
fn agnosai_sanitized_envp(): i64 {
    var e = atomic_load(&_AGNOSAI_SANITIZED_ENVP);
    if (e != 0) { return e; }
    e = _agnosai_sanitized_envp_of(_read_environ_envp());
    # Two threads racing here build two copies, and the loser's is a few hundred bytes, once.
    atomic_fence();
    atomic_store(&_AGNOSAI_SANITIZED_ENVP, e);
    return e;
}

# The filter itself, over an explicitly supplied `envp` array.
#
# **Split out so the control can be tested against a block that actually
# contains one of the variables.** The audit of 2026-08-04 deleted the filter
# outright — `if (agnosai_env_entry_is_sanitized(e) == 0)` replaced by
# `if (1 == 1)` — and the suite reported 144/144, byte for byte the baseline,
# because no developer or CI environment carries an `LD_*` for it to remove.
# Re-running the same mutant with `LD_PRELOAD` exported produced three failures,
# which is the point: the test was measuring the ambient environment, not the
# code. A caller-supplied block removes the environment from the question.
fn _agnosai_sanitized_envp_of(src): i64 {
    if (src == 0) {
        var empty = alloc(8);
        store64(empty, 0);
        return empty;
    }

    var n = 0;
    while (load64(src + n * 8) != 0) { n = n + 1; }

    var out = alloc((n + 1) * 8);
    var oi = 0;
    var i = 0;
    while (i < n) {
        var e = load64(src + i * 8);
        if (agnosai_env_entry_is_sanitized(e) == 0) {
            store64(out + oi * 8, e);
            oi = oi + 1;
        }
        i = i + 1;
    }
    store64(out + oi * 8, 0);
    return out;
}

# Build an `envp` from an explicit `KEY=VALUE` vec, sanitized the same way.
#
# For a caller that supplies its own environment rather than inheriting one.
# **The filter applies here too**, deliberately: a caller passing `LD_PRELOAD`
# explicitly is the same injection the inherited path exists to stop, and a
# sanitizer that only covers the inherited case is one an attacker routes
# around by supplying the variable instead.
fn agnosai_sanitized_envp_from(entries): i64 {
    var kept = vec_new();
    var i = 0;
    while (i < vec_len(entries)) {
        var e = vec_get(entries, i);
        if (agnosai_env_entry_is_sanitized(str_data(e)) == 0) { vec_push(kept, e); }
        i = i + 1;
    }
    return _agnosai_envp_build(kept);
}

# A NUL-terminated `char**` from a vec of `NAME=value` strings, filtering
# nothing.
#
# **Every entry is NUL-terminated individually**, which the array's own
# terminator does not do for it.
#
# Measured: swapping `str_cstr` for the raw `str_data` the earlier version used
# changes nothing observable today — a `str_cat` result happens to be followed
# by a zero byte, because the bump allocator hands out zeroed memory and never
# reuses it. So this is not a fix for a live bug; it is a refusal to depend on
# an allocator's incidental behaviour for a pointer handed to `execve`. The
# copy costs one allocation per entry against a `fork` and an `exec`.
fn _agnosai_envp_build(entries): i64 {
    return _agnosai_envp_build_a(default_alloc(), entries);
}

# `_agnosai_envp_build`, in `a`. `str_clone_a` ends each copy with its NUL.
fn _agnosai_envp_build_a(a, entries): i64 {
    var n = vec_len(entries);
    var out = alloc_via(a, (n + 1) * 8);
    var i = 0;
    while (i < n) {
        store64(out + i * 8, str_data(str_clone_a(a, vec_get(entries, i))));
        i = i + 1;
    }
    store64(out + n * 8, 0);
    return out;
}

# How many entries an `envp` array holds, not counting its terminator.
fn agnosai_envp_len(envp): i64 {
    if (envp == 0) { return 0; }
    var n = 0;
    while (load64(envp + n * 8) != 0) { n = n + 1; }
    return n;
}

# Whether `envp` carries a variable of this name.
fn agnosai_envp_has(envp, name: Str): i64 {
    if (envp == 0) { return 0; }
    var i = 0;
    while (load64(envp + i * 8) != 0) {
        if (str_eq(_agnosai_env_entry_name(load64(envp + i * 8)), name) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Mark `fd` close-on-exec. Returns 1 on success, 0 on failure.
#
# The exec-errno pipe's write end needs this and nothing else does yet; it is
# named rather than inlined because getting it wrong is silent — an unmarked
# write end never closes, the parent's read blocks forever, and every spawn
# hangs instead of reporting.
fn agnosai_fd_set_cloexec(fd): i64 {
    if (syscall(SYS_FCNTL, fd, AGNOSAI_F_SETFD, AGNOSAI_FD_CLOEXEC) < 0) { return 0; }
    return 1;
}

# --- Confinement (2.3.4, ADR 031) -------------------------------------------
#
# The process and Python tiers run their child under kavach's confinement: the child
# applies `confine_child_caps` (NO_NEW_PRIVS, landlock, kavach's exec seccomp filter, every
# inherited descriptor closed) and then execs a binary the parent pinned by descriptor.
# agnosai keeps its own spawner around it, so argv, stdin, the environment, the work
# directory, the deadline and the two captured streams are exactly what they were.
#
# ⚠ **Not `sandbox_exec`.** Measured on kavach 3.14.7, that path refuses `python3`, `sh`
# and every other interpreter by name when there is no rootfs (`blocked command`, exit 126),
# and keeps each run's exit code, timeout flag and stderr in process-wide variables, which two
# tool calls on two threads share: about half of 200 concurrent runs read the other's stderr.
# The confinement primitives have none of that: everything here is per call, and the child is
# a copy of this process with nothing shared after the fork.
#
# ## The landlock rules
#
# Read and execute on the system's own trees, read and write on `/tmp`, `/dev/null`,
# `/dev/shm` and the call's work directory, and nothing else. A tool can run any program
# under `/usr`, `/bin` or `/lib` and read `/etc`, and cannot read the server's files,
# another user's, `/home`, `/root`, `/var`, `/srv` or `/opt`, or write anywhere it was not
# given. `/proc/self` is the child's own `/proc/<pid>`, as the rule is opened in the child,
# so a program can read its own status and nobody else's. A path the host does not have is
# left out, as kavach fails a rule it cannot open. `agnosai_confinement_allow` adds one.
#
# ⚠ **Network is not isolated on these tiers.** Without a rootfs that takes a network
# namespace, which needs a user namespace when unprivileged, and Ubuntu 24.04 and later,
# docker's default seccomp profile and GitHub's runners refuse one. Requiring it would stop
# every process and Python tool on those hosts. Landlock ABI 4 can refuse TCP connect and
# bind with no namespace, and kavach applies no network rule yet (filed). kavach's score has
# given these tiers no network credit since 3.14.7, so nothing claims what is not applied.

# `F_DUPFD_CLOEXEC` — duplicate onto the lowest free fd at or above an argument.
var AGNOSAI_F_DUPFD_CLOEXEC = 1030;

# kavach's `_spawn_close_inherited` closes every descriptor below this, and a confined
# child's errno pipe and pinned binary have to survive it.
var AGNOSAI_CONFINE_FD_FLOOR = 1024;

# The soft open-file limit a confined child raises itself to when its own is too low to
# hold a descriptor above the floor. Its own, after the fork: the server's is not touched.
var AGNOSAI_CONFINE_NOFILE = 4096;

# `RLIMIT_NOFILE` on Linux.
var AGNOSAI_RLIMIT_NOFILE = 7;

# A confined child could not put a descriptor above the floor: the hard open-file limit
# is below it.
var AGNOSAI_SPAWN_FAIL_CONFINE_FDS = 5;

# Confinement layout — 40 bytes. `POLICY` is a kavach `SandboxPolicy` with seccomp on and
# the landlock rules. `SECCOMP` is kavach's exec filter, built once. `LANDLOCK` is the ABI
# the kernel reports, 0 where it has none. `WORKDIRS` holds a policy per work directory.
enum AgnosaiConfinementOff {
    AGN_CF_POLICY = 0;
    AGN_CF_SECCOMP = 8;
    AGN_CF_LANDLOCK = 16;
    AGN_CF_RULES = 24;
    AGN_CF_WORKDIRS = 32;
    AGN_CF_SIZE = 40;
}

# The read-and-execute trees every confined child gets, where the host has them.
var _AGNOSAI_CONFINE_READ = 0;
# The read-and-write ones.
var _AGNOSAI_CONFINE_WRITE = 0;
# What `agnosai_confinement_allow` added, as `(cstring, writable)` pairs.
var _AGNOSAI_CONFINE_EXTRA = 0;
var _AGNOSAI_CONFINE_DEFAULT = 0;
var _AGNOSAI_CONFINE_LOCK = mutex_new();

# The base rule list, built on first use.
fn _agnosai_confine_base_paths(): i64 {
    if (_AGNOSAI_CONFINE_READ != 0) { return 0; }
    var r = vec_new();
    vec_push(r, "/usr");
    vec_push(r, "/bin");
    vec_push(r, "/sbin");
    vec_push(r, "/lib");
    vec_push(r, "/lib32");
    vec_push(r, "/lib64");
    vec_push(r, "/libx32");
    vec_push(r, "/etc");
    # `/etc/resolv.conf` is a link into here on systemd hosts, and landlock judges the target.
    vec_push(r, "/run/systemd/resolve");
    vec_push(r, "/proc/self");
    vec_push(r, "/dev/urandom");
    vec_push(r, "/dev/random");
    vec_push(r, "/dev/zero");
    var w = vec_new();
    vec_push(w, "/tmp");
    vec_push(w, "/dev/null");
    vec_push(w, "/dev/shm");
    _AGNOSAI_CONFINE_WRITE = w;
    _AGNOSAI_CONFINE_READ = r;
    return 0;
}

# Give every confined child `path` as well, writable if `writable` is 1. Returns 0, or -1
# once the confinement is built, as a child already running has its rules.
# ⚠ **Call at start-up, before any tool runs.** `AGNOSAI_SANDBOX_READ_PATHS` and
# `AGNOSAI_SANDBOX_WRITE_PATHS` reach this from the binary.
fn agnosai_confinement_allow(path: Str, writable): i64 {
    if (path == 0 || str_len(path) == 0) { return 0 - 1; }
    mutex_lock(_AGNOSAI_CONFINE_LOCK);
    if (atomic_load(&_AGNOSAI_CONFINE_DEFAULT) != 0) {
        mutex_unlock(_AGNOSAI_CONFINE_LOCK);
        return 0 - 1;
    }
    if (_AGNOSAI_CONFINE_EXTRA == 0) { _AGNOSAI_CONFINE_EXTRA = vec_new(); }
    vec_push(_AGNOSAI_CONFINE_EXTRA, str_cstr(path));
    vec_push(_AGNOSAI_CONFINE_EXTRA, writable);
    mutex_unlock(_AGNOSAI_CONFINE_LOCK);
    return 0;
}

# Add `path` to `p` with `access`, if it exists. kavach fails a rule it cannot open, and the
# whole confinement with it.
fn _agnosai_confine_add(p, rules, path, access): i64 {
    if (sys_access(path, 0) != 0) { return 0; }
    policy_landlock_add(p, path, access);
    vec_push(rules, path);
    vec_push(rules, access);
    return 1;
}

# kavach's basic policy, saying what this confinement applies: seccomp, and the network
# left on. `policy_basic()` says no network, which nothing applies without a namespace (see
# the section header), and a kavach that began enforcing it would cut every tool off in a
# patch release. A tool loses its network when agnosai asks for that, and not before.
fn _agnosai_confine_base_policy(): i64 {
    var p = policy_basic();
    SandboxPolicy_set_network_enabled(p, 1);
    return p;
}

# A policy holding `c`'s rules, and `workdir` read-write when it is not 0.
fn _agnosai_confine_policy(rules, workdir): i64 {
    var p = _agnosai_confine_base_policy();
    var n = vec_len(rules);
    for (var i = 0; i + 1 < n; i = i + 2) {
        policy_landlock_add(p, vec_get(rules, i), vec_get(rules, i + 1));
    }
    if (workdir != 0) {
        if (sys_access(workdir, 0) == 0) { policy_landlock_add(p, workdir, FS_READ_WRITE); }
    }
    return p;
}

# A confinement over the base rules and what `agnosai_confinement_allow` added, or 0 when
# kavach cannot build its seccomp filter, which is a host that cannot confine at all.
fn agnosai_confinement_new(): i64 {
    _agnosai_confine_base_paths();
    var sres_t, sres_v = security_create_exec_seccomp_filter();
    if (is_ok(sres_t) == 0) { return 0; }

    var c = alloc(AGN_CF_SIZE);
    store64(c + AGN_CF_SECCOMP, result_unwrap(sres_t, sres_v));
    store64(c + AGN_CF_LANDLOCK, security_landlock_abi_version());
    var rules = vec_new();
    var p = _agnosai_confine_base_policy();
    for (var i = 0; i < vec_len(_AGNOSAI_CONFINE_READ); i = i + 1) {
        _agnosai_confine_add(p, rules, vec_get(_AGNOSAI_CONFINE_READ, i), FS_READ_ONLY);
    }
    for (var j = 0; j < vec_len(_AGNOSAI_CONFINE_WRITE); j = j + 1) {
        _agnosai_confine_add(p, rules, vec_get(_AGNOSAI_CONFINE_WRITE, j), FS_READ_WRITE);
    }
    if (_AGNOSAI_CONFINE_EXTRA != 0) {
        for (var k = 0; k + 1 < vec_len(_AGNOSAI_CONFINE_EXTRA); k = k + 2) {
            var access = FS_READ_ONLY;
            if (vec_get(_AGNOSAI_CONFINE_EXTRA, k + 1) == 1) { access = FS_READ_WRITE; }
            _agnosai_confine_add(p, rules, vec_get(_AGNOSAI_CONFINE_EXTRA, k), access);
        }
    }
    store64(c + AGN_CF_POLICY, p);
    store64(c + AGN_CF_RULES, rules);
    store64(c + AGN_CF_WORKDIRS, vec_new());
    return c;
}

# The confinement every process and Python tool runs under, built on first use and kept,
# or 0 when the host cannot confine. A kernel with no landlock gets one with no filesystem
# rules, and says so once.
fn agnosai_confinement_default(): i64 {
    var c = atomic_load(&_AGNOSAI_CONFINE_DEFAULT);
    if (c != 0) { return c; }
    mutex_lock(_AGNOSAI_CONFINE_LOCK);
    c = atomic_load(&_AGNOSAI_CONFINE_DEFAULT);
    if (c == 0) {
        c = agnosai_confinement_new();
        if (c != 0) {
            if (load64(c + AGN_CF_LANDLOCK) == 0) {
                var m = "this kernel has no landlock: process and Python tools run without filesystem confinement";
                sakshi_warn(m, strlen(m));
            }
            atomic_fence();
            atomic_store(&_AGNOSAI_CONFINE_DEFAULT, c);
        }
    }
    mutex_unlock(_AGNOSAI_CONFINE_LOCK);
    return c;
}

# What a tier's config holds to mean "the default confinement", resolved when it runs, as
# the default is built on first use. 0 means unconfined, and anything else is a confinement.
var AGNOSAI_CONFINEMENT_DEFAULT = 1;

# The confinement a tier's `v` names, or 0 for unconfined. `ok_out` is set to 0 when `v`
# asked for one and the host could not build it, which a tier refuses rather than run
# its child unconfined.
fn agnosai_confinement_resolve(v, ok_out): i64 {
    store64(ok_out, 1);
    if (v == 0) { return 0; }
    if (v != AGNOSAI_CONFINEMENT_DEFAULT) { return v; }
    var c = agnosai_confinement_default();
    if (c == 0) { store64(ok_out, 0); }
    return c;
}

# `c` with `path` as well, writable if `writable` is 1: a new confinement, sharing `c`'s
# seccomp filter. For a tool that needs a tree the default does not give, without giving it
# to every tool. 0 when `path` does not exist.
fn agnosai_confinement_with_path(c, path: Str, writable): i64 {
    var cp = str_cstr(path);
    if (sys_access(cp, 0) != 0) { return 0; }
    var rules = vec_new();
    var old = load64(c + AGN_CF_RULES);
    for (var i = 0; i < vec_len(old); i = i + 1) { vec_push(rules, vec_get(old, i)); }
    vec_push(rules, cp);
    if (writable == 1) { vec_push(rules, FS_READ_WRITE); } else { vec_push(rules, FS_READ_ONLY); }
    var n = alloc(AGN_CF_SIZE);
    store64(n + AGN_CF_SECCOMP, load64(c + AGN_CF_SECCOMP));
    store64(n + AGN_CF_LANDLOCK, load64(c + AGN_CF_LANDLOCK));
    store64(n + AGN_CF_RULES, rules);
    store64(n + AGN_CF_POLICY, _agnosai_confine_policy(rules, 0));
    store64(n + AGN_CF_WORKDIRS, vec_new());
    return n;
}

# The landlock ABI the kernel reported when `c` was built, 0 for none.
fn agnosai_confinement_landlock_abi(c): i64 {
    return load64(c + AGN_CF_LANDLOCK);
}

# How many landlock rules `c` holds, the host's paths that exist.
fn agnosai_confinement_rule_count(c): i64 {
    return vec_len(load64(c + AGN_CF_RULES)) / 2;
}

# The policy for a child working in `workdir`, a cstring or 0. One per distinct directory,
# made once and kept: a tier's work directory is the operator's, so there are few, and a
# policy a call built for itself would be one more allocation per call that never goes.
fn _agnosai_confine_policy_for(c, workdir): i64 {
    if (workdir == 0) { return load64(c + AGN_CF_POLICY); }
    mutex_lock(_AGNOSAI_CONFINE_LOCK);
    var dirs = load64(c + AGN_CF_WORKDIRS);
    var p = 0;
    for (var i = 0; i + 1 < vec_len(dirs); i = i + 2) {
        if (streq(vec_get(dirs, i), workdir) == 1) { p = vec_get(dirs, i + 1); }
    }
    if (p == 0) {
        var n = strlen(workdir);
        var key = alloc(n + 1);
        memcpy(key, workdir, n);
        store8(key + n, 0);
        p = _agnosai_confine_policy(load64(c + AGN_CF_RULES), key);
        vec_push(dirs, key);
        vec_push(dirs, p);
    }
    mutex_unlock(_AGNOSAI_CONFINE_LOCK);
    return p;
}

# `fd` again at or above the floor, close-on-exec, raising this child's own soft open-file
# limit once if it is too low to allow that. In the CHILD: syscalls only.
fn _agnosai_confine_lift_fd(fd): i64 {
    var hi = syscall(SYS_FCNTL, fd, AGNOSAI_F_DUPFD_CLOEXEC, AGNOSAI_CONFINE_FD_FLOOR);
    if (hi >= 0) { return hi; }
    var lim[16];
    if (sys_getrlimit(AGNOSAI_RLIMIT_NOFILE, &lim) != 0) { return 0 - 1; }
    var want = AGNOSAI_CONFINE_NOFILE;
    if (load64(&lim + 8) < want) { want = load64(&lim + 8); }
    store64(&lim, want);
    #ifdef CYRIUS_ARCH_X86
    syscall(302, 0, AGNOSAI_RLIMIT_NOFILE, &lim, 0);
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    syscall(261, 0, AGNOSAI_RLIMIT_NOFILE, &lim, 0);
    #endif
    return syscall(SYS_FCNTL, fd, AGNOSAI_F_DUPFD_CLOEXEC, AGNOSAI_CONFINE_FD_FLOOR);
}

# Write one word down the errno pipe.
fn _agnosai_spawn_report(fd, word): i64 {
    var w[8];
    store64(&w, word);
    sys_write(fd, &w, 8);
    return 0;
}

# The confined child's last steps: die with the server, lift the errno pipe and the pin
# above what kavach closes, confine, say so, and exec the pin. Returns only to exit.
#
# Order: `confine_child_caps` closes every inherited descriptor, so the two lifts come
# first, and seccomp is its last step, so nothing after it needs a syscall it denies.
# The marker is written after confinement and before the exec, so a child that never
# writes it was stopped by a confinement step, whose exit code kavach chose.
fn _agnosai_spawn_confine_child(policy, seccomp, pin, xwf, ppid, argv, envp): i64 {
    syscall(SYS_PRCTL, 1, 9, 0, 0, 0);
    if (sys_getppid() != ppid) { syscall(SYS_EXIT_GROUP, 127); }
    var xhi = _agnosai_confine_lift_fd(xwf);
    if (xhi < 0) {
        _agnosai_spawn_report(xwf, AGNOSAI_SPAWN_FAIL_CONFINE_FDS);
        syscall(SYS_EXIT_GROUP, 127);
    }
    var phi = _agnosai_confine_lift_fd(pin);
    if (phi < 0) {
        _agnosai_spawn_report(xwf, AGNOSAI_SPAWN_FAIL_CONFINE_FDS);
        syscall(SYS_EXIT_GROUP, 127);
    }
    confine_child_caps(policy, 0, 0, sys_getuid(), sys_getgid(), seccomp, 0, 0, 0);
    _agnosai_spawn_report(xhi, AGNOSAI_SPAWN_CONFINED);
    kv_exec_pinned(phi, argv, envp);
    _agnosai_spawn_report(xhi, AGNOSAI_SPAWN_FAIL_EXEC);
    syscall(SYS_EXIT_GROUP, 127);
    return 0;
}

# --- Spawn ----------------------------------------------------------------

# `F_SETFL` — the `fcntl` op that sets file-status flags.
var AGNOSAI_F_SETFL = 4;

# `EPIPE` — the pipe this was written to has no reader left.
#
# Named here because `lib/syscalls_x86_64_linux.cyr`'s `Errno` enum stops short
# of it and the one definition in the tree belongs to a dependency
# (`lib/kavach.cyr:649`), whose enum agnosai must not bind to by accident. The
# stdin write loop is the only caller and it needs to tell this apart from
# `EAGAIN`: `EAGAIN` means come back next turn, `EPIPE` means there is no next
# turn.
var AGNOSAI_SPAWN_EPIPE = 32;

# How much is read per drain iteration.
var AGNOSAI_SPAWN_CHUNK = 4096;

# The spawn itself failed — `execve` never ran the program.
#
# **Distinct from any exit code, and that is the whole point.** A failed
# `execve` leaves the child alive at 127, which is also what a program that
# genuinely exits 127 reports. Three oracle sites require `Err` for the first
# and `Ok(127)` for the second.
var AGNOSAI_SPAWN_FAILED = 0 - 1;

# The spawn succeeded; the child ran and was reaped.
var AGNOSAI_SPAWN_OK = 0;

# Field offsets for a completed spawn.
enum AgnosaiSpawnResultOff {
    AGN_SPR_STATUS = 0;
    AGN_SPR_STDOUT = 8;
    AGN_SPR_STDERR = 16;
    AGN_SPR_EXIT_CODE = 24;
    AGN_SPR_SIGNAL = 32;
    AGN_SPR_TIMED_OUT = 40;
    AGN_SPR_FAIL_REASON = 48;
    AGN_SPR_STDIN_ERR = 56;
    AGN_SPR_SIZE = 64;
}

# Whether the spawn itself succeeded — `AGNOSAI_SPAWN_OK` or `_FAILED`.
fn agnosai_spawn_status(r): i64 { return load64(r + AGN_SPR_STATUS); }

# The child's captured stdout.
fn agnosai_spawn_stdout(r): Str { return load64(r + AGN_SPR_STDOUT); }

# The child's captured stderr, held separately.
fn agnosai_spawn_stderr(r): Str { return load64(r + AGN_SPR_STDERR); }

# The child's exit code, or **-1 when it was signalled**.
#
# -1 matches the oracle's `status.code().unwrap_or(-1)`: a signalled process has
# no exit code, and reporting 0 would read as success.
fn agnosai_spawn_exit_code(r): i64 { return load64(r + AGN_SPR_EXIT_CODE); }

# The signal that killed the child, or 0 if it exited normally.
fn agnosai_spawn_signal(r): i64 { return load64(r + AGN_SPR_SIGNAL); }

# Whether the deadline fired and the child was killed.
#
# **Distinct from being signalled.** A child that SIGKILLs itself reports signal
# 9 and `timed_out` 0; one the deadline killed reports signal 9 and `timed_out`
# 1. Only the second is agnosai's doing, and only the second should surface to a
# caller as a timeout.
#
# **The partial output survives here on purpose, and `process` must discard it.**
# The oracle's timeout arm returns `stdout: String::new(), stderr: String::new()`
# (`process.rs:154-160`) because cancelling `wait_with_output` throws the buffers
# away — it does not choose to hide them. This primitive has no oracle
# counterpart (it stands in for tokio's `Command`), so it keeps what it drained;
# `ProcessResult` is where the oracle's shape is owed, and that is where the
# blanking goes.
fn agnosai_spawn_timed_out(r): i64 { return load64(r + AGN_SPR_TIMED_OUT); }

# Which step failed, when `agnosai_spawn_status` is `AGNOSAI_SPAWN_FAILED`.
#
# `AGNOSAI_SPAWN_FAIL_NONE` on every successful spawn, including one whose child
# exited non-zero — a program that ran and failed is not a spawn failure.
fn agnosai_spawn_fail_reason(r): i64 { return load64(r + AGN_SPR_FAIL_REASON); }

# Whether the input could not be delivered because the child stopped reading.
#
# **Not a spawn failure and not an error here.** The program ran; it simply
# exited — or closed stdin — before draining what it was given, so `status` is
# still `AGNOSAI_SPAWN_OK` and whatever it wrote is still captured. The oracle
# reaches the same fork through `write_all`'s `Err`, and the three backends
# disagree about what it means: `python.rs:92-95` turns it into an error,
# `process.rs:133-137` and `oci.rs:158-162` log a warning and keep the output.
# A primitive that picked one of those would be wrong for the other two, so it
# reports the fact and lets each backend decide.
fn agnosai_spawn_stdin_write_failed(r): i64 { return load64(r + AGN_SPR_STDIN_ERR); }

# How long an idle iteration waits before looking again.
#
# The floor on how fast output is noticed, and the granularity of the deadline.
# 5 ms costs 200 wakeups a second against a child producing nothing, versus the
# 100%-of-a-core the unslept loop measured.
var AGNOSAI_SPAWN_IDLE_MS = 5;

# What the child reported down the errno pipe before it gave up.
#
# The pipe already carried eight bytes that the parent read and discarded, so
# naming them costs a single store and turns "spawn failed" — the only thing a
# caller could previously learn — into something actionable. A bad `work_dir` is
# an operator's typo, and reporting it as a generic exec failure sends them
# looking at the wrong thing.
var AGNOSAI_SPAWN_FAIL_NONE = 0;
var AGNOSAI_SPAWN_FAIL_EXEC = 1;
var AGNOSAI_SPAWN_FAIL_CHDIR = 2;

# The parent could not set the spawn up at all — a pipe, the `FD_CLOEXEC` mark,
# or `fork` itself failed. No child exists, so nothing was reported down the
# errno pipe and the reason is filled in on the parent side.
var AGNOSAI_SPAWN_FAIL_SETUP = 3;

# A confined child stopped before its program ran: a step of kavach's sequence
# refused, and the child's exit code names which (`agnosai_spawn_confine_failure`).
var AGNOSAI_SPAWN_FAIL_CONFINE = 4;

# What a confined child writes once it is confined and about to exec. A child that
# exits without it never reached the exec, so its exit code is kavach's and not the
# program's. 2.3.4, ADR 031.
var AGNOSAI_SPAWN_CONFINED = 1129270854;

# No deadline — run until the child finishes on its own.
var AGNOSAI_SPAWN_NO_TIMEOUT = 0;

# SIGKILL the child and reap it, so it cannot linger holding pipe ends.
#
# SIGKILL rather than SIGTERM, matching tokio's `kill_on_drop`: a tool that has
# blown its deadline has already had its chance to exit, and a catchable signal
# it ignores would leave exactly the zombie this exists to prevent.
# `X_OK` — the `access` mode bit asking "may this be executed".
var AGNOSAI_SPAWN_X_OK = 1;

# `execvp`'s fallback when the environment carries no `PATH` at all.
var AGNOSAI_SPAWN_DEFAULT_PATH = "/bin:/usr/bin";

# Resolve a program name against `PATH`, as `Command::new` does.
#
# **`execve` does not search `PATH`; `Command::new` does.** The oracle's
# defaults are bare names - `"docker"` (`oci.rs:55`, `manager.rs:47`) and
# `"python3"` (`python.rs:36`) - so a primitive that only honours absolute paths
# fails to launch the default container runtime and the default interpreter,
# while reporting it as "failed to spawn", indistinguishable from the binary
# genuinely being absent.
#
# The search uses the **child's** `envp` rather than the parent's environment,
# because that is the `PATH` the program would itself see. A name containing a
# slash is used literally, matching `execvp`. When nothing matches, the original
# name is returned so the child's `execve` fails and reports it the usual way.
fn _agnosai_spawn_resolve(name, envp): i64 {
    return _agnosai_spawn_resolve_a(default_alloc(), name, envp);
}

# `_agnosai_spawn_resolve`, building its candidates in `a`. The answer is `name` itself or
# a cstring in `a`.
fn _agnosai_spawn_resolve_a(a, name, envp): i64 {
    var i = 0;
    while (load8(name + i) != 0) {
        if (load8(name + i) == 47) { return name; }
        i = i + 1;
    }

    var path = 0;
    var e = 0;
    while (envp != 0 && path == 0 && load64(envp + e * 8) != 0) {
        var entry = load64(envp + e * 8);
        # `+ 5` steps over `PATH=` to the value. Compared in place: a name taken as a Str was a
        # 16-byte header per entry checked, kept for good on every spawn by a bare name.
        if (memeq(entry, "PATH=", 5) == 1) { path = entry + 5; }
        e = e + 1;
    }
    if (path == 0) { path = AGNOSAI_SPAWN_DEFAULT_PATH; }

    var start = 0;
    var j = 0;
    while (1 == 1) {
        var ch = load8(path + j);
        if (ch == 58 || ch == 0) {
            if (j > start) {
                var sb = str_builder_new_a(a);
                _agnosai_sb_add_bytes_a(a, sb, path + start, j - start);
                str_builder_add_cstr_a(a, sb, "/");
                str_builder_add_cstr_a(a, sb, name);
                # `str_builder_build_a` ends its bytes with a NUL, so the data is a cstring.
                var cand = str_data(str_builder_build_a(a, sb));
                if (sys_access(cand, AGNOSAI_SPAWN_X_OK) == 0) { return cand; }
            }
            start = j + 1;
        }
        if (ch == 0) { return name; }
        j = j + 1;
    }
    return name;
}

# Returns the child's raw wait status, so the caller reports the signal the
# child **actually** died from rather than the one this meant to send. The two
# can differ — a child already dying of something else when the deadline lands
# reports that cause — and a result that hardcoded 9 would describe the
# intention instead of the event.
fn _agnosai_spawn_kill_and_reap(pid): i64 {
    sys_kill(pid, 9);
    var st[8];
    store64(&st, 0);
    sys_waitpid(pid, &st, 0);
    return load64(&st);
}

# Mark `fd` non-blocking, so a drain loop can round-robin without parking.
fn _agnosai_fd_set_nonblock(fd): i64 {
    if (syscall(SYS_FCNTL, fd, AGNOSAI_F_SETFL, O_NONBLOCK) < 0) { return 0; }
    return 1;
}

# Append `n` bytes at `p` to `sb` in `a`, with no Str allocated to carry them: the header
# is on the stack, and `str_builder_add_a` reads only its pointer and length.
fn _agnosai_sb_add_bytes_a(a, sb, p, n): i64 {
    var hdr[16];
    store64(&hdr, p);
    store64(&hdr + 8, n);
    return str_builder_add_a(a, sb, &hdr);
}

# A spawn result carrying nothing but the failure verdict.
fn _agnosai_spawn_failure(): i64 {
    return _agnosai_spawn_failure_a(default_alloc());
}

# `_agnosai_spawn_failure`, in `a`.
fn _agnosai_spawn_failure_a(a): i64 {
    var r = alloc_via(a, AGN_SPR_SIZE);
    store64(r + AGN_SPR_STATUS, AGNOSAI_SPAWN_FAILED);
    store64(r + AGN_SPR_STDOUT, str_from_a(a, ""));
    store64(r + AGN_SPR_STDERR, str_from_a(a, ""));
    store64(r + AGN_SPR_EXIT_CODE, 0 - 1);
    store64(r + AGN_SPR_SIGNAL, 0);
    store64(r + AGN_SPR_TIMED_OUT, 0);
    store64(r + AGN_SPR_FAIL_REASON, AGNOSAI_SPAWN_FAIL_SETUP);
    store64(r + AGN_SPR_STDIN_ERR, 0);
    return r;
}

# Report a setup failure, closing the `n` pipes already opened.
#
# **The reason this exists is that the old spelling stranded them.** Every
# `return _agnosai_spawn_failure()` before the fork left whatever had already
# succeeded open, and the paths that reach it are `EMFILE`/`ENFILE` — descriptor
# exhaustion. So the failure that fires on a full table consumed six more
# descriptors and never gave them back, and the process never recovered: the
# audit of 2026-08-04 measured a permanent loss of six per exhausted table, with
# every later attempt then failing at the *first* pipe.
#
# `pipes` is the flat 32-byte block the four `sys_pipe` calls fill; `n` is how
# many of them succeeded, so the loop closes exactly what exists.
fn _agnosai_spawn_setup_failure(pipes, n): i64 {
    return _agnosai_spawn_setup_failure_a(default_alloc(), pipes, n);
}

# `_agnosai_spawn_setup_failure`, with the result in `a`.
fn _agnosai_spawn_setup_failure_a(a, pipes, n): i64 {
    var i = 0;
    while (i < n) {
        sys_close(load32(pipes + i * 8));
        sys_close(load32(pipes + i * 8 + 4));
        i = i + 1;
    }
    return _agnosai_spawn_failure_a(a);
}

# Run `path` with `argv` and `envp`, capturing stdout and stderr separately.
#
# `argv` and `envp` are NULL-terminated arrays of cstring pointers;
# `agnosai_sanitized_envp` builds the latter. Returns a spawn result, never 0.
#
# **The child's stdin is closed**, not piped — feeding input is the next
# sub-bite. A child that reads stdin sees EOF immediately, which is correct for
# every caller this bite serves.
#
# Failure is reported through `agnosai_spawn_status`, not through an exit code:
# see `AGNOSAI_SPAWN_FAILED`.

# Run `path` with `argv` and `envp`, feeding `input` on stdin and capturing both
# output streams.
#
# `agnosai_spawn_capture` is this with no input and a closed stdin. Everything
# about the result is the same, including how spawn failure is reported.
#
# **The write interleaves with the reads.** Writing the whole input first is
# what the oracle does and what deadlocks here — see the module header.
fn agnosai_spawn_capture_input(path, argv, envp, input: Str, timeout_ms, work_dir): i64 {
    return agnosai_spawn_capture_confined(path, argv, envp, input, timeout_ms, work_dir, 0);
}

# `agnosai_spawn_capture_input`, with the child confined by `cf`, or not at all when `cf`
# is 0 (ADR 031). A confined program is pinned by descriptor before the fork, so a name
# that resolves to nothing executable is a spawn failure with no child, and the program
# that runs is the file that was checked, whatever replaces its path in between.
fn agnosai_spawn_capture_confined(path, argv, envp, input: Str, timeout_ms, work_dir, cf): i64 {
    return agnosai_spawn_capture_confined_a(default_alloc(), path, argv, envp, input, timeout_ms,
      work_dir, cf);
}

# `agnosai_spawn_capture_confined`, with everything a call keeps in `a`: the two captured
# streams, the result, and a resolved program path. A per-call arena then keeps nothing of
# the spawn on the global heap. ⚠ **`a` is this thread's**: the drain runs on it, and nothing
# else does.
fn agnosai_spawn_capture_confined_a(a, path, argv, envp, input: Str, timeout_ms, work_dir, cf): i64 {
    # **Ignore `SIGPIPE` before anything can be written.** A child that exits
    # without draining its stdin leaves the parent writing into a pipe with no
    # reader, and the default disposition kills the *writer* — agnosai itself,
    # not the tool. The audit of 2026-08-04 reproduced it both ways: a
    # 320,000-byte payload to a script that exits immediately took the whole
    # process down with 128+13, three runs out of three. Production was masked
    # only incidentally, because sandhi installs `SIG_IGN` inside its own serve
    # loops — nothing protected a test, a benchmark, or a consumer linking the
    # sandbox without running a server. The oracle cannot die here because Rust
    # installs the same disposition at startup.
    #
    # Set on every call rather than once behind a flag: `rt_sigaction` is
    # idempotent and process-wide, so a guard would buy one syscall against a
    # `fork` + `execve` and cost a racing read of shared state.
    signal_ignore(Signal.SIGPIPE);

    # One flat block rather than four, so a setup failure can close exactly the
    # pipes that opened — see `_agnosai_spawn_setup_failure`. Two `i32` fds each.
    var pipes[32];
    if (sys_pipe(&pipes) < 0) { return _agnosai_spawn_setup_failure_a(a, &pipes, 0); }
    if (sys_pipe(&pipes + 8) < 0) { return _agnosai_spawn_setup_failure_a(a, &pipes, 1); }
    if (sys_pipe(&pipes + 16) < 0) { return _agnosai_spawn_setup_failure_a(a, &pipes, 2); }
    if (sys_pipe(&pipes + 24) < 0) { return _agnosai_spawn_setup_failure_a(a, &pipes, 3); }
    var irf = load32(&pipes);
    var iwf = load32(&pipes + 4);
    var orf = load32(&pipes + 8);
    var owf = load32(&pipes + 12);
    var erf = load32(&pipes + 16);
    var ewf = load32(&pipes + 20);
    var xrf = load32(&pipes + 24);
    var xwf = load32(&pipes + 28);

    if (agnosai_fd_set_cloexec(xwf) == 0) { return _agnosai_spawn_setup_failure_a(a, &pipes, 4); }

    # Resolved BEFORE the fork: the search allocates, and doing it in the child
    # would build strings the parent can never see or free.
    var prog = _agnosai_spawn_resolve_a(a, path, envp);

    # Pinned before the fork as well, and refused here: a name the search did not turn
    # into a path, or a path that is no executable file. The policy for a work directory
    # is looked up here too, as it may be made, which allocates.
    var pin = 0 - 1;
    var cpol = 0;
    var ppid = 0;
    if (cf != 0) {
        pin = kv_exec_pin(prog);
        if (pin < 0) {
            var nf = _agnosai_spawn_setup_failure_a(a, &pipes, 4);
            store64(nf + AGN_SPR_FAIL_REASON, AGNOSAI_SPAWN_FAIL_EXEC);
            return nf;
        }
        cpol = _agnosai_confine_policy_for(cf, work_dir);
        ppid = sys_getpid();
    }

    var pid = sys_fork();
    if (pid < 0) {
        if (pin >= 0) { sys_close(pin); }
        return _agnosai_spawn_setup_failure_a(a, &pipes, 4);
    }
    if (pid == 0) {
        # ⚠ `sys_dup2`, NOT `syscall(SYS_DUP2, ...)`. SYS_DUP2 is x86_64-only —
        # aarch64 Linux has no dup2 syscall at all, only dup3 — so the raw form
        # failed the aarch64 cross-build with "undefined variable 'SYS_DUP2'".
        # The stdlib wrapper exists on both targets and translates to
        # dup3(oldfd, newfd, 0) on aarch64 (lib/syscalls_aarch64_linux.cyr).
        sys_dup2(irf, 0);
        sys_dup2(owf, 1);
        sys_dup2(ewf, 2);
        sys_close(iwf);
        sys_close(orf);
        sys_close(erf);
        sys_close(xrf);
        # **And the originals the dup2s copied.** `dup2` duplicates; it does not
        # consume. Leaving `irf`/`owf`/`ewf` open leaves the child holding extra
        # write-end copies of the output pipes, which a grandchild then inherits
        # — so the parent's read does not see EOF until every one of those
        # copies is gone, not merely until the direct child exits. The audit of
        # 2026-08-04 found this; the grandchild test passed anyway because
        # `_t_sp_cloexec_survives_a_grandchild` is bounded by its own sleep
        # rather than by EOF.
        #
        # Guarded, because a descriptor that already IS 0/1/2 must not be closed
        # after being dup2'd onto itself.
        if (irf != 0) { sys_close(irf); }
        if (owf != 1) { sys_close(owf); }
        if (ewf != 2) { sys_close(ewf); }
        # And hand the child back the *default* `SIGPIPE`, which the parent just
        # turned off for itself. `SIG_IGN` survives `execve` and a handler does
        # not; the oracle's children do not inherit it, because `Command` restores
        # the default in the child. Without this a tool running `cmd | head` would
        # see `write` return `EPIPE` where the same tool under the oracle dies on
        # the signal, silently. `signal_default` is the stdlib's since cyrius
        # 6.5.7 (filed from here); the local copy this called until 2.1.7 is gone
        # (roadmap C2).
        signal_default(Signal.SIGPIPE);
        # `work_dir` is applied HERE and not in the parent: a parent-side chdir
        # would move the whole server, every later relative path with it. A
        # failure must not fall through to `execve` — running the child in the
        # wrong directory is the bug this prevents — so it reports on the same
        # errno pipe and exits.
        if (work_dir != 0) {
            if (syscall(SYS_CHDIR, work_dir) < 0) {
                var ce[8];
                store64(&ce, AGNOSAI_SPAWN_FAIL_CHDIR);
                sys_write(xwf, &ce, 8);
                syscall(SYS_EXIT_GROUP, 127);
            }
        }
        if (cf != 0) {
            _agnosai_spawn_confine_child(cpol, load64(cf + AGN_CF_SECCOMP), pin, xwf, ppid, argv,
              envp);
        }
        sys_execve(prog, argv, envp);
        var e[8];
        store64(&e, AGNOSAI_SPAWN_FAIL_EXEC);
        sys_write(xwf, &e, 8);
        syscall(SYS_EXIT_GROUP, 127);
    }

    if (pin >= 0) { sys_close(pin); }
    sys_close(irf);
    sys_close(owf);
    sys_close(ewf);
    sys_close(xwf);
    _agnosai_fd_set_nonblock(orf);
    _agnosai_fd_set_nonblock(erf);
    _agnosai_fd_set_nonblock(iwf);

    var ob = str_builder_new_a(a);
    var eb = str_builder_new_a(a);
    # On the stack: one chunk, reused for every read of this call.
    var chunk[4096];
    var buf = &chunk;
    var ilen = str_len(input);
    var idata = str_data(input);
    var isent = 0;
    var iopen = 1;
    var ierr = 0;
    var odone = 0;
    var edone = 0;

    # An empty input still needs stdin closed, or a child reading to EOF waits
    # forever for a byte that is never coming.
    if (ilen == 0) { sys_close(iwf); iopen = 0; }

    var deadline = 0;
    if (timeout_ms > 0) { deadline = clock_now_ms() + timeout_ms; }
    var killed = 0;
    var kraw = 0;

    while (odone == 0 || edone == 0) {
        var moved = 0;
        if (iopen == 1) {
            var want = ilen - isent;
            if (want > AGNOSAI_SPAWN_CHUNK) { want = AGNOSAI_SPAWN_CHUNK; }
            if (want > 0) {
                var w = sys_write(iwf, idata + isent, want);
                # A negative return is EAGAIN — the child has not drained its
                # stdin yet. Not an error: come back next turn.
                #
                # **EPIPE is the one that is not EAGAIN.** The read end is gone
                # because the child exited or closed stdin, so retrying writes
                # into nothing forever. Before this arm the two were
                # indistinguishable and the loop retried until the deadline; with
                # `SIGPIPE` at its default the process never even got here.
                if (w > 0) { isent = isent + w; moved = 1; }
                if (w == 0 - AGNOSAI_SPAWN_EPIPE) { ierr = 1; }
            }
            # The child still gets EOF on the way out — the write end closes on
            # a broken pipe exactly as it does on an exhausted input.
            if (ierr == 1 || isent >= ilen) { sys_close(iwf); iopen = 0; }
        }
        if (odone == 0) {
            var n = sys_read(orf, buf, AGNOSAI_SPAWN_CHUNK);
            if (n > 0) { _agnosai_sb_add_bytes_a(a, ob, buf, n); moved = 1; }
            if (n == 0) { odone = 1; }
        }
        if (edone == 0) {
            var m = sys_read(erf, buf, AGNOSAI_SPAWN_CHUNK);
            if (m > 0) { _agnosai_sb_add_bytes_a(a, eb, buf, m); moved = 1; }
            if (m == 0) { edone = 1; }
        }

        if (deadline > 0 && clock_now_ms() >= deadline) {
            # Kill FIRST, then leave: the child's pipe ends must close or the
            # loop below would wait on EOF that is never coming.
            kraw = _agnosai_spawn_kill_and_reap(pid);
            killed = 1;
            odone = 1;
            edone = 1;
        }
        # Sleeping only when nothing moved keeps a busy child at full speed and
        # an idle one off the CPU — see the module header.
        if (moved == 0 && killed == 0) { sleep_ms(AGNOSAI_SPAWN_IDLE_MS); }
    }
    if (iopen == 1) { sys_close(iwf); }
    sys_close(orf);
    sys_close(erf);

    # Up to two words: a failure, or for a confined child the marker and then whatever
    # stopped the exec. Read to EOF, as the second may follow the first in its own write.
    var xb[16];
    var xn = 0;
    while (xn < 16) {
        var got = sys_read(xrf, &xb + xn, 16 - xn);
        if (got <= 0) { break; }
        xn = xn + got;
    }
    sys_close(xrf);

    var st[8];
    store64(&st, 0);
    # Already reaped on the timeout path — waiting again would block on a child
    # that no longer exists.
    if (killed == 0) { sys_waitpid(pid, &st, 0); }
    var raw = load64(&st);

    var r = alloc_via(a, AGN_SPR_SIZE);
    store64(r + AGN_SPR_STDOUT, str_builder_build_a(a, ob));
    store64(r + AGN_SPR_STDERR, str_builder_build_a(a, eb));
    store64(r + AGN_SPR_TIMED_OUT, killed);
    store64(r + AGN_SPR_STDIN_ERR, ierr);

    # A confined child that ran its program wrote the marker first. Without it, the
    # child exited inside kavach's sequence, and its exit code is the step that refused.
    var failed = 0;
    var reason = AGNOSAI_SPAWN_FAIL_NONE;
    if (xn >= 8) {
        reason = load64(&xb);
        failed = 1;
        if (cf != 0 && reason == AGNOSAI_SPAWN_CONFINED) {
            failed = 0;
            if (xn >= 16) {
                reason = load64(&xb + 8);
                failed = 1;
            }
        }
    } elif (cf != 0 && killed == 0) {
        reason = AGNOSAI_SPAWN_FAIL_CONFINE;
        failed = 1;
    }
    if (failed == 1) {
        store64(r + AGN_SPR_STATUS, AGNOSAI_SPAWN_FAILED);
        store64(r + AGN_SPR_EXIT_CODE, 0 - 1);
        store64(r + AGN_SPR_SIGNAL, 0);
        if (reason == AGNOSAI_SPAWN_FAIL_CONFINE) {
            store64(r + AGN_SPR_EXIT_CODE, (raw >> 8) & 255);
            store64(r + AGN_SPR_SIGNAL, raw & 127);
        }
        store64(r + AGN_SPR_FAIL_REASON, reason);
        return r;
    }

    store64(r + AGN_SPR_STATUS, AGNOSAI_SPAWN_OK);
    if (killed == 1) {
        store64(r + AGN_SPR_SIGNAL, kraw & 127);
        store64(r + AGN_SPR_EXIT_CODE, 0 - 1);
        return r;
    }
    var sig = raw & 127;
    if (sig != 0) {
        store64(r + AGN_SPR_SIGNAL, sig);
        store64(r + AGN_SPR_EXIT_CODE, 0 - 1);
    } else {
        store64(r + AGN_SPR_SIGNAL, 0);
        store64(r + AGN_SPR_EXIT_CODE, (raw >> 8) & 255);
    }
    return r;
}

# Why a confined child stopped before its program ran, a cstring: the step kavach names
# for the child's exit code, or what agnosai's own setup reports. 0 for a spawn that did
# not fail that way.
fn agnosai_spawn_confine_failure(r): i64 {
    if (agnosai_spawn_status(r) != AGNOSAI_SPAWN_FAILED) { return 0; }
    var reason = agnosai_spawn_fail_reason(r);
    if (reason == AGNOSAI_SPAWN_FAIL_CONFINE_FDS) {
        return "cannot keep a descriptor above 1024 (the hard open-file limit is too low)";
    }
    if (reason != AGNOSAI_SPAWN_FAIL_CONFINE) { return 0; }
    if (agnosai_spawn_signal(r) != 0) { return "the child was killed while being confined"; }
    var name = spawn_exit_name(agnosai_spawn_exit_code(r));
    if (name == 0) { return "the child exited while being confined"; }
    return name;
}

# Run `path` with no stdin, capturing stdout and stderr.
#
# Exactly `agnosai_spawn_capture_input` with an empty input, and defined as that
# call rather than a second copy of the drain loop. The duplicate that stood here
# through bites 5 and 6 had already drifted: it left the child's stdin
# **inherited** from the parent, where the oracle pipes stdin on every spawn it
# makes (`process.rs:109`, `:189`) — a sandboxed tool could have read the
# server's own stdin. One implementation cannot drift from itself.
fn agnosai_spawn_capture(path, argv, envp, timeout_ms, work_dir): i64 {
    return agnosai_spawn_capture_input(path, argv, envp, str_from(""), timeout_ms, work_dir);
}
