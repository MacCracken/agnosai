# =========================================================================
# sandbox/wasm — sandboxed WASM execution.
#
# Origin: rust-old/src/sandbox/wasm.rs
#
# The oracle embeds wasmtime and drives it in-process. This drives the
# `wasmtime` CLI through **kavach's WASM backend**, per
# [ADR 019](../../docs/adr/019-wasm-tools-spawn-wasmtime-directly.md) — which
# means kavach's seccomp and landlock wrap the runtime process, on top of
# wasmtime's own WASI sandbox around the guest.
#
# ⚠ **kavach 3.11.10 is a FLOOR, not a preference**, and it took three releases
# to become one:
#
#   * **3.11.8** — in 3.11.7 the backend was hardcoded unavailable, had no stdin
#     channel, and reported every guest failure as a success with empty stderr.
#   * **3.11.9** — `confine_capture_input`, the stdin/exit-code/stderr fix.
#   * **3.11.10** — `wasmtime run` **rejected kavach's argv outright**:
#     `--max-memory-size` and `--fuel` were emitted as top-level flags where both
#     live in wasmtime's `-W` group. Never a version skew; the spelling was never
#     valid, and `-W` has existed since wasmtime 14.
#
# ⚠ **kavach 3.14.4 is a floor too, for two things this file now leans on (2.2.5).** A capture
# that drains stdout while it writes stdin, so an input of any size cannot hang the caller, and
# `config_wasm_max_instances` and its siblings.
#
# ⚠ **All three survived because nothing had ever run a module.** kavach's two
# WASM tests fail before argv is assembled, and everything here sat behind
# `if (agnosai_wasm_available() == 0)`, which returned early on a box with no
# runtime — so the whole path was dead code that still passed its tests. Three
# mutually-concealing defects, all exposed the day wasmtime was installed
# (2026-08-11), including two of agnosai's own: no `kavach_init` call, and a
# memory ceiling that never reached the runtime. Both are fixed below and both
# have a guard in `tests/sandbox_wasm.tcyr` that fails without them.
#
# ## The five bounds the oracle configures, and where they live now
#
# | bound | oracle | here |
# |---|---|---|
# | memory | `StoreLimitsBuilder::memory_size` | `--max-memory-size`, via kavach |
# | CPU | `store.set_fuel` | `--fuel`, via kavach |
# | wall clock | epoch deadline + ticker thread | `SandboxConfig.timeout_ms` |
# | ambient authority | WASI ctx with only stdin/stdout | no `--dir` preopens, plus seccomp/landlock |
# | what a guest may create | `StoreLimitsBuilder` | `-W max-instances` and friends, via kavach |
#
# ## `load_module` validates, and asks wasmtime (2.3.5)
#
# The oracle's `load_module` hands the bytes to `Module::new`, so a malformed
# module fails at LOAD. The oracle's own tests assert that
# `load_module(b"not valid wasm")` errors with a message naming what was
# *expected*, which is the eight-byte header check.
#
# Through 2.3.4 the header was all, so a module with a broken body failed only at
# `execute`, and a module with no `_start` export ran and **exited 0**, measured:
# wasmtime runs nothing for a module with no entry point and reports success. Now
# a load also walks the sections, requires a `_start` function export (a WASM tool
# is a WASI command), and, where wasmtime is installed, runs `wasmtime compile` on
# the staged file under the process tier's confinement (ADR 031), which is the
# engine's own verdict, the one `Module::new` gave the oracle. About 4 ms a load.
# With no wasmtime, the sections and the export are checked, and execution is
# refused anyway.
#
# ## A staged module goes when its tool does
#
# wasmtime runs a module from a path, so every load stages one, under `$TMPDIR`
# (else `/tmp`). `agnosai_wasm_module_free` unlinks it, and a WASM tool frees its
# module when the last registry holding it lets it go. ⚠ **Not while it runs**: a
# run counts itself in before kavach opens the file and out after, and the file
# goes with whichever of the two is last, the free or the run. A run that starts
# after the free is refused.
#
# ## `wasmtime` is a host requirement
#
# Absent, `agnosai_wasm_available()` answers 0 and `execute` returns a
# `Sandbox` error naming the binary. That is an assertable arm, not a silent
# skip. **wasmtime 47.0.3 is installed here as of 2026-08-11**, so the box now
# takes the other arm and the execute path is exercised for real.
#
# ⚠ `agnosai_wasm_available()` is NOT a readiness check for execution. It asks
# `backend_is_available`, which probes the FILESYSTEM for the binary;
# `backend_dispatch_exec` asks whether a function pointer is registered. They
# answered differently for months — availability 1, next call "backend not
# available: wasm" — because kavach was never initialised from this path.
# =========================================================================
# The shared whole-file reader (2.1.7, roadmap B19); include-once, so this costs nothing
# where `src/main.cyr` already has it.
include "src/read_file.cyr"

# The oracle's four constants, unchanged.
var AGNOSAI_WASM_DEFAULT_MAX_MEMORY_BYTES = 67108864;
var AGNOSAI_WASM_DEFAULT_TIMEOUT_MS = 30000;
var AGNOSAI_WASM_DEFAULT_FUEL = 1000000000;
var AGNOSAI_WASM_STDOUT_CAPACITY = 1048576;

# The oracle's store limits (`wasm.rs`, `StoreLimitsBuilder`): what one guest may create. Past them
# a module is refused at instantiation and never runs. `table_elements` is left to wasmtime, as
# the oracle left it.
var AGNOSAI_WASM_MAX_INSTANCES = 10;
var AGNOSAI_WASM_MAX_TABLES = 10;
var AGNOSAI_WASM_MAX_MEMORIES = 10;

# The oracle's `extract_exit_code` taxonomy, for failures that are not the
# guest's own `proc_exit`.
#
# ⚠ These are NEGATIVE and they are not errno. `-1` is the wall-clock deadline,
# `-2` is fuel exhaustion, `-3` is anything else. A caller matching `!= 0`
# behaves identically either way; a caller that reports the number to a user
# needs them to mean what the oracle's mean.
var AGNOSAI_WASM_EXIT_TIMEOUT = 0 - 1;
var AGNOSAI_WASM_EXIT_FUEL = 0 - 2;
var AGNOSAI_WASM_EXIT_TRAP = 0 - 3;

# The eight-byte WASM header: `\0asm` then a little-endian version of 1.
var AGNOSAI_WASM_HEADER_LEN = 8;

# How long `wasmtime compile` may take to check a module at load. A module a tool can
# afford to run compiles in milliseconds, and one that takes longer is refused.
var AGNOSAI_WASM_CHECK_TIMEOUT_MS = 10000;

# WasmSandbox heap layout — 24 bytes.
enum AgnosaiWasmSandboxOff {
    AGN_WS_MAX_MEMORY_BYTES = 0;
    AGN_WS_TIMEOUT_MS = 8;
    AGN_WS_FUEL = 16;
    AGN_WS_BYTES = 24;
}

# WasmModule heap layout — 16 bytes.
#
# ⚠ Holds a PATH, not a compiled module. `wasmtime run` takes a file, so the
# bytes are written once at load and the path is what `execute` passes. The
# oracle's `WasmModule` wraps a `Module` that was compiled at load; the
# observable difference is *when* a malformed body is rejected, which the header
# note above covers.
# A staged module — 40 bytes. `RUNS` counts executions holding the staged file, `FREED` is set
# once by `agnosai_wasm_module_free`, and `GONE` once the file is unlinked, which happens when
# both say so: freed, and nothing running (2.3.5).
enum AgnosaiWasmModuleOff {
    AGN_WM_PATH = 0;
    AGN_WM_LEN = 8;
    AGN_WM_RUNS = 16;
    AGN_WM_FREED = 24;
    AGN_WM_GONE = 32;
    AGN_WM_BYTES = 40;
}

# WasmResult heap layout — 16 bytes.
enum AgnosaiWasmResultOff {
    AGN_WR_STDOUT = 0;
    AGN_WR_EXIT_CODE = 8;
    AGN_WR_BYTES = 16;
}

# A sandbox with the oracle's default limits.
fn agnosai_wasm_sandbox_new(): i64 {
    return agnosai_wasm_sandbox_with_limits(AGNOSAI_WASM_DEFAULT_MAX_MEMORY_BYTES,
      AGNOSAI_WASM_DEFAULT_TIMEOUT_MS);
}

# A sandbox with explicit memory and wall-clock limits.
#
# ⚠ The fuel budget is NOT a parameter, matching the oracle: `with_limits` takes
# memory and a timeout and leaves `fuel` at its default. `agnosai_wasm_sandbox_set_fuel`
# is the port-local escape hatch — the oracle has no equivalent because it sets
# `store.set_fuel(self.fuel)` on a struct the caller can build field-by-field.
fn agnosai_wasm_sandbox_with_limits(max_memory_bytes, timeout_ms): i64 {
    var s = alloc(AGN_WS_BYTES);
    store64(s + AGN_WS_MAX_MEMORY_BYTES, max_memory_bytes);
    store64(s + AGN_WS_TIMEOUT_MS, timeout_ms);
    store64(s + AGN_WS_FUEL, AGNOSAI_WASM_DEFAULT_FUEL);
    return s;
}

# The sandbox's memory ceiling, in bytes.
fn agnosai_wasm_sandbox_max_memory_bytes(s): i64 {
    return load64(s + AGN_WS_MAX_MEMORY_BYTES);
}

# The sandbox's wall-clock limit, in milliseconds.
fn agnosai_wasm_sandbox_timeout_ms(s): i64 {
    return load64(s + AGN_WS_TIMEOUT_MS);
}

# The sandbox's fuel budget.
#
# ⚠ **Advertised AND enforced since kavach 3.11.11.** Before that this accessor
# reported the oracle's 1e9 while kavach derived its own from the timeout —
# `timeout_ms * 1e6`, 3e10 at the default 30 s — so the guest ran with thirty
# times the CPU bound this claimed. `agnosai_wasm_execute` now sends it through
# `config_fuel`.
fn agnosai_wasm_sandbox_fuel(s): i64 {
    return load64(s + AGN_WS_FUEL);
}

# Set the CPU budget, in wasmtime fuel units. Port-local: the oracle builds the
# struct directly, so it needs no setter.
fn agnosai_wasm_sandbox_set_fuel(s, fuel): i64 {
    store64(s + AGN_WS_FUEL, fuel);
    return s;
}

# Whether a `wasmtime` runtime is present.
#
# ⚠ `backend_is_available`, not a bare `which` — it is what `sandbox_create`
# consults, so a caller that asks this and then executes cannot be told
# different things by the two. Before kavach 3.11.8 this answered a hardcoded 0
# and the two DID disagree.
fn agnosai_wasm_available(): i64 {
    return backend_is_available(KavachBackend.WASM);
}

# Whether `buf` opens with the eight-byte WASM header.
fn _agnosai_wasm_header_ok(buf, len): i64 {
    if (len < AGNOSAI_WASM_HEADER_LEN) { return 0; }
    if (load8(buf) != 0) { return 0; }
    if (load8(buf + 1) != 97) { return 0; }
    if (load8(buf + 2) != 115) { return 0; }
    if (load8(buf + 3) != 109) { return 0; }
    # Version, little-endian u32 = 1.
    if (load8(buf + 4) != 1) { return 0; }
    if (load8(buf + 5) != 0) { return 0; }
    if (load8(buf + 6) != 0) { return 0; }
    if (load8(buf + 7) != 0) { return 0; }
    return 1;
}

# The directory modules are staged in: `$TMPDIR` when it names a directory, else `/tmp`.
# Read once: a process's `TMPDIR` is fixed at its start, and `getenv` copies on every call.
fn agnosai_wasm_stage_dir(): i64 {
    var held = atomic_load(&_AGNOSAI_WASM_STAGE_DIR);
    if (held != 0) { return held; }
    var dir = "/tmp";
    var v = getenv("TMPDIR");
    if (v != 0) {
        if (strlen(v) > 0 && sys_access(v, 0) == 0) { dir = v; }
    }
    atomic_fence();
    atomic_store(&_AGNOSAI_WASM_STAGE_DIR, dir);
    return dir;
}

var _AGNOSAI_WASM_STAGE_DIR = 0;

# A unique path for one module's bytes, in `agnosai_wasm_stage_dir`.
fn _agnosai_wasm_module_path(): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, agnosai_wasm_stage_dir());
    str_builder_add_cstr(sb, "/agnosai-wasm-");
    str_builder_add(sb, agnosai_uuid_v4_str());
    str_builder_add_cstr(sb, ".wasm");
    return str_builder_build(sb);
}

# Read a LEB128 u32 at `buf + load64(at)`, bounded by `end`, into `out`, and move `at` past
# it. Returns 1, or 0 for one that runs past `end` or past five bytes.
fn _agnosai_wasm_leb(buf, end, at, out): i64 {
    var pos = load64(at);
    var v = 0;
    var shift = 0;
    for (var i = 0; i < 5; i = i + 1) {
        if (pos >= end) { return 0; }
        var b = load8(buf + pos) & 255;
        pos = pos + 1;
        v = v | ((b & 127) << shift);
        if ((b & 128) == 0) {
            store64(at, pos);
            store64(out, v);
            return 1;
        }
        shift = shift + 7;
    }
    return 0;
}

# Why `buf` is not a module a WASM tool can run, as a cstring, or 0. The header is checked
# already. Every section's framing must fit, and the exports must name a `_start` function.
#
# The framing is what a truncated or corrupted upload breaks first, and `_start` is what
# makes a module a WASI command: without one wasmtime runs nothing and exits 0, so the tool
# "succeeds" with empty output on every call. Section ids run to 13, the tag section of the
# exception-handling proposal, and a custom section (0) is skipped like any other.
fn _agnosai_wasm_structure_error(buf, len): i64 {
    var at: i64[1];
    var v: i64[1];
    store64(&at, AGNOSAI_WASM_HEADER_LEN);
    var has_start = 0;
    while (load64(&at) < len) {
        var id = load8(buf + load64(&at)) & 255;
        store64(&at, load64(&at) + 1);
        if (id > 13) { return "a section has an id no WebAssembly version defines"; }
        if (_agnosai_wasm_leb(buf, len, &at, &v) == 0) { return "a section's size is cut off"; }
        var start = load64(&at);
        var end = start + load64(&v);
        if (end > len) { return "a section runs past the end of the module"; }
        if (id == 7) {
            var eat: i64[1];
            store64(&eat, start);
            if (_agnosai_wasm_leb(buf, end, &eat, &v) == 0) { return "the export section is malformed"; }
            var count = load64(&v);
            for (var k = 0; k < count; k = k + 1) {
                if (_agnosai_wasm_leb(buf, end, &eat, &v) == 0) { return "the export section is malformed"; }
                var nlen = load64(&v);
                var npos = load64(&eat);
                if (npos + nlen + 1 > end) { return "the export section is malformed"; }
                var kind = load8(buf + npos + nlen) & 255;
                store64(&eat, npos + nlen + 1);
                if (_agnosai_wasm_leb(buf, end, &eat, &v) == 0) { return "the export section is malformed"; }
                if (kind == 0 && nlen == 6) {
                    if (memeq(buf + npos, "_start", 6) == 1) { has_start = 1; }
                }
            }
        }
        store64(&at, end);
    }
    if (has_start == 0) {
        return "no `_start` function export, so wasmtime would run nothing and exit 0";
    }
    return 0;
}

# The wasmtime binary, where kavach's WASM backend looks for it, in its order, or 0.
fn _agnosai_wasm_binary(): i64 {
    if (sys_access("/usr/local/bin/wasmtime", 1) == 0) { return "/usr/local/bin/wasmtime"; }
    if (sys_access("/usr/bin/wasmtime", 1) == 0) { return "/usr/bin/wasmtime"; }
    var home = getenv("HOME");
    if (home == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, home);
    str_builder_add_cstr(sb, "/.cargo/bin/wasmtime");
    var p = str_cstr(str_builder_build(sb));
    if (sys_access(p, 1) == 0) { return p; }
    return 0;
}

# The confinement `wasmtime compile` runs under: the default, plus wasmtime's own directory
# and the stage directory where those are outside its rules. Built once.
fn _agnosai_wasm_check_confinement(bin): i64 {
    var held = atomic_load(&_AGNOSAI_WASM_CHECK_CF);
    if (held != 0) { return held; }
    var cf = agnosai_confinement_default();
    if (cf == 0) { return 0; }
    var bdir = str_from(bin);
    var slash = 0;
    for (var i = 0; i < str_len(bdir); i = i + 1) {
        if (load8(str_data(bdir) + i) == 47) { slash = i; }
    }
    var dir = str_sub(bdir, 0, slash);
    if (_agnosai_wasm_under_base(str_cstr(dir)) == 0) {
        var with_bin = agnosai_confinement_with_path(cf, dir, 0);
        if (with_bin != 0) { cf = with_bin; }
    }
    var stage = agnosai_wasm_stage_dir();
    if (_agnosai_wasm_under_base(stage) == 0) {
        var with_stage = agnosai_confinement_with_path(cf, str_from(stage), 0);
        if (with_stage != 0) { cf = with_stage; }
    }
    atomic_fence();
    atomic_store(&_AGNOSAI_WASM_CHECK_CF, cf);
    return cf;
}

var _AGNOSAI_WASM_CHECK_CF = 0;

# Whether `path` lies under a tree the default confinement already gives.
fn _agnosai_wasm_under_base(path): i64 {
    if (_agnosai_wasm_prefix(path, "/usr/") == 1) { return 1; }
    if (_agnosai_wasm_prefix(path, "/bin") == 1) { return 1; }
    if (_agnosai_wasm_prefix(path, "/tmp") == 1) { return 1; }
    return 0;
}

fn _agnosai_wasm_prefix(s, p): i64 {
    var n = strlen(p);
    if (strlen(s) < n) { return 0; }
    return memeq(s, p, n);
}

# The argv that checks the module at `path`: `wasmtime compile -C cache=n <path> -o /dev/null`, a
# NULL-terminated array of cstrings.
#
# ⚠ **`-C cache=n` is required.** By default wasmtime creates `$HOME/.cache/wasmtime` first, and the
# confinement gives no `$HOME`, so on a host where that directory did not exist yet every module was
# refused: `failed to create cache directory: … Permission denied`. Found in the CI replica, as a fresh
# user, and missed on the development box, where the directory had long existed. Measured on wasmtime
# 47.0.3 and 50.0.1. `-o /dev/null` keeps no artifact, so a cache would save nothing anyway.
fn agnosai_wasm_check_argv(bin, path: Str): i64 {
    var argv = alloc(64);
    store64(argv, bin);
    store64(argv + 8, "compile");
    store64(argv + 16, "-C");
    store64(argv + 24, "cache=n");
    store64(argv + 32, str_cstr(path));
    store64(argv + 40, "-o");
    store64(argv + 48, "/dev/null");
    store64(argv + 56, 0);
    return argv;
}

# wasmtime's verdict on the staged module at `path`, as a Str to report, or 0 when it compiled
# or there is no wasmtime to ask. `wasmtime compile -o /dev/null` validates and compiles and
# keeps nothing, and runs confined, as it parses bytes a caller sent.
fn _agnosai_wasm_engine_error(path: Str): i64 {
    var bin = _agnosai_wasm_binary();
    if (bin == 0) { return 0; }
    var cf = _agnosai_wasm_check_confinement(bin);
    if (cf == 0) { return str_from("wasmtime could not be confined to check it"); }
    var argv = agnosai_wasm_check_argv(bin, path);
    var sp = agnosai_spawn_capture_confined(bin, argv, agnosai_sanitized_envp(), str_from(""),
      AGNOSAI_WASM_CHECK_TIMEOUT_MS, 0, cf);
    if (agnosai_spawn_status(sp) == AGNOSAI_SPAWN_OK && agnosai_spawn_timed_out(sp) == 0) {
        if (agnosai_spawn_exit_code(sp) == 0) { return 0; }
    }
    return _agnosai_wasm_engine_reason(agnosai_spawn_stderr(sp));
}

# wasmtime's error text as one line: `Error: a\n\nCaused by:\n    b` reads `a: b`, cut to 300
# bytes, as it goes into a tool registration's error.
fn _agnosai_wasm_engine_reason(err: Str): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "wasmtime refused it: ");
    var lines = str_split(err, 10);
    var wrote = 0;
    for (var i = 0; i < vec_len(lines); i = i + 1) {
        var line = str_trim(vec_get(lines, i));
        if (str_len(line) == 0) { continue; }
        if (str_eq_cstr(line, "Caused by:") == 1) { continue; }
        if (str_starts_with(line, str_from("Error: ")) == 1) { line = str_sub(line, 7, str_len(line) - 7); }
        if (wrote == 1) { str_builder_add_cstr(sb, ": "); }
        str_builder_add(sb, line);
        wrote = 1;
    }
    if (wrote == 0) { str_builder_add_cstr(sb, "it did not compile"); }
    var out = str_builder_build(sb);
    if (str_len(out) > 300) { out = str_sub(out, 0, 300); }
    return out;
}

# Load a module from raw bytes — the oracle's `load_module`.
#
# Returns 0 with `*out_err` set to a `Sandbox` error.
#
# ⚠ The message names what was **expected**, because the oracle's own test
# asserts `msg.contains("expected")` — it is checking that the caller is told
# the bytes are not WASM rather than merely that something went wrong.
fn agnosai_wasm_load_module(s, buf, len, out_err): i64 {
    if (_agnosai_wasm_header_ok(buf, len) == 0) {
        store64(out_err, agnosai_error_sandbox(str_from(
              "invalid WASM module: expected magic bytes \\0asm and version 1")));
        return 0;
    }
    var why = _agnosai_wasm_structure_error(buf, len);
    if (why != 0) {
        store64(out_err, agnosai_error_sandbox(str_cat(str_from("invalid WASM module: "),
              str_from(why))));
        return 0;
    }

    var path = _agnosai_wasm_module_path();
    if (file_write_all(str_data(path), buf, len) != len) {
        sys_unlink(str_data(path));
        store64(out_err, agnosai_error_sandbox(str_cat(
              str_from("could not stage WASM module at "), path)));
        return 0;
    }
    var refused = _agnosai_wasm_engine_error(path);
    if (refused != 0) {
        sys_unlink(str_data(path));
        store64(out_err, agnosai_error_sandbox(str_cat(str_from("invalid WASM module: "), refused)));
        return 0;
    }

    var m = alloc(AGN_WM_BYTES);
    store64(m + AGN_WM_PATH, path);
    store64(m + AGN_WM_LEN, len);
    store64(m + AGN_WM_RUNS, 0);
    store64(m + AGN_WM_FREED, 0);
    store64(m + AGN_WM_GONE, 0);
    return m;
}

# Load a module from a file — the oracle's `load_module_from_file`.
#
# ⚠ Re-staged through `load_module` rather than handed to `wasmtime` where it
# lies. The header is validated the same way, and a caller cannot make the
# sandbox execute an arbitrary path it did not first prove was a WASM module.
fn agnosai_wasm_load_module_from_file(s, path: Str, out_err): i64 {
    # The shared reader, `src/read_file.cyr` (2.1.7, roadmap B19) — until then this reached
    # into `definitions/loader`'s private one.
    var content = _agnosai_read_file(path, out_err);
    if (content == 0) { return 0; }
    return agnosai_wasm_load_module(s, str_data(content), str_len(content), out_err);
}

# The staged path of a loaded module.
fn agnosai_wasm_module_path(m): Str {
    return load64(m + AGN_WM_PATH);
}

# The module's byte length.
fn agnosai_wasm_module_len(m): i64 {
    return load64(m + AGN_WM_LEN);
}

# Remove a module's staged copy. Every load writes one — wasmtime runs the module
# from a path. Safe to call twice, and from any thread. ⚠ **A run in flight keeps the
# file**: it goes when that run ends (see the module header), and a run that starts
# afterwards is refused. Returns 1 the first time, 0 after.
fn agnosai_wasm_module_free(m): i64 {
    if (m == 0) { return 0; }
    if (atomic_cas(m + AGN_WM_FREED, 0, 1) == 0) { return 0; }
    if (atomic_load(m + AGN_WM_RUNS) == 0) { _agnosai_wasm_module_unlink(m); }
    return 1;
}

# Unlink a module's staged file, once, whoever gets here first.
fn _agnosai_wasm_module_unlink(m): i64 {
    if (atomic_cas(m + AGN_WM_GONE, 0, 1) == 0) { return 0; }
    sys_unlink(str_cstr(load64(m + AGN_WM_PATH)));
    return 1;
}

# Whether `m` has been freed.
fn agnosai_wasm_module_freed(m): i64 {
    return atomic_load(m + AGN_WM_FREED);
}

# Count a run in. 1, or 0 for a freed module, which must not run: its file is going.
fn _agnosai_wasm_module_enter(m): i64 {
    atomic_fetch_add(m + AGN_WM_RUNS, 1);
    if (atomic_load(m + AGN_WM_FREED) == 1) {
        _agnosai_wasm_module_leave(m);
        return 0;
    }
    return 1;
}

# Count a run out, and unlink the file if the module was freed meanwhile and this was its
# last run.
fn _agnosai_wasm_module_leave(m): i64 {
    var left = atomic_fetch_add(m + AGN_WM_RUNS, 0 - 1) - 1;
    if (left == 0 && atomic_load(m + AGN_WM_FREED) == 1) { _agnosai_wasm_module_unlink(m); }
    return 0;
}

# Classify a run that kavach reported — the oracle's `extract_exit_code`.
#
# ⚠ The guest's own exit code wins when it is one. wasmtime surfaces WASI
# `proc_exit(n)` as its own process exit `n`, so a module that exits 3 reports 3
# — the oracle's `I32Exit` arm. Only a run that FAILED without the guest saying
# so gets the negative taxonomy.
#
# ⚠ The distinction between a deadline, exhausted fuel and a plain trap is read
# out of **stderr text**, because a CLI has one exit code and the oracle had a
# typed error chain. Best-effort and recorded as such: `timed_out` from kavach
# is authoritative for the deadline, and the other two are string matches on
# what wasmtime prints.
fn agnosai_wasm_classify_exit(exit_code, timed_out, stderr: Str): i64 {
    if (timed_out == 1) { return AGNOSAI_WASM_EXIT_TIMEOUT; }
    if (exit_code == 0) { return 0; }
    if (agnosai_str_contains_ci_cstr(stderr, "all fuel consumed") == 1) {
        return AGNOSAI_WASM_EXIT_FUEL;
    }
    if (agnosai_str_contains_ci_cstr(stderr, "fuel") == 1) {
        return AGNOSAI_WASM_EXIT_FUEL;
    }
    if (agnosai_str_contains_ci_cstr(stderr, "epoch") == 1) {
        return AGNOSAI_WASM_EXIT_TIMEOUT;
    }
    if (agnosai_str_contains_ci_cstr(stderr, "interrupt") == 1) {
        return AGNOSAI_WASM_EXIT_TIMEOUT;
    }
    # ⚠ A guest's OWN non-zero exit passes through unchanged. Mapping every
    # non-zero code onto -3 would erase `proc_exit(2)`, which the oracle
    # preserves through its `I32Exit` arm.
    if (agnosai_str_contains_ci_cstr(stderr, "wasm trap") == 1) {
        return AGNOSAI_WASM_EXIT_TRAP;
    }
    # `-W trap-on-grow-failure`'s wording, which is not a "wasm trap" and is one.
    if (agnosai_str_contains_ci_cstr(stderr, "forcing trap") == 1) {
        return AGNOSAI_WASM_EXIT_TRAP;
    }
    return exit_code;
}

# Hold a guest to the oracle's store limits, and trap a failed grow. Returns the config.
#
# ⚠ **Blocked on kavach until 3.14.4**, which passed only `max-memory-size` and fuel, so a guest
# could declare as many tables and memories as wasmtime would take. Its trap default is the
# oracle's too, and is stated here so that it is agnosai's decision and not an inherited one.
#
# A core module is one instance, and `agnosai_wasm_load_module` takes nothing else, so no guest
# can reach `max-instances` today. It is set because a component would, and because the limit
# should be there before the module that needs it is.
fn _agnosai_wasm_store_limits(cfg): i64 {
    config_wasm_max_instances(cfg, AGNOSAI_WASM_MAX_INSTANCES);
    config_wasm_max_tables(cfg, AGNOSAI_WASM_MAX_TABLES);
    config_wasm_max_memories(cfg, AGNOSAI_WASM_MAX_MEMORIES);
    config_wasm_trap_on_grow_failure(cfg, 1);
    return cfg;
}

# Build the result the oracle returns.
fn agnosai_wasm_result_new(stdout: Str, exit_code): i64 {
    var r = alloc(AGN_WR_BYTES);
    store64(r + AGN_WR_STDOUT, stdout);
    store64(r + AGN_WR_EXIT_CODE, exit_code);
    return r;
}

# The module's captured stdout.
fn agnosai_wasm_result_stdout(r): Str {
    return load64(r + AGN_WR_STDOUT);
}

# The module's exit code — 0, the guest's own, or the negative taxonomy.
fn agnosai_wasm_result_exit_code(r): i64 {
    return load64(r + AGN_WR_EXIT_CODE);
}

# Execute a loaded module with `input` on its stdin — the oracle's `execute`.
#
# Returns 0 with `*out_err` set; a module that RAN and failed is a successful
# call carrying a non-zero exit code, which is the oracle's shape.
#
# **`input` has no size limit (2.2.5).** 2.2.3 refused anything over 64 KiB, because kavach wrote
# stdin before it drained stdout, so a guest that wrote while it read hung its worker past any
# deadline. Since kavach 3.14.4 stdin goes out from the drain loop, under the deadline. Measured
# here: an echoing guest finishes 200,000 B in 103 ms where it used to hang, and one that reads
# nothing is killed at 307 ms of a 300 ms deadline. Nothing here copies the input, a guest's
# memory is held to its ceiling, and its output to `AGNOSAI_WASM_STDOUT_CAPACITY`.
#
# ⚠ The kavach lifecycle here mirrors `agnosai_kavach_execute`'s
# (`src/sandbox/kavach_bridge.cyr:360`) rather than calling it, because that one
# maps an agnosai isolation level onto a backend and this must pin
# `KavachBackend.WASM` and set `config_stdin`. That is the SECOND instance of the
# create/RUNNING/exec/STOPPED/DESTROYED sequence — CLAUDE.md says extract at the
# third.
fn agnosai_wasm_execute(s, module, input: Str, out_err): i64 {
    # ⚠ **Without this, every call fails with "backend not available: wasm"** —
    # kavach's dispatch table is populated by `kavach_init`, and this function
    # reaches `sandbox_create`/`sandbox_exec` DIRECTLY rather than through
    # `agnosai_kavach_execute`, which is the only other place the lazy
    # initialiser is called (`kavach_bridge.cyr:361`). Two entry points into the
    # same library, one of them initialising it.
    #
    # ⚠ **`agnosai_wasm_available()` does NOT cover this, and that is why it went
    # unnoticed.** `backend_is_available` probes the filesystem for the wasmtime
    # binary; `backend_dispatch_exec` looks for a registered function pointer.
    # They answer different questions, so availability reported 1 while the very
    # next call reported the backend missing.
    #
    # Unreachable until 2026-08-11: with no wasmtime on the box the guard below
    # returned early and nothing downstream ever ran. Installing wasmtime is what
    # exposed it.
    _agnosai_kavach_ensure_init();

    if (module == 0 || load64(module + AGN_WM_PATH) == 0) {
        store64(out_err, agnosai_error_sandbox(str_from("WASM module has been freed")));
        return 0;
    }

    # kavach writes the guest's stdin through a pipe; a guest that exits without
    # reading it makes that write raise SIGPIPE, whose default action kills this
    # process. sandhi's serve loops ignore it, but this must not depend on
    # running under one.
    signal_ignore(Signal.SIGPIPE);

    if (agnosai_wasm_available() == 0) {
        store64(out_err, agnosai_error_sandbox(str_from(
              "wasmtime runtime not found — WASM tool execution is unavailable")));
        return 0;
    }

    var cfg = config_new();
    config_backend(cfg, KavachBackend.WASM);
    config_timeout_ms(cfg, load64(s + AGN_WS_TIMEOUT_MS));

    # ⚠ **The memory ceiling has to travel on a POLICY, and until 2026-08-11 it
    # did not travel at all.** kavach's `_wasm_append_limits` reads
    # `SandboxPolicy_memory_limit_mb(policy)` and emits `-W max-memory-size=` only
    # when it is > 0. `config_new()` installs `policy_basic()`, which leaves that
    # field at 0 — so the guest ran with **no memory bound whatsoever** while
    # `agnosai_wasm_sandbox_max_memory_bytes` cheerfully reported one. A sandbox
    # that advertises a limit it does not enforce is worse than one that admits
    # it has none.
    #
    # It was unobservable until wasmtime was installed: with no runtime,
    # `agnosai_wasm_available()` returned 0 above and nothing downstream ran.
    #
    # ⚠ kavach takes MEGABYTES and the oracle's field is BYTES
    # (`StoreLimitsBuilder::memory_size`, which is bytes). Converting here rather
    # than storing megabytes keeps `agnosai_wasm_sandbox_with_limits`'s signature
    # the oracle's. Integer division truncates, so a sub-megabyte request floors
    # to 0 and would silently mean "unlimited" — clamped to 1 MiB instead.
    var mem_bytes = load64(s + AGN_WS_MAX_MEMORY_BYTES);
    if (mem_bytes > 0) {
        var mem_mb = mem_bytes / 1048576;
        if (mem_mb < 1) { mem_mb = 1; }
        var pol = policy_basic();
        SandboxPolicy_set_memory_limit_mb(pol, mem_mb);
        config_policy(cfg, pol);
    }
    # ⚠ **`str_data`, with its length, and no copy.** This was `str_cstr`, for a reader that was
    # `strlen`-based at the time. kavach's capture has gone by `config_stdin`'s length since
    # 3.11.9, and the copy was a guest's whole input on the no-free bump, every call, which an
    # input of any size cannot afford. kavach does not copy it either, and `input` outlives the
    # `sandbox_exec` below, which is the one thing `config_stdin` asks.
    if (input != 0) { config_stdin(cfg, str_data(input), str_len(input)); }

    # ⚠ **The fuel budget, which never reached wasmtime before kavach 3.11.11.**
    # `agnosai_wasm_sandbox_fuel` reported the oracle's `DEFAULT_FUEL` of 1e9
    # while kavach derived its own from the timeout — `timeout_ms * 1e6`, i.e.
    # **3e10 at the default 30 s, thirty times** the CPU bound the oracle sets
    # with `store.set_fuel(self.fuel)`. An accessor advertising a limit the
    # runtime never saw is worse than no accessor. `config_fuel` was added to
    # kavach for this; agnosai filed it.
    config_fuel(cfg, load64(s + AGN_WS_FUEL));
    _agnosai_wasm_store_limits(cfg);

    var sandbox = sandbox_create(cfg);
    if (sandbox == 0) {
        store64(out_err, agnosai_error_sandbox(str_from("kavach create failed")));
        return 0;
    }
    if (sandbox_transition(sandbox, SandboxState.RUNNING) != KAVACH_ERR_OK) {
        sandbox_destroy(sandbox);
        store64(out_err, agnosai_error_sandbox(str_from("kavach start failed")));
        return 0;
    }

    # Counted in for as long as kavach has the file, which is the exec. A freed module does not
    # run: its file is going.
    if (_agnosai_wasm_module_enter(module) == 0) {
        sandbox_transition(sandbox, SandboxState.STOPPED);
        sandbox_transition(sandbox, SandboxState.DESTROYED);
        store64(out_err, agnosai_error_sandbox(str_from("WASM module was freed: its tool was removed")));
        return 0;
    }
    var result = sandbox_exec(sandbox, str_data(load64(module + AGN_WM_PATH)));
    _agnosai_wasm_module_leave(module);

    sandbox_transition(sandbox, SandboxState.STOPPED);
    sandbox_transition(sandbox, SandboxState.DESTROYED);

    if (result == 0) {
        store64(out_err, agnosai_error_sandbox(str_from("kavach exec failed")));
        return 0;
    }

    # A module over a store limit never ran, so it is an error and not an exit code, as it is
    # in the oracle, where `instantiate` fails. The text is fixed: stderr is not repeated.
    var stderr = str_from(ExecResult_stderr(result));
    if (ExecResult_exit_code(result) != 0
      && agnosai_str_contains_ci_cstr(stderr, "resource limit exceeded") == 1) {
        store64(out_err, agnosai_error_sandbox(str_from(
              "WASM module refused: it exceeds the store limits on instances, tables and memories")));
        return 0;
    }

    return agnosai_wasm_result_new(str_from(ExecResult_stdout(result)),
      agnosai_wasm_classify_exit(ExecResult_exit_code(result),
        ExecResult_timed_out(result), stderr));
}
