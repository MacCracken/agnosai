# =========================================================================
# server/serve — the sandhi adapter: the first `sandhi_server_*` call site.
#
# Parity oracle: rust-old/src/main.rs's `axum::serve` + the layers
#                rust-old/src/server/mod.rs installs.
#
# **Bite 15b.** `server_router` decides; this connects that decision to a
# socket. Four things land here together, because splitting them would leave
# the arena unproven:
#
#   1. blocker #3's per-request arena, with `_a` on every sandhi call;
#   2. the allocation measurement that says what the arena actually bought;
#   3. the a2a callback dispatch `server_routes_a2a` left to this bite;
#   4. the decision on whether to mount `rate_limit`.
#
# ## The arena covers sandhi's half, and bayan's half is still on the bump
#
# Blocker #3's mitigation is "write our own handler on the raw
# `fn(ctx, cfd, buf, blen)` signature, take a per-worker arena, and use the `_a`
# variants **everywhere**". This does that: `_get_method_a`, `_get_path_a`,
# `_find_header_a`, `_send_response_a`, `_send_status_a` — every sandhi call in
# the request path is allocator-threaded, and sandhi's worker rewinds the arena
# before the next request, so that half costs nothing per request.
#
# **It does not make `alloc_used()` flat, and claiming so would be false.**
# `bayan_json_v_parse_buf` and `bayan_json_v_build` thread no allocator and
# bayan exposes **no `_a` variants for either** (verified: zero matches for
# `^fn bayan_json_v_(parse_buf_a|build_a)\(` in `lib/bayan.cyr`). Every handler
# that reads a request body or builds a JSON response therefore still grows the
# no-free global bump, and the arena cannot reach it.
#
# So the honest statement is: **the transport is flat; the handlers are not.**
# `tests/server_serve.tcyr` measures both halves separately rather than
# asserting a single number, and the residual is bayan's to fix — an `_a` parse
# and build API is the filing that closes it.
#
# ## `rate_limit` is NOT mounted — matching the oracle
#
# `mod.rs:47-99` never installs `rate_limit_middleware`, and this does not
# either. The temptation is real (`auth_jwt_verify_ok` is 3.3 ms, so a core
# sustains ~300 JWT verifies/second, and the `alg` check sits after the
# signature so a malformed token costs the same), but mounting it would be a
# **wire divergence with no ADR** — clients that are fine today would start
# seeing 429s at a threshold agnosai invented.
#
# `agnosai_serve_with_rate_limit` exists so an operator can opt in explicitly,
# and it is tested; the default path matches the oracle. Turning it on by
# default is a decision for whoever sets a rate, recorded in
# docs/development/state.md.
# =========================================================================

# Per-worker request arena. Sized for the largest thing sandhi puts in it: the
# request line, the header scan, and one response write. 64 KiB is generous
# against sandhi's own 64 KiB default request cap.
var AGNOSAI_SERVE_ARENA_BYTES = 65536;

# Worker count. The oracle's `ConcurrencyLimitLayer(100)` queues above its
# limit; sandhi's pool bounds work in flight instead and does not queue, so the
# number is carried across as a pool size rather than as an equivalent — see
# `AGNOSAI_MAX_CONCURRENT_REQUESTS` in `server_router`.
var AGNOSAI_SERVE_WORKERS = 100;

# The optional rate limiter, and the state, as process globals.
#
# sandhi's handler signature is `fn(ctx, cfd, buf, blen)` with a single opaque
# `ctx`, and the handler needs three things. Rather than box them into a tuple
# only this file understands, they are module globals set once by
# `agnosai_serve` before any worker exists — the same shape
# `agnosai_metrics_global` uses, and for the same reason.
var _agnosai_serve_state = 0;
var _agnosai_serve_limiter = 0;

# --- Method mapping -------------------------------------------------------

# sandhi's method string to the router's enum. Anything else is 405 — the
# router's table has no entry for it, and `agnosai_route_resolve` will not
# report a mismatch for a method it cannot name, so this maps unknown verbs to
# a value no route registers.
fn _agnosai_serve_method(m): i64 {
    if (m == 0) { return 0; }
    if (streq(m, "GET") == 1) { return AGNOSAI_METHOD_GET; }
    if (streq(m, "POST") == 1) { return AGNOSAI_METHOD_POST; }
    if (streq(m, "DELETE") == 1) { return AGNOSAI_METHOD_DELETE; }
    return 0;
}

# --- The a2a callback, carried over from bite 12 --------------------------

# The callback URL a request body asks for, **if and only if** it passes the
# SSRF gate. 0 otherwise — including when the body names no callback.
#
# Composed from pieces `server_routes_a2a` already ports and tests rather than
# re-deriving: the reader, then `agnosai_route_a2a_callback_allowed`. A rejected
# URL answers 0 here exactly as it is skipped there, so the gate has one
# implementation and one set of tests.
fn agnosai_serve_callback_url(body: Str): i64 {
    var v = bayan_json_v_parse_buf(str_data(body), str_len(body));
    if (v == 0) { return 0; }
    var req = agnosai_a2a_req_from_value(v);
    if (req == 0) { return 0; }
    var url = agnosai_a2a_req_callback_url(req);
    if (url == 0) { return 0; }
    if (agnosai_route_a2a_callback_allowed(url) == 0) { return 0; }
    return url;
}

# The oracle's 30-second `tokio::time::timeout` on the callback POST.
var AGNOSAI_SERVE_CALLBACK_TIMEOUT_MS = 30000;

# A pending callback: the URL and the body to POST. Heap-allocated because the
# thread outlives the handler frame.
enum AgnosaiCallbackOff {
    AGN_CB_URL = 0;
    AGN_CB_BODY = 8;
    AGN_CALLBACK_SIZE = 16;
}

# The thread body. **Fire and forget**: the result is discarded, matching the
# oracle, which logs a failure or a timeout and changes nothing — the response
# went out long before.
#
# One OS thread per callback, which is the oracle's `tokio::spawn` shape but a
# heavier unit. Acceptable because a callback fires once per *delegation*, not
# per request; if A2A traffic ever makes that wrong, the fix is a bounded
# dispatch queue, not an inline POST — an inline POST would put a 30-second
# timeout on the response path.
fn _agnosai_serve_callback_thread(cb): i64 {
    var arena = arena_allocator(AGNOSAI_SERVE_ARENA_BYTES);
    if (arena == 0) { return 0; }
    var opts = sandhi_http_options_new();
    agnosai_guarded_fetch(arena, str_from("POST"), load64(cb + AGN_CB_URL),
    0, opts, AGNOSAI_SERVE_CALLBACK_TIMEOUT_MS);
    reset_via(arena);
    return 0;
}

# Dispatch a callback if the body asked for one and it passed the gate.
fn agnosai_serve_dispatch_callback(body: Str): i64 {
    var url = agnosai_serve_callback_url(body);
    if (url == 0) { return 0; }
    var cb = alloc(AGN_CALLBACK_SIZE);
    store64(cb + AGN_CB_URL, url);
    store64(cb + AGN_CB_BODY, body);
    thread_create(&_agnosai_serve_callback_thread, cb);
    return 1;
}

# --- The handler ----------------------------------------------------------

# sandhi's `fn(ctx, cfd, buf, blen)`.
#
# Every sandhi call below is the `_a` form against the worker's per-request
# arena (blocker #3). `sandhi_server_request_arena()` answers 0 under `run` /
# `run_async`, which have no worker to own one; the bare forms are the fallback
# so this handler still works if it is ever mounted on a non-pooled server.
fn agnosai_serve_handler(ctx, cfd, buf, blen): i64 {
    var a = sandhi_server_request_arena();

    var method_s = 0;
    var path_s = 0;
    var auth = 0;
    if (a != 0) {
        method_s = sandhi_server_get_method_a(a, buf, blen);
        path_s = sandhi_server_get_path_a(a, buf, blen);
        auth = sandhi_server_find_header_a(a, buf, blen, "Authorization");
    } else {
        method_s = sandhi_server_get_method(buf, blen);
        path_s = sandhi_server_get_path(buf, blen);
        auth = sandhi_server_find_header(buf, blen, "Authorization");
    }

    # **sandhi's accessors return NUL-terminated cstrings, not `Str`.** Passing
    # one straight through reads its pointer as a Str header: the method compare
    # silently answers "no method" and `str_len(path)` returns garbage, so every
    # request 404s or faults. `str_from_a` wraps without copying the bytes.
    var method = _agnosai_serve_method(method_s);
    var path = str_from("/");
    if (path_s != 0) {
        if (a != 0) { path = str_from_a(a, path_s); } else { path = str_from(path_s); }
    }

    # The body Str is a {ptr,len} over sandhi's request buffer — no copy of the
    # bytes either way, and with the arena the descriptor lands there too.
    var body = str_from("");
    var off = sandhi_server_body_offset(buf, blen);
    if (off > 0 && off < blen) {
        if (a != 0) {
            body = str_new_a(a, buf + off, blen - off);
        } else {
            body = str_new(buf + off, blen - off);
        }
    }

    # `find_header` returns 0 when the header is absent, and the empty cstring
    # for `Authorization:` with no value. Both answer 401, so collapsing them
    # would not change the wire — but they log different audit reasons
    # ("missing authorization header" vs "malformed or empty bearer token"),
    # and the audit trail is the reason to keep them apart.
    var has_auth = 0;
    var auth_str = str_from("");
    if (auth != 0) {
        has_auth = 1;
        if (a != 0) { auth_str = str_from_a(a, auth); } else { auth_str = str_from(auth); }
    }

    # Rate limiting runs before routing when it is mounted, matching where a
    # tower layer would sit. Off by default — see the module header.
    if (_agnosai_serve_limiter != 0) {
        var key = agnosai_rate_limit_client_key(str_from(""), 0, str_from(""), 0);
        if (agnosai_rate_limit_check_request(_agnosai_serve_limiter, key) != HTTP_OK) {
            _agnosai_serve_send_status(a, cfd, AGNOSAI_HTTP_TOO_MANY_REQUESTS,
            "Too Many Requests");
            return 0;
        }
    }

    var resp = agnosai_route_dispatch(_agnosai_serve_state, method, path,
    auth_str, has_auth, body);

    # The a2a callback, on the success path only — the oracle spawns it inside
    # the `Ok(crew_state)` arm.
    if (method == AGNOSAI_METHOD_POST && agnosai_route_status(resp) == HTTP_OK) {
        if (str_eq_cstr(path, "/api/v1/a2a/receive") == 1) {
            agnosai_serve_dispatch_callback(body);
        }
    }

    _agnosai_serve_send(a, cfd, resp);
    return 0;
}

# Write a response, `_a` where the arena exists.
fn _agnosai_serve_send(a, cfd, resp): i64 {
    var status = agnosai_route_status(resp);
    var body = agnosai_route_body(resp);

    # 204 carries no body and no content type.
    if (status == HTTP_NO_CONTENT) {
        return _agnosai_serve_send_status(a, cfd, status, "No Content");
    }

    var text = str_from("");
    var ctype = "application/json";
    if (agnosai_route_is_text(resp) == 1) {
        text = body;
        ctype = "text/plain; version=0.0.4";
    } else {
        if (body != 0 && bayan_json_v_is_null(body) == 0) {
            text = bayan_json_v_build(body);
        }
    }

    if (a != 0) {
        return sandhi_server_send_response_a(a, cfd, status,
        _agnosai_serve_reason(status), ctype, str_data(text), str_len(text), 0);
    }
    return sandhi_server_send_response(cfd, status, _agnosai_serve_reason(status),
    ctype, str_data(text), str_len(text), 0);
}

fn _agnosai_serve_send_status(a, cfd, code, msg): i64 {
    if (a != 0) { return sandhi_server_send_status_a(a, cfd, code, msg); }
    return sandhi_server_send_status(cfd, code, msg);
}

# The reason phrase for each status this server emits.
fn _agnosai_serve_reason(status): i64 {
    if (status == HTTP_OK) { return "OK"; }
    if (status == AGNOSAI_HTTP_CREATED) { return "Created"; }
    if (status == HTTP_NO_CONTENT) { return "No Content"; }
    if (status == HTTP_BAD_REQUEST) { return "Bad Request"; }
    if (status == HTTP_UNAUTHORIZED) { return "Unauthorized"; }
    if (status == HTTP_NOT_FOUND) { return "Not Found"; }
    if (status == HTTP_METHOD_NOT_ALLOWED) { return "Method Not Allowed"; }
    if (status == HTTP_PAYLOAD_TOO_LARGE) { return "Payload Too Large"; }
    if (status == AGNOSAI_HTTP_UNPROCESSABLE) { return "Unprocessable Entity"; }
    if (status == AGNOSAI_HTTP_TOO_MANY_REQUESTS) { return "Too Many Requests"; }
    if (status == HTTP_NOT_IMPLEMENTED) { return "Not Implemented"; }  #skip-lint: status
    return "Internal Server Error";
}

# --- Entry points ---------------------------------------------------------

# Build the sandhi options this server runs with.
#
# **`req_arena` is the blocker #3 setting** and is the reason this is not
# `sandhi_server_options_new()` alone. `max_request` is the oracle's 10 MiB body
# limit pushed down to sandhi, so an oversized request is refused by the
# transport with a 413 rather than being read into memory and then rejected by
# the router — the router's own check stays as the second line, for the
# non-pooled path and for a body that arrives within the cap but over the
# limit after decoding.
fn agnosai_serve_options(): i64 {
    var o = sandhi_server_options_new();
    sandhi_server_options_req_arena(o, AGNOSAI_SERVE_ARENA_BYTES);
    sandhi_server_options_max_request(o, AGNOSAI_MAX_BODY_BYTES);
    sandhi_server_options_max_conns(o, AGNOSAI_SERVE_WORKERS);
    return o;
}

# Install `state` and `limiter` as the handler's process-wide context and
# return the options the listener will run under.
#
# Split out of the two entry points because everything except `run_pooled`
# itself is testable, and because mounting is where the rate-limit decision
# actually lives: `limiter` 0 is the oracle's behaviour, non-zero is opt-in.
fn agnosai_serve_mount(state, limiter): i64 {
    _agnosai_serve_state = state;
    _agnosai_serve_limiter = limiter;
    agnosai_metrics_global();
    return agnosai_serve_options();
}

# Serve `state` on `addr:port` forever. Returns 1 on a bind/listen failure, and
# — since sandhi 1.9.8 — also on a structurally dead listener or after 200
# consecutive resource failures, where earlier versions never returned once
# listening. A caller must treat a return as fatal rather than as a loop exit.
fn agnosai_serve(state, addr, port): i64 {
    return sandhi_server_run_pooled(addr, port, &agnosai_serve_handler, 0,
    agnosai_serve_mount(state, 0));
}

# The same, with rate limiting mounted. **Opt-in**: the oracle does not install
# the middleware, so turning it on is a wire change — clients that are fine
# today would start seeing 429s at a threshold agnosai chose.
fn agnosai_serve_with_rate_limit(state, addr, port, rate_x1000, burst): i64 {
    return sandhi_server_run_pooled(addr, port, &agnosai_serve_handler, 0,
    agnosai_serve_mount(state, agnosai_rate_limit_new(rate_x1000, burst)));
}
