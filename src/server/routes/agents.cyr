# =========================================================================
# server/routes/agents — agent-definition listing and creation.
#
# Parity oracle: rust-old/src/server/routes/agents.rs
#
# The first real consumer of `server_state`'s `definitions` map.
#
# ## These handlers own their own deserialization, and that is the point
#
# The rest of the routes tier takes already-parsed inputs, because axum's
# extractors run before the handler and the handler only sees a `T`. Here the
# extractor **is** part of the observable contract: three of the oracle's five
# tests assert the status of a body that never reaches the handler at all —
# `Json<AgentDefinition>` rejects malformed JSON with 400/422 and a
# missing-required-field body with 422, and the handler is never entered.
#
# So `agnosai_route_create_definition` takes the **raw body** and owns the whole
# status contract. Splitting it the other way would have left the port's most
# commonly hit failure paths untestable until the transport bite.
# =========================================================================

# `GET /api/v1/agents/definitions` — every stored definition, serialized.
#
# The oracle's `.filter_map(|entry| serde_json::to_value(..).ok())` **drops** an
# entry that fails to serialize rather than failing the request.
#
# **The skip below is unreachable here, and is kept deliberately.**
# `agnosai_agent_to_value` (`src/core/agent.cyr:234`) has no failure path — it
# builds an object unconditionally and always returns it — where serde's
# `to_value` genuinely can fail. So the guard cannot fire today, and no test
# reaches it; a mutation that deletes it passes the whole suite. It stays
# because it is the oracle's shape and because it is the one line that would
# matter if `to_value` ever grows a failure arm, but it should not be mistaken
# for a mechanism that runs. Same judgement as the oracle's own unreachable
# `exp.is_none()` guard at `auth.rs:143-146`.
#
# Empty answers `[]`, not `null`; the oracle's `Vec` serializes to an empty
# array and the oracle has a dedicated test for it.
fn agnosai_route_list_definitions(state): i64 {
    var defs = agnosai_app_state_definitions(state);
    var arr = bayan_json_v_arr_new();
    for (var i = 0; i < vec_len(defs); i = i + 1) {
        var v = agnosai_agent_to_value(vec_get(defs, i));
        if (v != 0) { bayan_json_v_arr_push(arr, v); }
    }
    return agnosai_route_json(HTTP_OK, arr);
}

# `POST /api/v1/agents/definitions` — store a definition, echoing it back.
#
# Status contract, all four arms of it:
#
# * **400** — the body is not JSON at all. axum's `Json` extractor answers
#   400 or 422 here and the oracle's test accepts either; 400 is the more
#   precise of the two for a syntax error, and it is what
#   `create_definition_with_malformed_json_returns_error` allows.
# * **422** — valid JSON, but not an `AgentDefinition`: a missing
#   `agent_key` / `name` / `role` / `goal`, or one of them not a string. This
#   is serde's `UNPROCESSABLE_ENTITY`, and it covers both
#   `create_definition_rejects_invalid_body` (`{"not":"valid"}`) and
#   `create_definition_missing_required_fields_returns_422`.
#   `agnosai_agent_from_value` already gates on exactly serde's required set,
#   so the two agree by construction rather than by a second list kept in sync.
# * **500** — the oracle's `serde_json::to_value(&def)` failure arm. Kept
#   because it is in the oracle's signature, though it is unreachable here for
#   the same reason it is unreachable there: a value that just deserialized
#   re-serializes.
# * **201** with the serialized definition as the body.
#
# **The response is built before the insert**, matching the oracle, which
# computes `value` first and only then moves `def` into the map. That ordering
# is what makes the 500 arm meaningful: a definition that cannot be serialized
# is never stored.
fn agnosai_route_create_definition(state, body: Str): i64 {
    var v = bayan_json_v_parse_buf(str_data(body), str_len(body));
    if (v == 0) {
        return agnosai_route_error(HTTP_BAD_REQUEST, str_from("malformed JSON body"));
    }

    var def = agnosai_agent_from_value(v);
    if (def == 0) {
        return agnosai_route_error(AGNOSAI_HTTP_UNPROCESSABLE,
        str_from("body is not a valid agent definition"));
    }

    var value = agnosai_agent_to_value(def);
    if (value == 0) {
        return agnosai_route_error(HTTP_INTERNAL, str_from("serialization failed"));
    }

    agnosai_app_state_definition_insert(state, agnosai_agent_key(def), def);
    return agnosai_route_json(AGNOSAI_HTTP_CREATED, value);
}
