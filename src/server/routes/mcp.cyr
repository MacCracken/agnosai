# =========================================================================
# server/routes/mcp — Model Context Protocol over JSON-RPC 2.0.
#
# Origin: rust-old/src/server/routes/mcp.rs
#
# The last of the pure handlers. Three methods — `initialize`, `tools/list`,
# `tools/call` — plus a `-32601` fall-through, every arm answered **HTTP 200**
# with a JSON-RPC envelope; JSON-RPC carries its own errors in the body.
#
# ## The envelope is built here, not delegated to bote
#
# The oracle uses `bote::protocol::{JsonRpcRequest, JsonRpcResponse}` and
# `bote::registry::{ToolDef, ToolSchema}` **as types only** — it never calls
# bote's dispatcher, and says so at `mcp.rs:3-5` ("bote's sync Dispatcher is not
# used here"). This port builds the same wire shapes directly, for a reason the
# Cyrius side makes sharper: `lib/bote-core.cyr`'s `dispatcher_dispatch`
# (`:1713`) hardcodes `"serverInfo":{"name":"bote"` in `_build_initialize_result`,
# where the oracle emits `"name":"agnosai"`. Delegating would change the wire.
#
# The shapes are transcribed from the **Rust** bote 0.91.0 the oracle pins
# (`~/.cargo/registry/.../bote-0.91.0/src/protocol.rs`), not from the Cyrius
# bundle, because the oracle's wire format is whatever serde emits there:
#
#   JsonRpcResponse { jsonrpc: String, id: Value,
#                     result: Option<Value>  #[skip_serializing_if none],
#                     error:  Option<JsonRpcError> #[skip_serializing_if none] }
#   JsonRpcError    { code: i32, message: String,
#                     data: Option<Value> #[skip_serializing_if none] }
#   ToolSchema      { #[serde(rename="type")] schema_type, properties, required }
#
# So a success carries `result` and **omits** `error`, an error carries `error`
# and **omits** `result`, and `data` is omitted throughout — the oracle never
# sets it. `id` is required on both, even on an error.
#
# **What this does NOT mean is that the bote pin is dead weight.** bote *is* the
# MCP layer — `dist/bote-core.cyr` ships the protocol, registry, dispatcher,
# schema validation, and 18 `prompt_*` + 15 `resource_*` fns. This route answers
# the three methods the oracle answers (`initialize`, `tools/list`,
# `tools/call`), all answered here — and MCP's prompts, resources and
# subscriptions are the obvious next surface for an agent orchestrator, all of
# them already sitting in the pinned bundle. The correct reading of "zero bote
# symbols called today" is that this route is a **thin slice of MCP**, not that
# the protocol library is unnecessary.
#
# The one thing that must not be delegated is `dispatcher_dispatch`: verified at
# `lib/bote-core.cyr:1559`, `_build_initialize_result` hardcodes
# `"serverInfo":{"name":"bote"` where the oracle emits `"name":"agnosai"`. That
# is a single-site wire divergence. **Filed and shipped: bote 3.3.0 adds
# `dispatcher_set_server_info(d, name, version)`**, so the hardcode is no longer
# a permanent reason to hand-roll — it becomes a one-line call whenever this
# route grows past the oracle's three methods.
#
# **Today it should still NOT delegate**, and that is a choice, not inertia: the
# oracle uses bote's protocol *types* while explicitly declining its Dispatcher
# (`mcp.rs:3-5`, "agnosai tools require async execution"). Matching the oracle
# means building the envelope here. The 3.3.0 fix removes the blocker for the
# surface that comes after — MCP prompts and resources, which bote already
# ships (18 + 15 fns in the pinned core bundle).
#
# ## Two eras on one endpoint (2.6.0, ADR 039)
#
# MCP 2026-07-28 has no `initialize` and no session: every request names its
# revision, in `params._meta` and in the `MCP-Protocol-Version` header, and
# carries the client's capabilities, and a POST says its method and the name it
# acts on in `Mcp-Method` and `Mcp-Name`, which the server compares with the
# body. `/mcp` serves it and the revision it spoke before, 2025-03-26, on one
# endpoint, deciding per request as bote's `src/http_era.cyr` does: a request
# that names 2026-07-28 is served under it; one with no header, or naming
# 2025-03-26, is served as it always was, byte for byte. The rules are followed
# here by hand, not delegated: bote's era layer is in its full bundle, not the
# core one this pins, and answers on the socket itself, where this route's
# answer goes through the serve layer's auth, limits, metrics and arena.
# =========================================================================

include "src/http_headers.cyr"

# The MCP protocol revision the oracle advertises (`mcp.rs:69`). A literal
# there and a literal here — it is a wire constant, not a capability check.
var AGNOSAI_MCP_PROTOCOL_VERSION = "2025-03-26";

# JSON-RPC 2.0 reserved error codes, the two the oracle uses.
var AGNOSAI_MCP_METHOD_NOT_FOUND = 0 - 32601;
var AGNOSAI_MCP_INVALID_PARAMS = 0 - 32602;

# The MCP wire vocabulary, minted once at startup. See the banner in
# `core/json.cyr` for the measurement and the rule; `routes/mod.cyr` carries the
# few this file shares with the rest of the tier.
#
# **The envelope is the reason this file has the most of them.** Every MCP reply
# — success or error, every method — is wrapped in `{jsonrpc, id, result}`, so
# those three keys and the `"2.0"` value are four allocations on the route's
# unconditional path. The list handlers add per-item ones on top: `tools/list`
# builds a name, description and inputSchema per registered tool, `prompts/list`
# the same per agent definition.
#
# The JSON-RPC *messages* stay inline, like the rest of the tier's error arms.
var AGN_JK_JSONRPC = str_from("jsonrpc");
var AGN_JV_JSONRPC_20 = str_from("2.0");
var AGN_JK_CODE = str_from("code");
var AGN_JK_TYPE = str_from("type");
var AGN_JK_TEXT = str_from("text");
var AGN_JV_TEXT = AGN_JK_TEXT;
var AGN_JK_CONTENT = str_from("content");
var AGN_JK_IS_ERROR = str_from("isError");
var AGN_JV_AGNOSAI = str_from("agnosai");
var AGN_JK_VERSION = str_from("version");
var AGN_JK_TOOLS = str_from("tools");
var AGN_JK_PROMPTS = str_from("prompts");
var AGN_JK_RESOURCES = str_from("resources");
var AGN_JK_PROTOCOL_VERSION = str_from("protocolVersion");
var AGN_JK_SERVER_INFO = str_from("serverInfo");
var AGN_JK_CAPABILITIES = str_from("capabilities");
var AGN_JV_OBJECT = str_from("object");
var AGN_JK_PROPERTIES = str_from("properties");
var AGN_JK_REQUIRED = str_from("required");
var AGN_JK_INPUT_SCHEMA = str_from("inputSchema");
var AGN_JK_ARGUMENTS = str_from("arguments");
var AGN_JV_ARG_DESC = str_from("What this agent should be asked to do");
var AGN_JV_USER = str_from("user");
var AGN_JK_MESSAGES = str_from("messages");
var AGN_JK_URI = str_from("uri");
var AGN_JK_MIME_TYPE = str_from("mimeType");
var AGN_JV_APPLICATION_JSON = str_from("application/json");
var AGN_JK_CONTENTS = str_from("contents");
# 2026-07-28's (2.6.0).
var AGN_JK_META = str_from("_meta");
var AGN_JK_RESULT_TYPE = str_from("resultType");
var AGN_JV_COMPLETE = str_from("complete");
var AGN_JK_TTL_MS = str_from("ttlMs");
var AGN_JK_CACHE_SCOPE = str_from("cacheScope");
var AGN_JV_PRIVATE = str_from("private");
var AGN_JK_SUPPORTED_VERSIONS = str_from("supportedVersions");
var AGN_JK_SUPPORTED = str_from("supported");
var AGN_JK_REQUESTED = str_from("requested");
var AGN_JK_DATA = str_from("data");
var AGN_JK_MCP_SERVER_INFO = str_from("io.modelcontextprotocol/serverInfo");

# --- MCP 2026-07-28 (2.6.0, ADR 039) ---------------------------------------

# The revision with no `initialize`, which a request names to be served under it.
var AGNOSAI_MCP_MODERN_VERSION = "2026-07-28";

# The `_meta` keys every 2026-07-28 request carries.
var AGNOSAI_MCP_META_VERSION = "io.modelcontextprotocol/protocolVersion";
var AGNOSAI_MCP_META_CAPS = "io.modelcontextprotocol/clientCapabilities";

# 2026-07-28's error codes this route sends: a header that is missing, malformed or says other than
# the body (HTTP 400), and a revision it does not speak (HTTP 400, naming the ones it does).
var AGNOSAI_MCP_HEADER_MISMATCH = 0 - 32020;
var AGNOSAI_MCP_UNSUPPORTED_VERSION = 0 - 32022;
var AGNOSAI_MCP_PARSE_ERROR = 0 - 32700;
var AGNOSAI_MCP_INVALID_REQUEST = 0 - 32600;

# How long a client may keep `server/discover`'s answer. It changes only with the process; a
# minute keeps a client that polls it off the endpoint without outliving an upgrade by long.
var AGNOSAI_MCP_DISCOVER_TTL_MS = 60000;

# --- Envelope -------------------------------------------------------------

# `JsonRpcResponse::success` — `result` present, `error` omitted.
fn _agnosai_mcp_success(a, id, result): i64 {
    var o = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, o, AGN_JK_JSONRPC, bayan_json_v_str_new_a(a, AGN_JV_JSONRPC_20));
    bayan_json_v_obj_set_a(a, o, AGN_JK_ID, id);
    bayan_json_v_obj_set_a(a, o, AGN_JK_RESULT, result);
    return o;
}

# `JsonRpcResponse::error` — `error` present, `result` omitted, `data` omitted.
fn _agnosai_mcp_error(a, id, code, message: Str): i64 {
    var e = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, e, AGN_JK_CODE, bayan_json_v_int_new_a(a, code));
    bayan_json_v_obj_set_a(a, e, AGN_JK_MESSAGE, bayan_json_v_str_new_a(a, message));

    var o = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, o, AGN_JK_JSONRPC, bayan_json_v_str_new_a(a, AGN_JV_JSONRPC_20));
    bayan_json_v_obj_set_a(a, o, AGN_JK_ID, id);
    bayan_json_v_obj_set_a(a, o, AGN_JK_ERROR, e);
    return o;
}

# `_agnosai_mcp_error` with `data`, which only 2026-07-28's errors carry.
fn _agnosai_mcp_error_data(a, id, code, message: Str, data): i64 {
    var o = _agnosai_mcp_error(a, id, code, message);
    bayan_json_v_obj_set_a(a, bayan_json_v_obj_get_by_cstr(o, "error"), AGN_JK_DATA, data);
    return o;
}

# The MCP `content` payload every `tools/call` outcome uses — including the
# failures, which are JSON-RPC **successes** carrying `isError: true`.
fn _agnosai_mcp_content(a, text: Str, is_error): i64 {
    var item = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, item, AGN_JK_TYPE, bayan_json_v_str_new_a(a, AGN_JV_TEXT));
    bayan_json_v_obj_set_a(a, item, AGN_JK_TEXT, bayan_json_v_str_new_a(a, text));
    var arr = bayan_json_v_arr_new_a(a);
    bayan_json_v_arr_push_a(a, arr, item);

    var o = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, o, AGN_JK_CONTENT, arr);
    bayan_json_v_obj_set_a(a, o, AGN_JK_IS_ERROR, bayan_json_v_bool_new_a(a, is_error));
    return o;
}

# --- initialize -----------------------------------------------------------

# The server's `Implementation`: `"agnosai"`, NOT bote's `"bote"` — the reason this module does not
# delegate. See the header.
fn _agnosai_mcp_server_info(a): i64 {
    var info = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, info, AGN_JK_NAME, bayan_json_v_str_new_a(a, AGN_JV_AGNOSAI));
    bayan_json_v_obj_set_a(a, info, AGN_JK_VERSION,
      bayan_json_v_str_new_a(a, str_from_a(a, AGNOSAI_VERSION)));
    return info;
}

# What the server can do, in either era: `tools`, `prompts` and `resources`, each an empty object.
fn _agnosai_mcp_capabilities(a): i64 {
    # `"capabilities": {"tools": {}}` — an empty object, not null and not
    # absent. A client reads the presence of the `tools` key as the capability.
    var caps = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, caps, AGN_JK_TOOLS, bayan_json_v_obj_new_a(a));
    # `prompts` on the same terms as `resources` below: advertised because it is
    # answered. `listChanged` is deliberately absent — definitions can be added
    # by `POST /api/v1/agents/definitions` at any time and nothing here can push
    # a `notifications/prompts/list_changed`, so claiming it would leave a client
    # waiting for a notification that never comes.
    bayan_json_v_obj_set_a(a, caps, AGN_JK_PROMPTS, bayan_json_v_obj_new_a(a));
    # `resources` alongside it (roadmap B1, [ADR 015]). **Advertised only
    # because it is answered** — a capability key is a promise a client acts on,
    # so it goes in exactly when `resources/list` and `resources/read` do, and
    # `subscribe` is deliberately absent from it: nothing here can push a
    # `notifications/resources/updated`, and claiming otherwise leaves a client
    # waiting for an event that never comes.
    bayan_json_v_obj_set_a(a, caps, AGN_JK_RESOURCES, bayan_json_v_obj_new_a(a));
    return caps;
}

fn _agnosai_mcp_initialize(a, id): i64 {
    var r = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, r, AGN_JK_PROTOCOL_VERSION,
      bayan_json_v_str_new_a(a, str_from_a(a, AGNOSAI_MCP_PROTOCOL_VERSION)));
    bayan_json_v_obj_set_a(a, r, AGN_JK_SERVER_INFO, _agnosai_mcp_server_info(a));
    bayan_json_v_obj_set_a(a, r, AGN_JK_CAPABILITIES, _agnosai_mcp_capabilities(a));
    return _agnosai_mcp_success(a, id, r);
}

# A 2026-07-28 result's own fields, on `r`, when `m` is 1: `resultType`, the caching hints a
# cacheable one carries (`ttl` of -1 for one that is not), and the server's identity in `_meta`.
# With `m` 0, `r` as it is, which is the earlier revision's wire.
fn _agnosai_mcp_finish(a, m, r, ttl): i64 {
    if (m == 0) { return r; }
    bayan_json_v_obj_set_a(a, r, AGN_JK_RESULT_TYPE, bayan_json_v_str_new_a(a, AGN_JV_COMPLETE));
    if (ttl >= 0) {
        bayan_json_v_obj_set_a(a, r, AGN_JK_TTL_MS, bayan_json_v_int_new_a(a, ttl));
        # `private`: every answer is behind the endpoint's auth, so no shared cache may keep one.
        bayan_json_v_obj_set_a(a, r, AGN_JK_CACHE_SCOPE, bayan_json_v_str_new_a(a, AGN_JV_PRIVATE));
    }
    var meta = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, meta, AGN_JK_MCP_SERVER_INFO, _agnosai_mcp_server_info(a));
    bayan_json_v_obj_set_a(a, r, AGN_JK_META, meta);
    return r;
}

# `server/discover`, which 2026-07-28 servers MUST answer in place of `initialize`: the revisions
# this endpoint speaks, newest first, what it can do, and who it is.
fn _agnosai_mcp_discover(a, id): i64 {
    var versions = bayan_json_v_arr_new_a(a);
    bayan_json_v_arr_push_a(a, versions, bayan_json_v_str_new_a(a, str_from_a(a, AGNOSAI_MCP_MODERN_VERSION)));
    bayan_json_v_arr_push_a(a, versions, bayan_json_v_str_new_a(a, str_from_a(a, AGNOSAI_MCP_PROTOCOL_VERSION)));
    var r = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, r, AGN_JK_SUPPORTED_VERSIONS, versions);
    bayan_json_v_obj_set_a(a, r, AGN_JK_CAPABILITIES, _agnosai_mcp_capabilities(a));
    return _agnosai_mcp_success(a, id, _agnosai_mcp_finish(a, 1, r, AGNOSAI_MCP_DISCOVER_TTL_MS));
}

# --- tools/list -----------------------------------------------------------

# An agnosai `ToolSchema` as bote's `ToolSchema` — the oracle's
# `to_bote_tool_def` (`mcp.rs:20-41`).
#
# Note the key is **`"type"`**, from `#[serde(rename = "type")]` on
# `schema_type`; a literal transcription of the Rust field name would emit
# `schema_type` and no MCP client would understand it.
fn _agnosai_mcp_input_schema(a, schema): i64 {
    var props = bayan_json_v_obj_new_a(a);
    var required = bayan_json_v_arr_new_a(a);
    var params = agnosai_tool_schema_parameters(schema);

    for (var i = 0; i < vec_len(params); i = i + 1) {
        var p = vec_get(params, i);
        var entry = bayan_json_v_obj_new_a(a);
        bayan_json_v_obj_set_a(a, entry, AGN_JK_TYPE,
          bayan_json_v_str_new_a(a, agnosai_param_schema_type(p)));
        bayan_json_v_obj_set_a(a, entry, AGN_JK_DESCRIPTION,
          bayan_json_v_str_new_a(a, agnosai_param_schema_description(p)));
        bayan_json_v_obj_set_a(a, props, agnosai_param_schema_name(p), entry);
        if (agnosai_param_schema_required(p) == 1) {
            bayan_json_v_arr_push_a(a, required, bayan_json_v_str_new_a(a, agnosai_param_schema_name(p)));
        }
    }

    var s = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, s, AGN_JK_TYPE, bayan_json_v_str_new_a(a, AGN_JV_OBJECT));
    bayan_json_v_obj_set_a(a, s, AGN_JK_PROPERTIES, props);
    bayan_json_v_obj_set_a(a, s, AGN_JK_REQUIRED, required);
    return s;
}

fn _agnosai_mcp_tools_list(a, id, state, m): i64 {
    var schemas = agnosai_tool_registry_list_a(a, agnosai_app_state_tools(state));
    var arr = bayan_json_v_arr_new_a(a);
    for (var i = 0; i < vec_len(schemas); i = i + 1) {
        var sc = vec_get(schemas, i);
        var t = bayan_json_v_obj_new_a(a);
        bayan_json_v_obj_set_a(a, t, AGN_JK_NAME,
          bayan_json_v_str_new_a(a, agnosai_tool_schema_name(sc)));
        bayan_json_v_obj_set_a(a, t, AGN_JK_DESCRIPTION,
          bayan_json_v_str_new_a(a, agnosai_tool_schema_description(sc)));
        bayan_json_v_obj_set_a(a, t, AGN_JK_INPUT_SCHEMA, _agnosai_mcp_input_schema(a, sc));
        bayan_json_v_arr_push_a(a, arr, t);
    }
    var r = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, r, AGN_JK_TOOLS, arr);
    # A ttl of 0: a tool registered after this answer is not announced, so no copy stays good.
    return _agnosai_mcp_success(a, id, _agnosai_mcp_finish(a, m, r, 0));
}

# --- tools/call -----------------------------------------------------------

# **A missing tool name is a JSON-RPC error; an unknown tool is not.** The
# oracle answers `-32602` for the former and a *success* carrying
# `isError: true` for the latter (`mcp.rs:101-116`). That asymmetry is the MCP
# convention — a protocol-level fault versus a tool-level one — and it is the
# thing most likely to be flattened by mistake.
#
# `tp` is the request's `traceparent`, or 0 (ADR 023). Parsed in the request
# arena, and only with telemetry on: the tool span is its child, and this is
# the only `execute_tool` producer until F1's tool loop.
#
# **2026-07-28 makes the unknown tool a protocol error too** (`m` 1): `-32602`, as its tools page has
# it, where the earlier revision's oracle answered a success with `isError`. A tool that ran and
# failed is `isError` in both.
fn _agnosai_mcp_tools_call(a, id, params, state, tp: Str, m): i64 {
    var name_v = 0;
    if (params != 0) { name_v = bayan_json_v_obj_get_by_cstr(params, "name"); }
    if (name_v == 0 || bayan_json_v_is_str(name_v) == 0) {
        return _agnosai_mcp_error(a, id, AGNOSAI_MCP_INVALID_PARAMS,
          str_from_a(a, "Missing tool name"));
    }
    var name = bayan_json_v_str(name_v);

    var tool = agnosai_tool_registry_get(agnosai_app_state_tools(state), name);
    if (tool == 0) {
        var sb = str_builder_new_a(a);
        str_builder_add_cstr_a(a, sb, "Tool not found: ");
        str_builder_add_a(a, sb, name);
        if (m == 1) { return _agnosai_mcp_error(a, id, AGNOSAI_MCP_INVALID_PARAMS, str_builder_build_a(a, sb)); }
        return _agnosai_mcp_success(a, id, _agnosai_mcp_content(a, str_builder_build_a(a, sb), 1));
    }

    # `params.get("arguments").cloned().unwrap_or(Value::Object(default))`, then
    # `arguments.as_object()` — a non-object `arguments` yields an EMPTY
    # parameter map rather than an error, so the tool runs with no arguments.
    var input = agnosai_tool_input_new();
    var args = bayan_json_v_obj_get_by_cstr(params, "arguments");
    if (args != 0 && bayan_json_v_is_obj(args) == 1) {
        for (var i = 0; i < bayan_json_v_obj_len(args); i = i + 1) {
            agnosai_tool_input_set(input, bayan_json_v_obj_key(args, i),
              bayan_json_v_obj_val(args, i));
        }
    }

    var parent = 0;
    if (tp != 0 && agnosai_telemetry_exporter() != 0) {
        parent = agnosai_otlp_span_context_parse_a(a, tp);
    }
    var started_ns = clock_now_ns();
    var out = agnosai_tool_execute_in(tool, input, parent);
    var took_ms = (clock_now_ns() - started_ns) / AGNOSAI_NS_PER_MS;
    # ⚠ **A tool may answer no output at all** — the vtable contract allows 0, and
    # `agnosai_tool_execute_in` null-checks for it and records `error.type` `no_output`. Until
    # 2.1.7 this handler read it three times without checking and segfaulted the worker
    # (roadmap B15). No builtin answers 0, so it was latent; a registered tool could. It is
    # a tool-level failure, `isError: true` with the oracle's fallback text.
    if (out == 0) {
        _agnosai_mcp_log_call(name, 0, took_ms);
        return _agnosai_mcp_success(a, id,
          _agnosai_mcp_finish(a, m, _agnosai_mcp_content(a, str_from_a(a, "Unknown error"), 1), 0 - 1));
    }
    _agnosai_mcp_log_call(name, agnosai_tool_output_success(out), took_ms);

    if (agnosai_tool_output_success(out) == 1) {
        return _agnosai_mcp_success(a, id, _agnosai_mcp_finish(a, m,
            _agnosai_mcp_content(a, _agnosai_mcp_result_text(a, agnosai_tool_output_result(out)), 0), 0 - 1));
    }

    # `output.error.unwrap_or_else(|| "Unknown error".to_string())`.
    var err = agnosai_tool_output_error(out);
    if (err == 0 || str_len(err) == 0) { err = str_from_a(a, "Unknown error"); }
    return _agnosai_mcp_success(a, id, _agnosai_mcp_finish(a, m, _agnosai_mcp_content(a, err, 1), 0 - 1));
}

# The oracle's `match output.result { Value::String(s) => s, other => other.to_string() }`
# — a **string result is unwrapped**, anything else is rendered as JSON.
#
# The distinction is wire-visible and pinned by the oracle's own
# `tools_call_executes_echo_tool`, which asserts `content[0]["text"] == "hello"`
# rather than `"\"hello\""`.
# --- resources/list, resources/read ---------------------------------------
#
# **Beyond the oracle, and re-projection rather than invention.** `mcp.rs`
# answers three methods and these are not among them — see
# [ADR 015](../../../docs/adr/015-mcp-resources-project-agent-definitions.md)
# for why the superset is allowed and what it is bounded to. Every byte served
# here is what `GET /api/v1/agents/definitions` already serves, addressed by URI
# instead of by path; no new state, no new lifecycle, nothing an MCP client can
# reach that a REST client could not.
#
# The URI scheme is `agnosai://agents/<name>`. `<name>` is the definition's map
# key, so `resources/read` is a single `agnosai_app_state_definition_get` and
# cannot walk anywhere the map does not already hold.
# --- prompts (beyond the oracle — see ADR 016) ----------------------------

# The optional `task` argument every projected prompt accepts.
var AGNOSAI_MCP_PROMPT_ARG = "task";

# One `prompts/list` entry for a stored agent definition.
#
# The prompt's **name is the agent key**, which is what
# `POST /api/v1/agents/definitions` stores it under and what
# `agnosai://agents/<name>` addresses — one identifier across all three
# surfaces rather than a per-surface naming scheme.
fn _agnosai_mcp_prompt_of(a, def): i64 {
    var o = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, o, AGN_JK_NAME,
      bayan_json_v_str_new_a(a, agnosai_agent_key(def)));
    bayan_json_v_obj_set_a(a, o, AGN_JK_DESCRIPTION,
      bayan_json_v_str_new_a(a, agnosai_agent_role(def)));

    var arg = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, arg, AGN_JK_NAME,
      bayan_json_v_str_new_a(a, str_from_a(a, AGNOSAI_MCP_PROMPT_ARG)));
    bayan_json_v_obj_set_a(a, arg, AGN_JK_DESCRIPTION,
      bayan_json_v_str_new_a(a, AGN_JV_ARG_DESC));
    # **Optional.** The persona is useful on its own; a client that wants the
    # agent's framing without a specific task should not have to invent one.
    bayan_json_v_obj_set_a(a, arg, AGN_JK_REQUIRED,
      bayan_json_v_bool_new_a(a, 0));
    var args = bayan_json_v_arr_new_a(a);
    bayan_json_v_arr_push_a(a, args, arg);
    bayan_json_v_obj_set_a(a, o, AGN_JK_ARGUMENTS, args);
    return o;
}

# `prompts/list` — one prompt per stored agent definition.
fn _agnosai_mcp_prompts_list(a, id, state, m): i64 {
    var defs = agnosai_app_state_definitions_a(a, state);
    var arr = bayan_json_v_arr_new_a(a);
    for (var i = 0; i < vec_len(defs); i = i + 1) {
        bayan_json_v_arr_push_a(a, arr, _agnosai_mcp_prompt_of(a, vec_get(defs, i)));
    }
    var r = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, r, AGN_JK_PROMPTS, arr);
    # 0: a definition posted after this answer is not announced either.
    return _agnosai_mcp_success(a, id, _agnosai_mcp_finish(a, m, r, 0));
}

# `prompts/get` — the agent's own system prompt, optionally with a task appended.
#
# **The text is `_agnosai_crew_build_system_prompt`, not a second renderer.**
# That is the whole point: an MCP client gets byte-for-byte the persona the crew
# would give that agent, so what a client previews and what a crew executes
# cannot drift. A separate template here would be a second source of truth for
# the same string.
fn _agnosai_mcp_prompts_get(a, id, params, state, m): i64 {
    if (params == 0 || bayan_json_v_is_obj(params) == 0) {
        return _agnosai_mcp_error(a, id, AGNOSAI_MCP_INVALID_PARAMS,
          str_from_a(a, "params must be an object"));
    }
    var nv = bayan_json_v_obj_get_by_cstr(params, "name");
    if (nv == 0 || bayan_json_v_is_str(nv) == 0) {
        return _agnosai_mcp_error(a, id, AGNOSAI_MCP_INVALID_PARAMS,
          str_from_a(a, "name is required"));
    }
    var def = agnosai_app_state_definition_get(state, bayan_json_v_str(nv));
    if (def == 0) {
        return _agnosai_mcp_error(a, id, AGNOSAI_MCP_INVALID_PARAMS,
          str_from_a(a, "unknown prompt"));
    }

    var sb = str_builder_new_a(a);
    str_builder_add_a(a, sb, _agnosai_crew_build_system_prompt(def));

    # `arguments` is optional, and so is `task` within it.
    var av = bayan_json_v_obj_get_by_cstr(params, "arguments");
    if (av != 0 && bayan_json_v_is_obj(av) == 1) {
        var tv = bayan_json_v_obj_get_by_cstr(av, AGNOSAI_MCP_PROMPT_ARG);
        if (tv != 0 && bayan_json_v_is_str(tv) == 1 && str_len(bayan_json_v_str(tv)) > 0) {
            str_builder_add_cstr_a(a, sb, "\n\nTask: ");
            str_builder_add_a(a, sb, bayan_json_v_str(tv));
        }
    }

    var content = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, content, AGN_JK_TYPE,
      bayan_json_v_str_new_a(a, AGN_JV_TEXT));
    bayan_json_v_obj_set_a(a, content, AGN_JK_TEXT,
      bayan_json_v_str_new_a(a, str_builder_build_a(a, sb)));

    var msg = bayan_json_v_obj_new_a(a);
    # **`user`, not `system`.** MCP's PromptMessage role is `user` or
    # `assistant` — there is no `system` — so the persona is delivered as the
    # opening user turn, which is what the spec's own examples do.
    bayan_json_v_obj_set_a(a, msg, AGN_JK_ROLE,
      bayan_json_v_str_new_a(a, AGN_JV_USER));
    bayan_json_v_obj_set_a(a, msg, AGN_JK_CONTENT, content);

    var msgs = bayan_json_v_arr_new_a(a);
    bayan_json_v_arr_push_a(a, msgs, msg);

    var r = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, r, AGN_JK_DESCRIPTION,
      bayan_json_v_str_new_a(a, agnosai_agent_role(def)));
    bayan_json_v_obj_set_a(a, r, AGN_JK_MESSAGES, msgs);
    # Not cacheable: 2026-07-28 lists `prompts/get` among the results that carry no caching hints.
    return _agnosai_mcp_success(a, id, _agnosai_mcp_finish(a, m, r, 0 - 1));
}

var AGNOSAI_MCP_RESOURCE_PREFIX = "agnosai://agents/";

# The name half of `agnosai://agents/<name>`, or 0 when `uri` is not one of ours.
#
# Returns 0 rather than an empty `Str` for a non-match, so "not our scheme" and
# "our scheme with an empty name" stay distinguishable — the second is a lookup
# that will miss, the first is a URI we must not claim to own.
fn _agnosai_mcp_resource_name(a, uri: Str): i64 {
    var plen = strlen(AGNOSAI_MCP_RESOURCE_PREFIX);
    if (str_len(uri) < plen) { return 0; }
    var d = str_data(uri);
    var i = 0;
    while (i < plen) {
        if (load8(d + i) != load8(AGNOSAI_MCP_RESOURCE_PREFIX + i)) { return 0; }
        i = i + 1;
    }
    return str_new(d + plen, str_len(uri) - plen);
}

# One MCP resource descriptor for an agent definition.
fn _agnosai_mcp_resource_of(a, def): i64 {
    var name = agnosai_agent_name(def);
    var o = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, o, AGN_JK_URI,
      bayan_json_v_str_new_a(a, str_cat_a(a, str_from_a(a, AGNOSAI_MCP_RESOURCE_PREFIX), name)));
    bayan_json_v_obj_set_a(a, o, AGN_JK_NAME, bayan_json_v_str_new_a(a, name));
    bayan_json_v_obj_set_a(a, o, AGN_JK_DESCRIPTION,
      bayan_json_v_str_new_a(a, agnosai_agent_role(def)));
    bayan_json_v_obj_set_a(a, o, AGN_JK_MIME_TYPE,
      bayan_json_v_str_new_a(a, AGN_JV_APPLICATION_JSON));
    return o;
}

fn _agnosai_mcp_resources_list(a, id, state, m): i64 {
    var defs = agnosai_app_state_definitions_a(a, state);
    var arr = bayan_json_v_arr_new_a(a);
    for (var i = 0; i < vec_len(defs); i = i + 1) {
        bayan_json_v_arr_push_a(a, arr, _agnosai_mcp_resource_of(a, vec_get(defs, i)));
    }
    var r = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, r, AGN_JK_RESOURCES, arr);
    return _agnosai_mcp_success(a, id, _agnosai_mcp_finish(a, m, r, 0));
}

# `resources/read` — the definition's own JSON, under MCP's `contents` envelope.
#
# **A missing resource is a JSON-RPC error, not an empty success.** MCP has no
# "isError" affordance here the way `tools/call` does, so the only way to say
# "no such resource" is the error channel; answering `contents: []` would read
# as "this resource exists and is empty".
#
# 2026-07-28 (`m` 1) says which resource was missing, in `data.uri`.
fn _agnosai_mcp_resources_read(a, id, params, state, m): i64 {
    if (params == 0 || bayan_json_v_is_obj(params) == 0) {
        return _agnosai_mcp_error(a, id, AGNOSAI_MCP_INVALID_PARAMS,
          str_from_a(a, "params must be an object with a uri"));
    }
    var uri_v = bayan_json_v_obj_get_by_cstr(params, "uri");
    if (uri_v == 0 || bayan_json_v_is_str(uri_v) == 0) {
        return _agnosai_mcp_error(a, id, AGNOSAI_MCP_INVALID_PARAMS,
          str_from_a(a, "uri is required and must be a string"));
    }
    var uri = bayan_json_v_str(uri_v);
    var name = _agnosai_mcp_resource_name(a, uri);
    if (name == 0) {
        return _agnosai_mcp_error(a, id, AGNOSAI_MCP_INVALID_PARAMS,
          str_from_a(a, "unknown resource URI scheme"));
    }
    var def = agnosai_app_state_definition_get(state, name);
    if (def == 0) {
        if (m == 1) {
            var d = bayan_json_v_obj_new_a(a);
            bayan_json_v_obj_set_a(a, d, AGN_JK_URI, bayan_json_v_str_new_a(a, uri));
            return _agnosai_mcp_error_data(a, id, AGNOSAI_MCP_INVALID_PARAMS, str_from_a(a, "no such resource"), d);
        }
        return _agnosai_mcp_error(a, id, AGNOSAI_MCP_INVALID_PARAMS,
          str_from_a(a, "no such resource"));
    }

    var item = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, item, AGN_JK_URI, bayan_json_v_str_new_a(a, uri));
    bayan_json_v_obj_set_a(a, item, AGN_JK_MIME_TYPE,
      bayan_json_v_str_new_a(a, AGN_JV_APPLICATION_JSON));
    # `text`, not an inline object: MCP's contents item carries the payload as a
    # string, so the definition is serialized rather than nested.
    bayan_json_v_obj_set_a(a, item, AGN_JK_TEXT,
      bayan_json_v_str_new_a(a, bayan_json_v_build_a(a, agnosai_agent_to_value_a(a, def))));

    var arr = bayan_json_v_arr_new_a(a);
    bayan_json_v_arr_push_a(a, arr, item);
    var r = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, r, AGN_JK_CONTENTS, arr);
    # 0: a definition can be replaced at any time, and nothing says so.
    return _agnosai_mcp_success(a, id, _agnosai_mcp_finish(a, m, r, 0));
}

fn _agnosai_mcp_result_text(a, result): Str {
    if (result == 0) { return AGN_JV_EMPTY; }
    if (bayan_json_v_is_str(result) == 1) { return bayan_json_v_str(result); }
    return bayan_json_v_build_a(a, result);
}

fn _agnosai_mcp_log_call(name: Str, success, duration_ms): i64 {
    if (sakshi_get_level() < SK_INFO) { return 0; }
    var f[AGNOSAI_LOG_FIELDS_BYTES];
    var n = agnosai_log_fields_start(&f, name);
    n = agnosai_log_field_bool(&f, n, "success", success);
    n = agnosai_log_field_int(&f, n, "duration_ms", duration_ms);
    sakshi_log_kv(SK_INFO, "MCP tool call", 13, "tool", 4, &f, n);
    return 0;
}

# --- The handler ----------------------------------------------------------

# `POST /mcp` — dispatch a JSON-RPC 2.0 request.
#
# **Every arm is HTTP 200**, including the unknown-method one: JSON-RPC carries
# its faults inside the envelope, and the oracle's return type
# (`Json<JsonRpcResponse>`) has no status to vary.
#
# `id` defaults to JSON **null** when absent — `req.id.clone().unwrap_or(Value::Null)`
# (`mcp.rs:53`) — and is echoed on every arm, errors included, because
# `JsonRpcResponse.id` is not `Option`.
fn agnosai_route_mcp_a(a, state, body: Str): i64 {
    return agnosai_route_mcp_tp_a(a, state, body, 0);
}

# `POST /mcp` with the request's `traceparent` header, or 0 (ADR 023). Only
# `tools/call` reads it; every response is byte-identical to the `_a` form's.
fn agnosai_route_mcp_tp_a(a, state, body: Str, tp: Str): i64 {
    return agnosai_route_mcp_h_a(a, state, body, tp, 0);
}

# `POST /mcp` with the request itself, `hdrs` (`src/http_headers.cyr`), or 0 (2.6.0, ADR 039).
#
# **The era is the request's.** One that names 2026-07-28, in `MCP-Protocol-Version` or in its
# `_meta`, is served under that revision; one with no header, or a header naming 2025-03-26, is
# served as this endpoint always served it, the oracle's wire. With `hdrs` of 0 there is no header,
# so a request that names 2026-07-28 in its body alone is refused for the header it lacks.
fn agnosai_route_mcp_h_a(a, state, body: Str, tp: Str, hdrs): i64 {
    var v = bayan_json_v_parse_buf_a(a, str_data(body), str_len(body));
    var hv_lines: i64[1];
    var hv = agnosai_http_header_once_a(a, hdrs, "MCP-Protocol-Version", &hv_lines);
    var bv = _agnosai_mcp_body_version(v);
    var modern_body = 0;
    if (bv != 0 && str_eq_cstr(bv, AGNOSAI_MCP_MODERN_VERSION) == 1) { modern_body = 1; }

    # A batch has no headers of its own to check, so 2026-07-28 takes one message a POST.
    if (v != 0 && bayan_json_v_is_arr(v) == 1 && _agnosai_mcp_batch_is_modern(v) == 1) {
        return _agnosai_mcp_refuse(a, HTTP_BAD_REQUEST, bayan_json_v_null_a(a), AGNOSAI_MCP_INVALID_REQUEST,
          str_from_a(a, "a POST carries one message"));
    }
    if (hv == 0) {
        if (modern_body == 1) {
            return _agnosai_mcp_refuse(a, HTTP_BAD_REQUEST, _agnosai_mcp_id_of(a, v), AGNOSAI_MCP_HEADER_MISMATCH,
              str_from_a(a, "missing required header: MCP-Protocol-Version"));
        }
        return _agnosai_mcp_legacy(a, state, v, tp);
    }
    if (streq(hv, AGNOSAI_MCP_MODERN_VERSION) == 0 && streq(hv, AGNOSAI_MCP_PROTOCOL_VERSION) == 0) {
        return _agnosai_mcp_unsupported(a, _agnosai_mcp_id_of(a, v), hv);
    }
    if (bv != 0 && str_eq_cstr(bv, hv) == 0) {
        return _agnosai_mcp_refuse(a, HTTP_BAD_REQUEST, _agnosai_mcp_id_of(a, v), AGNOSAI_MCP_HEADER_MISMATCH,
          _agnosai_mcp_mismatch_a(a, "MCP-Protocol-Version", hv, _agnosai_mcp_cstr_a(a, bv)));
    }
    if (streq(hv, AGNOSAI_MCP_MODERN_VERSION) == 0) { return _agnosai_mcp_legacy(a, state, v, tp); }
    return _agnosai_mcp_modern(a, state, v, bv, tp, hdrs, load64(&hv_lines));
}

# The earlier revision's answer, the oracle's: every arm HTTP 200, and an absent `id` echoed as null.
fn _agnosai_mcp_legacy(a, state, v, tp: Str): i64 {
    if (v == 0 || bayan_json_v_is_obj(v) == 0) {
        return agnosai_route_error_a(a, HTTP_BAD_REQUEST, str_from_a(a, "malformed JSON body"));
    }

    # JSON-RPC 2.0 requires `"jsonrpc": "2.0"` exactly; a request without it, or
    # naming another version, is not one this endpoint speaks.
    var ver_v = bayan_json_v_obj_get_by_cstr(v, "jsonrpc");
    var method_v = bayan_json_v_obj_get_by_cstr(v, "method");
    if (ver_v == 0 || bayan_json_v_is_str(ver_v) == 0 || method_v == 0
      || bayan_json_v_is_str(method_v) == 0) {
        return agnosai_route_error_a(a, AGNOSAI_HTTP_UNPROCESSABLE,
          str_from_a(a, "body is not a valid JSON-RPC request"));
    }
    if (str_eq_cstr(bayan_json_v_str(ver_v), "2.0") == 0) {
        return agnosai_route_error_a(a, AGNOSAI_HTTP_UNPROCESSABLE,
          str_from_a(a, "body is not a valid JSON-RPC request"));
    }
    var method = bayan_json_v_str(method_v);

    var id = bayan_json_v_obj_get_by_cstr(v, "id");
    if (id == 0) { id = bayan_json_v_null_a(a); }

    var r = _agnosai_mcp_dispatch(a, state, v, method, id, tp, 0);
    if (r == 0) {
        _agnosai_mcp_unknown(method);
        r = _agnosai_mcp_error(a, id, AGNOSAI_MCP_METHOD_NOT_FOUND, str_from_a(a, "Method not found"));
    }
    return agnosai_route_json_a(a, HTTP_OK, r);
}

# The method's answer, in either era (`m` 1 for 2026-07-28), or 0 for a method this endpoint does
# not have. `server/discover` is the newer revision's; `initialize` the earlier's.
fn _agnosai_mcp_dispatch(a, state, v, method: Str, id, tp: Str, m): i64 {
    var params = bayan_json_v_obj_get_by_cstr(v, "params");
    if (m == 0 && str_eq_cstr(method, "initialize") == 1) { return _agnosai_mcp_initialize(a, id); }
    if (m == 1 && str_eq_cstr(method, "server/discover") == 1) { return _agnosai_mcp_discover(a, id); }
    if (str_eq_cstr(method, "tools/list") == 1) {
        if (m == 1 && _agnosai_mcp_cursor_bad(params) == 1) { return _agnosai_mcp_bad_cursor(a, id); }
        return _agnosai_mcp_tools_list(a, id, state, m);
    }
    if (str_eq_cstr(method, "tools/call") == 1) { return _agnosai_mcp_tools_call(a, id, params, state, tp, m); }
    # Beyond the oracle's three — see ADR 015 and ADR 016.
    if (str_eq_cstr(method, "prompts/list") == 1) {
        if (m == 1 && _agnosai_mcp_cursor_bad(params) == 1) { return _agnosai_mcp_bad_cursor(a, id); }
        return _agnosai_mcp_prompts_list(a, id, state, m);
    }
    if (str_eq_cstr(method, "prompts/get") == 1) { return _agnosai_mcp_prompts_get(a, id, params, state, m); }
    if (str_eq_cstr(method, "resources/list") == 1) {
        if (m == 1 && _agnosai_mcp_cursor_bad(params) == 1) { return _agnosai_mcp_bad_cursor(a, id); }
        return _agnosai_mcp_resources_list(a, id, state, m);
    }
    if (str_eq_cstr(method, "resources/read") == 1) {
        return _agnosai_mcp_resources_read(a, id, params, state, m);
    }
    return 0;
}

# ---- 2026-07-28: the checks, and the answer ----------------------------------

# A 2026-07-28 request admitted by its version, checked as that revision asks, then answered. The
# order is bote's: what the body must carry, then each header against it. `hv_lines` is how many
# lines named `MCP-Protocol-Version`, counted when its value was read.
fn _agnosai_mcp_modern(a, state, v, bv: Str, tp: Str, hdrs, hv_lines): i64 {
    var null_id = bayan_json_v_null_a(a);
    if (v == 0) {
        return _agnosai_mcp_refuse(a, HTTP_BAD_REQUEST, null_id, AGNOSAI_MCP_PARSE_ERROR, str_from_a(a, "Parse error"));
    }
    if (bayan_json_v_is_obj(v) == 0) {
        return _agnosai_mcp_refuse(a, HTTP_BAD_REQUEST, null_id, AGNOSAI_MCP_INVALID_REQUEST,
          str_from_a(a, "a POST carries one message"));
    }
    var ver_v = bayan_json_v_obj_get_by_cstr(v, "jsonrpc");
    var method_v = bayan_json_v_obj_get_by_cstr(v, "method");
    var id = bayan_json_v_obj_get_by_cstr(v, "id");
    var rid = null_id;
    if (id != 0 && (bayan_json_v_is_str(id) == 1 || bayan_json_v_is_int(id) == 1)) { rid = id; }
    if (ver_v == 0 || bayan_json_v_is_str(ver_v) == 0 || str_eq_cstr(bayan_json_v_str(ver_v), "2.0") == 0
      || method_v == 0 || bayan_json_v_is_str(method_v) == 0) {
        return _agnosai_mcp_refuse(a, HTTP_BAD_REQUEST, rid, AGNOSAI_MCP_INVALID_REQUEST,
          str_from_a(a, "Invalid Request"));
    }
    # No `id`: a notification. This revision defines no header requirements for one, and this
    # endpoint acts on none, so it is accepted and nothing answers it.
    if (id == 0) { return agnosai_route_json_a(a, AGNOSAI_HTTP_ACCEPTED, 0); }
    # An `id` is a string or a number, never null, in this revision.
    if (rid == null_id) {
        return _agnosai_mcp_refuse(a, HTTP_BAD_REQUEST, null_id, AGNOSAI_MCP_INVALID_REQUEST,
          str_from_a(a, "Invalid Request: id must be a string or a number"));
    }
    var method = bayan_json_v_str(method_v);

    if (bv == 0) {
        return _agnosai_mcp_refuse(a, HTTP_BAD_REQUEST, rid, AGNOSAI_MCP_INVALID_PARAMS,
          str_from_a(a, "_meta needs a string io.modelcontextprotocol/protocolVersion"));
    }
    var caps = bayan_json_v_obj_get_by_cstr(_agnosai_mcp_meta(v), AGNOSAI_MCP_META_CAPS);
    if (caps == 0 || bayan_json_v_is_obj(caps) == 0) {
        return _agnosai_mcp_refuse(a, HTTP_BAD_REQUEST, rid, AGNOSAI_MCP_INVALID_PARAMS,
          str_from_a(a, "_meta needs an object io.modelcontextprotocol/clientCapabilities"));
    }
    if (hv_lines > 1) {
        return _agnosai_mcp_header_refuse(a, rid, "malformed header: MCP-Protocol-Version");
    }

    var hm_lines: i64[1];
    var hm = agnosai_http_header_once_a(a, hdrs, "Mcp-Method", &hm_lines);
    if (hm == 0) { return _agnosai_mcp_header_refuse(a, rid, "missing required header: Mcp-Method"); }
    if (load64(&hm_lines) > 1 || agnosai_http_header_value_ok(hm) == 0) {
        return _agnosai_mcp_header_refuse(a, rid, "malformed header: Mcp-Method");
    }
    if (str_eq_cstr(method, hm) == 0) {
        return _agnosai_mcp_refuse(a, HTTP_BAD_REQUEST, rid, AGNOSAI_MCP_HEADER_MISMATCH,
          _agnosai_mcp_mismatch_a(a, "Mcp-Method", hm, _agnosai_mcp_cstr_a(a, method)));
    }

    var key = _agnosai_mcp_name_key(method);
    if (key != 0) {
        var hn_lines: i64[1];
        var hn = agnosai_http_header_once_a(a, hdrs, "Mcp-Name", &hn_lines);
        if (hn == 0) { return _agnosai_mcp_header_refuse(a, rid, "missing required header: Mcp-Name"); }
        if (load64(&hn_lines) > 1 || agnosai_http_header_value_ok(hn) == 0) {
            return _agnosai_mcp_header_refuse(a, rid, "malformed header: Mcp-Name");
        }
        var nv = _agnosai_mcp_field_value_a(a, hn);
        if (nv == 0) { return _agnosai_mcp_header_refuse(a, rid, "Mcp-Name is not valid Base64"); }
        # A body without the field is the method's own -32602, as it is in the earlier revision.
        var params = bayan_json_v_obj_get_by_cstr(v, "params");
        var bn_v = 0;
        if (params != 0 && bayan_json_v_is_obj(params) == 1) { bn_v = bayan_json_v_obj_get_by_cstr(params, key); }
        if (bn_v != 0 && bayan_json_v_is_str(bn_v) == 1 && str_eq_cstr(bayan_json_v_str(bn_v), nv) == 0) {
            return _agnosai_mcp_refuse(a, HTTP_BAD_REQUEST, rid, AGNOSAI_MCP_HEADER_MISMATCH,
              _agnosai_mcp_mismatch_a(a, "Mcp-Name", nv, _agnosai_mcp_cstr_a(a, bayan_json_v_str(bn_v))));
        }
    }

    # This revision has no `initialize`: a request that named it named one without it.
    if (str_eq_cstr(method, "initialize") == 1) {
        return _agnosai_mcp_refuse(a, HTTP_NOT_FOUND, rid, AGNOSAI_MCP_METHOD_NOT_FOUND,
          str_from_a(a, "method not found: initialize"));
    }
    var r = _agnosai_mcp_dispatch(a, state, v, method, rid, tp, 1);
    if (r == 0) {
        _agnosai_mcp_unknown(method);
        return _agnosai_mcp_refuse(a, HTTP_NOT_FOUND, rid, AGNOSAI_MCP_METHOD_NOT_FOUND,
          str_from_a(a, "Method not found"));
    }
    # A method's own error is -32602, which goes out in band, on a 200, as bote's `_he_status_for`
    # has it: a client reads an error out of a 200, and a 5xx is what a proxy retries. The 404s and
    # 400s this revision sets are the refusals above, sent before a method runs.
    return agnosai_route_json_a(a, HTTP_OK, r);
}

# A refusal: `status` and a JSON-RPC error, which is how a client tells a 2026-07-28 server from an
# earlier one, as a 400 without a recognized error sends it back to `initialize`.
fn _agnosai_mcp_refuse(a, status, id, code, message: Str): i64 {
    _agnosai_mcp_refused(code, message);
    return agnosai_route_json_a(a, status, _agnosai_mcp_error(a, id, code, message));
}

fn _agnosai_mcp_header_refuse(a, id, message): i64 {
    return _agnosai_mcp_refuse(a, HTTP_BAD_REQUEST, id, AGNOSAI_MCP_HEADER_MISMATCH, str_from_a(a, message));
}

# -32022, naming the revisions this endpoint speaks, which a client picks from to retry.
fn _agnosai_mcp_unsupported(a, id, requested): i64 {
    var supported = bayan_json_v_arr_new_a(a);
    bayan_json_v_arr_push_a(a, supported, bayan_json_v_str_new_a(a, str_from_a(a, AGNOSAI_MCP_MODERN_VERSION)));
    bayan_json_v_arr_push_a(a, supported, bayan_json_v_str_new_a(a, str_from_a(a, AGNOSAI_MCP_PROTOCOL_VERSION)));
    var d = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, d, AGN_JK_SUPPORTED, supported);
    bayan_json_v_obj_set_a(a, d, AGN_JK_REQUESTED, bayan_json_v_str_new_a(a, str_from_a(a, requested)));
    var msg = str_from_a(a, "Unsupported protocol version");
    _agnosai_mcp_refused(AGNOSAI_MCP_UNSUPPORTED_VERSION, msg);
    return agnosai_route_json_a(a, HTTP_BAD_REQUEST,
      _agnosai_mcp_error_data(a, id, AGNOSAI_MCP_UNSUPPORTED_VERSION, msg, d));
}

# "Header mismatch: Mcp-Name header value 'foo' does not match body value 'bar'", as the spec's
# example has it. `hv` and `bv` are cstrs.
fn _agnosai_mcp_mismatch_a(a, header, hv, bv): Str {
    var sb = str_builder_new_a(a);
    str_builder_add_cstr_a(a, sb, "Header mismatch: ");
    str_builder_add_cstr_a(a, sb, header);
    str_builder_add_cstr_a(a, sb, " header value '");
    str_builder_add_cstr_a(a, sb, hv);
    str_builder_add_cstr_a(a, sb, "' does not match body value '");
    str_builder_add_cstr_a(a, sb, bv);
    str_builder_add_cstr_a(a, sb, "'");
    return str_builder_build_a(a, sb);
}

# `s` as a NUL-terminated cstr in `a`, for the messages that quote a body value.
fn _agnosai_mcp_cstr_a(a, s: Str): i64 {
    return str_data(str_clone_a(a, s));
}

# The request's `params._meta`, or 0.
fn _agnosai_mcp_meta(v): i64 {
    if (v == 0 || bayan_json_v_is_obj(v) == 0) { return 0; }
    var params = bayan_json_v_obj_get_by_cstr(v, "params");
    if (params == 0 || bayan_json_v_is_obj(params) == 0) { return 0; }
    var meta = bayan_json_v_obj_get_by_cstr(params, "_meta");
    if (meta == 0 || bayan_json_v_is_obj(meta) == 0) { return 0; }
    return meta;
}

# The revision a request names in its `_meta`, a Str, or 0.
fn _agnosai_mcp_body_version(v): i64 {
    var meta = _agnosai_mcp_meta(v);
    if (meta == 0) { return 0; }
    var bv = bayan_json_v_obj_get_by_cstr(meta, AGNOSAI_MCP_META_VERSION);
    if (bv == 0 || bayan_json_v_is_str(bv) == 0) { return 0; }
    return bayan_json_v_str(bv);
}

# 1 when a message of the batch `v` names 2026-07-28.
fn _agnosai_mcp_batch_is_modern(v): i64 {
    for (var i = 0; i < bayan_json_v_arr_len(v); i = i + 1) {
        var bv = _agnosai_mcp_body_version(bayan_json_v_arr_get(v, i));
        if (bv != 0 && str_eq_cstr(bv, AGNOSAI_MCP_MODERN_VERSION) == 1) { return 1; }
    }
    return 0;
}

# The request's `id` for a refusal: a string or a number as it is, anything else null.
fn _agnosai_mcp_id_of(a, v): i64 {
    if (v != 0 && bayan_json_v_is_obj(v) == 1) {
        var id = bayan_json_v_obj_get_by_cstr(v, "id");
        if (id != 0 && (bayan_json_v_is_str(id) == 1 || bayan_json_v_is_int(id) == 1)) { return id; }
    }
    return bayan_json_v_null_a(a);
}

# The params field `Mcp-Name` mirrors for `method`, a cstr, or 0 when it has none.
fn _agnosai_mcp_name_key(method: Str): i64 {
    if (str_eq_cstr(method, "tools/call") == 1) { return "name"; }
    if (str_eq_cstr(method, "prompts/get") == 1) { return "name"; }
    if (str_eq_cstr(method, "resources/read") == 1) { return "uri"; }
    return 0;
}

# 1 when a list's `params.cursor` is one this endpoint never issued: it answers every list in one
# page, so any cursor but the empty one is.
fn _agnosai_mcp_cursor_bad(params): i64 {
    if (params == 0 || bayan_json_v_is_obj(params) == 0) { return 0; }
    var c = bayan_json_v_obj_get_by_cstr(params, "cursor");
    if (c == 0 || bayan_json_v_is_null(c) == 1) { return 0; }
    if (bayan_json_v_is_str(c) == 0) { return 1; }
    if (str_len(bayan_json_v_str(c)) > 0) { return 1; }
    return 0;
}

fn _agnosai_mcp_bad_cursor(a, id): i64 {
    return _agnosai_mcp_error(a, id, AGNOSAI_MCP_INVALID_PARAMS, str_from_a(a, "invalid cursor"));
}

# What an `Mcp-Name` value says: the value as sent, or a `=?base64?…?=` sentinel decoded. The
# markers are case-sensitive, so anything else is a plain value. 0 when a sentinel does not decode.
fn _agnosai_mcp_field_value_a(a, v): i64 {
    var n = strlen(v);
    if (n < 11 || memeq(v, "=?base64?", 9) == 0 || memeq(v + n - 2, "?=", 2) == 0) { return v; }
    return _agnosai_mcp_b64_decode_a(a, v + 9, n - 11);
}

# The value of `ch` in the standard Base64 alphabet, or -1.
fn _agnosai_mcp_b64_val(ch): i64 {
    if (ch >= 65 && ch <= 90) { return ch - 65; }
    if (ch >= 97 && ch <= 122) { return ch - 71; }
    if (ch >= 48 && ch <= 57) { return ch + 4; }
    if (ch == 43) { return 62; }
    if (ch == 47) { return 63; }
    return 0 - 1;
}

# The standard Base64 at p[0, n) as a cstr in `a`, or 0 when it is not canonical or decodes to a
# NUL, which a cstr cannot hold. Not `bayan_base64_decode`: that keeps its output on the global heap,
# and this is a client's header on a path that may refuse it.
fn _agnosai_mcp_b64_decode_a(a, p, n): i64 {
    if (n % 4 != 0) { return 0; }
    var pad = 0;
    while (pad < 2 && n > 0 && load8(p + n - 1) == 61) {
        n = n - 1;
        pad = pad + 1;
    }
    var out = alloc_via(a, (n / 4) * 3 + 3);
    var acc = 0;
    var bits = 0;
    var o = 0;
    var i = 0;
    while (i < n) {
        var x = _agnosai_mcp_b64_val(load8(p + i));
        if (x < 0) { return 0; }
        acc = ((acc << 6) | x) & 0xFFFFFF;
        bits = bits + 6;
        if (bits >= 8) {
            bits = bits - 8;
            var b = (acc >> bits) & 255;
            if (b == 0) { return 0; }
            store8(out + o, b);
            o = o + 1;
        }
        i = i + 1;
    }
    # The bits a last group pads with are 0 in canonical Base64.
    if ((acc & ((1 << bits) - 1)) != 0) { return 0; }
    store8(out + o, 0);
    return out;
}

fn _agnosai_mcp_refused(code, message: Str): i64 {
    if (sakshi_get_level() < SK_DEBUG) { return 0; }
    var f[AGNOSAI_LOG_FIELDS_BYTES];
    var n = agnosai_log_fields_start(&f, message);
    n = agnosai_log_field_int(&f, n, "code", code);
    sakshi_log_kv(SK_DEBUG, "MCP request refused", 19, "reason", 6, &f, n);
    return 0;
}

# Global-allocator form of `agnosai_route_mcp_a`.
#
# **Threaded end to end, parse tree included** — the JSON-RPC envelope, the
# result tree, every tool schema behind `tools/list`, and the agent
# definitions behind `resources/list` all land in the request arena. Safe
# because `/mcp` retains nothing: `tools/call` executes and returns, and the
# resource routes read `AppState` without storing into it.
#
# The two logging helpers keep their bare shape deliberately — they allocate
# nothing, so an allocator parameter would be noise on a hot guard.
fn agnosai_route_mcp(state, body: Str): i64 {
    return agnosai_route_mcp_a(default_alloc(), state, body);
}

fn _agnosai_mcp_unknown(method: Str): i64 {
    if (sakshi_get_level() < SK_WARN) { return 0; }
    sakshi_log_kv(SK_WARN, "MCP unknown method", 18, "method", 6,
      str_data(method), str_len(method));
    return 0;
}
