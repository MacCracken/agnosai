# =========================================================================
# server/routes/mcp — Model Context Protocol over JSON-RPC 2.0.
#
# Parity oracle: rust-old/src/server/routes/mcp.rs
#
# The last of the pure handlers. Three methods — `initialize`, `tools/list`,
# `tools/call` — plus a `-32601` fall-through, every arm answered **HTTP 200**
# with a JSON-RPC envelope; JSON-RPC carries its own errors in the body.
#
# ## The envelope is built here, not delegated to bote
#
# The oracle uses `bote::protocol::{JsonRpcRequest, JsonRpcResponse}` and
# `bote::registry::{ToolDef, ToolSchema}` **as types only** — it never calls
# bote's dispatcher, and says so at `mcp.rs:3-5` ("bote's sync Dispatcher is not
# used here"). This port builds the same wire shapes directly, for a reason the
# Cyrius side makes sharper: `lib/bote-core.cyr`'s `dispatcher_dispatch`
# (`:1713`) hardcodes `"serverInfo":{"name":"bote"` in `_build_initialize_result`,
# where the oracle emits `"name":"agnosai"`. Delegating would change the wire.
#
# The shapes are transcribed from the **Rust** bote 0.91.0 the oracle pins
# (`~/.cargo/registry/.../bote-0.91.0/src/protocol.rs`), not from the Cyrius
# bundle, because the oracle's wire format is whatever serde emits there:
#
#   JsonRpcResponse { jsonrpc: String, id: Value,
#                     result: Option<Value>  #[skip_serializing_if none],
#                     error:  Option<JsonRpcError> #[skip_serializing_if none] }
#   JsonRpcError    { code: i32, message: String,
#                     data: Option<Value> #[skip_serializing_if none] }
#   ToolSchema      { #[serde(rename="type")] schema_type, properties, required }
#
# So a success carries `result` and **omits** `error`, an error carries `error`
# and **omits** `result`, and `data` is omitted throughout — the oracle never
# sets it. `id` is required on both, even on an error.
#
# **What this does NOT mean is that the bote pin is dead weight.** bote *is* the
# MCP layer — `dist/bote-core.cyr` ships the protocol, registry, dispatcher,
# schema validation, and 18 `prompt_*` + 15 `resource_*` fns. This route answers
# the three methods the oracle answers (`initialize`, `tools/list`,
# `tools/call`), which is full parity — and MCP's prompts, resources and
# subscriptions are the obvious next surface for an agent orchestrator, all of
# them already sitting in the pinned bundle. The correct reading of "zero bote
# symbols called today" is that this route is a **thin slice of MCP**, not that
# the protocol library is unnecessary.
#
# The one thing that must not be delegated is `dispatcher_dispatch`: verified at
# `lib/bote-core.cyr:1559`, `_build_initialize_result` hardcodes
# `"serverInfo":{"name":"bote"` where the oracle emits `"name":"agnosai"`. That
# is a single-site wire divergence. **Filed and shipped: bote 3.3.0 adds
# `dispatcher_set_server_info(d, name, version)`**, so the hardcode is no longer
# a permanent reason to hand-roll — it becomes a one-line call whenever this
# route grows past the oracle's three methods.
#
# **Today it should still NOT delegate**, and that is parity, not inertia: the
# oracle uses bote's protocol *types* while explicitly declining its Dispatcher
# (`mcp.rs:3-5`, "agnosai tools require async execution"). Matching the oracle
# means building the envelope here. The 3.3.0 fix removes the blocker for the
# surface that comes after — MCP prompts and resources, which bote already
# ships (18 + 15 fns in the pinned core bundle).
# =========================================================================

# The MCP protocol revision the oracle advertises (`mcp.rs:69`). A literal
# there and a literal here — it is a wire constant, not a capability check.
var AGNOSAI_MCP_PROTOCOL_VERSION = "2025-03-26";

# JSON-RPC 2.0 reserved error codes, the two the oracle uses.
var AGNOSAI_MCP_METHOD_NOT_FOUND = 0 - 32601;
var AGNOSAI_MCP_INVALID_PARAMS = 0 - 32602;

# The MCP wire vocabulary, minted once at startup. See the banner in
# `core/json.cyr` for the measurement and the rule; `routes/mod.cyr` carries the
# few this file shares with the rest of the tier.
#
# **The envelope is the reason this file has the most of them.** Every MCP reply
# — success or error, every method — is wrapped in `{jsonrpc, id, result}`, so
# those three keys and the `"2.0"` value are four allocations on the route's
# unconditional path. The list handlers add per-item ones on top: `tools/list`
# builds a name, description and inputSchema per registered tool, `prompts/list`
# the same per agent definition.
#
# The JSON-RPC *messages* stay inline, like the rest of the tier's error arms.
var AGN_JK_JSONRPC = str_from("jsonrpc");
var AGN_JV_JSONRPC_20 = str_from("2.0");
var AGN_JK_CODE = str_from("code");
var AGN_JK_TYPE = str_from("type");
var AGN_JK_TEXT = str_from("text");
var AGN_JV_TEXT = AGN_JK_TEXT;
var AGN_JK_CONTENT = str_from("content");
var AGN_JK_IS_ERROR = str_from("isError");
var AGN_JV_AGNOSAI = str_from("agnosai");
var AGN_JK_VERSION = str_from("version");
var AGN_JK_TOOLS = str_from("tools");
var AGN_JK_PROMPTS = str_from("prompts");
var AGN_JK_RESOURCES = str_from("resources");
var AGN_JK_PROTOCOL_VERSION = str_from("protocolVersion");
var AGN_JK_SERVER_INFO = str_from("serverInfo");
var AGN_JK_CAPABILITIES = str_from("capabilities");
var AGN_JV_OBJECT = str_from("object");
var AGN_JK_PROPERTIES = str_from("properties");
var AGN_JK_REQUIRED = str_from("required");
var AGN_JK_INPUT_SCHEMA = str_from("inputSchema");
var AGN_JK_ARGUMENTS = str_from("arguments");
var AGN_JV_ARG_DESC = str_from("What this agent should be asked to do");
var AGN_JV_USER = str_from("user");
var AGN_JK_MESSAGES = str_from("messages");
var AGN_JK_URI = str_from("uri");
var AGN_JK_MIME_TYPE = str_from("mimeType");
var AGN_JV_APPLICATION_JSON = str_from("application/json");
var AGN_JK_CONTENTS = str_from("contents");

# --- Envelope -------------------------------------------------------------

# `JsonRpcResponse::success` — `result` present, `error` omitted.
fn _agnosai_mcp_success(a, id, result): i64 {
    var o = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, o, AGN_JK_JSONRPC, bayan_json_v_str_new_a(a, AGN_JV_JSONRPC_20));
    bayan_json_v_obj_set_a(a, o, AGN_JK_ID, id);
    bayan_json_v_obj_set_a(a, o, AGN_JK_RESULT, result);
    return o;
}

# `JsonRpcResponse::error` — `error` present, `result` omitted, `data` omitted.
fn _agnosai_mcp_error(a, id, code, message: Str): i64 {
    var e = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, e, AGN_JK_CODE, bayan_json_v_int_new_a(a, code));
    bayan_json_v_obj_set_a(a, e, AGN_JK_MESSAGE, bayan_json_v_str_new_a(a, message));

    var o = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, o, AGN_JK_JSONRPC, bayan_json_v_str_new_a(a, AGN_JV_JSONRPC_20));
    bayan_json_v_obj_set_a(a, o, AGN_JK_ID, id);
    bayan_json_v_obj_set_a(a, o, AGN_JK_ERROR, e);
    return o;
}

# The MCP `content` payload every `tools/call` outcome uses — including the
# failures, which are JSON-RPC **successes** carrying `isError: true`.
fn _agnosai_mcp_content(a, text: Str, is_error): i64 {
    var item = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, item, AGN_JK_TYPE, bayan_json_v_str_new_a(a, AGN_JV_TEXT));
    bayan_json_v_obj_set_a(a, item, AGN_JK_TEXT, bayan_json_v_str_new_a(a, text));
    var arr = bayan_json_v_arr_new_a(a);
    bayan_json_v_arr_push_a(a, arr, item);

    var o = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, o, AGN_JK_CONTENT, arr);
    bayan_json_v_obj_set_a(a, o, AGN_JK_IS_ERROR, bayan_json_v_bool_new_a(a, is_error));
    return o;
}

# --- initialize -----------------------------------------------------------

fn _agnosai_mcp_initialize(a, id): i64 {
    var info = bayan_json_v_obj_new_a(a);
    # `"agnosai"`, NOT bote's `"bote"` — the reason this module does not
    # delegate. See the header.
    bayan_json_v_obj_set_a(a, info, AGN_JK_NAME, bayan_json_v_str_new_a(a, AGN_JV_AGNOSAI));
    bayan_json_v_obj_set_a(a, info, AGN_JK_VERSION,
      bayan_json_v_str_new_a(a, str_from_a(a, AGNOSAI_VERSION)));

    # `"capabilities": {"tools": {}}` — an empty object, not null and not
    # absent. A client reads the presence of the `tools` key as the capability.
    var caps = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, caps, AGN_JK_TOOLS, bayan_json_v_obj_new_a(a));
    # `prompts` on the same terms as `resources` below: advertised because it is
    # answered. `listChanged` is deliberately absent — definitions can be added
    # by `POST /api/v1/agents/definitions` at any time and nothing here can push
    # a `notifications/prompts/list_changed`, so claiming it would leave a client
    # waiting for a notification that never comes.
    bayan_json_v_obj_set_a(a, caps, AGN_JK_PROMPTS, bayan_json_v_obj_new_a(a));
    # `resources` alongside it (roadmap B1, [ADR 015]). **Advertised only
    # because it is answered** — a capability key is a promise a client acts on,
    # so it goes in exactly when `resources/list` and `resources/read` do, and
    # `subscribe` is deliberately absent from it: nothing here can push a
    # `notifications/resources/updated`, and claiming otherwise leaves a client
    # waiting for an event that never comes.
    bayan_json_v_obj_set_a(a, caps, AGN_JK_RESOURCES, bayan_json_v_obj_new_a(a));

    var r = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, r, AGN_JK_PROTOCOL_VERSION,
      bayan_json_v_str_new_a(a, str_from_a(a, AGNOSAI_MCP_PROTOCOL_VERSION)));
    bayan_json_v_obj_set_a(a, r, AGN_JK_SERVER_INFO, info);
    bayan_json_v_obj_set_a(a, r, AGN_JK_CAPABILITIES, caps);
    return _agnosai_mcp_success(a, id, r);
}

# --- tools/list -----------------------------------------------------------

# An agnosai `ToolSchema` as bote's `ToolSchema` — the oracle's
# `to_bote_tool_def` (`mcp.rs:20-41`).
#
# Note the key is **`"type"`**, from `#[serde(rename = "type")]` on
# `schema_type`; a literal transcription of the Rust field name would emit
# `schema_type` and no MCP client would understand it.
fn _agnosai_mcp_input_schema(a, schema): i64 {
    var props = bayan_json_v_obj_new_a(a);
    var required = bayan_json_v_arr_new_a(a);
    var params = agnosai_tool_schema_parameters(schema);

    for (var i = 0; i < vec_len(params); i = i + 1) {
        var p = vec_get(params, i);
        var entry = bayan_json_v_obj_new_a(a);
        bayan_json_v_obj_set_a(a, entry, AGN_JK_TYPE,
          bayan_json_v_str_new_a(a, agnosai_param_schema_type(p)));
        bayan_json_v_obj_set_a(a, entry, AGN_JK_DESCRIPTION,
          bayan_json_v_str_new_a(a, agnosai_param_schema_description(p)));
        bayan_json_v_obj_set_a(a, props, agnosai_param_schema_name(p), entry);
        if (agnosai_param_schema_required(p) == 1) {
            bayan_json_v_arr_push_a(a, required, bayan_json_v_str_new_a(a, agnosai_param_schema_name(p)));
        }
    }

    var s = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, s, AGN_JK_TYPE, bayan_json_v_str_new_a(a, AGN_JV_OBJECT));
    bayan_json_v_obj_set_a(a, s, AGN_JK_PROPERTIES, props);
    bayan_json_v_obj_set_a(a, s, AGN_JK_REQUIRED, required);
    return s;
}

fn _agnosai_mcp_tools_list(a, id, state): i64 {
    var schemas = agnosai_tool_registry_list_a(a, agnosai_app_state_tools(state));
    var arr = bayan_json_v_arr_new_a(a);
    for (var i = 0; i < vec_len(schemas); i = i + 1) {
        var sc = vec_get(schemas, i);
        var t = bayan_json_v_obj_new_a(a);
        bayan_json_v_obj_set_a(a, t, AGN_JK_NAME,
          bayan_json_v_str_new_a(a, agnosai_tool_schema_name(sc)));
        bayan_json_v_obj_set_a(a, t, AGN_JK_DESCRIPTION,
          bayan_json_v_str_new_a(a, agnosai_tool_schema_description(sc)));
        bayan_json_v_obj_set_a(a, t, AGN_JK_INPUT_SCHEMA, _agnosai_mcp_input_schema(a, sc));
        bayan_json_v_arr_push_a(a, arr, t);
    }
    var r = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, r, AGN_JK_TOOLS, arr);
    return _agnosai_mcp_success(a, id, r);
}

# --- tools/call -----------------------------------------------------------

# **A missing tool name is a JSON-RPC error; an unknown tool is not.** The
# oracle answers `-32602` for the former and a *success* carrying
# `isError: true` for the latter (`mcp.rs:101-116`). That asymmetry is the MCP
# convention — a protocol-level fault versus a tool-level one — and it is the
# thing most likely to be flattened by mistake.
fn _agnosai_mcp_tools_call(a, id, params, state): i64 {
    var name_v = 0;
    if (params != 0) { name_v = bayan_json_v_obj_get(params, "name"); }
    if (name_v == 0 || bayan_json_v_is_str(name_v) == 0) {
        return _agnosai_mcp_error(a, id, AGNOSAI_MCP_INVALID_PARAMS,
          str_from_a(a, "Missing tool name"));
    }
    var name = bayan_json_v_str(name_v);

    var tool = agnosai_tool_registry_get(agnosai_app_state_tools(state), name);
    if (tool == 0) {
        var sb = str_builder_new_a(a);
        str_builder_add_cstr_a(a, sb, "Tool not found: ");
        str_builder_add_a(a, sb, name);
        return _agnosai_mcp_success(a, id, _agnosai_mcp_content(a, str_builder_build_a(a, sb), 1));
    }

    # `params.get("arguments").cloned().unwrap_or(Value::Object(default))`, then
    # `arguments.as_object()` — a non-object `arguments` yields an EMPTY
    # parameter map rather than an error, so the tool runs with no arguments.
    var input = agnosai_tool_input_new();
    var args = bayan_json_v_obj_get(params, "arguments");
    if (args != 0 && bayan_json_v_is_obj(args) == 1) {
        for (var i = 0; i < bayan_json_v_obj_len(args); i = i + 1) {
            agnosai_tool_input_set(input, bayan_json_v_obj_key(args, i),
              bayan_json_v_obj_val(args, i));
        }
    }

    var out = agnosai_tool_execute(tool, input);
    _agnosai_mcp_log_call(name, agnosai_tool_output_success(out));

    if (agnosai_tool_output_success(out) == 1) {
        return _agnosai_mcp_success(a, id,
          _agnosai_mcp_content(a, _agnosai_mcp_result_text(a, agnosai_tool_output_result(out)), 0));
    }

    # `output.error.unwrap_or_else(|| "Unknown error".to_string())`.
    var err = agnosai_tool_output_error(out);
    if (err == 0 || str_len(err) == 0) { err = str_from_a(a, "Unknown error"); }
    return _agnosai_mcp_success(a, id, _agnosai_mcp_content(a, err, 1));
}

# The oracle's `match output.result { Value::String(s) => s, other => other.to_string() }`
# — a **string result is unwrapped**, anything else is rendered as JSON.
#
# The distinction is wire-visible and pinned by the oracle's own
# `tools_call_executes_echo_tool`, which asserts `content[0]["text"] == "hello"`
# rather than `"\"hello\""`.
# --- resources/list, resources/read ---------------------------------------
#
# **Beyond the oracle, and re-projection rather than invention.** `mcp.rs`
# answers three methods and these are not among them — see
# [ADR 015](../../../docs/adr/015-mcp-resources-project-agent-definitions.md)
# for why the superset is allowed and what it is bounded to. Every byte served
# here is what `GET /api/v1/agents/definitions` already serves, addressed by URI
# instead of by path; no new state, no new lifecycle, nothing an MCP client can
# reach that a REST client could not.
#
# The URI scheme is `agnosai://agents/<name>`. `<name>` is the definition's map
# key, so `resources/read` is a single `agnosai_app_state_definition_get` and
# cannot walk anywhere the map does not already hold.
# --- prompts (beyond the oracle — see ADR 016) ----------------------------

# The optional `task` argument every projected prompt accepts.
var AGNOSAI_MCP_PROMPT_ARG = "task";

# One `prompts/list` entry for a stored agent definition.
#
# The prompt's **name is the agent key**, which is what
# `POST /api/v1/agents/definitions` stores it under and what
# `agnosai://agents/<name>` addresses — one identifier across all three
# surfaces rather than a per-surface naming scheme.
fn _agnosai_mcp_prompt_of(a, def): i64 {
    var o = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, o, AGN_JK_NAME,
      bayan_json_v_str_new_a(a, agnosai_agent_key(def)));
    bayan_json_v_obj_set_a(a, o, AGN_JK_DESCRIPTION,
      bayan_json_v_str_new_a(a, agnosai_agent_role(def)));

    var arg = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, arg, AGN_JK_NAME,
      bayan_json_v_str_new_a(a, str_from_a(a, AGNOSAI_MCP_PROMPT_ARG)));
    bayan_json_v_obj_set_a(a, arg, AGN_JK_DESCRIPTION,
      bayan_json_v_str_new_a(a, AGN_JV_ARG_DESC));
    # **Optional.** The persona is useful on its own; a client that wants the
    # agent's framing without a specific task should not have to invent one.
    bayan_json_v_obj_set_a(a, arg, AGN_JK_REQUIRED,
      bayan_json_v_bool_new_a(a, 0));
    var args = bayan_json_v_arr_new_a(a);
    bayan_json_v_arr_push_a(a, args, arg);
    bayan_json_v_obj_set_a(a, o, AGN_JK_ARGUMENTS, args);
    return o;
}

# `prompts/list` — one prompt per stored agent definition.
fn _agnosai_mcp_prompts_list(a, id, state): i64 {
    var defs = agnosai_app_state_definitions_a(a, state);
    var arr = bayan_json_v_arr_new_a(a);
    for (var i = 0; i < vec_len(defs); i = i + 1) {
        bayan_json_v_arr_push_a(a, arr, _agnosai_mcp_prompt_of(a, vec_get(defs, i)));
    }
    var r = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, r, AGN_JK_PROMPTS, arr);
    return _agnosai_mcp_success(a, id, r);
}

# `prompts/get` — the agent's own system prompt, optionally with a task appended.
#
# **The text is `_agnosai_crew_build_system_prompt`, not a second renderer.**
# That is the whole point: an MCP client gets byte-for-byte the persona the crew
# would give that agent, so what a client previews and what a crew executes
# cannot drift. A separate template here would be a second source of truth for
# the same string.
fn _agnosai_mcp_prompts_get(a, id, params, state): i64 {
    if (params == 0 || bayan_json_v_is_obj(params) == 0) {
        return _agnosai_mcp_error(a, id, AGNOSAI_MCP_INVALID_PARAMS,
          str_from_a(a, "params must be an object"));
    }
    var nv = bayan_json_v_obj_get(params, "name");
    if (nv == 0 || bayan_json_v_is_str(nv) == 0) {
        return _agnosai_mcp_error(a, id, AGNOSAI_MCP_INVALID_PARAMS,
          str_from_a(a, "name is required"));
    }
    var def = agnosai_app_state_definition_get(state, bayan_json_v_str(nv));
    if (def == 0) {
        return _agnosai_mcp_error(a, id, AGNOSAI_MCP_INVALID_PARAMS,
          str_from_a(a, "unknown prompt"));
    }

    var sb = str_builder_new_a(a);
    str_builder_add_a(a, sb, _agnosai_crew_build_system_prompt(def));

    # `arguments` is optional, and so is `task` within it.
    var av = bayan_json_v_obj_get(params, "arguments");
    if (av != 0 && bayan_json_v_is_obj(av) == 1) {
        var tv = bayan_json_v_obj_get(av, AGNOSAI_MCP_PROMPT_ARG);
        if (tv != 0 && bayan_json_v_is_str(tv) == 1 && str_len(bayan_json_v_str(tv)) > 0) {
            str_builder_add_cstr_a(a, sb, "\n\nTask: ");
            str_builder_add_a(a, sb, bayan_json_v_str(tv));
        }
    }

    var content = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, content, AGN_JK_TYPE,
      bayan_json_v_str_new_a(a, AGN_JV_TEXT));
    bayan_json_v_obj_set_a(a, content, AGN_JK_TEXT,
      bayan_json_v_str_new_a(a, str_builder_build_a(a, sb)));

    var msg = bayan_json_v_obj_new_a(a);
    # **`user`, not `system`.** MCP's PromptMessage role is `user` or
    # `assistant` — there is no `system` — so the persona is delivered as the
    # opening user turn, which is what the spec's own examples do.
    bayan_json_v_obj_set_a(a, msg, AGN_JK_ROLE,
      bayan_json_v_str_new_a(a, AGN_JV_USER));
    bayan_json_v_obj_set_a(a, msg, AGN_JK_CONTENT, content);

    var msgs = bayan_json_v_arr_new_a(a);
    bayan_json_v_arr_push_a(a, msgs, msg);

    var r = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, r, AGN_JK_DESCRIPTION,
      bayan_json_v_str_new_a(a, agnosai_agent_role(def)));
    bayan_json_v_obj_set_a(a, r, AGN_JK_MESSAGES, msgs);
    return _agnosai_mcp_success(a, id, r);
}

var AGNOSAI_MCP_RESOURCE_PREFIX = "agnosai://agents/";

# The name half of `agnosai://agents/<name>`, or 0 when `uri` is not one of ours.
#
# Returns 0 rather than an empty `Str` for a non-match, so "not our scheme" and
# "our scheme with an empty name" stay distinguishable — the second is a lookup
# that will miss, the first is a URI we must not claim to own.
fn _agnosai_mcp_resource_name(a, uri: Str): i64 {
    var plen = strlen(AGNOSAI_MCP_RESOURCE_PREFIX);
    if (str_len(uri) < plen) { return 0; }
    var d = str_data(uri);
    var i = 0;
    while (i < plen) {
        if (load8(d + i) != load8(AGNOSAI_MCP_RESOURCE_PREFIX + i)) { return 0; }
        i = i + 1;
    }
    return str_new(d + plen, str_len(uri) - plen);
}

# One MCP resource descriptor for an agent definition.
fn _agnosai_mcp_resource_of(a, def): i64 {
    var name = agnosai_agent_name(def);
    var o = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, o, AGN_JK_URI,
      bayan_json_v_str_new_a(a, str_cat_a(a, str_from_a(a, AGNOSAI_MCP_RESOURCE_PREFIX), name)));
    bayan_json_v_obj_set_a(a, o, AGN_JK_NAME, bayan_json_v_str_new_a(a, name));
    bayan_json_v_obj_set_a(a, o, AGN_JK_DESCRIPTION,
      bayan_json_v_str_new_a(a, agnosai_agent_role(def)));
    bayan_json_v_obj_set_a(a, o, AGN_JK_MIME_TYPE,
      bayan_json_v_str_new_a(a, AGN_JV_APPLICATION_JSON));
    return o;
}

fn _agnosai_mcp_resources_list(a, id, state): i64 {
    var defs = agnosai_app_state_definitions_a(a, state);
    var arr = bayan_json_v_arr_new_a(a);
    for (var i = 0; i < vec_len(defs); i = i + 1) {
        bayan_json_v_arr_push_a(a, arr, _agnosai_mcp_resource_of(a, vec_get(defs, i)));
    }
    var r = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, r, AGN_JK_RESOURCES, arr);
    return _agnosai_mcp_success(a, id, r);
}

# `resources/read` — the definition's own JSON, under MCP's `contents` envelope.
#
# **A missing resource is a JSON-RPC error, not an empty success.** MCP has no
# "isError" affordance here the way `tools/call` does, so the only way to say
# "no such resource" is the error channel; answering `contents: []` would read
# as "this resource exists and is empty".
fn _agnosai_mcp_resources_read(a, id, params, state): i64 {
    if (params == 0 || bayan_json_v_is_obj(params) == 0) {
        return _agnosai_mcp_error(a, id, AGNOSAI_MCP_INVALID_PARAMS,
          str_from_a(a, "params must be an object with a uri"));
    }
    var uri_v = bayan_json_v_obj_get(params, "uri");
    if (uri_v == 0 || bayan_json_v_is_str(uri_v) == 0) {
        return _agnosai_mcp_error(a, id, AGNOSAI_MCP_INVALID_PARAMS,
          str_from_a(a, "uri is required and must be a string"));
    }
    var uri = bayan_json_v_str(uri_v);
    var name = _agnosai_mcp_resource_name(a, uri);
    if (name == 0) {
        return _agnosai_mcp_error(a, id, AGNOSAI_MCP_INVALID_PARAMS,
          str_from_a(a, "unknown resource URI scheme"));
    }
    var def = agnosai_app_state_definition_get(state, name);
    if (def == 0) {
        return _agnosai_mcp_error(a, id, AGNOSAI_MCP_INVALID_PARAMS,
          str_from_a(a, "no such resource"));
    }

    var item = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, item, AGN_JK_URI, bayan_json_v_str_new_a(a, uri));
    bayan_json_v_obj_set_a(a, item, AGN_JK_MIME_TYPE,
      bayan_json_v_str_new_a(a, AGN_JV_APPLICATION_JSON));
    # `text`, not an inline object: MCP's contents item carries the payload as a
    # string, so the definition is serialized rather than nested.
    bayan_json_v_obj_set_a(a, item, AGN_JK_TEXT,
      bayan_json_v_str_new_a(a, bayan_json_v_build_a(a, agnosai_agent_to_value_a(a, def))));

    var arr = bayan_json_v_arr_new_a(a);
    bayan_json_v_arr_push_a(a, arr, item);
    var r = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, r, AGN_JK_CONTENTS, arr);
    return _agnosai_mcp_success(a, id, r);
}

fn _agnosai_mcp_result_text(a, result): Str {
    if (result == 0) { return AGN_JV_EMPTY; }
    if (bayan_json_v_is_str(result) == 1) { return bayan_json_v_str(result); }
    return bayan_json_v_build_a(a, result);
}

fn _agnosai_mcp_log_call(name: Str, success): i64 {
    if (sakshi_get_level() < SK_INFO) { return 0; }
    sakshi_log_kv(SK_INFO, "MCP tool call", 13, "tool", 4, str_data(name), str_len(name));
    return 0;
}

# --- The handler ----------------------------------------------------------

# `POST /mcp` — dispatch a JSON-RPC 2.0 request.
#
# **Every arm is HTTP 200**, including the unknown-method one: JSON-RPC carries
# its faults inside the envelope, and the oracle's return type
# (`Json<JsonRpcResponse>`) has no status to vary.
#
# `id` defaults to JSON **null** when absent — `req.id.clone().unwrap_or(Value::Null)`
# (`mcp.rs:53`) — and is echoed on every arm, errors included, because
# `JsonRpcResponse.id` is not `Option`.
fn agnosai_route_mcp_a(a, state, body: Str): i64 {
    var v = bayan_json_v_parse_buf_a(a, str_data(body), str_len(body));
    if (v == 0 || bayan_json_v_is_obj(v) == 0) {
        return agnosai_route_error_a(a, HTTP_BAD_REQUEST, str_from_a(a, "malformed JSON body"));
    }

    var method_v = bayan_json_v_obj_get(v, "method");
    if (method_v == 0 || bayan_json_v_is_str(method_v) == 0) {
        return agnosai_route_error_a(a, AGNOSAI_HTTP_UNPROCESSABLE,
          str_from_a(a, "body is not a valid JSON-RPC request"));
    }
    var method = bayan_json_v_str(method_v);

    var id = bayan_json_v_obj_get(v, "id");
    if (id == 0) { id = bayan_json_v_null_a(a); }

    if (str_eq_cstr(method, "initialize") == 1) {
        return agnosai_route_json_a(a, HTTP_OK, _agnosai_mcp_initialize(a, id));
    }
    if (str_eq_cstr(method, "tools/list") == 1) {
        return agnosai_route_json_a(a, HTTP_OK, _agnosai_mcp_tools_list(a, id, state));
    }
    if (str_eq_cstr(method, "tools/call") == 1) {
        return agnosai_route_json_a(a, HTTP_OK,
          _agnosai_mcp_tools_call(a, id, bayan_json_v_obj_get(v, "params"), state));
    }
    # Beyond the oracle's three — see ADR 015 and ADR 016.
    if (str_eq_cstr(method, "prompts/list") == 1) {
        return agnosai_route_json_a(a, HTTP_OK, _agnosai_mcp_prompts_list(a, id, state));
    }
    if (str_eq_cstr(method, "prompts/get") == 1) {
        return agnosai_route_json_a(a, HTTP_OK,
          _agnosai_mcp_prompts_get(a, id, bayan_json_v_obj_get(v, "params"), state));
    }
    if (str_eq_cstr(method, "resources/list") == 1) {
        return agnosai_route_json_a(a, HTTP_OK, _agnosai_mcp_resources_list(a, id, state));
    }
    if (str_eq_cstr(method, "resources/read") == 1) {
        return agnosai_route_json_a(a, HTTP_OK,
          _agnosai_mcp_resources_read(a, id, bayan_json_v_obj_get(v, "params"), state));
    }

    _agnosai_mcp_unknown(method);
    return agnosai_route_json_a(a, HTTP_OK,
      _agnosai_mcp_error(a, id, AGNOSAI_MCP_METHOD_NOT_FOUND, str_from_a(a, "Method not found")));
}

# Global-allocator form of `agnosai_route_mcp_a`.
#
# **Threaded end to end, parse tree included** — the JSON-RPC envelope, the
# result tree, every tool schema behind `tools/list`, and the agent
# definitions behind `resources/list` all land in the request arena. Safe
# because `/mcp` retains nothing: `tools/call` executes and returns, and the
# resource routes read `AppState` without storing into it.
#
# The two logging helpers keep their bare shape deliberately — they allocate
# nothing, so an allocator parameter would be noise on a hot guard.
fn agnosai_route_mcp(state, body: Str): i64 {
    return agnosai_route_mcp_a(default_alloc(), state, body);
}

fn _agnosai_mcp_unknown(method: Str): i64 {
    if (sakshi_get_level() < SK_WARN) { return 0; }
    sakshi_log_kv(SK_WARN, "MCP unknown method", 18, "method", 6,
      str_data(method), str_len(method));
    return 0;
}
