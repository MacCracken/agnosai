# =========================================================================
# server/routes/dashboard — crew history and agent performance summaries.
#
# Parity oracle: rust-old/src/server/routes/dashboard.rs
#
# ## The read guard does not port, and the difference is visible
#
# Both oracle handlers open with `state.orchestrator.state().read().await` and
# then walk `active_crews.values()` while holding that guard — so they see one
# consistent snapshot of every crew.
#
# Holding the equivalent mutex across the whole walk would stall every worker
# thread's crew lookups for the duration of a dashboard render, which is the
# same trade `tools_registry.list` and `server_state`'s definitions snapshot
# already refused. So `agnosai_orchestrator_crew_ids` takes the id list under
# the lock and this walks it unlocked, fetching each state as it goes.
#
# **The observable consequence**: a crew that is removed between the id snapshot
# and its fetch is skipped rather than rendered. A crew whose state *changes*
# mid-walk renders its newer value, where the oracle would have rendered the
# value as of the guard. Both are dashboard reads of live data that is stale the
# moment it is serialized, so neither matters — but the port is not pretending
# to the oracle's consistency, and a reader should know which one they have.
#
# ## `{:?}` again, not serde
#
# `status: format!("{:?}", c.status)` is the derived `Debug`, so the dashboard
# emits the **capitalized** variant name — `Completed`, not the `completed` that
# `agnosai_crew_status_to_wire` produces for every other endpoint. Reproduced
# because it is wire-visible, and given its own renderer so the two spellings
# cannot be confused at a call site.
# =========================================================================

# This tier's own wire vocabulary, minted once at startup — the `Debug`
# spellings, the two dashboard-only keys, and the empty string the metadata
# reader answers with. Everything else these routes emit is already hoisted in
# `core/json.cyr` or `core/crew.cyr`; see the banner on the former.
#
# **These two routes are where it matters most.** Both loop over every
# registered crew, so a literal in a loop body costs one allocation per crew:
# `GET /api/v1/dashboard/crews` made 160 allocations against the eight-crew
# bench fixture, and six per crew — five keys and the status spelling — were
# literals like these.
#
# Deliberately capitalized: see the `{:?}` note in the banner.
var AGN_JV_D_RUNNING = str_from("Running");
var AGN_JV_D_COMPLETED = str_from("Completed");
var AGN_JV_D_FAILED = str_from("Failed");
var AGN_JV_D_CANCELLED = str_from("Cancelled");
var AGN_JV_D_PENDING = str_from("Pending");

var AGN_JK_AGENT = str_from("agent");
var AGN_JK_AGENT_NAME = str_from("agent_name");
var AGN_JK_AGENT_ROLE = str_from("agent_role");
var AGN_JK_AGENT_KEY = str_from("agent_key");
var AGN_JK_TOOL_COUNT = str_from("tool_count");

# The `Debug` spelling of a crew status — capitalized variant names.
#
# Deliberately NOT `agnosai_crew_status_to_wire`, which is the serde
# `rename_all = "snake_case"` spelling every other route uses. This one exists
# only because `dashboard.rs` formats with `{:?}`.
#
# `a` is unused — the answer is a process-lifetime `Str`. The parameter stays
# because the bare form below delegates through it.
fn _agnosai_route_status_debug_a(a, status): i64 {
    if (status == AGNOSAI_CREW_RUNNING) { return AGN_JV_D_RUNNING; }
    if (status == AGNOSAI_CREW_COMPLETED) { return AGN_JV_D_COMPLETED; }
    if (status == AGNOSAI_CREW_FAILED) { return AGN_JV_D_FAILED; }
    if (status == AGNOSAI_CREW_CANCELLED) { return AGN_JV_D_CANCELLED; }
    return AGN_JV_D_PENDING;
}

# Global-allocator form of `_agnosai_route_status_debug_a`.
#
# A wire spelling per crew per request. Same residual class the llm bite hit —
# invisible against the tree until the tree stops allocating.
fn _agnosai_route_status_debug(status): i64 {
    return _agnosai_route_status_debug_a(default_alloc(), status);
}

# `GET /api/v1/dashboard/crews` — a summary per registered crew.
#
# `wall_ms` and `cost_usd` are `map_or(0, ..)` / `map_or(0.0, ..)` over an
# absent profile, matching the oracle exactly: a crew that has not finished has
# no profile and reports zeros rather than being omitted.
#
# **`cost_usd` is rendered from integer micro-USD**, the representation the port
# carries end to end (see `server_prometheus`). The oracle's field is an f64 and
# this is the wire boundary where it becomes one, so the conversion happens here
# and nowhere earlier.
fn agnosai_route_crew_history_a(a, state): i64 {
    var o = agnosai_app_state_orchestrator(state);
    var ids = agnosai_orchestrator_crew_ids_a(a, o);
    var arr = bayan_json_v_arr_new_a(a);

    for (var i = 0; i < vec_len(ids); i = i + 1) {
        var c = agnosai_orchestrator_crew(o, vec_get(ids, i));
        # Skipped rather than rendered when the crew left between the snapshot
        # and this fetch — see the module header.
        if (c != 0) {
            var obj = bayan_json_v_obj_new_a(a);
            bayan_json_v_obj_set_a(a, obj, AGN_JK_CREW_ID,
              bayan_json_v_str_new_a(a, agnosai_crew_state_crew_id(c)));
            bayan_json_v_obj_set_a(a, obj, AGN_JK_STATUS,
              bayan_json_v_str_new_a(a,
                _agnosai_route_status_debug_a(a, agnosai_crew_state_status(c))));
            bayan_json_v_obj_set_a(a, obj, AGN_JK_TASK_COUNT,
              bayan_json_v_int_new_a(a, vec_len(agnosai_crew_state_results(c))));

            var prof = agnosai_crew_state_profile(c);
            var wall = 0;
            var micro = 0;
            if (prof != 0) {
                wall = agnosai_crew_profile_wall_ms(prof);
                micro = agnosai_crew_profile_cost_micro_usd(prof);
            }
            bayan_json_v_obj_set_a(a, obj, AGN_JK_WALL_MS,
              bayan_json_v_int_new_a(a, wall));
            bayan_json_v_obj_set_a(a, obj, AGN_JK_COST_USD,
              bayan_json_v_float_new_a(a, agnosai_micro_usd_to_f64(micro)));
            bayan_json_v_arr_push_a(a, arr, obj);
        }
    }
    return agnosai_route_json_a(a, HTTP_OK, arr);
}

# Global-allocator form of `agnosai_route_crew_history_a`.
#
# Cost scales with the registry: an id vec, then five keys, five value nodes and
# an object per crew. At the 1,000-crew retention cap that is a five-figure byte
# count per render on a route a dashboard polls.
fn agnosai_route_crew_history(state): i64 {
    return agnosai_route_crew_history_a(default_alloc(), state);
}

# `GET /api/v1/dashboard/agents` — one summary per distinct agent seen in a
# crew result, in first-seen order.
#
# The oracle builds a `HashSet` of agent keys and pushes only on first insert,
# so a repeated agent appears once. `name` falls back to the agent key and
# `role` to the empty string when the metadata does not carry them, and
# **`tool_count` is hardcoded 0** in the oracle — not derived from anything.
# Reproduced rather than "fixed": the field is wire-visible and a dashboard
# consumer reading a real count would be reading something the Rust never sent.
fn agnosai_route_agent_performance_a(a, state): i64 {
    var o = agnosai_app_state_orchestrator(state);
    var ids = agnosai_orchestrator_crew_ids_a(a, o);
    var seen = map_new_str_a(a);
    var arr = bayan_json_v_arr_new_a(a);
    for (var i = 0; i < vec_len(ids); i = i + 1) {
        var c = agnosai_orchestrator_crew(o, vec_get(ids, i));
        if (c != 0) {
            var results = agnosai_crew_state_results(c);
            for (var j = 0; j < vec_len(results); j = j + 1) {
                var meta = agnosai_task_result_metadata(vec_get(results, j));
                var key = _agnosai_route_meta_str_a(a, meta, AGN_JK_AGENT);
                # The oracle's `if let Some(agent_key) = .. && seen.insert(..)`:
                # no agent key, or one already recorded, contributes nothing.
                if (str_len(key) > 0 && map_has(seen, key) == 0) {
                    map_set(seen, str_clone_a(a, key), 1);
                    var obj = bayan_json_v_obj_new_a(a);
                    bayan_json_v_obj_set_a(a, obj, AGN_JK_AGENT_KEY,
                      bayan_json_v_str_new_a(a, key));

                    var name = _agnosai_route_meta_str_a(a, meta, AGN_JK_AGENT_NAME);
                    if (str_len(name) == 0) { name = key; }
                    bayan_json_v_obj_set_a(a, obj, AGN_JK_NAME,
                      bayan_json_v_str_new_a(a, name));
                    bayan_json_v_obj_set_a(a, obj, AGN_JK_ROLE,
                      bayan_json_v_str_new_a(a,
                        _agnosai_route_meta_str_a(a, meta, AGN_JK_AGENT_ROLE)));
                    # Hardcoded 0 in the oracle. See the fn header.
                    bayan_json_v_obj_set_a(a, obj, AGN_JK_TOOL_COUNT,
                      bayan_json_v_int_new_a(a, 0));
                    bayan_json_v_arr_push_a(a, arr, obj);
                }
            }
        }
    }
    return agnosai_route_json_a(a, HTTP_OK, arr);
}

# Global-allocator form of `agnosai_route_agent_performance_a`.
#
# Cost scales with **task results**, not crews: the metadata lookup runs three
# times per result across every crew in the registry, and only the first sighting
# of an agent key emits an object. So a registry of long crews pays the lookups
# and renders almost nothing — which is the shape that makes the un-threaded
# version's waste invisible in the response size.
fn agnosai_route_agent_performance(state): i64 {
    return agnosai_route_agent_performance_a(default_alloc(), state);
}

# A string member of a result's metadata, or "" — the oracle's
# `.get(k).and_then(|v| v.as_str())`, where a non-string is the same as absent.
#
# **`agnosai_task_result_metadata` is a stdlib Str-keyed `map`, not a bayan
# JSON object**, mirroring the oracle's `HashMap<String, serde_json::Value>`:
# the container is a map and only the *values* are JSON. So the lookup is
# `map_get`, and `bayan_json_v_obj_get` — which is what the shape of the
# surrounding code invites — silently finds nothing.
fn _agnosai_route_meta_str_a(a, meta, key: Str): Str {
    if (meta == 0) { return AGN_JV_EMPTY; }
    var v = map_get(meta, key);
    if (v == 0) { return AGN_JV_EMPTY; }
    if (bayan_json_v_is_str(v) == 0) { return AGN_JV_EMPTY; }
    return bayan_json_v_str(v);
}

# Global-allocator form of `_agnosai_route_meta_str_a`.
#
# The absent/wrong-type arms mint a Str; the found arm borrows the value's own.
# So the empty-string paths are the allocating ones, and they are the paths a
# result with no agent metadata takes three times over.
fn _agnosai_route_meta_str(meta, key: Str): Str {
    return _agnosai_route_meta_str_a(default_alloc(), meta, key);
}
