# =========================================================================
# server/router — the route table, path matching, and the auth boundary.
#
# Parity oracle: rust-old/src/server/mod.rs
#
# **Bite 15a of 2.** This is the router's *decision*: given a method, a path, an
# `Authorization` header and a body, which handler runs, whether auth gates it
# first, and what comes back. It touches **no sandhi** and is therefore fully
# testable — which matters because `mod.rs` has **no `#[cfg(test)]` module at
# all**, so every routing rule below is covered here for the first time.
#
# Bite 15b is the sandhi adapter — `sandhi_server_run_pooled`, the per-worker
# arena (blocker #3), the `alloc_used()`-flat regression test, and the a2a
# callback dispatch — tracked in docs/development/state.md and
# CHANGELOG [Unreleased].
#
# ## The auth boundary is the security-critical part of this file
#
# `mod.rs:79-88` nests everything under `/api/v1` plus the bare `/mcp` inside a
# `middleware::from_fn(auth_middleware)`, and merges that into a public router
# carrying `/health`, `/ready` and `/metrics`. So:
#
#   * **`/health`, `/ready`, `/metrics` are ALWAYS public** — no auth, even when
#     auth is enabled. `/metrics` being unauthenticated is worth knowing rather
#     than discovering: it exposes crew counts, task counts and inference cost.
#   * **Everything else requires auth when it is enabled**, including `/mcp`,
#     which is not under `/api/v1` and so is easy to miss when transcribing.
#
# A path that matches nothing is a 404 **without** consulting auth, matching
# axum: the router resolves the route before any layer runs, so an unauthorized
# request to a nonexistent path is a 404, not a 401. That is an information
# disclosure the oracle accepts, and the port reproduces it.
#
# ## Path parameters
#
# axum's `{id}` / `{name}` segments match exactly one non-empty segment and do
# not span `/`. `_agnosai_route_match` implements that literally, and the
# extracted value is handed to the handler which validates it — `get_crew`
# answers 422 for a malformed UUID, not 404, because axum's `Path<Uuid>`
# extractor runs after routing.
# =========================================================================

# The oracle's `MAX_BODY_BYTES` (`mod.rs:38`) — 10 MiB.
var AGNOSAI_MAX_BODY_BYTES = 10485760;

# The oracle's `MAX_CONCURRENT_REQUESTS` (`mod.rs:41`).
#
# **sandhi has no `ConcurrencyLimitLayer` analogue.** tower's layer queues
# requests above the limit rather than rejecting them; sandhi's pooled server
# bounds concurrency by its worker count instead, which is a different shape —
# it bounds work in flight but does not queue. Carried as a constant so the
# transport bite (15b) can size its worker pool against the oracle's intent
# rather than inventing a number, and so the divergence is stated rather than
# silently dropped.
var AGNOSAI_MAX_CONCURRENT_REQUESTS = 100;

# --- Route identifiers ----------------------------------------------------
#
# One per entry in the oracle's table. An enum rather than fn pointers because
# the handlers have different arities — some take state, some take a body, some
# take a path parameter, some take nothing.

enum AgnosaiRouteId {
    AGN_ROUTE_NONE = 0;
    AGN_ROUTE_HEALTH = 1;
    AGN_ROUTE_READY = 2;
    AGN_ROUTE_METRICS = 3;
    AGN_ROUTE_MCP = 4;
    AGN_ROUTE_CREATE_CREW = 5;
    AGN_ROUTE_GET_CREW = 6;
    AGN_ROUTE_CANCEL_CREW = 7;
    AGN_ROUTE_CREW_STREAM = 8;
    AGN_ROUTE_A2A_RECEIVE = 9;
    AGN_ROUTE_A2A_STATUS = 10;
    AGN_ROUTE_LIST_DEFINITIONS = 11;
    AGN_ROUTE_CREATE_DEFINITION = 12;
    AGN_ROUTE_LIST_TOOLS = 13;
    AGN_ROUTE_REMOVE_TOOL = 14;
    AGN_ROUTE_LIST_PENDING = 15;
    AGN_ROUTE_SUBMIT_APPROVAL = 16;
    AGN_ROUTE_LIST_PRESETS = 17;
    AGN_ROUTE_CREW_HISTORY = 18;
    AGN_ROUTE_AGENT_PERFORMANCE = 19;
}

# HTTP methods the table distinguishes.
var AGNOSAI_METHOD_GET = 1;
var AGNOSAI_METHOD_POST = 2;
var AGNOSAI_METHOD_DELETE = 3;

# A resolved route: which handler, and the path parameter if the pattern had one.
enum AgnosaiRouteMatchOff {
    AGN_RM_ID = 0;
    AGN_RM_PARAM = 8;
    AGN_RM_METHOD_MISMATCH = 16;
    AGN_ROUTE_MATCH_SIZE = 24;
}

# The resolved route, or `AGN_ROUTE_NONE` when nothing matched.
fn agnosai_route_match_id(m): i64 { return load64(m + AGN_RM_ID); }
# The captured path parameter, or 0 for a route that takes none.
fn agnosai_route_match_param(m): i64 { return load64(m + AGN_RM_PARAM); }

# Whether the path matched a known route but the method did not — axum answers
# **405**, not 404, when a path exists under a different method.
fn agnosai_route_match_method_mismatch(m): i64 {
    return load64(m + AGN_RM_METHOD_MISMATCH);
}

fn _agnosai_rm_new_a(a, id, param, mismatch): i64 {
    var m = alloc_via(a, AGN_ROUTE_MATCH_SIZE);
    store64(m + AGN_RM_ID, id);
    store64(m + AGN_RM_PARAM, param);
    store64(m + AGN_RM_METHOD_MISMATCH, mismatch);
    return m;
}

# Global-allocator form of `_agnosai_rm_new_a`.
fn _agnosai_rm_new(id, param, mismatch): i64 {
    return _agnosai_rm_new_a(default_alloc(), id, param, mismatch);
}

# --- Path matching --------------------------------------------------------

# Whether `path`, read from byte `start`, matches `pattern` — a `/`-joined
# literal where a segment of exactly `*` is a parameter. On a match with a
# parameter the captured value is stored through `out_param`, allocated from `a`.
#
# **Allocation-free apart from the capture, and that is the point.** The obvious
# implementation splits both sides into vecs of Str and compares them — which
# allocates a fresh vec plus a Str per segment for the *pattern* on every check,
# and a request that matches nothing walks the whole table. Measured at
# **4,352 bytes per request** of pure garbage on the no-free global bump, more
# than the entire `/health` handler costs (720 B). This walks both sides in
# place instead and allocates only the captured parameter, on the one pattern
# that matches.
#
# `start` points at the leading `/` of the portion being matched. It is what
# lets `agnosai_route_resolve` consume `/api/v1` **once** rather than
# re-verifying it on each of the twelve routes beneath it.
#
# A parameter matches exactly one **non-empty** segment and never spans `/`,
# which is axum's `{id}` behaviour: `/crews//cancel` does not match
# `/crews/*/cancel`, and `/crews/a/b/cancel` does not either. A trailing slash
# is a distinct path — `/health/` has an empty final segment and `/health` does
# not — so the two never match each other.
fn _agnosai_path_matches_at(a, path: Str, start, pattern, out_param): i64 {
    var p = str_data(path);
    var n = str_len(path);
    store64(out_param, 0);

    # Skip exactly one leading `/` on each side.
    var pi = start;
    if (n > start && (load8(p + start) & 255) == 47) { pi = start + 1; }
    var qi = 0;
    if ((load8(pattern) & 255) == 47) { qi = 1; }

    # `has` is "there is another segment to read", which is NOT the same as
    # "there are bytes left": after consuming a separator at the end of the
    # path there is one more, empty, segment.
    var p_has = 0;
    if (pi < n) { p_has = 1; }
    var q_has = 0;
    if ((load8(pattern + qi) & 255) != 0) { q_has = 1; }

    # Where the `*` segment sat, materialised only on a full match.
    var cap_at = 0 - 1;
    var cap_len = 0;

    while (1 == 1) {
        if (p_has == 0 && q_has == 0) {
            if (cap_at >= 0) { store64(out_param, str_sub_a(a, path, cap_at, cap_len)); }
            return 1;
        }
        if (p_has == 0 || q_has == 0) { return 0; }

        var pe = pi;
        while (pe < n && (load8(p + pe) & 255) != 47) { pe = pe + 1; }
        var qe = qi;
        while ((load8(pattern + qe) & 255) != 0 && (load8(pattern + qe) & 255) != 47) {
            qe = qe + 1;
        }
        var plen = pe - pi;
        var qlen = qe - qi;

        if (qlen == 1 && (load8(pattern + qi) & 255) == 42) {
            if (plen == 0) { return 0; }
            # ⚠ The capture is REMEMBERED, not materialised — `str_sub_a` runs
            # once, at the bottom, only if the whole pattern matched. It used to
            # allocate here, so every pattern that matched its `*` and then failed
            # a later segment left a Str behind: `POST /api/v1/crews/abc/cancel`
            # is tried against `/api/v1/crews/*` first, captures "abc", fails on
            # the trailing segment, and allocates again on the next pattern.
            cap_at = pi;
            cap_len = plen;
        } else {
            if (plen != qlen) { return 0; }
            for (var k = 0; k < plen; k = k + 1) {
                if ((load8(p + pi + k) & 255) != (load8(pattern + qi + k) & 255)) {
                    return 0;
                }
            }
        }

        if (pe >= n) { p_has = 0; } else { pi = pe + 1; }
        if ((load8(pattern + qe) & 255) == 0) { q_has = 0; } else { qi = qe + 1; }
    }
    return 0;
}

# Global-allocator form of `_agnosai_path_matches_at`, matching a whole path.
fn _agnosai_path_matches(path: Str, pattern, out_param): i64 {
    return _agnosai_path_matches_at(default_alloc(), path, 0, pattern, out_param);
}

# The offset of the `/` that begins whatever follows the literal `prefix`, or
# -1 when `path` does not continue past it.
#
# `/api/v1/tools` against `/api/v1` gives **7** — the index of the `/` before
# `tools`. **`/api/v1` itself gives -1**, because nothing follows and no route
# is the bare prefix; and so does `/api/v1x/tools`, because the prefix ends on a
# segment boundary.
#
# The boundary check is a filter like `_agnosai_seg_is` — see that function's
# header for why removing it changes no route, only which patterns are tried.
fn _agnosai_path_prefix_end(path: Str, prefix): i64 {
    var p = str_data(path);
    var n = str_len(path);
    var i = 0;
    while ((load8(prefix + i) & 255) != 0) {
        if (i >= n) { return 0 - 1; }
        if ((load8(p + i) & 255) != (load8(prefix + i) & 255)) { return 0 - 1; }
        i = i + 1;
    }
    if (i >= n) { return 0 - 1; }
    if ((load8(p + i) & 255) != 47) { return 0 - 1; }
    return i;
}

# Whether the path segment beginning at `at` — which points at that segment's
# leading `/` — is exactly `lit`. What follows the segment is not considered.
#
# **This is a filter, not a decision, and the difference is the safety argument
# for the whole two-level structure.** `_agnosai_seg_is` and
# `_agnosai_path_prefix_end` choose which patterns get *tried*; what a trial
# *answers* is still `_agnosai_path_matches_at` comparing the path against a
# pattern in full. So neither selector can route a request somewhere it does not
# belong — the worst either can do is waste time entering a group that cannot
# match, or skip a fast path.
#
# That is not a hopeful reading. `_t_resolve_is_equivalent` runs this resolver
# against the flat sixteen-attempt table it replaced, and **making this function
# a bare prefix test — `/crewsX` answering 1 for `crews` — changes no answer it
# produces.** Nor does dropping the segment-boundary check in
# `_agnosai_path_prefix_end`, which is why `/api/v1Xtools` still 404s: the
# selector would enter the tools group, and `/tools` would then fail to match
# `Xtools`. Both are pinned by their own unit assertions in `server_router`
# instead, because what they protect is the **cost**, not the routing.
fn _agnosai_seg_is(path: Str, at, lit): i64 {
    var p = str_data(path);
    var n = str_len(path);
    var i = at + 1;
    var j = 0;
    while ((load8(lit + j) & 255) != 0) {
        if (i >= n) { return 0; }
        if ((load8(p + i) & 255) != (load8(lit + j) & 255)) { return 0; }
        i = i + 1;
        j = j + 1;
    }
    if (i >= n) { return 1; }
    if ((load8(p + i) & 255) == 47) { return 1; }
    return 0;
}

# Resolve a method and path to a route, allocating the match from `a`.
#
# The table is the oracle's, in its order. `/api/v1` is written out rather than
# modelled as a `nest`, because the port has one flat table and nesting is only
# a way of writing a prefix.
#
# ## Two levels, not sixteen attempts
#
# This was a flat list: sixteen `_agnosai_path_matches` calls in table order,
# every one starting from byte 0. `/api/v1/dashboard/crews` matched on attempt
# **sixteen**, having re-compared the segments `api` and `v1` twelve times on
# the way — and a request that matches nothing paid all sixteen. Measured at
# **1.675 us**, which was 57% of the cheapest threaded request's total.
#
# So `/api/v1` is consumed once, and the segment after it selects a group of at
# most four patterns. The groups are disjoint by construction — their first
# segments are distinct literals — which is what makes the split preserve table
# order: within a group the original order is kept, and across groups no two
# patterns can both match. **`seen` is preserved for the same reason**: a path
# under `/api/v1` cannot match a public pattern, so splitting the 405-vs-404
# decision between the two arms cannot change it.
#
# The selection is a **filter over which patterns are tried**, never a decision
# about what they answer — so the fast path cannot route a request anywhere the
# flat table would not have. `_t_resolve_is_equivalent` holds both resolvers to
# that, on id, captured parameter and the 405-vs-404 flag, for every path in the
# table plus every near-miss that could cross a group boundary, under all four
# method values including the 0 that every unmapped verb resolves to.
fn agnosai_route_resolve_a(a, method, path: Str): i64 {
    var param = alloc_via(a, 8);
    var seen = 0;

    var api = _agnosai_path_prefix_end(path, "/api/v1");
    if (api >= 0) {
        if (_agnosai_seg_is(path, api, "crews") == 1) {
            if (_agnosai_path_matches_at(a, path, api, "/crews", param) == 1) {
                seen = 1;
                if (method == AGNOSAI_METHOD_POST) {
                    return _agnosai_rm_new_a(a, AGN_ROUTE_CREATE_CREW, 0, 0);
                }
            }
            if (_agnosai_path_matches_at(a, path, api, "/crews/*", param) == 1) {
                seen = 1;
                if (method == AGNOSAI_METHOD_GET) {
                    return _agnosai_rm_new_a(a, AGN_ROUTE_GET_CREW, load64(param), 0);
                }
            }
            if (_agnosai_path_matches_at(a, path, api, "/crews/*/cancel", param) == 1) {
                seen = 1;
                if (method == AGNOSAI_METHOD_POST) {
                    return _agnosai_rm_new_a(a, AGN_ROUTE_CANCEL_CREW, load64(param), 0);
                }
            }
            if (_agnosai_path_matches_at(a, path, api, "/crews/*/stream", param) == 1) {
                seen = 1;
                if (method == AGNOSAI_METHOD_GET) {
                    return _agnosai_rm_new_a(a, AGN_ROUTE_CREW_STREAM, load64(param), 0);
                }
            }
        }
        if (_agnosai_seg_is(path, api, "a2a") == 1) {
            if (_agnosai_path_matches_at(a, path, api, "/a2a/receive", param) == 1) {
                seen = 1;
                if (method == AGNOSAI_METHOD_POST) {
                    return _agnosai_rm_new_a(a, AGN_ROUTE_A2A_RECEIVE, 0, 0);
                }
            }
            if (_agnosai_path_matches_at(a, path, api, "/a2a/status", param) == 1) {
                seen = 1;
                # POST, not GET — the oracle registers `post(routes::a2a::status)`.
                if (method == AGNOSAI_METHOD_POST) {
                    return _agnosai_rm_new_a(a, AGN_ROUTE_A2A_STATUS, 0, 0);
                }
            }
        }
        if (_agnosai_seg_is(path, api, "agents") == 1) {
            if (_agnosai_path_matches_at(a, path, api, "/agents/definitions", param) == 1) {
                seen = 1;
                if (method == AGNOSAI_METHOD_GET) {
                    return _agnosai_rm_new_a(a, AGN_ROUTE_LIST_DEFINITIONS, 0, 0);
                }
                if (method == AGNOSAI_METHOD_POST) {
                    return _agnosai_rm_new_a(a, AGN_ROUTE_CREATE_DEFINITION, 0, 0);
                }
            }
        }
        if (_agnosai_seg_is(path, api, "tools") == 1) {
            if (_agnosai_path_matches_at(a, path, api, "/tools", param) == 1) {
                seen = 1;
                if (method == AGNOSAI_METHOD_GET) {
                    return _agnosai_rm_new_a(a, AGN_ROUTE_LIST_TOOLS, 0, 0);
                }
            }
            if (_agnosai_path_matches_at(a, path, api, "/tools/*", param) == 1) {
                seen = 1;
                if (method == AGNOSAI_METHOD_DELETE) {
                    return _agnosai_rm_new_a(a, AGN_ROUTE_REMOVE_TOOL, load64(param), 0);
                }
            }
        }
        if (_agnosai_seg_is(path, api, "approvals") == 1) {
            if (_agnosai_path_matches_at(a, path, api, "/approvals", param) == 1) {
                seen = 1;
                if (method == AGNOSAI_METHOD_GET) {
                    return _agnosai_rm_new_a(a, AGN_ROUTE_LIST_PENDING, 0, 0);
                }
                if (method == AGNOSAI_METHOD_POST) {
                    return _agnosai_rm_new_a(a, AGN_ROUTE_SUBMIT_APPROVAL, 0, 0);
                }
            }
        }
        if (_agnosai_seg_is(path, api, "presets") == 1) {
            if (_agnosai_path_matches_at(a, path, api, "/presets", param) == 1) {
                seen = 1;
                if (method == AGNOSAI_METHOD_GET) {
                    return _agnosai_rm_new_a(a, AGN_ROUTE_LIST_PRESETS, 0, 0);
                }
            }
        }
        if (_agnosai_seg_is(path, api, "dashboard") == 1) {
            if (_agnosai_path_matches_at(a, path, api, "/dashboard/crews", param) == 1) {
                seen = 1;
                if (method == AGNOSAI_METHOD_GET) {
                    return _agnosai_rm_new_a(a, AGN_ROUTE_CREW_HISTORY, 0, 0);
                }
            }
            if (_agnosai_path_matches_at(a, path, api, "/dashboard/agents", param) == 1) {
                seen = 1;
                if (method == AGNOSAI_METHOD_GET) {
                    return _agnosai_rm_new_a(a, AGN_ROUTE_AGENT_PERFORMANCE, 0, 0);
                }
            }
        }

        # Path known, method not — axum answers 405 rather than 404.
        if (seen == 1) { return _agnosai_rm_new_a(a, AGN_ROUTE_NONE, 0, 1); }
        return _agnosai_rm_new_a(a, AGN_ROUTE_NONE, 0, 0);
    }

    # Not under `/api/v1`: the three public probes, and `/mcp`, which is
    # protected and is NOT under /api/v1 — easy to miss.
    if (_agnosai_path_matches_at(a, path, 0, "/health", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_GET) {
            return _agnosai_rm_new_a(a, AGN_ROUTE_HEALTH, 0, 0);
        }
    }
    if (_agnosai_path_matches_at(a, path, 0, "/ready", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_GET) {
            return _agnosai_rm_new_a(a, AGN_ROUTE_READY, 0, 0);
        }
    }
    if (_agnosai_path_matches_at(a, path, 0, "/metrics", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_GET) {
            return _agnosai_rm_new_a(a, AGN_ROUTE_METRICS, 0, 0);
        }
    }
    if (_agnosai_path_matches_at(a, path, 0, "/mcp", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_POST) {
            return _agnosai_rm_new_a(a, AGN_ROUTE_MCP, 0, 0);
        }
    }

    if (seen == 1) { return _agnosai_rm_new_a(a, AGN_ROUTE_NONE, 0, 1); }
    return _agnosai_rm_new_a(a, AGN_ROUTE_NONE, 0, 0);
}

# Global-allocator form of `agnosai_route_resolve_a`.
#
# The match struct and the parameter buffer were the **entire** remaining
# per-request allocation of every arena-threaded read route — 32 bytes, or 64
# where a `{id}` segment made the matcher capture a Str. Threading it is what
# takes those routes to zero.
fn agnosai_route_resolve(method, path: Str): i64 {
    return agnosai_route_resolve_a(default_alloc(), method, path);
}

# --- The auth boundary ----------------------------------------------------

# Whether a resolved route sits behind the auth middleware.
#
# The oracle's structure inverted into a predicate: everything under
# `/api/v1` **plus `/mcp`** is protected; the three probes are not. Written as
# an explicit allow-list of the *public* routes rather than of the protected
# ones, so a route added to the table without thought defaults to **protected**
# — the safe direction.
fn agnosai_route_needs_auth(id): i64 {
    if (id == AGN_ROUTE_HEALTH) { return 0; }
    if (id == AGN_ROUTE_READY) { return 0; }
    if (id == AGN_ROUTE_METRICS) { return 0; }
    if (id == AGN_ROUTE_NONE) { return 0; }
    return 1;
}

# --- Dispatch -------------------------------------------------------------

# Route and run a request, returning the handler's response.
#
# `body` is the raw request body; `auth_header` / `has_auth` are the
# `Authorization` header as `server_auth` expects them.
#
# Order is the oracle's, and each step's status is the one axum produces:
#   1. **413** if the body exceeds `MAX_BODY_BYTES` — `DefaultBodyLimit` is the
#      outermost layer, so it fires before routing and therefore before auth.
#   2. **404** / **405** from routing, which happens *before* any middleware —
#      so an unauthenticated request to a nonexistent path is 404, not 401.
#   3. **401** (or 500) from auth, for protected routes only.
#   4. the handler.
# Dispatch with a per-request arena.
#
# **`a` may be 0**, and every caller must tolerate that: sandhi only supplies a
# request arena when `sandhi_server_options_req_arena` is configured, and the
# direct-dispatch callers (tests, and anything driving the router without the
# transport) pass 0 deliberately. A route threading `a` therefore uses the
# `_a` form only when it is non-zero and its bare twin otherwise — the two emit
# byte-identical wire, which is what lets this land without an ADR.
#
# The arena's lifetime is sandhi's: it is reset after the response is written,
# so anything a route allocates in it is valid for exactly as long as the reply
# that carries it, and no longer.
fn agnosai_route_dispatch_a(a, state, method, path: Str, auth_header: Str, has_auth,
body: Str): i64 {
    return _agnosai_route_dispatch_inner(a, state, method, path, auth_header, has_auth, body);
}

# Global-allocator form of `agnosai_route_dispatch_a`.
fn agnosai_route_dispatch(state, method, path: Str, auth_header: Str, has_auth, body: Str): i64 {
    return _agnosai_route_dispatch_inner(0, state, method, path, auth_header, has_auth, body);
}

fn _agnosai_route_dispatch_inner(a, state, method, path: Str, auth_header: Str, has_auth,
body: Str): i64 {
    # `a` of 0 means "no per-request arena" and every allocation below falls
    # back to the global bump — the un-threaded caller's path, kept working
    # rather than made a special case at each site.
    var al = a;
    if (al == 0) { al = default_alloc(); }

    if (str_len(body) > AGNOSAI_MAX_BODY_BYTES) {
        return agnosai_route_error_a(al, HTTP_PAYLOAD_TOO_LARGE,
        str_from_a(al, "request body exceeds the 10 MiB limit"));
    }

    var m = agnosai_route_resolve_a(al, method, path);
    var id = agnosai_route_match_id(m);
    if (id == AGN_ROUTE_NONE) {
        if (agnosai_route_match_method_mismatch(m) == 1) {
            return agnosai_route_error_a(al, HTTP_METHOD_NOT_ALLOWED,
            str_from_a(al, "method not allowed"));
        }
        return agnosai_route_error_a(al, HTTP_NOT_FOUND, str_from_a(al, "not found"));
    }

    if (agnosai_route_needs_auth(id) == 1) {
        var st = agnosai_auth_check(agnosai_app_state_auth(state), has_auth, auth_header);
        if (st != HTTP_OK) {
            return agnosai_route_error_a(al, st, str_from_a(al, "unauthorized"));
        }
    }

    var param = agnosai_route_match_param(m);
    if (id == AGN_ROUTE_HEALTH) { return agnosai_route_health(); }
    if (id == AGN_ROUTE_READY) { return agnosai_route_ready(); }
    if (id == AGN_ROUTE_METRICS) { return agnosai_route_metrics(); }
    if (id == AGN_ROUTE_MCP) {
        if (a != 0) { return agnosai_route_mcp_a(a, state, body); }
        return agnosai_route_mcp(state, body);
    }
    if (id == AGN_ROUTE_CREATE_CREW) {
        if (a != 0) { return agnosai_route_create_crew_a(a, state, body); }
        return agnosai_route_create_crew(state, body);
    }
    if (id == AGN_ROUTE_GET_CREW) {
        if (a != 0) { return agnosai_route_get_crew_a(a, state, param); }
        return agnosai_route_get_crew(state, param);
    }
    if (id == AGN_ROUTE_CANCEL_CREW) { return agnosai_route_cancel_crew(state, param); }
    if (id == AGN_ROUTE_A2A_RECEIVE) {
        if (a != 0) { return agnosai_route_a2a_receive_a(a, state, body); }
        return agnosai_route_a2a_receive(state, body);
    }
    if (id == AGN_ROUTE_A2A_STATUS) { return agnosai_route_a2a_status(); }
    if (id == AGN_ROUTE_LIST_DEFINITIONS) {
        if (a != 0) { return agnosai_route_list_definitions_a(a, state); }
        return agnosai_route_list_definitions(state);
    }
    if (id == AGN_ROUTE_CREATE_DEFINITION) {
        if (a != 0) { return agnosai_route_create_definition_a(a, state, body); }
        return agnosai_route_create_definition(state, body);
    }
    if (id == AGN_ROUTE_LIST_TOOLS) {
        if (a != 0) { return agnosai_route_list_tools_a(a, state); }
        return agnosai_route_list_tools(state);
    }
    if (id == AGN_ROUTE_REMOVE_TOOL) { return agnosai_route_remove_tool(state, param); }
    if (id == AGN_ROUTE_LIST_PENDING) {
        if (a != 0) { return agnosai_route_list_pending_a(a, state); }
        return agnosai_route_list_pending(state);
    }
    if (id == AGN_ROUTE_SUBMIT_APPROVAL) {
        if (a != 0) { return agnosai_route_submit_approval_a(a, state, body); }
        return agnosai_route_submit_approval(state, body);
    }
    # ⚠ The arena arm was MISSING here until 2026-08-11, and this was the only id
    # in the ladder with an `_a` form that went unwired — every neighbour above
    # and below carries one. `agnosai_route_list_presets_a` has existed since
    # M10; the effect was that `GET /api/v1/presets` parsed all 18 preset
    # documents onto the no-free global bump on every request instead of the
    # per-request arena, so the memory was never reclaimed. That is the exact
    # failure CLAUDE.md's "thread the `_a` allocator variants" rule exists to
    # prevent, and it is a heavier route than most: `benches/definitions.bcyr`
    # measures the parse at ~744us per request.
    if (id == AGN_ROUTE_LIST_PRESETS) {
        if (a != 0) { return agnosai_route_list_presets_a(a); }
        return agnosai_route_list_presets();
    }
    if (id == AGN_ROUTE_CREW_HISTORY) {
        if (a != 0) { return agnosai_route_crew_history_a(a, state); }
        return agnosai_route_crew_history(state);
    }
    if (id == AGN_ROUTE_AGENT_PERFORMANCE) {
        if (a != 0) { return agnosai_route_agent_performance_a(a, state); }
        return agnosai_route_agent_performance(state);
    }

    # `/api/v1/crews/{id}/stream` **is implemented** — as a stream, which this
    # function cannot express: `agnosai_route_dispatch` returns a status plus a
    # finished body, and an SSE response has neither until the crew ends.
    #
    # `agnosai_serve_handler` therefore intercepts the route *before* calling
    # here (`src/server/serve.cyr`) and hands the connection to
    # `agnosai_sse_crew_stream`. **Over the transport this line is unreachable.**
    #
    # It stays as the answer for a caller that dispatches directly — a `.tcyr`,
    # or any future non-streaming context — because 501 is the honest reply
    # there: the route exists, and *this* path has no handler for it. A 404
    # would say the endpoint is not part of the API, which is a different and
    # wrong statement.
    return agnosai_route_error(HTTP_NOT_IMPLEMENTED,  #skip-lint: HTTP 501 status code
    str_from("crew streaming is unavailable in this build"));
}
