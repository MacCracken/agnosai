# =========================================================================
# core/resource — hardware devices, requirements, inventories and budgets.
#
# Parity oracle: rust-old/src/core/resource.rs
#
# Port notes (divergences from the Rust shape, all deliberate):
#   * **Money is integer micro-USD** (user decision, 2026-07-28). The oracle's
#     `max_cost_usd: Option<f64>` becomes an i64 count of millionths of a
#     dollar, so a crew's cost path accumulates exactly with no float drift.
#     Serialization still goes out through an f64 under the *same* wire name
#     `max_cost_usd`, so bayan's Grisu2 emits the shortest round-tripping form —
#     `0.0025`, byte-identical to serde. (The port plan predicted a `0.002500`
#     divergence; routing through f64 only at the boundary avoids it while
#     keeping arithmetic exact.)
#   * `Option<u64>` / `Option<usize>` fields use **-1 for None**. Every one of
#     them is a non-negative count or limit, so the sentinel is unambiguous and
#     keeps these structs allocation-free.
#   * The `#[cfg(feature = "hwaccel")]` half of the oracle is **ported**, at the
#     bottom of this file: `AcceleratorType::from_hwaccel`,
#     `HardwareInventory::detect` / `from_hwaccel`, and `TrainingMemoryEstimate`
#     with its three methods. A cargo feature gate is not a scope boundary, and
#     `[deps.ai-hwaccel]` was already vendored.
#
#     ⚠ The oracle's ten `pub use ai_hwaccel::{...}` **re-exports have no
#     counterpart and need none.** They exist so a Rust caller can name
#     `QuantizationLevel` without depending on ai-hwaccel directly; Cyrius has
#     ONE flat namespace, so `QUANT_FP16`, `TRAIN_LORA`, `est_total_x1000` and
#     the rest are already visible to every consumer. Re-exporting would mean
#     defining duplicate symbols, which is the one thing the flat namespace
#     punishes.
# =========================================================================

# Broad accelerator family for requirement matching.
enum AgnosaiAcceleratorFamily {
    AGNOSAI_FAMILY_CPU = 0;
    AGNOSAI_FAMILY_GPU = 1;
    AGNOSAI_FAMILY_NPU = 2;
    AGNOSAI_FAMILY_TPU = 3;
    AGNOSAI_FAMILY_AI_ASIC = 4;
}

# Hardware accelerator type — the oracle's 6 broad categories.
enum AgnosaiAcceleratorType {
    AGNOSAI_ACCEL_CPU = 0;
    AGNOSAI_ACCEL_CUDA = 1;
    AGNOSAI_ACCEL_ROCM = 2;
    AGNOSAI_ACCEL_METAL = 3;
    AGNOSAI_ACCEL_VULKAN = 4;
    AGNOSAI_ACCEL_TPU = 5;
}

# Micro-USD per whole dollar — the money scale factor.
var AGNOSAI_MICRO_USD_PER_USD = 1000000;

# ComputeDevice heap layout — 40 bytes.
enum AgnosaiComputeDeviceOff {
    AGN_DEV_INDEX = 0;
    AGN_DEV_NAME = 8;
    AGN_DEV_ACCELERATOR = 16;
    AGN_DEV_MEMORY_TOTAL_MB = 24;
    AGN_DEV_MEMORY_AVAILABLE_MB = 32;
    AGN_DEV_SIZE = 40;
}

# HardwareRequirement heap layout — 40 bytes.
enum AgnosaiHwRequirementOff {
    AGN_REQ_ACCELERATORS = 0;
    AGN_REQ_MIN_MEMORY_MB = 8;
    AGN_REQ_MIN_DEVICE_COUNT = 16;
    AGN_REQ_MIN_CPU_CORES = 24;
    AGN_REQ_REQUIRED_FAMILY = 32;
    AGN_HW_REQ_SIZE = 40;
}

# HardwareInventory heap layout — 24 bytes.
enum AgnosaiHwInventoryOff {
    AGN_INV_CPU_CORES = 0;
    AGN_INV_MEMORY_TOTAL_MB = 8;
    AGN_INV_DEVICES = 16;
    AGN_INV_SIZE = 24;
}

# ResourceBudget heap layout — 32 bytes.
enum AgnosaiResourceBudgetOff {
    AGN_BUD_MAX_TOKENS = 0;
    AGN_BUD_MAX_COST_MICRO_USD = 8;
    AGN_BUD_MAX_DURATION_SECS = 16;
    AGN_BUD_MAX_CONCURRENT_TASKS = 24;
    AGN_BUD_SIZE = 32;
}

# GpuDevice heap layout — 32 bytes.
enum AgnosaiGpuDeviceOff {
    AGN_GPU_INDEX = 0;
    AGN_GPU_NAME = 8;
    AGN_GPU_VRAM_TOTAL_MB = 16;
    AGN_GPU_VRAM_AVAILABLE_MB = 24;
    AGN_GPU_SIZE = 32;
}

# The snake_case wire spelling of an accelerator family.
fn agnosai_accelerator_family_to_wire_a(a, family): i64 {
    if (family == AGNOSAI_FAMILY_GPU) { return str_from_a(a, "gpu"); }
    if (family == AGNOSAI_FAMILY_NPU) { return str_from_a(a, "npu"); }
    if (family == AGNOSAI_FAMILY_TPU) { return str_from_a(a, "tpu"); }
    if (family == AGNOSAI_FAMILY_AI_ASIC) { return str_from_a(a, "ai_asic"); }
    return str_from_a(a, "cpu");
}

# Global-allocator form of `agnosai_accelerator_family_to_wire_a`.
fn agnosai_accelerator_family_to_wire(family): i64 {
    return agnosai_accelerator_family_to_wire_a(default_alloc(), family);
}

# An accelerator family from its wire spelling. Unknown spellings read as Cpu.
fn agnosai_accelerator_family_from_wire(s: Str): i64 {
    if (str_eq_cstr(s, "gpu") == 1) { return AGNOSAI_FAMILY_GPU; }
    if (str_eq_cstr(s, "npu") == 1) { return AGNOSAI_FAMILY_NPU; }
    if (str_eq_cstr(s, "tpu") == 1) { return AGNOSAI_FAMILY_TPU; }
    if (str_eq_cstr(s, "ai_asic") == 1) { return AGNOSAI_FAMILY_AI_ASIC; }
    return AGNOSAI_FAMILY_CPU;
}

# The snake_case wire spelling of an accelerator type.
fn agnosai_accelerator_type_to_wire_a(a, accel): i64 {
    if (accel == AGNOSAI_ACCEL_CUDA) { return str_from_a(a, "cuda"); }
    if (accel == AGNOSAI_ACCEL_ROCM) { return str_from_a(a, "rocm"); }
    if (accel == AGNOSAI_ACCEL_METAL) { return str_from_a(a, "metal"); }
    if (accel == AGNOSAI_ACCEL_VULKAN) { return str_from_a(a, "vulkan"); }
    if (accel == AGNOSAI_ACCEL_TPU) { return str_from_a(a, "tpu"); }
    return str_from_a(a, "cpu");
}

# Global-allocator form of `agnosai_accelerator_type_to_wire_a`.
fn agnosai_accelerator_type_to_wire(accel): i64 {
    return agnosai_accelerator_type_to_wire_a(default_alloc(), accel);
}

# An accelerator type from its wire spelling. Unknown spellings read as Cpu.
fn agnosai_accelerator_type_from_wire(s: Str): i64 {
    if (str_eq_cstr(s, "cuda") == 1) { return AGNOSAI_ACCEL_CUDA; }
    if (str_eq_cstr(s, "rocm") == 1) { return AGNOSAI_ACCEL_ROCM; }
    if (str_eq_cstr(s, "metal") == 1) { return AGNOSAI_ACCEL_METAL; }
    if (str_eq_cstr(s, "vulkan") == 1) { return AGNOSAI_ACCEL_VULKAN; }
    if (str_eq_cstr(s, "tpu") == 1) { return AGNOSAI_ACCEL_TPU; }
    return AGNOSAI_ACCEL_CPU;
}

# Broad family an accelerator belongs to.
fn agnosai_accelerator_family_of(accel): i64 {
    if (accel == AGNOSAI_ACCEL_CPU) { return AGNOSAI_FAMILY_CPU; }
    if (accel == AGNOSAI_ACCEL_TPU) { return AGNOSAI_FAMILY_TPU; }
    return AGNOSAI_FAMILY_GPU;
}

# Whether this is a GPU variant.
fn agnosai_accelerator_is_gpu(accel): i64 {
    if (agnosai_accelerator_family_of(accel) == AGNOSAI_FAMILY_GPU) { return 1; }
    return 0;
}

# Whether this is a TPU variant.
fn agnosai_accelerator_is_tpu(accel): i64 {
    if (agnosai_accelerator_family_of(accel) == AGNOSAI_FAMILY_TPU) { return 1; }
    return 0;
}

# Create a new compute device. Available memory starts equal to total.
fn agnosai_compute_device_new(index, name: Str, accelerator, memory_total_mb): i64 {
    var d = alloc(AGN_DEV_SIZE);
    store64(d + AGN_DEV_INDEX, index);
    store64(d + AGN_DEV_NAME, name);
    store64(d + AGN_DEV_ACCELERATOR, accelerator);
    store64(d + AGN_DEV_MEMORY_TOTAL_MB, memory_total_mb);
    store64(d + AGN_DEV_MEMORY_AVAILABLE_MB, memory_total_mb);
    return d;
}

# Set the device's available memory. Returns the device so calls chain.
fn agnosai_compute_device_with_available(d, memory_available_mb): i64 {
    store64(d + AGN_DEV_MEMORY_AVAILABLE_MB, memory_available_mb);
    return d;
}

# Zero-based device index.
fn agnosai_compute_device_index(d): i64 {
    return load64(d + AGN_DEV_INDEX);
}

# Human-readable device name.
fn agnosai_compute_device_name(d): i64 {
    return load64(d + AGN_DEV_NAME);
}

# Accelerator type of this device.
fn agnosai_compute_device_accelerator(d): i64 {
    return load64(d + AGN_DEV_ACCELERATOR);
}

# Total device memory in megabytes.
fn agnosai_compute_device_memory_total_mb(d): i64 {
    return load64(d + AGN_DEV_MEMORY_TOTAL_MB);
}

# Available (free) device memory in megabytes.
fn agnosai_compute_device_memory_available_mb(d): i64 {
    return load64(d + AGN_DEV_MEMORY_AVAILABLE_MB);
}

# A compute device as a bayan JSON value.
fn agnosai_compute_device_to_value_a(a, d): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "index"), bayan_json_v_int_new_a(a, load64(d + AGN_DEV_INDEX)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "name"), bayan_json_v_str_new_a(a, load64(d + AGN_DEV_NAME)));
    var accel = agnosai_accelerator_type_to_wire_a(a, load64(d + AGN_DEV_ACCELERATOR));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "accelerator"), bayan_json_v_str_new_a(a, accel));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "memory_total_mb"),
      bayan_json_v_int_new_a(a, load64(d + AGN_DEV_MEMORY_TOTAL_MB)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "memory_available_mb"),
      bayan_json_v_int_new_a(a, load64(d + AGN_DEV_MEMORY_AVAILABLE_MB)));
    return obj;
}

# Global-allocator form of `agnosai_compute_device_to_value_a`.
fn agnosai_compute_device_to_value(d): i64 {
    return agnosai_compute_device_to_value_a(default_alloc(), d);
}

# Rebuild a compute device from a bayan JSON value, or 0 when not an object.
fn agnosai_compute_device_from_value(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var name = str_from("");
    var nv = bayan_json_v_obj_get(v, "name");
    if (nv != 0 && bayan_json_v_is_str(nv) == 1) { name = bayan_json_v_str(nv); }

    var accel = AGNOSAI_ACCEL_CPU;
    var av = bayan_json_v_obj_get(v, "accelerator");
    if (av != 0 && bayan_json_v_is_str(av) == 1) {
        accel = agnosai_accelerator_type_from_wire(bayan_json_v_str(av));
    }

    var d = agnosai_compute_device_new(_agnosai_int_field(v, "index", 0), name, accel,
      _agnosai_int_field(v, "memory_total_mb", 0));
    store64(d + AGN_DEV_MEMORY_AVAILABLE_MB,
      _agnosai_int_field(v, "memory_available_mb", load64(d + AGN_DEV_MEMORY_TOTAL_MB)));
    return d;
}

# An empty hardware requirement — matches anything, including CPU-only.
fn agnosai_hw_requirement_new_a(a): i64 {
    var r = alloc_via(a, AGN_HW_REQ_SIZE);
    store64(r + AGN_REQ_ACCELERATORS, vec_new_a(a));
    store64(r + AGN_REQ_MIN_MEMORY_MB, 0);
    store64(r + AGN_REQ_MIN_DEVICE_COUNT, 0);
    store64(r + AGN_REQ_MIN_CPU_CORES, 0);
    store64(r + AGN_REQ_REQUIRED_FAMILY, AGNOSAI_NO_LIMIT);
    return r;
}

# Global-allocator form of `agnosai_hw_requirement_new_a`.
fn agnosai_hw_requirement_new(): i64 {
    return agnosai_hw_requirement_new_a(default_alloc());
}

# A requirement for specific accelerator types. `accelerators` is a vec.
fn agnosai_hw_requirement_for_accelerators(accelerators): i64 {
    var r = agnosai_hw_requirement_new();
    store64(r + AGN_REQ_ACCELERATORS, accelerators);
    return r;
}

# Set minimum device memory in MB. Returns the requirement.
fn agnosai_hw_requirement_with_min_memory(r, mb): i64 {
    store64(r + AGN_REQ_MIN_MEMORY_MB, mb);
    return r;
}

# Set minimum device count. Returns the requirement.
fn agnosai_hw_requirement_with_min_devices(r, count): i64 {
    store64(r + AGN_REQ_MIN_DEVICE_COUNT, count);
    return r;
}

# Set minimum CPU cores. Returns the requirement.
fn agnosai_hw_requirement_with_min_cpu_cores(r, cores): i64 {
    store64(r + AGN_REQ_MIN_CPU_CORES, cores);
    return r;
}

# Set the required accelerator family. Returns the requirement.
fn agnosai_hw_requirement_with_family(r, family): i64 {
    store64(r + AGN_REQ_REQUIRED_FAMILY, family);
    return r;
}

# Vec of acceptable accelerator types (empty = any).
fn agnosai_hw_requirement_accelerators(r): i64 {
    return load64(r + AGN_REQ_ACCELERATORS);
}

# Minimum device memory in MB (0 = no requirement).
fn agnosai_hw_requirement_min_memory_mb(r): i64 {
    return load64(r + AGN_REQ_MIN_MEMORY_MB);
}

# Minimum number of devices needed (0 = no requirement).
fn agnosai_hw_requirement_min_device_count(r): i64 {
    return load64(r + AGN_REQ_MIN_DEVICE_COUNT);
}

# Minimum CPU cores (0 = no requirement).
fn agnosai_hw_requirement_min_cpu_cores(r): i64 {
    return load64(r + AGN_REQ_MIN_CPU_CORES);
}

# Required accelerator family, or AGNOSAI_NO_LIMIT when unset.
fn agnosai_hw_requirement_required_family(r): i64 {
    return load64(r + AGN_REQ_REQUIRED_FAMILY);
}

# A hardware requirement as a bayan JSON value. `required_family` is **omitted**
# rather than emitted as null when unset — the oracle marks that one field
# `skip_serializing_if = "Option::is_none"`.
fn agnosai_hw_requirement_to_value_a(a, r): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    var accels = load64(r + AGN_REQ_ACCELERATORS);
    var arr = bayan_json_v_arr_new_a(a);
    for (var i = 0; i < vec_len(accels); i = i + 1) {
        var w = agnosai_accelerator_type_to_wire_a(a, vec_get(accels, i));
        bayan_json_v_arr_push_a(a, arr, bayan_json_v_str_new_a(a, w));
    }
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "accelerators"), arr);
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "min_memory_mb"),
      bayan_json_v_int_new_a(a, load64(r + AGN_REQ_MIN_MEMORY_MB)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "min_device_count"),
      bayan_json_v_int_new_a(a, load64(r + AGN_REQ_MIN_DEVICE_COUNT)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "min_cpu_cores"),
      bayan_json_v_int_new_a(a, load64(r + AGN_REQ_MIN_CPU_CORES)));

    var fam = load64(r + AGN_REQ_REQUIRED_FAMILY);
    if (fam != AGNOSAI_NO_LIMIT) {
        bayan_json_v_obj_set_a(a, obj, str_from_a(a, "required_family"),
          bayan_json_v_str_new_a(a, agnosai_accelerator_family_to_wire_a(a, fam)));
    }
    return obj;
}

# Global-allocator form of `agnosai_hw_requirement_to_value_a`.
fn agnosai_hw_requirement_to_value(r): i64 {
    return agnosai_hw_requirement_to_value_a(default_alloc(), r);
}

# Rebuild a hardware requirement from a bayan JSON value. Every field is
# `#[serde(default)]` in the oracle, so missing ones take their defaults.
fn agnosai_hw_requirement_from_value_a(a, v): i64 {
    var r = agnosai_hw_requirement_new_a(a);
    if (bayan_json_v_is_obj(v) == 0) { return r; }

    var av = bayan_json_v_obj_get(v, "accelerators");
    if (av != 0 && bayan_json_v_is_arr(av) == 1) {
        var accels = load64(r + AGN_REQ_ACCELERATORS);
        for (var i = 0; i < bayan_json_v_arr_len(av); i = i + 1) {
            var e = bayan_json_v_arr_get(av, i);
            if (bayan_json_v_is_str(e) == 1) {
                vec_push_a(a, accels, agnosai_accelerator_type_from_wire(bayan_json_v_str(e)));
            }
        }
    }
    store64(r + AGN_REQ_MIN_MEMORY_MB, _agnosai_int_field(v, "min_memory_mb", 0));
    store64(r + AGN_REQ_MIN_DEVICE_COUNT, _agnosai_int_field(v, "min_device_count", 0));
    store64(r + AGN_REQ_MIN_CPU_CORES, _agnosai_int_field(v, "min_cpu_cores", 0));

    var fv = bayan_json_v_obj_get(v, "required_family");
    if (fv != 0 && bayan_json_v_is_str(fv) == 1) {
        store64(r + AGN_REQ_REQUIRED_FAMILY, agnosai_accelerator_family_from_wire(bayan_json_v_str(fv)));
    }
    return r;
}

# Global-allocator form of `agnosai_hw_requirement_from_value_a`.
#
# **This one borrows nothing from `v`.** Both string-valued members go through
# `agnosai_accelerator_type_from_wire` / `_family_from_wire`, which answer enum
# ints — so the requirement is self-contained however `v` was allocated, and the
# allocator here is only for its own struct and vec.
fn agnosai_hw_requirement_from_value(v): i64 {
    return agnosai_hw_requirement_from_value_a(default_alloc(), v);
}

# Create a hardware inventory. `devices` is a vec of compute devices.
fn agnosai_hw_inventory_new(cpu_cores, memory_total_mb, devices): i64 {
    var inv = alloc(AGN_INV_SIZE);
    store64(inv + AGN_INV_CPU_CORES, cpu_cores);
    store64(inv + AGN_INV_MEMORY_TOTAL_MB, memory_total_mb);
    store64(inv + AGN_INV_DEVICES, devices);
    return inv;
}

# Number of CPU cores available.
fn agnosai_hw_inventory_cpu_cores(inv): i64 {
    return load64(inv + AGN_INV_CPU_CORES);
}

# Total system memory in megabytes.
fn agnosai_hw_inventory_memory_total_mb(inv): i64 {
    return load64(inv + AGN_INV_MEMORY_TOTAL_MB);
}

# Vec of accelerator devices present on this node.
fn agnosai_hw_inventory_devices(inv): i64 {
    return load64(inv + AGN_INV_DEVICES);
}

# Vec of devices of a specific accelerator type.
fn agnosai_hw_inventory_devices_of_type(inv, accel): i64 {
    var out = vec_new();
    var devices = load64(inv + AGN_INV_DEVICES);
    for (var i = 0; i < vec_len(devices); i = i + 1) {
        var d = vec_get(devices, i);
        if (load64(d + AGN_DEV_ACCELERATOR) == accel) { vec_push(out, d); }
    }
    return out;
}

# Total device memory in MB across all devices of a type.
fn agnosai_hw_inventory_total_memory_mb(inv, accel): i64 {
    var total = 0;
    var matching = agnosai_hw_inventory_devices_of_type(inv, accel);
    for (var i = 0; i < vec_len(matching); i = i + 1) {
        total = total + load64(vec_get(matching, i) + AGN_DEV_MEMORY_TOTAL_MB);
    }
    return total;
}

# Whether any device in `matching` has at least `min_memory_mb` total memory.
fn _agnosai_any_device_meets_memory(matching, min_memory_mb): i64 {
    for (var i = 0; i < vec_len(matching); i = i + 1) {
        if (load64(vec_get(matching, i) + AGN_DEV_MEMORY_TOTAL_MB) >= min_memory_mb) { return 1; }
    }
    return 0;
}

# Whether this inventory satisfies a hardware requirement.
#
# The branch order is the oracle's and is observable: CPU cores first, then
# family-based matching (which returns outright), then specific-type matching.
# An empty `accelerators` list with no family means "anything satisfies".
fn agnosai_hw_inventory_satisfies(inv, req): i64 {
    var min_cores = load64(req + AGN_REQ_MIN_CPU_CORES);
    if (min_cores > 0 && load64(inv + AGN_INV_CPU_CORES) < min_cores) { return 0; }

    var min_count = load64(req + AGN_REQ_MIN_DEVICE_COUNT);
    var min_mem = load64(req + AGN_REQ_MIN_MEMORY_MB);
    var devices = load64(inv + AGN_INV_DEVICES);

    var family = load64(req + AGN_REQ_REQUIRED_FAMILY);
    if (family != AGNOSAI_NO_LIMIT) {
        var fam_match = vec_new();
        for (var i = 0; i < vec_len(devices); i = i + 1) {
            var d = vec_get(devices, i);
            if (agnosai_accelerator_family_of(load64(d + AGN_DEV_ACCELERATOR)) == family) {
                vec_push(fam_match, d);
            }
        }
        if (vec_len(fam_match) == 0) { return 0; }
        if (min_count > 0 && vec_len(fam_match) < min_count) { return 0; }
        if (min_mem > 0 && _agnosai_any_device_meets_memory(fam_match, min_mem) == 0) { return 0; }
        return 1;
    }

    var accels = load64(req + AGN_REQ_ACCELERATORS);
    if (vec_len(accels) == 0) { return 1; }

    var type_match = vec_new();
    for (var j = 0; j < vec_len(devices); j = j + 1) {
        var dev = vec_get(devices, j);
        if (vec_find(accels, load64(dev + AGN_DEV_ACCELERATOR)) >= 0) { vec_push(type_match, dev); }
    }
    if (min_count > 0 && vec_len(type_match) < min_count) { return 0; }
    if (min_mem > 0 && _agnosai_any_device_meets_memory(type_match, min_mem) == 0) { return 0; }
    if (vec_len(type_match) == 0) { return 0; }
    return 1;
}

# Create a resource budget. Pass AGNOSAI_NO_LIMIT for any unset field.
# `max_cost_micro_usd` is millionths of a dollar.
fn agnosai_resource_budget_new(max_tokens, max_cost_micro_usd, max_duration_secs,
  max_concurrent_tasks): i64 {
    var b = alloc(AGN_BUD_SIZE);
    store64(b + AGN_BUD_MAX_TOKENS, max_tokens);
    store64(b + AGN_BUD_MAX_COST_MICRO_USD, max_cost_micro_usd);
    store64(b + AGN_BUD_MAX_DURATION_SECS, max_duration_secs);
    store64(b + AGN_BUD_MAX_CONCURRENT_TASKS, max_concurrent_tasks);
    return b;
}

# The oracle's `Default`: no token, cost or duration ceiling, but at most 10
# concurrent tasks.
fn agnosai_resource_budget_default(): i64 {
    return agnosai_resource_budget_new(AGNOSAI_NO_LIMIT, AGNOSAI_NO_LIMIT, AGNOSAI_NO_LIMIT, 10);
}

# Maximum total LLM tokens, or AGNOSAI_NO_LIMIT.
fn agnosai_resource_budget_max_tokens(b): i64 {
    return load64(b + AGN_BUD_MAX_TOKENS);
}

# Maximum total cost in micro-USD, or AGNOSAI_NO_LIMIT.
fn agnosai_resource_budget_max_cost_micro_usd(b): i64 {
    return load64(b + AGN_BUD_MAX_COST_MICRO_USD);
}

# Maximum wall-clock seconds for the crew run, or AGNOSAI_NO_LIMIT.
fn agnosai_resource_budget_max_duration_secs(b): i64 {
    return load64(b + AGN_BUD_MAX_DURATION_SECS);
}

# Maximum number of concurrent crew executions, or AGNOSAI_NO_LIMIT.
fn agnosai_resource_budget_max_concurrent_tasks(b): i64 {
    return load64(b + AGN_BUD_MAX_CONCURRENT_TASKS);
}

# Micro-USD as the f64 dollar amount the wire carries.
fn agnosai_micro_usd_to_f64(micro): i64 {
    return f64_div(f64_from(micro), f64_from(AGNOSAI_MICRO_USD_PER_USD));
}

# An f64 dollar amount as micro-USD, rounded to the nearest millionth.
fn agnosai_f64_to_micro_usd(usd): i64 {
    return f64_to(f64_round(f64_mul(usd, f64_from(AGNOSAI_MICRO_USD_PER_USD))));
}

# A resource budget as a bayan JSON value. `max_cost_usd` keeps the oracle's
# wire name and goes out as a JSON number in dollars — bayan's Grisu2 emits the
# shortest round-tripping form, so 2500 micro-USD renders as `0.0025`, exactly
# as serde rendered the f64.
fn agnosai_resource_budget_to_value_a(a, b): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "max_tokens"),
      _agnosai_opt_int_to_value_a(a, load64(b + AGN_BUD_MAX_TOKENS)));

    var micro = load64(b + AGN_BUD_MAX_COST_MICRO_USD);
    var cost_v = bayan_json_v_null_a(a);
    if (micro != AGNOSAI_NO_LIMIT) {
        cost_v = bayan_json_v_float_new_a(a, agnosai_micro_usd_to_f64(micro));
    }
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "max_cost_usd"), cost_v);

    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "max_duration_secs"),
      _agnosai_opt_int_to_value_a(a, load64(b + AGN_BUD_MAX_DURATION_SECS)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "max_concurrent_tasks"),
      _agnosai_opt_int_to_value_a(a, load64(b + AGN_BUD_MAX_CONCURRENT_TASKS)));
    return obj;
}

# Global-allocator form of `agnosai_resource_budget_to_value_a`.
fn agnosai_resource_budget_to_value(b): i64 {
    return agnosai_resource_budget_to_value_a(default_alloc(), b);
}

# Rebuild a resource budget from a bayan JSON value. `max_cost_usd` is accepted
# as either a JSON float or a whole-dollar integer.
fn agnosai_resource_budget_from_value(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return agnosai_resource_budget_default(); }

    var micro = AGNOSAI_NO_LIMIT;
    var cv = bayan_json_v_obj_get(v, "max_cost_usd");
    if (cv != 0) {
        if (bayan_json_v_is_float(cv) == 1) {
            micro = agnosai_f64_to_micro_usd(bayan_json_v_float(cv));
        } elif (bayan_json_v_is_int(cv) == 1) {
            micro = bayan_json_v_int(cv) * AGNOSAI_MICRO_USD_PER_USD;
        }
    }

    return agnosai_resource_budget_new(_agnosai_opt_int_field(v, "max_tokens"), micro,
      _agnosai_opt_int_field(v, "max_duration_secs"),
      _agnosai_opt_int_field(v, "max_concurrent_tasks"));
}

# Create a GPU device with VRAM capacity information.
fn agnosai_gpu_device_new(index, name: Str, vram_total_mb, vram_available_mb): i64 {
    var g = alloc(AGN_GPU_SIZE);
    store64(g + AGN_GPU_INDEX, index);
    store64(g + AGN_GPU_NAME, name);
    store64(g + AGN_GPU_VRAM_TOTAL_MB, vram_total_mb);
    store64(g + AGN_GPU_VRAM_AVAILABLE_MB, vram_available_mb);
    return g;
}

# Zero-based GPU index.
fn agnosai_gpu_device_index(g): i64 {
    return load64(g + AGN_GPU_INDEX);
}

# GPU device name.
fn agnosai_gpu_device_name(g): i64 {
    return load64(g + AGN_GPU_NAME);
}

# Total VRAM in megabytes.
fn agnosai_gpu_device_vram_total_mb(g): i64 {
    return load64(g + AGN_GPU_VRAM_TOTAL_MB);
}

# Available (free) VRAM in megabytes.
fn agnosai_gpu_device_vram_available_mb(g): i64 {
    return load64(g + AGN_GPU_VRAM_AVAILABLE_MB);
}

# A GPU device as a bayan JSON value.
fn agnosai_gpu_device_to_value_a(a, g): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "index"), bayan_json_v_int_new_a(a, load64(g + AGN_GPU_INDEX)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "name"), bayan_json_v_str_new_a(a, load64(g + AGN_GPU_NAME)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "vram_total_mb"),
      bayan_json_v_int_new_a(a, load64(g + AGN_GPU_VRAM_TOTAL_MB)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "vram_available_mb"),
      bayan_json_v_int_new_a(a, load64(g + AGN_GPU_VRAM_AVAILABLE_MB)));
    return obj;
}

# Global-allocator form of `agnosai_gpu_device_to_value_a`.
fn agnosai_gpu_device_to_value(g): i64 {
    return agnosai_gpu_device_to_value_a(default_alloc(), g);
}

# Rebuild a GPU device from a bayan JSON value, or 0 when not an object.
fn agnosai_gpu_device_from_value(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var name = str_from("");
    var nv = bayan_json_v_obj_get(v, "name");
    if (nv != 0 && bayan_json_v_is_str(nv) == 1) { name = bayan_json_v_str(nv); }
    return agnosai_gpu_device_new(_agnosai_int_field(v, "index", 0), name,
      _agnosai_int_field(v, "vram_total_mb", 0), _agnosai_int_field(v, "vram_available_mb", 0));
}

# A hardware inventory as a bayan JSON value.
fn agnosai_hw_inventory_to_value_a(a, inv): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "cpu_cores"),
      bayan_json_v_int_new_a(a, load64(inv + AGN_INV_CPU_CORES)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "memory_total_mb"),
      bayan_json_v_int_new_a(a, load64(inv + AGN_INV_MEMORY_TOTAL_MB)));
    var devices = load64(inv + AGN_INV_DEVICES);
    var arr = bayan_json_v_arr_new_a(a);
    for (var i = 0; i < vec_len(devices); i = i + 1) {
        bayan_json_v_arr_push_a(a, arr, agnosai_compute_device_to_value_a(a, vec_get(devices, i)));
    }
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "devices"), arr);
    return obj;
}

# Global-allocator form of `agnosai_hw_inventory_to_value_a`.
fn agnosai_hw_inventory_to_value(inv): i64 {
    return agnosai_hw_inventory_to_value_a(default_alloc(), inv);
}

# Rebuild a hardware inventory from a bayan JSON value.
fn agnosai_hw_inventory_from_value(v): i64 {
    var devices = vec_new();
    if (bayan_json_v_is_obj(v) == 0) { return agnosai_hw_inventory_new(0, 0, devices); }
    var dv = bayan_json_v_obj_get(v, "devices");
    if (dv != 0 && bayan_json_v_is_arr(dv) == 1) {
        for (var i = 0; i < bayan_json_v_arr_len(dv); i = i + 1) {
            var d = agnosai_compute_device_from_value(bayan_json_v_arr_get(dv, i));
            if (d != 0) { vec_push(devices, d); }
        }
    }
    return agnosai_hw_inventory_new(_agnosai_int_field(v, "cpu_cores", 0),
      _agnosai_int_field(v, "memory_total_mb", 0), devices);
}

# --- hwaccel -------------------------------------------------------------
#
# The oracle's `#[cfg(feature = "hwaccel")]` half. Every body here is an
# ADAPTER over ai-hwaccel, never an implementation — the detection, the
# quantization policy and the training-memory model all live in the vendored
# library, and a second copy would drift from it silently. Same call
# `fleet/coordinator` made for `plan_sharding`.

# Bytes in a mebibyte and a gibibyte. ai-hwaccel reports device memory in bytes
# and the oracle's `ComputeDevice` carries megabytes, so the conversion is the
# oracle's `/ (1024 * 1024)` — MiB, not decimal MB.
var AGNOSAI_BYTES_PER_MB = 1048576;
var AGNOSAI_BYTES_PER_GB = 1073741824;

# One `cpu_set_t`, in bytes — 1024 CPUs, glibc's default ceiling.
var AGNOSAI_CPU_SET_BYTES = 128;

# Bits set in a 64-bit word.
fn _agnosai_popcount64(x): i64 {
    var n = 0;
    for (var i = 0; i < 64; i = i + 1) {
        if (((x >> i) & 1) == 1) { n = n + 1; }
    }
    return n;
}

# The oracle's `std::thread::available_parallelism().map(|p| p.get()).unwrap_or(1)`.
#
# ⚠ **The AFFINITY mask, not the machine's core count**, because that is what
# std answers on Linux: a process under `taskset -c 0-3` on a 64-core box gets
# 4, and so does one in a cgroup pinned the same way. Counting
# `/sys/devices/system/cpu/online` instead would answer 64 and over-provision
# every placement decision that reads `min_cpu_cores` — and it would look right
# on an unconstrained developer box, which is where it would be tested.
#
# ⚠ Falls back to **1**, never 0, matching `unwrap_or(1)`. A zero would make
# `agnosai_hw_inventory_satisfies` reject every requirement that names any CPU
# cores at all.
#
# `sched_getaffinity` is Linux-only and its number differs per ABI — x86-64 is
# 204, aarch64 is 123 — and a raw `syscall()` is NOT renumbered by the backend
# the way the `sys_*` wrappers are, so the number is selected here. Every other
# target takes the fallback, which is a real residual and not a silent one: the
# inventory reports one core rather than a wrong number.
# Bits set across the first `rc` BYTES of an affinity mask, or 1 when the
# syscall failed — the oracle's `unwrap_or(1)`.
#
# ⚠ Split out because the fallback is otherwise **unreachable on the platform
# that runs the tests**: this box is Linux x86, `sched_getaffinity` always
# succeeds, and a mutant changing the fallback from 1 to 0 survives every
# assertion. Taking `rc` and the mask as data makes both arms testable.
#
# ⚠ `rc` is a BYTE count, not a word count. Reading the whole 128-byte buffer
# regardless would count whatever the kernel did not write.
fn _agnosai_cores_from_affinity(rc, mask): i64 {
    if (rc > 0) {
        var cores = 0;
        for (var w = 0; w < rc / 8; w = w + 1) {
            cores = cores + _agnosai_popcount64(load64(mask + w * 8));
        }
        if (cores > 0) { return cores; }
    }
    return 1;
}

fn _agnosai_available_parallelism(): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    # ⚠ The size is a LITERAL 128, not `AGNOSAI_CPU_SET_BYTES` — a `var buf[N]`
    # needs a compile-time constant and a `var` will not do. Keep the two in step.
    var mask[128];
    for (var z = 0; z < AGNOSAI_CPU_SET_BYTES / 8; z = z + 1) {
        store64(&mask + z * 8, 0);
    }

    var rc = 0 - 1;
    #ifdef CYRIUS_ARCH_X86
    rc = syscall(204, 0, AGNOSAI_CPU_SET_BYTES, &mask);
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    rc = syscall(123, 0, AGNOSAI_CPU_SET_BYTES, &mask);
    #endif

    return _agnosai_cores_from_affinity(rc, &mask);
    #endif
    return 1;
}

# Narrow ai-hwaccel's accelerator type to the oracle's six.
#
# ⚠ **This is NOT a pass-through, and it looks like one.** ai-hwaccel numbers
# `ACCEL_TPU = 8` while `AGNOSAI_ACCEL_TPU = 5`; CPU/CUDA/ROCM/METAL/VULKAN are
# 0-4 on both sides and would survive a bare cast, so five of six values are
# right by coincidence and a TPU silently becomes an Intel NPU. ai-hwaccel has
# nineteen variants against these six.
#
# ⚠ Everything unmapped falls back to **CPU**, which is the oracle's choice and
# a deliberate one: an NPU or an ASIC is still usable, and answering `Cpu` keeps
# it from matching a GPU or TPU placement requirement it cannot serve. Answering
# some "other" value would make it match nothing at all, including CPU work.
fn agnosai_accelerator_type_from_hwaccel(hw): i64 {
    if (hw == ACCEL_CPU) { return AGNOSAI_ACCEL_CPU; }
    if (hw == ACCEL_CUDA) { return AGNOSAI_ACCEL_CUDA; }
    if (hw == ACCEL_ROCM) { return AGNOSAI_ACCEL_ROCM; }
    if (hw == ACCEL_METAL) { return AGNOSAI_ACCEL_METAL; }
    if (hw == ACCEL_VULKAN) { return AGNOSAI_ACCEL_VULKAN; }
    if (hw == ACCEL_TPU) { return AGNOSAI_ACCEL_TPU; }
    return AGNOSAI_ACCEL_CPU;
}

# Build a `HardwareInventory` from an ai-hwaccel registry.
#
# ⚠ The CPU profile is **not a device**. It is diverted into the inventory's
# `memory_total_mb` and `cpu_cores` and then `continue`d past, so a registry of
# one CPU profile yields an inventory with ZERO devices. Pushing it as a device
# instead would make `total_memory_mb` double-count and let a CPU satisfy a
# `devices_of_type` query for accelerators.
#
# ⚠ `index` is the position in the registry's profile list, NOT a count of
# devices pushed. The oracle enumerates before it filters, so a CPU profile at
# position 0 leaves the first real device with index 1 and a gap at 0.
#
# ⚠ `memory_free_bytes` is an Option upstream and `PROFILE_NONE` (-1) here;
# absent means "fall back to the total", not "zero available".
fn agnosai_hw_inventory_from_hwaccel(registry): i64 {
    var cpu_cores = 0;
    var memory_total_mb = 0;
    var devices = vec_new();

    var profiles = reg_profiles(registry);
    for (var i = 0; i < vec_len(profiles); i = i + 1) {
        var p = vec_get(profiles, i);
        var atype = profile_accel_type(p);
        var mem_mb = profile_memory_bytes(p) / AGNOSAI_BYTES_PER_MB;

        var free_bytes = profile_mem_free(p);
        if (free_bytes == PROFILE_NONE) { free_bytes = profile_memory_bytes(p); }
        var avail_mb = free_bytes / AGNOSAI_BYTES_PER_MB;

        if (atype == ACCEL_CPU) {
            memory_total_mb = mem_mb;
            cpu_cores = _agnosai_available_parallelism();
            continue;
        }

        vec_push(devices, agnosai_compute_device_with_available(
            agnosai_compute_device_new(i, str_from(accel_name(atype)),
              agnosai_accelerator_type_from_hwaccel(atype), mem_mb), avail_mb));
    }

    return agnosai_hw_inventory_new(cpu_cores, memory_total_mb, devices);
}

# Detect the host's hardware — the oracle's `HardwareInventory::detect`.
#
# ⚠ `registry_detect` shells out to `nvidia-smi` and friends. The oracle's
# `detect()` has **no test at all**, gated or otherwise, and neither does this:
# what it answers depends on the box. `from_hwaccel` above is the testable half
# and is where every assertion goes.
fn agnosai_hw_inventory_detect(): i64 {
    return agnosai_hw_inventory_from_hwaccel(registry_detect());
}

# TrainingMemoryEstimate heap layout — 32 bytes, four f64 bit patterns in GB.
#
# ⚠ GB as **f64**, matching the oracle's four `f64` fields — ai-hwaccel answers
# in x1000 fixed-point integers (`est_model_x1000` and friends), and storing
# those raw would make `total_gb` read 14000 for a 14 GB model. The conversion
# is one divide and it happens once, at construction.
enum AgnosaiTrainingMemOff {
    AGN_TRAINMEM_MODEL_GB = 0;
    AGN_TRAINMEM_OPTIMIZER_GB = 8;
    AGN_TRAINMEM_ACTIVATION_GB = 16;
    AGN_TRAINMEM_TOTAL_GB = 24;
    AGN_TRAINMEM_BYTES = 32;
}

# Estimate training memory — the oracle's `TrainingMemoryEstimate::estimate`.
#
# `model_params_millions` is millions (7000 for a 7B model), `method` is one of
# ai-hwaccel's `TRAIN_*` and `target` one of its `TARGET_*`.
fn agnosai_training_memory_estimate(model_params_millions, method, target): i64 {
    var e = estimate_training_memory(model_params_millions, method, target);
    var thousand = f64_from(1000);
    var t = alloc(AGN_TRAINMEM_BYTES);
    store64(t + AGN_TRAINMEM_MODEL_GB,
      f64_div(f64_from(est_model_x1000(e)), thousand));
    store64(t + AGN_TRAINMEM_OPTIMIZER_GB,
      f64_div(f64_from(est_optimizer_x1000(e)), thousand));
    store64(t + AGN_TRAINMEM_ACTIVATION_GB,
      f64_div(f64_from(est_activation_x1000(e)), thousand));
    store64(t + AGN_TRAINMEM_TOTAL_GB,
      f64_div(f64_from(est_total_x1000(e)), thousand));
    return t;
}

# Model weights, in GB.
fn agnosai_training_memory_model_gb(t): i64 {
    return load64(t + AGN_TRAINMEM_MODEL_GB);
}

# Optimizer state, in GB.
fn agnosai_training_memory_optimizer_gb(t): i64 {
    return load64(t + AGN_TRAINMEM_OPTIMIZER_GB);
}

# Activations, in GB.
fn agnosai_training_memory_activation_gb(t): i64 {
    return load64(t + AGN_TRAINMEM_ACTIVATION_GB);
}

# The three summed, in GB.
fn agnosai_training_memory_total_gb(t): i64 {
    return load64(t + AGN_TRAINMEM_TOTAL_GB);
}

# Whether the estimate fits in an inventory's total accelerator VRAM.
#
# ⚠ **DEVICE VRAM ONLY.** The sum walks `devices`, and the CPU profile never
# becomes a device — so an inventory with 512 GB of system RAM and no GPU fits
# nothing at all. That is the oracle's arithmetic and the right one for a
# training estimate, but `memory_total_mb` sitting right there makes the wrong
# version easy to write.
#
# ⚠ `<=`, so an estimate exactly equal to available VRAM FITS.
fn agnosai_training_memory_fits_in(t, inventory): i64 {
    var total_vram_gb = f64_from(0);
    var devices = agnosai_hw_inventory_devices(inventory);
    var mb_per_gb = f64_from(1024);
    for (var i = 0; i < vec_len(devices); i = i + 1) {
        total_vram_gb = f64_add(total_vram_gb, f64_div(
            f64_from(agnosai_compute_device_memory_total_mb(vec_get(devices, i))), mb_per_gb));
    }
    return f64_le(load64(t + AGN_TRAINMEM_TOTAL_GB), total_vram_gb);
}

# The total in bytes — GB x 1024^3, truncated, as the oracle's `as u64` is.
fn agnosai_training_memory_total_bytes(t): i64 {
    return f64_to(f64_mul(load64(t + AGN_TRAINMEM_TOTAL_GB),
        f64_from(AGNOSAI_BYTES_PER_GB)));
}
