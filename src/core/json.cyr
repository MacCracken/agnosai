# =========================================================================
# core/json — shared JSON field helpers for the core group.
#
# No oracle module. The Rust side gets these from serde derives; Cyrius has to
# spell them out, and by the third module needing them (task, resource, agent)
# the duplication had earned an extraction.
#
# Everything here is `_`-prefixed except the shared sentinel, so these stay out
# of the coverage denominator — they are plumbing, exercised through the
# modules that use them.
#
# Two bayan API hazards these encapsulate, both easy to get wrong:
#   * `bayan_json_v_obj_set` takes a **Str** key; `bayan_json_v_obj_get` takes
#     a **C string**. Mixing them up reads a Str header as text, or text as a
#     pointer — a segfault, not a clean error.
#   * A `_str`-suffixed name is a reserved overload slot (see the bayan 1.3.0
#     note in core_message.cyr), so nothing here is named `X_str`.
# =========================================================================

# The shared "absent" sentinel for optional numeric fields across core. Every
# such field is a non-negative count, limit or amount, so -1 is unambiguous and
# keeps the structs allocation-free where a tagged Option would not.
var AGNOSAI_NO_LIMIT = 0 - 1;

# --- Hoisted wire vocabulary ------------------------------------------------
#
# The enum spellings and object keys that more than one core serialiser emits,
# minted **once at startup** instead of once per serialisation.
#
# Measured, not assumed. `alloc_via` costs 15.1 ns whatever it is handed, so a
# `str_from_a(a, "completed")` inside a per-item loop costs one allocation per
# item on top of the JSON node it wraps. `GET /crews/{id}` makes 62 allocations
# and `GET /api/v1/dashboard/crews` makes 160; the literals reached from a loop
# body were a measurable share of both.
#
# **This is not the constant-return hoist state.md declines.** That proposal was
# 149 sites judged on *bytes* — 2.5% — against 121 new symbols. These are judged
# on *time*, and only where `benches/server.bcyr` shows the path is hot. The
# error-arm literals beside them stay as they are: a 400's message is built at
# most once per request, and only for a request that already failed.
#
# They live **here** rather than beside their serialisers because Cyrius resolves
# in a single pass and `core/json.cyr` is the first of the group's includes —
# `task`, `agent` and `crew` all spell the same statuses, and a global defined in
# any one of them would be invisible to the ones included earlier. One literal,
# one `Str`, one place to look.
#
# Safe to share: nothing mutates a wire string. Every consumer either `str_eq`s
# it or wraps it in a JSON value, and a process-lifetime `Str` is strictly safer
# than an arena one — it cannot dangle when the arena resets.
var AGN_JV_PENDING = str_from("pending");
var AGN_JV_QUEUED = str_from("queued");
var AGN_JV_RUNNING = str_from("running");
var AGN_JV_COMPLETED = str_from("completed");
var AGN_JV_FAILED = str_from("failed");
var AGN_JV_CANCELLED = str_from("cancelled");
var AGN_JV_IDLE = str_from("idle");
var AGN_JV_ASSIGNED = str_from("assigned");
var AGN_JV_WORKING = str_from("working");
var AGN_JV_BLOCKED = str_from("blocked");

var AGN_JK_ID = str_from("id");
var AGN_JK_NAME = str_from("name");
var AGN_JK_TASKS = str_from("tasks");
var AGN_JK_PROCESS = str_from("process");

# An Option<String> as a JSON value: the string, or null when unset.
#
# **The `_a` form is the real body throughout this file; the bare name delegates
# with `default_alloc()`.** bayan 1.4.0 (cyrius 6.5.5) completed the `_a` JSON
# surface, so a caller holding a per-request arena can now build a whole
# response tree on it — before that, every cell landed on the no-free global
# bump and stayed there for the life of the process.
fn _agnosai_opt_str_to_value_a(a, s): i64 {
    if (s == 0) { return bayan_json_v_null_a(a); }
    return bayan_json_v_str_new_a(a, s);
}

fn _agnosai_opt_str_to_value(s): i64 {
    return _agnosai_opt_str_to_value_a(default_alloc(), s);
}

# An optional count as a JSON value: the integer, or null when unset.
fn _agnosai_opt_int_to_value_a(a, n): i64 {
    if (n == AGNOSAI_NO_LIMIT) { return bayan_json_v_null_a(a); }
    return bayan_json_v_int_new_a(a, n);
}

fn _agnosai_opt_int_to_value(n): i64 {
    return _agnosai_opt_int_to_value_a(default_alloc(), n);
}

# Read an integer field, falling back to `fallback` when missing or non-integer.
fn _agnosai_int_field(v, key, fallback): i64 {
    var f = bayan_json_v_obj_get(v, key);
    if (f == 0) { return fallback; }
    if (bayan_json_v_is_int(f) == 0) { return fallback; }
    return bayan_json_v_int(f);
}

# Read an optional count, mapping a missing or null field to AGNOSAI_NO_LIMIT.
fn _agnosai_opt_int_field(v, key): i64 {
    var f = bayan_json_v_obj_get(v, key);
    if (f == 0) { return AGNOSAI_NO_LIMIT; }
    if (bayan_json_v_is_int(f) == 0) { return AGNOSAI_NO_LIMIT; }
    return bayan_json_v_int(f);
}

# A bool as the JSON literal serde emits.
fn _agnosai_bool_to_value_a(a, b): i64 {
    if (b == 1) { return bayan_json_v_bool_new_a(a, 1); }
    return bayan_json_v_bool_new_a(a, 0);
}

fn _agnosai_bool_to_value(b): i64 {
    return _agnosai_bool_to_value_a(default_alloc(), b);
}

# Read a bool field, defaulting to 0 when missing or non-bool.
fn _agnosai_bool_field(v, key): i64 {
    var f = bayan_json_v_obj_get(v, key);
    if (f == 0) { return 0; }
    if (bayan_json_v_is_bool(f) == 0) { return 0; }
    return bayan_json_v_bool(f);
}

# Read a Str field, or 0 when missing or non-string.
fn _agnosai_str_field(v, key): i64 {
    var f = bayan_json_v_obj_get(v, key);
    if (f == 0) { return 0; }
    if (bayan_json_v_is_str(f) == 0) { return 0; }
    return bayan_json_v_str(f);
}

# Serialize a Str-keyed map of JSON values into a bayan object.
#
# The VALUES are borrowed from the map, not copied — they are already JSON
# values. Only the object shell and its pair cells come from `a`, so a caller
# arena-ing this must not `reset_via` while the source map is still live.
# Number of SLOTS in a Str/cstr-keyed map — the walk bound, not the entry count.
#
# `map_keys` is the obvious way to iterate a map and it is wrong on an arena
# path: it materialises a key vec through `vec_new()` on the no-free GLOBAL bump
# and has no `_a` form to thread. Walking slots avoids the vec entirely, so it is
# both allocation-free and cheaper.
#
# These three wrap the **documented public layout** (`lib/hashmap.cyr:22-35`) —
# header `{entries_ptr, capacity, count, key_type}`, slot `{key_ptr, value,
# state}` at 24 bytes, `state == 1` occupied. They exist rather than being
# inlined at each call site because that layout belongs to **another module**: if
# hashmap ever changes its slot size, one wrong constant here is a silent
# mis-read, and it should have exactly one place to be wrong.
#
# **key_type 2 (u64) is a different, 16-byte slot with no state field.** The
# hashmap header says `map_keys` / `map_values` / `map_iter` do not work on it
# either; `_agnosai_map_slots` returns 0 for it so every walk is empty rather
# than reading values as states.
fn _agnosai_map_slots(m): i64 {
    if (load64(m + 24) == 2) { return 0; }
    return load64(m + 8);
}

# Is slot `i` occupied?
fn _agnosai_map_slot_live(m, i): i64 {
    if (load64(load64(m) + i * 24 + 16) == 1) { return 1; }
    return 0;
}

# The key Str at slot `i`. Only meaningful when `_agnosai_map_slot_live` is 1.
fn _agnosai_map_slot_key(m, i): i64 { return load64(load64(m) + i * 24); }

# The value at slot `i`. Only meaningful when `_agnosai_map_slot_live` is 1.
fn _agnosai_map_slot_val(m, i): i64 { return load64(load64(m) + i * 24 + 8); }

fn _agnosai_map_to_value_a(a, m): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    var n = _agnosai_map_slots(m);
    # **Stop once every live entry is out.** A slot walk is over *capacity*, not
    # size, and `map_new_str` starts at 16 — a task result's metadata is
    # typically one or two entries, so the loop was scanning 16 slots to emit
    # one. Measured at 195 ns for a single-entry map.
    var live = map_size(m);
    var emitted = 0;
    for (var i = 0; i < n && emitted < live; i = i + 1) {
        if (_agnosai_map_slot_live(m, i) == 1) {
            bayan_json_v_obj_set_a(a, obj, _agnosai_map_slot_key(m, i),
              _agnosai_map_slot_val(m, i));
            emitted = emitted + 1;
        }
    }
    return obj;
}

fn _agnosai_map_to_value(m): i64 {
    return _agnosai_map_to_value_a(default_alloc(), m);
}

# Rebuild a Str-keyed map of JSON values from a bayan object. A missing or
# non-object value yields an empty map, matching `#[serde(default)]`.
fn _agnosai_map_from_value(v): i64 {
    var m = map_new_str();
    if (v == 0) { return m; }
    if (bayan_json_v_is_obj(v) == 0) { return m; }
    for (var i = 0; i < bayan_json_v_obj_len(v); i = i + 1) {
        map_set(m, str_clone(bayan_json_v_obj_key(v, i)), bayan_json_v_obj_val(v, i));
    }
    return m;
}

# Serialize a vec of Str into a JSON array.
fn _agnosai_str_vec_to_value_a(a, v): i64 {
    var arr = bayan_json_v_arr_new_a(a);
    for (var i = 0; i < vec_len(v); i = i + 1) {
        bayan_json_v_arr_push_a(a, arr, bayan_json_v_str_new_a(a, vec_get(v, i)));
    }
    return arr;
}

fn _agnosai_str_vec_to_value(v): i64 {
    return _agnosai_str_vec_to_value_a(default_alloc(), v);
}

# Append every string element of a JSON array onto `dst`. A missing or
# non-array value appends nothing, matching `#[serde(default)]`.
fn _agnosai_str_vec_from_value(dst, v): i64 {
    if (v == 0) { return dst; }
    if (bayan_json_v_is_arr(v) == 0) { return dst; }
    for (var i = 0; i < bayan_json_v_arr_len(v); i = i + 1) {
        var e = bayan_json_v_arr_get(v, i);
        if (bayan_json_v_is_str(e) == 1) { vec_push(dst, bayan_json_v_str(e)); }
    }
    return dst;
}
