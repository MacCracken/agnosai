# =========================================================================
# core/json — shared JSON field helpers for the core group.
#
# No oracle module. The Rust side gets these from serde derives; Cyrius has to
# spell them out, and by the third module needing them (task, resource, agent)
# the duplication had earned an extraction.
#
# Everything here is `_`-prefixed except the shared sentinel, so these stay out
# of the coverage denominator — they are plumbing, exercised through the
# modules that use them.
#
# Two bayan API hazards these encapsulate, both easy to get wrong:
#   * `bayan_json_v_obj_set` takes a **Str** key; `bayan_json_v_obj_get` takes
#     a **C string**. Mixing them up reads a Str header as text, or text as a
#     pointer — a segfault, not a clean error.
#   * A `_str`-suffixed name is a reserved overload slot (see the bayan 1.3.0
#     note in core_message.cyr), so nothing here is named `X_str`.
# =========================================================================

# The shared "absent" sentinel for optional numeric fields across core. Every
# such field is a non-negative count, limit or amount, so -1 is unambiguous and
# keeps the structs allocation-free where a tagged Option would not.
var AGNOSAI_NO_LIMIT = 0 - 1;

# An Option<String> as a JSON value: the string, or null when unset.
fn _agnosai_opt_str_to_value(s): i64 {
    if (s == 0) { return bayan_json_v_null(); }
    return bayan_json_v_str_new(s);
}

# An optional count as a JSON value: the integer, or null when unset.
fn _agnosai_opt_int_to_value(n): i64 {
    if (n == AGNOSAI_NO_LIMIT) { return bayan_json_v_null(); }
    return bayan_json_v_int_new(n);
}

# Read an integer field, falling back to `fallback` when missing or non-integer.
fn _agnosai_int_field(v, key, fallback): i64 {
    var f = bayan_json_v_obj_get(v, key);
    if (f == 0) { return fallback; }
    if (bayan_json_v_is_int(f) == 0) { return fallback; }
    return bayan_json_v_int(f);
}

# Read an optional count, mapping a missing or null field to AGNOSAI_NO_LIMIT.
fn _agnosai_opt_int_field(v, key): i64 {
    var f = bayan_json_v_obj_get(v, key);
    if (f == 0) { return AGNOSAI_NO_LIMIT; }
    if (bayan_json_v_is_int(f) == 0) { return AGNOSAI_NO_LIMIT; }
    return bayan_json_v_int(f);
}

# A bool as the JSON literal serde emits.
fn _agnosai_bool_to_value(b): i64 {
    if (b == 1) { return bayan_json_v_bool_new(1); }
    return bayan_json_v_bool_new(0);
}

# Read a bool field, defaulting to 0 when missing or non-bool.
fn _agnosai_bool_field(v, key): i64 {
    var f = bayan_json_v_obj_get(v, key);
    if (f == 0) { return 0; }
    if (bayan_json_v_is_bool(f) == 0) { return 0; }
    return bayan_json_v_bool(f);
}

# Read a Str field, or 0 when missing or non-string.
fn _agnosai_str_field(v, key): i64 {
    var f = bayan_json_v_obj_get(v, key);
    if (f == 0) { return 0; }
    if (bayan_json_v_is_str(f) == 0) { return 0; }
    return bayan_json_v_str(f);
}

# Serialize a Str-keyed map of JSON values into a bayan object.
fn _agnosai_map_to_value(m): i64 {
    var obj = bayan_json_v_obj_new();
    var keys = map_keys(m);
    for (var i = 0; i < vec_len(keys); i = i + 1) {
        var k = vec_get(keys, i);
        bayan_json_v_obj_set(obj, k, map_get(m, k));
    }
    return obj;
}

# Rebuild a Str-keyed map of JSON values from a bayan object. A missing or
# non-object value yields an empty map, matching `#[serde(default)]`.
fn _agnosai_map_from_value(v): i64 {
    var m = map_new_str();
    if (v == 0) { return m; }
    if (bayan_json_v_is_obj(v) == 0) { return m; }
    for (var i = 0; i < bayan_json_v_obj_len(v); i = i + 1) {
        map_set(m, str_clone(bayan_json_v_obj_key(v, i)), bayan_json_v_obj_val(v, i));
    }
    return m;
}

# Serialize a vec of Str into a JSON array.
fn _agnosai_str_vec_to_value(v): i64 {
    var arr = bayan_json_v_arr_new();
    for (var i = 0; i < vec_len(v); i = i + 1) {
        bayan_json_v_arr_push(arr, bayan_json_v_str_new(vec_get(v, i)));
    }
    return arr;
}

# Append every string element of a JSON array onto `dst`. A missing or
# non-array value appends nothing, matching `#[serde(default)]`.
fn _agnosai_str_vec_from_value(dst, v): i64 {
    if (v == 0) { return dst; }
    if (bayan_json_v_is_arr(v) == 0) { return dst; }
    for (var i = 0; i < bayan_json_v_arr_len(v); i = i + 1) {
        var e = bayan_json_v_arr_get(v, i);
        if (bayan_json_v_is_str(e) == 1) { vec_push(dst, bayan_json_v_str(e)); }
    }
    return dst;
}
