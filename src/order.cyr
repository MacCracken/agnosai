# =========================================================================
# order — O(n log n) sorting and selection.
#
# No oracle module: Rust got these from `slice::sort_unstable` and
# `select_nth_unstable`. Cyrius's stdlib has neither, which is **port plan
# blocker #8** — and it is not a theoretical gap. Measured on this box at
# cyrius 6.4.83, an itihas-style insertion sort over agnosai's 100k-entry
# percentile vector (builtin/load_testing.rs) costs **52.6 seconds**; heapsort
# costs 87 ms, and three quickselects cost ~21 ms. Percentiles never needed a
# full sort in the first place.
#
# Design, per the plan:
#   * `agnosai_sort` is an **iterative in-place heapsort** — O(n log n) in the
#     *worst* case, O(1) extra memory, and no recursion, so it cannot blow the
#     stack on adversarial input the way a naive quicksort can. It is NOT
#     stable; no call site needs stability.
#   * `agnosai_select_nth` is a Hoare quickselect with median-of-3 pivoting,
#     also iterative. It partially reorders the vec and is the right tool when
#     you want a percentile rather than a full ordering.
#
# **Naming is load-bearing.** The plan calls for an `ai_*` prefix purely to stay
# clear of the flat namespace; this uses `agnosai_*` instead, which is strictly
# safer (it also clears ai-hwaccel's `ai_*` surface) and matches CLAUDE.md's
# rule for every public symbol. Never define a bare `vec_sort` — itihas exports
# that name unprefixed, and under the fold the last definition would win.
#
# Comparators are `fn(a, b): i64`, negative / zero / positive like C's qsort.
# =========================================================================

# Ascending order for plain i64 elements.
fn agnosai_cmp_i64_asc(a, b): i64 {
    if (a < b) { return 0 - 1; }
    if (a > b) { return 1; }
    return 0;
}

# Descending order for plain i64 elements.
fn agnosai_cmp_i64_desc(a, b): i64 {
    if (a < b) { return 1; }
    if (a > b) { return 0 - 1; }
    return 0;
}

# Swap two elements of a vec.
fn _agnosai_swap(v, i, j): i64 {
    var tmp = vec_get(v, i);
    vec_set(v, i, vec_get(v, j));
    vec_set(v, j, tmp);
    return 0;
}

# Sift `root` down through a heap of `size` elements. Iterative — a recursive
# sift is the usual shape, but it costs O(log n) stack per call and Cyrius has
# no tail-call guarantee.
fn _agnosai_sift_down(v, root, size, cmp): i64 {
    var parent = root;
    while (1 == 1) {
        var child = parent * 2 + 1;
        if (child >= size) { break; }

        # Pick the larger child. `>` (not `>=`) keeps the earlier sibling on a
        # tie, which costs nothing and makes the traversal deterministic.
        var right = child + 1;
        if (right < size) {
            if (callptr(cmp, vec_get(v, right), vec_get(v, child)) > 0) { child = right; }
        }

        if (callptr(cmp, vec_get(v, child), vec_get(v, parent)) <= 0) { break; }
        _agnosai_swap(v, parent, child);
        parent = child;
    }
    return 0;
}

# Sort a vec in place with `cmp`.
#
# Iterative in-place heapsort: build a max-heap bottom-up, then repeatedly swap
# the root to the end and re-sift. O(n log n) worst case, O(1) extra memory,
# no recursion. Not stable.
fn agnosai_sort(v, cmp): i64 {
    var n = vec_len(v);
    if (n < 2) { return 0; }

    for (var i = n / 2 - 1; i >= 0; i = i - 1) {
        _agnosai_sift_down(v, i, n, cmp);
    }
    for (var end = n - 1; end > 0; end = end - 1) {
        _agnosai_swap(v, 0, end);
        _agnosai_sift_down(v, 0, end, cmp);
    }
    return 0;
}

# Sort a vec of plain i64 ascending.
fn agnosai_sort_i64(v): i64 {
    return agnosai_sort(v, &agnosai_cmp_i64_asc);
}

# The median of the elements at lo, mid and hi — the pivot value for
# quickselect. Median-of-3 is what keeps already-sorted and reverse-sorted
# input off quickselect's O(n^2) path, which is the input shape a latency
# vector most often has.
fn _agnosai_median3(v, lo, hi, cmp): i64 {
    var mid = lo + (hi - lo) / 2;
    var a = vec_get(v, lo);
    var b = vec_get(v, mid);
    var c = vec_get(v, hi);

    if (callptr(cmp, a, b) > 0) {
        var t = a;
        a = b;
        b = t;
    }
    if (callptr(cmp, b, c) > 0) { b = c; }
    if (callptr(cmp, a, b) > 0) { b = a; }
    return b;
}

# Hoare-partition v[lo..hi] around `pivot`, returning the split index j such
# that everything at or below j compares <= everything above it.
fn _agnosai_partition(v, lo, hi, pivot, cmp): i64 {
    var i = lo - 1;
    var j = hi + 1;
    while (1 == 1) {
        i = i + 1;
        while (callptr(cmp, vec_get(v, i), pivot) < 0) { i = i + 1; }
        j = j - 1;
        while (callptr(cmp, vec_get(v, j), pivot) > 0) { j = j - 1; }
        if (i >= j) { return j; }
        _agnosai_swap(v, i, j);
    }
    return j;
}

# The k-th smallest element (0-based) under `cmp`, partially reordering the vec.
#
# Iterative Hoare quickselect with median-of-3. Returns 0 for an empty vec or an
# out-of-range k. Average O(n) — the reason percentiles do not need a full sort:
# three of these over 100k elements cost ~21 ms where sorting costs 87 ms.
fn agnosai_select_nth(v, k, cmp): i64 {
    var n = vec_len(v);
    if (n == 0) { return 0; }
    if (k < 0) { return 0; }
    if (k >= n) { return 0; }

    var lo = 0;
    var hi = n - 1;
    while (lo < hi) {
        var pivot = _agnosai_median3(v, lo, hi, cmp);
        var split = _agnosai_partition(v, lo, hi, pivot, cmp);
        if (k <= split) { hi = split; } else { lo = split + 1; }
    }
    return vec_get(v, k);
}

# The k-th smallest plain i64 (0-based).
fn agnosai_select_nth_i64(v, k): i64 {
    return agnosai_select_nth(v, k, &agnosai_cmp_i64_asc);
}

# The `p_milli`-th percentile of a vec of plain i64, where `p_milli` is
# thousandths of a percent-point — 95000 is p95, 99900 is p99.9.
#
# Integer milli-percent for the same reason money is micro-USD: p99.9 is a real
# SLO target and a float percentile argument would make the index computation
# depend on rounding. The index is `floor(p * (n - 1) / 100000)`, the standard
# nearest-rank-on-a-0-based-vector convention.
#
# Uses selection, not a sort — the vec is left partially reordered, which is
# fine for a latency sample and is what makes this O(n) instead of O(n log n).
# Returns 0 for an empty vec.
fn agnosai_percentile_i64(v, p_milli): i64 {
    var n = vec_len(v);
    if (n == 0) { return 0; }
    if (n == 1) { return vec_get(v, 0); }

    var p = p_milli;
    if (p < 0) { p = 0; }
    if (p > 100000) { p = 100000; }

    var idx = (p * (n - 1)) / 100000;
    return agnosai_select_nth_i64(v, idx);
}
