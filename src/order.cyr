# =========================================================================
# order — O(n log n) sorting and selection.
#
# No oracle module: Rust got these from `slice::sort_unstable` and
# `select_nth_unstable`. Cyrius's stdlib has neither, which is **port plan
# blocker #8** — and it is not a theoretical gap. Measured on this box at
# cyrius 6.4.83, an itihas-style insertion sort over agnosai's 100k-entry
# percentile vector (builtin/load_testing.rs) costs **52.6 seconds**; heapsort
# costs 87 ms, and three quickselects cost ~21 ms. Percentiles never needed a
# full sort in the first place.
#
# **The algorithms are no longer vendored here.** `vec_sort_by` and
# `vec_select_nth` shipped in cyrius **6.5.4**, closing agnosai's own filing
# (`2026-07-28-agnosai-no-nlogn-sort-in-stdlib`). This module keeps its public
# API and delegates. Measured on this box, 100k elements:
#
# | benchmark | vendored | stdlib | |
# |---|---|---|---|
# | `sort_100k` | 79.6 ms | **20.4 ms** | 3.90x |
# | `sort_10k` | 6.30 ms | **1.71 ms** | 3.69x |
# | `sort_100k_already_sorted` | 79.1 ms | **3.35 ms** | **23.6x** |
# | `three_percentiles_100k` | 10.7 ms | **7.88 ms** | 1.35x |
# | `select_nth_100k` | 6.89 ms | **5.18 ms** | 1.33x |
#
# The already-sorted row is the big one and it is a real difference in kind:
# heapsort's worst case equals its average, so it had no fast path. The stdlib
# introsort checks for pre-sorted input first. A latency vector that arrives
# roughly ordered — which is common — now costs a scan instead of a full sort.
#
# **What does NOT delegate is the guard set**, and that is deliberate:
# `vec_select_nth` **aborts the process** (`_vec_die()`) on `k < 0` or
# `k >= len`, where this module's contract — pinned by three assertions in
# `tests/order.tcyr` — is to return 0. An empty latency vector is an ordinary
# state for a load test that recorded no samples, not a reason to kill the
# server, so the wrappers keep their bounds checks and only the sorting is
# delegated.
#
# Comparators are `fn(a, b): i64`, negative / zero / positive like C's qsort.
# =========================================================================

# Ascending order for plain i64 elements.
fn agnosai_cmp_i64_asc(a, b): i64 {
    if (a < b) { return 0 - 1; }
    if (a > b) { return 1; }
    return 0;
}

# Descending order for plain i64 elements.
fn agnosai_cmp_i64_desc(a, b): i64 {
    if (a < b) { return 1; }
    if (a > b) { return 0 - 1; }
    return 0;
}

# Byte-wise lexicographic order for two `Str`s: <0, 0 or >0.
#
# Rust's `String: Ord` is a byte-wise compare of the UTF-8 encoding, so a
# shorter string sorts first only when it is a **prefix** of the longer one.
# `"Z" < "a"` and `"ab" < "b"`; case is not folded. Every oracle `Vec<String>`
# sort in the port means exactly this.
#
# The bytes must compare **unsigned**, or everything above 0x7F would sort
# before every ASCII byte and non-ASCII ids would order differently from Rust.
# They already do: `load8` is zero-extending by definition of the language —
# `movzx rax, byte [rcx]` on x86-64 (`backend/x86/emit.cyr:467`) and `ldrb w0`
# on aarch64 (`backend/aarch64/emit.cyr:365`), which zeroes the upper half.
# The two copies this was extracted from each carried an `& 255` that masked
# nothing; dropping it leaves all 64 assertions in `tests/order.tcyr` green,
# including the 0xFF one written specifically to catch a signed read.
#
# Lives here rather than in a caller because `orchestrator/scheduler`,
# `orchestrator/plan_cache` and `fleet/federation` all need it — the third
# instance, which is when CLAUDE.md says to extract. `src/order.cyr` already
# precedes every one of them in `src/main.cyr`'s single-pass include order.
fn agnosai_order_str_cmp(a: Str, b: Str): i64 {
    var la = str_len(a);
    var lb = str_len(b);
    var n = la;
    if (lb < n) { n = lb; }
    var da = str_data(a);
    var db = str_data(b);
    for (var i = 0; i < n; i = i + 1) {
        var ca = load8(da + i);
        var cb = load8(db + i);
        if (ca != cb) { return ca - cb; }
    }
    return la - lb;
}

# Sort a vec in place with `cmp`.
#
# Delegates to the stdlib `vec_sort_by` (cyrius 6.5.4+): introsort with a
# pre-sorted fast path. Not stable — no call site needs stability.
fn agnosai_sort(v, cmp): i64 {
    return vec_sort_by(v, cmp);
}
# Sort a vec of plain i64 ascending.
fn agnosai_sort_i64(v): i64 {
    return agnosai_sort(v, &agnosai_cmp_i64_asc);
}

# The k-th smallest element (0-based) under `cmp`, partially reordering the vec.
#
# Delegates to the stdlib `vec_select_nth` **behind this module's bounds
# contract**: 0 for an empty vec or an out-of-range k, where the stdlib aborts.
# Average O(n) — the reason percentiles do not need a full sort.
fn agnosai_select_nth(v, k, cmp): i64 {
    var n = vec_len(v);
    if (n == 0) { return 0; }
    if (k < 0) { return 0; }
    if (k >= n) { return 0; }
    return vec_select_nth(v, k, cmp);
}
# The k-th smallest plain i64 (0-based).
fn agnosai_select_nth_i64(v, k): i64 {
    return agnosai_select_nth(v, k, &agnosai_cmp_i64_asc);
}

# The `p_milli`-th percentile of a vec of plain i64, where `p_milli` is
# thousandths of a percent-point — 95000 is p95, 99900 is p99.9.
#
# Integer milli-percent for the same reason money is micro-USD: p99.9 is a real
# SLO target and a float percentile argument would make the index computation
# depend on rounding. The index is `floor(p * (n - 1) / 100000)`, the standard
# nearest-rank-on-a-0-based-vector convention.
#
# Uses selection, not a sort — the vec is left partially reordered, which is
# fine for a latency sample and is what makes this O(n) instead of O(n log n).
# Returns 0 for an empty vec.
fn agnosai_percentile_i64(v, p_milli): i64 {
    var n = vec_len(v);
    if (n == 0) { return 0; }
    if (n == 1) { return vec_get(v, 0); }

    var p = p_milli;
    if (p < 0) { p = 0; }
    if (p > 100000) { p = 100000; }

    var idx = (p * (n - 1)) / 100000;
    return agnosai_select_nth_i64(v, idx);
}
