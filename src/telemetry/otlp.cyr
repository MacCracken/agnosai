# =========================================================================
# telemetry/otlp — OTLP/HTTP+JSON span encoding.
#
# No oracle module. `rust-old` gets OTLP from `hoosh::telemetry::init_otel`,
# which is an OpenTelemetry SDK behind a Rust crate; there is no Cyrius OTel
# SDK, so the encoding is written here. The shape follows hoosh's own
# `src/lib/otlp.cyr` (199 lines), which solved the same problem for the same
# collector — **this is the one place ADR 003's remote-HTTP seam does not
# apply**, because export is in-process and there is nothing to call hoosh
# *for*. Copying its proven encoder is not linking hoosh.
#
# ## Why JSON and not protobuf
#
# OTLP defines both. protobuf needs a wire-format library Cyrius does not have;
# OTLP/HTTP+JSON is a first-class transport that every collector accepts, and it
# is `str_builder` all the way down. hoosh made the same call for the same
# reason.
#
# ⚠ **This file is the SECOND hand-rolled OTLP subset in the ecosystem**, after
# hoosh's. If you are about to write a third, don't — read
# `docs/development/roadmap.md`'s note *"an OpenTelemetry library repo"* first.
# That library is a **sibling repo consumed through `[deps]`**, like sakshi or
# majra — not a cyrius stdlib module and not a language feature. It would own
# the protobuf codec, a general span model, W3C context propagation, and a
# batching exporter. When it lands, this file collapses to a thin adapter, the
# way `fleet/relay` did onto majra. (Context propagation is no longer missing
# here: ADR 023 parses `traceparent` and threads span contexts explicitly.)
#
# ## The JSON mapping is NOT "just JSON"
#
# Two rules bite, and both are silent failures rather than errors:
#
# * **64-bit integers are encoded as STRINGS.** `"intValue":"42"`, not `42`, and
#   likewise every `*TimeUnixNano`. The protobuf JSON mapping requires it
#   because IEEE-754 doubles cannot hold the full int64 range, and a collector
#   fed a bare number either rejects the batch or silently truncates past 2^53.
# * **Ids are lowercase hex of a FIXED width** — 32 for a trace id, 16 for a
#   span id, zero-padded. A short id is not "close enough": the collector parses
#   by length.
#
# ## This module encodes only
#
# The ring buffer, the batch thread and the POST are the next bite. Everything
# here is a pure function over a span record, which is what makes the wire
# format testable byte-for-byte without a collector.
# =========================================================================

# The default path when the endpoint carries none, per the OTLP/HTTP spec.
var AGNOSAI_OTLP_DEFAULT_PATH = "/v1/traces";

# OTel `SpanKind`. INTERNAL is 1 and CLIENT is 3 — the numbers are the wire
# values, not an ordering.
enum AgnosaiOtlpSpanKind {
    AGNOSAI_OTLP_KIND_UNSPECIFIED = 0;
    AGNOSAI_OTLP_KIND_INTERNAL = 1;
    AGNOSAI_OTLP_KIND_SERVER = 2;
    AGNOSAI_OTLP_KIND_CLIENT = 3;
    AGNOSAI_OTLP_KIND_PRODUCER = 4;
    AGNOSAI_OTLP_KIND_CONSUMER = 5;
}

# OTel `Status.code`. ⚠ UNSET is 0 and is NOT the same as OK — a collector
# treats UNSET as "no opinion" and OK as an explicit success assertion.
enum AgnosaiOtlpStatusCode {
    AGNOSAI_OTLP_STATUS_UNSET = 0;
    AGNOSAI_OTLP_STATUS_OK = 1;
    AGNOSAI_OTLP_STATUS_ERROR = 2;
}

# Export context heap layout — 56 bytes. The identity and timing a span record
# does not carry: the exporter supplies them at enqueue time.
#
# `PARENT_SPAN_ID` is 0 for a root span, and the encoder then omits the
# `parentSpanId` key entirely rather than sending sixteen zeros (ADR 023).
enum AgnosaiOtlpCtxOff {
    AGN_OTC_TRACE_HI = 0;
    AGN_OTC_TRACE_LO = 8;
    AGN_OTC_SPAN_ID = 16;
    AGN_OTC_START_NS = 24;
    AGN_OTC_END_NS = 32;
    AGN_OTC_STATUS = 40;
    AGN_OTC_PARENT_SPAN_ID = 48;
    AGN_OTC_SIZE = 56;
}

# Fill an export context at `c`, which must hold `AGN_OTC_SIZE` bytes.
#
# Split from the constructor so the recorder can build the context in a stack
# buffer: `agnosai_otlp_ring_enqueue` encodes it and keeps nothing, so a heap
# copy would be 56 bytes on the no-free global bump per span for nothing.
fn _agnosai_otlp_ctx_fill(c, trace_hi, trace_lo, span_id, parent_span_id, start_ns, end_ns,
  status): i64 {
    store64(c + AGN_OTC_TRACE_HI, trace_hi);
    store64(c + AGN_OTC_TRACE_LO, trace_lo);
    store64(c + AGN_OTC_SPAN_ID, span_id);
    store64(c + AGN_OTC_START_NS, start_ns);
    store64(c + AGN_OTC_END_NS, end_ns);
    store64(c + AGN_OTC_STATUS, status);
    store64(c + AGN_OTC_PARENT_SPAN_ID, parent_span_id);
    return c;
}

# The identity, parent and timing for one exported span. `parent_span_id` is 0
# for a root span.
#
# `trace_hi`/`trace_lo` are the two halves of the W3C 128-bit trace id, which is
# exactly what `sakshi_trace_id_hi` / `_lo` hold.
fn agnosai_otlp_ctx_new_child(trace_hi, trace_lo, span_id, parent_span_id, start_ns, end_ns,
  status): i64 {
    return _agnosai_otlp_ctx_fill(alloc(AGN_OTC_SIZE), trace_hi, trace_lo, span_id,
      parent_span_id, start_ns, end_ns, status);
}

# The identity and timing for one exported ROOT span — no parent.
fn agnosai_otlp_ctx_new(trace_hi, trace_lo, span_id, start_ns, end_ns, status): i64 {
    return agnosai_otlp_ctx_new_child(trace_hi, trace_lo, span_id, 0, start_ns, end_ns, status);
}

# The context's status code.
fn agnosai_otlp_ctx_status(c): i64 {
    return load64(c + AGN_OTC_STATUS);
}

# The context's parent span id, or 0 for a root span.
fn agnosai_otlp_ctx_parent_span_id(c): i64 {
    return load64(c + AGN_OTC_PARENT_SPAN_ID);
}

# Whether a trace id is the all-zero id, which the W3C spec declares INVALID.
#
# Worth its own check because `sakshi_trace_id_hi`/`_lo` answer 0/0 when nothing
# ever called `sakshi_trace_set_128` — so an un-instrumented process would
# otherwise export a batch every collector drops, with no local symptom.
fn agnosai_otlp_trace_id_is_zero(hi, lo): i64 {
    if (hi != 0) { return 0; }
    if (lo != 0) { return 0; }
    return 1;
}

# --- arena-threaded builder primitives -------------------------------------
#
# ⚠ **A `str_builder` does NOT remember its allocator.** The header is 24 bytes
# — `{buf, len, cap}` (`lib/str.cyr:428`) — so `str_builder_new_a(arena)` charges
# the arena the 88-byte header and NOTHING else: every bare `str_builder_add*`
# grows through `_sb_grow` → `default_alloc()`, and bare `str_builder_build`
# builds there too. `lib/str.cyr:433` states the contract outright — *"Subsequent
# grows must use the `_a` add variants to keep the same allocator threaded
# through."*
#
# This module violated that from the start: it constructed with `_a` and then
# made 29 bare `add` calls and 4 bare `build` calls, so both 256 KiB ring arenas
# held only builder headers and every span fragment and batch document went to
# the no-free global bump — ~3.9 KB per exported span, on a 1000 ms loop, for
# process lifetime. Fixed 2026-08-12.
#
# `str_builder_putc` and `str_builder_add_json_str` have **no `_a` form**
# upstream, so the two below are port-local stand-ins. They are the only reason
# this section exists; delete them if `putc_a` / `add_json_str_a` ever land.

# One byte, through the threaded allocator. `str_builder_add_cstr_a` copies
# immediately, so the 2-byte NUL-terminated stack buffer is safe.
fn _agnosai_otlp_putc_a(a, sb, ch): i64 {
    var b[2];
    var p = &b;
    store8(p, ch & 0xFF);
    store8(p + 1, 0);
    return str_builder_add_cstr_a(a, sb, p);
}

# `str_builder_add_json_str` with the allocator threaded.
#
# ⚠ **Byte-for-byte identical to `lib/str.cyr:114` and must stay so** — the
# suites assert the encoded wire, so any divergence here is a wire change. Same
# escape set: `"`→`\"`, `\`→`\\`, the five named control escapes, `\u00XX` for
# the remaining controls, and everything >= 0x20 verbatim (RFC 8259 §8.1).
fn _agnosai_otlp_json_str_a(a, sb, s: Str): i64 {
    _agnosai_otlp_putc_a(a, sb, 34);
    _agnosai_otlp_json_body_a(a, sb, s);
    _agnosai_otlp_putc_a(a, sb, 34);
    return 0;
}

# The escaped bytes of `s`, with no quotes — the body of
# `_agnosai_otlp_json_str_a`, split out so a span name can be written as two
# escaped parts inside one pair of quotes without building the joined string.
fn _agnosai_otlp_json_body_a(a, sb, s: Str): i64 {
    var data = str_data(s);
    var slen = str_len(s);
    var ji = 0;
    while (ji < slen) {
        var bc = load8(data + ji);
        if (bc == 34) {
            _agnosai_otlp_putc_a(a, sb, 92);
            _agnosai_otlp_putc_a(a, sb, 34);
        } else { if (bc == 92) {
                _agnosai_otlp_putc_a(a, sb, 92);
                _agnosai_otlp_putc_a(a, sb, 92);
            } else { if (bc == 8) {
                    _agnosai_otlp_putc_a(a, sb, 92);
                    _agnosai_otlp_putc_a(a, sb, 98);
                } else { if (bc == 9) {
                        _agnosai_otlp_putc_a(a, sb, 92);
                        _agnosai_otlp_putc_a(a, sb, 116);
                    } else { if (bc == 10) {
                            _agnosai_otlp_putc_a(a, sb, 92);
                            _agnosai_otlp_putc_a(a, sb, 110);
                        } else { if (bc == 12) {
                                _agnosai_otlp_putc_a(a, sb, 92);
                                _agnosai_otlp_putc_a(a, sb, 102);
                            } else { if (bc == 13) {
                                    _agnosai_otlp_putc_a(a, sb, 92);
                                    _agnosai_otlp_putc_a(a, sb, 114);
                                } else { if (bc < 32) {
                                        _agnosai_otlp_putc_a(a, sb, 92);
                                        _agnosai_otlp_putc_a(a, sb, 117);
                                        _agnosai_otlp_putc_a(a, sb, 48);
                                        _agnosai_otlp_putc_a(a, sb, 48);
                                        var hi = (bc >> 4) & 0xF;
                                        var lo = bc & 0xF;
                                        if (hi < 10) { _agnosai_otlp_putc_a(a, sb, 48 + hi); }
                                        else { _agnosai_otlp_putc_a(a, sb, 87 + hi); }
                                        if (lo < 10) { _agnosai_otlp_putc_a(a, sb, 48 + lo); }
                                        else { _agnosai_otlp_putc_a(a, sb, 87 + lo); }
                                    } else {
                                        _agnosai_otlp_putc_a(a, sb, bc);
                                    } } } } } } } }
        ji = ji + 1;
    }
    return 0;
}

# --- hex ------------------------------------------------------------------

# Append `n` as exactly `width` lowercase hex digits, most significant first.
#
# ⚠ Zero-padded and fixed-width: the collector parses ids by length, so a
# 15-digit span id is not a span id. `_agnosai_hex_digit` is `src/id.cyr`'s —
# `id` precedes `telemetry` in `src/main.cyr`, so this is a reuse, not a copy.
fn _agnosai_otlp_add_hex_a(a, sb, n, width): i64 {
    for (var i = width - 1; i >= 0; i = i - 1) {
        _agnosai_otlp_putc_a(a, sb, _agnosai_hex_digit((n >> (i * 4)) & 15));
    }
    return 0;
}

# Append a W3C trace id: 32 lowercase hex digits, high half first.
fn agnosai_otlp_add_trace_id_a(a, sb, hi, lo): i64 {
    _agnosai_otlp_add_hex_a(a, sb, hi, 16);
    _agnosai_otlp_add_hex_a(a, sb, lo, 16);
    return 0;
}

# Global-allocator form. Kept because the encoder tests build against a bare
# `str_builder_new()`, where threading would be a lie.
fn agnosai_otlp_add_trace_id(sb, hi, lo): i64 {
    return agnosai_otlp_add_trace_id_a(default_alloc(), sb, hi, lo);
}

# Append a span id: 16 lowercase hex digits.
fn agnosai_otlp_add_span_id_a(a, sb, id): i64 {
    _agnosai_otlp_add_hex_a(a, sb, id, 16);
    return 0;
}

# Global-allocator form of `agnosai_otlp_add_span_id_a`, for a builder that was
# constructed with a bare `str_builder_new()`.
fn agnosai_otlp_add_span_id(sb, id): i64 {
    return agnosai_otlp_add_span_id_a(default_alloc(), sb, id);
}

# --- span context (W3C Trace Context Level 1) -------------------------------
#
# ADR 023. A span context is the identity a span hands its children: the trace
# it belongs to, its own span id, and the trace flags. It is **passed down the
# call path explicitly** — runner, wave job, task, retry context, chat call —
# and never kept in thread-local storage. `thread_create` gives every worker a
# zeroed TLS block (`lib/thread.cyr`), agnostic submits crews through a detached
# orchestrator thread, and `thread_local_get` faults on a main thread that never
# called `thread_local_init`; a context set on the caller's thread would be
# invisible to the crew in every process mode.
#
# The `traceparent` header is `version-traceid-parentid-flags`:
# `00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01` — 55 bytes.

# Span context heap layout — 32 bytes.
enum AgnosaiSpanContextOff {
    AGN_SPC_TRACE_HI = 0;
    AGN_SPC_TRACE_LO = 8;
    AGN_SPC_SPAN_ID = 16;
    # The W3C trace-flags byte. Bit 0 is `sampled`; the others are kept as they
    # arrived and passed on to children.
    AGN_SPC_FLAGS = 24;
    AGN_SPC_SIZE = 32;
}

# The exact length of a version-00 `traceparent`.
var AGNOSAI_TRACEPARENT_LEN = 55;

# A span context from its parts.
fn agnosai_otlp_span_context_new(trace_hi, trace_lo, span_id, flags): i64 {
    var sc = alloc(AGN_SPC_SIZE);
    store64(sc + AGN_SPC_TRACE_HI, trace_hi);
    store64(sc + AGN_SPC_TRACE_LO, trace_lo);
    store64(sc + AGN_SPC_SPAN_ID, span_id);
    store64(sc + AGN_SPC_FLAGS, flags);
    return sc;
}

# The high half of the context's trace id.
fn agnosai_otlp_span_context_trace_hi(sc): i64 {
    return load64(sc + AGN_SPC_TRACE_HI);
}

# The low half of the context's trace id.
fn agnosai_otlp_span_context_trace_lo(sc): i64 {
    return load64(sc + AGN_SPC_TRACE_LO);
}

# The context's own span id — a child's parent span id.
fn agnosai_otlp_span_context_span_id(sc): i64 {
    return load64(sc + AGN_SPC_SPAN_ID);
}

# The context's trace-flags byte.
fn agnosai_otlp_span_context_flags(sc): i64 {
    return load64(sc + AGN_SPC_FLAGS);
}

# 1 when the context's `sampled` flag is set.
fn agnosai_otlp_span_context_sampled(sc): i64 {
    return load64(sc + AGN_SPC_FLAGS) & 1;
}

# The value of one LOWERCASE hex digit, or -1.
#
# ⚠ Uppercase is rejected. W3C Trace Context writes the ids as HEXDIGLC, and a
# receiver that folds case accepts headers no conforming sender produces.
fn _agnosai_otlp_hex_lc(c): i64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return 0 - 1;
}

# `n` lowercase hex digits at `p` as a number, or -1 when any is not one.
#
# At most 16 digits, so the value fits an i64 bit pattern. A 16-digit value
# with the top bit set is negative as an i64, and still a valid id — so the
# caller tests the -1 sentinel through `ok`, never through the sign.
fn _agnosai_otlp_hex_field(p, n, ok): i64 {
    var v = 0;
    for (var i = 0; i < n; i = i + 1) {
        var d = _agnosai_otlp_hex_lc(load8(p + i));
        if (d < 0) {
            store64(ok, 0);
            return 0;
        }
        v = (v << 4) | d;
    }
    return v;
}

# Parse a `traceparent` into a span context in `a`, or 0.
#
# **Strict, and never an error.** Answers 0 unless every rule of W3C Trace
# Context Level 1 version `00` holds: exactly 55 bytes; version exactly `00`;
# `-` at offsets 2, 35 and 52; every other byte lowercase hex; a trace id that
# is not all zeros; a parent id that is not all zeros. A caller that gets 0
# starts a new root trace — a malformed header is the sender's problem and must
# not fail the request that carried it.
#
# ⚠ Version `00` only. The spec lets a receiver parse a HIGHER version's first
# 55 bytes, but no such version exists, and a parser that guesses at one is
# a parser that accepts what it cannot check.
fn agnosai_otlp_span_context_parse_a(a, tp: Str): i64 {
    if (tp == 0) { return 0; }
    if (str_len(tp) != AGNOSAI_TRACEPARENT_LEN) { return 0; }
    var d = str_data(tp);
    if (load8(d) != 48 || load8(d + 1) != 48) { return 0; }
    if (load8(d + 2) != 45 || load8(d + 35) != 45 || load8(d + 52) != 45) { return 0; }

    var ok: i64[1];
    store64(&ok, 1);
    var hi = _agnosai_otlp_hex_field(d + 3, 16, &ok);
    var lo = _agnosai_otlp_hex_field(d + 19, 16, &ok);
    var span = _agnosai_otlp_hex_field(d + 36, 16, &ok);
    var flags = _agnosai_otlp_hex_field(d + 53, 2, &ok);
    if (load64(&ok) == 0) { return 0; }
    if (agnosai_otlp_trace_id_is_zero(hi, lo) == 1) { return 0; }
    if (span == 0) { return 0; }

    var sc = alloc_via(a, AGN_SPC_SIZE);
    if (sc == 0) { return 0; }
    store64(sc + AGN_SPC_TRACE_HI, hi);
    store64(sc + AGN_SPC_TRACE_LO, lo);
    store64(sc + AGN_SPC_SPAN_ID, span);
    store64(sc + AGN_SPC_FLAGS, flags);
    return sc;
}

# Global-allocator form of `agnosai_otlp_span_context_parse_a`.
fn agnosai_otlp_span_context_parse(tp: Str): i64 {
    return agnosai_otlp_span_context_parse_a(default_alloc(), tp);
}

# A new span context under `parent`, or a new ROOT when `parent` is 0.
#
# A child keeps the parent's trace id and flags and takes a fresh random 8-byte
# span id. A root takes a random 16-byte trace id as well, and flags `01`
# (sampled) — agnosai records every span it is not told to drop.
#
# One `getrandom` either way: 8 bytes for a child, 24 for a root. Both ids are
# forced non-zero, because the all-zero id is INVALID and a collector drops the
# span. The chance of drawing zero is 2^-64; the guard costs a compare. A
# failed `getrandom` leaves the fresh allocation's zeros, which the same guards
# turn into a valid if unremarkable id — telemetry degrades, the work does not.
fn agnosai_otlp_span_context_child(parent): i64 {
    var sc = alloc(AGN_SPC_SIZE);
    if (parent == 0) {
        random_bytes(sc, 24);
        if (agnosai_otlp_trace_id_is_zero(load64(sc + AGN_SPC_TRACE_HI),
            load64(sc + AGN_SPC_TRACE_LO)) == 1) {
            store64(sc + AGN_SPC_TRACE_LO, 1);
        }
        store64(sc + AGN_SPC_FLAGS, 1);
    } else {
        store64(sc + AGN_SPC_TRACE_HI, load64(parent + AGN_SPC_TRACE_HI));
        store64(sc + AGN_SPC_TRACE_LO, load64(parent + AGN_SPC_TRACE_LO));
        store64(sc + AGN_SPC_FLAGS, load64(parent + AGN_SPC_FLAGS));
        random_bytes(sc + AGN_SPC_SPAN_ID, 8);
    }
    if (load64(sc + AGN_SPC_SPAN_ID) == 0) { store64(sc + AGN_SPC_SPAN_ID, 1); }
    return sc;
}

# The context as a `traceparent` in `a`: exactly 55 lowercase bytes.
#
# `format_a(parse(x))` is `x` byte for byte for every `x` parse accepts.
fn agnosai_otlp_span_context_format_a(a, sc): i64 {
    var sb = str_builder_new_a(a);
    str_builder_add_cstr_a(a, sb, "00-");
    agnosai_otlp_add_trace_id_a(a, sb, load64(sc + AGN_SPC_TRACE_HI),
      load64(sc + AGN_SPC_TRACE_LO));
    _agnosai_otlp_putc_a(a, sb, 45);
    _agnosai_otlp_add_hex_a(a, sb, load64(sc + AGN_SPC_SPAN_ID), 16);
    _agnosai_otlp_putc_a(a, sb, 45);
    _agnosai_otlp_add_hex_a(a, sb, load64(sc + AGN_SPC_FLAGS), 2);
    return str_builder_build_a(a, sb);
}

# --- attributes -----------------------------------------------------------

# One string attribute: `{"key":"k","value":{"stringValue":"v"}}`.
#
# The value goes through `str_builder_add_json_str` (`lib/str.cyr:114`), which
# emits its own quotes and escapes — a model name or tool name is caller data
# and can carry a quote or a control byte.
fn _agnosai_otlp_attr_str_a(a, sb, k, v: Str): i64 {
    str_builder_add_cstr_a(a, sb, "{\"key\":\"");
    str_builder_add_cstr_a(a, sb, k);
    str_builder_add_cstr_a(a, sb, "\",\"value\":{\"stringValue\":");
    _agnosai_otlp_json_str_a(a, sb, v);
    str_builder_add_cstr_a(a, sb, "}}");
    return 0;
}

fn _agnosai_otlp_attr_str(sb, k, v: Str): i64 {
    return _agnosai_otlp_attr_str_a(default_alloc(), sb, k, v);
}

# One integer attribute: `{"key":"k","value":{"intValue":"42"}}`.
#
# ⚠ The value is QUOTED. See the module header — a bare number is the silent
# failure the JSON mapping exists to prevent.
fn _agnosai_otlp_attr_int_a(a, sb, k, v): i64 {
    str_builder_add_cstr_a(a, sb, "{\"key\":\"");
    str_builder_add_cstr_a(a, sb, k);
    str_builder_add_cstr_a(a, sb, "\",\"value\":{\"intValue\":\"");
    str_builder_add_int_a(a, sb, v);
    str_builder_add_cstr_a(a, sb, "\"}}");
    return 0;
}

fn _agnosai_otlp_attr_int(sb, k, v): i64 {
    return _agnosai_otlp_attr_int_a(default_alloc(), sb, k, v);
}

# Append one string attribute from the span, with a leading comma when anything
# has already been written. Returns the updated "have written one" flag.
#
# ⚠ An EMPTY value is absent too. ADR 017 said the tool span's missing agent
# name and task id were "omitted rather than faked", while the call sites
# passed `str_from("")` and this emitted `"stringValue":""` for both — and for
# the chat span's. An empty attribute says nothing a backend can group by.
fn _agnosai_otlp_emit_str_a(a, sb, span, key, wrote): i64 {
    var v = agnosai_genai_span_attr_str(span, key);
    if (v == 0) { return wrote; }
    if (str_len(v) == 0) { return wrote; }
    if (wrote == 1) { str_builder_add_cstr_a(a, sb, ","); }
    _agnosai_otlp_attr_str_a(a, sb, key, v);
    return 1;
}

# The same for an integer attribute. -1 means unset and emits nothing.
fn _agnosai_otlp_emit_int_a(a, sb, span, key, wrote): i64 {
    var v = agnosai_genai_span_attr_int(span, key);
    if (v < 0) { return wrote; }
    if (wrote == 1) { str_builder_add_cstr_a(a, sb, ","); }
    _agnosai_otlp_attr_int_a(a, sb, key, v);
    return 1;
}

# --- span kind ------------------------------------------------------------

# The OTel `SpanKind` for a genai span, from its operation.
#
# A `chat` call leaves the process for a model provider, so it is CLIENT; an
# in-process agent, a crew run and a tool call are local work, so INTERNAL.
# ⚠ Getting this wrong is not cosmetic — a backend's service-dependency graph
# is built from CLIENT/SERVER pairs, so a mislabelled inference span drops the
# provider edge. Before ADR 023 the chat call was named `gen_ai.invoke_agent`
# and the kind keyed on that name; `invoke_agent` is now the INTERNAL task span.
fn agnosai_otlp_span_kind(span): i64 {
    if (streq(agnosai_genai_span_name(span), AGNOSAI_GENAI_OP_CHAT) == 1) {
        return AGNOSAI_OTLP_KIND_CLIENT;
    }
    return AGNOSAI_OTLP_KIND_INTERNAL;
}

# --- encoding -------------------------------------------------------------

# Encode one genai span as an OTLP/JSON `Span` object.
#
# Only attributes the span actually carries are emitted — an absent attribute is
# omitted rather than sent as null, because OTLP has no null attribute value and
# a collector reading one drops the whole span.
fn agnosai_otlp_span_json(span, ctx): i64 {
    var a = default_alloc();
    var sb = str_builder_new_a(a);
    _agnosai_otlp_span_json_into_a(a, sb, span, ctx);
    return str_builder_build_a(a, sb);
}

# The body of `agnosai_otlp_span_json`, writing into a caller-supplied builder.
#
# Split out so the ring can encode straight into its fragment arena — the
# convenience wrapper above allocates on the global, which is exactly what the
# ring exists to avoid.
fn _agnosai_otlp_span_json_into_a(a, sb, span, ctx): i64 {
    str_builder_add_cstr_a(a, sb, "{\"traceId\":\"");
    agnosai_otlp_add_trace_id_a(a, sb, load64(ctx + AGN_OTC_TRACE_HI),
      load64(ctx + AGN_OTC_TRACE_LO));
    str_builder_add_cstr_a(a, sb, "\",\"spanId\":\"");
    agnosai_otlp_add_span_id_a(a, sb, load64(ctx + AGN_OTC_SPAN_ID));
    # ⚠ Only for a child. A root span OMITS the key: sixteen zeros are an
    # invalid span id, not "no parent", and a collector would go looking for it.
    var parent = load64(ctx + AGN_OTC_PARENT_SPAN_ID);
    if (parent != 0) {
        str_builder_add_cstr_a(a, sb, "\",\"parentSpanId\":\"");
        agnosai_otlp_add_span_id_a(a, sb, parent);
    }
    str_builder_add_cstr_a(a, sb, "\",\"name\":");
    # `<operation> <subject>` (ADR 023), written as two escaped parts inside one
    # pair of quotes — `agnosai_genai_span_full_name_a` builds the same string,
    # and this avoids building it. The operation is the span's own `Str`, so
    # nothing here allocates a name. (Until 2026-08-12 a bare `str_from` of the
    # name was the last per-span allocation on the global bump.)
    _agnosai_otlp_putc_a(a, sb, 34);
    _agnosai_otlp_json_body_a(a, sb, agnosai_genai_span_attr_str(span,
        AGNOSAI_GENAI_OPERATION_NAME));
    var suffix = agnosai_genai_span_name_suffix(span);
    if (suffix != 0) {
        _agnosai_otlp_putc_a(a, sb, 32);
        _agnosai_otlp_json_body_a(a, sb, suffix);
    }
    _agnosai_otlp_putc_a(a, sb, 34);
    str_builder_add_cstr_a(a, sb, ",\"kind\":");
    str_builder_add_int_a(a, sb, agnosai_otlp_span_kind(span));
    str_builder_add_cstr_a(a, sb, ",\"startTimeUnixNano\":\"");
    str_builder_add_int_a(a, sb, load64(ctx + AGN_OTC_START_NS));
    str_builder_add_cstr_a(a, sb, "\",\"endTimeUnixNano\":\"");
    str_builder_add_int_a(a, sb, load64(ctx + AGN_OTC_END_NS));
    str_builder_add_cstr_a(a, sb, "\",\"attributes\":[");

    # Spec attributes first, then base semconv's `error.type`, then agnosai's
    # own — an order a reader can scan, and the order the suites pin.
    var wrote = 0;
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_OPERATION_NAME, wrote);
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_PROVIDER_NAME, wrote);
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_REQUEST_MODEL, wrote);
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_RESPONSE_MODEL, wrote);
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_AGENT_NAME, wrote);
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_WORKFLOW_NAME, wrote);
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_TOOL_NAME, wrote);
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_ERROR_TYPE, wrote);
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_CREW_ID, wrote);
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_TASK_ID, wrote);
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_AGENT_KEY, wrote);
    wrote = _agnosai_otlp_emit_int_a(a, sb, span, AGNOSAI_GENAI_USAGE_INPUT_TOKENS, wrote);
    wrote = _agnosai_otlp_emit_int_a(a, sb, span, AGNOSAI_GENAI_USAGE_OUTPUT_TOKENS, wrote);
    wrote = _agnosai_otlp_emit_int_a(a, sb, span, AGNOSAI_GENAI_CREW_TASK_COUNT, wrote);

    str_builder_add_cstr_a(a, sb, "],\"status\":{\"code\":");
    str_builder_add_int_a(a, sb, load64(ctx + AGN_OTC_STATUS));
    str_builder_add_cstr_a(a, sb, "}}");
    return 0;
}

# Wrap `n` encoded spans (oldest first) in an OTLP `ResourceSpans` document.
#
# `frags` is an array of `n` Str pointers. The `service.name` resource attribute
# is what a backend groups by, so it is the one attribute the resource carries.
fn agnosai_otlp_build_batch_a(a, service_name: Str, frags, n): i64 {
    var sb = str_builder_new_a(a);
    str_builder_add_cstr_a(a, sb, "{\"resourceSpans\":[{\"resource\":{\"attributes\":[");
    _agnosai_otlp_attr_str_a(a, sb, "service.name", service_name);
    str_builder_add_cstr_a(a, sb, "]},\"scopeSpans\":[{\"scope\":{\"name\":\"agnosai\"},\"spans\":[");
    for (var i = 0; i < n; i = i + 1) {
        if (i > 0) { str_builder_add_cstr_a(a, sb, ","); }
        str_builder_add_a(a, sb, load64(frags + i * 8));
    }
    str_builder_add_cstr_a(a, sb, "]}]}]}");
    return str_builder_build_a(a, sb);
}

# Global-allocator form of `agnosai_otlp_build_batch_a`.
#
# ⚠ The ring does NOT use this — `agnosai_otlp_ring_drain` builds the same
# document straight into its `doc_arena`. This form exists for the encoder tests,
# which assert the wire bytes without standing up a ring.
fn agnosai_otlp_build_batch(service_name: Str, frags, n): i64 {
    return agnosai_otlp_build_batch_a(default_alloc(), service_name, frags, n);
}

# --- endpoint parsing -----------------------------------------------------

# Whether the endpoint is an `https://` collector — the scheme in any case.
#
# ⚠ Case-insensitive since 2.1.6. A URL scheme is (RFC 3986 §3.1), sandhi parses
# it so, and through 2.1.5 `HTTPS://host` read as not-https here: the path scan
# below then started on the second `/` of `//` and called the URL pathed.
fn agnosai_otlp_is_https(url): i64 {
    if (url == 0) { return 0; }
    if (strlen(url) < 8) { return 0; }
    var lit = "https://";
    for (var i = 0; i < 8; i = i + 1) {
        var c = load8(url + i) & 255;
        if (c >= 65 && c <= 90) { c = c + 32; }
        if (c != (load8(lit + i) & 255)) { return 0; }
    }
    return 1;
}

# The path component of `http://host:port/path`, or `/v1/traces` when the URL
# carries none.
#
# ⚠ The scan starts after the scheme so the `//` in `http://` cannot be mistaken
# for the path. hoosh hardcodes 7 because it only ever sees `http://`; an
# `https://` URL is one longer, and starting at 7 would land on the second `/`
# of `//` and answer `/` — a POST to the collector's root, which 404s. So the
# offset comes from the scheme.
fn agnosai_otlp_path(url): i64 {
    var i = 7;
    if (agnosai_otlp_is_https(url) == 1) { i = 8; }
    while (load8(url + i) != 0) {
        if (load8(url + i) == 47) { return url + i; }
        i = i + 1;
    }
    return AGNOSAI_OTLP_DEFAULT_PATH;
}

# --- the export ring ------------------------------------------------------
#
# ## Identity is the CALLER's, never sakshi's
#
# sakshi's trace id and span stack are process globals (`sakshi_trace_id_hi` /
# `_lo`), so under `sandhi_server_run_pooled` two concurrent requests share one
# trace id and the traces interleave into nonsense.
#
# So **the export path never reads sakshi's trace context at all.** `enqueue`
# takes an export context the caller built, and correlation is the caller's
# job. Since ADR 023 the caller does it: each span site takes a span context
# from its parent (the span-context section above), hands its own context to
# the work it starts, and records with `agnosai_telemetry_record_span_in`, which
# fills `trace id`, `span id` and `parentSpanId` from the two contexts. One
# crew is therefore one trace, in every process mode, and it joins an inbound
# `traceparent` when there is one.
#
# ⚠ Still not thread-local. The cyrius stdlib has `thread_local_*` now, but a
# context set on one thread is invisible to a `thread_create` worker and to
# agnostic's detached submit thread, so it is passed explicitly — reentrant by
# construction and needing no upstream change.
#
# ## Two arenas, with single-owner rules
#
# Every span fragment is a fresh allocation, and the default allocator never
# frees — at ten spans a second that is ~14 MB an hour that never comes back.
# hoosh accepts this; agnosai's own principle ("thread the `_a` variants") does
# not. So:
#
# * **`frag_arena`** holds the encoded fragments and is written **only under the
#   ring lock** — by `enqueue` on worker threads and by nothing else. `drain`
#   resets it while still holding the lock, so a fragment never outlives the
#   batch that carried it.
# * **`doc_arena`** holds the batch document and is **private to the draining
#   thread**. It is reset at the top of each drain, which makes the lifetime
#   rule a single sentence: *a batch document is valid until the next drain*.
#   That is exactly the POST window.
#
# Encoding happens inside the critical section. It is pure string work with no
# I/O, and doing it there is what lets the fragment arena be reset safely.

# Ring capacity. hoosh uses the same 256 — a second of spans at any rate a
# single process can actually produce.
var AGNOSAI_OTLP_RING_MAX = 256;

# Per-arena capacity in bytes, sized from the RING's capacity so a full ring
# never spills.
#
# ⚠ **Size this against amplified cost, not final size.** `str_builder` starts
# at a 64-byte inline buffer and doubles, and an arena has no free — so every
# intermediate buffer stays. Measured 2026-08-12: a span fragment of ~700 bytes
# costs **2,736 bytes** of arena (64+128+256+512+1024 of abandoned grows, plus
# the built copy). Flat across 1, 10, 32 and 64 spans.
#
# 256 slots x 2,736 B = ~700 KB, so 768 KiB covers a completely full ring with
# headroom. The previous 256 KiB held ~95 spans and then spilled — and
# ARENA_FULL_SPILL spills to the **no-free global bump**, which is the leak this
# module was fixed for. Measured at 128 spans on the old size: 180,928 bytes
# spilled to the global in a single cycle.
#
# ⚠ The cost is VIRTUAL, not resident: arena chunks are anonymous overcommitted
# mmaps and only touched pages count against RSS (`lib/alloc.cyr:150-155`). Two
# arenas at 768 KiB is 1.5 MB of address space reserved once at startup, against
# the per-operation global-bump growth it removes.
var AGNOSAI_OTLP_ARENA_BYTES = 786432;

# Ring heap layout — 56 bytes.
enum AgnosaiOtlpRingOff {
    AGN_OTR_SLOTS = 0;
    AGN_OTR_HEAD = 8;
    AGN_OTR_COUNT = 16;
    # Spans discarded because the ring was full. Never silently zero — see
    # `agnosai_otlp_ring_dropped`.
    AGN_OTR_DROPPED = 24;
    AGN_OTR_LOCK = 32;
    AGN_OTR_FRAG_ARENA = 40;
    AGN_OTR_DOC_ARENA = 48;
    AGN_OTR_SIZE = 56;
}

# How many spans the ring holds before it starts dropping.
fn agnosai_otlp_ring_capacity(): i64 {
    return AGNOSAI_OTLP_RING_MAX;
}

# A new export ring with its lock and both arenas.
#
# Both arenas are `ARENA_FULL_SPILL`: an oversized batch is served from the
# global allocator rather than returning 0, because a dropped *allocation*
# inside the encoder would produce a truncated JSON document — malformed output
# is worse than an unbounded byte.
fn agnosai_otlp_ring_new(): i64 {
    var r = alloc(AGN_OTR_SIZE);
    var slots = alloc(AGNOSAI_OTLP_RING_MAX * 8);
    for (var i = 0; i < AGNOSAI_OTLP_RING_MAX; i = i + 1) { store64(slots + i * 8, 0); }
    store64(r + AGN_OTR_SLOTS, slots);
    store64(r + AGN_OTR_HEAD, 0);
    store64(r + AGN_OTR_COUNT, 0);
    store64(r + AGN_OTR_DROPPED, 0);
    store64(r + AGN_OTR_LOCK, mutex_new());
    var fa = arena_allocator(AGNOSAI_OTLP_ARENA_BYTES);
    arena_allocator_set_on_full(fa, ARENA_FULL_SPILL);
    store64(r + AGN_OTR_FRAG_ARENA, fa);
    var da = arena_allocator(AGNOSAI_OTLP_ARENA_BYTES);
    arena_allocator_set_on_full(da, ARENA_FULL_SPILL);
    store64(r + AGN_OTR_DOC_ARENA, da);
    return r;
}

# Spans currently waiting to be exported.
fn agnosai_otlp_ring_count(r): i64 {
    return load64(r + AGN_OTR_COUNT);
}

# The arena holding encoded fragments. Written only under the ring lock.
#
# Exposed because the separation from `doc_arena` is a **correctness property,
# not an implementation detail**: if the two were the same allocator, `drain`
# would reset the arena holding the fragments it is about to read.
#
# ⚠ Arena lifetime bugs are **not observable by assertion** in a bump allocator
# — a reset rewinds an offset and leaves the bytes intact, so use-after-reset
# reads correct data in a single-threaded test. The accessor pins that two
# arenas exist; that enqueue targets the right one is correct by construction
# only. Recorded in `roadmap.md` section E.
fn agnosai_otlp_ring_frag_arena(r): i64 {
    return load64(r + AGN_OTR_FRAG_ARENA);
}

# The arena holding the batch document. Private to the draining thread.
fn agnosai_otlp_ring_doc_arena(r): i64 {
    return load64(r + AGN_OTR_DOC_ARENA);
}

# Spans discarded because the ring was full, cumulative.
#
# ⚠ hoosh's ring drops the oldest and counts nothing, so loss is invisible. The
# port's standing rule is no silent truncation: this is the number an operator
# checks when a trace has holes in it.
fn agnosai_otlp_ring_dropped(r): i64 {
    return load64(r + AGN_OTR_DROPPED);
}

# Encode `span` under `ctx` and queue it. Returns 1 when queued, 0 when the ring
# was full and the OLDEST span was discarded to make room.
#
# ⚠ Drop-oldest, not drop-newest: a full ring means the exporter is behind, and
# the newest spans are the ones an operator is looking at. Matches hoosh.
fn agnosai_otlp_ring_enqueue(r, span, ctx): i64 {
    var lock = load64(r + AGN_OTR_LOCK);
    mutex_lock(lock);

    var fa = load64(r + AGN_OTR_FRAG_ARENA);
    var sb = str_builder_new_a(fa);
    _agnosai_otlp_span_json_into_a(fa, sb, span, ctx);
    var frag = str_builder_build_a(fa, sb);

    var head = load64(r + AGN_OTR_HEAD);
    store64(load64(r + AGN_OTR_SLOTS) + (head % AGNOSAI_OTLP_RING_MAX) * 8, frag);
    store64(r + AGN_OTR_HEAD, head + 1);

    var count = load64(r + AGN_OTR_COUNT);
    var queued = 1;
    if (count >= AGNOSAI_OTLP_RING_MAX) {
        store64(r + AGN_OTR_DROPPED, load64(r + AGN_OTR_DROPPED) + 1);
        queued = 0;
    } else {
        store64(r + AGN_OTR_COUNT, count + 1);
    }
    mutex_unlock(lock);
    return queued;
}

# Drain everything queued into one OTLP batch document, or 0 when empty.
#
# The returned Str lives in the ring's `doc_arena` and is **valid until the next
# drain** — POST it before draining again. See the header.
fn agnosai_otlp_ring_drain(r, service_name: Str): i64 {
    var lock = load64(r + AGN_OTR_LOCK);
    mutex_lock(lock);
    var n = load64(r + AGN_OTR_COUNT);
    if (n == 0) {
        mutex_unlock(lock);
        return 0;
    }

    # Oldest first. `head` has already advanced past the newest, so the oldest
    # live slot is `head - n`.
    var head = load64(r + AGN_OTR_HEAD);
    var slots = load64(r + AGN_OTR_SLOTS);
    var doc_arena = load64(r + AGN_OTR_DOC_ARENA);
    reset_via(doc_arena);

    var sb = str_builder_new_a(doc_arena);
    str_builder_add_cstr_a(doc_arena, sb, "{\"resourceSpans\":[{\"resource\":{\"attributes\":[");
    _agnosai_otlp_attr_str_a(doc_arena, sb, "service.name", service_name);
    str_builder_add_cstr_a(doc_arena, sb,
      "]},\"scopeSpans\":[{\"scope\":{\"name\":\"agnosai\"},\"spans\":[");
    for (var i = 0; i < n; i = i + 1) {
        if (i > 0) { str_builder_add_cstr_a(doc_arena, sb, ","); }
        str_builder_add_a(doc_arena, sb,
          load64(slots + ((head - n + i) % AGNOSAI_OTLP_RING_MAX) * 8));
    }
    str_builder_add_cstr_a(doc_arena, sb, "]}]}]}");
    var doc = str_builder_build_a(doc_arena, sb);

    # The fragments are copied into `doc` now, so the arena that held them can
    # go back to zero before any other thread gets the lock.
    store64(r + AGN_OTR_COUNT, 0);
    reset_via(load64(r + AGN_OTR_FRAG_ARENA));
    mutex_unlock(lock);
    return doc;
}

# --- the exporter ---------------------------------------------------------
#
# ## The POST goes through sandhi, not a raw socket
#
# hoosh opens a raw TCP socket for `http://` and only routes `https://` through
# sandhi, because its exporter thread owns no sigil crypto bank and TLS needs
# one. agnosai has no such constraint, so both schemes go through
# `sandhi_http_post` — which brings DNS, timeouts and TLS with it and deletes
# the hand-rolled HTTP/1.0 request builder hoosh had to write.
#
# ## The SSRF guard is deliberately NOT applied
#
# `src/guarded_fetch.cyr` exists because a *user* can influence the URLs the
# tool layer fetches. The collector endpoint is operator configuration read from
# `OTEL_EXPORTER_OTLP_ENDPOINT`, and the standard deployment is a sidecar on
# `http://localhost:4318` — which the SSRF guard blocks by design. Routing this
# through it would break the normal case to defend against a threat that does
# not exist here. Stated rather than silently bypassed.
#
# ## Export is best-effort
#
# A collector that is down must never fail a request or block a worker. The
# POST's result is ignored, the thread is detached, and the ring drops the
# oldest span when it is full. Telemetry loss is preferable to backpressure on
# the work the telemetry describes.
#
# ## ⚠ Every POST is bounded, in memory and in time (2.1.6)
#
# Through 2.1.5 `_agnosai_otlp_post` used the bare `sandhi_http_post`: the
# no-free global bump, and no options. Each batch therefore left its URL, its
# headers, its request bytes and sandhi's **256 KiB receive buffer** on the bump
# for good — measured at ~258 KiB of RSS per batch against a collector that
# answers (about 0.9 GB an hour at one batch a second), ~1.5 KB against one that
# is down. And with no options a collector that accepts and never answers held
# the exporter's `recv` forever, and the final flush in
# `agnosai_otlp_exporter_stop` with it, so a stop never returned.
#
# Now the exporter owns one growable arena, reset before and after every POST,
# and one options block: the collector's answer is capped at
# `AGNOSAI_OTLP_RESPONSE_MAX` (it is ignored anyway) and the exchange at
# `AGNOSAI_OTLP_CONNECT_MS` / `_IO_MS` / `_TOTAL_MS`. The arena's chunks are
# kept across resets, so it settles at the largest batch and stops growing.
#
# ## ⚠ One flush at a time (2.1.6)
#
# The exporter thread flushes on its clock and `agnosai_otlp_exporter_stop`
# flushes on the caller's thread. A drained batch lives in the ring's doc arena
# only "until the next drain", so two concurrent flushes could reset the batch
# one of them was still posting — and two posts would share the one arena. A
# mutex now covers drain and post together. A stop therefore waits for an
# in-flight post, which the timeouts above bound.

# The collector's answer is read only to finish the exchange; 16 KiB holds any
# OTLP partial-success body.
var AGNOSAI_OTLP_RESPONSE_MAX = 16384;
# Connect, per-read/-write, and whole-exchange ceilings for one batch POST, ms.
var AGNOSAI_OTLP_CONNECT_MS = 5000;
var AGNOSAI_OTLP_IO_MS = 5000;
var AGNOSAI_OTLP_TOTAL_MS = 10000;
# The exporter arena's first chunk; it grows by this much as a batch needs.
var AGNOSAI_OTLP_POST_ARENA = 65536;

# The oracle has no equivalent; hoosh batches every 1000 ms and so does this.
var AGNOSAI_OTLP_BATCH_MS = 1000;

# Exporter heap layout — 80 bytes.
enum AgnosaiOtlpExporterOff {
    AGN_OTE_RING = 0;
    # 0 when no endpoint is configured — the exporter still drains, so a
    # disabled collector does not grow the ring without bound.
    AGN_OTE_ENDPOINT = 8;
    AGN_OTE_SERVICE = 16;
    AGN_OTE_INTERVAL_MS = 24;
    AGN_OTE_STOP = 32;
    AGN_OTE_EXPORTED = 40;
    # 2.1.6 — the POST's arena, its options, the URL as a C string (built once,
    # 0 with no endpoint) and the lock that makes a flush one drain-and-post.
    AGN_OTE_ARENA = 48;
    AGN_OTE_OPTS = 56;
    AGN_OTE_URL = 64;
    AGN_OTE_LOCK = 72;
    AGN_OTE_SIZE = 80;
}

# An exporter over its own ring. `endpoint` may be 0 (drain and discard).
#
# Everything a POST needs that does not change — the URL, the options — is
# built here, once, so a flush allocates nothing outside the exporter's arena.
fn agnosai_otlp_exporter_new(endpoint, service_name: Str, interval_ms): i64 {
    var e = alloc(AGN_OTE_SIZE);
    store64(e + AGN_OTE_RING, agnosai_otlp_ring_new());
    store64(e + AGN_OTE_ENDPOINT, endpoint);
    store64(e + AGN_OTE_SERVICE, service_name);
    store64(e + AGN_OTE_INTERVAL_MS, interval_ms);
    store64(e + AGN_OTE_STOP, 0);
    store64(e + AGN_OTE_EXPORTED, 0);
    store64(e + AGN_OTE_LOCK, mutex_new());
    store64(e + AGN_OTE_ARENA, 0);
    store64(e + AGN_OTE_OPTS, 0);
    store64(e + AGN_OTE_URL, 0);
    if (endpoint != 0) {
        _agnosai_otlp_exporter_target(e, str_cstr(_agnosai_otlp_post_url(default_alloc(), endpoint)));
    }
    return e;
}

# An exporter that POSTs to `traces_url` exactly as given — the
# `OTEL_EXPORTER_OTLP_TRACES_ENDPOINT` form, which the OTel specification says is
# used as-is (2.1.6). `agnosai_otlp_exporter_new` takes the generic base form.
fn agnosai_otlp_exporter_new_traces(traces_url: Str, service_name: Str, interval_ms): i64 {
    var e = agnosai_otlp_exporter_new(0, service_name, interval_ms);
    if (traces_url != 0) {
        store64(e + AGN_OTE_ENDPOINT, traces_url);
        _agnosai_otlp_exporter_target(e, str_cstr(traces_url));
    }
    return e;
}

# Point exporter `e` at C-string `url`: the URL, the POST arena and its options.
fn _agnosai_otlp_exporter_target(e, url): i64 {
    store64(e + AGN_OTE_URL, url);
    store64(e + AGN_OTE_ARENA, arena_allocator_growable(AGNOSAI_OTLP_POST_ARENA));
    var o = sandhi_http_options_new();
    sandhi_http_options_max_response_bytes(o, AGNOSAI_OTLP_RESPONSE_MAX);
    sandhi_http_options_connect_ms(o, AGNOSAI_OTLP_CONNECT_MS);
    sandhi_http_options_read_ms(o, AGNOSAI_OTLP_IO_MS);
    sandhi_http_options_write_ms(o, AGNOSAI_OTLP_IO_MS);
    sandhi_http_options_total_ms(o, AGNOSAI_OTLP_TOTAL_MS);
    store64(e + AGN_OTE_OPTS, o);
    return e;
}

# The URL a batch is POSTed to, or 0 when the exporter has no endpoint.
fn agnosai_otlp_exporter_url(e): i64 {
    return load64(e + AGN_OTE_URL);
}

# Set the POST's connect, per-read/-write and whole-exchange ceilings, in ms.
# Returns the exporter. A no-op for an exporter with no endpoint. Call before
# `agnosai_otlp_exporter_start`: the options are read on the exporter thread.
fn agnosai_otlp_exporter_with_timeouts(e, connect_ms, io_ms, total_ms): i64 {
    var o = load64(e + AGN_OTE_OPTS);
    if (o == 0) { return e; }
    sandhi_http_options_connect_ms(o, connect_ms);
    sandhi_http_options_read_ms(o, io_ms);
    sandhi_http_options_write_ms(o, io_ms);
    sandhi_http_options_total_ms(o, total_ms);
    return e;
}

# The exporter's ring — what a caller enqueues into.
fn agnosai_otlp_exporter_ring(e): i64 {
    return load64(e + AGN_OTE_RING);
}

# Spans successfully handed to a batch, cumulative.
fn agnosai_otlp_exporter_exported(e): i64 {
    return load64(e + AGN_OTE_EXPORTED);
}

# Whether the exporter has been asked to stop.
fn agnosai_otlp_exporter_stopping(e): i64 {
    return load64(e + AGN_OTE_STOP);
}

# POST one batch document. Best-effort — the result is deliberately ignored.
#
# ⚠ Not reachable from the suite: it needs a listening collector. Everything
# that decides *what* to send is in `drain` and the encoder, which are tested
# byte-for-byte; this function only moves bytes. Recorded in roadmap section E.
# --- OTEL_EXPORTER_OTLP_HEADERS -------------------------------------------
#
# ⚠ **Without this, no hosted collector is reachable.** Honeycomb, Grafana Cloud
# and Datadog all authenticate through a header carried in this variable, and
# the module read only `OTEL_EXPORTER_OTLP_ENDPOINT` — so the exporter worked
# against an unauthenticated local sidecar and against nothing else.
#
# ⚠ There is **no oracle counterpart to port from**:
# `rust-old/src/telemetry/mod.rs:50` hands the whole transport to
# `hoosh::telemetry::init_otel`, so the oracle never implements headers, paths
# or retry — it inherits them from an SDK. ADR 003 keeps hoosh as a remote seam
# rather than linking it, so this file is port-original and its bar is the
# OTLP/HTTP spec, not a Rust line.
#
# Format is the spec's: `key1=value1,key2=value2`. Whitespace around either side
# is trimmed; an entry with no `=` is skipped.
var AGNOSAI_OTLP_HDR_MAX = 16;
var AGNOSAI_OTLP_HDR_KEY_MAX = 128;
var AGNOSAI_OTLP_HDR_VAL_MAX = 512;

# Parse `OTEL_EXPORTER_OTLP_HEADERS` onto `h`, allocating in `a`. Returns the
# number added.
#
# ⚠ An over-long key or value is **SKIPPED, never truncated**. These carry API
# tokens: a truncated token authenticates as nothing and fails at the collector
# with a 401 that looks like a credential problem rather than a parser one.
#
# The key and value are assembled in two stack buffers reused per entry; that is
# safe because `sandhi_headers_add_a` copies both into `a`.
fn _agnosai_otlp_add_env_headers_a(a, h): i64 {
    var raw = getenv("OTEL_EXPORTER_OTLP_HEADERS");
    if (raw == 0) { return 0; }

    var kbuf[128];
    var vbuf[512];
    var kp = &kbuf;
    var vp = &vbuf;
    var i = 0;
    var n = 0;

    while (load8(raw + i) != 0 && n < AGNOSAI_OTLP_HDR_MAX) {
        while (load8(raw + i) == 32 || load8(raw + i) == 44) { i = i + 1; }
        if (load8(raw + i) == 0) { return n; }

        var kl = 0;
        var kover = 0;
        while (load8(raw + i) != 0 && load8(raw + i) != 61 && load8(raw + i) != 44) {
            if (kl < AGNOSAI_OTLP_HDR_KEY_MAX - 1) {
                store8(kp + kl, load8(raw + i));
                kl = kl + 1;
            } else { kover = 1; }
            i = i + 1;
        }
        while (kl > 0 && load8(kp + kl - 1) == 32) { kl = kl - 1; }
        store8(kp + kl, 0);

        if (load8(raw + i) == 61) {
            i = i + 1;
            while (load8(raw + i) == 32) { i = i + 1; }

            var vl = 0;
            var vover = 0;
            while (load8(raw + i) != 0 && load8(raw + i) != 44) {
                if (vl < AGNOSAI_OTLP_HDR_VAL_MAX - 1) {
                    store8(vp + vl, load8(raw + i));
                    vl = vl + 1;
                } else { vover = 1; }
                i = i + 1;
            }
            while (vl > 0 && load8(vp + vl - 1) == 32) { vl = vl - 1; }
            store8(vp + vl, 0);

            if (kl > 0 && vl > 0 && kover == 0 && vover == 0) {
                sandhi_headers_add_a(a, h, kp, vp);
                n = n + 1;
            }
        }
    }
    return n;
}

# The URL to POST to: the configured endpoint, with `/v1/traces` appended when
# it carries no path of its own.
#
# ⚠ **`agnosai_otlp_path` existed for this and had ZERO production callers** —
# only five assertions in `tests/telemetry_otlp.tcyr`. `_agnosai_otlp_post`
# posted `str_cstr(endpoint)` raw, so the documented deployment
# (`OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318`, the sidecar form this
# module's own header describes) sent `POST /` and every collector answered 404.
# The whole telemetry tier was silently non-functional. Fixed 2026-08-12.
#
# ⚠ **The generic endpoint is a BASE URL (2.1.6)** — the OTel exporter
# specification: `OTEL_EXPORTER_OTLP_ENDPOINT` gets `v1/traces` appended to its
# path, so `http://c:4318` and `http://c:4318/` post to `/v1/traces` and a
# gateway's `https://gw/otlp` to `/otlp/v1/traces`. Through 2.1.5 an endpoint
# naming any path was posted to as given — the rule the spec gives the
# per-signal `OTEL_EXPORTER_OTLP_TRACES_ENDPOINT` only — so `/` and `/otlp`
# 404'd at the collector and every span was lost in silence.
#
# One leniency, kept from 2.1.5 on purpose: a base that already ends in
# `/v1/traces` is used as given. The spec would make it `/v1/traces/v1/traces`,
# a path no collector serves, and it is the commonest way the variable is set
# by mistake. The as-is form proper is `agnosai_otlp_exporter_new_traces`.
fn _agnosai_otlp_post_url(a, endpoint: Str): Str {
    var n = str_len(endpoint);
    var d = str_data(endpoint);
    var tail = AGNOSAI_OTLP_DEFAULT_PATH;   # "/v1/traces"
    var tl = strlen(tail);
    if (n >= tl && memeq(d + n - tl, tail, tl) == 1) { return endpoint; }
    var sb = str_builder_new_a(a);
    str_builder_add_a(a, sb, endpoint);
    if (n > 0 && load8(d + n - 1) == 47) {
        str_builder_add_cstr_a(a, sb, tail + 1);   # "v1/traces" after the base's own '/'
    } else {
        str_builder_add_cstr_a(a, sb, tail);
    }
    return str_builder_build_a(a, sb);
}

# POST one batch through exporter `e`'s arena and options. The caller holds the
# exporter's lock. Everything the POST allocates — headers, the request, the
# answer — is in the arena, which is reset before and after, so nothing outlives
# the call (2.1.6; see the module header).
fn _agnosai_otlp_post_e(e, doc: Str): i64 {
    var url = load64(e + AGN_OTE_URL);
    var a = load64(e + AGN_OTE_ARENA);
    if (url == 0 || a == 0) { return 0; }
    reset_via(a);
    var h = sandhi_headers_new_a(a);
    if (h != 0) {
        sandhi_headers_add_a(a, h, "Content-Type", "application/json");
        _agnosai_otlp_add_env_headers_a(a, h);
        sandhi_http_post_opts_a(a, url, h, str_data(doc), str_len(doc), load64(e + AGN_OTE_OPTS));
    }
    reset_via(a);
    return 0;
}

# Drain the ring once and POST whatever came out. Returns the number of spans
# in the batch, or 0 when there was nothing to send.
#
# The testable half of the exporter: it decides *whether* and *what*, and only
# the final byte-moving step needs a collector.
#
# ⚠ Under the exporter's lock, drain and post together (2.1.6): the batch lives
# in the ring's doc arena only until the next drain, and the POST's arena is the
# exporter's one. See the module header.
fn agnosai_otlp_exporter_flush(e): i64 {
    var lock = load64(e + AGN_OTE_LOCK);
    mutex_lock(lock);
    var ring = load64(e + AGN_OTE_RING);
    var n = agnosai_otlp_ring_count(ring);
    if (n == 0) {
        mutex_unlock(lock);
        return 0;
    }
    var doc = agnosai_otlp_ring_drain(ring, load64(e + AGN_OTE_SERVICE));
    if (doc == 0) {
        mutex_unlock(lock);
        return 0;
    }
    store64(e + AGN_OTE_EXPORTED, load64(e + AGN_OTE_EXPORTED) + n);
    # ⚠ The drain happens even with no endpoint. Skipping it would let the ring
    # fill and every span report as dropped, which reads like a bug in the
    # exporter rather than an absent collector.
    _agnosai_otlp_post_e(e, doc);
    mutex_unlock(lock);
    return n;
}

# How often the sleeping exporter checks whether it has been asked to stop.
var AGNOSAI_OTLP_STOP_POLL_MS = 25;

# The background loop: flush every `interval_ms` until asked to stop.
#
# ⚠ The sleep is **sliced**, not one `sleep_ms(interval_ms)`. A single sleep
# means `stop` is not noticed for up to a full interval, and the process cannot
# exit in the meantime — `.tcyr` epilogues and `_agnosai_exit_process`'s agnos
# path both end with `syscall(60, ..)`, which exits one *thread*, so a detached
# thread still sleeping holds the whole process open. Measured: one second of
# dead wait on every shutdown, and on `tests/telemetry_mod.tcyr`. Slicing turns
# that into at most `AGNOSAI_OTLP_STOP_POLL_MS`.
#
# ⚠ The loop does NOT flush on the way out. `agnosai_otlp_exporter_stop` does
# the final flush on the caller's thread, so exiting here would double it.
fn _agnosai_otlp_exporter_thread(e): i64 {
    while (load64(e + AGN_OTE_STOP) == 0) {
        var interval = load64(e + AGN_OTE_INTERVAL_MS);
        var slept = 0;
        while (slept < interval) {
            if (load64(e + AGN_OTE_STOP) != 0) { break; }
            var slice = AGNOSAI_OTLP_STOP_POLL_MS;
            if (interval - slept < slice) { slice = interval - slept; }
            sleep_ms(slice);
            slept = slept + slice;
        }
        if (load64(e + AGN_OTE_STOP) != 0) { break; }
        agnosai_otlp_exporter_flush(e);
    }
    return 0;
}

# Start the background exporter. Detached — nothing ever joins it.
#
# `thread_create_detached` rather than `thread_create`: a joinable thread nobody
# joins leaks its 2 MiB stack for the life of the process (cyrius 6.5.8's own
# filing from this repo).
fn agnosai_otlp_exporter_start(e): i64 {
    thread_create_detached(&_agnosai_otlp_exporter_thread, e);
    return 0;
}

# Stop the loop and flush what is left. Returns the spans in the final batch.
#
# A flush already in flight on the exporter thread finishes first: flushes take
# the exporter's lock (2.1.6). The wait is bounded by the POST's timeouts, so a
# stop against a collector that never answers returns within about
# `AGNOSAI_OTLP_TOTAL_MS` twice over — the in-flight batch, then the last one.
#
# ⚠ The final flush is the point. The oracle's `TracingGuard` exports pending
# spans when it drops; without this, every span queued in the last interval is
# lost on a clean shutdown — the batch most likely to explain why the process
# is shutting down.
fn agnosai_otlp_exporter_stop(e): i64 {
    store64(e + AGN_OTE_STOP, 1);
    return agnosai_otlp_exporter_flush(e);
}
