# =========================================================================
# core_error — the top-level AgnosAI error type.
#
# Parity oracle: rust-old/src/core/error.rs
#
# Port notes (divergences from the Rust shape, all deliberate):
#   * `thiserror`'s derived `Display` becomes `agnosai_error_message`, which
#     builds the same text. The strings are log- and wire-visible, so they are
#     held byte-for-byte to the oracle's `#[error("...")]` attributes.
#   * The `#[from]` conversions for `serde_json::Error` and `std::io::Error`
#     become explicit constructors taking the already-rendered detail string:
#     Cyrius has no trait-based conversion, and both foreign errors reach us as
#     text anyway (bayan's parse error, the syscall errno).
#   * `Timeout(Duration)` carries an i64 **nanosecond** count, matching the
#     representation learning_profile established. Its rendering reproduces
#     Rust's `Duration` `Debug` output — see `_agnosai_fmt_duration_debug`.
#   * `Result<T, AgnosaiError>` has no direct analogue here. Callers return 0
#     for "no error" or an error pointer; the stdlib `Result`/`?` machinery
#     stays available for the modules that want it.
# =========================================================================

# Error kinds, in the oracle's declaration order.
enum AgnosaiErrorKind {
    AGNOSAI_ERR_AGENT_NOT_FOUND = 0;
    AGNOSAI_ERR_TASK_NOT_FOUND = 1;
    AGNOSAI_ERR_CREW_NOT_FOUND = 2;
    AGNOSAI_ERR_INVALID_DEFINITION = 3;
    AGNOSAI_ERR_CYCLIC_DAG = 4;
    AGNOSAI_ERR_SCHEDULING = 5;
    AGNOSAI_ERR_LLM_PROVIDER = 6;
    AGNOSAI_ERR_TOOL_EXECUTION = 7;
    AGNOSAI_ERR_SANDBOX = 8;
    AGNOSAI_ERR_FLEET = 9;
    AGNOSAI_ERR_IPC = 10;
    AGNOSAI_ERR_SERIALIZATION = 11;
    AGNOSAI_ERR_IO = 12;
    AGNOSAI_ERR_TIMEOUT = 13;
    AGNOSAI_ERR_OTHER = 14;
}

# AgnosaiError heap layout — 24 bytes.
# `detail` carries the String payload every variant but CyclicDAG and Timeout
# has; `timeout_ns` carries Timeout's Duration.
enum AgnosaiErrorOff {
    AGN_ERR_KIND = 0;
    AGN_ERR_DETAIL = 8;
    AGN_ERR_TIMEOUT_NS = 16;
    AGN_ERR_SIZE = 24;
}

# Allocate an error of `kind` carrying `detail`. `detail` may be 0 for the
# variants that have no String payload.
fn _agnosai_error_new(kind, detail: Str): i64 {
    var e = alloc(AGN_ERR_SIZE);
    store64(e + AGN_ERR_KIND, kind);
    store64(e + AGN_ERR_DETAIL, detail);
    store64(e + AGN_ERR_TIMEOUT_NS, 0);
    return e;
}

# Append `value` to `sb` with `frac_digits` of fractional part, trailing zeros
# trimmed and the point omitted entirely when the fraction is zero. This is the
# shape Rust's `Duration` Debug uses to turn 1_500_000_000 ns into "1.5s" and
# 30_000_000_000 ns into "30s" rather than "30.000000000s".
fn _agnosai_append_fract(sb, fract, frac_digits): i64 {
    if (fract == 0) { return 0; }

    # Render the fraction zero-padded to frac_digits, then trim the tail.
    var digits[24];
    var n = fract;
    for (var i = frac_digits - 1; i >= 0; i = i - 1) {
        store8(&digits + i, 48 + (n % 10));
        n = n / 10;
    }
    var last = frac_digits - 1;
    while (last >= 0) {
        if (load8(&digits + last) != 48) { break; }
        last = last - 1;
    }
    if (last < 0) { return 0; }

    str_builder_putc(sb, 46);
    for (var j = 0; j <= last; j = j + 1) {
        str_builder_putc(sb, load8(&digits + j));
    }
    return 0;
}

# Render `ns` the way Rust's `Duration` `Debug` does: the largest unit whose
# integer part is non-zero, with a trimmed fractional tail. 30_000_000_000 ->
# "30s", 1_500_000_000 -> "1.5s", 100_000_000 -> "100ms", 1_500 -> "1.5µs",
# 100 -> "100ns".
fn _agnosai_fmt_duration_debug(sb, ns): i64 {
    if (ns >= AGNOSAI_NS_PER_SEC) {
        str_builder_add_int(sb, ns / AGNOSAI_NS_PER_SEC);
        _agnosai_append_fract(sb, ns % AGNOSAI_NS_PER_SEC, 9);
        str_builder_add_cstr(sb, "s");
        return 0;
    }
    if (ns >= AGNOSAI_NS_PER_MS) {
        str_builder_add_int(sb, ns / AGNOSAI_NS_PER_MS);
        _agnosai_append_fract(sb, ns % AGNOSAI_NS_PER_MS, 6);
        str_builder_add_cstr(sb, "ms");
        return 0;
    }
    if (ns >= AGNOSAI_NS_PER_US) {
        str_builder_add_int(sb, ns / AGNOSAI_NS_PER_US);
        _agnosai_append_fract(sb, ns % AGNOSAI_NS_PER_US, 3);
        str_builder_add_cstr(sb, "\u{b5}s");
        return 0;
    }
    str_builder_add_int(sb, ns);
    str_builder_add_cstr(sb, "ns");
    return 0;
}

# The `#[error("...")]` prefix for a kind, including its trailing ": " where
# the oracle has one. CyclicDAG and Other render without a detail, so they
# return their whole text and 0 respectively.
fn _agnosai_error_prefix(kind): i64 {
    if (kind == AGNOSAI_ERR_AGENT_NOT_FOUND) { return str_from("agent not found: "); }
    if (kind == AGNOSAI_ERR_TASK_NOT_FOUND) { return str_from("task not found: "); }
    if (kind == AGNOSAI_ERR_CREW_NOT_FOUND) { return str_from("crew not found: "); }
    if (kind == AGNOSAI_ERR_INVALID_DEFINITION) { return str_from("invalid definition: "); }
    if (kind == AGNOSAI_ERR_CYCLIC_DAG) { return str_from("task DAG contains a cycle"); }
    if (kind == AGNOSAI_ERR_SCHEDULING) { return str_from("scheduling error: "); }
    if (kind == AGNOSAI_ERR_LLM_PROVIDER) { return str_from("LLM provider error: "); }
    if (kind == AGNOSAI_ERR_TOOL_EXECUTION) { return str_from("tool execution error: "); }
    if (kind == AGNOSAI_ERR_SANDBOX) { return str_from("sandbox error: "); }
    if (kind == AGNOSAI_ERR_FLEET) { return str_from("fleet error: "); }
    if (kind == AGNOSAI_ERR_IPC) { return str_from("IPC error: "); }
    if (kind == AGNOSAI_ERR_SERIALIZATION) { return str_from("serialization error: "); }
    if (kind == AGNOSAI_ERR_IO) { return str_from("I/O error: "); }
    if (kind == AGNOSAI_ERR_TIMEOUT) { return str_from("timeout after "); }
    return str_from("");
}

# The requested agent was not found.
fn agnosai_error_agent_not_found(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_AGENT_NOT_FOUND, detail);
}

# The requested task was not found.
fn agnosai_error_task_not_found(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_TASK_NOT_FOUND, detail);
}

# The requested crew was not found.
fn agnosai_error_crew_not_found(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_CREW_NOT_FOUND, detail);
}

# An agent or crew definition failed validation.
fn agnosai_error_invalid_definition(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_INVALID_DEFINITION, detail);
}

# The task dependency graph contains a cycle. Carries no detail.
fn agnosai_error_cyclic_dag(): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_CYCLIC_DAG, 0);
}

# An error occurred during task scheduling.
fn agnosai_error_scheduling(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_SCHEDULING, detail);
}

# An LLM provider returned an error.
fn agnosai_error_llm_provider(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_LLM_PROVIDER, detail);
}

# A tool failed during execution.
fn agnosai_error_tool_execution(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_TOOL_EXECUTION, detail);
}

# A sandbox operation failed.
fn agnosai_error_sandbox(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_SANDBOX, detail);
}

# A fleet/cluster operation failed.
fn agnosai_error_fleet(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_FLEET, detail);
}

# An inter-process communication error.
fn agnosai_error_ipc(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_IPC, detail);
}

# JSON serialization or deserialization failed. Replaces the oracle's
# `#[from] serde_json::Error`; pass the already-rendered parser message.
fn agnosai_error_serialization(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_SERIALIZATION, detail);
}

# An I/O operation failed. Replaces the oracle's `#[from] std::io::Error`;
# pass the already-rendered errno message.
fn agnosai_error_io(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_IO, detail);
}

# An operation exceeded its time limit, after `ns` nanoseconds.
fn agnosai_error_timeout(ns): i64 {
    var e = _agnosai_error_new(AGNOSAI_ERR_TIMEOUT, 0);
    store64(e + AGN_ERR_TIMEOUT_NS, ns);
    return e;
}

# Catch-all for errors that don't fit other variants. Renders as the bare
# detail, with no prefix.
fn agnosai_error_other(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_OTHER, detail);
}

# Which variant this error is.
fn agnosai_error_kind(e): i64 {
    return load64(e + AGN_ERR_KIND);
}

# The String payload, or 0 for the variants that carry none.
fn agnosai_error_detail(e): i64 {
    return load64(e + AGN_ERR_DETAIL);
}

# The timeout duration in nanoseconds. 0 for every kind but Timeout.
fn agnosai_error_timeout_ns(e): i64 {
    return load64(e + AGN_ERR_TIMEOUT_NS);
}

# The rendered error text — the oracle's `Display`.
fn agnosai_error_message(e): i64 {
    var kind = load64(e + AGN_ERR_KIND);
    var sb = str_builder_new();
    str_builder_add(sb, _agnosai_error_prefix(kind));

    if (kind == AGNOSAI_ERR_TIMEOUT) {
        _agnosai_fmt_duration_debug(sb, load64(e + AGN_ERR_TIMEOUT_NS));
        return str_builder_build(sb);
    }

    var detail = load64(e + AGN_ERR_DETAIL);
    if (detail != 0) { str_builder_add(sb, detail); }
    return str_builder_build(sb);
}
