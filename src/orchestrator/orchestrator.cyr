# =========================================================================
# orchestrator/orchestrator — the crew registry and lifecycle.
#
# Origin: rust-old/src/orchestrator/orchestrator.rs
#
# The layer above `orch_crew_runner`: it accepts a crew spec, registers it,
# hands it to a runner, records the result, and lets a caller cancel it by id.
# The last M5 module.
#
# ## What the HTTP seam removes
#
# The oracle's struct carries a `ResponseCache` and a `CostTracker`, both
# `pub use hoosh::…` re-exports shared across every crew execution. Neither is
# here: hoosh caches and costs server-side, and `orch_crew_runner`'s header
# records why deleting the client cache is a correctness fix rather than a
# simplification. What remains is genuinely agnosai's — the registry, the
# cancellation tokens, the budget, the audit chain and the event bus.
#
# The `OnceLock<Arc<HooshClient>>` lazy-init also goes: the port's client is two
# Strs, so there is nothing expensive to defer. `llm_url` of 0 keeps its meaning
# — no gateway configured, so every task takes the placeholder path.
#
# ## Concurrency
#
# The oracle bounds concurrent crews with a `Semaphore` of the budget's
# `max_concurrent_tasks`, and so does this since 2.4.1 (ADR 033): a crew waits its
# turn, PENDING, before it runs, whether a caller runs it inline or submits it.
# Through 2.4.0 the field was stored and read by nothing, so every crew ran at once.
# The registry is mutex-guarded because `orch_crew_runner`'s parallel and DAG modes
# spawn real threads and a caller may drive several crews from several threads.
# `MAX_RETAINED_CREWS` is the oracle's, and so is that eviction only takes
# **finished** crews: a registry full of running crews grows past the cap rather
# than dropping live state. Which finished crews go is not the oracle's since 2.2.4
# (ADR 026).
# =========================================================================

include "src/semaphore.cyr"
include "src/orchestrator/multi_tenant.cyr"

# The oracle's `MAX_RETAINED_CREWS`, over crews that have ended (ADR 026): a submit that finds
# this many evicts. Crews still running are not counted, and are never evicted.
var AGNOSAI_MAX_RETAINED_CREWS = 1000;

# How many ended crews eviction leaves (ADR 026). The gap is what makes a submit at the cap
# cheap on average, and at 10% of the cap it costs a reader almost none of its window.
var AGNOSAI_CREWS_LOW_WATER = 900;

# The oracle's fallback execution timeout when the budget sets none — one hour.
var AGNOSAI_DEFAULT_CREW_TIMEOUT_SECS = 3600;

# The oracle's fallback for how many crews run at once when the budget sets none:
# `budget.max_concurrent_tasks.unwrap_or(10)` (`orchestrator.rs:55`).
var AGNOSAI_DEFAULT_MAX_CONCURRENT_CREWS = 10;

enum AgnosaiOrchestratorOff {
    AGN_OR_CREWS = 0;
    AGN_OR_BUDGET = 8;
    AGN_OR_EVENTS = 16;
    AGN_OR_LLM_URL = 24;
    AGN_OR_LLM_KEY = 32;
    AGN_OR_CANCEL = 40;
    AGN_OR_AUDIT = 48;
    AGN_OR_MUTEX = 56;
    AGN_OR_ENDED = 64;
    AGN_OR_ENDED_HEAD = 72;
    # The registry agents get their tools from, and the journal, each 0 for none (ADR 029).
    AGN_OR_TOOLS = 80;
    AGN_OR_TOOL_JOURNAL = 88;
    # The gate a task needing a reviewer waits on, or 0 for none, and whether `medium` risk needs
    # one (ADR 032).
    AGN_OR_GATE = 96;
    AGN_OR_APPROVE_MEDIUM = 104;
    # The turns a crew waits for before it runs (ADR 033): one permit a crew.
    AGN_OR_CREW_SEM = 112;
    # The tenants a crew may run for, or 0 for none, and what each has spent and has running: a
    # map from tenant id to a `TenantUse`, on the global heap, as it outlives every crew (ADR 033).
    AGN_OR_TENANTS = 120;
    AGN_OR_TENANT_USE = 128;
    # The most tasks a crew may have, or `AGNOSAI_NO_LIMIT` (ADR 033).
    AGN_OR_MAX_TASKS = 136;
    # Each registered crew's runner, by id, for its snapshot (ADR 036). Unlike `CANCEL` it stays
    # when the run ends, and goes as the crew leaves the registry, so a finished crew's snapshot
    # says it finished.
    AGN_OR_RUNNERS = 144;
    # Where each crew's log goes, or 0 for none (ADR 036).
    AGN_OR_STORE = 152;
    # The pool the crews this orchestrator owns take their arenas from, made on first use, under
    # `MUTEX` (ADR 037).
    AGN_OR_POOL = 160;
    AGN_OR_SIZE = 168;
}

# What a tenant has spent, through every crew it ran, and how many of its crews are admitted and
# still to end. Under the orchestrator's lock.
enum AgnosaiTenantUseOff {
    AGN_TU_TRACKER = 0;
    AGN_TU_ACTIVE = 8;
    AGN_TU_SIZE = 16;
}

# How many crews run at once under `budget`: its `max_concurrent_tasks`, or the oracle's 10 when it
# sets none, as `agnosai_orchestrator_timeout_secs` falls back to the oracle's hour. A budget of 0,
# `AGNOSAI_NO_LIMIT` and anything below 1 all set none.
fn _agnosai_orch_crew_permits(budget): i64 {
    if (budget == 0) { return AGNOSAI_DEFAULT_MAX_CONCURRENT_CREWS; }
    var n = agnosai_resource_budget_max_concurrent_tasks(budget);
    if (n == AGNOSAI_NO_LIMIT || n <= 0) { return AGNOSAI_DEFAULT_MAX_CONCURRENT_CREWS; }
    return n;
}

# Create an orchestrator over a resource budget.
#
# The audit chain is minted here with its own CSPRNG key, exactly as the
# oracle's `Orchestrator::new` does — it is the orchestration trail, separate by
# construction from hoosh's inference trail.
fn agnosai_orchestrator_new(budget): i64 {
    var o = alloc(AGN_OR_SIZE);
    store64(o + AGN_OR_CREWS, map_new_str());
    store64(o + AGN_OR_BUDGET, budget);
    store64(o + AGN_OR_EVENTS, 0);
    store64(o + AGN_OR_LLM_URL, 0);
    store64(o + AGN_OR_LLM_KEY, str_from(""));
    store64(o + AGN_OR_CANCEL, map_new_str());
    store64(o + AGN_OR_AUDIT, agnosai_audit_chain_new());
    store64(o + AGN_OR_MUTEX, mutex_new());
    store64(o + AGN_OR_ENDED, vec_new());
    store64(o + AGN_OR_ENDED_HEAD, 0);
    store64(o + AGN_OR_TOOLS, 0);
    store64(o + AGN_OR_TOOL_JOURNAL, 0);
    # Its own gate, as it has its own audit chain (ADR 032). The server's `/api/v1/approvals`
    # decides through this one.
    store64(o + AGN_OR_GATE, agnosai_approval_gate_new());
    store64(o + AGN_OR_APPROVE_MEDIUM, 0);
    store64(o + AGN_OR_CREW_SEM, agnosai_semaphore_new(_agnosai_orch_crew_permits(budget)));
    store64(o + AGN_OR_TENANTS, 0);
    store64(o + AGN_OR_TENANT_USE, map_new_str());
    store64(o + AGN_OR_MAX_TASKS, AGNOSAI_NO_LIMIT);
    store64(o + AGN_OR_RUNNERS, map_new_str());
    store64(o + AGN_OR_STORE, 0);
    store64(o + AGN_OR_POOL, 0);
    return o;
}

# Hold every crew that names a tenant to `registry`'s budget for it (ADR 033), or 0 for none. A
# crew whose tenant it does not hold is refused; one whose tenant has spent its tokens or its cost,
# or has its `max_concurrent_crews` admitted already, is refused; the rest count what they spend
# against their tenant's, as their crew's own budget does. Set it before any crew runs: it is read
# without the lock. Returns the orchestrator.
fn agnosai_orchestrator_with_tenants(o, registry): i64 {
    store64(o + AGN_OR_TENANTS, registry);
    return o;
}

# The tenant registry crews are held to, or 0.
fn agnosai_orchestrator_tenants(o): i64 {
    return load64(o + AGN_OR_TENANTS);
}

# Refuse a crew of more than `n` tasks (ADR 033); `AGNOSAI_NO_LIMIT`, the default, for none. A
# refused crew never registers. Returns the orchestrator.
fn agnosai_orchestrator_with_max_tasks(o, n): i64 {
    store64(o + AGN_OR_MAX_TASKS, n);
    return o;
}

# The most tasks a crew may have here, or `AGNOSAI_NO_LIMIT`.
fn agnosai_orchestrator_max_tasks(o): i64 {
    return load64(o + AGN_OR_MAX_TASKS);
}

# What `tenant` has spent here, a tracker, or 0 for a tenant no crew has run for.
fn agnosai_orchestrator_tenant_spent(o, tenant: Str): i64 {
    var mtx = load64(o + AGN_OR_MUTEX);
    mutex_lock(mtx);
    var tu = map_get(load64(o + AGN_OR_TENANT_USE), tenant);
    mutex_unlock(mtx);
    if (tu == 0) { return 0; }
    return load64(tu + AGN_TU_TRACKER);
}

# How many of `tenant`'s crews are admitted here and still to end.
fn agnosai_orchestrator_tenant_active(o, tenant: Str): i64 {
    var mtx = load64(o + AGN_OR_MUTEX);
    mutex_lock(mtx);
    var tu = map_get(load64(o + AGN_OR_TENANT_USE), tenant);
    var n = 0;
    if (tu != 0) { n = load64(tu + AGN_TU_ACTIVE); }
    mutex_unlock(mtx);
    return n;
}

# Forget what `tenant` has spent, at the start of whatever period its operator keeps. A crew of
# its still running goes on counting from 0. Returns 1, or 0 for a tenant no crew has run for.
fn agnosai_orchestrator_reset_tenant(o, tenant: Str): i64 {
    var t = agnosai_orchestrator_tenant_spent(o, tenant);
    if (t == 0) { return 0; }
    agnosai_budget_tracker_reset(t);
    return 1;
}

# How many crews this orchestrator runs at once (ADR 033). A crew past that waits its turn,
# `pending`, in the order it came.
fn agnosai_orchestrator_max_concurrent_crews(o): i64 {
    return agnosai_semaphore_permits(load64(o + AGN_OR_CREW_SEM));
}

# How many crews are waiting for a turn now: registered, `pending`, and still to run.
fn agnosai_orchestrator_crews_queued(o): i64 {
    return agnosai_semaphore_waiting(load64(o + AGN_OR_CREW_SEM));
}

# The gate this orchestrator's crews wait on for a reviewer, or 0 for none (ADR 032). Hand it to
# whatever decides: `POST /api/v1/approvals` does, through the server's state.
fn agnosai_orchestrator_approval_gate(o): i64 {
    return load64(o + AGN_OR_GATE);
}

# Replace the approval gate, or remove it with 0. ⚠ **With none, a task that needs a reviewer
# fails**, its answer withheld, as nothing can approve it. Read when a crew is registered.
fn agnosai_orchestrator_with_approval_gate(o, gate): i64 {
    store64(o + AGN_OR_GATE, gate);
    return o;
}

# Make a `medium` task wait on a reviewer too, with 1. `high` always does, and `low` never.
fn agnosai_orchestrator_with_medium_approval(o, on): i64 {
    var v = 0;
    if (on == 1) { v = 1; }
    store64(o + AGN_OR_APPROVE_MEDIUM, v);
    return o;
}

# Attach an event bus. Each crew gets its own sender, removed when it finishes.
fn agnosai_orchestrator_with_events(o, bus): i64 {
    store64(o + AGN_OR_EVENTS, bus);
    return o;
}

# Point the orchestrator at a hoosh gateway. Without one, every task takes the
# placeholder path — the oracle's `llm_url: None`.
fn agnosai_orchestrator_with_llm_url(o, url: Str, api_key: Str): i64 {
    store64(o + AGN_OR_LLM_URL, url);
    store64(o + AGN_OR_LLM_KEY, api_key);
    return o;
}

# Hand the orchestrator the registry its crews' agents get their tools from (ADR 029).
#
# The registry stays the caller's: it can register to it at any time, hold it to a gate, and serve
# the same one on `/mcp`. With none, every crew runs as it did before the tool loop: an agent's
# `tools` are words in its prompt. Each crew reads this when it is registered.
fn agnosai_orchestrator_with_tools(o, registry): i64 {
    store64(o + AGN_OR_TOOLS, registry);
    return o;
}

# The registry crews get their tools from, or 0.
fn agnosai_orchestrator_tools(o): i64 {
    return load64(o + AGN_OR_TOOLS);
}

# Attach a journal every tool call is written to before it runs (`agnosai_tool_journal_new`).
fn agnosai_orchestrator_with_tool_journal(o, journal): i64 {
    store64(o + AGN_OR_TOOL_JOURNAL, journal);
    return o;
}

# Give every crew a log in `store` (ADR 036), or 0 for none, the default. Each crew it registers
# writes its spec there first, then every event it sends and each tool call's intent before the
# call runs; `agnosai_orchestrator_recover` reads them back after a restart. A crew's log goes when
# the crew leaves the registry. Set it before any crew runs. Returns the orchestrator.
fn agnosai_orchestrator_with_state_store(o, store): i64 {
    store64(o + AGN_OR_STORE, store);
    return o;
}

# The store crews' logs go to, or 0.
fn agnosai_orchestrator_state_store(o): i64 {
    return load64(o + AGN_OR_STORE);
}

# Replace the audit chain — the oracle's `with_audit`.
fn agnosai_orchestrator_with_audit(o, chain): i64 {
    store64(o + AGN_OR_AUDIT, chain);
    return o;
}

# The orchestrator's audit chain.
fn agnosai_orchestrator_audit(o): i64 {
    return load64(o + AGN_OR_AUDIT);
}

# The resource budget.
fn agnosai_orchestrator_budget(o): i64 {
    return load64(o + AGN_OR_BUDGET);
}

# A crew's last known state by id, or 0 when it is not registered.
fn agnosai_orchestrator_crew(o, crew_id: Str): i64 {
    var mtx = load64(o + AGN_OR_MUTEX);
    mutex_lock(mtx);
    var s = map_get(load64(o + AGN_OR_CREWS), crew_id);
    mutex_unlock(mtx);
    return s;
}

# A snapshot of a crew from its state alone: its status, and each result's task and status.
fn _agnosai_orch_state_snapshot_a(a, state): i64 {
    var list = bayan_json_v_arr_new_a(a);
    var results = agnosai_crew_state_results(state);
    for (var i = 0; i < vec_len(results); i = i + 1) {
        var res = vec_get(results, i);
        var e = bayan_json_v_obj_new_a(a);
        bayan_json_v_obj_set_a(a, e, str_from_a(a, "task_id"),
          bayan_json_v_str_new_a(a, str_clone_a(a, agnosai_task_result_task_id(res))));
        bayan_json_v_obj_set_a(a, e, str_from_a(a, "status"),
          bayan_json_v_str_new_a(a, agnosai_task_status_to_wire_a(a, agnosai_task_result_status(res))));
        bayan_json_v_arr_push_a(a, list, e);
    }
    var v = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, v, str_from_a(a, "crew_id"),
      bayan_json_v_str_new_a(a, str_clone_a(a, agnosai_crew_state_crew_id(state))));
    bayan_json_v_obj_set_a(a, v, str_from_a(a, "status"),
      bayan_json_v_str_new_a(a, agnosai_crew_status_to_wire_a(a, agnosai_crew_state_status(state))));
    bayan_json_v_obj_set_a(a, v, str_from_a(a, "seq"), bayan_json_v_int_new_a(a, 0));
    bayan_json_v_obj_set_a(a, v, str_from_a(a, "tasks"), list);
    return v;
}

# A snapshot of a registered crew (ADR 036), in `a`: `agnosai_crew_runner_snapshot_a`'s value, or 0
# for a crew the registry does not hold. A reader that fell behind a crew's events reads this and
# goes on from the first event after its `seq`. A finished crew's says it finished, until the crew
# leaves the registry.
#
# ⚠ Read with no hold on the crew, as `agnosai_orchestrator_crew` is: a consumer that releases a
# crew (ADR 028) does not ask for its snapshot after.
fn agnosai_orchestrator_crew_snapshot_a(a, o, crew_id: Str): i64 {
    var mtx = load64(o + AGN_OR_MUTEX);
    mutex_lock(mtx);
    var runner = map_get(load64(o + AGN_OR_RUNNERS), crew_id);
    var state = map_get(load64(o + AGN_OR_CREWS), crew_id);
    # Held while it is read, when the orchestrator owns it (ADR 037): the snapshot copies its
    # strings, and the hold keeps them from going back meanwhile.
    var hold = 0;
    if (runner != 0 && load64(load64(runner + AGN_CR_SPEC) + AGN_CREW_OWNER) == o) {
        hold = load64(runner + AGN_CR_SPEC);
        store64(hold + AGN_CREW_HOLDS, load64(hold + AGN_CREW_HOLDS) + 1);
    }
    mutex_unlock(mtx);
    if (runner == 0 && state == 0) { return 0; }
    # A crew put back from its log after a restart (ADR 036) has no runner and sent no event in
    # this process: its state is all there is, at `seq` 0.
    if (runner == 0) { return _agnosai_orch_state_snapshot_a(a, state); }
    # A crew that ended without its run starting, cancelled while it waited for its turn or with no
    # thread to run on, sent no event to agree with: it reads as the registry has it, or a reader
    # would wait on a `pending` crew for good.
    var ended = 0 - 1;
    if (state != 0 && _agnosai_orch_is_finished(state) == 1) { ended = agnosai_crew_state_status(state); }
    var v = _agnosai_crew_runner_snapshot_ended_a(a, runner, ended);
    agnosai_orchestrator_let_go(o, hold);
    return v;
}

# The ids of every crew the registry holds, as a vec of Str.
#
# The oracle has no equivalent: its handlers hold an `RwLock` read guard and
# walk `orch_state.active_crews.values()` directly. That shape does not port —
# holding this mutex across a caller's arbitrary work would stall every worker
# thread's crew lookups, which is the same reasoning `tools_registry.list` and
# `server_state`'s definitions snapshot already follow.
#
# So callers take the ids under the lock, then fetch each state with
# `agnosai_orchestrator_crew` afterwards. A crew that finishes between the two
# calls answers 0 and the caller skips it — which is the behaviour a read guard
# would have prevented, and is worth less than the contention it costs.
# Added for `routes/dashboard.rs`, its only consumer today.
fn agnosai_orchestrator_crew_ids_a(a, o): i64 {
    var mtx = load64(o + AGN_OR_MUTEX);
    mutex_lock(mtx);
    var m = load64(o + AGN_OR_CREWS);
    var ids = vec_new_a(a);
    var n = _agnosai_map_slots(m);
    for (var i = 0; i < n; i = i + 1) {
        # A copy, in `a`: a key is in its crew's arena, which may go back (ADR 037).
        if (_agnosai_map_slot_live(m, i) == 1) {
            vec_push_a(a, ids, str_clone_a(a, _agnosai_map_slot_key(m, i)));
        }
    }
    mutex_unlock(mtx);
    return ids;
}

# Global-allocator form of `agnosai_orchestrator_crew_ids_a`.
#
# Slot-walked rather than `map_keys` (standing rule 5), which is what lets the
# dashboard routes' id snapshot land in the request arena. Both dashboard
# handlers take this snapshot on every call.
fn agnosai_orchestrator_crew_ids(o): i64 {
    return agnosai_orchestrator_crew_ids_a(default_alloc(), o);
}

# How many crews the registry holds.
fn agnosai_orchestrator_crew_count(o): i64 {
    var mtx = load64(o + AGN_OR_MUTEX);
    mutex_lock(mtx);
    var n = map_size(load64(o + AGN_OR_CREWS));
    mutex_unlock(mtx);
    return n;
}

# The crew execution timeout in seconds — the budget's, or the one-hour default.
fn agnosai_orchestrator_timeout_secs(o): i64 {
    # ⚠ **The NULL-budget guard is load-bearing as of 2026-08-12.** Until the
    # timeout was actually enforced this function had zero callers, so a
    # `agnosai_orchestrator_new(0)` was harmless — and four suites construct one
    # exactly that way (`server_router`, `server_routes_sse`, `server_routes_a2a`).
    # Wiring the timeout put this on every crew run, where the old unguarded
    # `load64(0 + AGN_BUD_MAX_DURATION_SECS)` would fault. A budget-less
    # orchestrator gets the oracle's own 3600 s default, which is also what
    # `ResourceBudget::default()` yields.
    var budget = load64(o + AGN_OR_BUDGET);
    if (budget == 0) { return AGNOSAI_DEFAULT_CREW_TIMEOUT_SECS; }
    var secs = agnosai_resource_budget_max_duration_secs(budget);
    if (secs == AGNOSAI_NO_LIMIT || secs <= 0) { return AGNOSAI_DEFAULT_CREW_TIMEOUT_SECS; }
    return secs;
}

# Whether a crew state is in a terminal state and so evictable.
fn _agnosai_orch_is_finished(state): i64 {
    var s = agnosai_crew_state_status(state);
    if (s == AGNOSAI_CREW_COMPLETED) { return 1; }
    if (s == AGNOSAI_CREW_FAILED) { return 1; }
    if (s == AGNOSAI_CREW_CANCELLED) { return 1; }
    return 0;
}

# Whether `state` is still the crew its id names in the registry. The caller holds the lock.
#
# ⚠ **By identity, not by id.** A queue slot outlives its crew: a forgotten crew leaves one
# behind, and so does a crew whose id ran again. Going by id would evict the re-run, which
# may be running, on the strength of its predecessor's slot.
fn _agnosai_orch_is_current_locked(o, state): i64 {
    if (map_get(load64(o + AGN_OR_CREWS), agnosai_crew_state_crew_id(state)) == state) {
        return 1;
    }
    return 0;
}

# Keep the ended queue in proportion to the registry. The caller holds the lock.
#
# ⚠ **Without this the queue is a leak, and in the case the API is for.** Eviction is what
# pops the queue, and a consumer that forgets every crew it reads never reaches the cap, so
# its queue would hold one stale slot per crew ever run. Past twice what the registry could
# need, the live slots slide down over the dead ones, and the slots eviction has popped go the
# same way once there are 1,024 of them. A pass frees half the queue or those 1,024 slots, so
# the cost per crew stays constant, and it allocates nothing.
fn _agnosai_orch_compact_ended_locked(o): i64 {
    var ended = load64(o + AGN_OR_ENDED);
    var head = load64(o + AGN_OR_ENDED_HEAD);
    var len = vec_len(ended);
    if (len - head <= 2 * map_size(load64(o + AGN_OR_CREWS)) + 64 && head < 1024) { return 0; }
    var kept = 0;
    for (var i = head; i < len; i = i + 1) {
        var state = vec_get(ended, i);
        if (_agnosai_orch_is_current_locked(o, state) == 1) {
            vec_set(ended, kept, state);
            kept = kept + 1;
        }
    }
    vec_truncate(ended, kept);
    store64(o + AGN_OR_ENDED_HEAD, 0);
    return kept;
}

# Queue a crew that has ended, in the order crews end. The caller holds the lock.
fn _agnosai_orch_note_ended_locked(o, state): i64 {
    vec_push(load64(o + AGN_OR_ENDED), state);
    _agnosai_orch_compact_ended_locked(o);
    return 0;
}

# Evict down to `AGNOSAI_CREWS_LOW_WATER` when the registry is at capacity, oldest ended
# first, and return how many went. The caller holds the lock.
#
# Through 2.2.3 this took **every** finished crew at once, in hash order. A consumer that
# reads by polling lost whatever it had not reached: agnostic's collector looks every 200 ms,
# and 1,300 unpolled crews at 190/s lost 885, each with its results. Now a crew keeps its
# place until 900 others have ended after it. **The order is when a crew ended and not when
# it was submitted**, since the time a reader has had is what matters: a crew that ran for an
# hour and has just ended is the newest here, however early it arrived.
#
# ⚠ **The marks are over crews that have ended, not over the registry.** Counting running crews
# gave the window away when it mattered most: with 950 running and 50 ended unread, a submit
# had to evict all 50 to reach 900. A crew a runner holds has its flag in AGN_OR_CANCEL, so the
# ended count is one subtraction. A crew that never ran counts as ended, and only the queue
# can evict, so a registry of those stops at the queue's end.
#
# Only crews no runner holds go, as the queue has nothing else in it. A cancelled crew reads
# CANCELLED while its work finishes, and is queued when it stops, so it can no longer be
# evicted and then come back as its runner stores the final state. A registry full of running
# crews still grows past the cap, as the oracle's does, and costs one comparison per submit
# rather than a walk of the map.
fn _agnosai_orch_evict_locked(o, out_ids): i64 {
    return _agnosai_orch_evict_give_locked(o, default_alloc(), out_ids, 0);
}

# `_agnosai_orch_evict_locked`, copying each id it pushes onto `out_ids` in `a`, and pushing each
# owned crew it lets go that nothing holds onto `give`, for its caller to give back once the lock is
# given back (ADR 037), or 0.
fn _agnosai_orch_evict_give_locked(o, a, out_ids, give): i64 {
    var crews = load64(o + AGN_OR_CREWS);
    var held = map_size(load64(o + AGN_OR_CANCEL));
    if (map_size(crews) - held < AGNOSAI_MAX_RETAINED_CREWS) { return 0; }
    var ended = load64(o + AGN_OR_ENDED);
    var head = load64(o + AGN_OR_ENDED_HEAD);
    var evicted = 0;
    while (head < vec_len(ended) && map_size(crews) - held > AGNOSAI_CREWS_LOW_WATER) {
        var state = vec_get(ended, head);
        head = head + 1;
        if (_agnosai_orch_is_current_locked(o, state) == 1) {
            # Its log goes with it, once the lock is given back (ADR 036): the id is copied, as
            # the crew's arena may go back first.
            if (out_ids != 0) { vec_push_a(a, out_ids, str_clone_a(a, agnosai_crew_state_crew_id(state))); }
            var er = map_get(load64(o + AGN_OR_RUNNERS), agnosai_crew_state_crew_id(state));
            if (er != 0) { _agnosai_orch_leave_locked(o, load64(er + AGN_CR_SPEC), give); }
            map_delete(load64(o + AGN_OR_RUNNERS), agnosai_crew_state_crew_id(state));
            map_delete(crews, agnosai_crew_state_crew_id(state));
            evicted = evicted + 1;
        }
    }
    store64(o + AGN_OR_ENDED_HEAD, head);
    _agnosai_orch_compact_ended_locked(o);
    return evicted;
}

# Remove the logs of crews that left the registry (ADR 036), outside its lock. A log that will not
# go is a WARN: it is read again at the next start, as a finished crew.
fn _agnosai_orch_drop_logs(o, ids): i64 {
    var store = load64(o + AGN_OR_STORE);
    if (store == 0 || ids == 0) { return 0; }
    for (var i = 0; i < vec_len(ids); i = i + 1) {
        var err = agnosai_state_store_remove(store, vec_get(ids, i));
        if (err != 0 && sakshi_get_level() >= SK_WARN) {
            var f[AGNOSAI_LOG_FIELDS_BYTES];
            var n = agnosai_log_fields_start(&f, vec_get(ids, i));
            n = agnosai_log_field_str(&f, n, "error", agnosai_error_message(err));
            sakshi_log_kv(SK_WARN, "crew log could not be removed", 29, "crew_id", 7, &f, n);
        }
    }
    return 0;
}

# Log an eviction, outside the registry lock. A consumer that polls should know its window.
fn _agnosai_orch_log_evicted(evicted): i64 {
    if (evicted == 0 || sakshi_get_level() < SK_INFO) { return 0; }
    var count[24];
    var len = fmt_int_buf(evicted, &count);
    sakshi_log_kv(SK_INFO, "crew registry evicted finished crews", 36, "count", 5, &count, len);
    return evicted;
}

# Move a registered crew from status `from` to `to`, and only from `from`.
# Returns 1 when it moved, 0 when the crew is not registered or holds any other
# status. The caller holds the lock.
#
# **Only from `from`** is what lets a cancel stand: `cancel_crew` marks the
# registered state CANCELLED in place, and a PENDING → RUNNING move that came
# after it must not overwrite that. It is the same in-place write `cancel_crew`
# makes — one aligned 8-byte store, so a reader holding the state pointer
# without the lock sees the old status or the new one, never a torn value.
fn _agnosai_orch_advance_locked(o, crew_id: Str, from, to): i64 {
    var state = map_get(load64(o + AGN_OR_CREWS), crew_id);
    if (state == 0) { return 0; }
    if (agnosai_crew_state_status(state) != from) { return 0; }
    agnosai_crew_state_with_status(state, to);
    return 1;
}

# `_agnosai_orch_advance_locked`, taking the registry lock itself.
fn _agnosai_orch_advance(o, crew_id: Str, from, to): i64 {
    var mtx = load64(o + AGN_OR_MUTEX);
    mutex_lock(mtx);
    var moved = _agnosai_orch_advance_locked(o, crew_id, from, to);
    mutex_unlock(mtx);
    return moved;
}

# Record one of the orchestrator's three audit events.
fn _agnosai_orch_audit(o, event: Str, level: Str, message: Str, metadata): i64 {
    var chain = load64(o + AGN_OR_AUDIT);
    if (chain == 0) { return 0; }
    return agnosai_audit_record(chain, event, level, message, 0, 0, metadata);
}

# The audit level for a finished crew's status.
fn _agnosai_orch_level_for(status): i64 {
    if (status == AGNOSAI_CREW_FAILED) { return str_from("error"); }
    if (status == AGNOSAI_CREW_CANCELLED) { return str_from("warn"); }
    return str_from("info");
}

# ── crews the orchestrator gives back itself (2.5.1, ADR 037) ──────────────

# An arena for a crew this orchestrator will own, from its own pool, made on first use: build the
# crew in it with `agnosai_crew_new_in` and hand it to `agnosai_orchestrator_own_crew`. One that
# goes unused goes back with `agnosai_crew_arena_give_back`.
fn agnosai_orchestrator_crew_arena(o): i64 {
    var mtx = load64(o + AGN_OR_MUTEX);
    mutex_lock(mtx);
    var pool = load64(o + AGN_OR_POOL);
    if (pool == 0) {
        pool = agnosai_crew_pool_new(AGNOSAI_CREW_ARENA_BYTES);
        store64(o + AGN_OR_POOL, pool);
    }
    mutex_unlock(mtx);
    return agnosai_crew_pool_acquire(pool);
}

# How many arenas the orchestrator's own pool has made, or 0 before its first.
fn agnosai_orchestrator_crew_arenas_minted(o): i64 {
    var pool = load64(o + AGN_OR_POOL);
    if (pool == 0) { return 0; }
    return agnosai_crew_pool_minted(pool);
}

# Give `spec`, built in an arena from `agnosai_orchestrator_crew_arena`, to the orchestrator to give
# back itself, before it is run (ADR 037). Returns a hold on it for the caller, which the caller
# lets go of with `agnosai_orchestrator_let_go` once it has read what it wants: the crew goes back
# once nothing holds it and the registry has let it go, evicted or forgotten, or was never given it.
# A spec on the global heap cannot go back: it is left as it is, and the hold is 0.
#
# ⚠ **After the last hold is let go, nothing the crew had is valid**, as after
# `agnosai_orchestrator_release_crew`, which is what gives it back: its spec, its id, its state.
# A reader of an owned crew holds it (`agnosai_orchestrator_hold_crew`) for as long as it reads,
# and copies what it keeps (`agnosai_json_copy_a`).
fn agnosai_orchestrator_own_crew(o, spec): i64 {
    if (agnosai_crew_arena(spec) == 0) { return 0; }
    store64(spec + AGN_CREW_HOLDS, 1);
    store64(spec + AGN_CREW_PLACED, _AGNOSAI_CREW_UNPLACED);
    store64(spec + AGN_CREW_OWNER, o);
    return spec;
}

# What `AGN_CREW_PLACED` says of an owned crew: not in the registry, never or since it was forgotten;
# in it; or let go by eviction, which took its one entry off the head of the ended queue.
var _AGNOSAI_CREW_UNPLACED = 0;
var _AGNOSAI_CREW_IN_PLACE = 1;
var _AGNOSAI_CREW_EVICTED = 2;

# The registry lets `spec` go by eviction: when the orchestrator owns it, it is no longer placed, and
# with nothing holding it, it goes onto `give` to be given back once the lock is given back. The
# caller holds the lock.
fn _agnosai_orch_leave_locked(o, spec, give): i64 {
    if (spec == 0 || load64(spec + AGN_CREW_OWNER) != o) { return 0; }
    store64(spec + AGN_CREW_PLACED, _AGNOSAI_CREW_EVICTED);
    if (load64(spec + AGN_CREW_HOLDS) == 0 && give != 0) { vec_push(give, spec); }
    return 0;
}

# Give back every crew on `give`, outside the registry lock.
fn _agnosai_orch_give_back(o, give): i64 {
    if (give == 0) { return 0; }
    for (var i = 0; i < vec_len(give); i = i + 1) { _agnosai_orch_give_back_one(o, vec_get(give, i)); }
    return 0;
}

# Give back one owned crew. ⚠ **One eviction let go is not looked for in the ended queue**: eviction
# took its entry off the queue's head, and an owned crew runs once, so it has no other, and the
# release's walk of the queue, an arena check an entry, would find nothing. Through the first cut of
# 2.5.1 every give-back walked it, which cost a post 40 µs at a full registry
# (`route_create_crew_*`). A crew forgotten, or never registered, is looked for as any is.
fn _agnosai_orch_give_back_one(o, spec): i64 {
    var purge = 1;
    if (load64(spec + AGN_CREW_PLACED) == _AGNOSAI_CREW_EVICTED) { purge = 0; }
    return _agnosai_orch_release(o, spec, purge);
}

# Read crew `crew_id` with a hold on it (ADR 037). Returns its registered state, or 0 for a crew
# the registry does not hold, and stores through `out_hold` what `agnosai_orchestrator_let_go` takes:
# the crew when the orchestrator owns it, held, else 0. A held crew is not given back until let go,
# though the registry let it go meanwhile. A crew the orchestrator does not own is not held: its
# consumer gives it back, and says when (ADR 028).
fn agnosai_orchestrator_hold_crew(o, crew_id: Str, out_hold): i64 {
    store64(out_hold, 0);
    var mtx = load64(o + AGN_OR_MUTEX);
    mutex_lock(mtx);
    var state = map_get(load64(o + AGN_OR_CREWS), crew_id);
    if (state != 0) {
        var runner = map_get(load64(o + AGN_OR_RUNNERS), crew_id);
        if (runner != 0) {
            var spec = load64(runner + AGN_CR_SPEC);
            if (load64(spec + AGN_CREW_OWNER) == o) {
                store64(spec + AGN_CREW_HOLDS, load64(spec + AGN_CREW_HOLDS) + 1);
                store64(out_hold, spec);
            }
        }
    }
    mutex_unlock(mtx);
    return state;
}

# Let go of a hold from `agnosai_orchestrator_hold_crew` or `agnosai_orchestrator_own_crew`, 0 for
# none. The last hold on a crew the registry has let go gives it back.
fn agnosai_orchestrator_let_go(o, hold): i64 {
    if (hold == 0) { return 0; }
    var mtx = load64(o + AGN_OR_MUTEX);
    mutex_lock(mtx);
    var n = load64(hold + AGN_CREW_HOLDS) - 1;
    store64(hold + AGN_CREW_HOLDS, n);
    var give = 0;
    if (n == 0 && load64(hold + AGN_CREW_PLACED) != _AGNOSAI_CREW_IN_PLACE) { give = 1; }
    mutex_unlock(mtx);
    if (give == 1) { _agnosai_orch_give_back_one(o, hold); }
    return 0;
}

# Give a registered crew its log (ADR 036), when the orchestrator has a store: a new one, whose
# spec goes down first, or for a resume the one it had, appended to. A spec that will not go down
# leaves the crew with no log, with an ERROR: it runs as a crew with none would, and a restart
# loses it, as one always did.
fn _agnosai_orch_attach_log(o, runner, spec, rp): i64 {
    var store = load64(o + AGN_OR_STORE);
    if (store == 0) { return 0; }
    var a = agnosai_crew_alloc(spec);
    var log = 0;
    if (rp != 0) {
        log = agnosai_crew_log_reopen_a(a, store, agnosai_crew_id(spec), agnosai_crew_replay_run(rp) + 1);
    } else {
        var err: i64[1];
        log = agnosai_crew_log_open_a(a, store, spec, &err);
        if (log == 0 && sakshi_get_level() >= SK_ERROR) {
            var f[AGNOSAI_LOG_FIELDS_BYTES];
            var n = agnosai_log_fields_start(&f, agnosai_crew_id(spec));
            n = agnosai_log_field_str(&f, n, "error", agnosai_error_message(load64(&err)));
            sakshi_log_kv(SK_ERROR, "crew log could not be opened; the crew runs without one", 55, "crew_id", 7,
              &f, n);
        }
    }
    agnosai_crew_runner_with_log(runner, log);
    agnosai_crew_runner_with_replay(runner, rp);
    return 0;
}

# Write the end of a crew whose run never started into its log (ADR 036), so a restart does not
# resume it: cancelled while it waited for its turn, or with no thread to run on.
fn _agnosai_orch_close_log(runner, state): i64 {
    var log = agnosai_crew_runner_log(runner);
    if (log == 0 || state == 0) { return 0; }
    return agnosai_crew_log_close(log, state);
}

# Accept a crew spec, run it, and return its final state.
#
# Order matters and is the oracle's: audit `crew_accepted` **before** the crew
# is registered and long before it runs, so a crash mid-run still leaves the
# acceptance in the trail; register as `Pending`; mark it `Running` as it is
# handed to the runner (ADR 022 — the oracle never stores `Running`); run; audit
# `crew_finished`; store the final state; then clean up the cancel token and the
# event channel.
#
# The event channel is removed at the end, which is what stops a long-lived
# orchestrator accumulating one channel per crew ever run.
# Register a crew and build its runner, without executing it.
#
# **The half `run_crew` and `submit_crew` share.** Split out in the async bite
# so the two entry points cannot drift: the registration order here is
# load-bearing — the crew is in the map as PENDING and its cancel flag is
# published **before** any execution starts, which is what lets `get_crew` and
# `cancel_crew` reach a run that has not finished. That was already true of the
# blocking path; async only makes it observable.
#
# Returns the runner, fully wired (audit, llm, events).
fn _agnosai_orch_register(o, spec): i64 {
    return _agnosai_orch_register_under(o, spec, 0);
}

# `_agnosai_orch_register`, with the crew's spending counted against `parent`, its tenant's
# tracker or 0 (ADR 033).
fn _agnosai_orch_register_under(o, spec, parent): i64 {
    return _agnosai_orch_register_with(o, spec, parent, 0);
}

# `_agnosai_orch_register_under` for a crew `rp` resumes (ADR 036), what its log said, or 0 for a
# first run.
fn _agnosai_orch_register_with(o, spec, parent, rp): i64 {
    var crew_id = agnosai_crew_id(spec);
    var crew_name = agnosai_crew_name(spec);
    var tasks = agnosai_crew_tasks(spec);
    var a = agnosai_crew_alloc(spec);
    atomic_fetch_add(spec + AGN_CREW_RUNS, 1);

    # ⚠ **Built only for a chain, on the global heap, owning its strings.** The entry keeps
    # this for as long as the chain keeps it, which outlives a crew in an arena.
    if (load64(o + AGN_OR_AUDIT) != 0) {
        var accepted = bayan_json_v_obj_new();
        bayan_json_v_obj_set(accepted, str_from("crew_id"),
          bayan_json_v_str_new(str_clone(crew_id)));
        bayan_json_v_obj_set(accepted, str_from("task_count"),
          bayan_json_v_int_new(vec_len(tasks)));
        _agnosai_orch_audit(o, str_from("crew_accepted"), str_from("info"), crew_name, accepted);
    }

    var runner = agnosai_crew_runner_new(spec);
    agnosai_crew_runner_with_budget(runner, _agnosai_orch_crew_budget_a(o, a, spec, parent));
    agnosai_crew_runner_with_audit(runner, load64(o + AGN_OR_AUDIT));
    agnosai_crew_runner_with_tools(runner, load64(o + AGN_OR_TOOLS),
      load64(o + AGN_OR_TOOL_JOURNAL));
    agnosai_crew_runner_with_approval(runner, load64(o + AGN_OR_GATE),
      load64(o + AGN_OR_APPROVE_MEDIUM));

    # The state and the cancel flag, published together. ⚠ A flag says a runner holds this
    # crew, and `cancel_crew` and `forget_crew` both go by it, so there can be no moment with
    # the state and no flag: a cancel there was lost, and queued a live crew as ended.
    _agnosai_orch_attach_log(o, runner, spec, rp);

    # Both lists in the new crew's allocator: the ids of the crews eviction lets go, whose logs go,
    # and the owned crews among them nothing holds, which go back (ADR 037). Logs first, as a crew
    # given back takes its id with it.
    var dropped = 0;
    if (load64(o + AGN_OR_STORE) != 0) { dropped = vec_new_a(a); }
    var give = 0;
    if (load64(o + AGN_OR_POOL) != 0) { give = vec_new_a(a); }
    var mtx = load64(o + AGN_OR_MUTEX);
    mutex_lock(mtx);
    var evicted = _agnosai_orch_evict_give_locked(o, a, dropped, give);
    # An owned crew is placed from here until the registry lets it go (ADR 037).
    if (load64(spec + AGN_CREW_OWNER) == o) { store64(spec + AGN_CREW_PLACED, _AGNOSAI_CREW_IN_PLACE); }
    var registered = agnosai_crew_state_new_a(a, crew_id, AGNOSAI_CREW_PENDING);
    # The runner moves this state's status while a task awaits a reviewer (ADR 032).
    _agnosai_crew_runner_with_state(runner, registered);
    map_set(load64(o + AGN_OR_CREWS), str_clone_a(a, crew_id), registered);
    map_set(load64(o + AGN_OR_CANCEL), str_clone_a(a, crew_id),
      agnosai_crew_runner_cancel_flag(runner));
    map_set(load64(o + AGN_OR_RUNNERS), str_clone_a(a, crew_id), runner);
    mutex_unlock(mtx);
    _agnosai_orch_log_evicted(evicted);
    _agnosai_orch_drop_logs(o, dropped);
    _agnosai_orch_give_back(o, give);

    var rurl = load64(o + AGN_OR_LLM_URL);
    if (rurl != 0) {
        agnosai_crew_runner_with_llm(runner,
          agnosai_hoosh_client_new_a(a, rurl, load64(o + AGN_OR_LLM_KEY)));
    }

    var rbus = load64(o + AGN_OR_EVENTS);
    if (rbus != 0) {
        agnosai_crew_runner_with_events(runner, agnosai_event_bus_sender_a(a, rbus, crew_id));
    }
    return runner;
}

# Whether this orchestrator takes `spec` (ADR 033): returns 0, with what its spending counts
# against through `out_parent` (its tenant's tracker, or 0), or the error that refuses it.
#
# A crew of more tasks than the orchestrator runs is refused; then, for one naming a tenant on an
# orchestrator with a registry, a tenant it does not hold, one that has spent its tokens or its
# cost, and one with `max_concurrent_crews` admitted already. The count and the check share the
# lock, so two crews cannot both take a tenant's last place. An admitted tenant crew is counted
# until `_agnosai_orch_tenant_done`.
#
# ⚠ **Spent means reached, as a crew's budget does**: a tenant at exactly its limit is refused. The
# oracle's `check_tenant_budget` passes at the limit, and admitting a crew there would only start
# one whose first call is refused.
fn _agnosai_orch_admit(o, spec, out_parent): i64 {
    store64(out_parent, 0);
    var max_tasks = load64(o + AGN_OR_MAX_TASKS);
    var n = vec_len(agnosai_crew_tasks(spec));
    if (max_tasks != AGNOSAI_NO_LIMIT && n > max_tasks) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "crew has ");
        str_builder_add_int(sb, n);
        str_builder_add_cstr(sb, " tasks, and this orchestrator runs at most ");
        str_builder_add_int(sb, max_tasks);
        return agnosai_error_scheduling(str_builder_build(sb));
    }
    var tenant = agnosai_crew_tenant(spec);
    var reg = load64(o + AGN_OR_TENANTS);
    if (tenant == 0 || reg == 0) { return 0; }
    var budget = agnosai_tenant_registry_get_budget(reg, tenant);
    if (budget == 0) {
        return agnosai_error_scheduling(str_cat(str_cat(str_from("tenant "), tenant),
            str_from(" is not registered")));
    }

    var mtx = load64(o + AGN_OR_MUTEX);
    mutex_lock(mtx);
    var uses = load64(o + AGN_OR_TENANT_USE);
    var tu = map_get(uses, tenant);
    if (tu == 0) {
        tu = alloc(AGN_TU_SIZE);
        store64(tu + AGN_TU_TRACKER, agnosai_budget_tracker_limits_a(default_alloc(),
            agnosai_tenant_budget_max_tokens(budget), agnosai_tenant_budget_max_cost_micro_usd(budget), 0,
            "tenant"));
        store64(tu + AGN_TU_ACTIVE, 0);
        map_set(uses, str_clone(tenant), tu);
    } else {
        # A tenant registered again has its new limits, and keeps what it spent.
        agnosai_budget_tracker_set_limits(load64(tu + AGN_TU_TRACKER), agnosai_tenant_budget_max_tokens(budget),
          agnosai_tenant_budget_max_cost_micro_usd(budget));
    }
    var tracker = load64(tu + AGN_TU_TRACKER);
    var kind = agnosai_budget_tracker_breach(tracker, 0);
    if (kind != AGNOSAI_BUDGET_WITHIN) {
        mutex_unlock(mtx);
        return agnosai_error_scheduling(agnosai_budget_exceeded_message(tracker, kind));
    }
    var most = agnosai_tenant_budget_max_concurrent_crews(budget);
    if (most != AGNOSAI_NO_LIMIT && load64(tu + AGN_TU_ACTIVE) >= most) {
        mutex_unlock(mtx);
        var cb = str_builder_new();
        str_builder_add_cstr(cb, "tenant ");
        str_builder_add(cb, tenant);
        str_builder_add_cstr(cb, " has ");
        str_builder_add_int(cb, most);
        str_builder_add_cstr(cb, " crews running, its most at once");
        return agnosai_error_scheduling(str_builder_build(cb));
    }
    store64(tu + AGN_TU_ACTIVE, load64(tu + AGN_TU_ACTIVE) + 1);
    mutex_unlock(mtx);
    store64(out_parent, tracker);
    return 0;
}

# Note that a crew `_agnosai_orch_admit` counted against its tenant has ended, on every way out.
fn _agnosai_orch_tenant_done(o, spec): i64 {
    var tenant = agnosai_crew_tenant(spec);
    if (tenant == 0 || load64(o + AGN_OR_TENANTS) == 0) { return 0; }
    var mtx = load64(o + AGN_OR_MUTEX);
    mutex_lock(mtx);
    var tu = map_get(load64(o + AGN_OR_TENANT_USE), tenant);
    if (tu != 0 && load64(tu + AGN_TU_ACTIVE) > 0) {
        store64(tu + AGN_TU_ACTIVE, load64(tu + AGN_TU_ACTIVE) - 1);
    }
    mutex_unlock(mtx);
    return 0;
}

# Log and audit a crew the orchestrator refused, and why: it never registers, so this is the only
# trace it leaves. On the global heap, owning its strings, as an audit entry outlives a crew.
fn _agnosai_orch_refused(o, spec, err): i64 {
    var why = agnosai_error_message(err);
    if (sakshi_get_level() >= SK_WARN) {
        sakshi_log_kv(SK_WARN, "crew refused", 12, "reason", 6, str_data(why), str_len(why));
    }
    if (load64(o + AGN_OR_AUDIT) != 0) {
        var md = bayan_json_v_obj_new();
        bayan_json_v_obj_set(md, str_from("crew_id"), bayan_json_v_str_new(str_clone(agnosai_crew_id(spec))));
        bayan_json_v_obj_set(md, str_from("reason"), bayan_json_v_str_new(str_clone(why)));
        var tenant = agnosai_crew_tenant(spec);
        if (tenant != 0) { bayan_json_v_obj_set(md, str_from("tenant"), bayan_json_v_str_new(str_clone(tenant))); }
        _agnosai_orch_audit(o, str_from("crew_refused"), str_from("warn"), str_clone(agnosai_crew_name(spec)), md);
    }
    return 0;
}

# The tighter of two limits, either of which may be `AGNOSAI_NO_LIMIT`.
fn _agnosai_tighter_limit(x, y): i64 {
    if (x == AGNOSAI_NO_LIMIT) { return y; }
    if (y == AGNOSAI_NO_LIMIT) { return x; }
    if (x < y) { return x; }
    return y;
}

# The crew's budget tracker (ADR 033), in its allocator `a`: the tighter of what the orchestrator's
# budget gives every crew and what the spec asks for, of tokens and of cost, under `parent` (a
# tenant's, or 0). 0 when there is nothing to hold it to or count it against, which costs a crew
# that has no budget nothing.
#
# The orchestrator's `max_tokens` and `max_cost_usd` are **per crew**, as the oracle's
# `BudgetTracker::new(&ResourceBudget)` read them for one running crew. Through 2.4.0 nothing did.
fn _agnosai_orch_crew_budget_a(o, a, spec, parent): i64 {
    var b = load64(o + AGN_OR_BUDGET);
    var tokens = AGNOSAI_NO_LIMIT;
    var cost = AGNOSAI_NO_LIMIT;
    if (b != 0) {
        tokens = agnosai_resource_budget_max_tokens(b);
        cost = agnosai_resource_budget_max_cost_micro_usd(b);
    }
    tokens = _agnosai_tighter_limit(tokens, agnosai_crew_max_tokens(spec));
    cost = _agnosai_tighter_limit(cost, agnosai_crew_max_cost_micro_usd(spec));
    if (tokens == AGNOSAI_NO_LIMIT && cost == AGNOSAI_NO_LIMIT && parent == 0) { return 0; }
    return agnosai_budget_tracker_limits_a(a, tokens, cost, parent, "crew");
}

# Run a crew to completion and return its final state, or 0 if it never ran.
#
# `Orchestrator::run_crew` — `rust-old/src/orchestrator/orchestrator.rs:126`.
# **Blocking, and deliberately still blocking**: the oracle's `create_crew`
# awaits this inline (`crews.rs:151`), so `POST /api/v1/crews` returns only when
# the crew has finished and the id it hands back names a completed run. That is
# the wire contract, and `agnosai_orchestrator_submit_crew` below exists rather
# than changing it.
#
# The body is two shared halves so the blocking and async paths cannot drift —
# see `_agnosai_orch_register` above and `_agnosai_orch_finish` below.
fn agnosai_orchestrator_run_crew(o, spec): i64 {
    return agnosai_orchestrator_run_crew_err(o, spec, 0);
}

# `agnosai_orchestrator_run_crew`, reporting WHY it failed.
#
# ⚠ **The reason existed and was thrown away.** `_agnosai_orch_finish` already
# builds a `run_err` for `agnosai_crew_runner_run` — a cyclic DAG is the arm the
# oracle's `?` propagates — and then returned a bare 0, so every caller could say
# only "it failed". `routes/a2a.cyr` sends that reason to the delegating system
# on the wire (`a2a.rs:182` is `error: Some(e.to_string())`), which is the whole
# point of an A2A error field.
#
# `out_err` of 0 means "don't care", which is what the bare form passes.
#
# **A crew the orchestrator refuses never registers (ADR 033)**: too many tasks, or a tenant it
# does not hold, has spent, or has at its limit of crews. This returns 0, with the reason.
fn agnosai_orchestrator_run_crew_err(o, spec, out_err): i64 {
    var parent: i64[1];
    var refused = _agnosai_orch_admit(o, spec, &parent);
    if (refused != 0) {
        _agnosai_orch_refused(o, spec, refused);
        if (out_err != 0) { store64(out_err, refused); }
        return 0;
    }
    return _agnosai_orch_finish_err(o, _agnosai_orch_register_under(o, spec, load64(&parent)),
      agnosai_crew_id(spec), agnosai_crew_name(spec), out_err);
}

# Run a registered crew to completion and store its outcome.
#
# **The other half `run_crew` and `submit_crew` share**, so the blocking and
# async paths cannot diverge in how a finished crew is audited, stored, or
# unregistered. Called inline by the first and on a thread by the second; it
# touches nothing that is not already thread-safe (see the note above
# `agnosai_orchestrator_submit_crew`).
# The state a timed-out crew reports, and the warning that goes with it.
#
# Split out of `_agnosai_orch_finish` so a suite can reach it: the orchestrator's
# own timeout needs a budget of at least one second (`agnosai_orchestrator_timeout_secs`
# treats <= 0 as unset), and a trivial crew finishes in microseconds — so the
# substitution is unreachable end to end without a one-second sleep. Same reason
# the three seams in `docs/development/state.md` exist; nothing is injected in
# production.
#
# ⚠ The oracle's `warn!` carries TWO fields (`crew_id`, `timeout_secs`), and
# `sakshi_log_kv` carries exactly ONE pair, flattening it into the message before
# the emit hook. `crew_id` is the pair — it is the correlation key an operator
# greps — and the timeout is folded into the message text, so no information is
# dropped even though the shape differs.
fn _agnosai_orch_timeout_state(crew_id: Str, timeout_secs): i64 {
    return _agnosai_orch_timeout_state_a(default_alloc(), crew_id, timeout_secs);
}

# `_agnosai_orch_timeout_state`, in allocator `a`.
fn _agnosai_orch_timeout_state_a(a, crew_id: Str, timeout_secs): i64 {
    # Level-gated so the message is not built when nothing will emit it — the
    # same shape as `_agnosai_rl_warn` in `src/server/rate_limit.cyr`.
    if (sakshi_get_level() >= SK_WARN) {
        var msg = str_builder_new_a(a);
        str_builder_add_cstr_a(a, msg, "crew execution timed out after ");
        str_builder_add_int_a(a, msg, timeout_secs);
        str_builder_add_cstr_a(a, msg, "s");
        var m = str_builder_build_a(a, msg);
        sakshi_log_kv(SK_WARN, str_data(m), str_len(m),
          "crew_id", 7, str_data(crew_id), str_len(crew_id));
    }
    return agnosai_crew_state_with_reason(agnosai_crew_state_new_a(a, crew_id, AGNOSAI_CREW_FAILED),
      AGNOSAI_CREW_REASON_TIMEOUT);
}

# Audit `crew_finished` for `state`, when a chain is attached. Built on the global heap, owning its
# strings, as the entry outlives a crew in an arena (see `_agnosai_orch_register`).
fn _agnosai_orch_audit_finished(o, crew_id: Str, crew_name: Str, state): i64 {
    if (load64(o + AGN_OR_AUDIT) == 0) { return 0; }
    var status = agnosai_crew_state_status(state);
    var profile = agnosai_crew_state_profile(state);
    var wall_ms = 0;
    var cost = 0;
    if (profile != 0) {
        wall_ms = agnosai_crew_profile_wall_ms(profile);
        cost = agnosai_crew_profile_cost_micro_usd(profile);
    }
    var finished = bayan_json_v_obj_new();
    bayan_json_v_obj_set(finished, str_from("crew_id"), bayan_json_v_str_new(str_clone(crew_id)));
    bayan_json_v_obj_set(finished, str_from("status"),
      bayan_json_v_str_new(agnosai_crew_status_to_wire(status)));
    var reason = agnosai_crew_state_reason(state);
    if (reason != 0) { bayan_json_v_obj_set(finished, str_from("reason"), bayan_json_v_str_new(reason)); }
    bayan_json_v_obj_set(finished, str_from("task_count"),
      bayan_json_v_int_new(vec_len(agnosai_crew_state_results(state))));
    bayan_json_v_obj_set(finished, str_from("wall_ms"), bayan_json_v_int_new(wall_ms));
    bayan_json_v_obj_set(finished, str_from("cost_micro_usd"), bayan_json_v_int_new(cost));
    return _agnosai_orch_audit(o, str_from("crew_finished"), _agnosai_orch_level_for(status),
      crew_name, finished);
}

fn _agnosai_orch_finish(o, runner, crew_id: Str, crew_name: Str): i64 {
    return _agnosai_orch_finish_err(o, runner, crew_id, crew_name, 0);
}

fn _agnosai_orch_finish_err(o, runner, crew_id: Str, crew_name: Str, out_err): i64 {
    var mtx = load64(o + AGN_OR_MUTEX);
    var bus = load64(o + AGN_OR_EVENTS);
    var a = load64(runner + AGN_CR_ALLOC);
    var spec = load64(runner + AGN_CR_SPEC);

    # ⚠ **A turn first (ADR 033).** At most `max_concurrent_tasks` crews run at once, as the
    # oracle's semaphore allowed (`orchestrator.rs:129`); through 2.4.0 every crew ran at once. A
    # crew waits here, PENDING, behind those that came before it, and its deadline starts when it
    # runs, as the oracle's timeout wrapped only the run. A cancel ends the wait, and a permit that
    # arrived with it goes back.
    var sem = load64(o + AGN_OR_CREW_SEM);
    var flag = agnosai_crew_runner_cancel_flag(runner);
    var turn = agnosai_semaphore_acquire_until(sem, 0, flag);
    if (turn == 1 && atomic_load(flag) != 0) {
        agnosai_semaphore_release(sem);
        turn = 0;
    }
    if (turn == 0) { return _agnosai_orch_end_queued(o, runner, crew_id, crew_name, spec); }

    # Enforce the execution timeout from the budget, matching
    # `rust-old/src/orchestrator/orchestrator.rs:197-214`.
    #
    # ⚠ **This was computed and never applied.** `agnosai_orchestrator_timeout_secs`
    # existed with ZERO call sites in `src/` — its only mention was a comment in
    # `main.cyr` — so a wedged crew held one of the 100 pool workers forever, with
    # no `Failed` state, no sakshi event and no audit record. `POST /api/v1/crews`
    # runs the crew inline, so that worker never came back. Fixed 2026-08-12.
    var timeout_secs = agnosai_orchestrator_timeout_secs(o);
    agnosai_crew_runner_set_deadline_ns(runner,
      clock_now_ns() + timeout_secs * AGNOSAI_NS_PER_SEC);

    # ADR 022 — the registry says RUNNING while the crew runs. The oracle stores
    # `Pending` at registration and the terminal state at the end, and never
    # `Running` in between (`orchestrator.rs:168-176`, `:254` as of tag 2.1.4),
    # so a poller could not tell a queued crew from a working one. It moves only
    # from PENDING: a cancel that landed first stands.
    _agnosai_orch_advance(o, crew_id, AGNOSAI_CREW_PENDING, AGNOSAI_CREW_RUNNING);

    var run_err: i64[1];
    store64(&run_err, 0);
    var state = agnosai_crew_runner_run(runner, &run_err);

    # On expiry the oracle DISCARDS partial results and reports a bare `Failed`
    # — `CrewState { status: Failed, results: vec![], profile: None }`. Matched
    # exactly: a caller must not read a timed-out crew's partial output as if the
    # crew had finished.
    #
    # Since ADR 022 the runner already returns that state, and its
    # `crew_completed` already said `failed`, so this replaces it with an equal
    # one. It stays for the warning `_agnosai_orch_timeout_state` logs, and so a
    # runner that did not build the state could not leak partial results here.
    if (state != 0 && agnosai_crew_runner_timed_out(runner) == 1) {
        state = _agnosai_orch_timeout_state_a(a, crew_id, timeout_secs);
    }

    # A crew that could not run: its tasks form a cycle, or depend on one the spec does not hold, or
    # its manager names no agent of its own (ADR 035).
    # The caller of `run_crew_err` still gets 0 and the error, as no crew ran (ADR 032).
    #
    # ⚠ **It ends FAILED, with its reason, and its channel closes** (ADR 032). Through 2.3.8 this
    # arm put PENDING back (ADR 022, decision 6) and stored nothing, so a submitted crew read
    # `pending` for good and a subscriber waited on it for good. A cancel that landed first stands,
    # as a terminal state never changes.
    var never_ran = 0;
    if (state == 0) {
        if (out_err != 0) { store64(out_err, load64(&run_err)); }
        never_ran = 1;
        state = agnosai_crew_state_with_reason(agnosai_crew_state_new_a(a, crew_id, AGNOSAI_CREW_FAILED),
          agnosai_crew_unrunnable_reason(load64(&run_err)));
        mutex_lock(mtx);
        var held = map_get(load64(o + AGN_OR_CREWS), crew_id);
        if (held != 0) {
            if (agnosai_crew_state_status(held) == AGNOSAI_CREW_CANCELLED) { state = held; }
        }
        mutex_unlock(mtx);
    }

    _agnosai_orch_audit_finished(o, crew_id, crew_name, state);

    mutex_lock(mtx);
    map_set(load64(o + AGN_OR_CREWS), str_clone_a(a, crew_id), state);
    map_delete(load64(o + AGN_OR_CANCEL), crew_id);
    _agnosai_orch_note_ended_locked(o, state);
    mutex_unlock(mtx);

    if (bus != 0) { agnosai_event_bus_remove(bus, crew_id); }
    # Its turn goes to the next crew once its final state is stored, so that crew starts after
    # this one reads as ended.
    agnosai_semaphore_release(sem);
    _agnosai_orch_tenant_done(o, spec);
    if (never_ran == 1) {
        atomic_fetch_add(spec + AGN_CREW_RUNS, 0 - 1);
        return 0;
    }
    # ⚠ **The run's last touch of the crew**, on either exit. Once this lands a release may
    # scrub the spec, its id and its runner, and the caller has only pointers left to return.
    atomic_fetch_add(spec + AGN_CREW_RUNS, 0 - 1);
    return state;
}

# End a crew that was cancelled while it waited for a turn, and return its state.
#
# It never ran, so it has no events, and its channel closes (ADR 032's `pending` → `cancelled`).
# `cancel_crew` stored CANCELLED with the flag; a flag raised on the runner alone left PENDING,
# which ends CANCELLED here. Queued as ended and audited, as a finish would have.
fn _agnosai_orch_end_queued(o, runner, crew_id: Str, crew_name: Str, spec): i64 {
    var mtx = load64(o + AGN_OR_MUTEX);
    mutex_lock(mtx);
    map_delete(load64(o + AGN_OR_CANCEL), crew_id);
    var state = map_get(load64(o + AGN_OR_CREWS), crew_id);
    if (state != 0) {
        if (agnosai_crew_state_status(state) == AGNOSAI_CREW_PENDING) {
            agnosai_crew_state_with_reason(state, AGNOSAI_CREW_REASON_CANCELLED);
            atomic_fence();
            agnosai_crew_state_with_status(state, AGNOSAI_CREW_CANCELLED);
        }
        _agnosai_orch_note_ended_locked(o, state);
    }
    mutex_unlock(mtx);
    if (state != 0) { _agnosai_orch_audit_finished(o, crew_id, crew_name, state); }
    _agnosai_orch_close_log(runner, state);
    var bus = load64(o + AGN_OR_EVENTS);
    if (bus != 0) { agnosai_event_bus_remove(bus, crew_id); }
    _agnosai_orch_tenant_done(o, spec);
    atomic_fetch_add(spec + AGN_CREW_RUNS, 0 - 1);
    return state;
}

# --- Async submission -----------------------------------------------------
#
# **Beyond the oracle.** `create_crew` awaits `run_crew` inline
# (`crews.rs:151`, `orchestrator.rs:126`), so the oracle has no async crew
# lifecycle at all and `POST /api/v1/crews` keeps that exact blocking shape —
# `agnosai_orchestrator_run_crew` above is untouched. This is the submit half
# the `delegate` tool needs: a model driving subagents cannot hold a tool call
# open for a crew that may run for minutes.
#
# **It adds no new concurrency class.** Crews already run concurrently — server
# handlers execute on pool workers, so two simultaneous `POST /api/v1/crews`
# already run two crews — and the runner itself already spawns one OS thread
# per task (`crew_runner.cyr:851`). Every subsystem the run touches was audited
# for it: metrics counters are `atomic_fetch_add` with the singleton pre-built
# at `serve.cyr:478`, the audit chain locks inside `agnosai_audit_record`, the
# event bus locks its whole fan-out and is lossy so it never blocks, and the
# crew map locks on every access.

# The payload handed to a submitted crew's thread.
enum AgnosaiOrchJobOff {
    AGN_OJ_ORCH = 0;
    AGN_OJ_RUNNER = 8;
    AGN_OJ_CREW_ID = 16;
    AGN_OJ_NAME = 24;
    AGN_OJ_SIZE = 32;
}

# The thread body: run the registered crew and store its outcome.
#
# `thread_create` passes exactly one argument, so the four values travel as a
# heap struct — the same device `crew_runner.cyr:632` uses for its task workers.
fn _agnosai_orch_submit_thread(job): i64 {
    var o = load64(job + AGN_OJ_ORCH);
    var runner = load64(job + AGN_OJ_RUNNER);
    var crew_id = load64(job + AGN_OJ_CREW_ID);
    var crew_name = load64(job + AGN_OJ_NAME);
    _agnosai_orch_finish(o, runner, crew_id, crew_name);
    return 0;
}

# Let go of a registered crew no runner will take: its flag and its event channel go, as a
# finish would have taken them. Without this a flag says a runner holds it for good, so it could
# not be forgotten, nothing would queue it, and a subscriber would wait on it forever.
fn _agnosai_orch_abandon(o, runner, crew_id: Str): i64 {
    var mtx = load64(o + AGN_OR_MUTEX);
    mutex_lock(mtx);
    map_delete(load64(o + AGN_OR_CANCEL), crew_id);
    # ⚠ **It ends FAILED, `not_started`** (ADR 032): it was left PENDING through 2.3.8, a state
    # nothing would ever move. Only from PENDING, so a cancel that landed first stands. It is
    # queued as ended, so eviction can take it.
    var state = map_get(load64(o + AGN_OR_CREWS), crew_id);
    if (state != 0) {
        if (agnosai_crew_state_status(state) == AGNOSAI_CREW_PENDING) {
            agnosai_crew_state_with_reason(state, AGNOSAI_CREW_REASON_NOT_STARTED);
            atomic_fence();
            agnosai_crew_state_with_status(state, AGNOSAI_CREW_FAILED);
        }
        # A cancel that landed first left the queueing to a finish there will not be.
        if (_agnosai_orch_is_finished(state) == 1) { _agnosai_orch_note_ended_locked(o, state); }
    }
    mutex_unlock(mtx);
    _agnosai_orch_close_log(runner, state);
    var bus = load64(o + AGN_OR_EVENTS);
    if (bus != 0) { agnosai_event_bus_remove(bus, crew_id); }
    return 0;
}

# Submit a crew for asynchronous execution. Returns its id immediately.
#
# The id is usable at once: `_agnosai_orch_register` has already put the crew in
# the map as PENDING and published its cancel flag, so `GET /api/v1/crews/{id}`
# answers and `cancel_crew` reaches it while it runs. A poller sees `pending`,
# then `running` once the thread hands the crew to its runner (ADR 022), then
# the terminal status. All are existing wire values (`agnosai_crew_status_to_wire`),
# so a polling client sees no new spelling.
#
# **Returns 0 if the thread cannot be created**, and the crew ends FAILED with
# reason `not_started`, rather than reporting a run that never started (ADR 032; it
# was left PENDING through 2.3.8). Nothing holds it then (`_agnosai_orch_abandon`),
# so a consumer can forget it.
#
# ✅ **The thread is detached, and it leaks nothing.** This used to call
# `thread_create` and never join, stranding 2 MiB of stack and 4 KiB of TLS per
# submitted crew — a consumer-side reaper would have bounded it but could not
# close it, because a thread cannot free the stack it is running on. Filed
# upstream as
# `2026-08-05-no-thread-detach-so-a-fire-and-forget-thread-leaks-its-2-mib-stack.md`
# and **shipped in cyrius 6.5.8**: `thread_create_detached` has the child unmap
# its own stack in the trampoline tail, carves the TLS from the top of that same
# mapping so one `munmap` frees both, and allocates no handle at all. Upstream
# measured 100 unjoined threads at 210,124,800 B of VA before and **0** after.
#
# **6.5.8 is therefore the floor for this function** — against 6.5.7 or earlier
# `thread_create_detached` does not exist and the module will not compile, which
# is the right failure mode for a change whose silent one is an unbounded leak.
#
# **Do not "improve" this to `thread_create` + a later `thread_join`.** The
# handle a joiner needs is exactly what the detached path declines to allocate,
# and the crew's result reaches the caller through the registry rather than
# through the thread's return value — there is nothing to join *for*.
fn agnosai_orchestrator_submit_crew(o, spec): i64 {
    return agnosai_orchestrator_submit_crew_err(o, spec, 0);
}

# `agnosai_orchestrator_submit_crew`, saying why when it returns 0: a crew the orchestrator refuses
# (ADR 033, as `agnosai_orchestrator_run_crew_err` says), which never registers, or a thread that
# would not start. `out_err` of 0 means don't care.
fn agnosai_orchestrator_submit_crew_err(o, spec, out_err): i64 {
    if (out_err != 0) { store64(out_err, 0); }
    var parent: i64[1];
    var refused = _agnosai_orch_admit(o, spec, &parent);
    if (refused != 0) {
        _agnosai_orch_refused(o, spec, refused);
        if (out_err != 0) { store64(out_err, refused); }
        return 0;
    }
    return _agnosai_orch_launch(o, spec, _agnosai_orch_register_under(o, spec, load64(&parent)), out_err);
}

# Run a registered crew on a thread of its own. Returns its id, or 0 with the error through
# `out_err` when no thread would start, and the crew then ends FAILED, `not_started`.
fn _agnosai_orch_launch(o, spec, runner, out_err): i64 {
    var crew_id = agnosai_crew_id(spec);
    var job = alloc_via(agnosai_crew_alloc(spec), AGN_OJ_SIZE);
    store64(job + AGN_OJ_ORCH, o);
    store64(job + AGN_OJ_RUNNER, runner);
    store64(job + AGN_OJ_CREW_ID, crew_id);
    store64(job + AGN_OJ_NAME, agnosai_crew_name(spec));

    if (thread_create_detached(&_agnosai_orch_submit_thread, job) == 0) {
        _agnosai_orch_abandon(o, runner, crew_id);
        _agnosai_orch_tenant_done(o, spec);
        if (out_err != 0) { store64(out_err, agnosai_error_scheduling(str_from("could not start the crew's thread"))); }
        atomic_fetch_add(spec + AGN_CREW_RUNS, 0 - 1);
        return 0;
    }
    return crew_id;
}

# ── resuming a crew from its log (2.5.0, ADR 036) ──────────────────────────

# Put a crew that ended before a restart back in the registry, as it ended: what its log's last
# state says, with no runner. Nothing if the registry holds the id already.
fn _agnosai_orch_restore_ended(o, state): i64 {
    var crew_id = agnosai_crew_state_crew_id(state);
    var mtx = load64(o + AGN_OR_MUTEX);
    var dropped = 0;
    if (load64(o + AGN_OR_STORE) != 0) { dropped = vec_new(); }
    var give = vec_new();
    mutex_lock(mtx);
    if (map_get(load64(o + AGN_OR_CREWS), crew_id) != 0) {
        mutex_unlock(mtx);
        return 0;
    }
    var evicted = _agnosai_orch_evict_give_locked(o, default_alloc(), dropped, give);
    map_set(load64(o + AGN_OR_CREWS), str_clone(crew_id), state);
    _agnosai_orch_note_ended_locked(o, state);
    mutex_unlock(mtx);
    _agnosai_orch_log_evicted(evicted);
    _agnosai_orch_drop_logs(o, dropped);
    _agnosai_orch_give_back(o, give);
    return 1;
}

# Resume crew `crew_id` from its log in the orchestrator's store (ADR 036). A crew whose log ended
# goes back in the registry as it ended, and runs nothing. One whose log did not end is registered
# and run on a thread of its own, as `agnosai_orchestrator_submit_crew` runs one, from where its log
# left off: what it finished stands, an answer that waited on a reviewer is asked about again, a
# task whose earlier attempt made calls whose effect may stand waits for a reviewer before it runs
# again, and the rest runs. Its events go on from its log's last `seq`.
#
# Returns the crew's id, or 0 with the error through `out_err`: no store, no log for the crew, a log
# that cannot be read, a crew the registry already holds, or one admission refuses, as a new crew's
# would be refused (its tenant unknown or spent). A refused crew's log is left as it was, to try
# again.
fn agnosai_orchestrator_resume_crew_err(o, crew_id: Str, out_err): i64 {
    if (out_err != 0) { store64(out_err, 0); }
    var store = load64(o + AGN_OR_STORE);
    if (store == 0) {
        if (out_err != 0) { store64(out_err, agnosai_error_other(str_from("no state store to resume from"))); }
        return 0;
    }
    var rerr: i64[1];
    var rp = agnosai_crew_log_read(store, crew_id, &rerr);
    if (rp == 0) {
        var why = load64(&rerr);
        if (why == 0) { why = agnosai_error_crew_not_found(crew_id); }
        if (out_err != 0) { store64(out_err, why); }
        return 0;
    }
    var spec = agnosai_crew_replay_spec(rp);
    var mtx = load64(o + AGN_OR_MUTEX);
    mutex_lock(mtx);
    var held = map_get(load64(o + AGN_OR_CREWS), agnosai_crew_id(spec));
    mutex_unlock(mtx);
    if (held != 0) {
        if (out_err != 0) { store64(out_err, agnosai_error_other(str_from("crew is already registered"))); }
        return 0;
    }
    var ended = agnosai_crew_replay_state(rp);
    if (ended != 0) {
        _agnosai_orch_restore_ended(o, ended);
        return agnosai_crew_id(spec);
    }
    var parent: i64[1];
    var refused = _agnosai_orch_admit(o, spec, &parent);
    if (refused != 0) {
        _agnosai_orch_refused(o, spec, refused);
        if (out_err != 0) { store64(out_err, refused); }
        return 0;
    }
    return _agnosai_orch_launch(o, spec, _agnosai_orch_register_with(o, spec, load64(&parent), rp), out_err);
}

# `agnosai_orchestrator_resume_crew_err` without the error.
fn agnosai_orchestrator_resume_crew(o, crew_id: Str): i64 {
    return agnosai_orchestrator_resume_crew_err(o, crew_id, 0);
}

# After a restart, read back every crew log in the orchestrator's store (ADR 036): each crew whose
# log ended goes back in the registry as it ended, and each whose log did not is resumed. Returns
# how many were resumed, and how many restored through `out_restored`, or 0 for none. A crew that
# cannot be read back or resumed is a WARN, and its log is left as it was.
#
# What `src/main.cyr` runs before the server listens, when `AGNOSAI_STATE_DIR` is set.
fn agnosai_orchestrator_recover(o, out_restored): i64 {
    if (out_restored != 0) { store64(out_restored, 0); }
    var store = load64(o + AGN_OR_STORE);
    if (store == 0) { return 0; }
    var ids = vec_new();
    var lerr = agnosai_state_store_list(store, ids);
    if (lerr != 0 && sakshi_get_level() >= SK_WARN) {
        var lf[AGNOSAI_LOG_FIELDS_BYTES];
        var ln = agnosai_log_fields_start(&lf, agnosai_error_message(lerr));
        sakshi_log_kv(SK_WARN, "crew logs could not be listed", 29, "error", 5, &lf, ln);
    }
    var resumed = 0;
    var restored = 0;
    for (var i = 0; i < vec_len(ids); i = i + 1) {
        var id = vec_get(ids, i);
        var rerr: i64[1];
        var rp = agnosai_crew_log_read(store, id, &rerr);
        var err = load64(&rerr);
        if (rp != 0 && agnosai_crew_replay_state(rp) != 0) {
            if (_agnosai_orch_restore_ended(o, agnosai_crew_replay_state(rp)) == 1) { restored = restored + 1; }
        } elif (rp != 0) {
            var serr: i64[1];
            if (agnosai_orchestrator_resume_crew_err(o, id, &serr) != 0) { resumed = resumed + 1; }
            else { err = load64(&serr); }
        } elif (err == 0) {
            err = agnosai_error_other(str_from("its log holds no spec to run"));
        }
        if (err != 0 && sakshi_get_level() >= SK_WARN) {
            var f[AGNOSAI_LOG_FIELDS_BYTES];
            var n = agnosai_log_fields_start(&f, id);
            n = agnosai_log_field_str(&f, n, "error", agnosai_error_message(err));
            sakshi_log_kv(SK_WARN, "crew could not be recovered from its log", 40, "crew_id", 7, &f, n);
        }
    }
    if (out_restored != 0) { store64(out_restored, restored); }
    if (sakshi_get_level() >= SK_INFO && resumed + restored > 0) {
        var g[AGNOSAI_LOG_FIELDS_BYTES];
        var m = agnosai_log_fields_start_int(&g, resumed);
        m = agnosai_log_field_int(&g, m, "restored", restored);
        sakshi_log_kv(SK_INFO, "crews recovered from their logs", 31, "resumed", 7, &g, m);
    }
    return resumed;
}

# Cancel a crew by id. Returns 0, a CrewNotFound error, or — for a crew that
# has already finished — an Other error saying so (2.1.6).
#
# Sets the shared flag so a running crew stops scheduling new tasks — work
# already in flight finishes — and marks the registered state Cancelled.
#
# An unknown id is an ERROR, not a silent no-op: a caller cancelling a crew that
# was never registered has a bug, and the oracle says so.
#
# ⚠ **A finished crew is left as it finished (2.1.6, ADR 022's rule).** Through
# 2.1.5 this overwrote any registered state, COMPLETED and FAILED included, so a
# cancel that arrived a moment after the crew ended relabelled finished work as
# cancelled — and a consumer that latches what it is told (agnostic) then
# reported every completed result under `cancelled`. The oracle did the same;
# this diverges on purpose. The check and the write share the registry lock, so
# no completion can slip between them.
fn agnosai_orchestrator_cancel_crew(o, crew_id: Str): i64 {
    var mtx = load64(o + AGN_OR_MUTEX);
    mutex_lock(mtx);

    var state = map_get(load64(o + AGN_OR_CREWS), crew_id);
    if (state == 0) {
        mutex_unlock(mtx);
        return agnosai_error_crew_not_found(crew_id);
    }
    if (_agnosai_orch_is_finished(state) == 1) {
        mutex_unlock(mtx);
        return agnosai_error_other(str_from("crew has already finished and cannot be cancelled"));
    }
    var flag = map_get(load64(o + AGN_OR_CANCEL), crew_id);
    if (flag != 0) { store64(flag, 1); }
    # The reason first, so a reader that sees CANCELLED sees why as well.
    agnosai_crew_state_with_reason(state, AGNOSAI_CREW_REASON_CANCELLED);
    atomic_fence();
    agnosai_crew_state_with_status(state, AGNOSAI_CREW_CANCELLED);
    # With no flag nothing is running this crew, so no finish will queue it, and without this
    # it could never be evicted. A crew with a flag is queued when its runner stops.
    if (flag == 0) { _agnosai_orch_note_ended_locked(o, state); }
    mutex_unlock(mtx);
    # A crew waiting for its turn sees the flag now, not at its next poll (ADR 033).
    if (flag != 0) { agnosai_semaphore_wake_waiters(load64(o + AGN_OR_CREW_SEM)); }

    if (load64(o + AGN_OR_AUDIT) != 0) {
        var md = bayan_json_v_obj_new();
        bayan_json_v_obj_set(md, str_from("crew_id"), bayan_json_v_str_new(str_clone(crew_id)));
        _agnosai_orch_audit(o, str_from("crew_cancelled"), str_from("warn"),
          str_from("crew cancelled by caller"), md);
    }
    return 0;
}

# Take a crew out of the registry, once a consumer has read all it needs. Returns 0, a
# CrewNotFound error, or an Other error for a crew still running.
#
# **The other half of ADR 026.** Eviction is a backstop: a window of 900 is enough for a poller
# that keeps up and not for one that falls behind. A consumer that forgets what it has read
# keeps the registry at the crews still running, so eviction never fires and no reader can lose
# one. Reading first is the caller's job, and the state stays valid after this for a caller
# that still holds it, since a registry entry is a pointer and nothing here frees it.
#
# ⚠ **Refused while a runner holds the crew, and the test is the cancel flag, not the status.**
# `cancel_crew` marks a crew CANCELLED in place while its work finishes, so a terminal status
# does not mean it has stopped. Forgetting that crew would not stick: its runner stores the
# final state on the way out, and the crew would come back with nobody left to forget it. The
# flag goes under this same lock as the final state lands, so "no flag" means the state here is
# final. A crew that never ran (a cyclic DAG, or a thread that would not start) ends FAILED with
# no flag since 2.4.0 (ADR 032), and may be forgotten. This all holds for one run of an id at a time: overlapping runs
# of one id have always shared an entry and a flag, and the first to end takes both.
#
# A crew's event channel is removed after its final state is stored, so a consumer that waits
# for its subscription to close can always forget what it then finds.
fn agnosai_orchestrator_forget_crew(o, crew_id: Str): i64 {
    var mtx = load64(o + AGN_OR_MUTEX);
    mutex_lock(mtx);
    var crews = load64(o + AGN_OR_CREWS);
    if (map_get(crews, crew_id) == 0) {
        mutex_unlock(mtx);
        return agnosai_error_crew_not_found(crew_id);
    }
    if (map_get(load64(o + AGN_OR_CANCEL), crew_id) != 0) {
        mutex_unlock(mtx);
        return agnosai_error_other(str_from("crew is still running and cannot be forgotten"));
    }
    # An owned crew nothing holds goes back once the lock is given back (ADR 037).
    var owned = 0;
    var fr = map_get(load64(o + AGN_OR_RUNNERS), crew_id);
    if (fr != 0 && load64(load64(fr + AGN_CR_SPEC) + AGN_CREW_OWNER) == o) {
        owned = load64(fr + AGN_CR_SPEC);
        store64(owned + AGN_CREW_PLACED, _AGNOSAI_CREW_UNPLACED);
        if (load64(owned + AGN_CREW_HOLDS) != 0) { owned = 0; }
    }
    map_delete(crews, crew_id);
    map_delete(load64(o + AGN_OR_RUNNERS), crew_id);
    _agnosai_orch_compact_ended_locked(o);
    mutex_unlock(mtx);
    if (owned != 0) {
        agnosai_orchestrator_release_crew(o, owned);
        return 0;
    }
    # Its log goes with it (ADR 036).
    var store = load64(o + AGN_OR_STORE);
    if (store != 0) {
        var ids = vec_new();
        vec_push(ids, crew_id);
        _agnosai_orch_drop_logs(o, ids);
    }
    return 0;
}

# Drop every ended-queue slot that points into arena `a`. The caller holds the lock.
#
# A queue slot is a pointer to a crew's state, and `_agnosai_orch_is_current_locked` reads
# through it, so a slot left behind would read scrubbed memory, or another crew's. A forgotten
# crew leaves one and so does an id run twice, which is why this goes by address: a crew may
# have more than one state in here, and `AGN_OR_CREWS` no longer names any of them.
fn _agnosai_orch_purge_ended_locked(o, a): i64 {
    var ended = load64(o + AGN_OR_ENDED);
    var head = load64(o + AGN_OR_ENDED_HEAD);
    var len = vec_len(ended);
    var kept = head;
    for (var i = head; i < len; i = i + 1) {
        var state = vec_get(ended, i);
        if (agnosai_crew_arena_holds(a, state) == 0) {
            vec_set(ended, kept, state);
            kept = kept + 1;
        }
    }
    vec_truncate(ended, kept);
    return len - kept;
}

# Give a crew back: it leaves the registry if it is still there, and an arena crew's memory
# goes back to its pool for the next crew. Returns 0, or an Other error for a crew still
# running or already released, which is left as it is. A crew on the global heap has no
# arena to give back, so for one of those this is `forget_crew`.
#
# **The other half of `agnosai_crew_new_in` (ADR 028).** `forget_crew` takes a crew out of the
# registry and frees nothing, and it keeps that contract: a consumer may read a forgotten crew
# for as long as it likes. This is the call that ends that. It is separate because a consumer
# forgets a crew when it has read it, and is done with it some time later.
#
# ⚠ **After this, nothing the crew had is valid**: the spec and its id, its tasks, its state and
# results, its events. It is scrubbed and will be reused. So a consumer clears its own pointers
# first, under whatever lock its readers take, and calls this exactly once. Passing a spec a
# second time is refused only until its arena serves another crew.
#
# ⚠ **Waits out the run's last few instructions, and only then takes the crew out.** A run that
# has dropped its flag still has its event channel to remove, with the crew's id in hand, and a
# consumer can get here in between. `AGN_CREW_RUNS` reaching 0 is the run's last touch of the
# crew, and the flag and that count are read under one lock, so the delete and the purge happen
# after everything that could put the crew back. Doing them first left a dangling entry behind
# a second run of the same spec: overlapping runs share one flag and the first to end takes it,
# and the other then stored its final state into the registry, under a key in the arena, on its
# way to being scrubbed. So for that case, and only that one, this waits for the whole of the
# other run. Otherwise it is a window of a few instructions.
#
# The channel is removed here too, as a crew that never ran left its own behind. That closes a
# subscription, which `agnosai_event_bus_recycle` then takes back.
fn agnosai_orchestrator_release_crew(o, spec): i64 {
    return _agnosai_orch_release(o, spec, 1);
}

# `agnosai_orchestrator_release_crew`, looking in the ended queue for the crew's entries only when
# `purge` is 1 (ADR 037).
fn _agnosai_orch_release(o, spec, purge): i64 {
    var crew_id = agnosai_crew_id(spec);
    if (crew_id == 0) {
        return agnosai_error_other(str_from("crew has already been released"));
    }
    var a = agnosai_crew_arena(spec);

    var mtx = load64(o + AGN_OR_MUTEX);
    while (1 == 1) {
        mutex_lock(mtx);
        if (map_get(load64(o + AGN_OR_CANCEL), crew_id) != 0) {
            mutex_unlock(mtx);
            return agnosai_error_other(str_from("crew is still running and cannot be released"));
        }
        if (atomic_load(spec + AGN_CREW_RUNS) == 0) { break; }
        mutex_unlock(mtx);
        sys_sched_yield();
    }
    atomic_fence();
    map_delete(load64(o + AGN_OR_CREWS), crew_id);
    map_delete(load64(o + AGN_OR_RUNNERS), crew_id);
    if (a != 0 && purge == 1) { _agnosai_orch_purge_ended_locked(o, a); }
    _agnosai_orch_compact_ended_locked(o);
    mutex_unlock(mtx);

    var bus = load64(o + AGN_OR_EVENTS);
    if (bus != 0) { agnosai_event_bus_remove(bus, crew_id); }
    # Its log goes with it (ADR 036), while its id is still the crew's.
    if (load64(o + AGN_OR_STORE) != 0) {
        var ids = vec_new();
        vec_push(ids, str_clone(crew_id));
        _agnosai_orch_drop_logs(o, ids);
    }
    if (a != 0) { agnosai_crew_arena_give_back(a); }
    return 0;
}
