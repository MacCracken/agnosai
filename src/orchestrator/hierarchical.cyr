# =========================================================================
# orchestrator/hierarchical — manager-driven task delegation.
#
# Origin: rust-old/src/orchestrator/hierarchical.rs
#
# In hierarchical mode a designated manager agent does not execute anything
# itself; it assigns each task to the best-scoring worker from the pool, using
# `orch_scoring`'s ranking.
#
# **The manager is the fallback, not a candidate.** It is excluded from the
# worker pool, so it never competes for a task on score — but when the pool is
# empty it takes every task itself. That is the oracle's behaviour and it means
# a crew with one agent still runs: the manager quietly becomes the worker.
#
# `ManagerAgent<'a>` is three borrowed slices in the oracle, which exists only to
# give `delegate()` a receiver. Here it is a plain struct holding the same three
# things, and `agnosai_delegate_tasks` is the function the method delegates to —
# same split, same names.
# =========================================================================

include "src/log_fields.cyr"

# An assignment: which agent should run which task.
enum AgnosaiAssignmentOff {
    AGN_AS_TASK_ID = 0;
    AGN_AS_AGENT_KEY = 8;
    AGN_AS_SIZE = 16;
}

# The task being assigned.
fn agnosai_assignment_task_id(a): i64 {
    return load64(a + AGN_AS_TASK_ID);
}

# The agent key it was assigned to.
fn agnosai_assignment_agent_key(a): i64 {
    return load64(a + AGN_AS_AGENT_KEY);
}

# Build an assignment.
fn agnosai_assignment_new(task_id: Str, agent_key: Str): i64 {
    var a = alloc(AGN_AS_SIZE);
    store64(a + AGN_AS_TASK_ID, task_id);
    store64(a + AGN_AS_AGENT_KEY, agent_key);
    return a;
}

# Log a delegation event.
fn _agnosai_hier_log(level, msg, msg_len, key: Str, detail): i64 {
    if (sakshi_get_level() < level) { return 0; }
    var sb = str_builder_new();
    str_builder_add(sb, key);
    if (detail != 0) {
        str_builder_add_cstr(sb, " ");
        str_builder_add(sb, detail);
    }
    var line = str_builder_build(sb);
    sakshi_log_kv(level, msg, msg_len, "delegate", 8, str_data(line), str_len(line));
    return 0;
}

# Assign every task to its best-scoring agent.
#
# Returns a vec of assignments, one per task, in the tasks' own order — the
# oracle pushes as it iterates, so the result is positionally aligned with the
# input and its own test relies on that.
#
# With no workers the manager takes every task. Otherwise each task is ranked
# independently: two tasks in one call can go to different agents, and the same
# agent can take several — there is no round-robin and no capacity limit here.
fn agnosai_delegate_tasks(manager, agents, tasks): i64 {
    var assignments = vec_new();
    var manager_key = agnosai_agent_key(manager);

    for (var i = 0; i < vec_len(tasks); i = i + 1) {
        var task = vec_get(tasks, i);
        var task_id = agnosai_task_id(task);

        if (vec_len(agents) == 0) {
            _agnosai_hier_log(SK_WARN, "no workers available, manager takes task", 40,
              manager_key, task_id);
            vec_push(assignments, agnosai_assignment_new(task_id, manager_key));
            continue;
        }

        var ranked = agnosai_rank_agents(agents, task);

        # `ranked.first().unwrap_or((0, 0.0))` in the oracle: index 0 is the
        # fallback when the ranking comes back empty, which it cannot here since
        # the pool is non-empty — but reproducing the default keeps the
        # out-of-range indexing impossible rather than merely unlikely.
        var best_idx = 0;
        if (vec_len(ranked) > 0) { best_idx = agnosai_scored_index(vec_get(ranked, 0)); }

        var agent_key = agnosai_agent_key(vec_get(agents, best_idx));
        _agnosai_hier_log(SK_DEBUG, "delegated task to agent", 23, agent_key, task_id);
        vec_push(assignments, agnosai_assignment_new(task_id, agent_key));
    }

    _agnosai_hier_log(SK_INFO, "hierarchical delegation complete", 32,
      str_from_int(vec_len(assignments)), 0);
    return assignments;
}

# ManagerAgent — the manager's definition plus the pool and tasks it delegates.
enum AgnosaiManagerOff {
    AGN_MG_DEFINITION = 0;
    AGN_MG_AGENTS = 8;
    AGN_MG_TASKS = 16;
    AGN_MG_SIZE = 24;
}

# Create a manager over a worker pool and a task list.
#
# `agents` must already exclude the manager; the oracle's field comment says so
# and nothing here filters it. A manager left in its own pool would be allowed
# to win a task on score, which is exactly what hierarchical mode exists to
# prevent.
fn agnosai_manager_agent_new(definition, agents, tasks): i64 {
    var m = alloc(AGN_MG_SIZE);
    store64(m + AGN_MG_DEFINITION, definition);
    store64(m + AGN_MG_AGENTS, agents);
    store64(m + AGN_MG_TASKS, tasks);
    return m;
}

# The manager's own agent definition.
fn agnosai_manager_agent_definition(m): i64 {
    return load64(m + AGN_MG_DEFINITION);
}

# The worker pool.
fn agnosai_manager_agent_agents(m): i64 {
    return load64(m + AGN_MG_AGENTS);
}

# The tasks to delegate.
fn agnosai_manager_agent_tasks(m): i64 {
    return load64(m + AGN_MG_TASKS);
}

# Delegate every task the manager holds.
fn agnosai_manager_agent_delegate(m): i64 {
    return agnosai_delegate_tasks(load64(m + AGN_MG_DEFINITION), load64(m + AGN_MG_AGENTS),
      load64(m + AGN_MG_TASKS));
}

# ── A manager and its workers (2.4.3, ADR 035) ─────────────────────────────
#
# **Authority only narrows.** A worker holds at most its manager's tools: what both name, in the
# worker's order. A tool only the worker names is withheld, and the run records which. Nothing in
# the run widens a grant, neither the manager nor a model; the crew's author does, by giving the
# manager the tool.

# Whether `tools`, a vec of names, holds `name`.
fn _agnosai_hier_holds(tools, name: Str): i64 {
    if (tools == 0) { return 0; }
    for (var i = 0; i < vec_len(tools); i = i + 1) {
        if (str_eq(vec_get(tools, i), name) == 1) { return 1; }
    }
    return 0;
}

# The tools `worker` names that `manager` holds too (`kept` 1), or that it does not (`kept` 0), in
# the worker's order, in `a`.
fn _agnosai_hier_tools_a(a, worker, manager, kept): i64 {
    var out = vec_new_a(a);
    var mine = agnosai_agent_tools(worker);
    var theirs = agnosai_agent_tools(manager);
    if (mine == 0) { return out; }
    for (var i = 0; i < vec_len(mine); i = i + 1) {
        var name = vec_get(mine, i);
        if (_agnosai_hier_holds(theirs, name) == kept) { vec_push_a(a, out, name); }
    }
    return out;
}

# The tools of `worker` that `manager` does not hold, in `a`.
fn agnosai_tools_withheld_a(a, worker, manager): i64 {
    return _agnosai_hier_tools_a(a, worker, manager, 0);
}

# A copy of `worker`, in `a`, holding only the tools `manager` holds too. Every other field is the
# worker's own, shared, so its system prompt and its score read the tools it may use.
fn agnosai_worker_within_a(a, worker, manager): i64 {
    var w = alloc_via(a, AGN_AGENT_SIZE);
    memcpy(w, worker, AGN_AGENT_SIZE);
    store64(w + AGN_AGENT_TOOLS, _agnosai_hier_tools_a(a, worker, manager, 1));
    return w;
}

# Warn that `manager` withholds `held`, a vec of `worker`'s tool names. A run says it once a worker,
# and `delegate` once a call. The tools are named in the record, not here.
fn agnosai_log_withheld(manager, worker, held): i64 {
    if (sakshi_get_level() < SK_WARN) { return 0; }
    var f[AGNOSAI_LOG_FIELDS_BYTES];
    var n = agnosai_log_fields_start(&f, agnosai_agent_key(worker));
    n = agnosai_log_field_str(&f, n, "manager", agnosai_agent_key(manager));
    n = agnosai_log_field_int(&f, n, "withheld", vec_len(held));
    sakshi_log_kv(SK_WARN, "a worker's tools its manager does not hold are withheld", 55, "worker", 6, &f, n);
    return 0;
}

# The agent of `agents` whose `agent_key` is `key`, or 0.
fn agnosai_find_manager(agents, key: Str): i64 {
    if (key == 0) { return 0; }
    for (var i = 0; i < vec_len(agents); i = i + 1) {
        if (str_eq(agnosai_agent_key(vec_get(agents, i)), key) == 1) { return vec_get(agents, i); }
    }
    return 0;
}

# The workers a hierarchical crew assigns its tasks to, in `a`: every agent but its manager, each
# within the manager's tools. With no other agent, the manager itself, as the Rust line's
# `delegate_tasks` falls back to it. An agent sharing the manager's key is the manager.
#
# Ranking these is how a run assigns each task, so `agnosai_explain_selection_a` over them explains
# a hierarchical run exactly, as it explains any other over the crew's agents.
fn agnosai_hierarchical_workers_a(a, agents, manager): i64 {
    var out = vec_new_a(a);
    var key = agnosai_agent_key(manager);
    for (var i = 0; i < vec_len(agents); i = i + 1) {
        var ag = vec_get(agents, i);
        if (str_eq(agnosai_agent_key(ag), key) == 0) {
            vec_push_a(a, out, agnosai_worker_within_a(a, ag, manager));
        }
    }
    if (vec_len(out) == 0) { vec_push_a(a, out, manager); }
    return out;
}
