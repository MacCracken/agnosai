# =========================================================================
# orchestrator/budget — token and cost budget enforcement for a running crew.
#
# Origin: rust-old/src/orchestrator/budget.rs
#
# Checked before every inference call; once a limit is *reached* the crew stops.
#
# **This module does not use micro-USD, and that is deliberate.** The rest of
# the port carries money as millionths of a dollar (the 2026-07-28 decision, see
# `core_resource`). The oracle here uses its own unit — **1/10000 USD**, which
# it calls a "cost unit" — because it needs an integer for atomic accumulation
# without floating-point atomics. That unit is not an implementation detail that
# can be quietly widened: `BudgetExceeded::Cost` derives `Serialize` and carries
# `used_units` / `limit_units` **on the wire**, so changing the divisor changes
# the numbers a consumer reads. It is reproduced exactly.
#
# The two units meet at the constructor. `ResourceBudget`'s limit arrives in
# micro-USD and is converted with `ceil`, matching the oracle's
# `(c * 10_000.0).ceil()`. Since 1 cost unit is exactly 100 micro-USD, that is
# integer ceil-division and needs no float — which makes this port's conversion
# *more* exact than the oracle's, whose f64 multiply can land a hair under an
# integer and ceil to the wrong unit.
#
# **Limits bite at `>=`, not `>`.** A tracker that has used exactly its token
# allowance refuses the next call. That is the opposite of `multi_tenant`'s
# check, which passes at exactly the limit — the two modules genuinely differ,
# and both are the oracle's.
#
# The oracle's atomics are `atomic_fetch_add` here since 2.4.1 (ADR 033), when a crew's
# workers began recording into one tracker at once. Through 2.4.0 they were plain
# fields, which lost an update to a concurrent record, and nothing called them.
#
# ## Budgets subdivide (ADR 033)
#
# A tracker may have a parent: a task's counts against its crew's, and a crew's against
# its tenant's. What is recorded into a tracker is recorded into every tracker above it,
# and a check fails on the nearest one that is spent, so a task can never spend more
# than its crew has left, nor a crew more than its tenant has. A tracker's scope names
# it in a breach's message ("crew token budget exceeded: …"); with none, the message is
# the oracle's own.
# =========================================================================

# Cost units per dollar: the oracle's 10_000, i.e. one unit is 1/10000 USD.
var AGNOSAI_COST_UNITS_PER_USD = 10000;

# Micro-USD per cost unit — 1000000 / 10000. The bridge between this module's
# unit and the port's money representation.
var AGNOSAI_MICRO_USD_PER_COST_UNIT = 100;

# No budget breach.
var AGNOSAI_BUDGET_WITHIN = 0;

# The token limit has been reached.
var AGNOSAI_BUDGET_TOKENS = 1;

# The cost limit has been reached.
var AGNOSAI_BUDGET_COST = 2;

# BudgetTracker — usage counters plus the limits they are checked against.
#
# `AGNOSAI_NO_LIMIT` in either limit field means "unlimited", the port's
# standing spelling of the oracle's `Option::None`.
enum AgnosaiBudgetTrackerOff {
    AGN_BT_TOKENS_USED = 0;
    AGN_BT_COST_UNITS = 8;
    AGN_BT_MAX_TOKENS = 16;
    AGN_BT_MAX_COST_UNITS = 24;
    # The tracker this one's spending also counts against, or 0 (ADR 033).
    AGN_BT_PARENT = 32;
    # A C string naming what this is the budget of, for a breach's message, or 0.
    AGN_BT_SCOPE = 40;
    AGN_BT_SIZE = 48;
}

# Convert micro-USD to cost units, rounding **up** — the oracle's `.ceil()`.
#
# Rounding up is the conservative direction for a budget: a cost that does not
# divide evenly is charged the larger unit, so the tracker can never understate
# what has been spent.
fn agnosai_micro_usd_to_cost_units(micro): i64 {
    if (micro <= 0) { return 0; }
    return (micro + AGNOSAI_MICRO_USD_PER_COST_UNIT - 1) / AGNOSAI_MICRO_USD_PER_COST_UNIT;
}

# Create a tracker from a `ResourceBudget`.
fn agnosai_budget_tracker_new(budget): i64 {
    return agnosai_budget_tracker_new_a(default_alloc(), budget);
}

# `agnosai_budget_tracker_new`, in allocator `a`.
fn agnosai_budget_tracker_new_a(a, budget): i64 {
    var max_tokens = AGNOSAI_NO_LIMIT;
    var max_micro = AGNOSAI_NO_LIMIT;
    if (budget != 0) {
        max_tokens = agnosai_resource_budget_max_tokens(budget);
        max_micro = agnosai_resource_budget_max_cost_micro_usd(budget);
    }
    return agnosai_budget_tracker_limits_a(a, max_tokens, max_micro, 0, 0);
}

# A tracker of `max_tokens` and `max_cost_micro_usd` (either `AGNOSAI_NO_LIMIT`), in allocator `a`,
# whose spending also counts against `parent` (0 for none), and which a breach's message calls
# `scope`, a C string (0 for the oracle's bare message).
fn agnosai_budget_tracker_limits_a(a, max_tokens, max_cost_micro_usd, parent, scope): i64 {
    var t = alloc_via(a, AGN_BT_SIZE);
    store64(t + AGN_BT_TOKENS_USED, 0);
    store64(t + AGN_BT_COST_UNITS, 0);
    store64(t + AGN_BT_PARENT, parent);
    store64(t + AGN_BT_SCOPE, scope);
    agnosai_budget_tracker_set_limits(t, max_tokens, max_cost_micro_usd);
    return t;
}

# Change a tracker's limits, keeping what it has spent: a tenant's, when it is registered again.
# Either may be `AGNOSAI_NO_LIMIT`. Any other limit below 1 is spent before anything is, as it
# always was: a budget that cannot be read as a limit fails closed.
fn agnosai_budget_tracker_set_limits(t, max_tokens, max_cost_micro_usd): i64 {
    var units = AGNOSAI_NO_LIMIT;
    if (max_cost_micro_usd != AGNOSAI_NO_LIMIT) {
        units = agnosai_micro_usd_to_cost_units(max_cost_micro_usd);
    }
    store64(t + AGN_BT_MAX_TOKENS, max_tokens);
    store64(t + AGN_BT_MAX_COST_UNITS, units);
    return 0;
}

# The tracker `t`'s spending also counts against, or 0.
fn agnosai_budget_tracker_parent(t): i64 {
    return load64(t + AGN_BT_PARENT);
}

# What `t` is the budget of, as a C string, or 0.
fn agnosai_budget_tracker_scope(t): i64 {
    return load64(t + AGN_BT_SCOPE);
}

# Forget what `t` has spent, and not what its parent has: a tenant's count, at the start of a
# period its operator keeps.
fn agnosai_budget_tracker_reset(t): i64 {
    atomic_store(t + AGN_BT_TOKENS_USED, 0);
    atomic_store(t + AGN_BT_COST_UNITS, 0);
    return 0;
}

# Total tokens recorded so far.
fn agnosai_budget_tracker_tokens_used(t): i64 {
    return load64(t + AGN_BT_TOKENS_USED);
}

# Total cost recorded so far, in cost units.
fn agnosai_budget_tracker_cost_units(t): i64 {
    return load64(t + AGN_BT_COST_UNITS);
}

# Total cost recorded so far, as an f64 dollar amount.
fn agnosai_budget_tracker_cost_usd(t): i64 {
    return f64_div(f64_from(load64(t + AGN_BT_COST_UNITS)),
      f64_from(AGNOSAI_COST_UNITS_PER_USD));
}

# The token limit, or AGNOSAI_NO_LIMIT.
fn agnosai_budget_tracker_max_tokens(t): i64 {
    return load64(t + AGN_BT_MAX_TOKENS);
}

# The cost limit in cost units, or AGNOSAI_NO_LIMIT.
fn agnosai_budget_tracker_max_cost_units(t): i64 {
    return load64(t + AGN_BT_MAX_COST_UNITS);
}

# Whether any limit is configured at all.
fn agnosai_budget_tracker_has_limits(t): i64 {
    if (load64(t + AGN_BT_MAX_TOKENS) != AGNOSAI_NO_LIMIT) { return 1; }
    if (load64(t + AGN_BT_MAX_COST_UNITS) != AGNOSAI_NO_LIMIT) { return 1; }
    return 0;
}

# Record tokens consumed by a completed inference call, into `t` and every tracker above it.
fn agnosai_budget_tracker_record_tokens(t, tokens): i64 {
    var at = t;
    while (at != 0) {
        atomic_fetch_add(at + AGN_BT_TOKENS_USED, tokens);
        at = load64(at + AGN_BT_PARENT);
    }
    return 0;
}

# Record the cost of a completed inference call, in micro-USD, into `t` and every tracker above it.
#
# The oracle takes f64 USD and ceils; this takes the port's micro-USD and
# ceil-divides, which is the same rounding without the float. It is ceiled once,
# so every tracker of the chain is charged the same units.
fn agnosai_budget_tracker_record_cost(t, micro_usd): i64 {
    var units = agnosai_micro_usd_to_cost_units(micro_usd);
    var at = t;
    while (at != 0) {
        atomic_fetch_add(at + AGN_BT_COST_UNITS, units);
        at = load64(at + AGN_BT_PARENT);
    }
    return 0;
}

# The oracle's `warn!` when a limit is hit.
fn _agnosai_budget_log(msg, msg_len, used, limit): i64 {
    if (sakshi_get_level() < SK_WARN) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "used=");
    str_builder_add_int(sb, used);
    str_builder_add_cstr(sb, " limit=");
    str_builder_add_int(sb, limit);
    var line = str_builder_build(sb);
    sakshi_log_kv(SK_WARN, msg, msg_len, "budget", 6, str_data(line), str_len(line));
    return 0;
}

# Which limit of `t` alone is reached, without a word: `AGNOSAI_BUDGET_WITHIN`, or the kind.
fn _agnosai_budget_tracker_own(t): i64 {
    var max_tokens = load64(t + AGN_BT_MAX_TOKENS);
    if (max_tokens != AGNOSAI_NO_LIMIT) {
        if (atomic_load(t + AGN_BT_TOKENS_USED) >= max_tokens) { return AGNOSAI_BUDGET_TOKENS; }
    }
    var max_cost = load64(t + AGN_BT_MAX_COST_UNITS);
    if (max_cost != AGNOSAI_NO_LIMIT) {
        if (atomic_load(t + AGN_BT_COST_UNITS) >= max_cost) { return AGNOSAI_BUDGET_COST; }
    }
    return AGNOSAI_BUDGET_WITHIN;
}

# Which limit stops another call, without a word, and which tracker it is through `out_at` (0 for
# don't care): `t`'s own first, then each tracker above it in turn, so the nearest that is spent
# is the one named. `AGNOSAI_BUDGET_WITHIN` when none is.
fn agnosai_budget_tracker_breach(t, out_at): i64 {
    var at = t;
    while (at != 0) {
        var kind = _agnosai_budget_tracker_own(at);
        if (kind != AGNOSAI_BUDGET_WITHIN) {
            if (out_at != 0) { store64(out_at, at); }
            return kind;
        }
        at = load64(at + AGN_BT_PARENT);
    }
    if (out_at != 0) { store64(out_at, 0); }
    return AGNOSAI_BUDGET_WITHIN;
}

# Whether another inference call is allowed.
#
# Returns `AGNOSAI_BUDGET_WITHIN`, or which limit has been reached, of `t` or of a tracker
# above it (`agnosai_budget_tracker_breach`), and warns once a call. Tokens are checked
# before cost, which is observable when both are breached.
#
# The test is `>=`: a tracker that has spent exactly its allowance is already
# over. `multi_tenant`'s equivalent uses `>` and passes at the limit — the two
# really do differ in the oracle, so neither can be "corrected" to match.
fn agnosai_budget_tracker_check(t): i64 {
    var at: i64[1];
    var kind = agnosai_budget_tracker_breach(t, &at);
    var b = load64(&at);
    if (kind == AGNOSAI_BUDGET_TOKENS) {
        _agnosai_budget_log("token budget exceeded", 21, load64(b + AGN_BT_TOKENS_USED),
          load64(b + AGN_BT_MAX_TOKENS));
    } elif (kind == AGNOSAI_BUDGET_COST) {
        _agnosai_budget_log("cost budget exceeded", 20, load64(b + AGN_BT_COST_UNITS),
          load64(b + AGN_BT_MAX_COST_UNITS));
    }
    return kind;
}

# Add a cost-unit count to `sb` as the oracle's `${:.4}` — four decimal places.
#
# One cost unit is exactly 1/10000 USD, so four decimals is the unit's own
# precision and the rendering is exact rather than rounded.
fn _agnosai_budget_add_usd_a(a, sb, units): i64 {
    str_builder_add_cstr_a(a, sb, "$");
    str_builder_add_int_a(a, sb, units / AGNOSAI_COST_UNITS_PER_USD);
    str_builder_add_cstr_a(a, sb, ".");
    var frac = units % AGNOSAI_COST_UNITS_PER_USD;
    if (frac < 0) { frac = 0 - frac; }
    # Zero-padded to four digits: 5 units is $0.0005, not $0.5.
    if (frac < 1000) { str_builder_add_cstr_a(a, sb, "0"); }
    if (frac < 100) { str_builder_add_cstr_a(a, sb, "0"); }
    if (frac < 10) { str_builder_add_cstr_a(a, sb, "0"); }
    str_builder_add_int_a(a, sb, frac);
    return 0;
}

# The oracle's `Display` for a breach, or 0 when nothing is exceeded.
#
# `token budget exceeded: {used} used, {limit} limit`
# `cost budget exceeded: ${used:.4} used, ${limit:.4} limit`
#
# A tracker with a scope names it first: `crew token budget exceeded: …` (ADR 033).
fn agnosai_budget_exceeded_message(t, kind): i64 {
    return agnosai_budget_exceeded_message_a(default_alloc(), t, kind);
}

# `agnosai_budget_exceeded_message`, in allocator `a`.
fn agnosai_budget_exceeded_message_a(a, t, kind): i64 {
    if (kind != AGNOSAI_BUDGET_TOKENS && kind != AGNOSAI_BUDGET_COST) { return 0; }
    var sb = str_builder_new_a(a);
    var scope = load64(t + AGN_BT_SCOPE);
    if (scope != 0) {
        str_builder_add_cstr_a(a, sb, scope);
        str_builder_add_cstr_a(a, sb, " ");
    }
    if (kind == AGNOSAI_BUDGET_TOKENS) {
        str_builder_add_cstr_a(a, sb, "token budget exceeded: ");
        str_builder_add_int_a(a, sb, atomic_load(t + AGN_BT_TOKENS_USED));
        str_builder_add_cstr_a(a, sb, " used, ");
        str_builder_add_int_a(a, sb, load64(t + AGN_BT_MAX_TOKENS));
    } else {
        str_builder_add_cstr_a(a, sb, "cost budget exceeded: ");
        _agnosai_budget_add_usd_a(a, sb, atomic_load(t + AGN_BT_COST_UNITS));
        str_builder_add_cstr_a(a, sb, " used, ");
        _agnosai_budget_add_usd_a(a, sb, load64(t + AGN_BT_MAX_COST_UNITS));
    }
    str_builder_add_cstr_a(a, sb, " limit");
    return str_builder_build_a(a, sb);
}

# A breach read back from JSON: which limit, what was used, and what the limit was.
enum AgnosaiBudgetBreachOff {
    AGN_BB_KIND = 0;
    AGN_BB_USED = 8;
    AGN_BB_LIMIT = 16;
    AGN_BB_SIZE = 24;
}

# Field `key` of `v` as a whole number, or a negative when it is missing, not a number, or negative.
fn _agnosai_budget_count(v, key): i64 {
    var f = bayan_json_v_obj_get_by_cstr(v, key);
    if (f == 0 || bayan_json_v_is_int(f) == 0) { return 0 - 1; }
    return bayan_json_v_int(f);
}

# A breach from `inner`, with its two fields under the names given. 0 when either is missing.
fn _agnosai_budget_breach_a(a, kind, inner, used_key, limit_key): i64 {
    if (bayan_json_v_is_obj(inner) != 1) { return 0; }
    var used = _agnosai_budget_count(inner, used_key);
    var limit = _agnosai_budget_count(inner, limit_key);
    if (used < 0 || limit < 0) { return 0; }
    var b = alloc_via(a, AGN_BB_SIZE);
    store64(b + AGN_BB_KIND, kind);
    store64(b + AGN_BB_USED, used);
    store64(b + AGN_BB_LIMIT, limit);
    return b;
}

# A breach from its JSON form, in allocator `a`, or 0 when it is malformed. The form is
# externally tagged, so the value has exactly one key, and it names the limit.
fn agnosai_budget_exceeded_from_value_a(a, v): i64 {
    if (bayan_json_v_is_obj(v) != 1 || bayan_json_v_obj_len(v) != 1) { return 0; }
    var tokens = bayan_json_v_obj_get_by_cstr(v, "Tokens");
    if (tokens != 0) { return _agnosai_budget_breach_a(a, AGNOSAI_BUDGET_TOKENS, tokens, "used", "limit"); }
    var cost = bayan_json_v_obj_get_by_cstr(v, "Cost");
    if (cost != 0) { return _agnosai_budget_breach_a(a, AGNOSAI_BUDGET_COST, cost, "used_units", "limit_units"); }
    return 0;
}

# Global-allocator form of `agnosai_budget_exceeded_from_value_a`.
fn agnosai_budget_exceeded_from_value(v): i64 {
    return agnosai_budget_exceeded_from_value_a(default_alloc(), v);
}

# Which limit a parsed breach is: `AGNOSAI_BUDGET_TOKENS` or `AGNOSAI_BUDGET_COST`.
fn agnosai_budget_exceeded_kind(b): i64 {
    return load64(b + AGN_BB_KIND);
}

# What was used: tokens, or cost in the form's 1/10000 unit.
fn agnosai_budget_exceeded_used(b): i64 {
    return load64(b + AGN_BB_USED);
}

# The limit, in the same unit as `agnosai_budget_exceeded_used`.
fn agnosai_budget_exceeded_limit(b): i64 {
    return load64(b + AGN_BB_LIMIT);
}

# Serialise a breach the way `BudgetExceeded` derives.
#
# The oracle is an externally-tagged enum, so `Tokens { used, limit }` emits
# `{"Tokens":{"used":N,"limit":N}}` and the cost arm names its fields
# `used_units` / `limit_units` — the 1/10000 unit is on the wire, which is why
# this module keeps it.
fn agnosai_budget_exceeded_to_value(t, kind): i64 {
    return agnosai_budget_exceeded_to_value_a(default_alloc(), t, kind);
}

# `agnosai_budget_exceeded_to_value`, in allocator `a`.
fn agnosai_budget_exceeded_to_value_a(a, t, kind): i64 {
    if (kind != AGNOSAI_BUDGET_TOKENS && kind != AGNOSAI_BUDGET_COST) { return 0; }
    var inner = bayan_json_v_obj_new_a(a);
    var arm = "Tokens";
    if (kind == AGNOSAI_BUDGET_TOKENS) {
        bayan_json_v_obj_set_a(a, inner, str_from_a(a, "used"),
          bayan_json_v_int_new_a(a, atomic_load(t + AGN_BT_TOKENS_USED)));
        bayan_json_v_obj_set_a(a, inner, str_from_a(a, "limit"),
          bayan_json_v_int_new_a(a, load64(t + AGN_BT_MAX_TOKENS)));
    } else {
        arm = "Cost";
        bayan_json_v_obj_set_a(a, inner, str_from_a(a, "used_units"),
          bayan_json_v_int_new_a(a, atomic_load(t + AGN_BT_COST_UNITS)));
        bayan_json_v_obj_set_a(a, inner, str_from_a(a, "limit_units"),
          bayan_json_v_int_new_a(a, load64(t + AGN_BT_MAX_COST_UNITS)));
    }
    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, arm), inner);
    return obj;
}
