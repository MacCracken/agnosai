# =========================================================================
# server_routes_a2a — Agent-to-Agent task delegation.
#
# Parity oracle: rust-old/src/server/routes/a2a.rs
#
# ## The callback's SSRF decision is here; its dispatch is not
#
# The oracle's `receive` ends by `tokio::spawn`-ing a fire-and-forget POST to
# `callback_url`, wrapped in a 30-second timeout, and explicitly ignores the
# result: a failed or timed-out callback is logged and changes nothing about the
# response already returned.
#
# This module ports **the decision** — `agnosai_route_a2a_callback_allowed`, the
# SSRF gate that decides whether the URL may be posted to at all, which is the
# security-relevant half and the half all five of the oracle's `#[test]`s cover.
# It does **not** dispatch the request, for two reasons that both point the same
# way: outbound HTTP goes through `agnosai_guarded_fetch`, which needs the
# per-request arena the router bite introduces; and spawning a thread per
# callback is a resource decision that belongs with the transport tier that
# owns the thread pool, not with a pure handler.
#
# The seam is deliberate and the handler is complete without it — the oracle's
# own response does not depend on the callback either. When the transport lands,
# it reads `agnosai_route_a2a_callback_allowed` and does the POST.
#
# ## `is_safe_callback_url` is a one-line delegate, and so is this
#
# `a2a.rs:16-18` is `crate::server::ssrf::is_safe_url(url)` and nothing else, so
# the port calls `agnosai_is_safe_url` directly. The five oracle tests in this
# file are therefore near-duplicates of `server_ssrf.tcyr`'s 81 assertions;
# they are ported anyway, because they are this file's tests and because a
# future refactor that stopped delegating would only be caught here.
# =========================================================================

# The oracle's two request caps (`a2a.rs:28-30`).
var AGNOSAI_A2A_MAX_STRING_LEN = 10000;
var AGNOSAI_A2A_MAX_METADATA_BYTES = 65536;

enum AgnosaiA2AReqOff {
    AGN_A2A_TASK_ID = 0;
    AGN_A2A_DESCRIPTION = 8;
    AGN_A2A_DOMAIN = 16;
    AGN_A2A_SIZE = 24;
    AGN_A2A_PRESET = 32;
    AGN_A2A_CALLBACK_URL = 40;
    AGN_A2A_METADATA = 48;
    AGN_A2A_STRUCT_SIZE = 56;
}

# A delegation request with only its two required fields set.
fn agnosai_a2a_req_new(task_id: Str, description: Str): i64 {
    var r = alloc(AGN_A2A_STRUCT_SIZE);
    store64(r + AGN_A2A_TASK_ID, task_id);
    store64(r + AGN_A2A_DESCRIPTION, description);
    store64(r + AGN_A2A_DOMAIN, 0);
    store64(r + AGN_A2A_SIZE, 0);
    store64(r + AGN_A2A_PRESET, 0);
    store64(r + AGN_A2A_CALLBACK_URL, 0);
    store64(r + AGN_A2A_METADATA, 0);
    return r;
}

# The caller's task identifier, echoed back on the response.
fn agnosai_a2a_req_task_id(r): Str { return load64(r + AGN_A2A_TASK_ID); }
# What the delegating agent wants done.
fn agnosai_a2a_req_description(r): Str { return load64(r + AGN_A2A_DESCRIPTION); }
# The optional domain hint, or 0 when the request omitted it.
fn agnosai_a2a_req_domain(r): i64 { return load64(r + AGN_A2A_DOMAIN); }
# The optional size hint, or 0 when the request omitted it.
fn agnosai_a2a_req_size(r): i64 { return load64(r + AGN_A2A_SIZE); }
# The optional crew preset name, or 0 when the request omitted it.
fn agnosai_a2a_req_preset(r): i64 { return load64(r + AGN_A2A_PRESET); }
# The optional completion callback, or 0. Passes the SSRF gate before use.
fn agnosai_a2a_req_callback_url(r): i64 { return load64(r + AGN_A2A_CALLBACK_URL); }
# The optional opaque metadata object, or 0 when the request omitted it.
fn agnosai_a2a_req_metadata(r): i64 { return load64(r + AGN_A2A_METADATA); }

# The fields serde accepts. `A2ARequest` is `deny_unknown_fields` (`a2a.rs:34`).
fn _agnosai_a2a_fields(): i64 {
    var f = agnosai_route_fields();
    agnosai_route_field(f, "task_id");
    agnosai_route_field(f, "description");
    agnosai_route_field(f, "domain");
    agnosai_route_field(f, "size");
    agnosai_route_field(f, "preset");
    agnosai_route_field(f, "callback_url");
    agnosai_route_field(f, "metadata");
    return f;
}

# Read an `A2ARequest`, or 0 when serde would reject it.
#
# `metadata` is `serde_json::Value` with `#[serde(default)]`, so **any** JSON
# shape is accepted there — object, array, scalar, null — and an absent one
# defaults to `Value::Null`. That is the one field with no type constraint, and
# it is why the size cap below exists.
fn agnosai_a2a_req_from_value(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    if (agnosai_route_no_unknown_fields(v, _agnosai_a2a_fields()) == 0) { return 0; }

    var tid = bayan_json_v_obj_get(v, "task_id");
    if (tid == 0 || bayan_json_v_is_str(tid) == 0) { return 0; }
    var d = bayan_json_v_obj_get(v, "description");
    if (d == 0 || bayan_json_v_is_str(d) == 0) { return 0; }

    var r = agnosai_a2a_req_new(bayan_json_v_str(tid), bayan_json_v_str(d));
    if (_agnosai_a2a_opt_str(v, "domain", r, AGN_A2A_DOMAIN) == 0) { return 0; }
    if (_agnosai_a2a_opt_str(v, "size", r, AGN_A2A_SIZE) == 0) { return 0; }
    if (_agnosai_a2a_opt_str(v, "preset", r, AGN_A2A_PRESET) == 0) { return 0; }
    if (_agnosai_a2a_opt_str(v, "callback_url", r, AGN_A2A_CALLBACK_URL) == 0) { return 0; }

    var md = bayan_json_v_obj_get(v, "metadata");
    if (md != 0) { store64(r + AGN_A2A_METADATA, md); }
    return r;
}

# Read an `Option<String>` field into `off`, or answer 0 when it is present and
# not a string. An absent field, or an explicit null, leaves the slot at 0.
fn _agnosai_a2a_opt_str(v, key, r, off): i64 {
    var f = bayan_json_v_obj_get(v, key);
    if (f == 0 || bayan_json_v_is_null(f) == 1) { return 1; }
    if (bayan_json_v_is_str(f) == 0) { return 0; }
    store64(r + off, bayan_json_v_str(f));
    return 1;
}

# Whether a callback URL may be posted to.
#
# `a2a.rs:16-18` delegates straight to the shared SSRF module, and so does this.
# A URL that fails is **logged and skipped**, never an error: the oracle's
# `else` branch warns and falls through, and the response is unaffected.
fn agnosai_route_a2a_callback_allowed(url: Str): i64 {
    return agnosai_is_safe_url(url);
}

# `POST /api/v1/a2a/receive` — accept a delegation, run it, answer with the
# result.
#
# Status contract: **400** with a `failed` body for an over-long field or
# oversized metadata; **500** with a `failed` body when the run fails; **200**
# with a `completed` body otherwise. Note the 400 and 500 arms still return the
# full `A2AResponse` shape rather than the routes tier's `{"error": ..}` — the
# oracle types this handler `(StatusCode, Json<A2AResponse>)`, so every arm
# carries `task_id`, `status`, `result` and `error`.
fn agnosai_route_a2a_receive(state, body: Str): i64 {
    var v = bayan_json_v_parse_buf(str_data(body), str_len(body));
    if (v == 0) {
        return agnosai_route_error(HTTP_BAD_REQUEST, str_from("malformed JSON body"));
    }
    var req = agnosai_a2a_req_from_value(v);
    if (req == 0) {
        return agnosai_route_error(AGNOSAI_HTTP_UNPROCESSABLE,
        str_from("body is not a valid A2A request"));
    }

    var tid = agnosai_a2a_req_task_id(req);
    if (str_len(tid) > AGNOSAI_A2A_MAX_STRING_LEN
    || str_len(agnosai_a2a_req_description(req)) > AGNOSAI_A2A_MAX_STRING_LEN) {
        return _agnosai_a2a_failed(HTTP_BAD_REQUEST, tid,
        str_from("field exceeds max length"));
    }

    # The oracle measures the metadata by **re-serializing it** and checking the
    # byte length (`serde_json::to_vec(&req.metadata)`), not by the request's
    # own size — so the cap is on the canonical form, and whitespace in the
    # incoming body does not count against it.
    var md = agnosai_a2a_req_metadata(req);
    if (md != 0) {
        if (str_len(bayan_json_v_build(md)) > AGNOSAI_A2A_MAX_METADATA_BYTES) {
            return _agnosai_a2a_failed(HTTP_BAD_REQUEST, tid,
            str_from("metadata exceeds 64 KiB limit"));
        }
    }

    # `format!("a2a-{}-{}", domain.unwrap_or("general"), task_id)`.
    var name = str_builder_new();
    str_builder_add_cstr(name, "a2a-");
    var dom = agnosai_a2a_req_domain(req);
    if (dom == 0) { str_builder_add_cstr(name, "general"); }
    if (dom != 0) { str_builder_add_str(name, dom); }
    str_builder_add_cstr(name, "-");
    str_builder_add_str(name, tid);

    # One task, and **an empty agent list** — the oracle builds `CrewSpec::new`
    # and sets only `tasks`, leaving `agents` at its default.
    var spec = agnosai_crew_new(str_builder_build(name));
    var tasks = vec_new();
    vec_push(tasks, agnosai_task_new(agnosai_a2a_req_description(req)));
    agnosai_crew_with_tasks(spec, tasks);

    var st = agnosai_orchestrator_run_crew(agnosai_app_state_orchestrator(state), spec);
    if (st == 0) {
        return _agnosai_a2a_failed(HTTP_INTERNAL, tid, str_from("crew execution failed"));
    }

    var arr = bayan_json_v_arr_new();
    var results = agnosai_crew_state_results(st);
    for (var i = 0; i < vec_len(results); i = i + 1) {
        var res = vec_get(results, i);
        var e = bayan_json_v_obj_new();
        bayan_json_v_obj_set(e, str_from("task_id"),
        bayan_json_v_str_new(agnosai_task_result_task_id(res)));
        bayan_json_v_obj_set(e, str_from("output"),
        bayan_json_v_str_new(agnosai_task_result_output(res)));
        bayan_json_v_arr_push(arr, e);
    }
    var result = bayan_json_v_obj_new();
    bayan_json_v_obj_set(result, str_from("tasks"), arr);

    # The SSRF gate runs here, on the response path, exactly where the oracle
    # runs it. Only the POST itself waits for the transport tier — see the
    # module header, docs/development/state.md and CHANGELOG [Unreleased].
    var cb = agnosai_a2a_req_callback_url(req);
    if (cb != 0) {
        if (agnosai_route_a2a_callback_allowed(cb) == 0) {
            _agnosai_a2a_warn("A2A callback URL rejected (SSRF protection)", 42, tid);
        }
    }

    var obj = bayan_json_v_obj_new();
    bayan_json_v_obj_set(obj, str_from("task_id"), bayan_json_v_str_new(tid));
    bayan_json_v_obj_set(obj, str_from("status"), bayan_json_v_str_new(str_from("completed")));
    bayan_json_v_obj_set(obj, str_from("result"), result);
    bayan_json_v_obj_set(obj, str_from("error"), bayan_json_v_null());
    return agnosai_route_json(HTTP_OK, obj);
}

# The oracle's failure `A2AResponse`: same four fields, `status: "failed"`,
# a null `result`, and the message in `error`.
fn _agnosai_a2a_failed(status, task_id: Str, message: Str): i64 {
    var obj = bayan_json_v_obj_new();
    bayan_json_v_obj_set(obj, str_from("task_id"), bayan_json_v_str_new(task_id));
    bayan_json_v_obj_set(obj, str_from("status"), bayan_json_v_str_new(str_from("failed")));
    bayan_json_v_obj_set(obj, str_from("result"), bayan_json_v_null());
    bayan_json_v_obj_set(obj, str_from("error"), bayan_json_v_str_new(message));
    return agnosai_route_json(status, obj);
}

fn _agnosai_a2a_warn(msg, msg_len, task_id: Str): i64 {
    if (sakshi_get_level() < SK_WARN) { return 0; }
    sakshi_log_kv(SK_WARN, msg, msg_len, "task_id", 7, str_data(task_id), str_len(task_id));
    return 0;
}

# `POST /api/v1/a2a/status` — a placeholder in the oracle, and a placeholder
# here. It takes no state and always answers the same body.
fn agnosai_route_a2a_status(): i64 {
    var obj = bayan_json_v_obj_new();
    bayan_json_v_obj_set(obj, str_from("status"),
    bayan_json_v_str_new(str_from("not_implemented")));
    return agnosai_route_json(HTTP_OK, obj);
}
