# =========================================================================
# server_prometheus — Prometheus-compatible metrics and text exposition.
#
# Parity oracle: rust-old/src/server/prometheus.rs
#
# Six counters behind `agnosai_metrics_gather`, which renders them in the
# Prometheus text exposition format the `/metrics` route serves.
#
# ## Atomics, not a mutex
#
# The oracle's counters are `AtomicU64` with `Ordering::Relaxed` — monotonic,
# no cross-thread barrier needed. The port uses `atomic_fetch_add` for the same
# reason rather than taking a lock: `orch_crew_runner`'s parallel and DAG modes
# record from real worker threads, and an uncontended `mutex_lock`/`unlock` pair
# costs ~394 ns here (see the filed cyrius issue) against a handful of
# nanoseconds for the atomic. The one non-additive operation, the active-crews
# decrement, is a CAS loop because Cyrius has no `fetch_update`.
#
# ## Cost is integer micro-USD end to end, and that is a fix
#
# The oracle stores micro-USD too — `AtomicU64`, `cost_usd * 1_000_000.0 as u64`
# — but its *entry point* takes an f64 USD and multiplies, and its `gather`
# divides back to f64 to format `{:.6}`. Two float conversions bracketing an
# integer store.
#
# This port takes micro-USD directly (`agnosai_metrics_record_inference` is the
# only signature change) and formats by splitting the integer, so the value that
# arrives is the value that is stored and the value that is printed. That is not
# a stylistic preference: hoosh 2.6.0 reports `usage.cost_micro_usd` as an
# integer and the port carries micro-USD everywhere, so an f64 round trip here
# would be the *only* place a cost could pick up representation error.
# =========================================================================

# Micro-USD per USD — the oracle's `MICRODOLLAR`, as an integer divisor.
var AGNOSAI_MICRO_PER_USD = 1000000;

# The process-wide metrics set `/metrics` serves.
#
# A singleton rather than an `AppState` field, matching the shape the oracle's
# `/metrics` handler has: `pub async fn metrics() -> String` takes no `State`,
# because `llm_metrics::gather()` reads a process-global registry. Keeping that
# shape means the route needs no state and the recording sites — which are deep
# inside the crew runner's worker threads — need nothing threaded down to them.
var _agnosai_metrics_singleton = 0;

# The process-wide metrics set, created on first use.
#
# **Not thread-safe to *create* concurrently**, and it does not need to be: the
# server builds its state at startup, before any worker thread exists, and
# `agnosai_metrics_gather` / the record verbs are called on it afterwards. Call
# this once during boot to make the initialization explicit rather than relying
# on whichever request arrives first — the same reason
# `agnosai_jwt_config_prepare` is a startup call.
fn agnosai_metrics_global(): i64 {
    if (_agnosai_metrics_singleton == 0) {
        _agnosai_metrics_singleton = agnosai_metrics_new();
    }
    return _agnosai_metrics_singleton;
}

enum AgnosaiMetricsOff {
    AGN_MT_CREWS_TOTAL = 0;
    AGN_MT_CREWS_ACTIVE = 8;
    AGN_MT_TASKS_COMPLETED = 16;
    AGN_MT_TASKS_FAILED = 24;
    AGN_MT_TOKENS_TOTAL = 32;
    AGN_MT_COST_MICRO_USD = 40;
    AGN_MT_SIZE = 48;
}

# Create a metrics set with every counter at zero — the oracle's `new`, which
# its `Default` also delegates to.
fn agnosai_metrics_new(): i64 {
    var m = alloc(AGN_MT_SIZE);
    for (var i = 0; i < AGN_MT_SIZE; i = i + 8) { store64(m + i, 0); }
    return m;
}

# Total crews created — monotonic.
fn agnosai_metrics_crews_total(m): i64 {
    return atomic_load(m + AGN_MT_CREWS_TOTAL);
}

# Crews currently running — a gauge, so it goes down as well as up.
fn agnosai_metrics_crews_active(m): i64 {
    return atomic_load(m + AGN_MT_CREWS_ACTIVE);
}

# Tasks that completed successfully.
fn agnosai_metrics_tasks_completed(m): i64 {
    return atomic_load(m + AGN_MT_TASKS_COMPLETED);
}

# Tasks that failed.
fn agnosai_metrics_tasks_failed(m): i64 {
    return atomic_load(m + AGN_MT_TASKS_FAILED);
}

# Total inference tokens processed.
fn agnosai_metrics_tokens_total(m): i64 {
    return atomic_load(m + AGN_MT_TOKENS_TOTAL);
}

# Total inference cost, in integer micro-USD.
#
# The oracle's accessor returns an f64 USD; this returns the stored integer.
# A caller wanting dollars divides by `AGNOSAI_MICRO_PER_USD` at the point of
# display — which is what `gather` does, without a float.
fn agnosai_metrics_cost_micro_usd(m): i64 {
    return atomic_load(m + AGN_MT_COST_MICRO_USD);
}

# Record a crew starting: the total counter and the active gauge both rise.
fn agnosai_metrics_record_crew_started(m): i64 {
    atomic_fetch_add(m + AGN_MT_CREWS_TOTAL, 1);
    atomic_fetch_add(m + AGN_MT_CREWS_ACTIVE, 1);
    return 0;
}

# Record a crew finishing, however it finished.
#
# **Saturating**: the gauge never goes below zero. The oracle uses
# `fetch_update` with `saturating_sub`; Cyrius has no fetch_update, so this is
# the equivalent CAS loop. A plain `fetch_add(-1)` would wrap to a huge value on
# an unbalanced call and the metric would be nonsense rather than merely wrong —
# the oracle guards this explicitly and its own test pins it.
fn agnosai_metrics_record_crew_completed(m): i64 {
    var slot = m + AGN_MT_CREWS_ACTIVE;
    while (1 == 1) {
        var cur = atomic_load(slot);
        if (cur == 0) { return 0; }
        if (atomic_cas(slot, cur, cur - 1) == 1) { return 0; }
    }
    return 0;
}

# Record a task that completed successfully.
fn agnosai_metrics_record_task_completed(m): i64 {
    atomic_fetch_add(m + AGN_MT_TASKS_COMPLETED, 1);
    return 0;
}

# Record a task that failed.
fn agnosai_metrics_record_task_failed(m): i64 {
    atomic_fetch_add(m + AGN_MT_TASKS_FAILED, 1);
    return 0;
}

# Record one inference: its token count and its cost in **micro-USD**.
#
# The oracle takes `cost_usd: f64` and truncates `cost_usd * 1e6` into the same
# integer slot. Taking micro directly removes that conversion — and it is what
# every caller already has, since `agnosai_execute_task` reads
# `usage.cost_micro_usd` straight off the hoosh response.
fn agnosai_metrics_record_inference(m, tokens, cost_micro_usd): i64 {
    atomic_fetch_add(m + AGN_MT_TOKENS_TOTAL, tokens);
    atomic_fetch_add(m + AGN_MT_COST_MICRO_USD, cost_micro_usd);
    return 0;
}

# Append `micro` micro-USD as a fixed-point dollar amount with exactly six
# decimal places — the oracle's `{:.6}`.
#
# Integer split, no f64: 25000 micro renders `0.025000`, and 1234567890 renders
# `1234.567890`. Formatting through a float would be the only place in the
# port's cost path where a value could pick up representation error.
fn _agnosai_metrics_add_usd(sb, micro): i64 {
    str_builder_add_int(sb, micro / AGNOSAI_MICRO_PER_USD);
    str_builder_putc(sb, 46);
    var frac = micro % AGNOSAI_MICRO_PER_USD;
    # Zero-pad the fraction to six digits.
    var scale = AGNOSAI_MICRO_PER_USD / 10;
    while (scale > 0) {
        str_builder_putc(sb, 48 + (frac / scale) % 10);
        scale = scale / 10;
    }
    return 0;
}

# Emit one metric family: HELP, TYPE, then the sample.
fn _agnosai_metrics_family(sb, name, help, kind): i64 {
    str_builder_add_cstr(sb, "# HELP ");
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, help);
    str_builder_add_cstr(sb, "\n# TYPE ");
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, kind);
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, " ");
    return 0;
}

# Render every metric in Prometheus text exposition format.
#
# Six families in the oracle's order, each `# HELP` / `# TYPE` / sample, every
# line newline-terminated including the last. The help strings and metric names
# are contractual — a scraper's dashboards key on them.
fn agnosai_metrics_gather(m): i64 {
    var sb = str_builder_new();

    _agnosai_metrics_family(sb, "agnosai_crews_total",
    "Total number of crews created.", "counter");
    str_builder_add_int(sb, agnosai_metrics_crews_total(m));
    str_builder_add_cstr(sb, "\n");

    _agnosai_metrics_family(sb, "agnosai_crews_active",
    "Number of currently active crews.", "gauge");
    str_builder_add_int(sb, agnosai_metrics_crews_active(m));
    str_builder_add_cstr(sb, "\n");

    _agnosai_metrics_family(sb, "agnosai_tasks_completed_total",
    "Total tasks completed successfully.", "counter");
    str_builder_add_int(sb, agnosai_metrics_tasks_completed(m));
    str_builder_add_cstr(sb, "\n");

    _agnosai_metrics_family(sb, "agnosai_tasks_failed_total",
    "Total tasks that failed.", "counter");
    str_builder_add_int(sb, agnosai_metrics_tasks_failed(m));
    str_builder_add_cstr(sb, "\n");

    _agnosai_metrics_family(sb, "agnosai_inference_tokens_total",
    "Total inference tokens processed.", "counter");
    str_builder_add_int(sb, agnosai_metrics_tokens_total(m));
    str_builder_add_cstr(sb, "\n");

    _agnosai_metrics_family(sb, "agnosai_inference_cost_usd_total",
    "Total inference cost in USD.", "counter");
    _agnosai_metrics_add_usd(sb, agnosai_metrics_cost_micro_usd(m));
    str_builder_add_cstr(sb, "\n");

    return str_builder_build(sb);
}
