# =========================================================================
# learning_strategy — UCB1 multi-armed bandit for strategy selection.
#
# Parity oracle: rust-old/src/learning/strategy.rs
#
# Port notes (divergences from the Rust shape, all deliberate):
#   * `Option<usize>` returns become **-1 for None**. Arm indices are never
#     negative, so the sentinel is unambiguous and keeps the hot selection path
#     allocation-free.
#   * Tie-breaking is held to Rust's iterator contract exactly, because it is
#     observable: `Iterator::max_by` returns the LAST of several equal maxima.
#     `_agnosai_ucb1_is_better` therefore takes the candidate whenever the
#     incumbent is not strictly greater — which also reproduces Rust's
#     `partial_cmp(..).unwrap_or(Ordering::Equal)` handling of NaN.
# =========================================================================

# ArmStats heap layout — 24 bytes.
enum AgnosaiArmStatsOff {
    AGN_ARM_NAME = 0;
    AGN_ARM_TOTAL_REWARD = 8;
    AGN_ARM_COUNT = 16;
    AGN_ARM_SIZE = 24;
}

# Returned in place of Rust's `None` by select / best_arm.
var AGNOSAI_UCB1_NO_ARM = 0 - 1;

# Allocate an unplayed arm.
fn _agnosai_arm_stats_new(name: Str): i64 {
    var a = alloc(AGN_ARM_SIZE);
    store64(a + AGN_ARM_NAME, name);
    store64(a + AGN_ARM_TOTAL_REWARD, f64_from(0));
    store64(a + AGN_ARM_COUNT, 0);
    return a;
}

# Whether `cand` should displace the incumbent `best` under Rust's `max_by`
# rule: displace unless the incumbent compares strictly Greater. Equal — and
# NaN, which Rust maps to Equal — displaces, so the LAST of several equal
# maxima wins, matching the oracle.
fn _agnosai_ucb1_is_better(cand, best): i64 {
    if (f64_gt(best, cand) == 1) { return 0; }
    return 1;
}

# Create a new UCB1 bandit over `arm_names`, a vec of Str. The bandit takes
# ownership of the names (Rust takes `Vec<String>` by value) — they are stored
# by reference, not cloned.
fn agnosai_ucb1_new(arm_names): i64 {
    var b = alloc(8);
    var arms = vec_new();
    var n = vec_len(arm_names);
    for (var i = 0; i < n; i = i + 1) {
        vec_push(arms, _agnosai_arm_stats_new(vec_get(arm_names, i)));
    }
    store64(b, arms);
    return b;
}

# Mean reward for an arm, as an f64 bit pattern. An unplayed arm means 0.0.
fn agnosai_arm_stats_mean_reward(a): i64 {
    var count = load64(a + AGN_ARM_COUNT);
    if (count == 0) { return f64_from(0); }
    return f64_div(load64(a + AGN_ARM_TOTAL_REWARD), f64_from(count));
}

# Human-readable name of an arm.
fn agnosai_arm_stats_name(a): i64 {
    return load64(a + AGN_ARM_NAME);
}

# Cumulative reward received from an arm, as an f64 bit pattern.
fn agnosai_arm_stats_total_reward(a): i64 {
    return load64(a + AGN_ARM_TOTAL_REWARD);
}

# Number of times an arm has been pulled.
fn agnosai_arm_stats_count(a): i64 {
    return load64(a + AGN_ARM_COUNT);
}

# Number of arms.
fn agnosai_ucb1_arm_count(b): i64 {
    return vec_len(load64(b));
}

# The ArmStats pointer at `idx`, or 0 when out of range.
fn agnosai_ucb1_arm(b, idx): i64 {
    var arms = load64(b);
    if (idx < 0) { return 0; }
    if (idx >= vec_len(arms)) { return 0; }
    return vec_get(arms, idx);
}

# Select the next arm using UCB1: mean + sqrt(2 * ln(N) / n).
# Arms that have never been pulled are selected first (lowest index).
# Returns AGNOSAI_UCB1_NO_ARM when there are no arms.
fn agnosai_ucb1_select(b, total_rounds): i64 {
    var arms = load64(b);
    var n = vec_len(arms);
    if (n == 0) { return AGNOSAI_UCB1_NO_ARM; }

    # Select any unexplored arm first.
    for (var i = 0; i < n; i = i + 1) {
        if (load64(vec_get(arms, i) + AGN_ARM_COUNT) == 0) { return i; }
    }

    if (total_rounds == 0) { return 0; }

    var ln_n = f64_ln(f64_from(total_rounds));
    var best_i = 0;
    var best = f64_from(0);
    for (var j = 0; j < n; j = j + 1) {
        var arm = vec_get(arms, j);
        var bonus = f64_sqrt(f64_div(f64_mul(F64_TWO, ln_n), f64_from(load64(arm + AGN_ARM_COUNT))));
        var ucb = f64_add(agnosai_arm_stats_mean_reward(arm), bonus);
        if (j == 0) {
            best = ucb;
        } elif (_agnosai_ucb1_is_better(ucb, best) == 1) {
            best = ucb;
            best_i = j;
        }
    }
    return best_i;
}

# Record a reward (an f64 bit pattern) for the given arm index.
# Out-of-range indices are ignored, matching Rust's `if let Some(..) = get_mut`.
fn agnosai_ucb1_update(b, idx, reward): i64 {
    var arm = agnosai_ucb1_arm(b, idx);
    if (arm == 0) { return 0; }
    store64(arm + AGN_ARM_TOTAL_REWARD, f64_add(load64(arm + AGN_ARM_TOTAL_REWARD), reward));
    store64(arm + AGN_ARM_COUNT, load64(arm + AGN_ARM_COUNT) + 1);
    return 0;
}

# The arm index with the highest mean reward.
# Returns AGNOSAI_UCB1_NO_ARM when there are no arms.
fn agnosai_ucb1_best_arm(b): i64 {
    var arms = load64(b);
    var n = vec_len(arms);
    if (n == 0) { return AGNOSAI_UCB1_NO_ARM; }

    var best_i = 0;
    var best = agnosai_arm_stats_mean_reward(vec_get(arms, 0));
    for (var i = 1; i < n; i = i + 1) {
        var mean = agnosai_arm_stats_mean_reward(vec_get(arms, i));
        if (_agnosai_ucb1_is_better(mean, best) == 1) {
            best = mean;
            best_i = i;
        }
    }
    return best_i;
}
