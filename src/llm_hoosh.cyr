# =========================================================================
# llm_hoosh — the hoosh seam client.
#
# No single oracle file. This replaces the `pub use hoosh::…` facade in
# rust-old/src/llm/mod.rs, which cannot survive the port: hoosh in Cyrius is a
# BINARY (no `dist/`, no `[lib]` stanza), so it is consumed as a **remote HTTP
# seam** rather than linked. The reference implementation is
# `thoth/src/hoosh.cyr`, and the ADR behind that shape is thoth's
# `docs/architecture/001-consumer-only-no-domain-logic.md`.
#
# What this module provides is the OpenAI-compatible chat-completions round
# trip plus the inference types the rest of agnosai consumes — `Message`,
# `Role`, `ProviderType`, `InferenceRequest`, `InferenceResponse`, and the
# client itself (`HooshClient`).
#
# Deliberately NOT here, because an HTTP seam has no client-side equivalent:
# AuditChain, ResponseCache, CostTracker, TokenBudget, DlpScanner,
# RateLimitRegistry and the metrics registry. hoosh implements those
# server-side. Every agnosai consumer of them is in orchestrator (M5) or
# server (M6) — see the header of src/llm.cyr for the measured reference counts
# and why that decision belongs to those milestones.
#
# Naming: LLM chat messages are `agnosai_chat_*`, NOT `agnosai_message_*` —
# the latter is core_message's inter-agent Message, and Cyrius has ONE flat
# namespace.
#
# Everything here is pure except `agnosai_hoosh_chat`, which is the one I/O
# call. That split is deliberate: it is what lets the builders and extractors
# be unit-tested with no gateway running.
# =========================================================================

# Message role in an OpenAI-compatible conversation.
#
# This is the LLM role, not fleet's consensus `Role` (Coordinator / Follower /
# Candidate) — the oracle has two unrelated enums by that name.
enum AgnosaiChatRole {
    AGNOSAI_ROLE_SYSTEM = 0;
    AGNOSAI_ROLE_USER = 1;
    AGNOSAI_ROLE_ASSISTANT = 2;
    AGNOSAI_ROLE_TOOL = 3;
}

# LLM provider. These are the seven variants agnosai actually references.
#
# NOTE: the wire spellings below are the conventional `rename_all = "snake_case"`
# forms, but agnosai never puts a ProviderType on any wire it controls — the
# gateway is addressed by model string, and hoosh owns the provider mapping. If
# a caller ever needs these to match hoosh byte-for-byte, verify against hoosh
# rather than trusting this comment.
enum AgnosaiProviderType {
    AGNOSAI_PROVIDER_OPENAI = 0;
    AGNOSAI_PROVIDER_ANTHROPIC = 1;
    AGNOSAI_PROVIDER_GOOGLE = 2;
    AGNOSAI_PROVIDER_MISTRAL = 3;
    AGNOSAI_PROVIDER_DEEPSEEK = 4;
    AGNOSAI_PROVIDER_GROK = 5;
    AGNOSAI_PROVIDER_OLLAMA = 6;
}

# ChatMessage heap layout — 16 bytes.
enum AgnosaiChatMessageOff {
    AGN_CHAT_ROLE = 0;
    AGN_CHAT_CONTENT = 8;
    AGN_CHAT_SIZE = 16;
}

# InferenceRequest heap layout — 40 bytes.
enum AgnosaiInferenceReqOff {
    AGN_REQ_MODEL = 0;
    AGN_REQ_MESSAGES = 8;
    AGN_REQ_MAX_TOKENS = 16;
    AGN_REQ_TEMPERATURE_MILLI = 24;
    AGN_REQ_STREAM = 32;
    AGN_INFER_REQ_SIZE = 40;
}

# InferenceResponse heap layout — 40 bytes.
enum AgnosaiInferenceRespOff {
    AGN_RESP_CONTENT = 0;
    AGN_RESP_MODEL = 8;
    AGN_RESP_PROMPT_TOKENS = 16;
    AGN_RESP_COMPLETION_TOKENS = 24;
    AGN_RESP_FINISH_REASON = 32;
    AGN_RESP_COST_MICRO_USD = 40;
    AGN_RESP_PROVIDER = 48;
    AGN_RESP_CACHE = 56;
    AGN_RESP_SIZE = 64;
}

# The default gateway base URL — a local `hoosh serve 8088`.
fn agnosai_hoosh_default_url(): i64 {
    return str_from("http://127.0.0.1:8088");
}

# The OpenAI-compatible chat-completions path.
fn agnosai_hoosh_chat_path(): i64 {
    return str_from("/v1/chat/completions");
}

# The OpenAI-compatible model-list path.
fn agnosai_hoosh_models_path(): i64 {
    return str_from("/v1/models");
}

# Join a gateway base URL and a path, trimming exactly one trailing '/' from the
# base — the same convention thoth's `_hoosh_endpoint_url` uses, so a base
# configured with or without a trailing slash yields the same endpoint.
fn agnosai_hoosh_join_url(base: Str, path: Str): i64 {
    var blen = str_len(base);
    if (blen > 0) {
        if (load8(str_data(base) + blen - 1) == 47) { blen = blen - 1; }
    }
    var sb = str_builder_new();
    str_builder_add(sb, str_new(str_data(base), blen));
    str_builder_add(sb, path);
    return str_builder_build(sb);
}

# The chat-completions endpoint for a gateway base URL.
fn agnosai_hoosh_endpoint(base: Str): i64 {
    return agnosai_hoosh_join_url(base, agnosai_hoosh_chat_path());
}

# The model-list endpoint for a gateway base URL.
fn agnosai_hoosh_models_endpoint(base: Str): i64 {
    return agnosai_hoosh_join_url(base, agnosai_hoosh_models_path());
}

# The wire spelling of a chat role.
fn agnosai_chat_role_to_wire(role): i64 {
    if (role == AGNOSAI_ROLE_SYSTEM) { return str_from("system"); }
    if (role == AGNOSAI_ROLE_ASSISTANT) { return str_from("assistant"); }
    if (role == AGNOSAI_ROLE_TOOL) { return str_from("tool"); }
    return str_from("user");
}

# A chat role from its wire spelling. Unknown spellings read as User.
fn agnosai_chat_role_from_wire(s: Str): i64 {
    if (str_eq(s, str_from("system")) == 1) { return AGNOSAI_ROLE_SYSTEM; }
    if (str_eq(s, str_from("assistant")) == 1) { return AGNOSAI_ROLE_ASSISTANT; }
    if (str_eq(s, str_from("tool")) == 1) { return AGNOSAI_ROLE_TOOL; }
    return AGNOSAI_ROLE_USER;
}

# The snake_case spelling of a provider. See the enum's note on wire fidelity.
fn agnosai_provider_to_wire(provider): i64 {
    if (provider == AGNOSAI_PROVIDER_ANTHROPIC) { return str_from("anthropic"); }
    if (provider == AGNOSAI_PROVIDER_GOOGLE) { return str_from("google"); }
    if (provider == AGNOSAI_PROVIDER_MISTRAL) { return str_from("mistral"); }
    if (provider == AGNOSAI_PROVIDER_DEEPSEEK) { return str_from("deep_seek"); }
    if (provider == AGNOSAI_PROVIDER_GROK) { return str_from("grok"); }
    if (provider == AGNOSAI_PROVIDER_OLLAMA) { return str_from("ollama"); }
    return str_from("open_ai");
}

# A provider from its spelling. Unknown spellings read as OpenAi.
fn agnosai_provider_from_wire(s: Str): i64 {
    if (str_eq(s, str_from("anthropic")) == 1) { return AGNOSAI_PROVIDER_ANTHROPIC; }
    if (str_eq(s, str_from("google")) == 1) { return AGNOSAI_PROVIDER_GOOGLE; }
    if (str_eq(s, str_from("mistral")) == 1) { return AGNOSAI_PROVIDER_MISTRAL; }
    if (str_eq(s, str_from("deep_seek")) == 1) { return AGNOSAI_PROVIDER_DEEPSEEK; }
    if (str_eq(s, str_from("grok")) == 1) { return AGNOSAI_PROVIDER_GROK; }
    if (str_eq(s, str_from("ollama")) == 1) { return AGNOSAI_PROVIDER_OLLAMA; }
    return AGNOSAI_PROVIDER_OPENAI;
}

# Create a chat message.
fn agnosai_chat_message_new(role, content: Str): i64 {
    var m = alloc(AGN_CHAT_SIZE);
    store64(m + AGN_CHAT_ROLE, role);
    store64(m + AGN_CHAT_CONTENT, content);
    return m;
}

# The message's role.
fn agnosai_chat_message_role(m): i64 {
    return load64(m + AGN_CHAT_ROLE);
}

# The message's content.
fn agnosai_chat_message_content(m): i64 {
    return load64(m + AGN_CHAT_CONTENT);
}

# A chat message as a bayan JSON value: `{"role":"user","content":"..."}`.
fn agnosai_chat_message_to_value(m): i64 {
    var obj = bayan_json_v_obj_new();
    bayan_json_v_obj_set(obj, str_from("role"),
    bayan_json_v_str_new(agnosai_chat_role_to_wire(load64(m + AGN_CHAT_ROLE))));
    bayan_json_v_obj_set(obj, str_from("content"), bayan_json_v_str_new(load64(m + AGN_CHAT_CONTENT)));
    return obj;
}

# Create an inference request for a model. `max_tokens` and `temperature` start
# unset; streaming starts off.
fn agnosai_inference_request_new(model: Str): i64 {
    var r = alloc(AGN_INFER_REQ_SIZE);
    store64(r + AGN_REQ_MODEL, model);
    store64(r + AGN_REQ_MESSAGES, vec_new());
    store64(r + AGN_REQ_MAX_TOKENS, AGNOSAI_NO_LIMIT);
    store64(r + AGN_REQ_TEMPERATURE_MILLI, AGNOSAI_NO_LIMIT);
    store64(r + AGN_REQ_STREAM, 0);
    return r;
}

# Append a message. Returns the request so calls chain.
fn agnosai_inference_request_with_message(r, m): i64 {
    vec_push(load64(r + AGN_REQ_MESSAGES), m);
    return r;
}

# Append a message built from a role and content. Returns the request.
fn agnosai_inference_request_say(r, role, content: Str): i64 {
    vec_push(load64(r + AGN_REQ_MESSAGES), agnosai_chat_message_new(role, content));
    return r;
}

# Set the completion token ceiling. Returns the request.
fn agnosai_inference_request_with_max_tokens(r, max_tokens): i64 {
    store64(r + AGN_REQ_MAX_TOKENS, max_tokens);
    return r;
}

# Set the sampling temperature, in **thousandths** — 700 is 0.7. Integer
# milli-units for the same reason money is micro-USD: exact, and it leaves
# AGNOSAI_NO_LIMIT free to mean "unset" without colliding with a real 0.0.
# Returns the request.
fn agnosai_inference_request_with_temperature_milli(r, temperature_milli): i64 {
    store64(r + AGN_REQ_TEMPERATURE_MILLI, temperature_milli);
    return r;
}

# Turn streaming on (1) or off (0). Returns the request.
fn agnosai_inference_request_with_stream(r, stream): i64 {
    store64(r + AGN_REQ_STREAM, stream);
    return r;
}

# The model identifier the request targets.
fn agnosai_inference_request_model(r): i64 {
    return load64(r + AGN_REQ_MODEL);
}

# Vec of the request's messages.
fn agnosai_inference_request_messages(r): i64 {
    return load64(r + AGN_REQ_MESSAGES);
}

# The completion token ceiling, or AGNOSAI_NO_LIMIT.
fn agnosai_inference_request_max_tokens(r): i64 {
    return load64(r + AGN_REQ_MAX_TOKENS);
}

# The sampling temperature in thousandths, or AGNOSAI_NO_LIMIT.
fn agnosai_inference_request_temperature_milli(r): i64 {
    return load64(r + AGN_REQ_TEMPERATURE_MILLI);
}

# Whether the request asks for a streamed response.
fn agnosai_inference_request_stream(r): i64 {
    return load64(r + AGN_REQ_STREAM);
}

# The request as a bayan JSON value — the OpenAI-compatible chat-completions
# body. Unset optional fields are **omitted**, not sent as null: a gateway
# reading `"max_tokens": null` may reject it, and omission is what every
# OpenAI-compatible client does.
#
# When streaming, `stream_options.include_usage` is set so the gateway appends a
# final usage frame — without it a streamed turn carries no token count at all.
fn agnosai_inference_request_to_value(r): i64 {
    var obj = bayan_json_v_obj_new();
    bayan_json_v_obj_set(obj, str_from("model"), bayan_json_v_str_new(load64(r + AGN_REQ_MODEL)));

    var msgs = load64(r + AGN_REQ_MESSAGES);
    var arr = bayan_json_v_arr_new();
    for (var i = 0; i < vec_len(msgs); i = i + 1) {
        bayan_json_v_arr_push(arr, agnosai_chat_message_to_value(vec_get(msgs, i)));
    }
    bayan_json_v_obj_set(obj, str_from("messages"), arr);

    var max_tokens = load64(r + AGN_REQ_MAX_TOKENS);
    if (max_tokens != AGNOSAI_NO_LIMIT) {
        bayan_json_v_obj_set(obj, str_from("max_tokens"), bayan_json_v_int_new(max_tokens));
    }

    var temp = load64(r + AGN_REQ_TEMPERATURE_MILLI);
    if (temp != AGNOSAI_NO_LIMIT) {
        var tv = f64_div(f64_from(temp), f64_from(1000));
        bayan_json_v_obj_set(obj, str_from("temperature"), bayan_json_v_float_new(tv));
    }

    var stream = load64(r + AGN_REQ_STREAM);
    if (stream == 1) {
        bayan_json_v_obj_set(obj, str_from("stream"), bayan_json_v_bool_new(1));
        var opts = bayan_json_v_obj_new();
        bayan_json_v_obj_set(opts, str_from("include_usage"), bayan_json_v_bool_new(1));
        bayan_json_v_obj_set(obj, str_from("stream_options"), opts);
    } else {
        bayan_json_v_obj_set(obj, str_from("stream"), bayan_json_v_bool_new(0));
    }
    return obj;
}

# The request serialized to the JSON body to POST.
fn agnosai_inference_request_to_json(r): i64 {
    return bayan_json_v_build(agnosai_inference_request_to_value(r));
}

# Create an inference response.
fn agnosai_inference_response_new(content: Str, model: Str): i64 {
    var r = alloc(AGN_RESP_SIZE);
    store64(r + AGN_RESP_CONTENT, content);
    store64(r + AGN_RESP_MODEL, model);
    store64(r + AGN_RESP_PROMPT_TOKENS, 0);
    store64(r + AGN_RESP_COMPLETION_TOKENS, 0);
    store64(r + AGN_RESP_FINISH_REASON, 0);
    store64(r + AGN_RESP_COST_MICRO_USD, AGNOSAI_NO_LIMIT);
    store64(r + AGN_RESP_PROVIDER, 0);
    store64(r + AGN_RESP_CACHE, AGNOSAI_HOOSH_CACHE_UNKNOWN);
    return r;
}

# The assistant's reply text.
fn agnosai_inference_response_content(r): i64 {
    return load64(r + AGN_RESP_CONTENT);
}

# The model that produced the reply.
fn agnosai_inference_response_model(r): i64 {
    return load64(r + AGN_RESP_MODEL);
}

# Prompt tokens consumed.
fn agnosai_inference_response_prompt_tokens(r): i64 {
    return load64(r + AGN_RESP_PROMPT_TOKENS);
}

# Completion tokens produced.
fn agnosai_inference_response_completion_tokens(r): i64 {
    return load64(r + AGN_RESP_COMPLETION_TOKENS);
}

# Total tokens for the turn.
fn agnosai_inference_response_total_tokens(r): i64 {
    return load64(r + AGN_RESP_PROMPT_TOKENS) + load64(r + AGN_RESP_COMPLETION_TOKENS);
}

# Why generation stopped ("stop", "length", ...), or 0 when absent.
fn agnosai_inference_response_finish_reason(r): i64 {
    return load64(r + AGN_RESP_FINISH_REASON);
}

# `choices[0]` of a parsed response body, or 0 when the shape does not match.
fn _agnosai_hoosh_first_choice(v): i64 {
    if (v == 0) { return 0; }
    var choices = bayan_json_v_obj_get(v, "choices");
    if (choices == 0) { return 0; }
    if (bayan_json_v_is_arr(choices) == 0) { return 0; }
    if (bayan_json_v_arr_len(choices) == 0) { return 0; }
    return bayan_json_v_arr_get(choices, 0);
}

# Parse a response body. Returns the bayan value tree, or 0 on a parse error.
#
# Calls `bayan_json_v_parse_buf` rather than the bare entry for the reason
# documented in core_message.cyr — switch at the bayan 1.3.0 fold-in.
fn agnosai_hoosh_parse_body(body: Str): i64 {
    return bayan_json_v_parse_buf(str_data(body), str_len(body));
}

# Pull `choices[0].message.content` out of a non-streaming response body, or 0
# when absent or malformed.
fn agnosai_hoosh_extract_content(body: Str): i64 {
    var first = _agnosai_hoosh_first_choice(agnosai_hoosh_parse_body(body));
    if (first == 0) { return 0; }
    var msg = bayan_json_v_obj_get(first, "message");
    if (msg == 0) { return 0; }
    var content = bayan_json_v_obj_get(msg, "content");
    if (content == 0) { return 0; }
    if (bayan_json_v_is_str(content) == 0) { return 0; }
    return bayan_json_v_str(content);
}

# Pull `choices[0].delta.content` out of ONE SSE frame's JSON, or 0 when absent
# — which is the normal case for the role-only opening delta and the finish
# frame, not an error.
fn agnosai_hoosh_extract_delta(body: Str): i64 {
    var first = _agnosai_hoosh_first_choice(agnosai_hoosh_parse_body(body));
    if (first == 0) { return 0; }
    var delta = bayan_json_v_obj_get(first, "delta");
    if (delta == 0) { return 0; }
    var content = bayan_json_v_obj_get(delta, "content");
    if (content == 0) { return 0; }
    if (bayan_json_v_is_str(content) == 0) { return 0; }
    return bayan_json_v_str(content);
}

# Pull `choices[0].finish_reason`, or 0 when absent or null.
fn agnosai_hoosh_extract_finish_reason(body: Str): i64 {
    var first = _agnosai_hoosh_first_choice(agnosai_hoosh_parse_body(body));
    if (first == 0) { return 0; }
    var fr = bayan_json_v_obj_get(first, "finish_reason");
    if (fr == 0) { return 0; }
    if (bayan_json_v_is_str(fr) == 0) { return 0; }
    return bayan_json_v_str(fr);
}

# Pull `error.message` out of an error body, or 0 when not present.
fn agnosai_hoosh_extract_error(body: Str): i64 {
    var v = agnosai_hoosh_parse_body(body);
    if (v == 0) { return 0; }
    var err = bayan_json_v_obj_get(v, "error");
    if (err == 0) { return 0; }
    var m = bayan_json_v_obj_get(err, "message");
    if (m == 0) { return 0; }
    if (bayan_json_v_is_str(m) == 0) { return 0; }
    return bayan_json_v_str(m);
}

# Pull the `model` field of a response body, or 0 when absent.
fn agnosai_hoosh_extract_model(body: Str): i64 {
    var v = agnosai_hoosh_parse_body(body);
    if (v == 0) { return 0; }
    var m = bayan_json_v_obj_get(v, "model");
    if (m == 0) { return 0; }
    if (bayan_json_v_is_str(m) == 0) { return 0; }
    return bayan_json_v_str(m);
}

# What the gateway said about its response cache — hoosh 2.6.0's `X-Hoosh-Cache`.
#
# UNKNOWN means the header was absent, which is what a pre-2.6.0 gateway sends.
# It is deliberately distinct from MISS: "this was a real inference" and "this
# gateway cannot tell me" are different facts, and only the first justifies
# billing the call.
var AGNOSAI_HOOSH_CACHE_UNKNOWN = 0;
var AGNOSAI_HOOSH_CACHE_MISS = 1;
var AGNOSAI_HOOSH_CACHE_HIT = 2;
var AGNOSAI_HOOSH_CACHE_SEMANTIC = 3;

# Map an `X-Hoosh-Cache` value to its constant. Unrecognised values — including
# anything a future hoosh adds — read as UNKNOWN rather than as a MISS, so a new
# cache tier can never be mistaken for a billable inference.
fn agnosai_hoosh_cache_from_header(v: Str): i64 {
    if (str_eq(v, str_from("HIT")) == 1) { return AGNOSAI_HOOSH_CACHE_HIT; }
    if (str_eq(v, str_from("SEMANTIC")) == 1) { return AGNOSAI_HOOSH_CACHE_SEMANTIC; }
    if (str_eq(v, str_from("MISS")) == 1) { return AGNOSAI_HOOSH_CACHE_MISS; }
    return AGNOSAI_HOOSH_CACHE_UNKNOWN;
}

# The response's cost in integer micro-USD, or `AGNOSAI_NO_LIMIT` when the
# gateway did not report one.
#
# **0 is a real cost**, not an absence — a local model served through Ollama is
# genuinely free — so the absent sentinel has to be -1. A caller that treats 0
# as "unknown" under-reports every local inference.
fn agnosai_inference_response_cost_micro_usd(r): i64 {
    return load64(r + AGN_RESP_COST_MICRO_USD);
}

# The provider that actually served the response, or 0 when unreported.
#
# This is the **serving route**, not a guess from the model name — the two
# differ whenever hoosh's DLP re-routes a confidential request to a local
# provider, in which case hoosh bills nothing and a name-based guess would
# price it as remote.
fn agnosai_inference_response_provider(r): i64 {
    return load64(r + AGN_RESP_PROVIDER);
}

# Whether the response came from hoosh's cache — one of the
# `AGNOSAI_HOOSH_CACHE_*` constants.
fn agnosai_inference_response_cache(r): i64 {
    return load64(r + AGN_RESP_CACHE);
}

# Pull `usage.cost_micro_usd` / `usage.provider` into the out-params — hoosh
# 2.6.0. Returns 1 when a cost was reported, 0 otherwise.
#
# Both fields are absent on a pre-2.6.0 gateway, which is not an error: the
# caller then simply has no cost to report, which is more honest than
# re-deriving one from a copy of hoosh's pricing table that would drift.
fn agnosai_hoosh_extract_cost(body: Str, out_cost, out_provider): i64 {
    store64(out_cost, AGNOSAI_NO_LIMIT);
    store64(out_provider, 0);

    var v = agnosai_hoosh_parse_body(body);
    if (v == 0) { return 0; }
    var usage = bayan_json_v_obj_get(v, "usage");
    if (usage == 0) { return 0; }
    if (bayan_json_v_is_obj(usage) == 0) { return 0; }

    var prov = bayan_json_v_obj_get(usage, "provider");
    if (prov != 0 && bayan_json_v_is_str(prov) == 1) {
        store64(out_provider, bayan_json_v_str(prov));
    }

    var cost = bayan_json_v_obj_get(usage, "cost_micro_usd");
    if (cost == 0) { return 0; }
    if (bayan_json_v_is_int(cost) == 0) { return 0; }
    store64(out_cost, bayan_json_v_int(cost));
    return 1;
}

# Pull `usage.prompt_tokens` / `usage.completion_tokens` into the out-params.
# Returns 1 when a usage block was present, 0 otherwise — a streamed turn
# without `stream_options.include_usage` has none.
fn agnosai_hoosh_extract_usage(body: Str, out_prompt, out_completion): i64 {
    var v = agnosai_hoosh_parse_body(body);
    if (v == 0) { return 0; }
    var usage = bayan_json_v_obj_get(v, "usage");
    if (usage == 0) { return 0; }
    if (bayan_json_v_is_obj(usage) == 0) { return 0; }
    store64(out_prompt, _agnosai_int_field(usage, "prompt_tokens", 0));
    store64(out_completion, _agnosai_int_field(usage, "completion_tokens", 0));
    return 1;
}

# The `data` array of an OpenAI `/v1/models` body, or 0 when the shape does not
# match. The caller walks it with `bayan_json_v_arr_*`.
fn agnosai_hoosh_extract_models(body: Str): i64 {
    var v = agnosai_hoosh_parse_body(body);
    if (v == 0) { return 0; }
    var data = bayan_json_v_obj_get(v, "data");
    if (data == 0) { return 0; }
    if (bayan_json_v_is_arr(data) == 0) { return 0; }
    return data;
}

# Build a full InferenceResponse from a non-streaming body, or 0 when the body
# carries no content.
fn agnosai_hoosh_response_from_body(body: Str): i64 {
    var content = agnosai_hoosh_extract_content(body);
    if (content == 0) { return 0; }

    var model = agnosai_hoosh_extract_model(body);
    if (model == 0) { model = str_from(""); }

    var resp = agnosai_inference_response_new(content, model);
    store64(resp + AGN_RESP_FINISH_REASON, agnosai_hoosh_extract_finish_reason(body));

    var prompt: i64[1];
    var completion: i64[1];
    store64(&prompt, 0);
    store64(&completion, 0);
    if (agnosai_hoosh_extract_usage(body, &prompt, &completion) == 1) {
        store64(resp + AGN_RESP_PROMPT_TOKENS, load64(&prompt));
        store64(resp + AGN_RESP_COMPLETION_TOKENS, load64(&completion));
    }

    var cost: i64[1];
    var provider: i64[1];
    store64(&cost, AGNOSAI_NO_LIMIT);
    store64(&provider, 0);
    agnosai_hoosh_extract_cost(body, &cost, &provider);
    store64(resp + AGN_RESP_COST_MICRO_USD, load64(&cost));
    store64(resp + AGN_RESP_PROVIDER, load64(&provider));
    return resp;
}

# The payload of one SSE `data:` line, or 0 when the line is not a data line.
#
# Handles both `data:{...}` and `data: {...}` (one optional space, per the SSE
# spec's field-value parsing). The terminal `data: [DONE]` sentinel returns 0 —
# it is a control marker, not a frame to parse.
fn agnosai_hoosh_sse_data(line: Str): i64 {
    var len = str_len(line);
    if (len < 5) { return 0; }
    var d = str_data(line);
    if (memeq(d, "data:", 5) == 0) { return 0; }

    var start = 5;
    if (start < len) {
        if (load8(d + start) == 32) { start = start + 1; }
    }
    if (start >= len) { return 0; }

    var payload = str_new(d + start, len - start);
    if (str_eq(payload, str_from("[DONE]")) == 1) { return 0; }
    return payload;
}

# Whether an SSE line is the terminal `data: [DONE]` sentinel.
fn agnosai_hoosh_sse_is_done(line: Str): i64 {
    var len = str_len(line);
    if (len < 5) { return 0; }
    var d = str_data(line);
    if (memeq(d, "data:", 5) == 0) { return 0; }
    var start = 5;
    if (start < len) {
        if (load8(d + start) == 32) { start = start + 1; }
    }
    return str_eq(str_new(d + start, len - start), str_from("[DONE]"));
}

# The request headers for a chat-completions POST, as a **sandhi headers
# object** — `sandhi_http_post` takes the structured form from
# `sandhi_headers_new`, not a raw CRLF string. Handing it a string makes sandhi
# dereference text as a struct, which segfaults rather than erroring.
#
# `api_key` may be 0, which is the usual case: the gateway holds the provider
# credentials and agnosai never sees them.
fn agnosai_hoosh_headers(api_key: Str): i64 {
    var h = sandhi_headers_new();
    sandhi_headers_set(h, "Content-Type", "application/json");
    if (api_key != 0) {
        if (str_len(api_key) > 0) {
            var sb = str_builder_new();
            str_builder_add_cstr(sb, "Bearer ");
            str_builder_add(sb, api_key);
            sandhi_headers_set(h, "Authorization", str_cstr(str_builder_build(sb)));
        }
    }
    return h;
}

# POST a chat-completions request to the gateway. **The one I/O call here.**
#
# Returns 0 on success, having written the InferenceResponse to `out_response`.
# On failure returns an error-message Str — the same contract llm_retry's driver
# expects, so `agnosai_with_retry` wraps this directly.
#
# Error text deliberately includes the HTTP status and the gateway's own
# `error.message` where present, because `agnosai_is_retryable` classifies on
# that text: a bare "request failed" would make a 503 look non-retryable.
fn agnosai_hoosh_chat(base_url: Str, api_key: Str, request, out_response): i64 {
    var url = agnosai_hoosh_endpoint(base_url);
    var headers = agnosai_hoosh_headers(api_key);
    var body = agnosai_inference_request_to_json(request);

    var r = sandhi_http_post(str_cstr(url), headers, str_data(body), str_len(body));
    if (r == 0) { return str_from("hoosh transport error: no response allocated"); }
    var kind = sandhi_http_err_kind(r);
    if (kind != SANDHI_OK) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "hoosh transport error: ");
        str_builder_add_cstr(sb, sandhi_err_kind_name(kind));
        str_builder_add_cstr(sb, " (");
        str_builder_add(sb, url);
        str_builder_add_cstr(sb, ")");
        return str_builder_build(sb);
    }

    var status = sandhi_http_status(r);
    var resp_body = str_new(sandhi_http_body(r), sandhi_http_body_len(r));

    if (status < 200 || status >= 300) {
        var esb = str_builder_new();
        str_builder_add_cstr(esb, "hoosh returned HTTP ");
        str_builder_add_int(esb, status);
        var detail = agnosai_hoosh_extract_error(resp_body);
        if (detail != 0) {
            str_builder_add_cstr(esb, ": ");
            str_builder_add(esb, detail);
        }
        return str_builder_build(esb);
    }

    var parsed = agnosai_hoosh_response_from_body(resp_body);
    if (parsed == 0) {
        return str_from("hoosh returned a body with no choices[0].message.content");
    }

    # hoosh 2.6.0's cache signal. A HIT replays the cached body verbatim, cost
    # included — that is what the ORIGINAL inference cost, not this request — so
    # the header, not the body, is what a caller bills on.
    var cache_hdr = sandhi_headers_get(sandhi_http_headers(r), "X-Hoosh-Cache");
    if (cache_hdr != 0) {
        store64(parsed + AGN_RESP_CACHE, agnosai_hoosh_cache_from_header(str_from(cache_hdr)));
    }

    store64(out_response, parsed);
    return 0;
}

# A configured hoosh endpoint — base URL plus optional API key.
#
# The oracle's `execute_task` takes `Option<&Arc<HooshClient>>`, where `None`
# selects the placeholder path, so the port needs something for 0 to be the
# absence of. This is the minimum that shape requires: hoosh's own client is a
# provider registry, a cache and a cost tracker, all of which live on the far
# side of the HTTP seam here.
enum AgnosaiHooshClientOff {
    AGN_HC_BASE_URL = 0;
    AGN_HC_API_KEY = 8;
    AGN_HC_SIZE = 16;
}

# Create a client over a base URL and an API key. Pass `str_from("")` for the
# key when the gateway is unauthenticated.
fn agnosai_hoosh_client_new(base_url: Str, api_key: Str): i64 {
    var c = alloc(AGN_HC_SIZE);
    store64(c + AGN_HC_BASE_URL, base_url);
    store64(c + AGN_HC_API_KEY, api_key);
    return c;
}

# The client's gateway base URL.
fn agnosai_hoosh_client_base_url(c): i64 {
    return load64(c + AGN_HC_BASE_URL);
}

# The client's API key.
fn agnosai_hoosh_client_api_key(c): i64 {
    return load64(c + AGN_HC_API_KEY);
}
