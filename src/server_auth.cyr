# =========================================================================
# server_auth — Bearer-token authentication: config, extraction, shared secret.
#
# Parity oracle: rust-old/src/server/auth.rs
#
# **This is bite 1 of 2.** It ports the config types, the `Bearer ` extraction
# and the shared-secret comparison — the five oracle tests that need no crypto
# and no fixtures. The RS256 JWT half (`validate_jwt`, `Claims`) lands next; the
# `jwt` branch of `agnosai_auth_check` is a loud 500 until then, never a silent
# pass. See docs/development/state.md, "Four decisions waiting on the
# maintainer", before writing that half — the `iss`/`aud`/`exp`/leeway semantics
# are all deliberate calls, not transcription.
#
# ## The comparison is genuinely constant time, and the oracle's is not
#
# The oracle's `constant_time_eq` (auth.rs:18-31) bounds its loop with
# `a.len().max(b.len())` while its own doc comment at auth.rs:16-17 claims
# "no early return on length mismatch that would leak secret length". The
# content compare is constant time; the **loop bound is not**. An attacker
# controls the token length, so sending a 1-byte token makes the loop run
# `secret.len()` times — the secret's length is recoverable by timing, which is
# exactly what the comment promises it is not.
#
# `ct_eq_bytes_lens` is not the fix either: it returns 0 *immediately* on a
# length mismatch (`lib/ct.cyr:76`), which leaks the same fact through a much
# sharper signal.
#
# So this port hashes both sides and compares the digests:
# `sha256` is fixed-output, so the compare runs over exactly 32 bytes no matter
# what either input's length is, and `ct_eq_bytes` over those 32 bytes is
# constant time in the content.
#
# **This is not a wire divergence.** The accept/reject set is byte-identical to
# the oracle's — `sha256(a) == sha256(b)` iff `a == b` for any input an attacker
# can construct — so every oracle assertion holds unchanged. Only the timing
# profile differs, and only by removing a leak. Recorded as
# [ADR 009](../docs/adr/009-auth-constant-time-secret-compare.md).
#
# ## `to_str()` is a real gate, not a formality
#
# The oracle reads the header through `.and_then(|v| v.to_str().ok())`, so a
# header carrying any byte outside visible ASCII is `None` and takes the
# missing-header arm — a 401, not a comparison. Dropping that gate would let a
# byte sequence that `http` refuses to expose as a `&str` reach the compare.
# =========================================================================

# --- AuthConfig ----------------------------------------------------------

enum AgnosaiAuthConfigOff {
    AGN_AC_ENABLED = 0;
    AGN_AC_SECRET = 8;
    AGN_AC_JWT = 16;
    AGN_AUTH_CFG_SIZE = 24;
}

# The oracle's `#[derive(Default)] AuthConfig` — **disabled**, empty secret, no
# JWT. Worth naming plainly: the default is fail-**open**, so a caller that
# forgets to configure auth serves every route unauthenticated. That is the
# oracle's behaviour and the port reproduces it; the place to change it, if it
# is ever changed, is here and with an ADR.
fn agnosai_auth_config_new(): i64 {
    var c = alloc(AGN_AUTH_CFG_SIZE);
    store64(c + AGN_AC_ENABLED, 0);
    store64(c + AGN_AC_SECRET, str_from(""));
    store64(c + AGN_AC_JWT, 0);
    return c;
}

# The oracle's `AuthConfig::with_secret` — enabled, shared-secret mode.
fn agnosai_auth_config_with_secret(sec: Str): i64 {
    var c = alloc(AGN_AUTH_CFG_SIZE);
    store64(c + AGN_AC_ENABLED, 1);
    store64(c + AGN_AC_SECRET, sec);
    store64(c + AGN_AC_JWT, 0);
    return c;
}

# The oracle's `AuthConfig::with_jwt` — enabled, RS256 mode, empty secret.
fn agnosai_auth_config_with_jwt(jwt): i64 {
    var c = alloc(AGN_AUTH_CFG_SIZE);
    store64(c + AGN_AC_ENABLED, 1);
    store64(c + AGN_AC_SECRET, str_from(""));
    store64(c + AGN_AC_JWT, jwt);
    return c;
}

# Whether auth is enforced at all.
fn agnosai_auth_config_enabled(c): i64 {
    return load64(c + AGN_AC_ENABLED);
}

# The shared secret. Meaningful only when `agnosai_auth_config_jwt` is 0.
fn agnosai_auth_config_secret(c): Str {
    return load64(c + AGN_AC_SECRET);
}

# The JWT config, or 0 for the oracle's `None` (shared-secret mode).
fn agnosai_auth_config_jwt(c): i64 {
    return load64(c + AGN_AC_JWT);
}

# Enable or disable auth in place — the oracle mutates the struct field
# directly in its tests, which build `AuthConfig { enabled, .. }` literals.
fn agnosai_auth_config_set_enabled(c, enabled): i64 {
    store64(c + AGN_AC_ENABLED, enabled);
    return 0;
}

# --- JwtConfig -----------------------------------------------------------
#
# Declared here so `AuthConfig` is complete and `state.rs` can be written
# against it. `agnosai_auth_check` does not *use* it — the RS256 half is bite 2,
# tracked in docs/development/roadmap.md (M6) and CHANGELOG [Unreleased].

# Largest RSA modulus accepted, in bytes — 4096-bit. The oracle has no such
# cap (`DecodingKey` takes whatever the PEM holds), but every buffer here is a
# stack local rather than an allocation, so the bound has to be stated. 4096-bit
# is two doublings past the 2048-bit key the oracle's fixtures use.
var AGNOSAI_JWT_MAX_MODULUS = 512;

# Largest public exponent accepted, in bytes. Real keys use 65537 (3 bytes).
var AGNOSAI_JWT_MAX_EXPONENT = 16;

# Smallest RSA modulus accepted, in bytes — 2048-bit, matching the floor of the
# oracle's `RSA_PKCS1_2048_8192_SHA256`. sigil enforces no minimum of its own,
# so without this a 512-bit key would be accepted and its tokens verified.
#
# The oracle's *ceiling* is 8192-bit; `AGNOSAI_JWT_MAX_MODULUS` is 4096-bit
# because sigil's `_rsa_recover_em` refuses anything over 512 bytes
# (`lib/sigil.cyr:17608`). A 8192-bit key is therefore a 500 here and a 200
# there — documented rather than silent, and not a weakening.
var AGNOSAI_JWT_MIN_MODULUS = 256;

enum AgnosaiJwtConfigOff {
    AGN_JC_PUBLIC_KEY_PEM = 0;
    AGN_JC_ISSUER = 8;
    AGN_JC_AUDIENCE = 16;
    # The decoded key. Populated once by `agnosai_jwt_config_prepare`; see the
    # note on that fn for why this is not done per request as the oracle does.
    AGN_JC_N = 24;
    AGN_JC_N_LEN = 32;
    AGN_JC_E = 40;
    AGN_JC_E_LEN = 48;
    AGN_JC_PREPARED = 56;
    AGN_JC_SIZE = 64;
}

# `AGN_JC_PREPARED` states.
var AGNOSAI_JWT_KEY_UNPREPARED = 0;
var AGNOSAI_JWT_KEY_OK = 1;
var AGNOSAI_JWT_KEY_BAD = 2;

# The oracle's `JwtConfig::new` — key only, no issuer or audience pinned.
# 0 stands in for `None`, the convention the rest of the port uses.
fn agnosai_jwt_config_new(public_key_pem: Str): i64 {
    var j = alloc(AGN_JC_SIZE);
    store64(j + AGN_JC_PUBLIC_KEY_PEM, public_key_pem);
    store64(j + AGN_JC_ISSUER, 0);
    store64(j + AGN_JC_AUDIENCE, 0);
    store64(j + AGN_JC_N, 0);
    store64(j + AGN_JC_N_LEN, 0);
    store64(j + AGN_JC_E, 0);
    store64(j + AGN_JC_E_LEN, 0);
    store64(j + AGN_JC_PREPARED, AGNOSAI_JWT_KEY_UNPREPARED);
    return j;
}

# The oracle's builder `with_issuer`. Mutates and returns, since Cyrius has no
# move semantics to consume `self`.
fn agnosai_jwt_config_with_issuer(j, issuer: Str): i64 {
    store64(j + AGN_JC_ISSUER, issuer);
    return j;
}

# The oracle's builder `with_audience`.
fn agnosai_jwt_config_with_audience(j, audience: Str): i64 {
    store64(j + AGN_JC_AUDIENCE, audience);
    return j;
}

# The PEM-encoded RSA public key.
fn agnosai_jwt_config_public_key_pem(j): Str {
    return load64(j + AGN_JC_PUBLIC_KEY_PEM);
}

# The expected `iss`, or 0 for none configured.
fn agnosai_jwt_config_issuer(j): i64 {
    return load64(j + AGN_JC_ISSUER);
}

# The expected `aud`, or 0 for none configured.
fn agnosai_jwt_config_audience(j): i64 {
    return load64(j + AGN_JC_AUDIENCE);
}

# --- PEM public key ------------------------------------------------------

# Copy a string literal into a byte buffer, so it can be passed to `_pem_find`
# as a (ptr, len) marker. sigil's `_privkey_load_marker` is the same six lines;
# duplicating them keeps this module off a sigil-private symbol it does not
# otherwise need.
fn _agnosai_auth_load_marker(dst, s, len): i64 {
    var i = 0;
    while (i < len) {
        store8(dst + i, load8(s + i) & 0xFF);
        i = i + 1;
    }
    return 0;
}

# Decode a PEM public key into its DER body. Returns the DER length, or -1.
#
# The port plan's "~15 lines of local glue": sigil already exposes everything
# needed — `_pem_find` / `_pem_b64_decode` take the label as a parameter, and
# `rsa_pubkey_from_der` already accepts an X.509 SubjectPublicKeyInfo as well as
# a bare PKCS#1 `RSAPublicKey`. Only the `PUBLIC KEY` label pair was missing.
#
# Both labels are accepted because the oracle's `DecodingKey::from_rsa_pem` does:
# `-----BEGIN PUBLIC KEY-----` (SPKI, what openssl emits and what the oracle's
# fixture uses) and `-----BEGIN RSA PUBLIC KEY-----` (PKCS#1).
fn _agnosai_auth_pem_to_der(pem: Str, der_out, der_max): i64 {
    _pem_init();
    var p = str_data(pem);
    var n = str_len(pem);
    if (n <= 0) { return 0 - 1; }

    var b_spki[26];
    var e_spki[24];
    _agnosai_auth_load_marker(&b_spki, "-----BEGIN PUBLIC KEY-----", 26);
    _agnosai_auth_load_marker(&e_spki, "-----END PUBLIC KEY-----", 24);
    var b_pkcs1[30];
    var e_pkcs1[28];
    _agnosai_auth_load_marker(&b_pkcs1, "-----BEGIN RSA PUBLIC KEY-----", 30);
    _agnosai_auth_load_marker(&e_pkcs1, "-----END RSA PUBLIC KEY-----", 28);

    # PKCS#1 first: its BEGIN label contains the SPKI label as a substring
    # ("-----BEGIN RSA PUBLIC KEY-----" does not, but "-----END RSA PUBLIC
    # KEY-----" would match a naive search for the SPKI END marker inside it),
    # so testing the more specific label first removes any ordering doubt.
    var bpos = _pem_find(p, n, 0, &b_pkcs1, 30);
    var blen = 30;
    var emk = &e_pkcs1;
    var elen = 28;
    if (bpos < 0) {
        bpos = _pem_find(p, n, 0, &b_spki, 26);
        blen = 26;
        emk = &e_spki;
        elen = 24;
    }
    if (bpos < 0) { return 0 - 1; }

    var body = bpos + blen;
    var epos = _pem_find(p, n, body, emk, elen);
    if (epos < 0) { return 0 - 1; }
    return _pem_b64_decode(p, body, epos, der_out, der_max);
}

# Decode the configured PEM into the modulus and exponent this config verifies
# with. Returns 1 on success, 0 on a PEM the key parser rejects.
#
# **Called once, not per request — a deliberate divergence in *when*, not in
# *what*.** The oracle rebuilds `DecodingKey::from_rsa_pem` inside `validate_jwt`
# on every authenticated request (auth.rs:120-123). Hoisting it is both the
# obvious performance fix and the fix for a real hazard: sigil's `_pem_init`
# guards its table build with a plain non-atomic `if (_pem_inited == 1)`, and
# under `sandhi_server_run_pooled` every worker is an OS thread, so two
# concurrent first-requests could race that build.
#
# The **observable** behaviour is unchanged. A config whose PEM does not parse
# still answers 500 on every request that reaches the JWT path, exactly as the
# oracle does — it is simply decided once instead of repeatedly. A server should
# call this at startup and refuse to boot on 0; nothing here requires that,
# because the oracle does not.
fn agnosai_jwt_config_prepare(j): i64 {
    # **Both outcomes are memoized, not just success.** An earlier revision
    # short-circuited only on `_KEY_OK`, so `_KEY_BAD` was written and never
    # read: a config whose PEM base64-decoded but failed RSA SPKI parsing
    # re-ran the whole decode on every request and re-leaked the three
    # allocations below — measured at **536 bytes per request**, from a request
    # that returns 500 and carries no valid credential. One mistyped
    # `AGNOSAI_JWT_PUBLIC_KEY` was enough to make that an unauthenticated
    # memory-exhaustion channel.
    var st = load64(j + AGN_JC_PREPARED);
    if (st == AGNOSAI_JWT_KEY_OK) { return 1; }
    if (st == AGNOSAI_JWT_KEY_BAD) { return 0; }

    var der[1024];
    var dlen = _agnosai_auth_pem_to_der(agnosai_jwt_config_public_key_pem(j), &der, 1024);
    if (dlen <= 0) {
        store64(j + AGN_JC_PREPARED, AGNOSAI_JWT_KEY_BAD);
        return 0;
    }

    var nbuf = alloc(AGNOSAI_JWT_MAX_MODULUS);
    var ebuf = alloc(AGNOSAI_JWT_MAX_EXPONENT);
    var elen_out = alloc(8);
    var nlen = rsa_pubkey_from_der(&der, dlen, nbuf, AGNOSAI_JWT_MAX_MODULUS,
    ebuf, AGNOSAI_JWT_MAX_EXPONENT, elen_out);
    if (nlen <= 0) {
        store64(j + AGN_JC_PREPARED, AGNOSAI_JWT_KEY_BAD);
        return 0;
    }

    # **Enforce the oracle's minimum key size.** jsonwebtoken verifies RS256
    # through ring's `RSA_PKCS1_2048_8192_SHA256`, which refuses any modulus
    # below 2048 bits. sigil imposes no minimum at all — `_rsa_recover_em`
    # (`lib/sigil.cyr:17607-17624`) checks only that the signature width equals
    # the modulus width, that the modulus fits 512 bytes, and that it is odd.
    # Without this check a **512-bit** key was accepted and its tokens verified,
    # which is a straight security regression against the oracle rather than a
    # port detail.
    if (nlen < AGNOSAI_JWT_MIN_MODULUS) {
        store64(j + AGN_JC_PREPARED, AGNOSAI_JWT_KEY_BAD);
        return 0;
    }

    store64(j + AGN_JC_N, nbuf);
    store64(j + AGN_JC_N_LEN, nlen);
    store64(j + AGN_JC_E, ebuf);
    store64(j + AGN_JC_E_LEN, load64(elen_out));
    store64(j + AGN_JC_PREPARED, AGNOSAI_JWT_KEY_OK);
    return 1;
}

# The decoded modulus length, or 0 if the key has not been prepared.
fn agnosai_jwt_config_modulus_len(j): i64 {
    return load64(j + AGN_JC_N_LEN);
}

# --- base64url ------------------------------------------------------------

# The value of one base64url character, or -1.
#
# `-` and `_` rather than `+` and `/`, and **`=` is invalid**: jsonwebtoken
# decodes with `URL_SAFE_NO_PAD`, under which a padding byte is not a padding
# byte, it is a character outside the alphabet.
fn _agnosai_auth_b64u_val(c): i64 {
    if (c >= 65 && c <= 90) { return c - 65; }
    if (c >= 97 && c <= 122) { return c - 97 + 26; }
    if (c >= 48 && c <= 57) { return c - 48 + 52; }
    if (c == 45) { return 62; }
    if (c == 95) { return 63; }
    return 0 - 1;
}

# Decode base64url into a caller-supplied buffer. Returns the decoded length,
# or -1 on anything malformed.
#
# **Written locally rather than calling `bayan_base64url_decode`**, for two
# reasons. It allocates three times per call on the no-free global bump — a
# 256-byte table, the output, and a `{ptr,len}` pair (`lib/bayan.cyr:132`,
# `:150`, `:180`) — which on a per-request auth path leaks forever and violates
# the arena discipline the rest of the server follows; and it is *lax* where a
# token verifier must not be: it strips trailing `=`, and a segment whose length
# is 1 mod 4 silently drops the stray character instead of failing.
#
# This one allocates nothing and rejects both. It also rejects non-canonical
# trailing bits, which the `base64` crate does by default and which is therefore
# what the oracle enforces.
fn _agnosai_auth_b64u_decode(src, src_len, out, out_max): i64 {
    if (src_len < 0) { return 0 - 1; }
    var rem = src_len % 4;
    # A 1-character tail encodes 6 bits, which is not a byte at any padding.
    if (rem == 1) { return 0 - 1; }

    var full = src_len / 4;
    var out_len = full * 3;
    if (rem == 2) { out_len = out_len + 1; }
    if (rem == 3) { out_len = out_len + 2; }
    if (out_len > out_max) { return 0 - 1; }

    var si = 0;
    var di = 0;
    while (si + 4 <= src_len) {
        var a = _agnosai_auth_b64u_val(load8(src + si) & 255);
        var b = _agnosai_auth_b64u_val(load8(src + si + 1) & 255);
        var c = _agnosai_auth_b64u_val(load8(src + si + 2) & 255);
        var d = _agnosai_auth_b64u_val(load8(src + si + 3) & 255);
        if (a < 0 || b < 0 || c < 0 || d < 0) { return 0 - 1; }
        store8(out + di, ((a << 2) | (b >> 4)) & 255);
        store8(out + di + 1, (((b & 15) << 4) | (c >> 2)) & 255);
        store8(out + di + 2, (((c & 3) << 6) | d) & 255);
        si = si + 4;
        di = di + 3;
    }

    if (rem == 2) {
        var ta = _agnosai_auth_b64u_val(load8(src + si) & 255);
        var tb = _agnosai_auth_b64u_val(load8(src + si + 1) & 255);
        if (ta < 0 || tb < 0) { return 0 - 1; }
        # The low 4 bits of the second symbol are discarded; a canonical
        # encoder leaves them zero, and the `base64` crate rejects them
        # otherwise (`InvalidLastSymbol`).
        if ((tb & 15) != 0) { return 0 - 1; }
        store8(out + di, ((ta << 2) | (tb >> 4)) & 255);
    }
    if (rem == 3) {
        var ua = _agnosai_auth_b64u_val(load8(src + si) & 255);
        var ub = _agnosai_auth_b64u_val(load8(src + si + 1) & 255);
        var uc = _agnosai_auth_b64u_val(load8(src + si + 2) & 255);
        if (ua < 0 || ub < 0 || uc < 0) { return 0 - 1; }
        if ((uc & 3) != 0) { return 0 - 1; }
        store8(out + di, ((ua << 2) | (ub >> 4)) & 255);
        store8(out + di + 1, (((ub & 15) << 4) | (uc >> 2)) & 255);
    }
    return out_len;
}

# --- Header handling -----------------------------------------------------

# The `Bearer ` prefix, including its trailing space. Case-sensitive, matching
# the oracle's `header.starts_with("Bearer ")` — RFC 7235 says the scheme is
# case-insensitive, but the oracle is not, and a client sending `bearer ` gets a
# 401 from Rust today. Reproduced deliberately.
var AGNOSAI_AUTH_BEARER_LEN = 7;

# Whether every byte of `s` would survive `HeaderValue::to_str()` — that is,
# `is_visible_ascii`: printable ASCII plus tab.
#
# The byte is masked because `load8` sign-extends: without it a 0x80-or-higher
# byte arrives negative and would still fail the range test, but for the wrong
# reason — the kind of accident that survives a refactor.
#
# `tools_builtin_security_audit` has the cstr-shaped twin of this
# (`_agnosai_audit_is_visible_ascii`). Two instances in different shapes is not
# yet an abstraction; if a third appears, hoist all three.
fn _agnosai_auth_is_visible_ascii(s: Str): i64 {
    var n = str_len(s);
    var p = str_data(s);
    var i = 0;
    while (i < n) {
        var c = load8(p + i) & 255;
        if (c != 9 && (c < 32 || c > 126)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Extract the token from an `Authorization` header value, or 0 if there is none
# to extract.
#
# 0 is returned for all three of the oracle's rejection shapes — a value that
# fails `to_str()`, a value not starting with `Bearer `, and `Bearer ` with an
# empty token — because the oracle answers 401 to all three. The caller does not
# need to tell them apart; only the log line differs, and that is `check`'s job.
fn agnosai_auth_bearer_token(header: Str): i64 {
    if (_agnosai_auth_is_visible_ascii(header) == 0) { return 0; }
    if (str_starts_with(header, str_from("Bearer ")) == 0) { return 0; }
    var n = str_len(header);
    if (n == AGNOSAI_AUTH_BEARER_LEN) { return 0; }
    return str_sub(header, AGNOSAI_AUTH_BEARER_LEN, n - AGNOSAI_AUTH_BEARER_LEN);
}

# --- Shared-secret comparison --------------------------------------------

# SHA-256 digest length, in bytes — the width every secret comparison runs over
# regardless of input length.
var AGNOSAI_AUTH_DIGEST_LEN = 32;

# Whether `a` and `b` are equal, in time independent of both their lengths and
# their contents.
#
# See the module header for why this hashes rather than transcribing the
# oracle's loop: the accept/reject set is identical, the timing leak is not.
fn _agnosai_auth_secret_eq(a: Str, b: Str): i64 {
    var ha[32];
    var hb[32];
    sha256(str_data(a), str_len(a), &ha);
    sha256(str_data(b), str_len(b), &hb);
    return ct_eq_bytes(&ha, &hb, AGNOSAI_AUTH_DIGEST_LEN);
}

# --- JWT validation ------------------------------------------------------

# jsonwebtoken's `Validation::new` default leeway, in seconds
# (`jsonwebtoken-10.3.0/src/validation.rs:120`, `leeway: 60`).
#
# **Decision 4 (maintainer, 2026-07-30): reproduce it.** This number is
# invisible from `auth.rs` — the oracle never sets it, it comes from the crate's
# constructor — so a port written faithfully from the oracle *source* would
# compare `exp < now` and silently ship a stricter server. 60 s is also standard
# clock-skew practice. Stated here as a named constant rather than implied,
# which is the whole point.
var AGNOSAI_JWT_LEEWAY_SECS = 60;

# Largest `exp` accepted — 9999-12-31T23:59:59Z, the same sentinel Decision 2
# picked for the token fixtures. Anything larger is rejected rather than
# compared; see the range guard in `_agnosai_auth_validate_jwt` for why a bound
# is required rather than merely tidy.
var AGNOSAI_JWT_MAX_EXP = 253402300799;

# Largest decoded header, payload and signature this verifier accepts, in bytes.
#
# The oracle has no equivalent cap: `jsonwebtoken::decode` allocates per
# segment. These are stack locals, so a bound is required — and a bound is
# wanted anyway, since the buffers are filled from an unauthenticated request.
# 4 KiB of claims is far past any real token; the signature bound is the
# modulus bound, because a PKCS#1 v1.5 signature is exactly as wide as the key.
var AGNOSAI_JWT_MAX_HEADER = 1024;
var AGNOSAI_JWT_MAX_PAYLOAD = 4096;

# Offset of the next `.` at or after `start`, or -1.
fn _agnosai_auth_find_dot(p, start, len): i64 {
    var i = start;
    while (i < len) {
        if ((load8(p + i) & 255) == 46) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Whether a parsed JSON string field equals `want`. 0 if the field is absent or
# is not a string — an array `aud` lands here and answers 0, which is
# **Decision 3**: see `_agnosai_auth_validate_jwt`.
fn _agnosai_auth_field_eq(obj, key, want: Str): i64 {
    var v = bayan_json_v_obj_get(obj, key);
    if (v == 0) { return 0; }
    if (bayan_json_v_is_str(v) == 0) { return 0; }
    return str_eq(bayan_json_v_str(v), want);
}

# Whether a claim, if present, has the type the oracle's `Claims` struct
# declares. `want_str` is 1 for the `Option<String>` fields and 0 for the
# `Option<u64>` ones. An absent claim is fine — every field is an `Option`.
#
# The oracle gets this free: `jsonwebtoken::decode` deserializes the whole
# payload into `Claims` (`decoding.rs:289`) before validating, so any type
# mismatch is an `ErrorKind::Json` and becomes a 401 at `auth.rs:138-141`. The
# port reads the payload untyped, so without this it would **accept** tokens
# the oracle rejects — `"sub": 123`, `"aud": []` with no audience configured,
# and so on. Fail-open divergences, and the cheapest kind to close.
fn _agnosai_auth_claim_type_ok(claims, key, want_str): i64 {
    var v = bayan_json_v_obj_get(claims, key);
    if (v == 0) { return 1; }
    if (want_str == 1) { return bayan_json_v_is_str(v); }
    if (bayan_json_v_is_int(v) == 0) { return 0; }
    # `Option<u64>` — serde refuses a negative literal for an unsigned field.
    if (bayan_json_v_int(v) < 0) { return 0; }
    return 1;
}

# Every field of the oracle's `Claims` (rust-old/src/server/auth.rs:101-116),
# checked for the type it declares.
fn _agnosai_auth_claims_well_typed(claims): i64 {
    if (_agnosai_auth_claim_type_ok(claims, "sub", 1) == 0) { return 0; }
    if (_agnosai_auth_claim_type_ok(claims, "iss", 1) == 0) { return 0; }
    if (_agnosai_auth_claim_type_ok(claims, "aud", 1) == 0) { return 0; }
    if (_agnosai_auth_claim_type_ok(claims, "scope", 1) == 0) { return 0; }
    if (_agnosai_auth_claim_type_ok(claims, "exp", 0) == 0) { return 0; }
    if (_agnosai_auth_claim_type_ok(claims, "iat", 0) == 0) { return 0; }
    return 1;
}

# Validate an RS256 JWT. Returns `HTTP_OK`, `HTTP_UNAUTHORIZED`, or
# `HTTP_INTERNAL` when the configured key itself is unusable.
#
# `now` is injected rather than read from the clock so the 60-second leeway
# boundary is testable against a frozen token vector. `agnosai_auth_check`
# passes `clock_epoch_secs()`.
fn _agnosai_auth_validate_jwt(token: Str, j, now): i64 {
    # A key that does not parse is a server misconfiguration, not a bad
    # request — the oracle answers 500 here (auth.rs:120-123) and so does this.
    if (agnosai_jwt_config_prepare(j) == 0) { return HTTP_INTERNAL; }

    var p = str_data(token);
    var n = str_len(token);

    # Exactly three segments.
    var d1 = _agnosai_auth_find_dot(p, 0, n);
    if (d1 < 0) { return HTTP_UNAUTHORIZED; }
    var d2 = _agnosai_auth_find_dot(p, d1 + 1, n);
    if (d2 < 0) { return HTTP_UNAUTHORIZED; }
    if (_agnosai_auth_find_dot(p, d2 + 1, n) >= 0) { return HTTP_UNAUTHORIZED; }

    var hlen = d1;
    var plen = d2 - d1 - 1;
    var slen = n - d2 - 1;
    if (hlen <= 0 || plen <= 0 || slen <= 0) { return HTTP_UNAUTHORIZED; }

    # --- Signature FIRST, before a single byte of JSON is parsed ----------
    #
    # **This ordering is load-bearing and was chosen against the obvious one.**
    #
    # `bayan_json_v_parse_buf` builds a value tree on the **no-free global
    # bump** — bayan threads no allocator through its parser, and there is no
    # `_parse_buf_a`. Parsing the header before verifying therefore hands an
    # unauthenticated caller a permanent heap write. Measured: a 1,164-byte
    # header segment leaked **62,248 bytes per request, ~53x amplification**, on
    # a request that then returned 401. A slow attacker with no credential at
    # all eventually OOMs the process, and nothing reclaims it.
    #
    # Verifying first costs CPU instead: every garbage token pays a ~3.3 ms RSA
    # operation (see `benches/orch.bcyr`). That is the worse trade on paper and
    # the better one in practice — CPU exhaustion is recoverable and is what a
    # rate limiter is for, while a no-free leak is neither.
    #
    # **It is cryptographically safe to verify before reading `alg`**, because
    # the algorithm is never *chosen* from the header: this path always runs
    # RSASSA-PKCS1-v1.5 over SHA-256 with the configured RSA key. A token
    # declaring `alg:none` or `alg:HS256` still has to carry a valid RSA
    # signature to get past this point, which only the key holder can produce.
    # The `alg` check below is defense in depth against exactly one residual
    # case — a token that IS validly RSA-signed but declares another algorithm.
    var sbuf[512];
    var sn = _agnosai_auth_b64u_decode(p + d2 + 1, slen, &sbuf, AGNOSAI_JWT_MAX_MODULUS);
    if (sn <= 0) { return HTTP_UNAUTHORIZED; }
    if (rsa_pkcs1v15_verify_sha256(load64(j + AGN_JC_N), load64(j + AGN_JC_N_LEN),
    load64(j + AGN_JC_E), load64(j + AGN_JC_E_LEN),
    p, d2, &sbuf, sn) != 1) {
        return HTTP_UNAUTHORIZED;
    }

    # --- Header: pin the algorithm ---------------------------------------
    #
    # The oracle gets this from `Validation::new(Algorithm::RS256)`, which
    # jsonwebtoken enforces inside `decode`. sigil exposes only the raw
    # primitive, so it has to be done here or the port ships an `alg: none`
    # bypass the oracle does not have — and the oracle's own tests never
    # exercise `alg`, so test parity would not catch its absence.
    #
    # Read as a **parsed JSON field**, never a substring scan: a header like
    # `{"alg":"none","kid":"RS256-2024"}` satisfies a substring test.
    var hbuf[1024];
    var hn = _agnosai_auth_b64u_decode(p, hlen, &hbuf, AGNOSAI_JWT_MAX_HEADER);
    if (hn <= 0) { return HTTP_UNAUTHORIZED; }
    var hdr = bayan_json_v_parse_buf(&hbuf, hn);
    if (hdr == 0) { return HTTP_UNAUTHORIZED; }
    if (bayan_json_v_is_obj(hdr) == 0) { return HTTP_UNAUTHORIZED; }
    if (_agnosai_auth_field_eq(hdr, "alg", str_from("RS256")) == 0) {
        return HTTP_UNAUTHORIZED;
    }

    # --- Claims ----------------------------------------------------------
    #
    # This parse still grows the global bump, but only for a caller who already
    # produced a valid signature. That residual is blocker #3's to close, not
    # this module's: the router bite gives each worker a per-request arena with
    # one `reset_via` exit path, and every allocation here lands inside it.
    var pbuf[4096];
    var pn = _agnosai_auth_b64u_decode(p + d1 + 1, plen, &pbuf, AGNOSAI_JWT_MAX_PAYLOAD);
    if (pn <= 0) { return HTTP_UNAUTHORIZED; }
    var claims = bayan_json_v_parse_buf(&pbuf, pn);
    if (claims == 0) { return HTTP_UNAUTHORIZED; }
    if (bayan_json_v_is_obj(claims) == 0) { return HTTP_UNAUTHORIZED; }

    # Type-check every declared claim before reading any of them, so the port
    # rejects the same malformed payloads the oracle's typed deserialization
    # does. This must run before the `iss`/`aud` comparisons, which are
    # conditional on configuration and would otherwise let an ill-typed claim
    # through whenever it happens not to be configured.
    if (_agnosai_auth_claims_well_typed(claims) == 0) { return HTTP_UNAUTHORIZED; }

    # `exp` is required. jsonwebtoken seeds `required_spec_claims = {"exp"}`
    # in `Validation::new` (validation.rs:113-118), so a token without one is
    # `MissingRequiredClaim` — and the oracle then checks again at
    # auth.rs:143-146. That second check is unreachable in Rust; this single
    # check is the mechanism, not the belt-and-braces.
    var exp = bayan_json_v_obj_get(claims, "exp");
    if (exp == 0) { return HTTP_UNAUTHORIZED; }
    if (bayan_json_v_is_int(exp) == 0) { return HTTP_UNAUTHORIZED; }
    var exp_v = bayan_json_v_int(exp);

    # **Range-guard `exp` before comparing it.** bayan's `_jp_atoi`
    # (`lib/bayan.cyr:3504-3514`) computes `n = n * 10 + digit` in wrapping i64
    # with no overflow detection, and still tags the wrapped result `JTAG_INT`
    # — so `bayan_json_v_is_int` above does not catch it. Without this guard a
    # payload carrying `"exp":20000000000000000000` wrapped to
    # 1553255926290448384, a year-51-billion timestamp, and the token was
    # **accepted** where the oracle answers 401 (the value exceeds `u64::MAX`,
    # so `Claims { exp: Option<u64> }` fails to deserialize before validation
    # even runs).
    #
    # The bound is the same year-9999 sentinel Decision 2 picked for the
    # fixtures, so any `exp` a real issuer emits passes and everything past the
    # end of four-digit years does not. Negative is rejected for the mirror
    # case: an `exp` in `(i64::MAX, u64::MAX]` wraps negative, which the oracle
    # would accept — fail-closed, and the only direction worth erring in.
    #
    # Residual, and it needs the signing key to reach: a literal above
    # `u64::MAX` chosen to wrap *into* [0, 253402300799] is indistinguishable
    # after parsing. Detecting it needs a raw-digit-count check bayan does not
    # expose; worth filing there.
    if (exp_v < 0) { return HTTP_UNAUTHORIZED; }
    if (exp_v > AGNOSAI_JWT_MAX_EXP) { return HTTP_UNAUTHORIZED; }

    # jsonwebtoken rejects when `exp < now - leeway` (validation.rs:290-291,
    # with `reject_tokens_expiring_in_less_than` at its default 0). Written as
    # the accept condition, that is `exp >= now - leeway`.
    if (exp_v < now - AGNOSAI_JWT_LEEWAY_SECS) {
        return HTTP_UNAUTHORIZED;
    }

    # **Decision 1 (maintainer, 2026-07-30): TIGHTENED — see ADR 010.**
    #
    # jsonwebtoken's `set_issuer` / `set_audience` set only `Validation.iss` /
    # `.aud`; neither touches `required_spec_claims` (validation.rs:143-145).
    # A token carrying **no `iss` at all** therefore passes issuer validation in
    # the oracle even when an issuer is configured. Here, configuring an issuer
    # *requires* a matching one.
    #
    # Cost of the divergence: zero oracle assertions change, because
    # `valid_claims()` (auth.rs:332-341) always populates both. What changes is
    # the case an operator would call a bug.
    var want_iss = agnosai_jwt_config_issuer(j);
    if (want_iss != 0) {
        if (_agnosai_auth_field_eq(claims, "iss", want_iss) == 0) {
            return HTTP_UNAUTHORIZED;
        }
    }

    # Same tightening for `aud`, and **Decision 3 rides along**: an array-valued
    # `aud` is not a string, so `_agnosai_auth_field_eq` answers 0 and the token
    # is rejected. That is *inherited*, not designed — the oracle rejects it too,
    # though for an unrelated reason: `Claims.aud` is `Option<String>`, so
    # jsonwebtoken fails deserialization (decoding.rs:285-287) before validation
    # ever runs. Single-element `["agnosai"]` is rejected as well, which is the
    # surprising half, and is what an Auth0 or Cognito token looks like.
    var want_aud = agnosai_jwt_config_audience(j);
    if (want_aud != 0) {
        if (_agnosai_auth_field_eq(claims, "aud", want_aud) == 0) {
            return HTTP_UNAUTHORIZED;
        }
    }

    return HTTP_OK;
}

# --- The middleware ------------------------------------------------------

# Emit one WARN with a reason, matching the oracle's `tracing::warn!` calls.
# Level-checked first so the formatting is only paid when it would be emitted.
fn _agnosai_auth_warn(msg, msg_len, reason, reason_len): i64 {
    if (sakshi_get_level() < SK_WARN) { return 0; }
    sakshi_log_kv(SK_WARN, msg, msg_len, "reason", 6, reason, reason_len);
    return 0;
}

# The oracle's `auth_middleware`, as a pure function of the config and the
# request's `Authorization` header.
#
# Returns an HTTP status: `HTTP_OK` to let the request through, `HTTP_UNAUTHORIZED`
# to reject it. `has_header` is the oracle's `Option` — 0 when the request
# carried no `Authorization` header at all, in which case `header` is ignored.
#
# Shaped as `fn(config, inputs) -> status` rather than as a sandhi handler on
# purpose: it keeps the whole decision synchronously testable before any
# transport exists, which is what turns the oracle's ten `#[tokio::test]`s into
# ordinary assertions here.
#
# `now` is the epoch-second reading the `exp` leeway is judged against. Callers
# use `agnosai_auth_check`, which supplies the wall clock.
fn agnosai_auth_check_at(c, has_header, header: Str, now): i64 {
    if (agnosai_auth_config_enabled(c) == 0) { return HTTP_OK; }

    if (has_header == 0) {
        _agnosai_auth_warn("auth rejected", 13, "missing authorization header", 28);
        return HTTP_UNAUTHORIZED;
    }

    var token = agnosai_auth_bearer_token(header);
    if (token == 0) {
        _agnosai_auth_warn("auth rejected", 13, "malformed or empty bearer token", 31);
        return HTTP_UNAUTHORIZED;
    }

    var jwt = agnosai_auth_config_jwt(c);
    if (jwt != 0) {
        var st = _agnosai_auth_validate_jwt(token, jwt, now);
        if (st == HTTP_INTERNAL) {
            _agnosai_auth_warn("auth misconfigured", 18, "jwt public key pem is invalid", 29);
        }
        if (st == HTTP_UNAUTHORIZED) {
            _agnosai_auth_warn("auth rejected", 13, "jwt validation failed", 21);
        }
        return st;
    }

    if (_agnosai_auth_secret_eq(token, agnosai_auth_config_secret(c)) == 0) {
        _agnosai_auth_warn("auth rejected", 13, "invalid shared secret", 21);
        return HTTP_UNAUTHORIZED;
    }

    return HTTP_OK;
}

# `agnosai_auth_check_at` with the wall clock — the entry point a request
# handler calls. Split so the 60-second `exp` leeway can be driven from both
# sides against a frozen token vector, which is the only way to test it without
# a signing key at test time.
#
# **The clock is read only on the path that uses it.** The obvious spelling,
# `check_at(c, has_header, header, clock_epoch_secs())`, reads it before the
# config is even inspected — and `clock_epoch_secs` costs ~1.34 µs here, which
# `benches/orch.bcyr` caught turning the disabled short-circuit from 6 ns into
# 1.35 µs and the shared-secret path from 945 ns into 2.35 µs. Both are paths
# where `now` is never looked at. `now` is passed as 0 for them, which is safe
# precisely because only the JWT branch reads it.
fn agnosai_auth_check(c, has_header, header: Str): i64 {
    if (agnosai_auth_config_enabled(c) == 0) { return HTTP_OK; }
    if (agnosai_auth_config_jwt(c) == 0) {
        # `now` is never read on the shared-secret path, so any value is safe.
        return agnosai_auth_check_at(c, has_header, header, 0);
    }

    # **A 0 from the clock means "unknown", not 1970.** `lib/chrono.cyr:50-57`
    # documents `clock_epoch_secs` as returning 0 when the RTC is mid-update or
    # unreadable — on the agnos target it is a bare `sys_time_unix` with no
    # retry. Fed straight through, that turns the expiry test into
    # `exp < -60`, which is false for every non-negative `exp`: **expiry
    # enforcement silently switches off** and any expired token is accepted.
    #
    # Refusing the request is the only safe reading. It is a 500 rather than a
    # 401 because the fault is the server's, and it matches how this module
    # already answers a key it cannot use.
    return agnosai_auth_check_clocked(c, has_header, header, clock_epoch_secs());
}

# The sentinel guard, split out from `agnosai_auth_check` so it can be driven
# with a `now` of 0 on a host whose clock works.
#
# That split is not cosmetic: with the guard inlined, deleting it failed **no**
# test on this machine, because `clock_epoch_secs()` here always returns a sane
# epoch and the branch was unreachable from the suite. A guard no test can
# reach is a guard that silently rots.
fn agnosai_auth_check_clocked(c, has_header, header: Str, now): i64 {
    if (now <= 0) {
        _agnosai_auth_warn("auth unavailable", 16, "clock unreadable", 16);
        return HTTP_INTERNAL;
    }
    return agnosai_auth_check_at(c, has_header, header, now);
}
