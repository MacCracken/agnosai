# Entry point. Initializes the bump allocator every downstream module's heap
# structures depend on, then reports readiness. The port has no CLI surface yet.
fn main() {
    alloc_init();
    println("agnosai ready");
    return 0;
}

# Prefixed like everything else: this is a top-level `var` in Cyrius's single
# flat namespace, so a bare `r` here is a global that could shadow — or be
# shadowed by — any dep that happens to use the same name. `scripts/check-symbols.sh`
# enforces the rule; the `.tcyr` epilogue's bare `f` is exempt only because a
# test binary is its own final translation unit.
var _agnosai_exit_code = main();
syscall(SYS_EXIT, _agnosai_exit_code);
