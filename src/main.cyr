# agnosai — Cyrius port
# Ported from 27683 lines of Rust

# Stdlib auto-included via cyrius.cyml

include "src/id.cyr"
include "src/core.cyr"
include "src/learning.cyr"

# Entry point. Initializes the bump allocator every downstream module's heap
# structures depend on, then reports readiness. The port has no CLI surface yet.
fn main() {
    alloc_init();
    println("agnosai ready");
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
