# =========================================================================
# tools_builtin_mneme — the three Mneme knowledge-base tools.
#
# Parity oracle: rust-old/src/tools/builtin/mneme.rs
#
# Mneme is the AGNOS note store; the oracle's default base URL is
# `http://localhost:8400`. The HTTP shape lives in `src/tools_agnos.cyr`.
#
# Two things here are not boilerplate. `mneme_search` builds a query string,
# which is the only place in the ecosystem tools that needs percent-encoding —
# reqwest's `.query()` gave the oracle that for free and the stdlib has no
# equivalent, so `agnosai_agnos_form_encode` supplies it. `mneme_get_note`
# interpolates a caller-supplied id into the path, guarded by the oracle's
# `contains('/') || contains("..")` check.
# =========================================================================

# A client pointed at the default Mneme base URL.
fn agnosai_mneme_client(): i64 {
    return agnosai_agnos_client(str_from(AGNOSAI_MNEME_BASE_URL), str_from("mneme"));
}

# ---------------------------------------------------------------------------
# mneme_search
# ---------------------------------------------------------------------------

# The mneme_search parameter schema.
fn _agnosai_mneme_search_schema(ctx): i64 {
    var s = agnosai_tool_schema_new(str_from("mneme_search"),
    str_from("Search the Mneme knowledge base for notes matching a query"));
    agnosai_tool_schema_param(s, str_from("query"), str_from("Search query text"),
    str_from("string"), 1);
    agnosai_tool_schema_param(s, str_from("limit"),
    str_from("Max results to return (default 10)"),
    str_from("number"), 0);
    return s;
}

# Build the search path with its query string: `/api/search?q=<q>&limit=<n>`.
#
# Key order is the oracle's — it passes `&[("q", ..), ("limit", ..)]` and
# `serde_urlencoded` preserves the slice order. The order is observable to any
# service that logs or caches on the raw query string, so it is not incidental.
#
# The oracle stringifies `limit` through `to_string()` and hands it to the same
# form encoder as `q`; digits survive encoding unchanged, so appending it
# directly is the same bytes.
fn agnosai_mneme_search_path(query: Str, limit): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/api/search?q=");
    agnosai_agnos_form_encode(sb, query);
    str_builder_add_cstr(sb, "&limit=");
    str_builder_add_int(sb, limit);
    return str_builder_build(sb);
}

# Search Mneme for notes matching a query.
fn _agnosai_mneme_search_execute(ctx, input): i64 {
    var query = agnosai_tool_input_get_str(input, str_from("query"));
    if (query == 0) {
        return agnosai_tool_output_err(str_from("missing required parameter: query"));
    }
    # The oracle's `unwrap_or(10)`.
    var limit = agnosai_tool_input_get_int(input, str_from("limit"));
    if (limit == AGNOSAI_NO_LIMIT) { limit = 10; }

    return agnosai_agnos_call(ctx, "GET", agnosai_mneme_search_path(query, limit), 0, 0);
}

# The mneme_search tool, bound to a client.
fn agnosai_mneme_search_tool(client): i64 {
    return agnosai_tool_new(str_from("mneme_search"),
    str_from("Search the Mneme knowledge base for notes matching a query"),
    &_agnosai_mneme_search_schema, &_agnosai_mneme_search_execute, client);
}

# ---------------------------------------------------------------------------
# mneme_get_note
# ---------------------------------------------------------------------------

# The mneme_get_note parameter schema.
fn _agnosai_mneme_get_note_schema(ctx): i64 {
    var s = agnosai_tool_schema_new(str_from("mneme_get_note"),
    str_from("Get a note by ID from the Mneme knowledge base"));
    agnosai_tool_schema_param(s, str_from("note_id"), str_from("Note identifier"),
    str_from("string"), 1);
    return s;
}

# Fetch one note by id.
fn _agnosai_mneme_get_note_execute(ctx, input): i64 {
    var note_id = agnosai_tool_input_get_str(input, str_from("note_id"));
    if (note_id == 0) {
        return agnosai_tool_output_err(str_from("missing required parameter: note_id"));
    }
    # The oracle's path-traversal guard, before the id reaches the URL.
    if (agnosai_agnos_segment_ok(note_id) == 0) {
        return agnosai_agnos_segment_err(str_from("note_id"));
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/api/notes/");
    str_builder_add(sb, note_id);
    return agnosai_agnos_call(ctx, "GET", str_builder_build(sb), 0, 0);
}

# The mneme_get_note tool, bound to a client.
fn agnosai_mneme_get_note_tool(client): i64 {
    return agnosai_tool_new(str_from("mneme_get_note"),
    str_from("Get a note by ID from the Mneme knowledge base"),
    &_agnosai_mneme_get_note_schema, &_agnosai_mneme_get_note_execute, client);
}

# ---------------------------------------------------------------------------
# mneme_create_note
# ---------------------------------------------------------------------------

# The mneme_create_note parameter schema.
fn _agnosai_mneme_create_note_schema(ctx): i64 {
    var s = agnosai_tool_schema_new(str_from("mneme_create_note"),
    str_from("Create a new note in the Mneme knowledge base"));
    agnosai_tool_schema_param(s, str_from("title"), str_from("Note title"), str_from("string"), 1);
    agnosai_tool_schema_param(s, str_from("content"),
    str_from("Note body content (Markdown)"), str_from("string"), 1);
    agnosai_tool_schema_param(s, str_from("tags"),
    str_from("Optional tags for categorisation"), str_from("array"), 0);
    return s;
}

# Build the create-note body.
#
# `tags` is taken from the raw parameter map and passed through **whatever its
# JSON type**, defaulting to `[]` when absent. The oracle does
# `parameters.get("tags").cloned().unwrap_or_else(|| json!([]))` — it never
# checks that the value is an array, so a caller sending `"tags": "urgent"`
# forwards a string and lets Mneme decide. Validating here would be an
# improvement the oracle does not make, and would reject a request the oracle
# accepts.
fn agnosai_mneme_create_note_body(title: Str, content: Str, tags): i64 {
    var body = bayan_json_v_obj_new();
    bayan_json_v_obj_set(body, str_from("title"), bayan_json_v_str_new(title));
    bayan_json_v_obj_set(body, str_from("content"), bayan_json_v_str_new(content));
    if (tags == 0) { tags = bayan_json_v_arr_new(); }
    bayan_json_v_obj_set(body, str_from("tags"), tags);
    return body;
}

# Create a note in Mneme.
fn _agnosai_mneme_create_note_execute(ctx, input): i64 {
    var title = agnosai_tool_input_get_str(input, str_from("title"));
    if (title == 0) {
        return agnosai_tool_output_err(str_from("missing required parameter: title"));
    }
    var content = agnosai_tool_input_get_str(input, str_from("content"));
    if (content == 0) {
        return agnosai_tool_output_err(str_from("missing required parameter: content"));
    }

    var body = agnosai_mneme_create_note_body(title, content,
    agnosai_tool_input_get(input, str_from("tags")));
    return agnosai_agnos_call(ctx, "POST", str_from("/api/notes"), body, 0);
}

# The mneme_create_note tool, bound to a client.
fn agnosai_mneme_create_note_tool(client): i64 {
    return agnosai_tool_new(str_from("mneme_create_note"),
    str_from("Create a new note in the Mneme knowledge base"),
    &_agnosai_mneme_create_note_schema, &_agnosai_mneme_create_note_execute, client);
}

# Register all three Mneme tools against a live client. Returns the registry.
fn agnosai_register_mneme_builtins(registry): i64 {
    var client = agnosai_mneme_client();
    agnosai_tool_registry_register(registry, agnosai_mneme_search_tool(client));
    agnosai_tool_registry_register(registry, agnosai_mneme_get_note_tool(client));
    agnosai_tool_registry_register(registry, agnosai_mneme_create_note_tool(client));
    return registry;
}
