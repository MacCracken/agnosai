# =========================================================================
# guarded_fetch — an HTTP fetch that re-validates the SSRF guard on every
# redirect hop.
#
# No single Rust file is the oracle. This is the shared implementation of
# [ADR 007](../docs/adr/007-audit-redirect-revalidation.md), which the two
# consumers that fetch a **caller-supplied** URL both need:
# `tools_builtin_security_audit` and `tools_remote_registry`. The ADR named
# both when it was written; this module is what stops them being two copies.
#
# Why it exists at all: reqwest follows up to 10 redirects by default, and both
# oracles validate only the URL the caller handed in. A target that passes
# `is_safe_url` and then answers `302 Location: http://169.254.169.254/` walks
# the oracle into the cloud metadata service. sandhi's default is the opposite —
# `sandhi_http_options_new` leaves following off — and inheriting that would be
# differently wrong, since a site that redirects http to https would never be
# reached at all. So hops are followed, and the guard runs against each one
# before the request to it is issued.
#
# Duplicating this would be worse than duplicating ordinary code: two copies of
# a security control drift, and the drift is silent. That is why it was
# extracted at the second instance rather than the third.
#
# Include order: needs `src/server/ssrf.cyr` for `agnosai_is_safe_url`.
# =========================================================================

# Redirect hop limit — reqwest's default, which is what both oracles inherit.
var AGNOSAI_FETCH_MAX_HOPS = 10;

# Returned instead of a response when a hop pointed somewhere the guard
# refuses. Distinguished from 0 (the request simply failed) because the two
# deserve different messages: one is a network problem, the other is an
# attempted bypass and should read like one.
var AGNOSAI_FETCH_BLOCKED = 0 - 1;

# Case-insensitive ASCII compare of the first `n` bytes of two C strings.
#
# The bounded sibling of `_agnosai_audit_cstr_ieq`, for prefix tests where the
# left side is a URL that continues past the prefix.
fn _agnosai_fetch_cstr_ieq_n(a, b, n): i64 {
    for (var i = 0; i < n; i = i + 1) {
        var ca = load8(a + i) & 255;
        var cb = load8(b + i) & 255;
        if (ca >= 65 && ca <= 90) { ca = ca + 32; }
        if (cb >= 65 && cb <= 90) { cb = cb + 32; }
        if (ca != cb) { return 0; }
    }
    return 1;
}

# Length of the URL's scheme prefix — 7 for `http://`, 8 for `https://`, 0 for
# anything else — compared **case-insensitively**.
#
# It has to be case-insensitive because `sandhi_url_parse` is (via
# `_sandhi_url_sceq`), and therefore so is `agnosai_is_safe_url`. A byte-exact
# test here against a guard that accepts `HTTPS://` is a hole, not a nicety:
# it would skip the downgrade refusal below, and slice the origin one byte short
# so that a relative `Location` resolved against `HTTPS://example.com/` produced
# a URL pointing at an entirely different host.
#
# Callers that need byte-exact scheme matching for **parity** reasons must not
# use this — `agnosai_audit_analyze`'s HTTPS recommendation reproduces the
# oracle's byte-exact `!target_url.starts_with("https://")` on purpose. This
# function is for the security controls, where matching the guard matters more
# than matching a cosmetic string test.
fn agnosai_fetch_scheme_len(url: Str): i64 {
    if (str_len(url) < 7) { return 0; }
    var d = str_data(url);
    if (_agnosai_fetch_cstr_ieq_n(d, "https://", 8) == 1) { return 8; }
    if (_agnosai_fetch_cstr_ieq_n(d, "http://", 7) == 1) { return 7; }
    return 0;
}

# Whether the URL's scheme is https, case-insensitively.
fn agnosai_fetch_is_https(url: Str): i64 {
    if (agnosai_fetch_scheme_len(url) == 8) { return 1; }
    return 0;
}

# The redirect statuses, per RFC 9110. Same set sandhi's own follower uses.
fn agnosai_fetch_is_redirect(status): i64 {
    if (status == 301) { return 1; }
    if (status == 302) { return 1; }
    if (status == 303) { return 1; }
    if (status == 307) { return 1; }
    if (status == 308) { return 1; }
    return 0;
}

# Resolve a `Location` value against the URL it came from, returning an absolute
# URL or 0 when it cannot be resolved with confidence.
#
# This handles the two forms that matter — an absolute URL, and an absolute path
# resolved against the base's authority — and **fails closed on everything
# else**. A relative reference like `../admin` needs real RFC 3986 path merging,
# and for a security tool "report what we already have" is a much better answer
# than "guess where that pointed and send a request there".
#
# The result is built through a str_builder, so it is a fresh copy rather than a
# borrow of the response arena.
fn agnosai_fetch_resolve_location(base: Str, location): i64 {
    var loc = str_from(location);
    if (str_len(loc) == 0) { return 0; }
    if (agnosai_fetch_scheme_len(loc) > 0) { return str_clone(loc); }

    # Anything that is not an absolute path is refused rather than guessed at.
    if (str_starts_with(loc, str_from("/")) == 0) { return 0; }
    # A protocol-relative "//host/path" carries its own authority, so it is not
    # the same-origin case this branch handles.
    if (str_starts_with(loc, str_from("//")) == 1) { return 0; }

    # The base's origin is its prefix up to the first '/', '?' or '#' after the
    # scheme separator. Taken as raw bytes rather than through
    # `sandhi_url_parse`, deliberately: that struct stores the scheme as an
    # integer code rather than text, and defaults an absent port to 80 or 443
    # rather than leaving it unset — so reassembling from it would both need a
    # code-to-text mapping and would rewrite `https://example.com/` into
    # `https://example.com:443/`. Slicing the original keeps the authority
    # byte-for-byte as the caller wrote it.
    var p = agnosai_fetch_scheme_len(base);
    if (p == 0) { return 0; }
    var data = str_data(base);
    var n = str_len(base);
    var origin_end = n;
    for (var i = p; i < n; i = i + 1) {
        var c = load8(data + i);
        if (c == 47 || c == 63 || c == 35) { origin_end = i; break; }
    }

    var sb = str_builder_new();
    for (var b = 0; b < origin_end; b = b + 1) { str_builder_add_byte(sb, load8(data + b)); }
    str_builder_add(sb, loc);
    return str_builder_build(sb);
}

# Issue a request, following redirects and **re-running the SSRF guard on every
# hop**.
#
# This is the one place the port deliberately does not do what the oracle does,
# and it diverges in both directions at once — see docs/adr/007.
#
# reqwest follows up to 10 redirects by default, so the oracle follows them; but
# it validates only the URL the caller supplied. A target that passes
# `is_safe_url` and then answers `302 Location: http://169.254.169.254/` walks
# the oracle straight into the cloud metadata service and reports its headers
# back to the caller. That is the textbook SSRF-via-redirect bypass, and it is a
# hole in a tool whose entire job is to find holes.
#
# sandhi's default is the opposite — `sandhi_http_options_new` leaves following
# off — and simply inheriting that would be no better, just differently wrong:
# auditing `http://example.com` when it redirects to HTTPS would score the
# redirect's own (header-free) response and report a well-configured site as
# 0/7, critical risk.
#
# So the hops are followed, and the guard runs against each one before the
# request is made. An https -> http downgrade is refused for the same reason
# sandhi refuses it: the audit must not be talked down onto a cleartext channel.
#
# The 15s budget spans the **whole chain**, not each hop. reqwest's
# `Client::timeout` is one deadline covering a request and every redirect it
# follows, so giving each hop a fresh 15s would let an 11-hop chain run for 165
# seconds against the oracle's 15 — and the audit makes two such chains.
# `total_ms` is rewritten from the remaining budget before every request.
#
# `headers` must be owned outside the arena: it is reused across hops, and the
# arena is reset between them.
#
# Returns the final response, 0 if a request failed or the budget ran out, or
# AGNOSAI_FETCH_BLOCKED if a hop was refused.
fn agnosai_guarded_fetch(arena, method, url: Str, headers, opts, timeout_ms): i64 {
    var current = url;
    var verb = method;
    var hops = 0;
    var deadline = clock_now_ns() + timeout_ms * AGNOSAI_NS_PER_MS;

    while (hops <= AGNOSAI_FETCH_MAX_HOPS) {
        var left_ms = (deadline - clock_now_ns()) / AGNOSAI_NS_PER_MS;
        if (left_ms <= 0) { return 0; }
        sandhi_http_options_total_ms(opts, left_ms);

        var r = sandhi_http_request_auto_a(arena, verb, str_cstr(current), headers, 0, 0, opts);
        if (r == 0 || sandhi_http_err_kind(r) != SANDHI_OK) { return 0; }
        if (agnosai_fetch_is_redirect(sandhi_http_status(r)) == 0) { return r; }

        var loc = sandhi_headers_get(sandhi_http_headers(r), "Location");
        if (loc == 0) { return r; }
        var next = agnosai_fetch_resolve_location(current, loc);
        if (next == 0) { return r; }

        # Refuse to be downgraded off TLS mid-audit.
        if (agnosai_fetch_is_https(current) == 1 && agnosai_fetch_is_https(next) == 0) {
            return AGNOSAI_FETCH_BLOCKED;
        }
        # The guard, on every hop. This is the check the oracle never makes.
        if (agnosai_is_safe_url(next) == 0) { return AGNOSAI_FETCH_BLOCKED; }

        # A 303 turns the next request into a GET, per RFC 9110. Only reachable
        # on the CORS probe here, since the header fetch is already a GET.
        if (sandhi_http_status(r) == 303) { verb = "GET"; }

        # This hop's response is finished with — `next` is a fresh copy outside
        # the arena, and nothing else here points into it. Releasing now is what
        # keeps the arena sized for one exchange instead of for a whole chain.
        reset_via(arena);
        current = next;
        hops = hops + 1;
    }
    return 0;
}

