# Isolated: retention attributable to majra's bucket map alone.
# The key is formatted into a fixed stack buffer, so nothing but majra
# allocates inside the loop.

include "src/units.cyr"
include "src/arena_pool.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/strcase.cyr"
include "src/telemetry/mod.cyr"
