# =========================================================================
# server_router — rust-old/src/server/mod.rs.
#
# **`mod.rs` has no `#[cfg(test)]` module at all**, so every routing rule here
# is covered for the first time: all 18 table entries, the public/protected
# boundary, path-parameter capture, 404-vs-405, and the layer ordering that
# decides whether a bad request sees 413, 404 or 401.
#
# The auth boundary is the part worth the most scrutiny — a route that silently
# fell out of the protected set would be an authentication bypass, and nothing
# upstream would catch it.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/core/mod.cyr"
include "src/learning/mod.cyr"
include "src/llm/mod.cyr"
include "src/server/ssrf.cyr"
include "src/server/prompt_guard.cyr"
include "src/server/output_filter.cyr"
include "src/server/prometheus.cyr"
include "src/server/auth.cyr"
include "src/guarded_fetch.cyr"
include "src/chan_lossy.cyr"
include "src/server/sse.cyr"
include "src/tools/mod.cyr"
include "src/orchestrator/mod.cyr"
include "src/server/state.cyr"
include "src/server/routes/mod.cyr"
include "src/server/routes/health.cyr"
include "src/server/routes/tools.cyr"
include "src/server/routes/agents.cyr"
include "src/server/routes/approval.cyr"
include "src/server/routes/dashboard.cyr"
include "src/server/routes/crews.cyr"
include "src/server/routes/a2a.cyr"
include "src/server/routes/mcp.cyr"
include "src/server/hot_config.cyr"
include "src/server/rate_limit.cyr"
include "src/server/router.cyr"
include "tests/test_helpers.cyr"

fn _t_state_auth(auth): i64 {
    var reg = agnosai_tool_registry_new();
    agnosai_tool_registry_register(reg, agnosai_echo_tool());
    return agnosai_app_state_new(agnosai_orchestrator_new(0), reg, auth,
    agnosai_event_bus_new(), agnosai_audit_chain_new(), agnosai_approval_gate_new());
}

fn _t_open(): i64 { return _t_state_auth(agnosai_auth_config_new()); }
fn _t_guarded(): i64 {
    return _t_state_auth(agnosai_auth_config_with_secret(str_from("s3cret")));
}

# Dispatch with no Authorization header.
fn _t_go(s, method, path): i64 {
    return agnosai_route_dispatch(s, method, str_from(path), str_from(""), 0, str_from(""));
}

# Dispatch with a valid Bearer token.
fn _t_go_auth(s, method, path): i64 {
    return agnosai_route_dispatch(s, method, str_from(path),
    str_from("Bearer s3cret"), 1, str_from(""));
}

fn _t_id(method, path): i64 {
    return agnosai_route_match_id(agnosai_route_resolve(method, str_from(path)));
}

fn _t_param(method, path): Str {
    var p = agnosai_route_match_param(agnosai_route_resolve(method, str_from(path)));
    if (p == 0) { return str_from(""); }
    return p;
}

# --- The table: all 18 entries -------------------------------------------

fn _t_table(): i64 {
    assert(_t_id(AGNOSAI_METHOD_GET, "/health") == AGN_ROUTE_HEALTH, "GET /health");
    assert(_t_id(AGNOSAI_METHOD_GET, "/ready") == AGN_ROUTE_READY, "GET /ready");
    assert(_t_id(AGNOSAI_METHOD_GET, "/metrics") == AGN_ROUTE_METRICS, "GET /metrics");
    assert(_t_id(AGNOSAI_METHOD_POST, "/mcp") == AGN_ROUTE_MCP, "POST /mcp");
    assert(_t_id(AGNOSAI_METHOD_POST, "/api/v1/crews") == AGN_ROUTE_CREATE_CREW,
    "POST /api/v1/crews");
    assert(_t_id(AGNOSAI_METHOD_GET, "/api/v1/crews/abc") == AGN_ROUTE_GET_CREW,
    "GET /api/v1/crews/{id}");
    assert(_t_id(AGNOSAI_METHOD_POST, "/api/v1/crews/abc/cancel") == AGN_ROUTE_CANCEL_CREW,
    "POST /api/v1/crews/{id}/cancel");
    assert(_t_id(AGNOSAI_METHOD_GET, "/api/v1/crews/abc/stream") == AGN_ROUTE_CREW_STREAM,
    "GET /api/v1/crews/{id}/stream");
    assert(_t_id(AGNOSAI_METHOD_POST, "/api/v1/a2a/receive") == AGN_ROUTE_A2A_RECEIVE,
    "POST /api/v1/a2a/receive");
    # POST, not GET — the oracle registers `post(routes::a2a::status)`.
    assert(_t_id(AGNOSAI_METHOD_POST, "/api/v1/a2a/status") == AGN_ROUTE_A2A_STATUS,
    "POST /api/v1/a2a/status");
    assert(_t_id(AGNOSAI_METHOD_GET, "/api/v1/agents/definitions")
    == AGN_ROUTE_LIST_DEFINITIONS, "GET definitions");
    assert(_t_id(AGNOSAI_METHOD_POST, "/api/v1/agents/definitions")
    == AGN_ROUTE_CREATE_DEFINITION, "POST definitions — same path, different method");
    assert(_t_id(AGNOSAI_METHOD_GET, "/api/v1/tools") == AGN_ROUTE_LIST_TOOLS, "GET tools");
    assert(_t_id(AGNOSAI_METHOD_DELETE, "/api/v1/tools/echo") == AGN_ROUTE_REMOVE_TOOL,
    "DELETE /api/v1/tools/{name}");
    assert(_t_id(AGNOSAI_METHOD_GET, "/api/v1/approvals") == AGN_ROUTE_LIST_PENDING,
    "GET approvals");
    assert(_t_id(AGNOSAI_METHOD_POST, "/api/v1/approvals") == AGN_ROUTE_SUBMIT_APPROVAL,
    "POST approvals");
    assert(_t_id(AGNOSAI_METHOD_GET, "/api/v1/presets") == AGN_ROUTE_LIST_PRESETS,
    "GET presets");
    assert(_t_id(AGNOSAI_METHOD_GET, "/api/v1/dashboard/crews") == AGN_ROUTE_CREW_HISTORY,
    "GET dashboard/crews");
    assert(_t_id(AGNOSAI_METHOD_GET, "/api/v1/dashboard/agents")
    == AGN_ROUTE_AGENT_PERFORMANCE, "GET dashboard/agents");
    return 0;
}

# --- The auth boundary ---------------------------------------------------

# **`/health`, `/ready` and `/metrics` are ALWAYS public**, even with auth
# enabled. `/metrics` being unauthenticated exposes crew counts, task counts and
# inference cost — worth knowing rather than discovering.
fn _t_probes_are_public(): i64 {
    var s = _t_guarded();
    assert(agnosai_route_status(_t_go(s, AGNOSAI_METHOD_GET, "/health")) == HTTP_OK,
    "/health needs no auth even when auth is enabled");
    assert(agnosai_route_status(_t_go(s, AGNOSAI_METHOD_GET, "/ready")) == HTTP_OK,
    "/ready needs no auth");
    assert(agnosai_route_status(_t_go(s, AGNOSAI_METHOD_GET, "/metrics")) == HTTP_OK,
    "/metrics needs no auth — it is unauthenticated by design");

    assert(agnosai_route_needs_auth(AGN_ROUTE_HEALTH) == 0, "health is public");
    assert(agnosai_route_needs_auth(AGN_ROUTE_READY) == 0, "ready is public");
    assert(agnosai_route_needs_auth(AGN_ROUTE_METRICS) == 0, "metrics is public");
    return 0;
}

# **Every other route is protected**, `/mcp` included — it is not under
# `/api/v1` and is the one most easily missed when transcribing the router.
fn _t_everything_else_is_protected(): i64 {
    assert(agnosai_route_needs_auth(AGN_ROUTE_MCP) == 1,
    "/mcp is protected despite not being under /api/v1");
    assert(agnosai_route_needs_auth(AGN_ROUTE_CREATE_CREW) == 1, "create_crew");
    assert(agnosai_route_needs_auth(AGN_ROUTE_GET_CREW) == 1, "get_crew");
    assert(agnosai_route_needs_auth(AGN_ROUTE_CANCEL_CREW) == 1, "cancel_crew");
    assert(agnosai_route_needs_auth(AGN_ROUTE_CREW_STREAM) == 1, "crew_stream");
    assert(agnosai_route_needs_auth(AGN_ROUTE_A2A_RECEIVE) == 1, "a2a receive");
    assert(agnosai_route_needs_auth(AGN_ROUTE_A2A_STATUS) == 1, "a2a status");
    assert(agnosai_route_needs_auth(AGN_ROUTE_LIST_DEFINITIONS) == 1, "list definitions");
    assert(agnosai_route_needs_auth(AGN_ROUTE_CREATE_DEFINITION) == 1, "create definition");
    assert(agnosai_route_needs_auth(AGN_ROUTE_LIST_TOOLS) == 1, "list tools");
    assert(agnosai_route_needs_auth(AGN_ROUTE_REMOVE_TOOL) == 1, "remove tool");
    assert(agnosai_route_needs_auth(AGN_ROUTE_LIST_PENDING) == 1, "list pending");
    assert(agnosai_route_needs_auth(AGN_ROUTE_SUBMIT_APPROVAL) == 1, "submit approval");
    assert(agnosai_route_needs_auth(AGN_ROUTE_LIST_PRESETS) == 1, "list presets");
    assert(agnosai_route_needs_auth(AGN_ROUTE_CREW_HISTORY) == 1, "crew history");
    assert(agnosai_route_needs_auth(AGN_ROUTE_AGENT_PERFORMANCE) == 1, "agent performance");
    return 0;
}

# The boundary in effect, end to end.
fn _t_auth_gate_runs(): i64 {
    var s = _t_guarded();
    assert(agnosai_route_status(_t_go(s, AGNOSAI_METHOD_GET, "/api/v1/tools"))
    == HTTP_UNAUTHORIZED, "a protected route with no header is 401");
    assert(agnosai_route_status(_t_go_auth(s, AGNOSAI_METHOD_GET, "/api/v1/tools"))
    == HTTP_OK, "...and passes with a valid token");
    assert(agnosai_route_status(_t_go(s, AGNOSAI_METHOD_POST, "/mcp"))
    == HTTP_UNAUTHORIZED, "/mcp with no header is 401");

    var wrong = agnosai_route_dispatch(s, AGNOSAI_METHOD_GET, str_from("/api/v1/tools"),
    str_from("Bearer wrong"), 1, str_from(""));
    assert(agnosai_route_status(wrong) == HTTP_UNAUTHORIZED, "a wrong token is 401");

    # With auth disabled every route is open, which is the default posture.
    var open = _t_open();
    assert(agnosai_route_status(_t_go(open, AGNOSAI_METHOD_GET, "/api/v1/tools")) == HTTP_OK,
    "with auth disabled a protected route is open");
    return 0;
}

# --- Layer ordering ------------------------------------------------------

# **Routing happens before middleware**, so an unauthenticated request to a
# path that does not exist is 404, not 401 — an information disclosure the
# oracle accepts and the port reproduces.
fn _t_routing_precedes_auth(): i64 {
    var s = _t_guarded();
    assert(agnosai_route_status(_t_go(s, AGNOSAI_METHOD_GET, "/api/v1/nope"))
    == HTTP_NOT_FOUND, "an unknown path is 404 even without auth, not 401");
    assert(agnosai_route_status(_t_go(s, AGNOSAI_METHOD_GET, "/nope")) == HTTP_NOT_FOUND,
    "...at the top level too");
    return 0;
}

# `DefaultBodyLimit` is the OUTERMOST layer, so it fires before routing and
# therefore before auth — an oversized body is 413 regardless of path or token.
fn _t_body_limit_is_outermost(): i64 {
    var s = _t_guarded();
    var sb = str_builder_new();
    for (var i = 0; i < AGNOSAI_MAX_BODY_BYTES + 1; i = i + 1) { str_builder_putc(sb, 120); }
    var big = str_builder_build(sb);

    assert(agnosai_route_status(agnosai_route_dispatch(s, AGNOSAI_METHOD_POST,
    str_from("/api/v1/crews"), str_from(""), 0, big)) == HTTP_PAYLOAD_TOO_LARGE,
    "an oversized body is 413 before auth is consulted");
    assert(agnosai_route_status(agnosai_route_dispatch(s, AGNOSAI_METHOD_GET,
    str_from("/nonexistent"), str_from(""), 0, big)) == HTTP_PAYLOAD_TOO_LARGE,
    "...and before routing, so even an unknown path is 413 not 404");
    assert(AGNOSAI_MAX_BODY_BYTES == 10485760, "the cap is the oracle's 10 MiB");
    return 0;
}

# A known path under an unregistered method is **405**, not 404.
fn _t_method_mismatch_is_405(): i64 {
    var s = _t_open();
    assert(agnosai_route_status(_t_go(s, AGNOSAI_METHOD_POST, "/health"))
    == HTTP_METHOD_NOT_ALLOWED, "POST /health is 405");
    assert(agnosai_route_status(_t_go(s, AGNOSAI_METHOD_GET, "/mcp"))
    == HTTP_METHOD_NOT_ALLOWED, "GET /mcp is 405");
    assert(agnosai_route_status(_t_go(s, AGNOSAI_METHOD_DELETE, "/api/v1/crews"))
    == HTTP_METHOD_NOT_ALLOWED, "DELETE /api/v1/crews is 405");
    # a2a/status is POST-only.
    assert(agnosai_route_status(_t_go(s, AGNOSAI_METHOD_GET, "/api/v1/a2a/status"))
    == HTTP_METHOD_NOT_ALLOWED, "GET a2a/status is 405 — it is registered POST-only");
    # ...but a genuinely unknown path is still 404.
    assert(agnosai_route_status(_t_go(s, AGNOSAI_METHOD_POST, "/api/v1/zzz"))
    == HTTP_NOT_FOUND, "an unknown path is 404, not 405");
    return 0;
}

# --- Path parameters -----------------------------------------------------

fn _t_path_params(): i64 {
    assert(str_eq(_t_param(AGNOSAI_METHOD_GET, "/api/v1/crews/xyz"), str_from("xyz")) == 1,
    "the crew id is captured");
    assert(str_eq(_t_param(AGNOSAI_METHOD_POST, "/api/v1/crews/abc/cancel"),
    str_from("abc")) == 1, "the id is captured from a mid-path parameter");
    assert(str_eq(_t_param(AGNOSAI_METHOD_DELETE, "/api/v1/tools/echo"),
    str_from("echo")) == 1, "the tool name is captured");

    # A parameter matches exactly one NON-EMPTY segment and never spans `/`.
    assert(_t_id(AGNOSAI_METHOD_GET, "/api/v1/crews//") == AGN_ROUTE_NONE,
    "an empty parameter segment does not match");
    assert(_t_id(AGNOSAI_METHOD_POST, "/api/v1/crews//cancel") == AGN_ROUTE_NONE,
    "an empty mid-path parameter does not match");
    assert(_t_id(AGNOSAI_METHOD_POST, "/api/v1/crews/a/b/cancel") == AGN_ROUTE_NONE,
    "a parameter does not span a slash");
    assert(_t_id(AGNOSAI_METHOD_GET, "/api/v1/crews/a/b") == AGN_ROUTE_NONE,
    "an extra segment does not match");

    # A trailing slash is a distinct path, as in axum.
    assert(_t_id(AGNOSAI_METHOD_GET, "/health/") == AGN_ROUTE_NONE,
    "a trailing slash is not the same route");

    # `/api/v1/crews/{id}` and `/api/v1/crews` are different routes, and the
    # literal `/api/v1/crews` must not be swallowed by the parameter pattern.
    assert(_t_id(AGNOSAI_METHOD_POST, "/api/v1/crews") == AGN_ROUTE_CREATE_CREW,
    "the bare collection path is its own route");
    return 0;
}

# The parameter reaches the handler, which validates it — `get_crew` answers 422
# for a malformed UUID rather than 404, because axum's `Path<Uuid>` extractor
# runs AFTER routing.
fn _t_param_reaches_the_handler(): i64 {
    var s = _t_open();
    assert(agnosai_route_status(_t_go(s, AGNOSAI_METHOD_GET, "/api/v1/crews/not-a-uuid"))
    == AGNOSAI_HTTP_UNPROCESSABLE,
    "a malformed crew id is 422 from the handler, not 404 from the router");
    assert(agnosai_route_status(_t_go(s, AGNOSAI_METHOD_GET,
    "/api/v1/crews/00000000-0000-0000-0000-000000000001")) == HTTP_NOT_FOUND,
    "a well-formed but unknown crew id is 404 from the handler");
    assert(agnosai_route_status(_t_go(s, AGNOSAI_METHOD_DELETE, "/api/v1/tools/echo"))
    == HTTP_NO_CONTENT, "DELETE reaches remove_tool with the right name");
    assert(agnosai_route_status(_t_go(s, AGNOSAI_METHOD_DELETE, "/api/v1/tools/nope"))
    == HTTP_NOT_FOUND, "...and an unknown tool is the handler's 404");
    return 0;
}

# --- Dispatch reaches the right handler ----------------------------------

fn _t_dispatch(): i64 {
    var s = _t_open();
    var health = _t_go(s, AGNOSAI_METHOD_GET, "/health");
    assert(bayan_json_v_obj_get(agnosai_route_body(health), "status") != 0,
    "/health returns the health body");

    var tools = _t_go(s, AGNOSAI_METHOD_GET, "/api/v1/tools");
    assert(bayan_json_v_arr_len(agnosai_route_body(tools)) == 1,
    "/api/v1/tools returns the registered tool");

    var presets = _t_go(s, AGNOSAI_METHOD_GET, "/api/v1/presets");
    assert(bayan_json_v_arr_len(agnosai_route_body(presets)) == 0,
    "/api/v1/presets returns the empty default-build array");

    var metrics = _t_go(s, AGNOSAI_METHOD_GET, "/metrics");
    assert(agnosai_route_is_text(metrics) == 1, "/metrics returns text, not JSON");

    var mcp = agnosai_route_dispatch(s, AGNOSAI_METHOD_POST, str_from("/mcp"),
    str_from(""), 0, str_from("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"}"));
    assert(bayan_json_v_obj_get(agnosai_route_body(mcp), "result") != 0,
    "/mcp dispatches to the JSON-RPC handler with the body");

    var a2a = _t_go(s, AGNOSAI_METHOD_POST, "/api/v1/a2a/status");
    assert(bayan_json_v_obj_get(agnosai_route_body(a2a), "status") != 0,
    "a2a/status dispatches");
    return 0;
}

# `/api/v1/crews/{id}/stream` **is implemented** as of bite 15c — but as a
# stream, which `agnosai_route_dispatch` cannot express: its return is a status
# plus a finished body. `agnosai_serve_handler` intercepts the route before
# reaching the dispatcher, so this 501 is unreachable over the transport and is
# the honest answer only for a direct dispatch like this one. 501 rather than
# 404 because the route exists; the SSE behaviour itself is covered in
# `tests/server_serve.tcyr`.
fn _t_stream_is_501_not_404(): i64 {
    var s = _t_open();
    var r = _t_go(s, AGNOSAI_METHOD_GET, "/api/v1/crews/abc/stream");
    assert(agnosai_route_status(r) == HTTP_NOT_IMPLEMENTED,  #skip-lint: HTTP 501 status code
    "dispatched directly the stream route answers 501 — it streams over the transport instead");

    # The mismatch flag distinguishes a known path under a wrong method from an
    # unknown path, and is what the 405/404 split reads.
    assert(agnosai_route_match_method_mismatch(
    agnosai_route_resolve(AGNOSAI_METHOD_POST, str_from("/health"))) == 1,
    "a known path with a wrong method sets the mismatch flag");
    assert(agnosai_route_match_method_mismatch(
    agnosai_route_resolve(AGNOSAI_METHOD_GET, str_from("/zzz"))) == 0,
    "...and an unknown path does not");
    assert(agnosai_route_status(r) != HTTP_NOT_FOUND,
    "...specifically NOT 404, which would deny the endpoint exists");
    # And it is still behind auth, so an unauthenticated caller sees 401 first.
    var g = _t_guarded();
    assert(agnosai_route_status(_t_go(g, AGNOSAI_METHOD_GET, "/api/v1/crews/abc/stream"))
    == HTTP_UNAUTHORIZED, "the unwired route is still auth-gated");
    return 0;
}

# A segment must match in FULL. A prefix is a different path, and so is a
# suffix — `/heal` must not reach `/health`, and `/xhealth` must not either.
fn _t_partial_segments_do_not_match(): i64 {
    assert(agnosai_route_match_id(agnosai_route_resolve(AGNOSAI_METHOD_GET,
    str_from("/heal"))) == AGN_ROUTE_NONE,
    "a strict prefix of a route segment does not match it");
    assert(agnosai_route_match_id(agnosai_route_resolve(AGNOSAI_METHOD_GET,
    str_from("/health2"))) == AGN_ROUTE_NONE, "a strict extension does not match either");
    assert(agnosai_route_match_id(agnosai_route_resolve(AGNOSAI_METHOD_GET,
    str_from("/healthh"))) == AGN_ROUTE_NONE, "nor a repeated final byte");
    assert(agnosai_route_match_id(agnosai_route_resolve(AGNOSAI_METHOD_GET,
    str_from("/api/v1/tool"))) == AGN_ROUTE_NONE, "a truncated deep segment does not match");
    assert(agnosai_route_match_id(agnosai_route_resolve(AGNOSAI_METHOD_GET,
    str_from("/api/v/tools"))) == AGN_ROUTE_NONE,
    "a truncated interior segment does not match");

    # A near-miss is a 404, not a 405 — the path is genuinely unknown, so
    # `seen` must stay clear rather than reporting a method mismatch.
    assert(agnosai_route_match_method_mismatch(agnosai_route_resolve(AGNOSAI_METHOD_GET,
    str_from("/heal"))) == 0, "a near-miss is 404, not 405");

    assert(agnosai_route_match_id(agnosai_route_resolve(AGNOSAI_METHOD_GET,
    str_from("/health"))) == AGN_ROUTE_HEALTH, "...while the exact path still resolves");
    return 0;
}

# --- Matching is allocation-free -----------------------------------------

# The matcher walks both sides in place. The obvious vec-of-Str implementation
# cost **4,352 bytes per request** — more than the whole `/health` handler —
# because it re-split every pattern on every check and a miss walks all 18.
fn _t_matching_is_allocation_free(): i64 {
    agnosai_route_resolve(AGNOSAI_METHOD_GET, str_from("/api/v1/dashboard/agents"));

    # A full-table miss: the worst case, touching every pattern.
    var before = alloc_used();
    for (var i = 0; i < 64; i = i + 1) {
        agnosai_route_resolve(AGNOSAI_METHOD_GET, str_from("/no/such/path/here"));
    }
    assert((alloc_used() - before) / 64 < 64,
    "a full-table miss allocates essentially nothing");

    # A hit with no parameter allocates only the match struct.
    var b2 = alloc_used();
    for (var j = 0; j < 64; j = j + 1) {
        agnosai_route_resolve(AGNOSAI_METHOD_GET, str_from("/api/v1/dashboard/agents"));
    }
    assert((alloc_used() - b2) / 64 < 128, "a deep hit allocates only the match struct");

    # A hit WITH a parameter allocates the captured Str as well, and only one —
    # not one per pattern tried.
    var b3 = alloc_used();
    for (var k = 0; k < 64; k = k + 1) {
        agnosai_route_resolve(AGNOSAI_METHOD_POST, str_from("/api/v1/crews/abc/cancel"));
    }
    assert((alloc_used() - b3) / 64 < 192,
    "a parameterised hit captures one Str, not one per pattern tried");
    return 0;
}

# --- The flat table, kept as a differential oracle -----------------------

# **The sixteen-attempt table the router used before it was split into groups**,
# reproduced here verbatim and in its original order.
#
# It exists to be disagreed with. The two-level resolver is a pure performance
# change on the port's most security-sensitive decision —
# `agnosai_route_needs_auth` keys off the id this returns, so a path that lands
# in the wrong group, or lands nowhere, changes who may reach a handler. That is
# not a thing to verify by reading; `_t_resolve_is_equivalent` runs both over a
# generated corpus and requires they agree on **id, param and the 405-vs-404
# flag**, for every path, under every method.
#
# It lives in the test rather than in `src/` deliberately. A route added to the
# real table and not to this one fails the differential immediately, which is
# the right forcing function — the alternative is a reference that silently
# stops covering what it claims to.
fn _t_resolve_flat(method, path: Str): i64 {
    var param = alloc(8);
    var seen = 0;

    if (_agnosai_path_matches(path, "/health", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_GET) { return _agnosai_rm_new(AGN_ROUTE_HEALTH, 0, 0); }
    }
    if (_agnosai_path_matches(path, "/ready", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_GET) { return _agnosai_rm_new(AGN_ROUTE_READY, 0, 0); }
    }
    if (_agnosai_path_matches(path, "/metrics", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_GET) { return _agnosai_rm_new(AGN_ROUTE_METRICS, 0, 0); }
    }
    if (_agnosai_path_matches(path, "/mcp", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_POST) { return _agnosai_rm_new(AGN_ROUTE_MCP, 0, 0); }
    }
    if (_agnosai_path_matches(path, "/api/v1/crews", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_POST) {
            return _agnosai_rm_new(AGN_ROUTE_CREATE_CREW, 0, 0);
        }
    }
    if (_agnosai_path_matches(path, "/api/v1/crews/*", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_GET) {
            return _agnosai_rm_new(AGN_ROUTE_GET_CREW, load64(param), 0);
        }
    }
    if (_agnosai_path_matches(path, "/api/v1/crews/*/cancel", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_POST) {
            return _agnosai_rm_new(AGN_ROUTE_CANCEL_CREW, load64(param), 0);
        }
    }
    if (_agnosai_path_matches(path, "/api/v1/crews/*/stream", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_GET) {
            return _agnosai_rm_new(AGN_ROUTE_CREW_STREAM, load64(param), 0);
        }
    }
    if (_agnosai_path_matches(path, "/api/v1/a2a/receive", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_POST) {
            return _agnosai_rm_new(AGN_ROUTE_A2A_RECEIVE, 0, 0);
        }
    }
    if (_agnosai_path_matches(path, "/api/v1/a2a/status", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_POST) {
            return _agnosai_rm_new(AGN_ROUTE_A2A_STATUS, 0, 0);
        }
    }
    if (_agnosai_path_matches(path, "/api/v1/agents/definitions", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_GET) {
            return _agnosai_rm_new(AGN_ROUTE_LIST_DEFINITIONS, 0, 0);
        }
        if (method == AGNOSAI_METHOD_POST) {
            return _agnosai_rm_new(AGN_ROUTE_CREATE_DEFINITION, 0, 0);
        }
    }
    if (_agnosai_path_matches(path, "/api/v1/tools", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_GET) {
            return _agnosai_rm_new(AGN_ROUTE_LIST_TOOLS, 0, 0);
        }
    }
    if (_agnosai_path_matches(path, "/api/v1/tools/*", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_DELETE) {
            return _agnosai_rm_new(AGN_ROUTE_REMOVE_TOOL, load64(param), 0);
        }
    }
    if (_agnosai_path_matches(path, "/api/v1/approvals", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_GET) {
            return _agnosai_rm_new(AGN_ROUTE_LIST_PENDING, 0, 0);
        }
        if (method == AGNOSAI_METHOD_POST) {
            return _agnosai_rm_new(AGN_ROUTE_SUBMIT_APPROVAL, 0, 0);
        }
    }
    if (_agnosai_path_matches(path, "/api/v1/presets", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_GET) {
            return _agnosai_rm_new(AGN_ROUTE_LIST_PRESETS, 0, 0);
        }
    }
    if (_agnosai_path_matches(path, "/api/v1/dashboard/crews", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_GET) {
            return _agnosai_rm_new(AGN_ROUTE_CREW_HISTORY, 0, 0);
        }
    }
    if (_agnosai_path_matches(path, "/api/v1/dashboard/agents", param) == 1) {
        seen = 1;
        if (method == AGNOSAI_METHOD_GET) {
            return _agnosai_rm_new(AGN_ROUTE_AGENT_PERFORMANCE, 0, 0);
        }
    }

    if (seen == 1) { return _agnosai_rm_new(AGN_ROUTE_NONE, 0, 1); }
    return _agnosai_rm_new(AGN_ROUTE_NONE, 0, 0);
}

# Assert both resolvers agree on `path` under all four method values.
#
# **Method 0 is included.** `_agnosai_serve_method` answers 0 for any verb the
# table does not map — PUT, PATCH, a lowercase `get`, an unparsed line — and
# that value reaches the resolver, where it must produce 405 on a known path
# rather than matching something. Testing only the three real methods would
# leave the arm every unmapped verb takes unchecked on both sides.
fn _t_same(path): i64 {
    var s = str_from(path);
    for (var m = 0; m <= 3; m = m + 1) {
        var want = _t_resolve_flat(m, s);
        var got = agnosai_route_resolve(m, s);
        assert(agnosai_route_match_id(got) == agnosai_route_match_id(want),
        "grouped and flat resolvers agree on the route id");
        assert(agnosai_route_match_method_mismatch(got)
        == agnosai_route_match_method_mismatch(want),
        "...and on 405-vs-404");
        var pw = agnosai_route_match_param(want);
        var pg = agnosai_route_match_param(got);
        if (pw == 0) {
            assert(pg == 0, "...and neither captures a parameter");
        } else {
            assert(pg != 0, "...or both do");
            assert(str_eq(pg, pw) == 1, "...with the same captured value");
        }
    }
    return 0;
}

# Every path in the table, every near-miss that could cross a group boundary,
# and the shapes that make the split's assumptions load-bearing.
fn _t_resolve_is_equivalent(): i64 {
    # Every registered path, and each parameterised one with a real value.
    _t_same("/health");
    _t_same("/ready");
    _t_same("/metrics");
    _t_same("/mcp");
    _t_same("/api/v1/crews");
    _t_same("/api/v1/crews/abc");
    _t_same("/api/v1/crews/abc/cancel");
    _t_same("/api/v1/crews/abc/stream");
    _t_same("/api/v1/a2a/receive");
    _t_same("/api/v1/a2a/status");
    _t_same("/api/v1/agents/definitions");
    _t_same("/api/v1/tools");
    _t_same("/api/v1/tools/echo");
    _t_same("/api/v1/approvals");
    _t_same("/api/v1/presets");
    _t_same("/api/v1/dashboard/crews");
    _t_same("/api/v1/dashboard/agents");

    # A parameter that spells another route's segment, in both positions.
    _t_same("/api/v1/crews/cancel");
    _t_same("/api/v1/crews/stream");
    _t_same("/api/v1/crews/crews");
    _t_same("/api/v1/tools/tools");
    _t_same("/api/v1/crews/dashboard/cancel");

    # **The group selector's exactness.** Each of these differs from a group
    # name by one byte or one boundary, and each would be routed into that
    # group by a prefix test rather than a segment test.
    _t_same("/api/v1/crewsX");
    _t_same("/api/v1/crews2/abc");
    _t_same("/api/v1/crew");
    _t_same("/api/v1/toolsy");
    _t_same("/api/v1/dashboardz/crews");
    _t_same("/api/v1/agentsz/definitions");
    _t_same("/api/v1/a2ab/status");
    _t_same("/api/v1/approvalsx");
    _t_same("/api/v1/presetsx");

    # **The prefix's exactness.** `/api/v1` must end on a segment boundary or
    # `/api/v1x/tools` would resolve as `/api/v1/tools`.
    _t_same("/api/v1x/tools");
    # **No separator at all after the prefix.** The shape the boundary check's
    # header claims still 404s without it: a loose `_agnosai_path_prefix_end`
    # returns 7 here, `_agnosai_seg_is` reads from 8 and sees `tools`, so the
    # group IS entered — and `/tools` then fails to match the segment `Xtools`,
    # because the matcher does not skip a byte that is not a separator. Asserted
    # rather than reasoned, for each group whose name could be spelled this way.
    _t_same("/api/v1Xtools");
    _t_same("/api/v1Xcrews");
    _t_same("/api/v1Xapprovals");
    _t_same("/api/v1Xdashboard/crews");
    _t_same("/api/v1Xcrews/abc/cancel");
    _t_same("/api/v1");
    _t_same("/api/v1/");
    _t_same("/api");
    _t_same("/api/");
    _t_same("/api/v2/tools");
    _t_same("/api/v/tools");
    _t_same("/apiv1/tools");
    _t_same("/xapi/v1/tools");

    # Empty segments, trailing slashes and doubled separators — the cases the
    # matcher's `has` bookkeeping exists for, now crossing a group boundary.
    _t_same("");
    _t_same("/");
    _t_same("//");
    _t_same("/health/");
    _t_same("/api/v1/tools/");
    _t_same("/api/v1//tools");
    _t_same("/api/v1/crews//cancel");
    _t_same("/api/v1/crews/a/b/cancel");
    _t_same("/api/v1/crews/abc/cancel/extra");
    _t_same("/api/v1/dashboard");
    _t_same("/api/v1/dashboard/");
    _t_same("/api/v1/dashboard/crews/extra");

    # Nothing near the table at all.
    _t_same("/zzz");
    _t_same("/no/such/path/here");
    _t_same("/api/v1/nonesuch");
    _t_same("/api/v1/nonesuch/deeper");
    return 0;
}

# --- The two selectors, pinned directly ---------------------------------

# **What `_t_resolve_is_equivalent` cannot see.** Both selectors are filters:
# they choose which patterns get tried, and `_agnosai_path_matches_at` still
# decides what a trial answers. So a *loose* selector costs time without
# changing a route — making `_agnosai_seg_is` a bare prefix test degenerates
# the resolver back into the flat table it replaced and produces identical
# answers, and dropping the boundary check in `_agnosai_path_prefix_end` still
# 404s `/api/v1Xtools`, because `/tools` will not match `Xtools`.
#
# That is the safety property, and it is why the differential test passes under
# both mutations rather than a gap in it. But it means the differential cannot
# pin the **cost**, which is the entire reason the two-level structure exists.
# These assertions do that instead.
fn _t_selectors_are_exact(): i64 {
    var p = str_from("/api/v1/crews/abc");

    # `/api/v1` ends at the `/` before `crews`.
    assert(_agnosai_path_prefix_end(p, "/api/v1") == 7,
    "the prefix ends at the separator that begins the remainder");
    assert(_agnosai_path_prefix_end(str_from("/api/v1"), "/api/v1") == 0 - 1,
    "the bare prefix has no remainder");
    assert(_agnosai_path_prefix_end(str_from("/api/v1x/tools"), "/api/v1") == 0 - 1,
    "the prefix must end on a segment boundary — otherwise every /api/v1* path \
    enters the group scan and pays for it");
    assert(_agnosai_path_prefix_end(str_from("/api/v2/tools"), "/api/v1") == 0 - 1,
    "a differing byte inside the prefix is not the prefix");
    assert(_agnosai_path_prefix_end(str_from("/api"), "/api/v1") == 0 - 1,
    "a path shorter than the prefix is not the prefix");
    assert(_agnosai_path_prefix_end(str_from("/api/v1/"), "/api/v1") == 7,
    "a trailing separator IS a remainder — one empty segment, which matches \
    nothing and 404s");

    # The group selector matches a whole segment, never a prefix of one.
    assert(_agnosai_seg_is(p, 7, "crews") == 1, "the segment is crews");
    assert(_agnosai_seg_is(p, 7, "crew") == 0, "...not a prefix of it");
    assert(_agnosai_seg_is(p, 7, "crewss") == 0, "...nor an extension of it");
    assert(_agnosai_seg_is(str_from("/api/v1/crewsX"), 7, "crews") == 0,
    "a longer segment is a different segment — a prefix test here would drag \
    every /api/v1/crews* path through all four crews patterns");
    assert(_agnosai_seg_is(str_from("/api/v1/crews"), 7, "crews") == 1,
    "a segment at the end of the path still matches");
    assert(_agnosai_seg_is(str_from("/api/v1/"), 7, "crews") == 0,
    "an empty segment matches no group");
    assert(_agnosai_seg_is(str_from("/api/v1/dashboard/crews"), 7, "dashboard") == 1,
    "and the selector reads only its own segment, not what follows");
    return 0;
}

fn main(): i64 {
    alloc_init();
    sakshi_set_level(SK_FATAL);

    _t_table();
    _t_probes_are_public();
    _t_everything_else_is_protected();
    _t_auth_gate_runs();
    _t_routing_precedes_auth();
    _t_body_limit_is_outermost();
    _t_method_mismatch_is_405();
    _t_path_params();
    _t_param_reaches_the_handler();
    _t_dispatch();
    _t_stream_is_501_not_404();
    _t_partial_segments_do_not_match();
    _t_matching_is_allocation_free();
    _t_resolve_is_equivalent();
    _t_selectors_are_exact();

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
