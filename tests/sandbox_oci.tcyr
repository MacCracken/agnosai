# =========================================================================
# sandbox_oci — parity tests for src/sandbox/oci.cyr (the pure half).
#
# Seven of the oracle's eight tests port directly. The eighth,
# `missing_runtime_returns_error`, needs a real spawn and lands with the spawn
# primitive.
#
# Where this goes past the oracle:
#
#   * **The argv.** The oracle builds its command line inside `execute` and
#     cannot assert on it, so `--read-only`, `--tmpfs /tmp` and
#     `--network=none` — the isolation posture — are untested there. Here the
#     argv is a value, and every flag plus its ORDER is pinned.
#   * **The validator, character by character.** The oracle checks three
#     rejections and six acceptances. This adds the classes those six do not
#     reach: each shell metacharacter separately, embedded whitespace, and the
#     non-ASCII case where this port is deliberately stricter than Rust.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/strcase.cyr"
include "src/core/mod.cyr"
include "src/sandbox/mod.cyr"
include "tests/test_helpers.cyr"

# Whether `argv` contains `needle`, in order-independent form.
fn _t_argv_has(argv, needle): i64 {
    var i = 0;
    while (i < vec_len(argv)) {
        if (str_eq_cstr(vec_get(argv, i), needle) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# The index of `needle` in `argv`, or -1.
fn _t_argv_at(argv, needle): i64 {
    var i = 0;
    while (i < vec_len(argv)) {
        if (str_eq_cstr(vec_get(argv, i), needle) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# --- Config --------------------------------------------------------------

# `config_defaults`, `config_with_network`, `config_with_env`.
fn _t_oci_config(): i64 {
    var c = agnosai_oci_config_new(str_from("alpine:latest"));
    assert(str_eq_cstr(agnosai_oci_config_runtime(c), "docker") == 1, "runtime defaults to docker");
    assert(str_eq_cstr(agnosai_oci_config_image(c), "alpine:latest") == 1, "the image is kept");
    assert(str_eq_cstr(agnosai_oci_config_memory_limit(c), "256m") == 1, "256m memory default");
    assert(agnosai_oci_config_timeout_secs(c) == 60, "60 s timeout default");

    # The default that matters most: no network unless asked.
    assert(agnosai_oci_config_allow_network(c) == 0,
    "networking is OFF by default — the container gets --network=none");
    assert(vec_len(agnosai_oci_config_env(c)) == 0, "no env pairs by default");
    assert(vec_len(agnosai_oci_config_volumes(c)) == 0, "no volumes by default");

    agnosai_oci_config_set_allow_network(c, 1);
    assert(agnosai_oci_config_allow_network(c) == 1, "networking can be turned on");

    agnosai_oci_config_add_env(c, str_from("KEY"), str_from("VALUE"));
    assert(vec_len(agnosai_oci_config_env(c)) == 2, "an env pair is two entries: key then value");

    agnosai_oci_config_add_volume(c, str_from("/host:/container"));
    assert(vec_len(agnosai_oci_config_volumes(c)) == 1, "a volume is one entry");

    agnosai_oci_config_set_runtime(c, str_from("podman"));
    assert(str_eq_cstr(agnosai_oci_config_runtime(c), "podman") == 1, "the runtime is selectable");

    agnosai_oci_config_set_timeout_secs(c, 5);
    assert(agnosai_oci_config_timeout_secs(c) == 5, "the timeout is settable");
    agnosai_oci_config_set_memory_limit(c, str_from("1g"));
    assert(str_eq_cstr(agnosai_oci_config_memory_limit(c), "1g") == 1, "so is the memory limit");
    assert(_t_argv_has(agnosai_oci_build_argv(c, 0), "1g") == 1,
    "...and the new limit reaches the argv, not just the struct");

    # `set_image` does NOT validate — matching the oracle, where the field is
    # public and `OciSandbox::new` is the gate. The gate must still refuse it.
    agnosai_oci_config_set_image(c, str_from("--privileged"));
    assert(str_eq_cstr(agnosai_oci_config_image(c), "--privileged") == 1,
    "the setter stores whatever it is given, as the oracle's public field does");
    assert(agnosai_oci_sandbox_new(c) == 0,
    "...and the CONSTRUCTOR is what refuses it — the gate is not bypassable by setting after");
    return 0;
}

# --- Image validation ----------------------------------------------------

# `accepts_valid_image_refs` — the oracle's six, verbatim.
fn _t_oci_accepts_valid_images(): i64 {
    assert(agnosai_oci_validate_image_ref(str_from("alpine")) == 1, "bare name");
    assert(agnosai_oci_validate_image_ref(str_from("alpine:latest")) == 1, "name:tag");
    assert(agnosai_oci_validate_image_ref(str_from("ubuntu:22.04")) == 1, "a dotted tag");
    assert(agnosai_oci_validate_image_ref(
    str_from("registry.example.com/myapp:v1.2.3")) == 1, "registry host + path + tag");
    assert(agnosai_oci_validate_image_ref(
    str_from("ghcr.io/org/repo:sha-abc123")) == 1, "nested path with a hyphen");
    assert(agnosai_oci_validate_image_ref(
    str_from("myimage@sha256:abcdef1234567890")) == 1, "a digest reference");
    # **Underscore is General Category `Pc`**, so no alphanumeric branch covers
    # it — it depends entirely on its own line in the allowed set, and it was
    # the only member of the oracle's literal `-_./:#@` with no covering test.
    # Deleting that line refuses `library/my_image` outright, a hard
    # availability failure with nothing to catch it.
    assert(agnosai_oci_validate_image_ref(str_from("library/my_image:v1")) == 1,
    "an underscore is a legal reference character");

    # And each is constructible through the gate.
    assert(agnosai_oci_sandbox_new(agnosai_oci_config_new(str_from("alpine:latest"))) != 0,
    "a valid image builds a sandbox");
    return 0;
}

# `rejects_empty_image`, `rejects_image_with_flag_injection`,
# `rejects_image_with_shell_metacharacters` — plus the classes they miss.
fn _t_oci_rejects_bad_images(): i64 {
    assert(agnosai_oci_validate_image_ref(str_from("")) == 0, "an empty image is refused");
    assert(agnosai_oci_sandbox_new(agnosai_oci_config_new(str_from(""))) == 0,
    "...and the sandbox does not construct");

    # **Flag injection.** A leading `-` makes the image parse as an option.
    assert(agnosai_oci_validate_image_ref(str_from("--privileged")) == 0,
    "--privileged is refused — it would be a FLAG, not an image");
    assert(agnosai_oci_validate_image_ref(str_from("-v")) == 0, "so is a short flag");
    assert(agnosai_oci_validate_image_ref(str_from("-")) == 0, "and a bare hyphen");
    # ...but a hyphen anywhere else is legitimate.
    assert(agnosai_oci_validate_image_ref(str_from("my-image")) == 1,
    "a hyphen that does not LEAD is fine — it is common in real names");

    # **Argument/shell injection.** The oracle tests one; each is checked here,
    # because a validator that happened to allow just one of them is still
    # broken and the oracle's single case would not say which.
    assert(agnosai_oci_validate_image_ref(str_from("alpine; rm -rf /")) == 0,
    "a semicolon is refused — the oracle's own case");
    assert(agnosai_oci_validate_image_ref(str_from("alpine rm")) == 0, "so is a space");
    assert(agnosai_oci_validate_image_ref(str_from("alpine|cat")) == 0, "a pipe");
    assert(agnosai_oci_validate_image_ref(str_from("alpine&whoami")) == 0, "an ampersand");
    assert(agnosai_oci_validate_image_ref(str_from("alpine$(id)")) == 0, "command substitution");
    assert(agnosai_oci_validate_image_ref(str_from("alpine`id`")) == 0, "backticks");
    assert(agnosai_oci_validate_image_ref(str_from("alpine>out")) == 0, "a redirect");
    assert(agnosai_oci_validate_image_ref(str_from("alpine\nrm")) == 0, "an embedded newline");
    assert(agnosai_oci_validate_image_ref(str_from("alpine\trm")) == 0, "an embedded tab");
    assert(agnosai_oci_validate_image_ref(str_from("al'pine")) == 0, "a single quote");
    assert(agnosai_oci_validate_image_ref(str_from("al\"pine")) == 0, "a double quote");
    assert(agnosai_oci_validate_image_ref(str_from("alpine\\x")) == 0, "a backslash");

    # `#` IS allowed — `oci.rs:80` includes it, though the doc comment above it
    # does not list it. The code is the oracle.
    assert(agnosai_oci_validate_image_ref(str_from("alpine#1")) == 1,
    "'#' is allowed — the oracle's character set includes it, its comment omits it");
    return 0;
}

# **Unicode parity, not an ASCII shortcut.** Rust's `is_alphanumeric` is
# Unicode, so the oracle accepts non-ASCII letters — and so does this, via
# `unicode_category`. An ASCII-only validator was written first; it was tighter
# but diverged, and the safety argument for it did not hold: the reference goes
# into an argv element, never a shell string, so a homograph is just a name no
# registry resolves.
fn _t_oci_unicode_matches_the_oracle(): i64 {
    assert(agnosai_oci_validate_image_ref(str_from("caf\xc3\xa9:latest")) == 1,
    "a non-ASCII letter is ACCEPTED, as Rust's Unicode is_alphanumeric accepts it");
    assert(agnosai_oci_validate_image_ref(str_from("\xd0\xb0lpine")) == 1,
    "...including a Cyrillic homograph — docker is what refuses to resolve it");
    assert(agnosai_oci_validate_image_ref(str_from("alpine")) == 1,
    "and the ASCII spelling it imitates, obviously");

    # Non-letter non-ASCII is still refused: an emoji is category So, not
    # alphanumeric. This is the assertion that would fail if the port had
    # accepted "any byte >= 0x80" as a shortcut to looking Unicode-aware.
    assert(agnosai_oci_validate_image_ref(str_from("alpine\xf0\x9f\x92\xa9")) == 0,
    "a non-ASCII SYMBOL is still refused — the test is the category, not the byte width");
    assert(agnosai_oci_validate_image_ref(str_from("alpine\xc2\xa0x")) == 0,
    "...and so is a non-breaking space, which is Zs and would otherwise pass as 'not ASCII'");

    # Malformed UTF-8 decodes to U+FFFD (So) and is refused. The oracle cannot
    # express this case at all — a Rust &str cannot hold invalid UTF-8.
    assert(agnosai_oci_validate_image_ref(str_from("alp\xffine")) == 0,
    "malformed UTF-8 is refused, a case the oracle's &str cannot even represent");
    return 0;
}

# --- Argv ----------------------------------------------------------------

# **No oracle test reaches this.** The isolation flags and their order are what
# a container actually receives.
fn _t_oci_argv(): i64 {
    var c = agnosai_oci_config_new(str_from("alpine:latest"));
    var argv = agnosai_oci_build_argv(c, 0);

    assert(str_eq_cstr(vec_get(argv, 0), "docker") == 1, "argv[0] is the runtime");
    assert(str_eq_cstr(vec_get(argv, 1), "run") == 1, "then 'run'");
    assert(str_eq_cstr(vec_get(argv, 2), "--rm") == 1, "--rm: the container is ephemeral");
    assert(str_eq_cstr(vec_get(argv, 3), "-i") == 1, "-i: stdin is piped in");

    # The isolation posture.
    assert(_t_argv_has(argv, "--read-only") == 1, "--read-only rootfs");
    assert(_t_argv_has(argv, "--tmpfs") == 1, "--tmpfs...");
    assert(_t_argv_has(argv, "/tmp") == 1, "...on /tmp, the only writable path");
    assert(_t_argv_has(argv, "--memory") == 1, "--memory is passed");
    assert(_t_argv_has(argv, "256m") == 1, "...with the configured limit");
    assert(_t_argv_has(argv, "--network=none") == 1,
    "--network=none by default — the flag whose absence silently grants a network");

    # `--memory` must be immediately followed by its value, not merely present.
    assert(_t_argv_at(argv, "256m") == _t_argv_at(argv, "--memory") + 1,
    "the memory limit follows its flag");
    assert(_t_argv_at(argv, "/tmp") == _t_argv_at(argv, "--tmpfs") + 1,
    "and /tmp follows --tmpfs");

    # The image is LAST of the runtime's own arguments.
    assert(str_eq_cstr(vec_get(argv, vec_len(argv) - 1), "alpine:latest") == 1,
    "the image is last — everything after it would belong to the container");
    return 0;
}

fn _t_oci_argv_options(): i64 {
    var c = agnosai_oci_config_new(str_from("alpine"));
    agnosai_oci_config_set_allow_network(c, 1);
    var argv = agnosai_oci_build_argv(c, 0);
    assert(_t_argv_has(argv, "--network=none") == 0,
    "allowing the network REMOVES the flag rather than negating it");

    # env and volumes.
    var c2 = agnosai_oci_config_new(str_from("alpine"));
    agnosai_oci_config_add_env(c2, str_from("FOO"), str_from("bar"));
    agnosai_oci_config_add_volume(c2, str_from("/h:/c"));
    var a2 = agnosai_oci_build_argv(c2, 0);
    assert(_t_argv_has(a2, "--env") == 1, "--env is emitted");
    assert(_t_argv_has(a2, "FOO=bar") == 1, "...with the pair joined by '='");
    assert(_t_argv_has(a2, "-v") == 1, "-v is emitted");
    assert(_t_argv_has(a2, "/h:/c") == 1, "...with the mount spec verbatim");
    assert(_t_argv_at(a2, "FOO=bar") == _t_argv_at(a2, "--env") + 1, "the pair follows --env");
    # **Membership is not position, and for `-v` position is the whole thing.**
    # `docker` parses options only until the first non-option argument, so an
    # image emitted ahead of `-v` makes the mount the *container's* argv and the
    # volume is silently never applied. The audit of 2026-08-04 hoisted the
    # image above the volume loop and all 100 assertions passed, because the
    # `-v` pair was checked for membership only — unlike `--env`, which already
    # had its adjacency pinned on the line above.
    assert(_t_argv_at(a2, "/h:/c") == _t_argv_at(a2, "-v") + 1, "the mount spec follows its flag");
    assert(_t_argv_at(a2, "-v") < _t_argv_at(a2, "alpine"),
    "-v precedes the image — after it, docker reads the mount as container argv");
    assert(_t_argv_at(a2, "--env") < _t_argv_at(a2, "alpine"), "...and so does --env");
    assert(_t_argv_at(a2, "alpine") == vec_len(a2) - 1,
    "the image is last when there are no entrypoint arguments");

    # Entrypoint args come after the image.
    var ep = vec_new();
    vec_push(ep, str_from("python3"));
    vec_push(ep, str_from("-c"));
    var a3 = agnosai_oci_build_argv(agnosai_oci_config_new(str_from("alpine")), ep);
    assert(_t_argv_at(a3, "python3") > _t_argv_at(a3, "alpine"),
    "entrypoint arguments come AFTER the image, or the runtime would eat them");
    assert(str_eq_cstr(vec_get(a3, vec_len(a3) - 1), "-c") == 1, "and in the order given");
    return 0;
}

# --- Result --------------------------------------------------------------

fn _t_oci_result(): i64 {
    var r = agnosai_oci_result_new(str_from("out"), str_from("err"), 0, 0);
    assert(str_eq_cstr(agnosai_oci_result_stdout(r), "out") == 1, "stdout");
    assert(str_eq_cstr(agnosai_oci_result_stderr(r), "err") == 1, "stderr held separately");
    assert(agnosai_oci_result_exit_code(r) == 0, "exit code");
    assert(agnosai_oci_result_timed_out(r) == 0, "not timed out");

    # -1 is the oracle's `status.code().unwrap_or(-1)` — a signalled container
    # has no exit code, and 0 would report success.
    var k = agnosai_oci_result_new(str_from(""), str_from(""), 0 - 1, 1);
    assert(agnosai_oci_result_exit_code(k) == 0 - 1, "a signalled container is -1, never 0");
    assert(agnosai_oci_result_timed_out(k) == 1, "and a timeout is flagged");
    return 0;
}

# --- The error message ---------------------------------------------------

fn _t_oci_error_message(): i64 {
    assert(str_contains_cstr(agnosai_oci_image_error(str_from("")), "empty") == 1,
    "an empty image reports emptiness");
    assert(str_contains_cstr(
    agnosai_oci_image_error(str_from("--privileged")), "flag injection") == 1,
    "a leading hyphen reports flag injection, not a generic bad character");
    assert(str_contains_cstr(
    agnosai_oci_image_error(str_from("alpine;x")), "invalid character") == 1,
    "and anything else reports the character class");
    # **Naming the character**, as `oci.rs:82` does — it was dropped until
    # 2026-08-05, leaving an operator with a refused image and no way to tell
    # which byte of it was the problem.
    assert(str_eq_cstr(agnosai_oci_image_error(str_from("alpine;x")),
    "image name contains invalid character: ';'") == 1,
    "...and says WHICH character, end to end");
    assert(str_eq_cstr(agnosai_oci_image_error(str_from("alp ine")),
    "image name contains invalid character: ' '") == 1, "...including a space");
    # A multi-byte character comes back whole, not as its first byte — the
    # validator walks codepoints and so must the message.
    assert(str_contains_cstr(agnosai_oci_image_error(str_from("alpine\xe2\x80\x8b")),
    "\xe2\x80\x8b") == 1, "...and a multi-byte character is reported whole");
    return 0;
}

# --- Execution ------------------------------------------------------------

fn _t_oci_missing_runtime_returns_error(): i64 {
    # The oracle's `missing_runtime_returns_error`. No container runtime is
    # assumed present in a test environment, so a bogus one is the case that
    # can actually be asserted - and it is the one that matters, since a
    # missing runtime must not read as "the container ran and failed".
    var c = agnosai_oci_config_new(str_from("alpine:latest"));
    agnosai_oci_config_set_runtime(c, str_from("/nonexistent/runtime"));

    var args = vec_new();
    vec_push(args, str_from("echo"));
    vec_push(args, str_from("hi"));

    var e[8];
    store64(&e, 0);
    var r = agnosai_oci_execute(c, args, str_from(""), &e);
    assert(r == 0, "oracle missing_runtime_returns_error: execute() is an ERROR");
    assert(load64(&e) != 0, "...with an error set");
    assert(agnosai_error_kind(load64(&e)) == AGNOSAI_ERR_SANDBOX, "...a sandbox error");
    assert(str_contains_cstr(agnosai_error_message(load64(&e)), "/nonexistent/runtime") == 1,
    "...naming the runtime it could not spawn");
    return 0;
}

fn _t_oci_execute_runs_the_built_argv(): i64 {
    # There is no container runtime to test against, so `/bin/echo` stands in
    # as one: it accepts any arguments and prints them. That makes the whole
    # argv observable end-to-end - the flags a real runtime would consume are
    # simply echoed - and proves `execute` runs what `build_argv` built rather
    # than assembling a second argv of its own.
    var c = agnosai_oci_config_new(str_from("alpine:latest"));
    agnosai_oci_config_set_runtime(c, str_from("/bin/echo"));
    agnosai_oci_config_add_env(c, str_from("KEY"), str_from("value"));

    var args = vec_new();
    vec_push(args, str_from("entrypoint-arg"));

    var e[8];
    store64(&e, 0);
    var r = agnosai_oci_execute(c, args, str_from(""), &e);
    assert(load64(&e) == 0, "the runtime spawns");
    assert(agnosai_oci_result_exit_code(r) == 0, "...and exits cleanly");

    var out = agnosai_oci_result_stdout(r);
    assert(str_contains_cstr(out, "run --rm -i --read-only") == 1,
    "the isolation flags reach the runtime in the oracle's order");
    assert(str_contains_cstr(out, "--network=none") == 1, "networking is off by default");
    assert(str_contains_cstr(out, "--env KEY=value") == 1, "configured env is passed as --env");
    assert(str_contains_cstr(out, "alpine:latest entrypoint-arg") == 1,
    "the image precedes the entrypoint arguments, and both are last");
    return 0;
}

# Write an executable stand-in runtime and return its path.
#
# **A real runtime cannot be assumed present, and the obvious substitutes do
# not work**: `build_argv` puts `run --rm -i ...` in front of everything, so
# `cat` tries to open a file called `run` and `sleep` rejects it as a bad
# operand. A script that ignores `"$@"` is the only stand-in that behaves like
# a runtime accepting flags it understands.
fn _t_oci_fake_runtime(name, body): Str {
    var path = str_cat(str_from("/tmp/agnosai-oci-test-"), str_from(name));
    var p = str_cstr(path);
    var src = str_cat(str_cat(str_from("#!/bin/sh\n"), str_from(body)), str_from("\n"));
    file_write_all(p, str_data(src), str_len(src));
    sys_chmod(p, 493);
    return path;
}

fn _t_oci_execute_feeds_stdin_and_splits_streams(): i64 {
    var c = agnosai_oci_config_new(str_from("alpine:latest"));
    agnosai_oci_config_set_runtime(c,
    _t_oci_fake_runtime("io", "cat; echo container-err >&2"));

    var e[8];
    store64(&e, 0);
    var r = agnosai_oci_execute(c, vec_new(), str_from("piped to the container"), &e);
    assert(load64(&e) == 0, "the runtime spawns");
    assert(str_contains_cstr(agnosai_oci_result_stdout(r), "piped to the container") == 1,
    "input reaches the container's stdin and its output comes back");
    assert(str_contains_cstr(agnosai_oci_result_stderr(r), "container-err") == 1,
    "stderr is captured separately");
    assert(str_contains_cstr(agnosai_oci_result_stdout(r), "container-err") == 0,
    "...not merged into stdout");
    assert(agnosai_oci_result_timed_out(r) == 0, "and it did not time out");
    return 0;
}

# A runtime that stops draining stdin is logged and carried on with — and it
# must not take agnosai with it.
#
# **`oci.rs:158-162` only `warn!`s**, where `python.rs:92-95` propagates the
# error, so this asserts the opposite verdict to its python sibling on purpose:
# the container ran, and what it printed before it closed stdin is still its
# answer. Reaching the assertions at all is the other half — the audit of
# 2026-08-04 measured this exact shape exiting 141 (128+13, `SIGPIPE`) with no
# assertion output, because `agnosai_spawn_capture_input` wrote into a pipe with
# no reader and the default disposition kills the writer.
#
# 320,000 bytes because anything inside the 64 KiB pipe buffer is accepted by
# the kernel whether or not the runtime ever reads it.
fn _t_oci_runtime_that_stops_reading_stdin(): i64 {
    var sb = str_builder_new();
    var i = 0;
    while (i < 3200) {
        str_builder_add_cstr(sb,
        "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789");
        i = i + 1;
    }
    var big = str_builder_build(sb);
    assert(str_len(big) == 320000, "the payload is 320,000 bytes");

    var c = agnosai_oci_config_new(str_from("alpine:latest"));
    # Closes stdin and stays alive, so the write fails while the drain loop is
    # still running rather than racing the runtime's exit.
    agnosai_oci_config_set_runtime(c,
    _t_oci_fake_runtime("deaf", "exec 0<&-; sleep 1; echo ran-anyway"));

    var e[8];
    store64(&e, 0);
    var r = agnosai_oci_execute(c, vec_new(), big, &e);
    assert(load64(&e) == 0,
    "a runtime that stopped reading is NOT an error here — oci.rs warns and continues");
    assert(r != 0, "...it returns a result");
    if (r == 0) { return 0; }
    assert(str_contains_cstr(agnosai_oci_result_stdout(r), "ran-anyway") == 1,
    "...carrying everything the container wrote after it closed stdin");
    assert(agnosai_oci_result_timed_out(r) == 0, "...and it is not reported as a timeout");
    assert(agnosai_oci_result_exit_code(r) == 0, "...its own exit code stands");
    return 0;
}

# --- The runtime's environment -------------------------------------------
#
# **`_read_environ_envp()` at `oci.cyr` is a documented parity decision**, and
# the audit of 2026-08-04 found it pinned in neither direction: replacing it
# with `0` (no environment at all) ran 100/100, and so did replacing it with
# `agnosai_sanitized_envp()`. The value is load-bearing twice — the module
# header argues it explicitly ("the runtime inherits the server's environment
# unfiltered... filtering here would sanitize the wrong process"), and it is
# what supplies `DOCKER_HOST`, `XDG_RUNTIME_DIR`, `HOME` and `PATH` to a real
# docker or podman client.
#
# One assertion covers both directions, but it needs a variable the filter
# WOULD strip — and a test process has no `setenv`. So the suite re-execs
# itself through the spawn primitive, which does take an arbitrary `envp`.

# The marker that tells a re-exec'd copy of this binary what it is for.
var _T_OCI_REEXEC = "AGNOSAI_TEST_REEXEC=oci-envp";

# `DYLD_LIBRARY_PATH` is on `SANITIZED_ENV_VARS` and is **inert on Linux** —
# nothing reads it, so unlike `LD_PRELOAD` it plants no loader warnings in the
# captured streams while still being a variable the filter removes.
var _T_OCI_MARKER = "DYLD_LIBRARY_PATH=/tmp/agnosai-oci-marker";

fn _t_oci_is_reexec(): i64 {
    var src = _read_environ_envp();
    var i = 0;
    while (src != 0 && load64(src + i * 8) != 0) {
        if (streq(load64(src + i * 8), _T_OCI_REEXEC) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# What the re-exec'd copy does: run a container and print what it saw.
#
# It asserts nothing itself — the parent reads this on stdout and asserts there,
# so a failure names one assertion instead of nesting two tallies.
fn _t_oci_reexec_body(): i64 {
    var c = agnosai_oci_config_new(str_from("alpine:latest"));
    agnosai_oci_config_set_runtime(c, _t_oci_fake_runtime("env", "env"));
    var e[8];
    store64(&e, 0);
    var r = agnosai_oci_execute(c, vec_new(), str_from(""), &e);
    if (r == 0) { return println("CHILD-FAILED-TO-RUN"); }
    return println_str(agnosai_oci_result_stdout(r));
}

fn _t_oci_runtime_inherits_the_unfiltered_environment(): i64 {
    var src = _read_environ_envp();
    var n = 0;
    while (src != 0 && load64(src + n * 8) != 0) { n = n + 1; }

    var envp = alloc((n + 3) * 8);
    var i = 0;
    while (i < n) {
        store64(envp + i * 8, load64(src + i * 8));
        i = i + 1;
    }
    store64(envp + n * 8, _T_OCI_REEXEC);
    store64(envp + (n + 1) * 8, _T_OCI_MARKER);
    store64(envp + (n + 2) * 8, 0);

    var argv = alloc(16);
    store64(argv, "/proc/self/exe");
    store64(argv + 8, 0);
    var r = agnosai_spawn_capture_input("/proc/self/exe", argv, envp, str_from(""), 30000, 0);
    assert(agnosai_spawn_status(r) == AGNOSAI_SPAWN_OK, "the suite re-execs itself");

    var out = agnosai_spawn_stdout(r);
    assert(str_contains_cstr(out, "CHILD-FAILED-TO-RUN") == 0, "...and the child ran a container");
    assert(str_contains_cstr(out, "PATH=") == 1,
    "the runtime gets an environment at all — envp 0 would give it none");
    assert(str_contains_cstr(out, "/tmp/agnosai-oci-marker") == 1,
    "...and it is the UNFILTERED one: a variable the sandbox filter strips still reaches the \
    container runtime, because filtering here would sanitize the wrong process");
    return 0;
}

fn _t_oci_execute_timeout(): i64 {
    # `timeout_secs` is the oracle's unit and the primitive takes milliseconds -
    # a missing x1000 would make every container time out a thousand times early.
    var c = agnosai_oci_config_new(str_from("alpine:latest"));
    agnosai_oci_config_set_runtime(c, _t_oci_fake_runtime("slow", "echo early; echo early-err >&2; sleep 30"));
    agnosai_oci_config_set_timeout_secs(c, 1);

    var e[8];
    store64(&e, 0);
    var t0 = clock_now_ms();
    var r = agnosai_oci_execute(c, vec_new(), str_from(""), &e);
    var dt = clock_now_ms() - t0;

    assert(load64(&e) == 0, "a timeout is a result, not an error");
    assert(agnosai_oci_result_timed_out(r) == 1, "the container was killed on its deadline");
    assert(agnosai_oci_result_exit_code(r) == 0 - 1, "...reporting -1");
    # The runtime PRODUCES output before it hangs, so blanking is observable -
    # a version that returned what it drained would show "early" here.
    assert(str_len(agnosai_oci_result_stdout(r)) == 0,
    "...with output blanked, as oci.rs:180-186 does");
    assert(str_len(agnosai_oci_result_stderr(r)) == 0, "...both streams");
    assert(dt >= 900, "the deadline is SECONDS, not milliseconds - 1s, not 1ms");
    assert(dt < 10000, "...and it fired rather than hanging");
    return 0;
}

fn main(): i64 {
    alloc_init();
    sakshi_set_level(SK_FATAL);

    # A re-exec'd copy runs one thing and prints it — see
    # `_t_oci_runtime_inherits_the_unfiltered_environment`.
    if (_t_oci_is_reexec() == 1) { return _t_oci_reexec_body(); }

    _t_oci_config();
    _t_oci_accepts_valid_images();
    _t_oci_rejects_bad_images();
    _t_oci_unicode_matches_the_oracle();
    _t_oci_argv();
    _t_oci_argv_options();
    _t_oci_result();
    _t_oci_error_message();
    _t_oci_missing_runtime_returns_error();
    _t_oci_execute_runs_the_built_argv();
    _t_oci_execute_feeds_stdin_and_splits_streams();
    _t_oci_runtime_that_stops_reading_stdin();
    _t_oci_runtime_inherits_the_unfiltered_environment();
    _t_oci_execute_timeout();

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
