# =========================================================================
# core_resource.tcyr — parity tests for src/core/resource.cyr
#
# Oracle: the 19 non-hwaccel #[cfg(test)] tests in
# rust-old/src/core/resource.rs. The 9 `#[cfg(feature = "hwaccel")]` tests
# defer with that feature — it is not in the default build.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/core/error.cyr"
include "src/core/json.cyr"
include "src/id.cyr"
include "src/core/message.cyr"
include "src/core/resource.cyr"
include "tests/test_helpers.cyr"

# A vec holding one accelerator type.
fn _t_accels1(a): i64 {
    var v = vec_new();
    vec_push(v, a);
    return v;
}

# A vec holding two accelerator types.
fn _t_accels2(a, b): i64 {
    var v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    return v;
}

# A vec holding one device.
fn _t_devices1(d): i64 {
    var v = vec_new();
    vec_push(v, d);
    return v;
}

fn main() {
    alloc_init();

    test_group("core_resource");

    # --- resource_budget_default_values ---
    var bd = agnosai_resource_budget_default();
    assert_eq(agnosai_resource_budget_max_tokens(bd), AGNOSAI_NO_LIMIT, "default max_tokens is none");
    assert_eq(agnosai_resource_budget_max_cost_micro_usd(bd), AGNOSAI_NO_LIMIT, "default max_cost is none");
    assert_eq(agnosai_resource_budget_max_duration_secs(bd), AGNOSAI_NO_LIMIT, "default duration is none");
    assert_eq(agnosai_resource_budget_max_concurrent_tasks(bd), 10, "default concurrency is 10");

    # --- money is integer micro-USD, and the wire form matches serde's f64 ---
    var b2 = agnosai_resource_budget_new(1000, 2500, 60, 4);
    assert_eq(agnosai_resource_budget_max_cost_micro_usd(b2), 2500, "cost stored as micro-USD");
    var cost_v = bayan_json_v_obj_get(agnosai_resource_budget_to_value(b2), "max_cost_usd");
    assert(str_eq(bayan_json_v_build(cost_v), str_from("0.0025")) == 1,
      "2500 micro-USD renders as 0.0025, byte-identical to serde");

    var whole = agnosai_resource_budget_new(AGNOSAI_NO_LIMIT, 5000000, AGNOSAI_NO_LIMIT, AGNOSAI_NO_LIMIT);
    var whole_v = bayan_json_v_obj_get(agnosai_resource_budget_to_value(whole), "max_cost_usd");
    assert(str_eq(bayan_json_v_build(whole_v), str_from("5.0")) == 1,
      "5000000 micro-USD renders as 5.0, matching serde");
    _t_assert_f64(agnosai_micro_usd_to_f64(2500), f64_div(f64_from(25), f64_from(10000)),
      "agnosai_micro_usd_to_f64 converts to dollars");
    assert_eq(agnosai_f64_to_micro_usd(f64_div(f64_from(25), f64_from(10000))), 2500,
      "agnosai_f64_to_micro_usd rounds back to the exact micro amount");

    # micro-USD arithmetic is exact where repeated f64 addition would drift
    var acc = 0;
    for (var i = 0; i < 10; i = i + 1) { acc = acc + 100000; }
    assert_eq(acc, 1000000, "ten 0.1 USD charges sum to exactly 1.000000 USD");

    # --- resource_budget_serde_round_trip ---
    var b2_back = agnosai_resource_budget_from_value(agnosai_resource_budget_to_value(b2));
    assert_eq(agnosai_resource_budget_max_tokens(b2_back), 1000, "max_tokens survives");
    assert_eq(agnosai_resource_budget_max_cost_micro_usd(b2_back), 2500, "micro-USD cost survives exactly");
    assert_eq(agnosai_resource_budget_max_duration_secs(b2_back), 60, "duration survives");
    assert_eq(agnosai_resource_budget_max_concurrent_tasks(b2_back), 4, "concurrency survives");

    # --- resource_budget_serde_with_none_fields ---
    var bnone = agnosai_resource_budget_new(AGNOSAI_NO_LIMIT, AGNOSAI_NO_LIMIT, AGNOSAI_NO_LIMIT,
      AGNOSAI_NO_LIMIT);
    var bnone_v = agnosai_resource_budget_to_value(bnone);
    assert_eq(bayan_json_v_is_null(bayan_json_v_obj_get(bnone_v, "max_tokens")), 1, "unset max_tokens is null");
    assert_eq(bayan_json_v_is_null(bayan_json_v_obj_get(bnone_v, "max_cost_usd")), 1, "unset cost is null");
    var bnone_back = agnosai_resource_budget_from_value(bnone_v);
    assert_eq(agnosai_resource_budget_max_tokens(bnone_back), AGNOSAI_NO_LIMIT, "null max_tokens round-trips");
    assert_eq(agnosai_resource_budget_max_cost_micro_usd(bnone_back), AGNOSAI_NO_LIMIT, "null cost round-trips");

    # --- accelerator_type_serde_round_trip_all_variants ---
    var all_ok = 1;
    for (var a = AGNOSAI_ACCEL_CPU; a <= AGNOSAI_ACCEL_TPU; a = a + 1) {
        if (agnosai_accelerator_type_from_wire(agnosai_accelerator_type_to_wire(a)) != a) { all_ok = 0; }
    }
    assert(all_ok, "every accelerator type round-trips through its wire spelling");
    assert(str_eq(agnosai_accelerator_type_to_wire(AGNOSAI_ACCEL_CUDA), str_from("cuda")) == 1, "wire cuda");
    assert(str_eq(agnosai_accelerator_type_to_wire(AGNOSAI_ACCEL_ROCM), str_from("rocm")) == 1, "wire rocm");
    assert(str_eq(agnosai_accelerator_family_to_wire(AGNOSAI_FAMILY_AI_ASIC), str_from("ai_asic")) == 1,
      "AiAsic renders snake_case as ai_asic");

    var fam_ok = 1;
    for (var g = AGNOSAI_FAMILY_CPU; g <= AGNOSAI_FAMILY_AI_ASIC; g = g + 1) {
        if (agnosai_accelerator_family_from_wire(agnosai_accelerator_family_to_wire(g)) != g) { fam_ok = 0; }
    }
    assert(fam_ok, "every accelerator family round-trips");

    # --- accelerator_type_family / is_gpu ---
    assert_eq(agnosai_accelerator_family_of(AGNOSAI_ACCEL_CPU), AGNOSAI_FAMILY_CPU, "cpu family");
    assert_eq(agnosai_accelerator_family_of(AGNOSAI_ACCEL_CUDA), AGNOSAI_FAMILY_GPU, "cuda is gpu family");
    assert_eq(agnosai_accelerator_family_of(AGNOSAI_ACCEL_ROCM), AGNOSAI_FAMILY_GPU, "rocm is gpu family");
    assert_eq(agnosai_accelerator_family_of(AGNOSAI_ACCEL_METAL), AGNOSAI_FAMILY_GPU, "metal is gpu family");
    assert_eq(agnosai_accelerator_family_of(AGNOSAI_ACCEL_VULKAN), AGNOSAI_FAMILY_GPU, "vulkan is gpu family");
    assert_eq(agnosai_accelerator_family_of(AGNOSAI_ACCEL_TPU), AGNOSAI_FAMILY_TPU, "tpu family");
    assert_eq(agnosai_accelerator_is_gpu(AGNOSAI_ACCEL_CUDA), 1, "cuda is_gpu");
    assert_eq(agnosai_accelerator_is_gpu(AGNOSAI_ACCEL_CPU), 0, "cpu is not gpu");
    assert_eq(agnosai_accelerator_is_gpu(AGNOSAI_ACCEL_TPU), 0, "tpu is not gpu");
    assert_eq(agnosai_accelerator_is_tpu(AGNOSAI_ACCEL_TPU), 1, "tpu is_tpu");

    # --- compute_device_serde_round_trip ---
    var dev = agnosai_compute_device_new(0, str_from("NVIDIA A100"), AGNOSAI_ACCEL_CUDA, 40960);
    assert_eq(agnosai_compute_device_memory_available_mb(dev), 40960, "available defaults to total");
    agnosai_compute_device_with_available(dev, 20480);
    assert_eq(agnosai_compute_device_memory_available_mb(dev), 20480, "with_available overrides");
    var dev_back = agnosai_compute_device_from_value(agnosai_compute_device_to_value(dev));
    assert(dev_back != 0, "device round-trips");
    assert_eq(agnosai_compute_device_index(dev_back), 0, "device index survives");
    assert(str_eq(agnosai_compute_device_name(dev_back), str_from("NVIDIA A100")) == 1, "device name survives");
    assert_eq(agnosai_compute_device_accelerator(dev_back), AGNOSAI_ACCEL_CUDA, "device accelerator survives");
    assert_eq(agnosai_compute_device_memory_total_mb(dev_back), 40960, "device total memory survives");
    assert_eq(agnosai_compute_device_memory_available_mb(dev_back), 20480, "device available memory survives");

    # --- hardware_requirement_default_is_empty ---
    var req0 = agnosai_hw_requirement_new();
    assert_eq(vec_len(agnosai_hw_requirement_accelerators(req0)), 0, "default accelerators empty");
    assert_eq(agnosai_hw_requirement_min_memory_mb(req0), 0, "default min memory 0");
    assert_eq(agnosai_hw_requirement_min_device_count(req0), 0, "default min devices 0");
    assert_eq(agnosai_hw_requirement_min_cpu_cores(req0), 0, "default min cores 0");
    assert_eq(agnosai_hw_requirement_required_family(req0), AGNOSAI_NO_LIMIT, "default family unset");

    # required_family is skip_serializing_if none — omitted, not null
    var req0_v = agnosai_hw_requirement_to_value(req0);
    assert_eq(bayan_json_v_obj_get(req0_v, "required_family"), 0, "unset required_family is omitted entirely");
    var reqf = agnosai_hw_requirement_with_family(agnosai_hw_requirement_new(), AGNOSAI_FAMILY_GPU);
    assert(bayan_json_v_obj_get(agnosai_hw_requirement_to_value(reqf), "required_family") != 0,
      "set required_family is emitted");

    # --- hardware_inventory_satisfies_cpu_only_requirement ---
    var cpu_inv = agnosai_hw_inventory_new(8, 16384, vec_new());
    assert_eq(agnosai_hw_inventory_satisfies(cpu_inv, agnosai_hw_requirement_new()), 1,
      "empty requirement is satisfied by a CPU-only node");
    var need4 = agnosai_hw_requirement_with_min_cpu_cores(agnosai_hw_requirement_new(), 4);
    assert_eq(agnosai_hw_inventory_satisfies(cpu_inv, need4), 1, "8 cores satisfies min 4");
    var need16 = agnosai_hw_requirement_with_min_cpu_cores(agnosai_hw_requirement_new(), 16);
    assert_eq(agnosai_hw_inventory_satisfies(cpu_inv, need16), 0, "8 cores fails min 16");

    # --- hardware_inventory_satisfies_cuda_gpu_requirement ---
    var cuda_dev = agnosai_compute_device_new(0, str_from("A100"), AGNOSAI_ACCEL_CUDA, 40960);
    var gpu_inv = agnosai_hw_inventory_new(16, 65536, _t_devices1(cuda_dev));
    var need_cuda = agnosai_hw_requirement_for_accelerators(_t_accels1(AGNOSAI_ACCEL_CUDA));
    assert_eq(agnosai_hw_inventory_satisfies(gpu_inv, need_cuda), 1, "cuda node satisfies a cuda requirement");
    var need_tpu = agnosai_hw_requirement_for_accelerators(_t_accels1(AGNOSAI_ACCEL_TPU));
    assert_eq(agnosai_hw_inventory_satisfies(gpu_inv, need_tpu), 0, "cuda node fails a tpu requirement");
    assert_eq(agnosai_hw_inventory_satisfies(cpu_inv, need_cuda), 0, "cpu-only node fails a cuda requirement");

    # --- min_memory_mb / min_device_count checks ---
    var big = agnosai_hw_requirement_with_min_memory(
      agnosai_hw_requirement_for_accelerators(_t_accels1(AGNOSAI_ACCEL_CUDA)), 80000);
    assert_eq(agnosai_hw_inventory_satisfies(gpu_inv, big), 0, "40GB device fails an 80GB requirement");
    var fits = agnosai_hw_requirement_with_min_memory(
      agnosai_hw_requirement_for_accelerators(_t_accels1(AGNOSAI_ACCEL_CUDA)), 32768);
    assert_eq(agnosai_hw_inventory_satisfies(gpu_inv, fits), 1, "40GB device satisfies a 32GB requirement");
    var two = agnosai_hw_requirement_with_min_devices(
      agnosai_hw_requirement_for_accelerators(_t_accels1(AGNOSAI_ACCEL_CUDA)), 2);
    assert_eq(agnosai_hw_inventory_satisfies(gpu_inv, two), 0, "one device fails a min-2 requirement");

    # --- satisfies_with_required_family_any_gpu ---
    var rocm_dev = agnosai_compute_device_new(1, str_from("MI300"), AGNOSAI_ACCEL_ROCM, 65536);
    var mixed = vec_new();
    vec_push(mixed, cuda_dev);
    vec_push(mixed, rocm_dev);
    var mixed_inv = agnosai_hw_inventory_new(32, 131072, mixed);
    var any_gpu = agnosai_hw_requirement_with_family(agnosai_hw_requirement_new(), AGNOSAI_FAMILY_GPU);
    assert_eq(agnosai_hw_inventory_satisfies(mixed_inv, any_gpu), 1, "any-GPU matches without enumerating types");
    assert_eq(agnosai_hw_inventory_satisfies(cpu_inv, any_gpu), 0, "any-GPU fails on a CPU-only node");
    var any_tpu = agnosai_hw_requirement_with_family(agnosai_hw_requirement_new(), AGNOSAI_FAMILY_TPU);
    assert_eq(agnosai_hw_inventory_satisfies(mixed_inv, any_tpu), 0, "any-TPU fails with only GPUs present");

    # family matching ignores the accelerators list entirely (the oracle returns
    # from the family branch before reaching type matching)
    var fam_over_type = agnosai_hw_requirement_with_family(
      agnosai_hw_requirement_for_accelerators(_t_accels1(AGNOSAI_ACCEL_TPU)), AGNOSAI_FAMILY_GPU);
    assert_eq(agnosai_hw_inventory_satisfies(mixed_inv, fam_over_type), 1,
      "required_family short-circuits the accelerators list");

    # --- satisfies_family_with_memory_requirement ---
    var fam_mem = agnosai_hw_requirement_with_min_memory(
      agnosai_hw_requirement_with_family(agnosai_hw_requirement_new(), AGNOSAI_FAMILY_GPU), 65536);
    assert_eq(agnosai_hw_inventory_satisfies(mixed_inv, fam_mem), 1,
      "the 64GB ROCm device meets the family memory bar");
    var fam_mem_big = agnosai_hw_requirement_with_min_memory(
      agnosai_hw_requirement_with_family(agnosai_hw_requirement_new(), AGNOSAI_FAMILY_GPU), 131072);
    assert_eq(agnosai_hw_inventory_satisfies(mixed_inv, fam_mem_big), 0, "no single GPU meets a 128GB bar");
    var fam_count = agnosai_hw_requirement_with_min_devices(
      agnosai_hw_requirement_with_family(agnosai_hw_requirement_new(), AGNOSAI_FAMILY_GPU), 3);
    assert_eq(agnosai_hw_inventory_satisfies(mixed_inv, fam_count), 0, "two GPUs fail a min-3 family requirement");

    # --- hardware_inventory_satisfies_empty_accelerators_any_ok ---
    var empty_req = agnosai_hw_requirement_for_accelerators(vec_new());
    assert_eq(agnosai_hw_inventory_satisfies(mixed_inv, empty_req), 1, "an empty accelerator list matches anything");

    # --- devices_of_type / total_memory_mb ---
    assert_eq(vec_len(agnosai_hw_inventory_devices_of_type(mixed_inv, AGNOSAI_ACCEL_CUDA)), 1,
      "one cuda device found");
    assert_eq(vec_len(agnosai_hw_inventory_devices_of_type(mixed_inv, AGNOSAI_ACCEL_TPU)), 0, "no tpu devices");
    assert_eq(agnosai_hw_inventory_total_memory_mb(mixed_inv, AGNOSAI_ACCEL_CUDA), 40960, "cuda memory total");
    assert_eq(agnosai_hw_inventory_total_memory_mb(mixed_inv, AGNOSAI_ACCEL_ROCM), 65536, "rocm memory total");
    assert_eq(agnosai_hw_inventory_total_memory_mb(mixed_inv, AGNOSAI_ACCEL_TPU), 0, "absent type totals 0");

    # --- hardware requirement + inventory round-trips ---
    var rreq = agnosai_hw_requirement_with_min_cpu_cores(agnosai_hw_requirement_with_min_devices(
        agnosai_hw_requirement_with_min_memory(
          agnosai_hw_requirement_for_accelerators(_t_accels2(AGNOSAI_ACCEL_CUDA, AGNOSAI_ACCEL_TPU)), 16384), 1), 4);
    var rreq_back = agnosai_hw_requirement_from_value(agnosai_hw_requirement_to_value(rreq));
    assert_eq(vec_len(agnosai_hw_requirement_accelerators(rreq_back)), 2, "2 accelerators survive");
    assert_eq(agnosai_hw_requirement_min_memory_mb(rreq_back), 16384, "min memory survives");
    assert_eq(agnosai_hw_requirement_min_device_count(rreq_back), 1, "min device count survives");
    assert_eq(agnosai_hw_requirement_min_cpu_cores(rreq_back), 4, "min cpu cores survives");
    assert_eq(agnosai_hw_requirement_required_family(rreq_back), AGNOSAI_NO_LIMIT, "omitted family stays unset");

    var inv_back = agnosai_hw_inventory_from_value(agnosai_hw_inventory_to_value(mixed_inv));
    assert_eq(agnosai_hw_inventory_cpu_cores(inv_back), 32, "inventory cpu cores survive");
    assert_eq(agnosai_hw_inventory_memory_total_mb(inv_back), 131072, "inventory memory survives");
    assert_eq(vec_len(agnosai_hw_inventory_devices(inv_back)), 2, "inventory devices survive");

    # --- gpu_device_serde_round_trip ---
    var gpu = agnosai_gpu_device_new(0, str_from("NVIDIA A100"), 40960, 20480);
    var gpu_back = agnosai_gpu_device_from_value(agnosai_gpu_device_to_value(gpu));
    assert(gpu_back != 0, "gpu device round-trips");
    assert_eq(agnosai_gpu_device_index(gpu_back), 0, "gpu index survives");
    assert(str_eq(agnosai_gpu_device_name(gpu_back), str_from("NVIDIA A100")) == 1, "gpu name survives");
    assert_eq(agnosai_gpu_device_vram_total_mb(gpu_back), 40960, "gpu vram total survives");
    assert_eq(agnosai_gpu_device_vram_available_mb(gpu_back), 20480, "gpu vram available survives");


    # [6.5.5] every `_a` form agrees with its global twin — the correctness claim
    # the whole allocator-threading rests on, and the only thing that would catch
    # a substitution that silently changed a value rather than just its home.
    var tw_ar = arena_allocator(262144);
    assert_eq(str_eq(agnosai_accelerator_family_to_wire_a(tw_ar, AGNOSAI_FAMILY_GPU),
        agnosai_accelerator_family_to_wire(AGNOSAI_FAMILY_GPU)), 1,
      "accelerator_family_to_wire_a agrees with its twin");
    assert_eq(str_eq(agnosai_accelerator_type_to_wire_a(tw_ar, AGNOSAI_ACCEL_CUDA),
        agnosai_accelerator_type_to_wire(AGNOSAI_ACCEL_CUDA)), 1,
      "accelerator_type_to_wire_a agrees");
    assert_eq(str_eq(bayan_json_v_build(agnosai_resource_budget_to_value_a(tw_ar, bd)),
        bayan_json_v_build(agnosai_resource_budget_to_value(bd))), 1,
      "resource_budget_to_value_a agrees byte-for-byte");
    var tw_hw = agnosai_hw_requirement_new();
    assert_eq(str_eq(bayan_json_v_build(agnosai_hw_requirement_to_value_a(tw_ar, tw_hw)),
        bayan_json_v_build(agnosai_hw_requirement_to_value(tw_hw))), 1,
      "hw_requirement_to_value_a agrees");
    var tw_inv = agnosai_hw_inventory_new(8, 16384, vec_new());
    assert_eq(str_eq(bayan_json_v_build(agnosai_hw_inventory_to_value_a(tw_ar, tw_inv)),
        bayan_json_v_build(agnosai_hw_inventory_to_value(tw_inv))), 1,
      "hw_inventory_to_value_a agrees");
    var tw_dev = agnosai_compute_device_new(0, str_from("d0"), AGNOSAI_ACCEL_CUDA, 8192);
    assert_eq(str_eq(bayan_json_v_build(agnosai_compute_device_to_value_a(tw_ar, tw_dev)),
        bayan_json_v_build(agnosai_compute_device_to_value(tw_dev))), 1,
      "compute_device_to_value_a agrees");
    var tw_gpu = agnosai_gpu_device_new(0, str_from("g0"), 8192, 4096);
    assert_eq(str_eq(bayan_json_v_build(agnosai_gpu_device_to_value_a(tw_ar, tw_gpu)),
        bayan_json_v_build(agnosai_gpu_device_to_value(tw_gpu))), 1,
      "gpu_device_to_value_a agrees");
    # --- hwaccel ----------------------------------------------------------
    # The oracle's four `#[cfg(feature = "hwaccel")]` tests plus its five
    # `mod training_tests`, and what they leave open. Every body under test is an
    # adapter over ai-hwaccel, so what is asserted is the WIRING — the enum
    # narrowing, the CPU diversion, the units — not the library's policy.
    test_group("core_resource hwaccel");

    # --- Oracle: hwaccel_accelerator_type_mapping -------------------------
    assert_eq(agnosai_accelerator_type_from_hwaccel(ACCEL_CPU), AGNOSAI_ACCEL_CPU,
      "CPU maps to CPU");
    assert_eq(agnosai_accelerator_type_from_hwaccel(ACCEL_CUDA), AGNOSAI_ACCEL_CUDA,
      "CUDA maps to CUDA");
    assert_eq(agnosai_accelerator_type_from_hwaccel(ACCEL_ROCM), AGNOSAI_ACCEL_ROCM,
      "ROCm maps to ROCm");
    assert_eq(agnosai_accelerator_type_from_hwaccel(ACCEL_METAL), AGNOSAI_ACCEL_METAL,
      "Metal maps to Metal");
    assert_eq(agnosai_accelerator_type_from_hwaccel(ACCEL_VULKAN), AGNOSAI_ACCEL_VULKAN,
      "Vulkan maps to Vulkan");

    # ⚠ **THE one that a pass-through gets wrong.** ai-hwaccel numbers
    # `ACCEL_TPU = 8` and agnosai numbers `AGNOSAI_ACCEL_TPU = 5`; the five
    # above are 0-4 on both sides and survive a bare cast, so a cast is right
    # five times out of six and turns every TPU into an Intel NPU.
    assert_eq(agnosai_accelerator_type_from_hwaccel(ACCEL_TPU), AGNOSAI_ACCEL_TPU,
      "TPU maps to TPU, which the identity mapping gets WRONG");
    assert_neq(ACCEL_TPU, AGNOSAI_ACCEL_TPU,
      "because the two enums genuinely disagree on TPU's number");

    # ⚠ NPUs and ASICs fall back to CPU — the oracle's `_ => Self::Cpu`.
    assert_eq(agnosai_accelerator_type_from_hwaccel(ACCEL_INTEL_NPU), AGNOSAI_ACCEL_CPU,
      "an Intel NPU falls back to CPU");
    assert_eq(agnosai_accelerator_type_from_hwaccel(ACCEL_GROQ), AGNOSAI_ACCEL_CPU,
      "and a Groq LPU");
    # Past the oracle: every one of the thirteen unmapped variants, so a
    # partial catch-all cannot hide.
    var fell_back = 0;
    var unmapped = vec_new();
    vec_push(unmapped, ACCEL_INTEL_NPU);
    vec_push(unmapped, ACCEL_AMD_XDNA);
    vec_push(unmapped, ACCEL_APPLE_NPU);
    vec_push(unmapped, ACCEL_GAUDI);
    vec_push(unmapped, ACCEL_NEURON);
    vec_push(unmapped, ACCEL_QUALCOMM);
    vec_push(unmapped, ACCEL_INTEL_ONEAPI);
    vec_push(unmapped, ACCEL_CEREBRAS);
    vec_push(unmapped, ACCEL_GRAPHCORE);
    vec_push(unmapped, ACCEL_GROQ);
    vec_push(unmapped, ACCEL_SAMSUNG_NPU);
    vec_push(unmapped, ACCEL_MEDIATEK_APU);
    vec_push(unmapped, ACCEL_WIN_GPU);
    for (var u = 0; u < vec_len(unmapped); u = u + 1) {
        if (agnosai_accelerator_type_from_hwaccel(vec_get(unmapped, u))
          == AGNOSAI_ACCEL_CPU) { fell_back = fell_back + 1; }
    }
    assert_eq(fell_back, 13, "all thirteen unmapped variants fall back to CPU");

    # ⚠ CPU is the fallback SPECIFICALLY so an NPU still matches CPU work and
    # never matches a GPU requirement it cannot serve.
    assert_eq(agnosai_accelerator_family_of(
        agnosai_accelerator_type_from_hwaccel(ACCEL_CEREBRAS)), AGNOSAI_FAMILY_CPU,
      "so an unmapped accelerator lands in the CPU family, not the GPU one");

    # --- Oracle: hwaccel_inventory_from_registry --------------------------
    var reg = hw_registry_new();
    reg_add_profile(reg, profile_cpu(64 * 1024 * 1024 * 1024));
    reg_add_profile(reg, profile_cuda(0, 80 * 1024 * 1024 * 1024));
    reg_add_profile(reg, profile_cuda(1, 80 * 1024 * 1024 * 1024));
    var inv = agnosai_hw_inventory_from_hwaccel(reg);

    assert_eq(agnosai_hw_inventory_memory_total_mb(inv), 64 * 1024,
      "the CPU profile's memory becomes SYSTEM memory");
    assert(agnosai_hw_inventory_cpu_cores(inv) > 0, "and cpu_cores is populated");
    assert_eq(vec_len(agnosai_hw_inventory_devices(inv)), 2,
      "the two CUDA profiles become devices");
    # ⚠ The CPU profile is NOT among them.
    assert_eq(agnosai_compute_device_accelerator(
        vec_get(agnosai_hw_inventory_devices(inv), 0)), AGNOSAI_ACCEL_CUDA,
      "the first device is CUDA, not the CPU");
    assert_eq(agnosai_compute_device_accelerator(
        vec_get(agnosai_hw_inventory_devices(inv), 1)), AGNOSAI_ACCEL_CUDA,
      "and so is the second");
    assert_eq(agnosai_compute_device_memory_total_mb(
        vec_get(agnosai_hw_inventory_devices(inv), 0)), 80 * 1024,
      "with bytes converted to MiB");
    assert_eq(agnosai_compute_device_memory_total_mb(
        vec_get(agnosai_hw_inventory_devices(inv), 1)), 80 * 1024, "on both");

    # Past the oracle:
    # ⚠ `index` is the REGISTRY position, not a running device count. The CPU
    # sits at 0, so the first real device is index 1 and index 0 never appears.
    assert_eq(agnosai_compute_device_index(
        vec_get(agnosai_hw_inventory_devices(inv), 0)), 1,
      "the first device's index is its REGISTRY position, so 1 — not 0");
    assert_eq(agnosai_compute_device_index(
        vec_get(agnosai_hw_inventory_devices(inv), 1)), 2, "and the second is 2");

    # ⚠ An absent `memory_free` falls back to the TOTAL, not to zero.
    assert_eq(agnosai_compute_device_memory_available_mb(
        vec_get(agnosai_hw_inventory_devices(inv), 0)), 80 * 1024,
      "an unknown free-memory reading falls back to the total, not to 0");

    # The device name comes from ai-hwaccel's own naming.
    assert(str_len(agnosai_compute_device_name(
          vec_get(agnosai_hw_inventory_devices(inv), 0))) > 0, "and the device is named");

    # --- Oracle: hwaccel_empty_registry_gives_cpu_only --------------------
    var cpu_only = hw_registry_new();
    reg_add_profile(cpu_only, profile_cpu(16 * 1024 * 1024 * 1024));
    var cinv = agnosai_hw_inventory_from_hwaccel(cpu_only);
    assert_eq(vec_len(agnosai_hw_inventory_devices(cinv)), 0,
      "a CPU-only registry yields NO devices");
    assert_eq(agnosai_hw_inventory_memory_total_mb(cinv), 16 * 1024,
      "and its memory is the system total");

    # A wholly empty registry is neither an error nor a crash.
    var none = agnosai_hw_inventory_from_hwaccel(hw_registry_new());
    assert_eq(vec_len(agnosai_hw_inventory_devices(none)), 0, "an EMPTY registry has none");
    assert_eq(agnosai_hw_inventory_memory_total_mb(none), 0, "and no system memory");
    assert_eq(agnosai_hw_inventory_cpu_cores(none), 0,
      "and no cores — cpu_cores is only set by a CPU profile");

    # ⚠ `available_parallelism` never answers 0, matching `unwrap_or(1)`. A zero
    # would make `satisfies` reject every requirement naming any CPU cores.
    assert(_agnosai_available_parallelism() >= 1,
      "available_parallelism is at least 1, never 0");

    # ⚠ The FALLBACK arm is unreachable on this box — Linux x86, where
    # `sched_getaffinity` always succeeds — so it is driven as data. Without
    # this, a fallback of 0 instead of 1 passes every assertion above.
    assert_eq(_agnosai_cores_from_affinity(0 - 1, 0), 1,
      "a failed sched_getaffinity falls back to ONE, not zero");
    assert_eq(_agnosai_cores_from_affinity(0, 0), 1, "and so does an empty answer");

    # A real mask counts set bits, and only across the bytes the kernel wrote.
    var m[16];
    store64(&m, 7);
    store64(&m + 8, 0 - 1);
    assert_eq(_agnosai_cores_from_affinity(8, &m), 3,
      "three set bits in the first word is three cores");
    assert_eq(_agnosai_cores_from_affinity(16, &m), 67,
      "and the second word counts only when the kernel says it was written");
    # An all-zero mask is not zero cores — it falls back.
    var mz[8];
    store64(&mz, 0);
    assert_eq(_agnosai_cores_from_affinity(8, &mz), 1,
      "an all-zero mask falls back to one rather than reporting zero cores");

    # ⚠ `detect()` has NO test in the oracle, gated or otherwise, and it cannot
    # have a value-asserting one anywhere: it shells out to `nvidia-smi` and
    # friends, so what it answers depends on the box. What IS assertable is that
    # the shell-out path completes and yields a WELL-FORMED inventory — which is
    # the failure this would otherwise hide, since a crash or a null in
    # `registry_detect` would go unnoticed until a deployment.
    var detected = agnosai_hw_inventory_detect();
    assert_neq(detected, 0, "detect() returns an inventory on any box");
    assert(agnosai_hw_inventory_cpu_cores(detected) >= 0, "with a non-negative core count");
    assert(agnosai_hw_inventory_memory_total_mb(detected) >= 0, "and non-negative memory");
    assert_neq(agnosai_hw_inventory_devices(detected), 0, "and a real device vec");
    # Every device it did find is well-formed and carries a mapped type.
    var bad_devices = 0;
    for (var d = 0; d < vec_len(agnosai_hw_inventory_devices(detected)); d = d + 1) {
        var dev = vec_get(agnosai_hw_inventory_devices(detected), d);
        if (agnosai_compute_device_accelerator(dev) > AGNOSAI_ACCEL_TPU) {
            bad_devices = bad_devices + 1;
        }
        if (agnosai_compute_device_accelerator(dev) < AGNOSAI_ACCEL_CPU) {
            bad_devices = bad_devices + 1;
        }
    }
    assert_eq(bad_devices, 0,
      "and every detected device carries one of the SIX mapped types, never a raw ai-hwaccel one");

    # --- Oracle: mod training_tests ---------------------------------------
    var full = agnosai_training_memory_estimate(7000, TRAIN_FULL, TARGET_GPU);
    var zero = f64_from(0);
    assert(f64_gt(agnosai_training_memory_total_gb(full), zero), "a 7B full fine-tune totals > 0");
    assert(f64_gt(agnosai_training_memory_model_gb(full), zero), "with model memory > 0");
    assert(f64_gt(agnosai_training_memory_optimizer_gb(full), zero), "and optimizer > 0");
    assert(f64_ge(agnosai_training_memory_total_gb(full),
        agnosai_training_memory_model_gb(full)), "and the total is at least the model alone");

    var lora = agnosai_training_memory_estimate(7000, TRAIN_LORA, TARGET_GPU);
    assert(f64_lt(agnosai_training_memory_total_gb(lora),
        agnosai_training_memory_total_gb(full)), "LoRA uses less than a full fine-tune");
    var qlora = agnosai_training_memory_estimate(7000, TRAIN_QLORA_4, TARGET_GPU);
    assert(f64_lt(agnosai_training_memory_total_gb(qlora),
        agnosai_training_memory_total_gb(lora)), "and QLoRA less than LoRA");

    # ⚠ GB as f64. ai-hwaccel answers in x1000 FIXED-POINT integers, so storing
    # them raw would make a 14 GB model read 14000 — and every ordering
    # assertion above would still pass, because the scale is uniform.
    assert(f64_lt(agnosai_training_memory_total_gb(full), f64_from(1000)),
      "the total is GB, not ai-hwaccel's x1000 fixed point");
    assert(f64_gt(agnosai_training_memory_total_gb(full), f64_from(1)),
      "and it is a real magnitude, not a truncated zero");

    # The total is exactly the three parts summed.
    _t_assert_f64(agnosai_training_memory_total_gb(full),
      f64_add(f64_add(agnosai_training_memory_model_gb(full),
          agnosai_training_memory_optimizer_gb(full)),
        agnosai_training_memory_activation_gb(full)),
      "the total is the three components summed");

    # --- Oracle: fits_in_inventory ----------------------------------------
    var big_dev = vec_new();
    vec_push(big_dev, agnosai_compute_device_new(0, str_from("A100 80GB"),
        AGNOSAI_ACCEL_CUDA, 81920));
    var big_inv = agnosai_hw_inventory_new(8, 65536, big_dev);
    assert_eq(agnosai_training_memory_fits_in(lora, big_inv), 1,
      "a 7B LoRA fits in an 80 GB GPU");

    var small_dev = vec_new();
    vec_push(small_dev, agnosai_compute_device_new(0, str_from("Small GPU"),
        AGNOSAI_ACCEL_CUDA, 4096));
    var small_inv = agnosai_hw_inventory_new(4, 16384, small_dev);
    assert_eq(agnosai_training_memory_fits_in(lora, small_inv), 0,
      "and does not fit in a 4 GB one");

    # ⚠ **DEVICE VRAM ONLY.** `memory_total_mb` is right there and is system
    # RAM; summing it instead would make this inventory — 512 GB of RAM, no GPU
    # — fit anything at all.
    var ramrich = agnosai_hw_inventory_new(64, 524288, vec_new());
    assert_eq(agnosai_training_memory_fits_in(lora, ramrich), 0,
      "a machine with 512 GB of RAM and NO GPU fits nothing");

    # ⚠ `<=`, so an estimate EXACTLY equal to available VRAM fits.
    #
    # Testing that needs an estimate whose total is a whole number of MiB, and
    # `total_gb * 1024` is generally fractional — truncating it lands just
    # BELOW the boundary and would assert the opposite of what is meant. So
    # search for a model size that lands on one. Without this the `<` and `<=`
    # versions are indistinguishable, because equality is the only input they
    # disagree on.
    var mb1024 = f64_from(1024);
    var exact_est = 0;
    var exact_mb = 0;
    for (var m = 1000; m < 30000; m = m + 1) {
        var e = agnosai_training_memory_estimate(m, TRAIN_LORA, TARGET_GPU);
        var mbf = f64_mul(agnosai_training_memory_total_gb(e), mb1024);
        var mbi = f64_to(mbf);
        if (f64_eq(mbf, f64_from(mbi)) == 1) {
            exact_est = e;
            exact_mb = mbi;
            break;
        }
    }
    assert_neq(exact_est, 0, "some model size lands on a whole MiB boundary");
    var exact_dev = vec_new();
    vec_push(exact_dev, agnosai_compute_device_new(0, str_from("exact"),
        AGNOSAI_ACCEL_CUDA, exact_mb));
    assert_eq(agnosai_training_memory_fits_in(exact_est,
        agnosai_hw_inventory_new(1, 0, exact_dev)), 1,
      "an estimate EXACTLY equal to available VRAM fits — the comparison is <=, not <");

    # And one MiB less does not, so the boundary really is where it looks.
    var short_dev = vec_new();
    vec_push(short_dev, agnosai_compute_device_new(0, str_from("one short"),
        AGNOSAI_ACCEL_CUDA, exact_mb - 1));
    assert_eq(agnosai_training_memory_fits_in(exact_est,
        agnosai_hw_inventory_new(1, 0, short_dev)), 0, "and one MiB short does not");

    # VRAM sums ACROSS devices — one 80 GB card and two 40 GB cards both fit.
    var split = vec_new();
    vec_push(split, agnosai_compute_device_new(0, str_from("a"), AGNOSAI_ACCEL_CUDA, 40960));
    vec_push(split, agnosai_compute_device_new(1, str_from("b"), AGNOSAI_ACCEL_CUDA, 40960));
    assert_eq(agnosai_training_memory_fits_in(lora, agnosai_hw_inventory_new(8, 0, split)), 1,
      "and VRAM is summed across devices");

    # --- Oracle: total_bytes_consistent -----------------------------------
    assert(agnosai_training_memory_total_bytes(full) > 0, "the total in bytes is positive");
    assert_eq(agnosai_training_memory_total_bytes(full),
      f64_to(f64_mul(agnosai_training_memory_total_gb(full), f64_from(1073741824))),
      "and is GB x 1024^3, truncated");
    assert(agnosai_training_memory_total_bytes(full)
      > agnosai_training_memory_total_bytes(lora),
      "a bigger estimate is more bytes");

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
