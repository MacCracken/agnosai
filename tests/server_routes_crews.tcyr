# =========================================================================
# server_routes_crews — rust-old/src/server/routes/crews.rs, validation half.
#
# All **six** of the oracle's plain `#[test]` functions live in this half and
# all six port here (`validate_rejects_empty_name`, `_missing_tasks`,
# `_self_dependency`, `_out_of_range_dependency`, `_dependency_cycle`,
# `validate_accepts_valid_dag`). The four `#[tokio::test]`s belong to the
# handlers, which are bite 11b.
#
# The oracle has no test at all for the request READERS — serde generated them —
# so `deny_unknown_fields` on two types, the `Option` vs required distinction,
# and every wrong-type rejection are covered here for the first time.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
# telemetry — `tools/native` and `orchestrator/crew_runner` record GenAI
# spans (ADR 017), so every suite that reaches them needs the module that
# defines the recorder. It depends on nothing in `src/` except `id`.
include "src/telemetry/mod.cyr"
include "src/core/mod.cyr"
include "src/learning/mod.cyr"
include "src/llm/mod.cyr"
include "src/server/ssrf.cyr"
include "src/server/prompt_guard.cyr"
include "src/server/output_filter.cyr"
include "src/server/prometheus.cyr"
include "src/server/auth.cyr"
include "src/guarded_fetch.cyr"
include "src/chan_lossy.cyr"
include "src/server/sse.cyr"
include "src/tools/mod.cyr"
include "src/orchestrator/mod.cyr"
include "src/server/state.cyr"
include "src/server/routes/mod.cyr"
include "src/server/routes/health.cyr"
include "src/server/routes/tools.cyr"
include "src/server/routes/agents.cyr"
include "src/server/routes/approval.cyr"
include "src/server/routes/dashboard.cyr"
include "src/server/routes/crews.cyr"
include "tests/test_helpers.cyr"

# Parse a JSON body — length from the Str, never hardcoded.
fn _t_parse(src: Str): i64 {
    return bayan_json_v_parse_buf(str_data(src), str_len(src));
}

# The oracle's `make_agent()`.
fn _t_agent(): i64 {
    return agnosai_agent_new(str_from("a1"), str_from("role"), str_from("goal"));
}

# A request with `n` tasks and one agent, no dependencies.
fn _t_req(name, n): i64 {
    var r = agnosai_crew_req_new(str_from(name));
    vec_push(agnosai_crew_req_agents(r), _t_agent());
    for (var i = 0; i < n; i = i + 1) {
        vec_push(agnosai_crew_req_tasks(r), agnosai_task_req_new(str_from("do it")));
    }
    return r;
}

# Add a dependency edge: task `from` depends on task `to`.
fn _t_dep(r, from, to): i64 {
    vec_push(agnosai_task_req_dependencies(vec_get(agnosai_crew_req_tasks(r), from)), to);
    return r;
}

fn _t_str_of(n, ch): Str {
    var sb = str_builder_new();
    for (var i = 0; i < n; i = i + 1) { str_builder_putc(sb, ch); }
    return str_builder_build(sb);
}

# --- The oracle's six sync tests -----------------------------------------

# Oracle: `validate_rejects_empty_name`.
fn _t_rejects_empty_name(): i64 {
    var r = _t_req("", 1);
    var e = agnosai_validate_crew_request(r);
    assert(e != 0, "an empty name is rejected");
    assert(str_contains(e, str_from("name must be 1-")) == 1, "...with the oracle's message");
    assert(str_contains(e, str_from("10000")) == 1, "...naming the cap");

    # And the other end of the same check.
    var long = agnosai_crew_req_new(_t_str_of(AGNOSAI_CREW_MAX_STRING_LEN + 1, 97));
    vec_push(agnosai_crew_req_agents(long), _t_agent());
    vec_push(agnosai_crew_req_tasks(long), agnosai_task_req_new(str_from("d")));
    assert(agnosai_validate_crew_request(long) != 0, "an over-long name is rejected");

    # Exactly at the cap is accepted — the boundary the `>` guards.
    var at = agnosai_crew_req_new(_t_str_of(AGNOSAI_CREW_MAX_STRING_LEN, 97));
    vec_push(agnosai_crew_req_agents(at), _t_agent());
    vec_push(agnosai_crew_req_tasks(at), agnosai_task_req_new(str_from("d")));
    assert(agnosai_validate_crew_request(at) == 0, "a name exactly at the cap is accepted");
    return 0;
}

# Oracle: `validate_rejects_missing_tasks`.
fn _t_rejects_missing_tasks(): i64 {
    var r = _t_req("crew", 0);
    var e = agnosai_validate_crew_request(r);
    assert(e != 0, "no tasks is rejected");
    assert(str_eq(e, str_from("at least one task is required")) == 1,
    "...with the oracle's exact message");
    return 0;
}

# The agents arm of the same shape — the oracle tests it through the handler
# (`post_crews_with_empty_agents_returns_bad_request`) rather than directly.
fn _t_rejects_missing_agents(): i64 {
    var r = agnosai_crew_req_new(str_from("crew"));
    vec_push(agnosai_crew_req_tasks(r), agnosai_task_req_new(str_from("d")));
    assert(str_eq(agnosai_validate_crew_request(r),
    str_from("at least one agent is required")) == 1, "no agents is rejected");

    # Order matters and is the oracle's: agents are checked before tasks, so a
    # request missing both reports the AGENT message.
    var both = agnosai_crew_req_new(str_from("crew"));
    assert(str_eq(agnosai_validate_crew_request(both),
    str_from("at least one agent is required")) == 1,
    "with both missing, the agent message wins — the oracle's check order");
    return 0;
}

# Oracle: `validate_rejects_self_dependency`.
fn _t_rejects_self_dependency(): i64 {
    var r = _t_req("crew", 2);
    _t_dep(r, 1, 1);
    var e = agnosai_validate_crew_request(r);
    assert(e != 0, "a self-dependency is rejected");
    assert(str_contains(e, str_from("task 1: self-dependency")) == 1,
    "...with the oracle's indexed message");
    return 0;
}

# Oracle: `validate_rejects_out_of_range_dependency`.
fn _t_rejects_out_of_range_dependency(): i64 {
    var r = _t_req("crew", 2);
    _t_dep(r, 0, 5);
    var e = agnosai_validate_crew_request(r);
    assert(e != 0, "an out-of-range dependency is rejected");
    assert(str_contains(e, str_from("task 0: dependency index 5 out of range")) == 1,
    "...with the oracle's indexed message");

    # The boundary: index == len is out of range, index == len-1 is not.
    var edge = _t_req("crew", 2);
    _t_dep(edge, 0, 2);
    assert(agnosai_validate_crew_request(edge) != 0, "index == task count is out of range");
    var ok = _t_req("crew", 2);
    _t_dep(ok, 0, 1);
    assert(agnosai_validate_crew_request(ok) == 0, "index == count-1 is in range");
    return 0;
}

# Oracle: `validate_rejects_dependency_cycle`.
fn _t_rejects_dependency_cycle(): i64 {
    var r = _t_req("crew", 2);
    _t_dep(r, 0, 1);
    _t_dep(r, 1, 0);
    var e = agnosai_validate_crew_request(r);
    assert(e != 0, "a two-node cycle is rejected");
    assert(str_eq(e, str_from("task dependencies contain a cycle")) == 1,
    "...with the oracle's message");

    # A longer cycle, so a detector that only catches the 2-cycle fails.
    var three = _t_req("crew", 3);
    _t_dep(three, 0, 1);
    _t_dep(three, 1, 2);
    _t_dep(three, 2, 0);
    assert(agnosai_validate_crew_request(three) != 0, "a three-node cycle is rejected");
    return 0;
}

# Oracle: `validate_accepts_valid_dag`.
fn _t_accepts_valid_dag(): i64 {
    var r = _t_req("crew", 3);
    _t_dep(r, 1, 0);
    _t_dep(r, 2, 0);
    _t_dep(r, 2, 1);
    assert(agnosai_validate_crew_request(r) == 0, "a valid DAG is accepted");

    # A diamond, which a naive visited-set (rather than in-progress) detector
    # would wrongly call a cycle: 3 depends on 1 and 2, both of which depend on 0.
    var d = _t_req("crew", 4);
    _t_dep(d, 1, 0);
    _t_dep(d, 2, 0);
    _t_dep(d, 3, 1);
    _t_dep(d, 3, 2);
    assert(agnosai_validate_crew_request(d) == 0,
    "a diamond is a DAG, not a cycle — the in-progress/done distinction");
    return 0;
}

# --- The cycle detector on its own ---------------------------------------

# The oracle exposes `has_dependency_cycle` as `pub(crate)` and tests it
# indirectly. Driven directly here, including the `dep < n` guard that
# `validate_crew_request` would otherwise have made unreachable.
fn _t_cycle_detector_direct(): i64 {
    var empty = vec_new();
    assert(agnosai_crew_has_dependency_cycle(empty) == 0, "no tasks, no cycle");

    var one = vec_new();
    vec_push(one, agnosai_task_req_new(str_from("a")));
    assert(agnosai_crew_has_dependency_cycle(one) == 0, "one task, no deps, no cycle");
    vec_push(agnosai_task_req_dependencies(vec_get(one, 0)), 0);
    assert(agnosai_crew_has_dependency_cycle(one) == 1, "a self-loop is a cycle");

    # Out-of-range deps are skipped rather than crashing — the `dep < n` guard.
    var oor = vec_new();
    vec_push(oor, agnosai_task_req_new(str_from("a")));
    vec_push(agnosai_task_req_dependencies(vec_get(oor, 0)), 99);
    assert(agnosai_crew_has_dependency_cycle(oor) == 0,
    "an out-of-range dependency is skipped, not followed");

    # A long chain, so the shared state vec proves it is not re-walking roots.
    var chain = vec_new();
    for (var i = 0; i < 200; i = i + 1) {
        vec_push(chain, agnosai_task_req_new(str_from("t")));
    }
    for (var j = 1; j < 200; j = j + 1) {
        vec_push(agnosai_task_req_dependencies(vec_get(chain, j)), j - 1);
    }
    assert(agnosai_crew_has_dependency_cycle(chain) == 0, "a 200-long chain is acyclic");
    vec_push(agnosai_task_req_dependencies(vec_get(chain, 0)), 199);
    assert(agnosai_crew_has_dependency_cycle(chain) == 1,
    "...and closing it into a ring is a cycle");
    return 0;
}

# The shape that makes the `state == 2` memoization matter: each task depends on
# the previous two, so the number of distinct paths from the last node is
# Fibonacci in the node count. With memoization this is O(V+E); without it, a
# 45-node version is ~10^9 visits — inside the oracle's 1000-task cap and
# reachable from an unauthenticated body.
#
# **This test cannot fail on a de-memoized implementation**, only take
# unboundedly longer, so it does not stand in for a mutation kill. It is here to
# exercise the shape and to keep a concrete example of why the mark is not
# redundant. See the note on `agnosai_crew_has_dependency_cycle`.
fn _t_cycle_memoization_shape(): i64 {
    var n = 32;
    var tasks = vec_new();
    for (var i = 0; i < n; i = i + 1) {
        vec_push(tasks, agnosai_task_req_new(str_from("t")));
    }
    for (var j = 2; j < n; j = j + 1) {
        vec_push(agnosai_task_req_dependencies(vec_get(tasks, j)), j - 1);
        vec_push(agnosai_task_req_dependencies(vec_get(tasks, j)), j - 2);
    }
    assert(agnosai_crew_has_dependency_cycle(tasks) == 0,
    "a Fibonacci-shaped dependency graph is acyclic");

    # And closing it is still detected on the same shape.
    vec_push(agnosai_task_req_dependencies(vec_get(tasks, 0)), n - 1);
    assert(agnosai_crew_has_dependency_cycle(tasks) == 1,
    "...and a back-edge through it is a cycle");
    return 0;
}

# --- Caps ----------------------------------------------------------------

fn _t_caps(): i64 {
    assert(AGNOSAI_CREW_MAX_AGENTS == 100, "the oracle's agent cap");
    assert(AGNOSAI_CREW_MAX_TASKS == 1000, "the oracle's task cap");
    assert(AGNOSAI_CREW_MAX_STRING_LEN == 10000, "the oracle's string cap");

    var r = agnosai_crew_req_new(str_from("crew"));
    for (var i = 0; i < AGNOSAI_CREW_MAX_AGENTS + 1; i = i + 1) {
        vec_push(agnosai_crew_req_agents(r), _t_agent());
    }
    vec_push(agnosai_crew_req_tasks(r), agnosai_task_req_new(str_from("d")));
    assert(str_contains(agnosai_validate_crew_request(r),
    str_from("at most 100 agents allowed")) == 1, "101 agents is rejected");

    # An over-long agent field.
    var f = _t_req("crew", 1);
    vec_push(agnosai_crew_req_agents(f), agnosai_agent_new(
    _t_str_of(AGNOSAI_CREW_MAX_STRING_LEN + 1, 98), str_from("r"), str_from("g")));
    assert(str_contains(agnosai_validate_crew_request(f),
    str_from("agent 1: field exceeds max length")) == 1,
    "an over-long agent_key is rejected, naming its index");

    # An over-long task description.
    var t = _t_req("crew", 1);
    vec_push(agnosai_crew_req_tasks(t),
    agnosai_task_req_new(_t_str_of(AGNOSAI_CREW_MAX_STRING_LEN + 1, 99)));
    assert(str_contains(agnosai_validate_crew_request(t),
    str_from("task 1: description exceeds max length")) == 1,
    "an over-long description is rejected, naming its index");
    return 0;
}

# --- The readers, which the oracle never tests ---------------------------

fn _t_task_req_reader(): i64 {
    var ok = _t_parse(str_from(
    "{\"description\":\"d\",\"expected_output\":\"e\",\"priority\":\"high\",\"dependencies\":[0,2]}"));
    var t = agnosai_task_req_from_value(ok);
    assert(t != 0, "a full TaskRequest reads");
    assert(str_eq(agnosai_task_req_description(t), str_from("d")) == 1, "description");
    assert(str_eq(agnosai_task_req_expected_output(t), str_from("e")) == 1, "expected_output");
    assert(agnosai_task_req_priority(t) == AGNOSAI_PRIORITY_HIGH, "priority");
    assert(agnosai_task_req_has_priority(t) == 1, "...and it was present");
    assert(vec_len(agnosai_task_req_dependencies(t)) == 2, "dependencies");

    # Only `description` is required.
    var min = agnosai_task_req_from_value(
    _t_parse(str_from("{\"description\":\"d\"}")));
    assert(min != 0, "description alone is enough");
    assert(agnosai_task_req_expected_output(min) == 0, "expected_output defaults to absent");
    assert(agnosai_task_req_has_priority(min) == 0, "priority defaults to absent");
    assert(agnosai_task_req_priority(min) == AGNOSAI_PRIORITY_NORMAL,
    "...reading as Normal, which is TaskPriority's own default");
    assert(vec_len(agnosai_task_req_dependencies(min)) == 0, "dependencies defaults to empty");
    return 0;
}

fn _t_task_req_rejections(): i64 {
    assert(agnosai_task_req_from_value(
    _t_parse(str_from("{}"))) == 0, "no description is rejected");
    assert(agnosai_task_req_from_value(
    _t_parse(str_from("{\"description\":1}"))) == 0,
    "a non-string description is rejected");
    assert(agnosai_task_req_from_value(bayan_json_v_arr_new()) == 0,
    "an array is not a TaskRequest");

    # `deny_unknown_fields`.
    assert(agnosai_task_req_from_value(_t_parse(str_from(
    "{\"description\":\"d\",\"nope\":1}"))) == 0, "an unknown field is rejected");

    # **`priority` is validated, not coerced.** `agnosai_task_priority_from_wire`
    # would silently answer Normal for "urgent"; serde rejects it.
    assert(agnosai_task_req_from_value(_t_parse(str_from("{\"description\":\"d\",\"priority\":\"urgent\"}"))) == 0,
    "an unknown priority is rejected, NOT coerced to Normal");
    assert(agnosai_task_priority_from_wire(str_from("urgent")) == AGNOSAI_PRIORITY_NORMAL,
    "...even though from_wire on its own would answer Normal");

    # `dependencies: Vec<usize>` — negatives and non-integers do not deserialize.
    assert(agnosai_task_req_from_value(_t_parse(str_from("{\"description\":\"d\",\"dependencies\":[-1]}"))) == 0,
    "a negative dependency index is rejected");
    assert(agnosai_task_req_from_value(_t_parse(str_from("{\"description\":\"d\",\"dependencies\":[\"a\"]}"))) == 0,
    "a non-integer dependency is rejected");
    assert(agnosai_task_req_from_value(_t_parse(str_from("{\"description\":\"d\",\"dependencies\":5}"))) == 0,
    "a non-array dependencies is rejected");
    return 0;
}

fn _t_crew_req_reader(): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"name\":\"c\",\"agents\":[{\"agent_key\":\"k\",");
    str_builder_add_cstr(sb, "\"name\":\"n\",\"role\":\"r\",\"goal\":\"g\"}],");
    str_builder_add_cstr(sb, "\"tasks\":[{\"description\":\"d\"}],");
    str_builder_add_cstr(sb, "\"process\":\"dag\",\"max_concurrency\":8}");
    var body = str_builder_build(sb);
    var r = agnosai_crew_req_from_value(_t_parse(body));
    assert(r != 0, "a full CrewRunRequest reads");
    assert(str_eq(agnosai_crew_req_name(r), str_from("c")) == 1, "name");
    assert(vec_len(agnosai_crew_req_agents(r)) == 1, "one agent");
    assert(vec_len(agnosai_crew_req_tasks(r)) == 1, "one task");
    assert(str_eq(agnosai_crew_req_process(r), str_from("dag")) == 1, "process");
    assert(agnosai_crew_req_max_concurrency(r) == 8, "max_concurrency");
    assert(agnosai_crew_req_has_concurrency(r) == 1, "...and it was present");
    assert(agnosai_validate_crew_request(r) == 0, "...and the whole thing validates");
    return 0;
}

fn _t_crew_req_rejections(): i64 {
    # `agents` and `tasks` are REQUIRED — no `#[serde(default)]` on either — so
    # an absent one is a deserialization failure, not an empty vec that would
    # reach validation and produce a different (400, specific) answer.
    assert(agnosai_crew_req_from_value(_t_parse(str_from(
    "{\"name\":\"c\",\"tasks\":[]}"))) == 0, "missing agents is rejected");
    assert(agnosai_crew_req_from_value(_t_parse(str_from(
    "{\"name\":\"c\",\"agents\":[]}"))) == 0, "missing tasks is rejected");
    assert(agnosai_crew_req_from_value(_t_parse(str_from(
    "{\"agents\":[],\"tasks\":[]}"))) == 0, "missing name is rejected");

    # But present-and-empty DOES read, and is validation's problem, not serde's.
    var e = agnosai_crew_req_from_value(_t_parse(str_from("{\"name\":\"c\",\"agents\":[],\"tasks\":[]}")));
    assert(e != 0, "present-but-empty agents/tasks deserialize fine");
    assert(agnosai_validate_crew_request(e) != 0, "...and are caught by validation instead");

    assert(agnosai_crew_req_from_value(_t_parse(str_from("{\"name\":\"c\",\"agents\":[],\"tasks\":[],\"x\":1}"))) == 0,
    "an unknown field is rejected");
    assert(agnosai_crew_req_from_value(_t_parse(str_from("{\"name\":\"c\",\"agents\":[{}],\"tasks\":[]}"))) == 0,
    "an invalid agent inside the array is rejected");
    assert(agnosai_crew_req_from_value(_t_parse(str_from("{\"name\":\"c\",\"agents\":[],\"tasks\":[{}]}"))) == 0,
    "an invalid task inside the array is rejected");
    assert(agnosai_crew_req_from_value(_t_parse(str_from(
    "{\"name\":\"c\",\"agents\":[],\"tasks\":[],\"max_concurrency\":-1}"))) == 0,
    "a negative max_concurrency is rejected");
    return 0;
}

# **`process` is NOT validated by the reader**, unlike `priority`. The oracle
# types it `Option<String>` and matches with a `_ => Sequential` catch-all after
# deserialization, so an unrecognised name is accepted and silently runs
# sequentially. Rejecting it here would be the divergence.
fn _t_process_is_not_validated(): i64 {
    var r = agnosai_crew_req_from_value(_t_parse(str_from(
    "{\"name\":\"c\",\"agents\":[],\"tasks\":[],\"process\":\"nonsense\"}")));
    assert(r != 0, "an unrecognised process name still deserializes");
    assert(str_eq(agnosai_crew_req_process(r), str_from("nonsense")) == 1,
    "...and is carried through verbatim, for the handler's catch-all to map");
    return 0;
}

# =========================================================================
# Bite 11b — the handlers. The oracle's four `#[tokio::test]`s live here.
# =========================================================================

fn _t_state_with(o): i64 {
    return agnosai_app_state_new(o, agnosai_tool_registry_new(),
    agnosai_auth_config_new(), agnosai_event_bus_new(),
    agnosai_audit_chain_new(), agnosai_approval_gate_new());
}

# The oracle's `post_crews_with_valid_body_returns_result` body.
fn _t_valid_body(): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"name\":\"test-crew\",\"agents\":[{\"agent_key\":\"tester\",");
    str_builder_add_cstr(sb, "\"name\":\"Tester\",\"role\":\"tester\",\"goal\":\"test things\"}],");
    str_builder_add_cstr(sb, "\"tasks\":[{\"description\":\"Run tests\",");
    str_builder_add_cstr(sb, "\"expected_output\":\"test results\"}]}");
    return str_builder_build(sb);
}

fn _t_rbody_str(r, key): Str {
    var v = bayan_json_v_obj_get(agnosai_route_body(r), key);
    if (v == 0 || bayan_json_v_is_str(v) == 0) { return str_from(""); }
    return bayan_json_v_str(v);
}

# Oracle: `post_crews_with_valid_body_returns_result`.
fn _t_create_crew_valid(): i64 {
    var o = agnosai_orchestrator_new(0);
    var r = agnosai_route_create_crew(_t_state_with(o), _t_valid_body());
    assert(agnosai_route_status(r) == HTTP_OK, "a valid crew run is 200");
    assert(str_len(_t_rbody_str(r, "crew_id")) > 0, "crew_id is a string");
    assert(str_len(_t_rbody_str(r, "status")) > 0, "status is a string");

    # **serde spelling here, not Debug** — the distinction from dashboard.rs.
    assert(str_eq(_t_rbody_str(r, "status"), str_from("completed")) == 1,
    "the status is the snake_case wire form");
    assert(str_eq(_t_rbody_str(r, "status"), str_from("Completed")) == 0,
    "...NOT the Debug form dashboard.rs emits for the same enum");

    var results = bayan_json_v_obj_get(agnosai_route_body(r), "results");
    assert(bayan_json_v_is_arr(results) == 1, "results is an array");
    assert(bayan_json_v_arr_len(results) == 1, "...with one entry for the one task");
    var e0 = bayan_json_v_arr_get(results, 0);
    assert(bayan_json_v_obj_get(e0, "task_id") != 0, "an entry carries task_id");
    assert(bayan_json_v_obj_get(e0, "output") != 0, "...output");
    assert(bayan_json_v_obj_get(e0, "status") != 0, "...and status");

    # And the crew is registered, so get_crew can find it.
    assert(agnosai_orchestrator_crew(o, _t_rbody_str(r, "crew_id")) != 0,
    "the crew is registered under the id the response reports");
    return 0;
}

# Oracle: `post_crews_with_empty_agents_returns_bad_request`.
fn _t_create_crew_empty_agents(): i64 {
    var o = agnosai_orchestrator_new(0);
    var body = str_from("{\"name\":\"empty-crew\",\"agents\":[],\"tasks\":[{\"description\":\"d\"}]}");
    var r = agnosai_route_create_crew(_t_state_with(o), body);
    assert(agnosai_route_status(r) == HTTP_BAD_REQUEST, "empty agents is 400");
    assert(str_eq(_t_rbody_str(r, "error"),
    str_from("at least one agent is required")) == 1,
    "...carrying validate_crew_request's own message");
    assert(agnosai_orchestrator_crew_count(o) == 0, "...and nothing ran");
    return 0;
}

# Oracle: `post_crews_dag_mode`.
fn _t_create_crew_dag(): i64 {
    var o = agnosai_orchestrator_new(0);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"name\":\"dag-crew\",\"agents\":[{\"agent_key\":\"worker\",");
    str_builder_add_cstr(sb, "\"name\":\"Worker\",\"role\":\"worker\",\"goal\":\"do work\"}],");
    str_builder_add_cstr(sb, "\"tasks\":[{\"description\":\"first task\"},");
    str_builder_add_cstr(sb, "{\"description\":\"second task\",\"dependencies\":[0]}],");
    str_builder_add_cstr(sb, "\"process\":\"dag\"}");
    var r = agnosai_route_create_crew(_t_state_with(o), str_builder_build(sb));
    assert(agnosai_route_status(r) == HTTP_OK, "dag mode is 200");
    assert(str_len(_t_rbody_str(r, "crew_id")) > 0, "...with a crew_id");
    var results = bayan_json_v_obj_get(agnosai_route_body(r), "results");
    assert(bayan_json_v_arr_len(results) == 2, "both tasks ran");
    return 0;
}

# Oracle: `get_crew_returns_not_found`.
fn _t_get_crew_not_found(): i64 {
    var r = agnosai_route_get_crew(_t_state_with(agnosai_orchestrator_new(0)),
    agnosai_uuid_v4_str());
    assert(agnosai_route_status(r) == HTTP_NOT_FOUND, "an unknown crew is 404");
    assert(str_contains(_t_rbody_str(r, "error"), str_from("not found")) == 1,
    "...with an error containing 'not found'");
    return 0;
}

# --- Beyond the oracle ---------------------------------------------------

fn _t_get_crew_found(): i64 {
    var o = agnosai_orchestrator_new(0);
    var s = _t_state_with(o);
    var created = agnosai_route_create_crew(s, _t_valid_body());
    var id = _t_rbody_str(created, "crew_id");

    var r = agnosai_route_get_crew(s, id);
    assert(agnosai_route_status(r) == HTTP_OK, "a known crew is 200");
    var b = agnosai_route_body(r);
    assert(bayan_json_v_is_obj(b) == 1, "the body is the serialized crew state");
    assert(bayan_json_v_obj_get(b, "crew_id") != 0, "...carrying crew_id");
    assert(bayan_json_v_obj_get(b, "status") != 0, "...and status");
    return 0;
}

# The oracle's `Path<Uuid>` extractor rejects a malformed id BEFORE the handler,
# so it is 422 rather than 404 — the same extractor-owns-the-status situation
# agents.rs and approval.rs have.
fn _t_malformed_id_is_422(): i64 {
    var s = _t_state_with(agnosai_orchestrator_new(0));
    assert(agnosai_route_status(agnosai_route_get_crew(s, str_from("not-a-uuid")))
    == AGNOSAI_HTTP_UNPROCESSABLE, "get with a malformed id is 422, not 404");
    assert(agnosai_route_status(agnosai_route_cancel_crew(s, str_from("not-a-uuid")))
    == AGNOSAI_HTTP_UNPROCESSABLE, "cancel with a malformed id is 422");
    assert(agnosai_route_status(agnosai_route_get_crew(s, str_from("")))
    == AGNOSAI_HTTP_UNPROCESSABLE, "an empty id is 422");
    return 0;
}

# `cancel_crew` — the oracle has NO test for it at all.
fn _t_cancel_crew(): i64 {
    var o = agnosai_orchestrator_new(0);
    var s = _t_state_with(o);
    var id = _t_rbody_str(agnosai_route_create_crew(s, _t_valid_body()), "crew_id");

    var r = agnosai_route_cancel_crew(s, id);
    assert(agnosai_route_status(r) == HTTP_OK, "cancelling a known crew is 200");
    assert(str_eq(_t_rbody_str(r, "status"), str_from("cancelled")) == 1,
    "...with status cancelled");
    assert(str_eq(_t_rbody_str(r, "crew_id"), id) == 1, "...and the crew id echoed");
    assert(agnosai_crew_state_status(agnosai_orchestrator_crew(o, id))
    == AGNOSAI_CREW_CANCELLED, "...and the registered crew is marked Cancelled");

    assert(agnosai_route_status(agnosai_route_cancel_crew(s, agnosai_uuid_v4_str()))
    == HTTP_NOT_FOUND, "cancelling an unknown crew is 404");
    return 0;
}

# The handler's own rejection surface.
fn _t_create_crew_rejections(): i64 {
    var s = _t_state_with(agnosai_orchestrator_new(0));
    assert(agnosai_route_status(agnosai_route_create_crew(s, str_from("not json")))
    == HTTP_BAD_REQUEST, "malformed JSON is 400");
    assert(agnosai_route_status(agnosai_route_create_crew(s, str_from("{}")))
    == AGNOSAI_HTTP_UNPROCESSABLE, "a body serde would reject is 422");
    assert(agnosai_route_status(agnosai_route_create_crew(s, str_from("[]")))
    == AGNOSAI_HTTP_UNPROCESSABLE, "an array body is 422");

    # 400 vs 422 is the distinction between "deserialized but invalid" and
    # "did not deserialize", and both are reachable from a plausible body.
    var eb = str_builder_new();
    str_builder_add_cstr(eb, "{\"name\":\"\",\"agents\":[{\"agent_key\":\"k\",\"name\":\"n\",");
    str_builder_add_cstr(eb, "\"role\":\"r\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"d\"}]}");
    var b = str_builder_build(eb);
    assert(agnosai_route_status(agnosai_route_create_crew(s, b)) == HTTP_BAD_REQUEST,
    "an empty name deserializes fine and fails validation with 400");
    return 0;
}

# `process` mapping, including the catch-all the reader deliberately allows
# through.
fn _t_process_mapping(): i64 {
    var seq = agnosai_crew_req_new(str_from("c"));
    assert(agnosai_process_kind(_agnosai_route_process_for(seq))
    == AGNOSAI_PROCESS_SEQUENTIAL, "an absent process is Sequential");

    var bad = agnosai_crew_req_new(str_from("c"));
    store64(bad + AGN_CREQ_PROCESS, str_from("nonsense"));
    assert(agnosai_process_kind(_agnosai_route_process_for(bad))
    == AGNOSAI_PROCESS_SEQUENTIAL,
    "an unrecognised process falls through to Sequential — the oracle's `_ =>` arm");

    var dag = agnosai_crew_req_new(str_from("c"));
    store64(dag + AGN_CREQ_PROCESS, str_from("dag"));
    assert(agnosai_process_kind(_agnosai_route_process_for(dag)) == AGNOSAI_PROCESS_DAG, "dag");

    var h = agnosai_crew_req_new(str_from("c"));
    store64(h + AGN_CREQ_PROCESS, str_from("hierarchical"));
    var hp = _agnosai_route_process_for(h);
    assert(agnosai_process_kind(hp) == AGNOSAI_PROCESS_HIERARCHICAL, "hierarchical");
    assert(str_len(agnosai_process_manager(hp)) > 0,
    "...with a placeholder manager UUID, as the oracle's Uuid::new_v4() gives");
    return 0;
}

# The oracle's `unwrap_or(4).clamp(1, 64)`.
fn _t_concurrency_clamp(): i64 {
    var p = agnosai_crew_req_new(str_from("c"));
    store64(p + AGN_CREQ_PROCESS, str_from("parallel"));
    assert(agnosai_process_max_concurrency(_agnosai_route_process_for(p)) == 4,
    "an absent max_concurrency defaults to 4");

    store64(p + AGN_CREQ_HAS_CONCURRENCY, 1);
    store64(p + AGN_CREQ_MAX_CONCURRENCY, 0);
    assert(agnosai_process_max_concurrency(_agnosai_route_process_for(p)) == 1,
    "0 clamps up to 1");
    store64(p + AGN_CREQ_MAX_CONCURRENCY, 1000);
    assert(agnosai_process_max_concurrency(_agnosai_route_process_for(p)) == 64,
    "1000 clamps down to 64");
    store64(p + AGN_CREQ_MAX_CONCURRENCY, 16);
    assert(agnosai_process_max_concurrency(_agnosai_route_process_for(p)) == 16,
    "an in-range value passes through");
    store64(p + AGN_CREQ_MAX_CONCURRENCY, 64);
    assert(agnosai_process_max_concurrency(_agnosai_route_process_for(p)) == 64,
    "exactly 64 is in range");
    return 0;
}

# Index-based dependencies on the wire become UUID-based in the spec.
fn _t_dependency_resolution(): i64 {
    var r = _t_req("c", 3);
    _t_dep(r, 1, 0);
    _t_dep(r, 2, 1);
    var spec = _agnosai_route_build_spec(r);
    var tasks = agnosai_crew_tasks(spec);
    assert(vec_len(tasks) == 3, "three tasks built");

    var t0 = vec_get(tasks, 0);
    var t1 = vec_get(tasks, 1);
    var t2 = vec_get(tasks, 2);
    assert(vec_len(agnosai_task_dependencies(t0)) == 0, "task 0 has no dependencies");
    assert(vec_len(agnosai_task_dependencies(t1)) == 1, "task 1 has one");
    assert(str_eq(vec_get(agnosai_task_dependencies(t1), 0), agnosai_task_id(t0)) == 1,
    "...resolved to task 0's UUID, not the index 0");
    assert(str_eq(vec_get(agnosai_task_dependencies(t2), 0), agnosai_task_id(t1)) == 1,
    "task 2 depends on task 1's UUID");
    assert(str_eq(agnosai_task_id(t0), agnosai_task_id(t1)) == 0,
    "the task ids are distinct");
    return 0;
}

# The request deserialisers' `_a` forms, named directly.
#
# All three are reached only through `agnosai_route_create_crew_a`, which
# reference coverage cannot see. Worth exercising on an arena rather than the
# global allocator: that is the arm the route does *not* use for them, and it
# has to work for anything that deserialises a request without keeping it.
fn _t_crew_req_constructors_take_an_allocator(): i64 {
    var ar = arena_allocator(65536);

    var r = agnosai_crew_req_new_a(ar, str_from_a(ar, "n"));
    assert(r != 0, "crew_req_new_a builds in the arena");
    assert(vec_len(agnosai_crew_req_agents(r)) == 0, "...with empty agents");
    assert(vec_len(agnosai_crew_req_tasks(r)) == 0, "...and empty tasks");

    var tq = agnosai_task_req_new_a(ar, str_from_a(ar, "d"));
    assert(tq != 0, "task_req_new_a builds in the arena");
    assert(str_eq_cstr(agnosai_task_req_description(tq), "d") == 1, "...carrying d");

    var body = _t_valid_body();
    var v = bayan_json_v_parse_buf_a(ar, str_data(body), str_len(body));
    var req = agnosai_crew_req_from_value_a(ar, v);
    assert(req != 0, "crew_req_from_value_a deserialises through the arena");
    assert(str_eq_cstr(agnosai_crew_req_name(req), "test-crew") == 1, "...with the name");
    assert(vec_len(agnosai_crew_req_tasks(req)) == 1, "...and one task");

    var tv = bayan_json_v_obj_get(v, "tasks");
    var t1 = agnosai_task_req_from_value_a(ar, bayan_json_v_arr_get(tv, 0));
    assert(t1 != 0, "task_req_from_value_a deserialises through the arena");
    assert(str_eq_cstr(agnosai_task_req_description(t1), "Run tests") == 1,
    "...carrying the description");

    reset_via(ar);
    return 0;
}

# --- The retention boundary --------------------------------------------

# **The audit chain is what retains a borrowed crew name — not the registry.**
#
# This test first asserted on `agnosai_crew_state_crew_id`, and every mutation
# survived it. That was the right instinct pointed at the wrong object:
# `CrewState` holds a *minted* UUID, a status, results and a profile, and the
# results' strings come from execution. Nothing there ever pointed at the
# request body.
#
# The real path is the audit trail. `_agnosai_orch_register` and
# `_agnosai_orch_finish` pass `agnosai_crew_name(spec)` — borrowed straight from
# the parse tree before the fix — as the audit **message**, and
# `agnosai_audit_record` stores that message **without cloning** into a chain
# that lives in `AppState`. So threading the parse would have left the audit
# chain holding pointers into a reclaimed request body: a tamper-evident log
# whose entries silently rewrite themselves is a worse outcome than most.
#
# `agnosai_crew_req_from_value_a` clones the name, so the entry owns it. Run the
# whole route through an arena, release it, scribble, and read the trail back.
fn _t_audit_trail_owns_the_crew_name(): i64 {
    var o = agnosai_orchestrator_new(0);
    var s = _t_state_with(o);
    var chain = agnosai_audit_chain_new();
    agnosai_orchestrator_with_audit(o, chain);
    var ar = arena_allocator(262144);

    var r = agnosai_route_create_crew_a(ar, s, _t_valid_body());
    assert(agnosai_route_status(r) == HTTP_OK, "the threaded route answers 200");
    assert(agnosai_audit_chain_count(chain) > 0, "the run left an audit trail");

    # **Read the crew id BEFORE the reset.** `r` is the response, and the
    # response lives in `ar` — which is the point of threading the route. Doing
    # this after `reset_via` is a use-after-free on the test's own side, and it
    # segfaults rather than failing an assertion. `str_clone` onto the global
    # allocator so the id itself outlives the arena too.
    var cid = str_clone(_t_rbody_str(r, "crew_id"));
    assert(str_len(cid) > 0, "...and returns a crew id");

    # End of request: the arena is rewound and the next one reuses the bytes.
    reset_via(ar);
    var scribble = str_builder_new_a(ar);
    for (var i = 0; i < 2048; i = i + 1) { str_builder_add_cstr_a(ar, scribble, "ZZZZ"); }
    str_builder_build_a(ar, scribble);

    # `crew_accepted` and `crew_finished` both carry the crew name as their
    # message. The fixture's crew is named `test-crew`.
    var recent = agnosai_audit_chain_recent(chain, 16);
    var seen = 0;
    for (var j = 0; j < vec_len(recent); j = j + 1) {
        if (str_eq_cstr(agnosai_audit_entry_message(vec_get(recent, j)), "test-crew") == 1) {
            seen = seen + 1;
        }
    }
    assert(seen > 0,
    "**the crew name in the audit trail survives the arena being released and \
    overwritten** — the entry owns it rather than borrowing the request body");

    # **The task description is retained too, by two routes.** On the
    # placeholder path `crew_runner` makes it the task result's *output*
    # (`crew_runner.cyr:460`) and also audits it (`:772`) — and results live in
    # the registered `CrewState`. So a borrowed description outlives the request
    # just as the crew name does; asserting only on the name left
    # `agnosai_task_req_from_value`'s clone unpinned, which a mutation found.
    var st = agnosai_orchestrator_crew(o, cid);
    assert(st != 0, "the crew is registered");
    var results = agnosai_crew_state_results(st);
    assert(vec_len(results) == 1, "...with its one task result");
    assert(str_eq_cstr(agnosai_task_result_output(vec_get(results, 0)), "Run tests") == 1,
    "and the description carried into that result survives the scribble too");
    return 0;
}

fn main(): i64 {
    alloc_init();
    sakshi_set_level(SK_FATAL);

    _t_rejects_empty_name();
    _t_rejects_missing_tasks();
    _t_rejects_missing_agents();
    _t_rejects_self_dependency();
    _t_rejects_out_of_range_dependency();
    _t_rejects_dependency_cycle();
    _t_accepts_valid_dag();
    _t_cycle_detector_direct();
    _t_cycle_memoization_shape();
    _t_caps();
    _t_task_req_reader();
    _t_task_req_rejections();
    _t_crew_req_reader();
    _t_crew_req_rejections();
    _t_process_is_not_validated();

    _t_create_crew_valid();
    _t_create_crew_empty_agents();
    _t_create_crew_dag();
    _t_get_crew_not_found();
    _t_get_crew_found();
    _t_malformed_id_is_422();
    _t_cancel_crew();
    _t_create_crew_rejections();
    _t_process_mapping();
    _t_concurrency_clamp();
    _t_dependency_resolution();

    _t_crew_req_constructors_take_an_allocator();
    _t_audit_trail_owns_the_crew_name();

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
