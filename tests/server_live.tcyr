var _T_TRACE = "4bf92f3577b34da6a3ce929d0e0e4736";
var _T_PARENT = "00f067aa0ba902b7";
var _T_LIVE_CREW = "6c1e2b2a-1f0e-4a6b-9d3c-5e7f8a9b0c1d";

# A free loopback port from [lo, hi), found by binding it, or 0.
fn _t_free_port(lo, hi): i64 {
    var p = lo;
    while (p < hi) {
        var st, fd = tcp_socket();
        sock_reuse(fd);
        var bt, bv = sock_bind(fd, INADDR_LOOPBACK(), p);
        sock_close(fd);
        if (is_err_result(bt) == 0) { return p; }
        p = p + 1;
    }
    return 0;
}

# ── the gateway ──────────────────────────────────────────────────────────

var _T_GW_LFD = 0;
var _T_GW_PORT = 0;
var _T_GW_DELAY_MS = 0;
var _T_GW_RESPONSE = 0;

# Read one HTTP request off `cfd`: its head, then as many body bytes as its Content-Length says.
fn _t_read_request(cfd, buf, cap): i64 {
    var got = 0;
    var need = 0 - 1;
    while (need < 0 || got < need) {
        var rt, n = sock_recv(cfd, buf + got, cap - got);
        if (is_err_result(rt) == 1 || n <= 0) { return got; }
        got = got + n;
        var head = str_new(buf, got);
        var end = str_index_of_cstr(head, "\r\n\r\n");
        if (end >= 0 && need < 0) {
            var at = str_index_of_cstr(head, "ontent-Length: ");
            var len = 0;
            if (at >= 0) {
                var p = at + 15;
                while (load8(buf + p) >= 48 && load8(buf + p) <= 57) {
                    len = len * 10 + load8(buf + p) - 48;
                    p = p + 1;
                }
            }
            need = end + 4 + len;
        }
    }
    return got;
}

fn _t_gateway(arg): i64 {
    var buf = alloc(65536);
    while (1 == 1) {
        var at, cfd = sock_accept(_T_GW_LFD);
        if (is_err_result(at) == 0) {
            _t_read_request(cfd, buf, 65536);
            if (_T_GW_DELAY_MS > 0) { sleep_ms(_T_GW_DELAY_MS); }
            sock_send_all(cfd, _T_GW_RESPONSE, strlen(_T_GW_RESPONSE));
            sock_close(cfd);
        }
    }
    return 0;
}

# A chat completion carrying `content`, as a whole HTTP response.
fn _t_completion(content): i64 {
    var body = bayan_json_v_obj_new();
    bayan_json_v_obj_set(body, str_from("model"), bayan_json_v_str_new(str_from("stub-model")));
    var msg = bayan_json_v_obj_new();
    bayan_json_v_obj_set(msg, str_from("content"), bayan_json_v_str_new(str_from(content)));
    var choice = bayan_json_v_obj_new();
    bayan_json_v_obj_set(choice, str_from("message"), msg);
    var choices = bayan_json_v_arr_new();
    bayan_json_v_arr_push(choices, choice);
    bayan_json_v_obj_set(body, str_from("choices"), choices);
    var b = bayan_json_v_build(body);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nConnection: close\r\n");
    str_builder_add_cstr(sb, "Content-Length: ");
    str_builder_add_int(sb, str_len(b));
    str_builder_add_cstr(sb, "\r\n\r\n");
    str_builder_add(sb, b);
    return str_data(str_builder_build(sb));
}

fn _t_gateway_start(): i64 {
    _T_GW_PORT = _t_free_port(48311, 48341);
    if (_T_GW_PORT == 0) { return 0; }
    var lt, lfd = tcp_socket();
    sock_reuse(lfd);
    var bt, bv = sock_bind(lfd, INADDR_LOOPBACK(), _T_GW_PORT);
    if (is_err_result(bt) == 1) { return 0; }
    var st, sv = sock_listen(lfd, 64);
    if (is_err_result(st) == 1) { return 0; }
    _T_GW_LFD = lfd;
    _T_GW_RESPONSE = _t_completion("a model's answer");
    thread_create_detached(&_t_gateway, 0);
    return 1;
}

# ── the server ───────────────────────────────────────────────────────────

var _T_STATE = 0;
var _T_PORT = 0;
var _T_SERVE_RC = 0 - 1;
var _T_SERVE_DONE = 0;
var _T_SERVE_DONE_MS = 0;

fn _t_server(arg): i64 {
    _T_SERVE_RC = agnosai_serve(_T_STATE, INADDR_LOOPBACK(), _T_PORT);
    _T_SERVE_DONE_MS = clock_now_ms();
    atomic_store(&_T_SERVE_DONE, 1);
    return 0;
}

# Send `req` and read the response to EOF, or for 10 s at most. Answers it as a Str.
fn _t_exchange(req: Str): Str {
    var ct, cfd = tcp_socket();
    var cr, cv = sock_connect(cfd, INADDR_LOOPBACK(), _T_PORT);
    if (is_err_result(cr) == 1) {
        sock_close(cfd);
        return str_from("");
    }
    sock_send_all(cfd, str_data(req), str_len(req));
    var cap = 65536;
    var buf = alloc(cap);
    var got = 0;
    var deadline = clock_now_ms() + 10000;
    while (got < cap - 1 && clock_now_ms() < deadline) {
        if (fd_wait_ready(cfd, 0, 50) == 1) {
            var rt, n = sock_recv(cfd, buf + got, cap - 1 - got);
            if (is_err_result(rt) == 1 || n <= 0) { break; }
            got = got + n;
        }
    }
    sock_close(cfd);
    return str_from_buf(buf, got);
}

fn _t_get(path): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "GET ");
    str_builder_add_cstr(sb, path);
    str_builder_add_cstr(sb, " HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n");
    return _t_exchange(str_builder_build(sb));
}

# `POST /api/v1/crews` with one agent on the gateway's model, and `extra` header lines.
fn _t_crew_request(extra): Str {
    var body = str_cat(str_cat(str_from("{\"name\":\"live\",\"agents\":[{\"agent_key\":\"tester\","),
        str_from("\"name\":\"Tester\",\"role\":\"tester\",\"goal\":\"test\",\"llm_model\":\"stub-model\"}],")),
      str_from("\"tasks\":[{\"description\":\"d\"}]}"));
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "POST /api/v1/crews HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n");
    str_builder_add_cstr(sb, "Content-Type: application/json\r\n");
    str_builder_add_cstr(sb, extra);
    str_builder_add_cstr(sb, "Content-Length: ");
    str_builder_add_int(sb, str_len(body));
    str_builder_add_cstr(sb, "\r\n\r\n");
    str_builder_add(sb, body);
    return str_builder_build(sb);
}

fn _t_starts(s: Str, prefix): i64 { return str_starts_with(s, str_from(prefix)); }

fn _t_server_start(): i64 {
    var o = agnosai_orchestrator_new(0);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "http://127.0.0.1:");
    str_builder_add_int(sb, _T_GW_PORT);
    agnosai_orchestrator_with_llm_url(o, str_builder_build(sb), str_from("sk-test"));
    var reg = agnosai_tool_registry_new();
    agnosai_tool_registry_register(reg, agnosai_echo_tool());
    _T_STATE = agnosai_app_state_new(o, reg, agnosai_auth_config_new(), agnosai_event_bus_new(),
      agnosai_audit_chain_new(), agnosai_approval_gate_new());
    _T_PORT = _t_free_port(48351, 48381);
    if (_T_PORT == 0) { return 0; }
    # Four workers, not the binary's hundred: enough to serve a stream, a slow request and a probe
    # at once.
    AGNOSAI_SERVE_WORKERS = 4;
    AGNOSAI_SHUTDOWN_GRACE_SECS = 10;
    thread_create_detached(&_t_server, 0);
    var w = 0;
    while (w < 200) {
        if (_t_starts(_t_get("/health"), "HTTP/1.1 200") == 1) { return 1; }
        sleep_ms(10);
        w = w + 1;
    }
    return 0;
}

# ── a crew joins the inbound trace, through a worker's arena ─────────────

fn _t_trace_suite(): i64 {
    var g = agnosai_telemetry_init_export(str_from("http://127.0.0.1:1"), str_from("live-probe"));
    var ring = agnosai_otlp_exporter_ring(agnosai_telemetry_exporter());
    agnosai_otlp_ring_drain(ring, str_from("x"));
    var r = _t_exchange(_t_crew_request(
        "traceparent: 00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01\r\n"));
    assert_eq(_t_starts(r, "HTTP/1.1 200"), 1, "a traced crew POST over a socket is 200");
    assert(str_contains_cstr(r, "a model's answer") == 1, "answered by the gateway's model");
    var doc = agnosai_otlp_ring_drain(ring, str_from("x"));
    assert(doc != 0, "and its spans were recorded");
    assert_eq(str_contains_cstr(doc, "\"name\":\"invoke_workflow live\""), 1, "the crew's workflow span among them");
    assert_eq(str_contains_cstr(doc, "\"traceId\":\"4bf92f3577b34da6a3ce929d0e0e4736\""), 1,
      "in the trace the header named, read from a pooled worker's arena");
    assert_eq(str_contains_cstr(doc, "\"parentSpanId\":\"00f067aa0ba902b7\""), 1, "as its parent's child");

    var r2 = _t_exchange(_t_crew_request(
        "Traceparent: 00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01\r\n"));
    assert_eq(_t_starts(r2, "HTTP/1.1 200"), 1, "a header named in another case is read the same");
    assert_eq(str_contains_cstr(agnosai_otlp_ring_drain(ring, str_from("x")), _T_TRACE), 1, "into the same trace");

    var r3 = _t_exchange(_t_crew_request(""));
    assert_eq(_t_starts(r3, "HTTP/1.1 200"), 1, "a crew with no traceparent is 200");
    assert_eq(str_contains_cstr(agnosai_otlp_ring_drain(ring, str_from("x")), _T_TRACE), 0, "in a trace of its own");
    agnosai_telemetry_shutdown(g);
    assert_eq(agnosai_serve_inflight(), 0, "and once each was answered, nothing is in flight");
    return 0;
}

# ── a stop drains ────────────────────────────────────────────────────────

var _T_SLOW_RESP = 0;
var _T_SLOW_DONE_MS = 0;
var _T_STREAM_RESP = 0;
var _T_STREAM_DONE_MS = 0;

fn _t_slow_client(arg): i64 {
    _T_SLOW_RESP = _t_exchange(_t_crew_request(""));
    _T_SLOW_DONE_MS = clock_now_ms();
    return 0;
}

fn _t_stream_client(arg): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/api/v1/crews/");
    str_builder_add_cstr(sb, _T_LIVE_CREW);
    str_builder_add_cstr(sb, "/stream");
    _T_STREAM_RESP = _t_get(str_cstr(str_builder_build(sb)));
    _T_STREAM_DONE_MS = clock_now_ms();
    return 0;
}

fn _t_drain_suite(): i64 {
    # A crew the bus knows and that never ends, for a stream to follow until the stop.
    agnosai_event_bus_subscribe(agnosai_app_state_events(_T_STATE), str_from(_T_LIVE_CREW));
    thread_create_detached(&_t_stream_client, 0);
    var w = 0;
    while (w < 400 && agnosai_serve_inflight() < 1) { sleep_ms(5); w = w + 1; }
    assert_eq(agnosai_serve_inflight(), 1, "a stream is open, in flight");

    _T_GW_DELAY_MS = 400;
    thread_create_detached(&_t_slow_client, 0);
    var w2 = 0;
    while (w2 < 400 && agnosai_serve_inflight() < 2) { sleep_ms(5); w2 = w2 + 1; }
    assert_eq(agnosai_serve_inflight(), 2, "and a request waits on its model, in flight too");

    var asked = clock_now_ms();
    _agnosai_serve_stop = 1;
    var w3 = 0;
    while (w3 < 1000 && atomic_load(&_T_SERVE_DONE) == 0) { sleep_ms(10); w3 = w3 + 1; }
    assert_eq(atomic_load(&_T_SERVE_DONE), 1, "a stop returns the serve loop");
    assert_eq(_T_SERVE_RC, 0, "as a stop, not a failure");
    var w4 = 0;
    while (w4 < 200 && (_T_SLOW_RESP == 0 || _T_STREAM_RESP == 0)) { sleep_ms(10); w4 = w4 + 1; }

    assert(_T_SLOW_RESP != 0 && _t_starts(_T_SLOW_RESP, "HTTP/1.1 200") == 1,
      "the request in flight at the stop is answered, not cut short");
    assert(str_contains_cstr(_T_SLOW_RESP, "a model's answer") == 1, "with its crew's answer, whole");
    assert(_T_SERVE_DONE_MS >= _T_SLOW_DONE_MS - 50, "and the loop returned only once it had been answered");
    assert(_T_SERVE_DONE_MS - asked >= 300, "which took the model's delay, as the drain waited for it");

    assert(_T_STREAM_RESP != 0 && str_contains_cstr(_T_STREAM_RESP, "SSE stream connected") == 1,
      "the stream open at the stop had been streaming");
    assert(str_ends_with(_T_STREAM_RESP, str_from("0\r\n\r\n")) == 1,
      "and ends whole, its last chunk sent, for its client to reconnect elsewhere");
    assert(_T_STREAM_DONE_MS - asked < 1000, "within a poll of the stop, not when its crew ends, which is never");
    assert_eq(agnosai_serve_inflight(), 0, "and nothing is in flight once the loop has returned");
    assert(_t_starts(_t_get("/health"), "HTTP/1.1") == 0, "nor does anything more get in");
    return 0;
}

fn main(): i64 {
    alloc_init();
    sakshi_set_level(SK_FATAL);
    _sandhi_server_ignore_sigpipe();
    agnosai_model_set_tier_override(AGNOSAI_TIER_FAST, str_from("stub-model"));
    agnosai_model_set_tier_override(AGNOSAI_TIER_CAPABLE, str_from("stub-model"));
    agnosai_model_set_tier_override(AGNOSAI_TIER_PREMIUM, str_from("stub-model"));
    test_group("server_live");
    if (_t_gateway_start() == 0 || _t_server_start() == 0) {
        println("server_live: no loopback port to listen on; the live server did not run");
        return assert_summary();
    }
    _t_trace_suite();
    # LAST: the stop closes the listener for good.
    _t_drain_suite();
    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
sys_exit_group(f);
