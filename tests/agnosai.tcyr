# agnosai test suite
# Stdlib auto-included via cyrius.cyml

fn main() {
    alloc_init();
    test_group("smoke");
    assert(1, "true is true");
    assert_eq(1 + 1, 2, "math works");
    return assert_summary();
}

# Clamp the failure count to 1 before exiting. The stock proj-tcyr epilogue
# passes the raw count, which the kernel masks `& 0xFF` — so exactly 256, 512
# or 768 failures would score as PASS. See CLAUDE.md.
var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
