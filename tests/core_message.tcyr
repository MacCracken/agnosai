# =========================================================================
# core_message.tcyr — parity tests for src/core/message.cyr
#
# Oracle: the 6 #[cfg(test)] tests in rust-old/src/core/message.rs, plus the
# RFC3339 AutoSi renderings the oracle never pins directly but whose exactness
# its `restored.timestamp == msg.timestamp` assertion depends on.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/core/error.cyr"
include "src/id.cyr"
include "src/core/message.cyr"
include "tests/test_helpers.cyr"

# Assert a nanosecond epoch renders to exactly `expected`.
fn _t_assert_ts(ns, expected, name): i64 {
    return assert(str_eq(_agnosai_msg_fmt_rfc3339(ns), str_from(expected)) == 1, name);
}

fn _t_v237_rfc3339(): i64 {
    test_group("RFC 3339, in an allocator");
    var ar = arena_allocator_growable(4096);
    var wrong = 0;
    var kept = 0;
    # Leap days, month ends, century rules, and a stride that lands on every day of the month.
    var secs = 0;
    while (secs < 5000000000) {
        var want = str_from(iso8601(secs));
        var before = alloc_used();
        var got = _agnosai_msg_fmt_rfc3339_a(ar, secs * AGNOSAI_NS_PER_SEC);
        kept = kept + alloc_used() - before;
        if (str_eq(got, want) != 1) { wrong = wrong + 1; }
        reset_via(ar);
        secs = secs + 2678411;
    }
    assert_eq(wrong, 0, "it agrees with the stdlib's date arithmetic across 150 years");
    assert_eq(kept, 0, "and leaves nothing on the global heap");
    var feb29 = _agnosai_msg_fmt_rfc3339_a(ar, 1709164800 * AGNOSAI_NS_PER_SEC);
    assert(str_eq_cstr(feb29, "2024-02-29T00:00:00Z") == 1, "a leap day");
    var end = _agnosai_msg_fmt_rfc3339_a(ar, 4102444799 * AGNOSAI_NS_PER_SEC);
    assert(str_eq_cstr(end, "2099-12-31T23:59:59Z") == 1, "the last second of a year");
    var one = _agnosai_msg_fmt_rfc3339_a(ar, 1785276000 * AGNOSAI_NS_PER_SEC + 500000000);
    assert(str_eq_cstr(one, "2026-07-28T22:00:00.500Z") == 1, "whole milliseconds as three digits");
    var two = _agnosai_msg_fmt_rfc3339_a(ar, 1785276000 * AGNOSAI_NS_PER_SEC + 1500);
    assert(str_eq_cstr(two, "2026-07-28T22:00:00.000001500Z") == 1, "and anything finer as nine");
    var three = _agnosai_msg_fmt_rfc3339_a(ar, 1785276000 * AGNOSAI_NS_PER_SEC + 1000);
    assert(str_eq_cstr(three, "2026-07-28T22:00:00.000001Z") == 1, "whole microseconds as six");
    assert_eq(load8(str_data(three) + str_len(three)), 0, "NUL-terminated, for what takes a C string");
    return 0;
}

fn main() {
    alloc_init();

    test_group("core_message");

    # --- message_new_sets_timestamp ---
    var before = clock_epoch_ns();
    var payload = bayan_json_v_obj_new();
    bayan_json_v_obj_set(payload, str_from("hello"), bayan_json_v_str_new(str_from("world")));
    var msg = agnosai_message_new(agnosai_uuid_v4_str(), agnosai_message_target_broadcast(), payload);
    var after = clock_epoch_ns();
    assert(agnosai_message_timestamp_ns(msg) >= before, "timestamp is not before creation");
    assert(agnosai_message_timestamp_ns(msg) <= after, "timestamp is not after creation");

    # --- message_new_generates_unique_id ---
    var from = agnosai_uuid_v4_str();
    var m1 = agnosai_message_new(from, agnosai_message_target_broadcast(), bayan_json_v_null());
    var m2 = agnosai_message_new(from, agnosai_message_target_broadcast(), bayan_json_v_null());
    assert_eq(str_eq(agnosai_message_id(m1), agnosai_message_id(m2)), 0,
      "each message gets a distinct id");
    assert_eq(str_eq(agnosai_message_from(m1), from), 1, "sender round-trips");

    # --- message_target_serde_agent ---
    var agent_id = agnosai_uuid_v4_str();
    var t_agent = agnosai_message_target_agent(agent_id);
    var restored_agent = agnosai_message_target_from_value(agnosai_message_target_to_value(t_agent));
    assert(restored_agent != 0, "agent target round-trips");
    assert_eq(agnosai_message_target_kind(restored_agent), AGNOSAI_TARGET_AGENT, "agent variant");
    assert_eq(str_eq(agnosai_message_target_agent_id(restored_agent), agent_id), 1,
      "agent target keeps its id");

    # --- message_target_serde_topic ---
    var t_topic = agnosai_message_target_topic(str_from("my-topic"));
    var restored_topic = agnosai_message_target_from_value(agnosai_message_target_to_value(t_topic));
    assert(restored_topic != 0, "topic target round-trips");
    assert_eq(agnosai_message_target_kind(restored_topic), AGNOSAI_TARGET_TOPIC, "topic variant");
    assert(str_eq(agnosai_message_target_topic_name(restored_topic), str_from("my-topic")) == 1,
      "topic target keeps its name");

    # --- message_target_serde_broadcast ---
    var t_bcast = agnosai_message_target_broadcast();
    var restored_bcast = agnosai_message_target_from_value(agnosai_message_target_to_value(t_bcast));
    assert(restored_bcast != 0, "broadcast target round-trips");
    assert_eq(agnosai_message_target_kind(restored_bcast), AGNOSAI_TARGET_BROADCAST,
      "broadcast variant");

    # --- the target wire forms are serde's externally-tagged snake_case ---
    assert(str_eq(bayan_json_v_build(agnosai_message_target_to_value(t_bcast)),
        str_from("\"broadcast\"")) == 1, "broadcast is a bare string");
    assert(str_eq(bayan_json_v_build(agnosai_message_target_to_value(t_topic)),
        str_from("{\"topic\":\"my-topic\"}")) == 1, "topic is externally tagged");

    # --- message_serde_round_trip ---
    var events = agnosai_message_target_topic(str_from("events"));
    var p2 = bayan_json_v_obj_new();
    bayan_json_v_obj_set(p2, str_from("type"), bayan_json_v_str_new(str_from("test")));
    var orig = agnosai_message_new(agnosai_uuid_v4_str(), events, p2);
    var json = agnosai_message_to_json(orig);
    var back = agnosai_message_from_json(json);
    assert(back != 0, "message parses back from its own JSON");
    assert_eq(str_eq(agnosai_message_id(back), agnosai_message_id(orig)), 1, "id survives");
    assert_eq(str_eq(agnosai_message_from(back), agnosai_message_from(orig)), 1,
      "from survives");
    assert_eq(agnosai_message_timestamp_ns(back), agnosai_message_timestamp_ns(orig),
      "timestamp survives to the nanosecond");
    assert_eq(agnosai_message_target_kind(agnosai_message_to(back)), AGNOSAI_TARGET_TOPIC,
      "target survives");
    assert(str_eq(bayan_json_v_build(agnosai_message_payload(back)),
        bayan_json_v_build(agnosai_message_payload(orig))) == 1, "payload survives");

    # --- the value-level round trip, skipping the text form entirely ---
    var via_value = agnosai_message_from_value(agnosai_message_to_value(orig));
    assert(via_value != 0, "message round-trips through the value tree");
    assert_eq(agnosai_message_timestamp_ns(via_value), agnosai_message_timestamp_ns(orig),
      "value round trip keeps the timestamp");
    assert_eq(agnosai_message_from_value(bayan_json_v_str_new(str_from("x"))), 0,
      "a non-object value is not a message");

    # --- field order matches serde's declaration order ---
    var v = agnosai_message_to_value(orig);
    assert(str_eq(bayan_json_v_obj_key(v, 0), str_from("id")) == 1, "field 0 is id");
    assert(str_eq(bayan_json_v_obj_key(v, 1), str_from("from")) == 1, "field 1 is from");
    assert(str_eq(bayan_json_v_obj_key(v, 2), str_from("to")) == 1, "field 2 is to");
    assert(str_eq(bayan_json_v_obj_key(v, 3), str_from("payload")) == 1, "field 3 is payload");
    assert(str_eq(bayan_json_v_obj_key(v, 4), str_from("timestamp")) == 1, "field 4 is timestamp");

    # --- RFC3339 AutoSi: 0, 3, 6 or 9 fractional digits, never anything else ---
    _t_assert_ts(1785283200 * AGNOSAI_NS_PER_SEC, "2026-07-29T00:00:00Z", "whole seconds omit the fraction");
    _t_assert_ts(1785283200 * AGNOSAI_NS_PER_SEC + 500000000, "2026-07-29T00:00:00.500Z",
      "half a second renders as 3 digits");
    _t_assert_ts(1785283200 * AGNOSAI_NS_PER_SEC + 123456000, "2026-07-29T00:00:00.123456Z",
      "microsecond precision renders as 6 digits");
    _t_assert_ts(1785283200 * AGNOSAI_NS_PER_SEC + 123456789, "2026-07-29T00:00:00.123456789Z",
      "nanosecond precision renders as 9 digits");
    _t_assert_ts(1785283200 * AGNOSAI_NS_PER_SEC + 1, "2026-07-29T00:00:00.000000001Z",
      "a single nanosecond keeps its leading zeros");

    # --- and the fractional forms all parse back exactly ---
    var ns9 = 1785283200 * AGNOSAI_NS_PER_SEC + 123456789;
    assert_eq(_agnosai_msg_parse_rfc3339(_agnosai_msg_fmt_rfc3339(ns9)), ns9, "9-digit round trip");
    var ns3 = 1785283200 * AGNOSAI_NS_PER_SEC + 500000000;
    assert_eq(_agnosai_msg_parse_rfc3339(_agnosai_msg_fmt_rfc3339(ns3)), ns3, "3-digit round trip");
    var ns0 = 1785283200 * AGNOSAI_NS_PER_SEC;
    assert_eq(_agnosai_msg_parse_rfc3339(_agnosai_msg_fmt_rfc3339(ns0)), ns0, "no-fraction round trip");

    # A zone offset is applied, not ignored: all three are the same instant.
    var utc = _agnosai_msg_parse_rfc3339(str_from("2026-07-28T00:00:00Z"));
    assert_eq(_agnosai_msg_parse_rfc3339(str_from("2026-07-28T02:00:00+02:00")), utc,
      "+02:00 is subtracted to reach UTC");
    assert_eq(_agnosai_msg_parse_rfc3339(str_from("2026-07-27T18:30:00.000-05:30")), utc,
      "-05:30 is added, after a fraction");
    assert_eq(_agnosai_msg_parse_rfc3339(str_from("2026-07-28T00:00:00")), utc, "no zone reads as UTC");
    assert_eq(_agnosai_msg_parse_rfc3339(str_from("2026-07-28T00:00:00+2")), 0 - 1,
      "a malformed offset is rejected, not ignored");
    assert_eq(_agnosai_msg_parse_rfc3339(str_from("2026-07-28T00:00:00Zjunk")), 0 - 1,
      "and so is trailing junk after the zone");

    # --- malformed input is rejected ---
    assert_eq(agnosai_message_from_json(str_from("not json")), 0, "garbage JSON rejected");
    assert_eq(agnosai_message_from_json(str_from("{\"id\":\"x\"}")), 0, "missing fields rejected");
    assert_eq(agnosai_message_target_from_value(bayan_json_v_str_new(str_from("nope"))), 0,
      "unknown target string rejected");

    # [6.5.5] `_a` forms agree with their global twins.
    var ms_ar = arena_allocator(262144);
    assert_eq(str_eq(bayan_json_v_build(agnosai_message_target_to_value_a(ms_ar, t_agent)),
        bayan_json_v_build(agnosai_message_target_to_value(t_agent))), 1,
      "message_target_to_value_a agrees");
    assert_eq(str_eq(bayan_json_v_build(agnosai_message_to_value_a(ms_ar, msg)),
        bayan_json_v_build(agnosai_message_to_value(msg))), 1, "message_to_value_a agrees");
    assert_eq(str_eq(agnosai_message_to_json_a(ms_ar, msg), agnosai_message_to_json(msg)), 1,
      "message_to_json_a agrees byte-for-byte");
    _t_v237_rfc3339();
    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
sys_exit_group(f);
