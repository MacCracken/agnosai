fn _t_state(): i64 {
    var reg = agnosai_tool_registry_new();
    agnosai_tool_registry_register(reg, agnosai_echo_tool());
    return agnosai_app_state_new(agnosai_orchestrator_new(0), reg,
    agnosai_auth_config_new(), agnosai_event_bus_new(),
    agnosai_audit_chain_new(), agnosai_approval_gate_new());
}

# The same state with **content in it** — eight finished crews and eight pending
# approvals.
#
# `_t_state`'s empty registry renders `[]` from every read route, and an empty
# body allocates almost nothing whether it is threaded or not. So the empty
# fixture cannot tell a threaded route from an un-threaded one: measuring
# against it would be the vacuous-assertion trap again, and this is the fixture
# `_t_allocation_profile`'s orchestrator-group numbers are taken over.
fn _t_state_populated(): i64 {
    var s = _t_state();
    var o = agnosai_app_state_orchestrator(s);
    for (var i = 0; i < 8; i = i + 1) {
        var spec = agnosai_crew_new(str_from("profile"));
        var tasks = vec_new();
        vec_push(tasks, agnosai_task_new(str_from("do the thing")));
        agnosai_crew_with_tasks(spec, tasks);
        agnosai_orchestrator_run_crew(o, spec);
        # **Each crew's result is given agent metadata.** Without it
        # `agnosai_route_agent_performance` takes its `str_len(key) > 0` guard
        # to false on every result and renders `[]` over eight crews — so its
        # per-agent object build never runs, and un-threading that build is a
        # mutation the measurement cannot see. It survived the sweep once for
        # exactly this reason.
        var st = agnosai_orchestrator_crew(o, agnosai_crew_id(spec));
        var r = agnosai_task_result_new(agnosai_uuid_v4_str(), str_from("out"),
        AGNOSAI_STATUS_COMPLETED);
        var ksb = str_builder_new();
        str_builder_add_cstr(ksb, "agent-");
        str_builder_add_int(ksb, i);
        agnosai_task_result_with_metadata(r, str_from("agent"),
        bayan_json_v_str_new(str_builder_build(ksb)));
        agnosai_task_result_with_metadata(r, str_from("agent_name"),
        bayan_json_v_str_new(str_from("The Agent")));
        agnosai_task_result_with_metadata(r, str_from("agent_role"),
        bayan_json_v_str_new(str_from("writer")));
        agnosai_crew_state_with_result(st, r);
    }
    for (var j = 0; j < 8; j = j + 1) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "task-");
        str_builder_add_int(sb, j);
        agnosai_approval_request(agnosai_app_state_approval_gate(s),
        str_builder_build(sb));
    }
    # One pending approval under a real UUID — `submit_approval` rejects a
    # non-UUID task_id at 422, so the eight above can never reach the gate.
    #
    # **This does not pin the delivered branch and is not meant to.** A
    # delivered approval is consumed, so only the first of a measuring loop's
    # iterations takes that path and the rest fall through to not-delivered.
    # `_agnosai_route_approval_message_a` is measured directly instead, below.
    agnosai_approval_request(agnosai_app_state_approval_gate(s),
    str_from("6ba7b810-9dad-11d1-80b4-00c04fd430c8"));
    return s;
}

# Bytes charged to the global bump by one POST of `body` to `path`, averaged
# over 32 calls. Same shape as `_t_per_request`, with the body hoisted for the
# same reason the path is.
fn _t_per_post(s, path: Str, body: Str, ar): i64 {
    var e = str_from("");
    if (ar == 0) {
        agnosai_route_dispatch(s, AGNOSAI_METHOD_POST, path, e, 0, body);
    } else {
        agnosai_route_dispatch_a(ar, s, AGNOSAI_METHOD_POST, path, e, 0, body);
        reset_via(ar);
    }
    var before = alloc_used();
    for (var i = 0; i < 32; i = i + 1) {
        if (ar == 0) {
            agnosai_route_dispatch(s, AGNOSAI_METHOD_POST, path, e, 0, body);
        } else {
            agnosai_route_dispatch_a(ar, s, AGNOSAI_METHOD_POST, path, e, 0, body);
            reset_via(ar);
        }
    }
    return (alloc_used() - before) / 32;
}

# Bytes charged to the **global** bump by one dispatch of `path`, averaged over
# 64 calls. `ar != 0` routes through `dispatch_a` with a reset between calls, so
# what it returns is the part the arena did NOT absorb.
fn _t_per_request(s, path: Str, ar): i64 {
    # Hoisted out of the loop deliberately: a `str_from("")` per iteration is
    # the *caller's* allocation, charged identically to both arms, and it would
    # sit in the arena figure as a constant that has nothing to do with the
    # route. Without the hoist the threaded arms all read 64 instead of 48.
    var empty = str_from("");
    # Warm every one-time path first, on whichever arm is being measured.
    if (ar == 0) {
        agnosai_route_dispatch(s, AGNOSAI_METHOD_GET, path, empty, 0, empty);
    } else {
        agnosai_route_dispatch_a(ar, s, AGNOSAI_METHOD_GET, path, empty, 0, empty);
        reset_via(ar);
    }
    var before = alloc_used();
    for (var i = 0; i < 64; i = i + 1) {
        if (ar == 0) {
            agnosai_route_dispatch(s, AGNOSAI_METHOD_GET, path, empty, 0, empty);
        } else {
            agnosai_route_dispatch_a(ar, s, AGNOSAI_METHOD_GET, path, empty, 0, empty);
            reset_via(ar);
        }
    }
    return (alloc_used() - before) / 64;
}

# --- Method mapping ------------------------------------------------------

fn _t_method_mapping(): i64 {
    assert(_agnosai_serve_method("GET") == AGNOSAI_METHOD_GET, "GET");
    assert(_agnosai_serve_method("POST") == AGNOSAI_METHOD_POST, "POST");
    assert(_agnosai_serve_method("DELETE") == AGNOSAI_METHOD_DELETE, "DELETE");

    # An unmapped verb becomes a value no route registers, so the router answers
    # 405 (path known, method not) rather than dispatching anything.
    assert(_agnosai_serve_method("PUT") == 0, "PUT maps to no route method");
    assert(_agnosai_serve_method("PATCH") == 0, "PATCH likewise");
    assert(_agnosai_serve_method("get") == 0, "method matching is case-sensitive");
    assert(_agnosai_serve_method(0) == 0, "an unparsed method line is 0");
    assert(_agnosai_serve_method("") == 0, "and so is the empty cstring sandhi returns");

    var s = _t_state();
    assert(agnosai_route_status(agnosai_route_dispatch(s, 0, str_from("/health"),
    str_from(""), 0, str_from(""))) == HTTP_METHOD_NOT_ALLOWED,
    "an unmapped verb on a known path is 405, not a dispatch");
    return 0;
}

# --- The response encoder ------------------------------------------------

fn _t_reason_phrases(): i64 {
    assert(str_eq(str_from(_agnosai_serve_reason(HTTP_OK)), str_from("OK")) == 1, "200");
    assert(str_eq(str_from(_agnosai_serve_reason(AGNOSAI_HTTP_CREATED)),
    str_from("Created")) == 1, "201");
    assert(str_eq(str_from(_agnosai_serve_reason(HTTP_NO_CONTENT)),
    str_from("No Content")) == 1, "204");
    assert(str_eq(str_from(_agnosai_serve_reason(HTTP_BAD_REQUEST)),
    str_from("Bad Request")) == 1, "400");
    assert(str_eq(str_from(_agnosai_serve_reason(HTTP_UNAUTHORIZED)),
    str_from("Unauthorized")) == 1, "401");
    assert(str_eq(str_from(_agnosai_serve_reason(HTTP_NOT_FOUND)),
    str_from("Not Found")) == 1, "404");
    assert(str_eq(str_from(_agnosai_serve_reason(HTTP_METHOD_NOT_ALLOWED)),
    str_from("Method Not Allowed")) == 1, "405");
    assert(str_eq(str_from(_agnosai_serve_reason(HTTP_PAYLOAD_TOO_LARGE)),
    str_from("Payload Too Large")) == 1, "413");
    assert(str_eq(str_from(_agnosai_serve_reason(AGNOSAI_HTTP_UNPROCESSABLE)),
    str_from("Unprocessable Entity")) == 1, "422");
    assert(str_eq(str_from(_agnosai_serve_reason(AGNOSAI_HTTP_TOO_MANY_REQUESTS)),
    str_from("Too Many Requests")) == 1, "429");
    assert(str_eq(str_from(_agnosai_serve_reason(HTTP_INTERNAL)),
    str_from("Internal Server Error")) == 1, "500 is the fallback");
    # Every status the router can emit has a phrase — an unmapped one would
    # silently ship as "Internal Server Error" alongside a 2xx code.
    assert(str_eq(str_from(_agnosai_serve_reason(HTTP_NOT_IMPLEMENTED)),  #skip-lint: status
    str_from("Not Implemented")) == 1, "501");
    return 0;
}

# --- Options -------------------------------------------------------------

# The blocker #3 setting, and the reason this is not `options_new()` alone.
fn _t_options(): i64 {
    var o = agnosai_serve_options();
    assert(sandhi_server_options_get_req_arena(o) == AGNOSAI_SERVE_ARENA_BYTES,
    "the per-request arena is enabled — blocker #3's whole point");
    assert(sandhi_server_options_get_req_arena(o) > 0, "...and non-zero, which is what enables it");
    assert(AGNOSAI_SERVE_ARENA_BYTES == 65536, "64 KiB, matching sandhi's request cap");
    assert(AGNOSAI_SERVE_WORKERS == AGNOSAI_MAX_CONCURRENT_REQUESTS,
    "the pool is sized from the oracle's concurrency limit rather than an invented number");
    return 0;
}

# --- The a2a callback gate ----------------------------------------------

fn _t_callback_body(url): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"task_id\":\"t1\",\"description\":\"d\",\"callback_url\":\"");
    str_builder_add_cstr(sb, url);
    str_builder_add_cstr(sb, "\"}");
    return str_builder_build(sb);
}

# The dispatcher reuses `agnosai_route_a2a_callback_allowed`, so the SSRF gate
# has one implementation and one set of tests — a URL rejected there is 0 here.
fn _t_callback_gate(): i64 {
    assert(agnosai_serve_callback_url(_t_callback_body("https://example.com/cb")) != 0,
    "a public callback URL is dispatchable");
    assert(agnosai_serve_callback_url(_t_callback_body("http://127.0.0.1/cb")) == 0,
    "a loopback callback URL is refused — the same gate a2a applies");
    assert(agnosai_serve_callback_url(_t_callback_body("http://169.254.169.254/x")) == 0,
    "the metadata IP is refused");
    assert(agnosai_serve_callback_url(_t_callback_body("file:///etc/passwd")) == 0,
    "a non-http scheme is refused");

    # No callback asked for, and bodies that are not A2A requests at all.
    assert(agnosai_serve_callback_url(
    str_from("{\"task_id\":\"t\",\"description\":\"d\"}")) == 0,
    "a body with no callback_url dispatches nothing");
    assert(agnosai_serve_callback_url(str_from("not json")) == 0, "malformed JSON is 0");
    assert(agnosai_serve_callback_url(str_from("{}")) == 0, "a non-A2A body is 0");
    assert(agnosai_serve_callback_url(str_from("")) == 0, "an empty body is 0");

    # And the URL that comes back is the one that was asked for.
    assert(str_eq(agnosai_serve_callback_url(_t_callback_body("https://example.com/cb")),
    str_from("https://example.com/cb")) == 1, "the dispatchable URL round-trips");
    return 0;
}

# A refused URL must not spawn a thread, and must not be reported as dispatched.
fn _t_callback_dispatch_is_gated(): i64 {
    assert(agnosai_serve_dispatch_callback(_t_callback_body("http://127.0.0.1/cb")) == 0,
    "a refused URL dispatches nothing");
    assert(agnosai_serve_dispatch_callback(str_from("{}")) == 0,
    "a non-A2A body dispatches nothing");
    assert(agnosai_serve_dispatch_callback(str_from("not json")) == 0,
    "malformed JSON dispatches nothing");
    assert(AGNOSAI_SERVE_CALLBACK_TIMEOUT_MS == 30000,
    "the callback timeout is the oracle's 30 seconds");
    return 0;
}

# --- rate_limit is NOT mounted by default -------------------------------

# Matching the oracle, which never installs the middleware. Mounting it would be
# a wire change — clients fine today would start seeing 429s at a threshold
# agnosai chose.
fn _t_rate_limit_off_by_default(): i64 {
    _agnosai_serve_limiter = 0;
    assert(_agnosai_serve_limiter == 0, "the limiter is unset by default");
    # With no limiter the check passes everything, however often.
    for (var i = 0; i < 200; i = i + 1) {
        if (agnosai_rate_limit_check_request(0, str_from("c")) != HTTP_OK) {
            assert(0, "an unmounted limiter must never refuse a request");
        }
    }
    assert(agnosai_rate_limit_check_request(0, str_from("c")) == HTTP_OK,
    "200 consecutive requests pass with no limiter mounted");

    # The opt-in path builds one.
    var lim = agnosai_rate_limit_new(10000, 2);
    assert(agnosai_rate_limit_check_request(lim, str_from("c")) == HTTP_OK, "opt-in: first");
    assert(agnosai_rate_limit_check_request(lim, str_from("c")) == HTTP_OK, "opt-in: second");
    assert(agnosai_rate_limit_check_request(lim, str_from("c"))
    == AGNOSAI_HTTP_TOO_MANY_REQUESTS, "opt-in: third is 429");
    return 0;
}

# --- The handler, end to end over a pipe --------------------------------

# `agnosai_serve_handler` writes its response to a raw fd, so a pipe stands in
# for the socket and the whole adapter runs for real: sandhi's request parse,
# the router, the handler, and the response encoder. Everything except the
# accept loop.
#
# Outside a sandhi worker `sandhi_server_request_arena()` is 0, which is exactly
# the fallback path the handler carries — so this also proves the bare-allocator
# branch works rather than leaving it to a live server to discover.
fn _t_serve_over_pipe(req: Str, out): i64 {
    var fds[8];
    if (sys_pipe(&fds) < 0) { return -1; }
    var rfd = load32(&fds);
    var wfd = load32(&fds + 4);
    agnosai_serve_handler(0, wfd, str_data(req), str_len(req));
    sys_close(wfd);
    var n = file_read(rfd, out, 8192);
    sys_close(rfd);
    if (n < 0) { n = 0; }
    return n;
}

fn _t_starts_with(hay, n, needle): i64 {
    var m = str_len(str_from(needle));
    if (n < m) { return 0; }
    for (var i = 0; i < m; i = i + 1) {
        if ((load8(hay + i) & 255) != (load8(str_data(str_from(needle)) + i) & 255)) {
            return 0;
        }
    }
    return 1;
}

fn _t_contains(hay, n, needle): i64 {
    var nd = str_from(needle);
    var m = str_len(nd);
    if (m == 0 || n < m) { return 0; }
    for (var i = 0; i <= n - m; i = i + 1) {
        if (_t_starts_with(hay + i, n - i, needle) == 1) { return 1; }
    }
    return 0;
}

fn _t_handler_end_to_end(): i64 {
    var s = _t_state();
    agnosai_serve_mount(s, 0);
    var out[8192];

    # A public route: parsed, routed, handled, encoded.
    var n = _t_serve_over_pipe(str_from(
    "GET /health HTTP/1.1\r\nHost: x\r\n\r\n"), &out);
    assert(n > 0, "the handler wrote a response");
    assert(_t_starts_with(&out, n, "HTTP/1.1 200 OK\r\n") == 1, "a status line, with reason");
    assert(_t_contains(&out, n, "Content-Type: application/json") == 1,
    "the JSON content type");
    assert(_t_contains(&out, n, "Content-Length:") == 1, "and a length — not a dangling body");
    assert(_t_contains(&out, n, "\"status\"") == 1, "the health body itself");

    # An unknown path is 404 with the reason phrase, not a bare code.
    var n2 = _t_serve_over_pipe(str_from(
    "GET /nope HTTP/1.1\r\nHost: x\r\n\r\n"), &out);
    assert(_t_starts_with(&out, n2, "HTTP/1.1 404 Not Found\r\n") == 1, "404 with its reason");

    # A known path with an unregistered verb is 405, not 404.
    var n3 = _t_serve_over_pipe(str_from(
    "PUT /health HTTP/1.1\r\nHost: x\r\n\r\n"), &out);
    assert(_t_starts_with(&out, n3, "HTTP/1.1 405 Method Not Allowed\r\n") == 1,
    "405 for a known path with an unmapped verb");

    # A protected route reaches its handler when auth is not configured — the
    # oracle's default, and the case that proves the transport routes at all.
    var n4 = _t_serve_over_pipe(str_from(
    "GET /api/v1/tools HTTP/1.1\r\nHost: x\r\n\r\n"), &out);
    assert(_t_starts_with(&out, n4, "HTTP/1.1 200 OK\r\n") == 1,
    "with auth unconfigured a protected route answers normally");
    assert(_t_contains(&out, n4, "echo") == 1, "...and the handler's real body came back");

    # **The auth boundary, exercised through the transport.** With a secret
    # configured, the same request must not reach the handler.
    var guarded = agnosai_app_state_new(agnosai_orchestrator_new(0),
    agnosai_app_state_tools(s), agnosai_auth_config_with_secret(str_from("s3cr3t")),
    agnosai_event_bus_new(), agnosai_audit_chain_new(), agnosai_approval_gate_new());
    agnosai_serve_mount(guarded, 0);

    var n5 = _t_serve_over_pipe(str_from(
    "GET /api/v1/tools HTTP/1.1\r\nHost: x\r\n\r\n"), &out);
    assert(_t_starts_with(&out, n5, "HTTP/1.1 401 Unauthorized\r\n") == 1,
    "a protected route without credentials is 401 at the transport");
    assert(_t_contains(&out, n5, "echo") == 0,
    "...and the tool list did not leak into the 401 body");

    # A wrong secret is 401 too — the header was read, not merely counted.
    var n6 = _t_serve_over_pipe(str_from(
    "GET /api/v1/tools HTTP/1.1\r\nHost: x\r\nAuthorization: Bearer wrong\r\n\r\n"), &out);
    assert(_t_starts_with(&out, n6, "HTTP/1.1 401 Unauthorized\r\n") == 1,
    "a wrong bearer token is 401");

    # The right one passes, which is what proves the header value survived the
    # cstring-to-Str conversion intact rather than arriving empty.
    var n7 = _t_serve_over_pipe(str_from(
    "GET /api/v1/tools HTTP/1.1\r\nHost: x\r\nAuthorization: Bearer s3cr3t\r\n\r\n"), &out);
    assert(_t_starts_with(&out, n7, "HTTP/1.1 200 OK\r\n") == 1,
    "the correct bearer token reaches the handler");
    assert(_t_contains(&out, n7, "echo") == 1, "...and gets the real body");

    # A present-but-empty `Authorization:` is 401, same as an absent one. The
    # two differ only in the audit reason sakshi records, not on the wire.
    var ne = _t_serve_over_pipe(str_from(
    "GET /api/v1/tools HTTP/1.1\r\nHost: x\r\nAuthorization:\r\n\r\n"), &out);
    assert(_t_starts_with(&out, ne, "HTTP/1.1 401 Unauthorized\r\n") == 1,
    "an empty Authorization header is 401");
    var nb = _t_serve_over_pipe(str_from(
    "GET /api/v1/tools HTTP/1.1\r\nHost: x\r\nAuthorization: Basic dXNlcjpwdw==\r\n\r\n"),
    &out);
    assert(_t_starts_with(&out, nb, "HTTP/1.1 401 Unauthorized\r\n") == 1,
    "a non-Bearer scheme is 401 — the scheme is checked, not just presence");

    # A public route is still public with auth configured.
    var n8 = _t_serve_over_pipe(str_from(
    "GET /health HTTP/1.1\r\nHost: x\r\n\r\n"), &out);
    assert(_t_starts_with(&out, n8, "HTTP/1.1 200 OK\r\n") == 1,
    "/health stays public behind a configured secret");
    agnosai_serve_mount(s, 0);

    # A body arrives at the handler: this POST is rejected on its CONTENT, which
    # can only happen if the body offset and length were computed correctly.
    var n9 = _t_serve_over_pipe(str_from(
    "POST /mcp HTTP/1.1\r\nHost: x\r\nContent-Length: 9\r\n\r\nnot json!"), &out);
    assert(n9 > 0, "a POST with a body gets a response");
    assert(_t_starts_with(&out, n9, "HTTP/1.1 200 ") == 0,
    "a malformed body is not answered 200");
    return 0;
}

# --- Mounting, and the bind-failure contract ----------------------------

fn _t_mount(): i64 {
    var s = _t_state();

    # The default entry point mounts no limiter — the oracle's behaviour.
    var o = agnosai_serve_mount(s, 0);
    assert(_agnosai_serve_state == s, "the handler's state is the one mounted");
    assert(_agnosai_serve_limiter == 0, "the default mount installs no limiter");
    assert(sandhi_server_options_get_req_arena(o) == AGNOSAI_SERVE_ARENA_BYTES,
    "mount returns the options the listener runs under");

    # The opt-in path installs one, and mounting again clears it — so a second
    # `agnosai_serve` call cannot inherit a limiter from a previous one.
    var lim = agnosai_rate_limit_new(10000, 2);
    agnosai_serve_mount(s, lim);
    assert(_agnosai_serve_limiter == lim, "the opt-in mount installs the limiter");
    agnosai_serve_mount(s, 0);
    assert(_agnosai_serve_limiter == 0, "re-mounting clears it rather than accumulating");

    # Metrics are registered by mounting, not lazily on first scrape — so a
    # `/metrics` request before any traffic renders the registry, not an error.
    assert(agnosai_metrics_global() != 0, "the metrics registry exists after mounting");
    return 0;
}

# The doc comment promises a bind failure RETURNS rather than looping, and a
# caller must treat that as fatal. TEST-NET-1 (192.0.2.0/24, RFC 5737) is never
# assigned to a host, so the bind fails with EADDRNOTAVAIL at any privilege
# level — this cannot accidentally start listening, even as root. That matters
# more than it looks: `sandhi_server_run_pooled` fails at `sock_bind` BEFORE any
# `thread_create`, so a test that binds successfully would spawn 100 workers
# — each reserving a 10 MiB request buffer — and then never return.
#
# **`addr` is a network-order IPv4 u32, not a `Str`.** These three sites passed
# `str_from("192.0.2.1")` until 2026-08-03, which put a 16-byte heap `Str`
# *header pointer* into `sin_addr`: the assertions passed, but for a garbage
# address rather than for TEST-NET-1, so the stated rationale did not hold.
# 0x010200C0 is 192.0.2.1 in the byte order `store32` writes little-endian at
# `lib/net.cyr:99` — same convention as `INADDR_LOOPBACK()` = 0x0100007F.
var _T_TESTNET1 = 0x010200C0;

fn _t_bind_failure_returns(): i64 {
    var s = _t_state();
    assert(agnosai_serve(s, _T_TESTNET1, 9) == 1,
    "an unbindable address returns 1 rather than looping forever");
    assert(agnosai_serve_with_rate_limit(s, _T_TESTNET1, 9, 10000, 2) == 1,
    "the opt-in entry point reports the same failure");
    # ...and the failed opt-in attempt still left the limiter mounted, which is
    # why `agnosai_serve` clears it rather than assuming a fresh process.
    assert(_agnosai_serve_limiter != 0, "a failed opt-in start still mounted its limiter");
    assert(agnosai_serve(s, _T_TESTNET1, 9) == 1, "and a retry re-reports");
    assert(_agnosai_serve_limiter == 0, "...having cleared it");
    return 0;
}

# --- SSE (M6 bite 15c) ---------------------------------------------------

# The unknown-crew path terminates on its own, so it needs no thread: the
# handler emits one error frame and ends the chunked body.
fn _t_sse_over_pipe(state, id: Str, out): i64 {
    var fds[8];
    if (sys_pipe(&fds) < 0) { return -1; }
    var rfd = load32(&fds);
    var wfd = load32(&fds + 4);
    agnosai_sse_crew_stream(state, wfd, id);
    sys_close(wfd);
    var n = file_read(rfd, out, 8192);
    sys_close(rfd);
    if (n < 0) { n = 0; }
    return n;
}

# An id that parses but names no crew: `has` is 0, so the oracle yields a single
# `error` event carrying "crew not found" and returns (`routes/sse.rs:34-44`).
fn _t_sse_unknown_crew(): i64 {
    var s = _t_state();
    var out[8192];
    var n = _t_sse_over_pipe(s, str_from("aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee"), &out);
    assert(n > 0, "the stream wrote something");

    assert(_t_starts_with(&out, n, "HTTP/1.1 200 OK\r\n") == 1,
    "SSE is a 200 — an unknown crew is reported IN the stream, not as a status");
    assert(_t_contains(&out, n, "Content-Type: text/event-stream") == 1,
    "the SSE content type the oracle's test asserts");
    assert(_t_contains(&out, n, "Transfer-Encoding: chunked") == 1, "streamed, not buffered");
    assert(_t_contains(&out, n, "Cache-Control: no-cache") == 1, "and not cacheable");

    assert(_t_contains(&out, n, "event: error") == 1,
    "an error event — the oracle's sse_endpoint_sends_error_event_for_unknown_crew");
    assert(_t_contains(&out, n, "crew not found") == 1, "...naming the reason");
    assert(_t_contains(&out, n, "\"event_type\":\"error\"") == 1,
    "the frame carries a whole serialised CrewEvent, not a bare message");
    assert(_t_contains(&out, n, "0\r\n\r\n") == 1, "and the chunked terminator closes the body");

    # No `connected` frame on this path — the oracle returns before emitting one.
    assert(_t_contains(&out, n, "event: connected") == 0,
    "an unknown crew never gets a connected event");
    return 0;
}

# **Canonicalisation.** An uppercase id parses, and crew ids are minted
# lowercase, so without `agnosai_uuid_canonical` the bus lookup would miss and a
# live crew would be reported as not found. The oracle cannot have this bug: it
# takes `Path<Uuid>` and immediately `to_string()`s it.
fn _t_sse_uppercase_id_canonicalises(): i64 {
    var s = _t_state();
    var bus = agnosai_app_state_events(s);
    var lower = str_from("aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee");

    # Make the crew live under its lowercase (minted) spelling.
    agnosai_event_bus_subscribe(bus, lower);
    assert(agnosai_event_bus_has(bus, lower) == 1, "the crew is live under the lowercase id");

    # A LIVE crew streams until its subscription closes, so this needs a closer
    # thread exactly as the live-stream test does. Without one the handler is
    # correct and the test hangs — which is what happened writing it.
    _t_sse_bus = bus;
    _t_sse_crew = lower;
    thread_create(&_t_sse_closer, 0);

    # The same id in uppercase must resolve to it, not to "not found".
    var out[8192];
    var n = _t_sse_over_pipe(s, str_from("AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE"), &out);
    assert(_t_contains(&out, n, "crew not found") == 0,
    "an UPPERCASE id finds the crew — canonicalised before the bus lookup");
    assert(_t_contains(&out, n, "\"crew_id\":\"aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee\"") == 1,
    "...and the frames echo the LOWERCASE id, as Uuid::to_string does");
    return 0;
}

# State shared with the helper threads below: they run concurrently with the
# handler, so these cannot be stack locals.
var _t_sse_bus = 0;
var _t_sse_crew = 0;

# End the crew after a delay, closing the handler's subscription.
#
# **Every test against a LIVE crew needs one of these.** A live stream is
# correct precisely because it does not end on its own, so a suite that forgets
# to close the crew hangs rather than failing — which is how this helper came to
# exist.
fn _t_sse_closer(arg) {
    sleep_ms(150);
    agnosai_event_bus_remove(_t_sse_bus, _t_sse_crew);
    return 0;
}

# Publish one event, then end the crew — which closes the handler's subscription
# and is what lets the stream terminate.
fn _t_sse_feeder(arg) {
    sleep_ms(120);
    var tx = agnosai_event_bus_sender(_t_sse_bus, _t_sse_crew);
    var d = bayan_json_v_obj_new();
    bayan_json_v_obj_set(d, str_from("step"), bayan_json_v_str_new(str_from("one")));
    agnosai_event_sender_send(tx, agnosai_crew_event_new(_t_sse_crew,
    str_from("task_started"), d));
    sleep_ms(160);
    agnosai_event_bus_remove(_t_sse_bus, _t_sse_crew);
    return 0;
}

# The live path: connected frame, a forwarded event, then termination on Closed.
#
# This is the half the unknown-crew test cannot reach, and the one that proves
# `agnosai_event_sub_closed` actually ends the loop — without it the handler
# polls forever and this test hangs rather than failing.
fn _t_sse_live_stream(): i64 {
    var s = _t_state();
    _t_sse_bus = agnosai_app_state_events(s);
    _t_sse_crew = str_from("11111111-2222-4333-8444-555555555555");

    agnosai_event_bus_subscribe(_t_sse_bus, _t_sse_crew);
    thread_create(&_t_sse_feeder, 0);

    var out[8192];
    var n = _t_sse_over_pipe(s, _t_sse_crew, &out);
    assert(n > 0, "the live stream wrote frames");
    assert(_t_contains(&out, n, "event: connected") == 1,
    "a live crew gets the connected event — the oracle's third test");
    assert(_t_contains(&out, n, "SSE stream connected") == 1, "...with its message");
    assert(_t_contains(&out, n, "event: task_started") == 1,
    "the forwarded event uses its OWN type as the SSE event name");
    assert(_t_contains(&out, n, "\"step\":\"one\"") == 1, "carrying the event's data verbatim");
    assert(_t_contains(&out, n, "0\r\n\r\n") == 1,
    "and a closed subscription ends the body rather than looping forever");
    return 0;
}

# Routing and auth still precede the stream, exactly as in the dispatcher.
fn _t_sse_transport_gates(): i64 {
    var s = _t_state();
    agnosai_serve_mount(s, 0);
    var out[8192];

    # A malformed id is 422 — the oracle's `Path<Uuid>` extractor rejects before
    # the handler, matching `agnosai_route_get_crew`. This is the assertion that
    # caught an unauthenticated SIGSEGV: the route matches on shape alone, so
    # without the gate the id reached `agnosai_uuid_canonical`, which answered 0,
    # and `str_clone(0)` faulted.
    var n = _t_serve_over_pipe(str_from(
    "GET /api/v1/crews/not-a-uuid/stream HTTP/1.1\r\nHost: x\r\n\r\n"), &out);
    assert(_t_starts_with(&out, n, "HTTP/1.1 422 Unprocessable Entity\r\n") == 1,
    "a malformed crew id is 422, not a stream and not a crash");
    assert(_t_contains(&out, n, "text/event-stream") == 0,
    "...with no SSE headers written");

    # With auth configured the stream is refused BEFORE any chunked header is
    # written — a 401 must be a normal buffered response, not a stream carrying
    # an error frame.
    var guarded = agnosai_app_state_new(agnosai_orchestrator_new(0),
    agnosai_app_state_tools(s), agnosai_auth_config_with_secret(str_from("s3cr3t")),
    agnosai_event_bus_new(), agnosai_audit_chain_new(), agnosai_approval_gate_new());
    agnosai_serve_mount(guarded, 0);
    var n2 = _t_serve_over_pipe(str_from(
    "GET /api/v1/crews/aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee/stream HTTP/1.1\r\nHost: x\r\n\r\n"),
    &out);
    assert(_t_starts_with(&out, n2, "HTTP/1.1 401 Unauthorized\r\n") == 1,
    "auth precedes the stream, and refuses with a buffered 401");
    assert(_t_contains(&out, n2, "text/event-stream") == 0,
    "...emitting no SSE headers at all");

    agnosai_serve_mount(s, 0);
    return 0;
}

# Graceful shutdown (ADR 013). Unblocked by cyrius 6.5.6, which vendors sandhi
# 1.9.9's `sandhi_server_options_stop_flag` — before it, ADR 012 recorded that
# no amount of signal handling could reach a loop parked in `accept`.
fn _t_shutdown_flag_wired(): i64 {
    assert(agnosai_serve_stop_requested() == 0, "no shutdown is requested at rest");

    # The mount must hand sandhi the flag, or the whole mechanism is inert while
    # looking correct — the signal thread would set a flag nobody polls.
    var s = _t_state();
    var o = agnosai_serve_mount(s, 0);
    assert(sandhi_server_options_get_stop_flag(o) != 0,
    "mount wires a stop flag into the sandhi options");
    assert(sandhi_server_options_get_stop_flag(o) == &_agnosai_serve_stop,
    "...and it is THIS module's flag, the one the signal thread writes");

    # Wired on the opt-in entry point too — a rate-limited server must still be
    # stoppable.
    var o2 = agnosai_serve_mount(s, agnosai_rate_limit_new(10000, 2));
    assert(sandhi_server_options_get_stop_flag(o2) == &_agnosai_serve_stop,
    "the rate-limited mount wires it as well");
    agnosai_serve_mount(s, 0);
    return 0;
}

# The signal path end to end, in-process: install the handler, signal ourselves,
# and confirm the flag flips.
#
# This runs LAST in the suite. `agnosai_serve_install_signals` blocks
# SIGINT/SIGTERM for the whole process and parks a thread on a signalfd, so
# anything after it inherits a changed signal mask. Ordering it last keeps that
# contained rather than letting it leak into unrelated assertions.
fn _t_shutdown_signal_sets_flag(): i64 {
    assert(agnosai_serve_install_signals() == 1, "signal handlers install");
    assert(agnosai_serve_stop_requested() == 0, "installing does not itself request a stop");

    # SIGTERM to self. Blocked, so it lands on the signalfd rather than killing
    # the test — which is exactly the property being asserted: if the mask were
    # not installed first, this line would terminate the suite instead of
    # failing an assertion.
    sys_kill(sys_getpid(), SIGTERM);

    # The reader thread has to be scheduled. Poll rather than sleeping a fixed
    # amount, so a loaded box does not make this flaky.
    var waited = 0;
    while (waited < 2000) {
        if (agnosai_serve_stop_requested() == 1) { waited = 5000; }
        if (waited < 5000) { sleep_ms(10); waited = waited + 10; }
    }
    assert(agnosai_serve_stop_requested() == 1,
    "a delivered SIGTERM sets the stop flag the serve loops poll");
    return 0;
}

# `agnosai_serve_parse_port` reproduces `u16::from_str`, which neither stdlib
# parser does. The cases that matter are the ones where the two stdlib parsers
# answer a NUMBER rather than failing — those are the silent misbinds.
fn _t_parse_port(): i64 {
    assert(agnosai_serve_parse_port(str_from("8080")) == 8080, "a plain port parses");
    assert(agnosai_serve_parse_port(str_from("0")) == 0, "0 is a legal u16, not the sentinel");
    assert(agnosai_serve_parse_port(str_from("65535")) == 65535, "the u16 ceiling parses");
    assert(agnosai_serve_parse_port(str_from("65536")) == 0 - 1, "one past the ceiling is Err");
    assert(agnosai_serve_parse_port(str_from("+80")) == 80, "a single leading + is Ok, as in Rust");

    # Unbounded leading zeros are Ok in Rust: from_str_radix bounds the VALUE
    # via checked_mul/checked_add, never the digit count. A 5-digit length cap
    # would reject these and silently fall back to 8080.
    assert(agnosai_serve_parse_port(str_from("000080")) == 80, "leading zeros do not cap length");
    assert(agnosai_serve_parse_port(str_from("0000065535")) == 65535,
    "...even ten digits, so long as the value fits");
    assert(agnosai_serve_parse_port(str_from("+000080")) == 80, "sign and zeros together");

    # The two stdlib parsers answer a number for every case below. That is the
    # whole reason this function exists rather than delegating.
    assert(agnosai_serve_parse_port(str_from("80a80")) == 0 - 1,
    "an embedded non-digit is Err (str_to_int skips it and answers 8080)");
    assert(agnosai_serve_parse_port(str_from("80 ")) == 0 - 1,
    "a trailing space is Err (atoi stops and answers 80)");
    assert(agnosai_serve_parse_port(str_from(" 80")) == 0 - 1, "a leading space is Err");
    assert(agnosai_serve_parse_port(str_from("-80")) == 0 - 1, "a negative is Err, not a u16");
    assert(agnosai_serve_parse_port(str_from("")) == 0 - 1, "empty is Err, not the default");
    assert(agnosai_serve_parse_port(str_from("+")) == 0 - 1, "a lone sign is Err");
    assert(agnosai_serve_parse_port(str_from("99999")) == 0 - 1, "five digits over the ceiling is Err");
    return 0;
}

# --- The allocation measurement -----------------------------------------

# **What the arena bought, stated as two numbers rather than one claim.**
#
# Blocker #3's mitigation threads `_a` through every sandhi call, and sandhi's
# worker rewinds the arena between requests — so the transport half costs
# nothing per request. But `bayan_json_v_parse_buf` / `_build` thread no
# allocator and bayan ships no `_a` variants, so every handler that reads a body
# or builds a JSON response still grows the no-free global bump.
#
# Measured here so the residual is a number in the record rather than a
# hand-wave. Writing this test is what caught the router re-splitting all 18
# patterns per request — routing cost 4,352 B/request, six times the handler it
# was dispatching to, and now costs 48.
fn _t_allocation_profile(): i64 {
    var s = _t_state();
    # Warm every one-time path first.
    agnosai_route_dispatch(s, AGNOSAI_METHOD_GET, str_from("/health"),
    str_from(""), 0, str_from(""));
    agnosai_route_dispatch(s, AGNOSAI_METHOD_GET, str_from("/api/v1/tools"),
    str_from(""), 0, str_from(""));

    # The routing half — what the arena would cover under sandhi.
    var before = alloc_used();
    for (var i = 0; i < 64; i = i + 1) {
        agnosai_route_resolve(AGNOSAI_METHOD_GET, str_from("/api/v1/dashboard/agents"));
    }
    var per_resolve = (alloc_used() - before) / 64;
    assert(per_resolve < 128, "routing is ~48 B/request — the match struct, nothing more");

    # The handler half — what bayan still charges, and the part that is NOT flat.
    var b2 = alloc_used();
    for (var j = 0; j < 64; j = j + 1) {
        agnosai_route_dispatch(s, AGNOSAI_METHOD_GET, str_from("/health"),
        str_from(""), 0, str_from(""));
    }
    var per_health = (alloc_used() - b2) / 64;
    assert(per_health > 0, "building a JSON response does allocate — not a zero claim");
    assert(per_health < 1024, "...but bounded per call, at ~352 B");
    assert(per_health > per_resolve * 2,
    "the handler half dominates: bayan's build, not the route table, is the residual");

    # A miss costs the same as a hit now. Before the allocation-free matcher it
    # cost twelve times as much, because a miss walked the whole table.
    var b3 = alloc_used();
    for (var k = 0; k < 64; k = k + 1) {
        agnosai_route_dispatch(s, AGNOSAI_METHOD_GET, str_from("/nonexistent"),
        str_from(""), 0, str_from(""));
    }
    var per_404 = (alloc_used() - b3) / 64;
    assert(per_404 < 1024, "a full-table miss is no longer the expensive case");

    # And a response that grows with content costs more than a fixed one, which
    # is the shape that IS acceptable: proportional to the answer, not to the
    # number of routes registered.
    var b4 = alloc_used();
    for (var m = 0; m < 64; m = m + 1) {
        agnosai_route_dispatch(s, AGNOSAI_METHOD_GET, str_from("/api/v1/tools"),
        str_from(""), 0, str_from(""));
    }
    var per_list = (alloc_used() - b4) / 64;
    assert(per_list > per_health,
    "a list response costs more than a fixed one — proportional to the answer");
    assert(per_list < 8192, "...and still bounded");

    # --- B2: a threaded route on the per-request arena --------------------
    #
    # **The first route whose handler half is nearly flat.** Everything above
    # measures the global path, which is what a caller dispatching without an
    # arena still gets and what the oracle's shape costs. `dispatch_a` with a
    # real arena is the path sandhi takes, and `/api/v1/agents/definitions`
    # measured **1,696 → 80 bytes per request** across two changes: threading
    # the route onto core's existing `_a` forms (1,696 → 384), then walking map
    # slots instead of `map_keys` (384 → 80), which is standing rule 5 and was
    # the entire residual.
    #
    # The assertion is a ratio rather than an absolute so it survives an
    # allocator whose bookkeeping differs, while still failing loudly if the
    # threading is undone — un-threading any single call puts the arena path
    # back within a small factor of the global one.
    #
    # **Measured through `_t_per_request`, which hoists the argument Strs out of
    # the timed loop.** The hand-rolled version this replaced minted the path
    # and two empty headers on every iteration, so it charged the arena arm
    # 48 bytes of the *caller's* allocation and could only ever be asserted as a
    # ratio. Those 48 bytes had nothing to do with the route.
    var ar = arena_allocator(65536);
    var defs_path = str_from("/api/v1/agents/definitions");
    var per_defs_global = _t_per_request(s, defs_path, 0);
    var per_defs_arena = _t_per_request(s, defs_path, ar);

    assert(per_defs_global > 0, "the global path allocates, as every route above does");
    assert(per_defs_arena == 0,
    "the SAME route through a per-request arena costs the global bump NOTHING — \
    1,696 B to 384 B by threading the route, to 80 B by walking map slots instead \
    of `map_keys`, to 0 B by threading the router underneath it");

    # The same, for `/api/v1/tools` — the most expensive route in the table, and
    # the **last** one to reach zero. 7,384 → 1,696 → 320 → 288 → 0 across four
    # changes.
    #
    # It sat at a floor for three of them, and the floor was the tool vtable
    # rather than this module: `agnosai_tool_schema` called each tool's own
    # `schema_fp`, which rebuilds its schema and every parameter under it per
    # call, and the vtable passed no allocator — so nothing in the routes or
    # registry tier could reach that allocation. `schema_fp` now takes the
    # allocator as its first parameter and all fourteen implementors thread it.
    var tools_path = str_from("/api/v1/tools");
    var per_tools_global = _t_per_request(s, tools_path, 0);
    var per_tools_arena = _t_per_request(s, tools_path, ar);

    assert(per_tools_global > 0, "the global path allocates the whole schema tree");
    # **An equality, and it took four changes to earn it.** The threshold on
    # this line was 2x, then 3x, then 5x — each one a bound with slack, and the
    # 2x version passed both the threaded and the un-threaded case, so it
    # asserted nothing at all. There is no slack in `== 0`.
    assert(per_tools_arena == 0,
    "the tools listing costs the global bump NOTHING — including the per-tool \
    schema_fp build, now that the vtable passes the allocator through");

    # --- B2: the orchestrator group's four read routes --------------------
    #
    # `/api/v1/dashboard/crews`, `/api/v1/dashboard/agents`, `/api/v1/approvals`
    # and `/api/v1/crews/{id}` — the last un-threaded reads in the table, and
    # the first group whose handler half reaches **exactly zero**.
    #
    # Measured over `_t_state_populated` (8 finished crews each carrying agent
    # metadata, 8 pending approvals), global against arena, bytes per request:
    #
    #     /api/v1/dashboard/agents   4,368 -> 32
    #     /api/v1/dashboard/crews    4,160 -> 32
    #     /api/v1/crews/{id}         2,368 -> 64
    #     /api/v1/approvals            576 -> 32
    #     /api/v1/crews/{unknown}      336 -> 64   (the 404 arm)
    #
    # **The 32 is not the handler.** `agnosai_route_resolve` mints the match
    # struct on the global bump before dispatch reaches any arm, threaded or
    # not, and `/api/v1/crews/{id}`'s extra 32 is the wildcard param Str the
    # matcher stores. Nothing in these four handlers survives the arena — which
    # is why the assertions below are absolute bounds rather than the ratios the
    # two groups above use. A ratio cannot distinguish "the handler contributes
    # nothing" from "the handler contributes a little", and at these magnitudes
    # every un-threading mutation still clears a 4x ratio.
    var ps = _t_state_populated();
    var cid = vec_get(agnosai_orchestrator_crew_ids(
    agnosai_app_state_orchestrator(ps)), 0);
    var csb = str_builder_new();
    str_builder_add_cstr(csb, "/api/v1/crews/");
    str_builder_add_str(csb, cid);
    var crew_path = str_builder_build(csb);

    var p_hist_g = _t_per_request(ps, str_from("/api/v1/dashboard/crews"), 0);
    var p_hist_a = _t_per_request(ps, str_from("/api/v1/dashboard/crews"), ar);
    var p_perf_g = _t_per_request(ps, str_from("/api/v1/dashboard/agents"), 0);
    var p_perf_a = _t_per_request(ps, str_from("/api/v1/dashboard/agents"), ar);
    var p_pend_g = _t_per_request(ps, str_from("/api/v1/approvals"), 0);
    var p_pend_a = _t_per_request(ps, str_from("/api/v1/approvals"), ar);
    var p_crew_g = _t_per_request(ps, crew_path, 0);
    var p_crew_a = _t_per_request(ps, crew_path, ar);

    # **The 404 arm is measured too, not just its status.** A threaded route's
    # error paths are separately threadable and separately forgettable: with the
    # success path measured and the failure path only status-checked, reverting
    # `route_error_a` to `route_error` inside `get_crew_a` passed the whole
    # suite. It is also the arm an unauthenticated scan hits hardest, so it is
    # the one least affordable as a per-request leak.
    var p_404_g = _t_per_request(ps,
    str_from("/api/v1/crews/00000000-0000-0000-0000-000000000000"), 0);
    var p_404_a = _t_per_request(ps,
    str_from("/api/v1/crews/00000000-0000-0000-0000-000000000000"), ar);

    # The global arm still allocates in proportion to the answer — the oracle's
    # shape, and what a caller dispatching without an arena gets.
    assert(p_hist_g > 1024, "the crew history global path is the heaviest read route");
    assert(p_perf_g > 128, "agent performance allocates per result walked");
    assert(p_pend_g > 128, "the pending list allocates per pending id");
    assert(p_crew_g > 512, "a single crew's state renders its whole result vec");

    # **These are equalities, because the answer is exactly zero.** The bound
    # used to be `agnosai_route_resolve`'s own cost, measured in the same run:
    # the match struct was minted before dispatch reached any arm, so it was in
    # both columns and no handler threading could remove it. Threading the
    # router removed it, and five of these routes now charge the global bump
    # **nothing at all** for a request served through an arena.
    #
    # An equality is also the strongest mutation detector available here. Every
    # earlier form of this test was a bound with slack, and slack is what let
    # three separate un-threadings pass: a route's 404 arm, a per-agent object
    # build, and a single hoisted `str_from` worth 16 bytes. Against `== 0`
    # there is no slack to hide in — un-threading *any* call in these handlers,
    # or in the router beneath them, fails on the next line.
    assert(p_hist_a == 0,
    "crew history through the arena costs the global bump NOTHING — handler and \
    router both");
    assert(p_perf_a == 0, "...and so does agent performance");
    assert(p_pend_a == 0, "...and the pending list");
    assert(per_defs_arena == 0, "...and the definitions listing, asserted above");

    # `agnosai_route_resolve` named directly on both arms, since it is what the
    # four zeros above are actually asserting about.
    var mpath = str_from("/api/v1/dashboard/crews");
    var b9 = alloc_used();
    for (var z = 0; z < 64; z = z + 1) {
        agnosai_route_resolve(AGNOSAI_METHOD_GET, mpath);
    }
    var per_match = (alloc_used() - b9) / 64;
    assert(per_match > 0,
    "the router on the GLOBAL allocator still costs the match struct per call");

    var b10 = alloc_used();
    for (var y = 0; y < 64; y = y + 1) {
        agnosai_route_resolve_a(ar, AGNOSAI_METHOD_GET, mpath);
        reset_via(ar);
    }
    assert((alloc_used() - b10) / 64 == 0,
    "...and nothing at all through an arena — the match struct and the parameter \
    buffer both land in `a`");

    # **A `{id}` path as well, because the four routes asserted at zero above
    # are all parameterless.** `_agnosai_path_matches_at` only allocates when a
    # `*` segment captures, so reverting that one `str_sub_a` to `str_sub`
    # passed every other assertion in this file — the capture was never
    # exercised by anything pinned at zero.
    var ppath = str_from("/api/v1/crews/00000000-0000-0000-0000-000000000000");
    assert(agnosai_route_match_param(agnosai_route_resolve_a(ar,
    AGNOSAI_METHOD_GET, ppath)) != 0, "a {id} path really does capture");
    reset_via(ar);

    var b11 = alloc_used();
    for (var x = 0; x < 64; x = x + 1) {
        agnosai_route_resolve_a(ar, AGNOSAI_METHOD_GET, ppath);
        reset_via(ar);
    }
    assert((alloc_used() - b11) / 64 == 0,
    "...and the captured Str lands in `a` too");

    # **A `{id}` route reaches zero too, including its 404 arm.** It was the
    # last one that did not, at 16 bytes: `agnosai_uuid_parse` allocated a
    # buffer for the decoded UUID and **all five of its callers in `src/` threw
    # that buffer away** — every one was `if (agnosai_uuid_parse(x) == 0)`, a
    # validity test. `agnosai_uuid_is_valid` is that test without the buffer,
    # over the same `_agnosai_uuid_scan`, so the two cannot drift on what they
    # accept. The 404 arm pays the same as the 200 arm because it validates the
    # same id — which is why it mattered: that arm is the unauthenticated one.
    assert(p_crew_a == 0, "a {id} route costs the global bump nothing either");
    assert(p_404_a == 0, "...and neither does its 404 arm");
    assert(p_404_g > 0, "the unthreaded 404 arm allocates its error object per request");

    # And `/api/v1/tools`, asserted in its own block above where both arms are
    # already measured. **All six read routes are at zero.**
    assert(per_tools_arena == 0, "the tools listing too — no read route allocates");

    # The schema constructors' `_a` forms named directly: each is reached only
    # through a tool's `schema_fp`, which reference coverage cannot see.
    var sa = agnosai_tool_schema_new_a(ar, str_from_a(ar, "t"), str_from_a(ar, "d"));
    agnosai_tool_schema_param_a(ar, sa, str_from_a(ar, "p"), str_from_a(ar, "pd"),
    str_from_a(ar, "string"), 1);
    agnosai_tool_schema_with_param_a(ar, sa,
    agnosai_param_schema_new_a(ar, str_from_a(ar, "q"), str_from_a(ar, "qd"),
    str_from_a(ar, "string"), 0));
    assert(vec_len(agnosai_tool_schema_parameters(sa)) == 2,
    "both append paths reach the schema through the arena");
    assert(agnosai_tool_schema_a(ar, agnosai_echo_tool()) != 0,
    "and a tool's schema_fp answers through the arena");
    reset_via(ar);

    # Byte-identical wire on both arms, for each of the four.
    assert(str_eq(bayan_json_v_build(agnosai_route_body(
    agnosai_route_crew_history(ps))), bayan_json_v_build(agnosai_route_body(
    agnosai_route_crew_history_a(ar, ps)))) == 1, "crew history is byte-identical");
    reset_via(ar);
    assert(str_eq(bayan_json_v_build(agnosai_route_body(
    agnosai_route_agent_performance(ps))), bayan_json_v_build(agnosai_route_body(
    agnosai_route_agent_performance_a(ar, ps)))) == 1, "agent performance likewise");
    reset_via(ar);
    assert(str_eq(bayan_json_v_build(agnosai_route_body(
    agnosai_route_list_pending(ps))), bayan_json_v_build(agnosai_route_body(
    agnosai_route_list_pending_a(ar, ps)))) == 1, "the pending list likewise");
    reset_via(ar);
    assert(str_eq(bayan_json_v_build(agnosai_route_body(
    agnosai_route_get_crew(ps, cid))), bayan_json_v_build(agnosai_route_body(
    agnosai_route_get_crew_a(ar, ps, cid)))) == 1, "and a single crew's state");
    reset_via(ar);

    # The failure arms too — `route_error_a` is the arm a scan hits, and it must
    # answer the same status and body through either allocator.
    var bad = str_from("not-a-uuid");
    assert(agnosai_route_status(agnosai_route_get_crew_a(ar, ps, bad))
    == AGNOSAI_HTTP_UNPROCESSABLE, "a malformed id is 422 through the arena too");
    var missing = str_from("00000000-0000-0000-0000-000000000000");
    assert(agnosai_route_status(agnosai_route_get_crew_a(ar, ps, missing))
    == HTTP_NOT_FOUND, "...and an unknown one is 404");
    var ea = agnosai_route_error_a(ar, HTTP_NOT_FOUND, str_from("gone"));
    assert(agnosai_route_status(ea) == HTTP_NOT_FOUND, "route_error_a carries its status");
    assert(str_eq(bayan_json_v_build(agnosai_route_body(ea)),
    bayan_json_v_build(agnosai_route_body(
    agnosai_route_error(HTTP_NOT_FOUND, str_from("gone"))))) == 1,
    "...and builds the oracle's {\"error\":..} either way");
    reset_via(ar);

    # --- B2: the write routes, and the line they cannot cross ----------------
    #
    # A body-carrying route splits in two, and only one half is safely
    # threadable. **`POST /api/v1/approvals` and `POST /mcp` retain nothing** —
    # the first uses `task_id` as a `map_get` key and sends an int through a
    # channel, the second executes and returns — so their parse trees go in the
    # arena with everything else.
    #
    # **The other three retain data borrowed from the parse tree.**
    # `agnosai_agent_from_value` and `agnosai_crew_from_value` take
    # `bayan_json_v_str(...)` without cloning, and the results are stored in
    # `AppState.definitions` and the orchestrator registry respectively. So a
    # threaded parse would have `reset_via` reclaim what those hold, and the
    # next request would be handed the same bytes — corruption, not a crash.
    # `server_routes_agents` reproduces exactly that.
    #
    # These assertions pin **both** sides: the two that reached zero, and the
    # three that must not, so "thread them for consistency" fails here rather
    # than in production.
    var appr_body = str_from(
    "{\"task_id\":\"6ba7b810-9dad-11d1-80b4-00c04fd430c8\",\"decision\":\"approved\"}");
    var mcp_body = str_from("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}");
    var defn_body = str_from(
    "{\"agent_key\":\"w\",\"name\":\"W\",\"role\":\"r\",\"goal\":\"g\"}");

    assert(_t_per_post(ps, str_from("/api/v1/approvals"), appr_body, 0) > 0,
    "the approvals POST allocates on the global path");
    assert(_t_per_post(ps, str_from("/api/v1/approvals"), appr_body, ar) == 0,
    "...and NOTHING through the arena — parse tree, allow-list, message and \
    response all land in `a`");

    # The **not-delivered** branch too: a different message, built by the same
    # builder, and the only one the eight non-UUID pending ids could reach.
    var appr_miss = str_from(
    "{\"task_id\":\"00000000-0000-0000-0000-000000000000\",\"decision\":\"rejected\"}");
    assert(_t_per_post(ps, str_from("/api/v1/approvals"), appr_miss, 0) > 0,
    "an unknown task id still allocates on the global path");
    assert(_t_per_post(ps, str_from("/api/v1/approvals"), appr_miss, ar) == 0,
    "...and nothing through the arena either");

    # **Both message branches, measured directly.** Routing to them is not
    # enough: a delivered approval is consumed, so a loop through the route
    # takes that path once and the not-delivered path 31 times, leaving the
    # delivered branch's `str_builder_add_a` free to grow on the global bump.
    # A mutation found exactly that. Both strings pass 64 bytes once a
    # 36-character id is appended, which is where the builder starts growing.
    var mid = str_from("6ba7b810-9dad-11d1-80b4-00c04fd430c8");
    _agnosai_route_approval_message_a(ar, 1, AGNOSAI_APPROVAL_APPROVED, mid);
    _agnosai_route_approval_message_a(ar, 0, AGNOSAI_APPROVAL_REJECTED, mid);
    reset_via(ar);
    var bm = alloc_used();
    for (var mi = 0; mi < 32; mi = mi + 1) {
        _agnosai_route_approval_message_a(ar, 1, AGNOSAI_APPROVAL_APPROVED, mid);
        _agnosai_route_approval_message_a(ar, 1, AGNOSAI_APPROVAL_REJECTED, mid);
        _agnosai_route_approval_message_a(ar, 0, AGNOSAI_APPROVAL_APPROVED, mid);
        reset_via(ar);
    }
    assert((alloc_used() - bm) == 0,
    "every branch of the approval message builds entirely in the arena — \
    including the growth past its 64-byte inline buffer");
    assert(str_len(_agnosai_route_approval_message(1, AGNOSAI_APPROVAL_APPROVED, mid)) > 64,
    "...and the delivered message really does exceed that buffer, so the \
    assertion above is about growth rather than about the inline case");

    assert(_t_per_post(ps, str_from("/mcp"), mcp_body, 0) > 0,
    "the MCP POST allocates on the global path");
    assert(_t_per_post(ps, str_from("/mcp"), mcp_body, ar) == 0,
    "...and nothing through the arena, including every tool schema behind \
    tools/list");

    # **`create_definition` is threaded now, and its residual is the definition
    # it deliberately keeps.** The parse tree and the response go in the arena;
    # the agent does not, because `AppState.definitions` outlives the request —
    # `agnosai_agent_from_value_a` is handed `default_alloc()` and clones every
    # Str, so the stored definition survives `reset_via`.
    #
    # So this route cannot reach zero and should not: what remains on the global
    # bump is exactly the retained object, which is the point. The assertion is
    # therefore a large reduction rather than an equality — and it is bounded
    # above too, because a residual that stopped shrinking would mean the parse
    # tree had quietly gone back to the global allocator.
    var d_global = _t_per_post(ps, str_from("/api/v1/agents/definitions"), defn_body, 0);
    var d_arena = _t_per_post(ps, str_from("/api/v1/agents/definitions"), defn_body, ar);
    assert(d_arena > 0,
    "the threaded route still allocates — the definition it stores is retained \
    on purpose and cannot live in a per-request arena");
    assert(d_arena * 3 < d_global,
    "...but everything that is NOT retained moved to the arena: the parse tree, \
    the response value and the response struct");

    # `POST /api/v1/crews`, the same shape at a very different ratio.
    #
    # **This route cannot approach zero and should not.** Most of what it
    # allocates is the crew *execution* — task results accumulated by
    # `crew_runner` and kept in the orchestrator registry — which is retained
    # state, not per-request garbage. Only the parse tree and the response move,
    # so the win is ~20% rather than the ~83% `create_definition` gets. The
    # assertion is therefore a modest reduction with a floor under it: a route
    # that suddenly dropped to near-zero here would mean retained crew state had
    # been put in an arena, which is the corruption this whole boundary exists
    # to prevent.
    var crew_body = str_from(
    "{\"name\":\"c\",\"agents\":[{\"agent_key\":\"k\",\"name\":\"N\",\"role\":\"r\",\
    \"goal\":\"g\"}],\"tasks\":[{\"description\":\"d\"}]}");
    # **Its own state, not `ps`.** Every POST here registers a crew, so measuring
    # against the shared fixture would leave it holding hundreds instead of the
    # eight `agnosai_orchestrator_crew_ids_a` is asserted on above — which is
    # exactly how this first failed.
    var cs = _t_state();
    var c_global = _t_per_post(cs, str_from("/api/v1/crews"), crew_body, 0);
    var c_arena = _t_per_post(cs, str_from("/api/v1/crews"), crew_body, ar);
    assert(c_global > 0, "creating a crew allocates on the global path");
    assert(c_arena < c_global,
    "the parse tree and the response move to the arena");
    assert(c_arena * 2 > c_global,
    "...but most of it stays, and must: the crew's own state is registered and \
    outlives the request that created it");

    # `POST /api/v1/a2a/receive` — the last write route, and the same shape:
    # it builds a one-task crew from the request and runs it, so the bulk is
    # execution held in the registry.
    var a2a_body = str_from(
    "{\"task_id\":\"t-1\",\"description\":\"do the thing\"}");
    var as_ = _t_state();
    var a_global = _t_per_post(as_, str_from("/api/v1/a2a/receive"), a2a_body, 0);
    var a_arena = _t_per_post(as_, str_from("/api/v1/a2a/receive"), a2a_body, ar);
    assert(a_global > 0, "the a2a POST allocates on the global path");
    assert(a_arena < a_global, "the parse tree and the response move to the arena");
    assert(a_arena * 2 > a_global,
    "...and the crew it runs stays registered, as it must");

    # The write routes' `_a` forms named directly — both are reached only
    # through `dispatch_a`, which reference coverage cannot see.
    assert(agnosai_route_status(agnosai_route_submit_approval_a(ar, ps, appr_miss))
    == HTTP_OK, "submit_approval_a answers 200 for an unknown task id");
    assert(agnosai_route_status(agnosai_route_mcp_a(ar, ps, mcp_body)) == HTTP_OK,
    "mcp_a answers 200 for tools/list");
    reset_via(ar);

    # And the `deny_unknown_fields` allow-list builder, which every
    # body-carrying route rebuilds per request.
    var fl = agnosai_route_fields_a(ar);
    agnosai_route_field_a(ar, fl, "task_id");
    assert(vec_len(fl) == 1, "fields_a/field_a build the allow-list in the arena");
    assert(str_eq_cstr(vec_get(fl, 0), "task_id") == 1, "...carrying the field name");
    reset_via(ar);

    # The `_a` forms named directly. Each is reached through `dispatch_a`, so
    # the behaviour is covered — but reference coverage counts the SYMBOL, and
    # an indirectly-used public fn reads as dead.
    var ids_a = agnosai_orchestrator_crew_ids_a(ar,
    agnosai_app_state_orchestrator(ps));
    assert(vec_len(ids_a) == 8, "crew_ids_a slot-walks all eight through the arena");
    var pend_a = agnosai_approval_gate_pending_tasks_a(ar,
    agnosai_app_state_approval_gate(ps));
    assert(vec_len(pend_a) == 8, "pending_tasks_a snapshots all eight through the arena");
    assert(str_eq(_agnosai_route_status_debug_a(ar, AGNOSAI_CREW_COMPLETED),
    str_from("Completed")) == 1, "status_debug_a keeps the Debug spelling");
    assert(str_len(_agnosai_route_meta_str_a(ar, 0, str_from("agent"))) == 0,
    "meta_str_a answers empty for absent metadata");
    reset_via(ar);

    var d_a = agnosai_app_state_definitions_a(ar, s);
    assert(vec_len(d_a) >= 0, "definitions_a walks the map through the arena");
    var lr = agnosai_route_list_definitions_a(ar, s);
    assert(agnosai_route_status(lr) == HTTP_OK, "list_definitions_a answers 200");
    var lt = agnosai_route_list_tools_a(ar, s);
    assert(agnosai_route_status(lt) == HTTP_OK, "list_tools_a answers 200");
    var rj = agnosai_route_json_a(ar, HTTP_OK, bayan_json_v_null());
    assert(agnosai_route_status(rj) == HTTP_OK, "route_json_a builds a response in the arena");

    # Byte-identical wire, which is what lets the threading land without an ADR.
    var gv = agnosai_route_body(agnosai_route_dispatch(s, AGNOSAI_METHOD_GET,
    str_from("/api/v1/agents/definitions"), str_from(""), 0, str_from("")));
    var av = agnosai_route_body(agnosai_route_dispatch_a(ar, s, AGNOSAI_METHOD_GET,
    str_from("/api/v1/agents/definitions"), str_from(""), 0, str_from("")));
    assert(str_eq(bayan_json_v_build(gv), bayan_json_v_build(av)) == 1,
    "...and emits byte-identical JSON either way");
    return 0;
}

# --- The arena must not be a cliff --------------------------------------

# **A response that outgrows the request arena degrades; it does not fault.**
#
# `arena_alloc` answers **0** when full — it does not grow, and the stdlib has
# no chunked arena. Before the routes were threaded that was harmless: every
# handler allocated from the no-free global bump, so a big response was a leak.
# Threading them onto a fixed 64 KiB arena inverted it, because nothing in
# `bayan_json_v_*`, `str_from_a` or `vec_push_a` checks its allocator's answer —
# an exhausted arena hands out 0 and the next store **segfaults the worker**.
#
# Measured before the fix: 200 registered crews crashed
# `GET /api/v1/dashboard/crews` through a 64 KiB arena. `MAX_RETAINED_CREWS` is
# **1,000**, so that is an ordinary operating condition and not an attack.
#
# `agnosai_spill_arena` serves from the arena and falls back to the global bump
# per allocation. This asserts both halves: the big render completes **and** the
# arena really did hit its ceiling, so the spill path is what carried it rather
# than the response happening to fit.
fn _t_arena_overflow_degrades_not_faults(): i64 {
    var o = agnosai_orchestrator_new(0);
    var s = agnosai_app_state_new(o, agnosai_tool_registry_new(),
    agnosai_auth_config_new(), agnosai_event_bus_new(),
    agnosai_audit_chain_new(), agnosai_approval_gate_new());

    for (var i = 0; i < 200; i = i + 1) {
        var spec = agnosai_crew_new(str_from("c"));
        var tasks = vec_new();
        vec_push(tasks, agnosai_task_new(str_from("t")));
        agnosai_crew_with_tasks(spec, tasks);
        agnosai_orchestrator_run_crew(o, spec);
    }

    var e = str_from("");
    var sp = agnosai_spill_arena(AGNOSAI_SERVE_ARENA_BYTES);
    assert(sp != 0, "the spill arena builds");
    var r = agnosai_route_dispatch_a(sp, s, AGNOSAI_METHOD_GET,
    str_from("/api/v1/dashboard/crews"), e, 0, e);

    assert(agnosai_route_status(r) == HTTP_OK,
    "**200 crews render through a 64 KiB arena instead of faulting** — the raw \
    arena segfaults here, which is what threading the routes introduced");
    assert(bayan_json_v_arr_len(agnosai_route_body(r)) == 200,
    "...with every crew present, not a truncated answer");

    # The spill path is what carried it: the arena is at its ceiling.
    assert(arena_used(allocator_state(sp)) > AGNOSAI_SERVE_ARENA_BYTES - 512,
    "...and the arena really did fill, so this exercised the fallback rather \
    than a response that happened to fit");
    return 0;
}

# The fallback is per-allocation, so the ordinary case keeps the whole win.
fn _t_spill_arena_still_costs_nothing_when_it_fits(): i64 {
    var s = _t_state_populated();
    var e = str_from("");
    var sp = agnosai_spill_arena(AGNOSAI_SERVE_ARENA_BYTES);
    var path = str_from("/api/v1/dashboard/crews");

    agnosai_route_dispatch_a(sp, s, AGNOSAI_METHOD_GET, path, e, 0, e);
    reset_via(sp);

    var before = alloc_used();
    for (var i = 0; i < 32; i = i + 1) {
        agnosai_route_dispatch_a(sp, s, AGNOSAI_METHOD_GET, path, e, 0, e);
        reset_via(sp);
    }
    assert((alloc_used() - before) == 0,
    "a response that fits still charges the global bump NOTHING — the spill is \
    per-allocation, so it costs only what actually overflows");
    return 0;
}

fn main(): i64 {
    alloc_init();
    sakshi_set_level(SK_FATAL);

    _t_method_mapping();
    _t_reason_phrases();
    _t_options();
    _t_callback_gate();
    _t_callback_dispatch_is_gated();
    _t_rate_limit_off_by_default();
    _t_handler_end_to_end();
    _t_mount();
    _t_parse_port();
    _t_shutdown_flag_wired();
    _t_sse_unknown_crew();
    _t_sse_uppercase_id_canonicalises();
    _t_sse_live_stream();
    _t_sse_transport_gates();
    _t_bind_failure_returns();
    _t_allocation_profile();
    _t_arena_overflow_degrades_not_faults();
    _t_spill_arena_still_costs_nothing_when_it_fits();
    # LAST — installs a process-wide signal mask; see the fn's own note.
    _t_shutdown_signal_sets_flag();

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
