# =========================================================================
# orch_durable_state.tcyr — parity tests for src/orchestrator/durable_state.cyr
#
# Oracle: the #[cfg(test)] block in rust-old/src/orchestrator/durable_state.rs —
# 8 tests. All eight port: the four #[tokio::test] ones are blocking here, and
# tempfile::tempdir becomes a fixed /tmp path with explicit teardown, following
# tests/orch_ipc.tcyr's convention (the only other suite that touches the
# filesystem).
#
# The extra cases cover what the oracle's suite cannot see, because the oracle
# reaches the filesystem through std and inherits its behaviour for free:
#
#   * the golden pretty-printed bytes, which are the whole point of the format;
#   * a DIRECTORY where a snapshot should be, versus an EMPTY file — one is an
#     error and one is a zero-length success, and `file_read_all` conflates them
#     into 0, which is why this module does not use it;
#   * mkdir_p's idempotence, and its refusal when a path component is a file;
#   * the two deliberate divergences: crew_id validation (ADR 008) and the
#     required-field strictness that `serde` has and core_crew's own
#     deserialiser does not.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/core/error.cyr"
include "src/core/json.cyr"
include "src/core/message.cyr"
include "src/core/resource.cyr"
include "src/core/task.cyr"
include "src/core/agent.cyr"
include "src/core/crew.cyr"
include "src/orchestrator/durable_state.cyr"
include "tests/test_helpers.cyr"
include "tests/test_tmp.cyr"

# The oracle's tempfile::tempdir, minus the RAII. Every path used here lives
# under this root so teardown is a single sweep.
var _T_ROOT = _tt_tmp_path("durable-state", "");

# The oracle's sample_state(): a fresh uuid, Running, no results, no profile.
fn _t_state(): i64 {
    return agnosai_crew_state_new(agnosai_uuid_v4_str(), AGNOSAI_CREW_RUNNING);
}

# Join two path pieces into a NUL-TERMINATED Str.
#
# `str_cat` does not terminate — only `str_builder_build` does — and every
# `sys_*` path argument here is a C string, so a bare `str_data(str_cat(...))`
# reads past the buffer.
fn _t_join(a: Str, b: Str): i64 {
    var sb = str_builder_new();
    str_builder_add(sb, a);
    str_builder_add(sb, b);
    return str_builder_build(sb);
}

# `_T_ROOT` plus a suffix, NUL-terminated.
fn _t_under(suffix): i64 {
    return _t_join(str_from(_T_ROOT), str_from(suffix));
}

# Remove a file, ignoring a missing one.
fn _t_rm(path: Str): i64 {
    return sys_unlink(str_data(path));
}

# Read a snapshot back, asserting the load reported no error. Returns the
# payload pointer, which is AGNOSAI_STATE_ABSENT when there was no snapshot.
#
# Note `assert_eq` returns 0 whether it passes or fails — it tallies and prints
# rather than reporting — so there is nothing to branch on here.
fn _t_load_ok(store, crew_id: Str, out_len, name): i64 {
    var bytes = 0;
    store64(&bytes, 0);
    assert_eq(agnosai_state_store_load(store, crew_id, &bytes, out_len), 0, name);
    return load64(&bytes);
}

# Compare `len` bytes at `p` against a Str.
fn _t_bytes_eq(p, len, want: Str): i64 {
    if (p == 0) { return 0; }
    if (len != str_len(want)) { return 0; }
    for (var i = 0; i < len; i = i + 1) {
        if (load8(p + i) != load8(str_data(want) + i)) { return 0; }
    }
    return 1;
}

# ── 2.5.0: the log's verbs, and a backend of a consumer's own (ADR 036) ────

# A whole log read back, as a Str, or 0 when the crew has none.
fn _t_log_of(store, crew_id: Str): i64 {
    var bytes = 0;
    var len = 0;
    if (agnosai_state_store_read_log(store, crew_id, &bytes, &len) != 0) { return 0; }
    if (bytes == AGNOSAI_STATE_ABSENT) { return 0; }
    return str_new(bytes, len);
}

# Whether `ids` holds `id`.
fn _t_has_id(ids, id): i64 {
    for (var i = 0; i < vec_len(ids); i = i + 1) {
        if (str_eq(vec_get(ids, i), str_from(id)) == 1) { return 1; }
    }
    return 0;
}

fn _t_log_verbs(): i64 {
    # A directory that does not exist yet: the first append makes it.
    var dir = _t_under("/log/deeper");
    var store = agnosai_state_store_new(dir);
    var ids = vec_new();
    assert_eq(agnosai_state_store_list(store, ids), 0, "a store with no directory yet lists without error");
    assert_eq(vec_len(ids), 0, "and lists no crew");
    assert_eq(_t_log_of(store, str_from("crew-a")), 0, "a crew with no log reads as none");

    assert_eq(agnosai_state_store_append(store, str_from("crew-a"), "one\n", 4, 1), 0,
      "the first append, synced, makes the directory and the log");
    assert_eq(agnosai_state_store_append(store, str_from("crew-a"), "two\n", 4, 0), 0,
      "a second, not synced, appends");
    assert(str_eq(_t_log_of(store, str_from("crew-a")), str_from("one\ntwo\n")) == 1,
      "the log reads back both records, in the order they were written");
    var st[144];
    assert_eq(xstat(str_data(agnosai_state_log_path_for(store, str_from("crew-a"))), &st), 0,
      "the log is a file beside where its snapshot would be");
    assert_eq(load32(&st + STAT_MODE) & 0x1FF, 0x180, "and only its owner may read it: 0600");
    # A log made in a directory that is already there takes the other open, and is 0600 too.
    agnosai_state_store_append(store, str_from("crew-c"), "c\n", 2, 0);
    var st2[144];
    xstat(str_data(agnosai_state_log_path_for(store, str_from("crew-c"))), &st2);
    assert_eq(load32(&st2 + STAT_MODE) & 0x1FF, 0x180, "a log made where the directory is already there is 0600");
    agnosai_state_store_remove(store, str_from("crew-c"));
    # A write the disk refuses is an error, not a record the log thinks it has.
    var full = agnosai_state_log_path_for(store, str_from("crew-full"));
    if (xsymlink("/dev/full", str_data(full)) == 0) {
        var ferr = agnosai_state_store_append(store, str_from("crew-full"), "x\n", 2, 0);
        assert(ferr != 0, "an append the disk refuses is an error");
        assert(str_contains(agnosai_error_detail(ferr), str_from("no space left")) == 1, "saying why");
        sys_unlink(str_data(full));
    }

    agnosai_state_store_append(store, str_from("crew-b"), "b\n", 2, 0);
    var raw = str_from("{}");
    agnosai_state_store_save(store, str_from("crew-b"), str_data(raw), str_len(raw));
    var listed = vec_new();
    assert_eq(agnosai_state_store_list(store, listed), 0, "listing a store with logs");
    assert_eq(vec_len(listed), 2, "lists each crew that has a log, once, and no snapshot");
    assert(_t_has_id(listed, "crew-a") == 1 && _t_has_id(listed, "crew-b") == 1,
      "by its crew id, without the extension");

    var evil = str_from("../escape");
    assert(agnosai_state_store_append(store, evil, "x", 1, 0) != 0, "append refuses an unsafe id (ADR 008)");
    var eb = 0;
    var el = 0;
    assert(agnosai_state_store_read_log(store, evil, &eb, &el) != 0, "and so does read_log");
    assert(agnosai_state_store_remove(store, evil) != 0, "and remove");

    assert_eq(agnosai_state_store_remove(store, str_from("crew-b")), 0, "remove takes a crew's log and snapshot");
    var lb = 0;
    var ll = 0;
    agnosai_state_store_load(store, str_from("crew-b"), &lb, &ll);
    assert_eq(lb, AGNOSAI_STATE_ABSENT, "its snapshot is gone");
    assert_eq(_t_log_of(store, str_from("crew-b")), 0, "and its log");
    assert_eq(agnosai_state_store_remove(store, str_from("crew-b")), 0, "removing what is gone is not an error");
    assert_eq(agnosai_state_store_remove(store, str_from("crew-a")), 0, "the other crew's log goes too");
    var left = vec_new();
    agnosai_state_store_list(store, left);
    assert_eq(vec_len(left), 0, "and the store lists none");

    # A directory where the log should be: the append is an error that names it.
    var as_dir = agnosai_state_log_path_for(store, str_from("crew-d"));
    sys_mkdir(str_data(as_dir), 0x1FF);
    var derr = agnosai_state_store_append(store, str_from("crew-d"), "x", 1, 0);
    assert(derr != 0, "an append that cannot open its log is an error");
    assert(str_contains(agnosai_error_detail(derr), str_from("crew-d.log")) == 1, "naming the log");
    sys_rmdir(str_data(as_dir));
    sys_rmdir(str_data(dir));
    sys_rmdir(str_data(_t_under("/log")));
    return 0;
}

# A backend of a consumer's own: it counts what each verb is handed.
var _t_calls = 0;
var _t_last_sync = 0 - 1;

fn _t_b_save(ctx, id, buf, len): i64 { _t_calls = _t_calls + 1; return 0; }
fn _t_b_load(ctx, id, out_bytes, out_len): i64 { _t_calls = _t_calls + 10; return 0; }
fn _t_b_append(ctx, id, buf, len, sync): i64 {
    _t_calls = _t_calls + 100;
    _t_last_sync = sync;
    if (ctx != 7) { return agnosai_error_io(str_from("wrong context")); }
    return 0;
}
fn _t_b_read(ctx, id, out_bytes, out_len): i64 { _t_calls = _t_calls + 1000; return 0; }
fn _t_b_list(ctx, out_ids): i64 {
    _t_calls = _t_calls + 10000;
    vec_push(out_ids, str_from("ok-id"));
    vec_push(out_ids, str_from("../bad"));
    return 0;
}
fn _t_b_remove(ctx, id): i64 { _t_calls = _t_calls + 100000; return 0; }

fn _t_custom_backend(): i64 {
    var s = agnosai_state_store_backend(7, &_t_b_save, &_t_b_load, &_t_b_append, &_t_b_read,
      &_t_b_list, &_t_b_remove);
    assert_eq(agnosai_state_store_base_dir(s), 0, "a backend of a consumer's own has no base directory");
    agnosai_state_store_save(s, str_from("c"), "x", 1);
    var b = 0;
    var l = 0;
    agnosai_state_store_load(s, str_from("c"), &b, &l);
    assert_eq(b, AGNOSAI_STATE_ABSENT, "a load the backend answered nothing to reads as none");
    assert_eq(agnosai_state_store_append(s, str_from("c"), "x", 1, 1), 0,
      "append reaches the backend with its context");
    assert_eq(_t_last_sync, 1, "and its sync flag");
    agnosai_state_store_read_log(s, str_from("c"), &b, &l);
    var ids = vec_new();
    agnosai_state_store_list(s, ids);
    assert_eq(vec_len(ids), 1, "an unsafe id a backend lists is left out");
    agnosai_state_store_remove(s, str_from("c"));
    assert_eq(_t_calls, 111111, "each verb reached its own fnptr, once");
    agnosai_state_store_append(s, str_from("../x"), "x", 1, 0);
    assert_eq(_t_calls, 111111, "and an unsafe id reaches none");
    return 0;
}

fn main() {
    alloc_init();

    test_group("orch_durable_state");

    var root = str_from(_T_ROOT);
    var store = agnosai_state_store_new(root);
    assert(str_eq(agnosai_state_store_base_dir(store), root) == 1,
      "the store keeps its base directory verbatim — no canonicalisation, as the oracle does none");

    # --- file_state_store_path_for ---
    var fixed = agnosai_state_store_new(str_from("/tmp/agnosai-state"));
    assert(str_eq(agnosai_state_path_for(fixed, str_from("my-crew-123")),
        str_from("/tmp/agnosai-state/my-crew-123.json")) == 1,
      "the path is {base_dir}/{crew_id}.json");

    # --- serialize_produces_valid_json + the golden bytes ---
    # The oracle only asserts that crew_id and status are present. The exact
    # bytes matter more than that: serialize_crew_state exists to produce a
    # HUMAN-READABLE snapshot, so the indentation is part of the contract, not
    # incidental. This is bayan_json_v_build_pretty(v, 2) checked against
    # serde_json::to_vec_pretty for the oracle's own sample_state().
    var golden_state = agnosai_crew_state_new(
      str_from("0191b3f0-1111-4222-8333-444455556666"), AGNOSAI_CREW_RUNNING);
    var golden = agnosai_serialize_crew_state(golden_state);
    assert(str_eq(golden, str_cat(str_from("{\n  \"crew_id\": \"0191b3f0-1111-4222-8333-444455556666\",\n"),
          str_cat(str_from("  \"status\": \"running\",\n"), str_from("  \"results\": []\n}")))) == 1,
      "the snapshot is 2-space-indented JSON with a space after each colon and [] for an empty \
    array — byte-identical to serde_json::to_vec_pretty");
    assert_eq(str_len(golden), 95, "which is 95 bytes for this shape");
    assert_eq(load8(str_data(golden) + str_len(golden) - 1), 125,
      "and ends with '}' — to_vec_pretty appends no trailing newline");

    # profile is omitted when unset, not emitted as null
    assert(str_contains(golden, str_from("profile")) == 0,
      "an unset profile is omitted entirely — skip_serializing_if = Option::is_none");

    # --- serialize_deserialize_round_trip ---
    var state = _t_state();
    var bytes = agnosai_serialize_crew_state(state);
    var restored = 0;
    store64(&restored, 0);
    assert_eq(agnosai_deserialize_crew_state(str_data(bytes), str_len(bytes), &restored), 0,
      "a serialized state deserializes");
    var back = load64(&restored);
    assert(str_eq(agnosai_crew_state_crew_id(back), agnosai_crew_state_crew_id(state)) == 1,
      "the crew id survives the round trip");
    assert_eq(agnosai_crew_state_status(back), AGNOSAI_CREW_RUNNING, "and the status");
    assert_eq(vec_len(agnosai_crew_state_results(back)), 0, "and the empty results");
    assert_eq(agnosai_crew_state_profile(back), 0, "and the absent profile");

    # the pretty form is what gets parsed — a writer whose own output the parser
    # cannot read back would be useless, and pretty JSON has newlines in it
    assert(str_contains(bytes, str_from("\n")) == 1, "the serialized form really has newlines");

    # --- deserialize_invalid_data ---
    var junk = str_from("not valid json");
    var out = 0;
    store64(&out, 0);
    var jerr = agnosai_deserialize_crew_state(str_data(junk), str_len(junk), &out);
    assert(jerr != 0, "garbage input is an error");
    assert_eq(agnosai_error_kind(jerr), AGNOSAI_ERR_SERIALIZATION, "a Serialization error");
    assert_eq(load64(&out), 0, "and nothing is written to the out-parameter");

    # a bare JSON scalar parses but is not an object
    var scalar = str_from("42");
    assert(agnosai_deserialize_crew_state(str_data(scalar), str_len(scalar), &out) != 0,
      "a JSON scalar is not a crew state");

    # --- required fields: divergence 2 (see the module header) ---
    # serde requires crew_id, status and results; only profile has #[serde(default)].
    # agnosai_crew_state_from_value defaults a missing status to Pending and
    # tolerates a missing results, so the gate lives in this module.
    var no_status = str_from("{\"crew_id\":\"0191b3f0-1111-4222-8333-444455556666\",\"results\":[]}");
    var e1 = agnosai_deserialize_crew_state(str_data(no_status), str_len(no_status), &out);
    assert(e1 != 0, "a missing `status` is rejected — serde has no default for it, and silently \
    loading a crashed crew as Pending would restart work that already ran");
    assert_eq(agnosai_error_kind(e1), AGNOSAI_ERR_SERIALIZATION, "as a Serialization error");

    var no_results = str_from(
      "{\"crew_id\":\"0191b3f0-1111-4222-8333-444455556666\",\"status\":\"running\"}");
    assert(agnosai_deserialize_crew_state(str_data(no_results), str_len(no_results), &out) != 0,
      "and so is a missing `results` — dropping it would report a finished crew as having done \
    nothing");

    var bad_status = str_cat(str_from("{\"crew_id\":\"0191b3f0-1111-4222-8333-444455556666\","),
      str_from("\"status\":\"bogus\",\"results\":[]}"));
    assert(agnosai_deserialize_crew_state(str_data(bad_status), str_len(bad_status), &out) != 0,
      "an unknown status spelling is rejected rather than quietly becoming Pending");

    var no_id = str_from("{\"status\":\"running\",\"results\":[]}");
    assert(agnosai_deserialize_crew_state(str_data(no_id), str_len(no_id), &out) != 0,
      "and a missing crew_id is rejected");

    # every known spelling round-trips
    var spellings = vec_new();
    vec_push(spellings, str_from("pending"));
    vec_push(spellings, str_from("running"));
    vec_push(spellings, str_from("completed"));
    vec_push(spellings, str_from("failed"));
    vec_push(spellings, str_from("cancelled"));
    for (var si = 0; si < vec_len(spellings); si = si + 1) {
        var doc = str_cat(str_from("{\"crew_id\":\"0191b3f0-1111-4222-8333-444455556666\",\"status\":\""),
          str_cat(vec_get(spellings, si), str_from("\",\"results\":[]}")));
        assert_eq(agnosai_deserialize_crew_state(str_data(doc), str_len(doc), &out), 0,
          "a known status spelling is accepted");
    }

    # an unknown EXTRA field is accepted — CrewState has no deny_unknown_fields
    var extra = str_cat(str_from("{\"crew_id\":\"0191b3f0-1111-4222-8333-444455556666\","),
      str_from("\"status\":\"running\",\"results\":[],\"future_field\":1}"));
    assert_eq(agnosai_deserialize_crew_state(str_data(extra), str_len(extra), &out), 0,
      "an unknown extra field is accepted — there is no deny_unknown_fields, so a newer writer's \
    snapshot still loads");

    # --- crew_id validation: divergence 1, ADR 008 ---
    assert_eq(agnosai_crew_id_is_safe(str_from("crew-1")), 1, "a plain id is safe");
    assert_eq(agnosai_crew_id_is_safe(str_from("nonexistent-crew")), 1, "and a hyphenated one");
    assert_eq(agnosai_crew_id_is_safe(agnosai_uuid_v4_str()), 1, "and a uuid");
    assert_eq(agnosai_crew_id_is_safe(str_from("")), 0, "an empty id is refused");
    assert_eq(agnosai_crew_id_is_safe(str_from("..")), 0, "and ..");
    assert_eq(agnosai_crew_id_is_safe(str_from(".")), 0, "and .");
    assert_eq(agnosai_crew_id_is_safe(str_from(".hidden")), 0, "and a leading dot");
    assert_eq(agnosai_crew_id_is_safe(str_from("../../etc/passwd")), 0, "and traversal");
    assert_eq(agnosai_crew_id_is_safe(str_from("/etc/cron.d/pwn")), 0, "and an absolute path");
    assert_eq(agnosai_crew_id_is_safe(str_from("a/b")), 0, "and a nested id — a separator is \
    refused outright, which is what closes Path::join's replace-the-base behaviour");
    assert_eq(agnosai_crew_id_is_safe(str_from("a\\b")), 0, "and a backslash");

    var evil = str_from("../../tmp/agnosai-durable-pwn");
    var payload = str_from("owned");
    var eerr = agnosai_state_store_save(store, evil, str_data(payload), str_len(payload));
    assert(eerr != 0, "save refuses an unsafe crew id BEFORE touching the filesystem");
    assert_eq(agnosai_error_kind(eerr), AGNOSAI_ERR_IO, "reporting it as an I/O error");
    assert_eq(file_exists(str_data(str_from("/tmp/agnosai-durable-pwn.json"))), 0,
      "and nothing was written outside the base directory");

    var lbytes = 0;
    var llen = 0;
    store64(&lbytes, 0);
    store64(&llen, 0);
    assert(agnosai_state_store_load(store, evil, &lbytes, &llen) != 0,
      "load refuses it too — it would otherwise read any path ending .json");
    assert_eq(load64(&lbytes), AGNOSAI_STATE_ABSENT, "leaving the out-parameter absent");

    # --- file_state_store_save_and_load ---
    var s2 = _t_state();
    var cid = agnosai_crew_state_crew_id(s2);
    var payload2 = agnosai_serialize_crew_state(s2);
    assert_eq(agnosai_state_store_save(store, cid, str_data(payload2), str_len(payload2)), 0,
      "saving a crew state succeeds");

    var got_len = 0;
    store64(&got_len, 0);
    var got = _t_load_ok(store, cid, &got_len, "and it loads back");
    assert(got != AGNOSAI_STATE_ABSENT, "with a payload present");
    assert_eq(load64(&got_len), str_len(payload2), "of the same length");
    assert(_t_bytes_eq(got, load64(&got_len), payload2) == 1, "and the same bytes");

    var round = 0;
    store64(&round, 0);
    assert_eq(agnosai_deserialize_crew_state(got, load64(&got_len), &round), 0,
      "the loaded bytes deserialize");
    assert(str_eq(agnosai_crew_state_crew_id(load64(&round)), cid) == 1,
      "back to the same crew id");

    # --- file_state_store_load_missing ---
    var mlen = 0;
    var mbytes = 0;
    store64(&mbytes, 0);
    store64(&mlen, 0);
    assert_eq(agnosai_state_store_load(store, str_from("nonexistent-crew"), &mbytes, &mlen), 0,
      "loading an unsaved crew is NOT an error");
    assert_eq(load64(&mbytes), AGNOSAI_STATE_ABSENT,
      "it reports absent — the oracle's Ok(None), which is what lets a caller tell 'no snapshot' \
    from 'the disk is broken'");
    assert_eq(load64(&mlen), 0, "with a zero length");

    # --- file_state_store_overwrite ---
    var v1 = str_from("version-1");
    var v2 = str_from("version-2");
    assert_eq(agnosai_state_store_save(store, str_from("crew-x"), str_data(v1), str_len(v1)), 0,
      "the first save succeeds");
    assert_eq(agnosai_state_store_save(store, str_from("crew-x"), str_data(v2), str_len(v2)), 0,
      "and so does the second");
    var olen = 0;
    store64(&olen, 0);
    var ogot = _t_load_ok(store, str_from("crew-x"), &olen, "the overwritten crew loads");
    assert_eq(load64(&olen), str_len(v2),
      "and holds only the newer payload — the write REPLACES rather than appending, which is the \
    one thing patra's append-only jsonl could not have done");
    assert(_t_bytes_eq(ogot, load64(&olen), v2) == 1, "byte for byte");

    # raw non-JSON bytes round-trip: save takes &[u8], not a string
    var raw = str_from("test data");
    assert_eq(agnosai_state_store_save(store, str_from("crew-raw"), str_data(raw), str_len(raw)), 0,
      "arbitrary bytes can be saved");
    var rlen = 0;
    store64(&rlen, 0);
    var rgot = _t_load_ok(store, str_from("crew-raw"), &rlen, "and load back");
    assert(_t_bytes_eq(rgot, load64(&rlen), raw) == 1,
      "unchanged — the store is byte-transparent, it does not require valid JSON");

    # a zero-length payload is a real snapshot, distinguishable from no snapshot
    assert_eq(agnosai_state_store_save(store, str_from("crew-empty"), str_data(raw), 0), 0,
      "an empty payload saves");
    var elen = 0;
    var ebytes = 0;
    store64(&ebytes, 0);
    store64(&elen, 0);
    assert_eq(agnosai_state_store_load(store, str_from("crew-empty"), &ebytes, &elen), 0,
      "and loads without error");
    assert(load64(&ebytes) != AGNOSAI_STATE_ABSENT,
      "reporting PRESENT with zero length, not absent — an empty file is a snapshot that says \
    nothing happened, which is different from never having been saved");
    assert_eq(load64(&elen), 0, "and the length is zero");

    # --- file_state_store_creates_dir ---
    var nested_dir = _t_under("/sub/dir");
    var nested = agnosai_state_store_new(nested_dir);
    assert_eq(is_dir(nested_dir), 0, "the nested directory does not exist yet");
    assert_eq(agnosai_state_store_save(nested, str_from("crew-1"), str_data(raw), str_len(raw)), 0,
      "saving into a missing nested directory succeeds");
    assert_eq(is_dir(nested_dir), 1,
      "because save creates the whole tree — the stdlib has only single-level mkdir, so this is \
    the hand-rolled create_dir_all and it has to walk BOTH missing components");
    var nlen = 0;
    store64(&nlen, 0);
    assert(_t_bytes_eq(_t_load_ok(nested, str_from("crew-1"), &nlen, "and the file is readable"),
        load64(&nlen), raw) == 1, "with the right bytes");

    # saving again is idempotent: mkdir_p must swallow EEXIST on every component
    assert_eq(agnosai_state_store_save(nested, str_from("crew-2"), str_data(raw), str_len(raw)), 0,
      "a second save into the now-existing tree succeeds — mkdir returns -17 EEXIST on every \
    component and that has to be success, not failure");

    # --- a path component that is a FILE, not a directory ---
    # create_dir_all fails here; swallowing EEXIST blindly would let it through
    # and surface as a confusing write error one step later instead.
    var blocker = _t_under("/blocker");
    assert_eq(file_write_all(str_data(blocker), str_data(raw), str_len(raw)), str_len(raw),
      "a plain file sits where a directory component would go");
    var blocked = agnosai_state_store_new(_t_join(blocker, str_from("/deeper")));
    var berr = agnosai_state_store_save(blocked, str_from("crew-1"), str_data(raw), str_len(raw));
    assert(berr != 0, "saving through it fails");
    assert_eq(agnosai_error_kind(berr), AGNOSAI_ERR_IO, "as an I/O error");

    # --- a DIRECTORY where the snapshot file should be ---
    # This is the case file_read_all cannot express: opening a directory
    # SUCCEEDS and only the read fails, with -EISDIR. Reported as 0 bytes it
    # would be indistinguishable from the empty-snapshot case above.
    var dir_as_file = _t_under("/crew-dir.json");
    assert_eq(sys_mkdir(str_data(dir_as_file), 0x1FF), 0, "a directory named like a snapshot");
    var dlen = 0;
    var dbytes = 0;
    store64(&dbytes, 0);
    store64(&dlen, 0);
    var derr = agnosai_state_store_load(store, str_from("crew-dir"), &dbytes, &dlen);
    assert(derr != 0,
      "loading it is an ERROR, not an empty success — file_read_all would have returned 0 here, \
    exactly as it does for a genuinely empty file");
    assert_eq(agnosai_error_kind(derr), AGNOSAI_ERR_IO, "an I/O error");
    assert_eq(load64(&dbytes), AGNOSAI_STATE_ABSENT, "with nothing handed back");

    # --- the error detail carries the path and a readable reason ---
    assert(str_contains(agnosai_error_detail(derr), str_from("crew-dir.json")) == 1,
      "the error names the path it failed on");
    assert(str_contains(agnosai_error_detail(derr), str_from("is a directory")) == 1,
      "and renders the errno rather than leaking a bare number");
    assert(str_contains(agnosai_error_message(derr), str_from("I/O error: ")) == 1,
      "and the message keeps the oracle's variant prefix");

    # --- a borrowed path reads the file it names ---
    # A Str is not NUL-terminated at its length — a `str_sub` borrows its
    # parent's bytes — so cutting `borrow.json.bak` back to `borrow.json` leaves
    # `.bak` in the bytes past the cut, and handing `str_data` to `open` read the
    # backup. The store builds its own paths, so only a direct call reaches this.
    # Fails on 2.1.2.
    var named = _t_under("/borrow.json");
    var longer = _t_under("/borrow.json.bak");
    file_write_all(str_data(named), "named", 5);
    file_write_all(str_data(longer), "backup", 6);
    var cut = str_sub(longer, 0, str_len(longer) - 4);
    var clen = 0;
    store64(&clen, 0);
    var cbytes = _agnosai_read_file_exact(cut, &clen);
    assert(_t_bytes_eq(cbytes, load64(&clen), str_from("named")) == 1,
      "a path cut from a longer one reads the file it names, not the one its bytes run on into");

    _t_log_verbs();
    _t_custom_backend();

    # --- teardown ---
    _t_rm(named);
    _t_rm(longer);
    _t_rm(_t_join(_t_under("/"), _t_join(cid, str_from(".json"))));
    _t_rm(_t_under("/crew-x.json"));
    _t_rm(_t_under("/crew-raw.json"));
    _t_rm(_t_under("/crew-empty.json"));
    _t_rm(blocker);
    _t_rm(_t_join(nested_dir, str_from("/crew-1.json")));
    _t_rm(_t_join(nested_dir, str_from("/crew-2.json")));
    sys_rmdir(str_data(dir_as_file));
    sys_rmdir(str_data(nested_dir));
    sys_rmdir(str_data(_t_under("/sub")));
    sys_rmdir(str_data(root));
    assert_eq(is_dir(root), 0, "teardown removes the test root");

    # 2.3.5: every scratch path this suite made goes, so two runs at once share none and a run
    # leaves nothing behind (`tests/test_tmp.cyr`).
    _tt_cleanup();
    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
sys_exit_group(f);
