# =========================================================================
# tools_python_tool.tcyr — tests for src/tools/python_tool.cyr
#
# Oracle test block: rust-old/src/tools/python_tool.rs, nine of its ten tests.
# `tool_debug_format` is dropped — it asserts on `format!("{tool:?}")` and
# Cyrius has no `Debug`.
#
# ⚠ **Seven of the oracle's ten do not call `PythonTool::execute`.** Tests 4-10
# re-implement the result ladder inline against `serde_json` and assert on that
# copy, so upstream they would pass against a completely broken `execute`.
# `PythonTool::execute` has NO end-to-end test in the oracle at all. Here they
# are routed through the real `agnosai_python_tool_output_of`, which is why that
# helper is split out of `execute` — the assertions become load-bearing instead
# of testing bayan.
#
# What is pinned past the oracle:
#
#   * **the ladder's ORDER.** A timed-out result also carries `exit_code == -1`,
#     so checking the exit code first turns a timeout into "exited with code -1".
#   * **`exit_code != 0` shadows the structured error**, which is why the
#     `success:false` arm is unreachable for the shipped bridge. Pinned so the
#     ladder is not "fixed" into a different program.
#   * **`success` defaults TRUE, and a non-boolean `success` also defaults
#     true** — `{"success":"yes"}` is a success.
#   * **an absent `result` means the whole value; a present JSON null does not.**
#   * **non-JSON stdout is a SUCCESS** carrying the raw text.
#   * **the error prefix doubles** — `"python sandbox error: sandbox error: …"`.
#   * `schema_fp` COPIES its parameters into the arena rather than sharing the
#     ctx's.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/strcase.cyr"
include "src/core/mod.cyr"
include "src/telemetry/mod.cyr"
include "src/sandbox/mod.cyr"
include "src/tools/native.cyr"
include "src/tools/python_tool.cyr"
include "tests/test_helpers.cyr"

# Assert two Strs are equal. The stdlib's `assert_streq` compares C strings.
fn _t_seq(a: Str, b: Str, name): i64 {
    return assert(str_eq(a, b), name);
}

# The oracle's `sample_tool`: "greet" / "Greet a user" / one required string
# parameter "name", over a default sandbox.
fn _t_sample_tool(): i64 {
    var params = vec_new();
    vec_push(params, agnosai_param_schema_new(str_from("name"),
        str_from("The user's name"), str_from("string"), 1));
    return agnosai_python_tool(str_from("greet"), str_from("Greet a user"), params,
      str_from("def create_tool():\n    class Greeter:\n        pass\n    return Greeter()\n"),
      agnosai_python_sandbox_new());
}

# The result of the ladder for a plain stdout string, exit 0, no timeout.
fn _t_out(stdout): i64 {
    return agnosai_python_tool_output_of(str_from(stdout), str_from(""), 0, 0);
}

# The `result` value of a successful ToolOutput.
fn _t_result(o): i64 {
    return agnosai_tool_output_result(o);
}

fn main(): i64 {
    # --- Oracle: tool_name_and_description --------------------------------
    var tool = _t_sample_tool();
    _t_seq(agnosai_tool_name(tool), str_from("greet"), "the tool carries its name");
    _t_seq(agnosai_tool_description(tool), str_from("Greet a user"),
      "and its description");

    # --- Oracle: tool_schema_matches --------------------------------------
    var schema = agnosai_tool_schema(tool);
    _t_seq(agnosai_tool_schema_name(schema), str_from("greet"), "the schema's name");
    _t_seq(agnosai_tool_schema_description(schema), str_from("Greet a user"),
      "and description");
    assert_eq(vec_len(agnosai_tool_schema_parameters(schema)), 1, "with its one parameter");
    var p0 = vec_get(agnosai_tool_schema_parameters(schema), 0);
    _t_seq(agnosai_param_schema_name(p0), str_from("name"), "named `name`");
    _t_seq(agnosai_param_schema_description(p0), str_from("The user's name"),
      "with its description");
    _t_seq(agnosai_param_schema_type(p0), str_from("string"), "typed string");
    assert_eq(agnosai_param_schema_required(p0), 1, "and required");

    # ⚠ The schema COPIES its parameters rather than sharing the ctx's, because
    # `schema_fp` runs under the per-request arena. Two calls must therefore
    # hand back DIFFERENT ParameterSchema objects with equal contents — sharing
    # would make them the same pointer and put an arena cell in a
    # process-lifetime ctx.
    var schema2 = agnosai_tool_schema(tool);
    var p0b = vec_get(agnosai_tool_schema_parameters(schema2), 0);
    assert_neq(p0, p0b, "each schema build mints its OWN parameter objects");
    _t_seq(agnosai_param_schema_name(p0b), agnosai_param_schema_name(p0),
      "with the same contents");
    assert_neq(agnosai_tool_schema_parameters(schema2), agnosai_python_tool_parameters(tool),
      "and never the ctx's own vec");

    # A tool with no parameters still builds a schema.
    var bare = agnosai_python_tool(str_from("bare"), str_from("no params"), vec_new(),
      str_from("x"), agnosai_python_sandbox_new());
    assert_eq(vec_len(agnosai_tool_schema_parameters(agnosai_tool_schema(bare))), 0,
      "a parameterless tool has an empty schema parameter list");

    # The ctx accessors round-trip what was handed in.
    _t_seq(agnosai_python_tool_source(agnosai_tool_ctx(tool)),
      str_from("def create_tool():\n    class Greeter:\n        pass\n    return Greeter()\n"),
      "the ctx keeps the tool source verbatim");
    assert_neq(agnosai_python_tool_sandbox(agnosai_tool_ctx(tool)), 0,
      "and the sandbox it runs in");

    # --- Oracle: output_success_parsing -----------------------------------
    var ok1 = _t_out("{\"result\":\"ok\",\"success\":true}");
    assert_eq(agnosai_tool_output_success(ok1), 1, "an explicit success is a success");
    _t_seq(bayan_json_v_str(_t_result(ok1)), str_from("ok"), "and `result` is extracted");

    # --- Oracle: output_failure_parsing -----------------------------------
    var bad1 = _t_out("{\"success\":false,\"error\":\"missing param\"}");
    assert_eq(agnosai_tool_output_success(bad1), 0, "an explicit failure is a failure");
    _t_seq(agnosai_tool_output_error(bad1), str_from("missing param"),
      "carrying the tool's own message");

    # --- Oracle: output_missing_success_defaults_true ---------------------
    # ⚠ `.and_then(as_bool).unwrap_or(true)`.
    var ok2 = _t_out("{\"result\":{\"key\":\"value\"}}");
    assert_eq(agnosai_tool_output_success(ok2), 1, "an ABSENT `success` defaults to TRUE");

    # ...and so does a NON-BOOLEAN one, which the oracle never tests and which
    # `bayan_json_v_bool` on a string would answer 0 for, inverting it.
    assert_eq(agnosai_tool_output_success(_t_out("{\"success\":\"yes\",\"result\":1}")), 1,
      "a NON-BOOLEAN `success` also defaults to true");
    assert_eq(agnosai_tool_output_success(_t_out("{\"success\":1,\"result\":1}")), 1,
      "including a numeric one");
    assert_eq(agnosai_tool_output_success(_t_out("{\"success\":null,\"result\":1}")), 1,
      "and a null one");

    # --- Oracle: output_non_json_returns_raw ------------------------------
    # ⚠ A SUCCESS, not an error, and the text is TRIMMED.
    var raw = _t_out("not json at all\n");
    assert_eq(agnosai_tool_output_success(raw), 1, "non-JSON stdout is a SUCCESS");
    _t_seq(bayan_json_v_str(_t_result(raw)), str_from("not json at all"),
      "carrying the raw text, trimmed");
    assert_eq(bayan_json_v_is_str(_t_result(raw)), 1, "as a JSON string");
    var empty_out = _t_out("");
    assert_eq(agnosai_tool_output_success(empty_out), 1, "and empty stdout is a success too");

    # --- Oracle: output_missing_error_defaults_unknown --------------------
    var bad2 = _t_out("{\"success\":false}");
    assert_eq(agnosai_tool_output_success(bad2), 0, "a failure with no `error`");
    _t_seq(agnosai_tool_output_error(bad2), str_from("unknown error"),
      "reads `unknown error`");
    # A non-string `error` falls back the same way — `.and_then(as_str)`.
    _t_seq(agnosai_tool_output_error(_t_out("{\"success\":false,\"error\":42}")),
      str_from("unknown error"), "and so does a non-string one");

    # --- Oracle: output_result_extracted_when_present ---------------------
    var arr = _t_out("{\"result\":[1,2,3],\"success\":true}");
    assert_eq(bayan_json_v_is_arr(_t_result(arr)), 1, "an array `result` is extracted");
    assert_eq(bayan_json_v_arr_len(_t_result(arr)), 3, "whole");

    # --- Oracle: output_whole_value_when_no_result_key --------------------
    var whole = _t_out("{\"data\":\"something\"}");
    assert_eq(agnosai_tool_output_success(whole), 1, "no `result` key is still a success");
    assert_neq(bayan_json_v_obj_get(_t_result(whole), "data"), 0,
      "and the WHOLE value becomes the result");

    # ⚠ An ABSENT `result` means the whole value; a PRESENT JSON NULL does not.
    # serde's `.get()` answers `Some(Value::Null)`, and bayan draws the same
    # line — 0 for absent, a JTAG_NULL node for a present null. The bridge emits
    # `"result": None` on every failure, so this path is live.
    var nullres = _t_out("{\"result\":null,\"success\":true}");
    assert_eq(bayan_json_v_is_null(_t_result(nullres)), 1,
      "a PRESENT null `result` is null, not the enclosing object");
    assert_eq(bayan_json_v_is_obj(_t_result(nullres)), 0, "and definitely not the object");

    # --- the ladder's order -------------------------------------------------
    # ⚠ TIMED OUT is checked FIRST. A timed-out result also carries
    # `exit_code == -1`, so the reversed order reports "exited with code -1".
    var to = agnosai_python_tool_output_of(str_from(""), str_from(""), 0 - 1, 1);
    assert_eq(agnosai_tool_output_success(to), 0, "a timeout is a failure");
    _t_seq(agnosai_tool_output_error(to), str_from("python tool execution timed out"),
      "reported as a TIMEOUT, not as exit code -1");

    # A timeout wins even when stdout holds a perfectly good result.
    _t_seq(agnosai_tool_output_error(agnosai_python_tool_output_of(
          str_from("{\"result\":\"ok\"}"), str_from(""), 0, 1)),
      str_from("python tool execution timed out"), "and it wins over usable stdout");

    # ⚠ A NON-ZERO EXIT shadows the structured error. This is the shipped
    # bridge's own shape — `exit 1` with `{"success":false,"error":...}` on
    # stdout and an empty stderr — so the tool's real message is DISCARDED and
    # the caller sees the exit code. Pinned because it reads like a bug.
    var shadowed = agnosai_python_tool_output_of(
      str_from("{\"success\":false,\"error\":\"ValueError: bad name\",\"result\":null}"),
      str_from(""), 1, 0);
    assert_eq(agnosai_tool_output_success(shadowed), 0, "a non-zero exit is a failure");
    _t_seq(agnosai_tool_output_error(shadowed), str_from("python tool exited with code 1"),
      "and the exit code SHADOWS the structured error the bridge actually sent");

    # stderr wins over the exit code when it has anything, trimmed.
    _t_seq(agnosai_tool_output_error(agnosai_python_tool_output_of(str_from(""),
          str_from("  Traceback: boom  \n"), 1, 0)), str_from("Traceback: boom"),
      "a non-empty stderr is preferred, trimmed");
    # Whitespace-only stderr is empty, so the code wins.
    _t_seq(agnosai_tool_output_error(agnosai_python_tool_output_of(str_from(""),
          str_from("   \n  "), 2, 0)), str_from("python tool exited with code 2"),
      "whitespace-only stderr counts as empty");
    # A negative exit code that is not a timeout still renders.
    _t_seq(agnosai_tool_output_error(agnosai_python_tool_output_of(str_from(""),
          str_from(""), 0 - 9, 0)), str_from("python tool exited with code -9"),
      "and a signal-shaped exit code renders as itself");

    # --- the sandbox error path ---------------------------------------------
    # ⚠ The prefix DOUBLES. `AgnosaiError`'s Sandbox variant Displays as
    # "sandbox error: <detail>" and the format string prepends "python sandbox
    # error: ". Using `agnosai_error_detail` instead of `_message` would drop
    # the inner prefix and diverge silently.
    var broken = agnosai_python_tool(str_from("nope"), str_from("nope"), vec_new(),
      str_from("x"), agnosai_python_sandbox_with_config(
        str_from("/nonexistent/definitely-not-python"), 2000));
    var out = agnosai_tool_execute(broken, agnosai_tool_input_new());
    assert_eq(agnosai_tool_output_success(out), 0, "an unspawnable interpreter fails");
    assert_eq(str_starts_with(agnosai_tool_output_error(out),
        str_from("python sandbox error: sandbox error: ")), 1,
      "with the prefix DOUBLED, which is what the oracle's format! produces");

    # --- end to end, when there is an interpreter ---------------------------
    # ⚠ The oracle has NO end-to-end test of `execute`. This is a port addition.
    if (file_exists("/usr/bin/python3") == 1) {
        var greeter = agnosai_python_tool(str_from("greet"), str_from("Greet a user"),
          vec_new(),
          str_from("def create_tool():\n    class Greeter:\n        def execute(self, params):\n            return {\"greeting\": \"Hello, \" + params[\"name\"] + \"!\"}\n    return Greeter()\n"),
          agnosai_python_sandbox_with_config(str_from("python3"), 10000));
        var input = agnosai_tool_input_new();
        agnosai_tool_input_set(input, str_from("name"),
          bayan_json_v_str_new(str_from("world")));
        var real = agnosai_tool_execute(greeter, input);
        assert_eq(agnosai_tool_output_success(real), 1,
          "a real Python tool runs end to end and succeeds");
        _t_seq(bayan_json_v_str(bayan_json_v_obj_get(_t_result(real), "greeting")),
          str_from("Hello, world!"), "returning what it computed");

        # A tool that raises exits 1 with the structured error on stdout, which
        # the ladder shadows — the live proof of the branch pinned above.
        var raiser = agnosai_python_tool(str_from("boom"), str_from("raises"), vec_new(),
          str_from("def create_tool():\n    class B:\n        def execute(self, params):\n            raise ValueError(\"nope\")\n    return B()\n"),
          agnosai_python_sandbox_with_config(str_from("python3"), 10000));
        var boom = agnosai_tool_execute(raiser, agnosai_tool_input_new());
        assert_eq(agnosai_tool_output_success(boom), 0, "a raising tool fails");
        _t_seq(agnosai_tool_output_error(boom), str_from("python tool exited with code 1"),
          "and its ValueError really is discarded in favour of the exit code");
    }

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
