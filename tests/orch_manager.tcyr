# =========================================================================
# orch_manager.tcyr — a hierarchical crew: a manager and its workers (ADR 035).
#
# No oracle: the Rust line warned and ran a hierarchical crew sequentially. Its `delegate_tasks`
# (`orch_hierarchical.tcyr`) is held here to agree with what a run assigns.
#
# The crew is a manager holding `sql_query` and `report_writer`, and three workers: an analyst
# holding `sql_query`, a writer holding `report_writer` and `docker`, and a deployer holding
# `docker` and `kubectl`. So the analyst keeps everything, the writer loses `docker`, and the
# deployer loses both. The gateway tells its callers apart by a word in each one's turn, and keeps
# each one's last request in a slot of its own.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/strcase.cyr"
include "src/telemetry/mod.cyr"
include "src/core/error.cyr"
include "src/core/json.cyr"
include "src/core/message.cyr"
include "src/core/resource.cyr"
include "src/core/task.cyr"
include "src/core/agent.cyr"
include "src/core/crew.cyr"
include "src/orchestrator/scheduler.cyr"
include "src/orchestrator/audit.cyr"
include "src/llm/retry.cyr"
include "src/llm/hoosh.cyr"
include "src/llm/router.cyr"
include "src/orchestrator/scoring.cyr"
include "src/orchestrator/output_validation.cyr"
include "src/server/prompt_guard.cyr"
include "src/server/output_filter.cyr"
include "src/chan_lossy.cyr"
include "src/server/sse.cyr"
include "src/server/prometheus.cyr"
