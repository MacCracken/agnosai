# ── the scripted gateway ───────────────────────────────────────────────────

# Slot 0–2 are the three tasks, by their words; slot 3 is the manager's answer. Each: what it
# answers (0 refuses), its last request, and how many it sent.
var _t_says_[32];
var _t_last[32];
var _t_sent[32];
# A runner the gateway cancels while slot 2 answers, or 0.
var _t_cancel_on = 0;

fn _t_word(i): i64 {
    if (i == 0) { return "ALPHA"; }
    if (i == 1) { return "BRAVO"; }
    if (i == 2) { return "CHARLIE"; }
    return "Write this crew's answer";
}

fn _t_reset(): i64 {
    for (var i = 0; i < 4; i = i + 1) {
        store64(&_t_last + i * 8, 0);
        store64(&_t_sent + i * 8, 0);
    }
    store64(&_t_says_ + 0, "the numbers are up");
    store64(&_t_says_ + 8, "the report is written");
    store64(&_t_says_ + 16, "nothing was deployed");
    store64(&_t_says_ + 24, "the crew's answer");
    _t_cancel_on = 0;
    return 0;
}

fn _t_says(i, text): i64 {
    store64(&_t_says_ + i * 8, text);
    return 0;
}

fn _t_body(text): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"model\":\"m\",\"choices\":[{\"message\":{\"content\":\"");
    str_builder_add_cstr(sb, text);
    str_builder_add_cstr(sb, "\"}}],\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":5}}");
    return str_builder_build(sb);
}

fn _t_parse(json: Str): i64 {
    return bayan_json_v_parse_buf(str_data(json), str_len(json));
}

fn _t_msgs(json: Str): i64 {
    return bayan_json_v_obj_get_by_cstr(_t_parse(json), "messages");
}

fn _t_msg_field(json: Str, j, key): i64 {
    var msgs = _t_msgs(json);
    var at = j;
    if (at < 0) { at = bayan_json_v_arr_len(msgs) + j; }
    return bayan_json_v_str(bayan_json_v_obj_get_by_cstr(bayan_json_v_arr_get(msgs, at), key));
}

fn _t_chat(client, request, out_response, parent_sc): i64 {
    var json = agnosai_inference_request_to_json(request);
    var turn = _t_msg_field(json, 0 - 1, "content");
    var who = 0 - 1;
    for (var i = 0; i < 4; i = i + 1) {
        if (str_contains_cstr(turn, _t_word(i)) == 1) { who = i; }
    }
    if (who < 0) { return str_from("no such caller"); }
    store64(&_t_last + who * 8, json);
    atomic_fetch_add(&_t_sent + who * 8, 1);
    if (who == 2 && _t_cancel_on != 0) { agnosai_crew_runner_cancel(_t_cancel_on); }
    var say = load64(&_t_says_ + who * 8);
    if (say == 0) { return str_from("invalid API key"); }
    store64(out_response, agnosai_hoosh_response_from_body_a(agnosai_inference_request_alloc(request),
        _t_body(say)));
    return 0;
}

fn _t_req(i): i64 {
    return load64(&_t_last + i * 8);
}

fn _t_sent_by(i): i64 {
    return load64(&_t_sent + i * 8);
}

fn _t_content(i, j): i64 {
    return _t_msg_field(_t_req(i), j, "content");
}

# The tool names request `i` offered.
fn _t_offered(i): i64 {
    var out = vec_new();
    var tools = bayan_json_v_obj_get_by_cstr(_t_parse(_t_req(i)), "tools");
    if (tools == 0) { return out; }
    for (var k = 0; k < bayan_json_v_arr_len(tools); k = k + 1) {
        var f = bayan_json_v_obj_get_by_cstr(bayan_json_v_arr_get(tools, k), "function");
        vec_push(out, bayan_json_v_str(bayan_json_v_obj_get_by_cstr(f, "name")));
    }
    return out;
}

fn _t_holds(names, name): i64 {
    for (var i = 0; i < vec_len(names); i = i + 1) {
        if (str_eq_cstr(vec_get(names, i), name) == 1) { return 1; }
    }
    return 0;
}

# ── the crew ───────────────────────────────────────────────────────────────

fn _t_names(t0, t1): i64 {
    var v = vec_new();
    if (t0 != 0) { vec_push(v, str_from(t0)); }
    if (t1 != 0) { vec_push(v, str_from(t1)); }
    return v;
}

fn _t_agent(key, t0, t1): i64 {
    var a = agnosai_agent_new(str_from(key), str_from("worker"), str_from("do the work"));
    agnosai_agent_with_tools(a, _t_names(t0, t1));
    return a;
}

var _t_boss = 0;
var _t_analyst = 0;
var _t_writer = 0;
var _t_deployer = 0;

fn _t_agents(): i64 {
    _t_boss = _t_agent("boss", "sql_query", "report_writer");
    _t_analyst = _t_agent("analyst", "sql_query", 0);
    _t_writer = _t_agent("writer", "report_writer", "docker");
    _t_deployer = _t_agent("deployer", "docker", "kubectl");
    var v = vec_new();
    vec_push(v, _t_boss);
    vec_push(v, _t_analyst);
    vec_push(v, _t_writer);
    vec_push(v, _t_deployer);
    return v;
}

# Task `i`, by its word, needing `tool`.
fn _t_task(i, tool): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "do the ");
    str_builder_add_cstr(sb, _t_word(i));
    str_builder_add_cstr(sb, " part");
    var t = agnosai_task_new(str_builder_build(sb));
    var req = bayan_json_v_arr_new();
    bayan_json_v_arr_push(req, bayan_json_v_str_new(str_from(tool)));
    agnosai_task_with_context(t, str_from("required_tools"), req);
    return t;
}

fn _t_tasks(): i64 {
    var v = vec_new();
    vec_push(v, _t_task(0, "sql_query"));
    vec_push(v, _t_task(1, "report_writer"));
    vec_push(v, _t_task(2, "kubectl"));
    return v;
}

fn _t_spec(manager): i64 {
    var spec = agnosai_crew_new(str_from("managed"));
    agnosai_crew_with_agents(spec, _t_agents());
    agnosai_crew_with_tasks(spec, _t_tasks());
    agnosai_crew_with_process(spec, agnosai_process_hierarchical(str_from(manager)));
    return spec;
}

fn _t_schema(a, ctx): i64 {
    return agnosai_tool_schema_new_a(a, str_from_a(a, "ignored"), str_from_a(a, "a test tool"));
}

fn _t_exec(ctx, input): i64 {
    return agnosai_tool_output_ok(bayan_json_v_str_new(str_from("ran")));
}

fn _t_registry(): i64 {
    var r = agnosai_tool_registry_new();
    var names = _t_names("sql_query", "report_writer");
    vec_push(names, str_from("docker"));
    vec_push(names, str_from("kubectl"));
    for (var i = 0; i < vec_len(names); i = i + 1) {
        agnosai_tool_registry_register(r, agnosai_tool_new(vec_get(names, i), str_from("a test tool"),
            &_t_schema, &_t_exec, 0));
    }
    return r;
}

fn _t_client(): i64 {
    return agnosai_hoosh_client_with_chat(agnosai_hoosh_client_new(str_from("http://127.0.0.1:1"),
        str_from("")), &_t_chat);
}

fn _t_runner(spec): i64 {
    var r = agnosai_crew_runner_new(spec);
    agnosai_crew_runner_with_llm(r, _t_client());
    agnosai_crew_runner_with_tools(r, _t_registry(), 0);
    return r;
}

fn _t_run(spec): i64 {
    var err: i64[1];
    store64(&err, 0);
    return agnosai_crew_runner_run(_t_runner(spec), &err);
}

fn _t_md(result, key): i64 {
    return map_get(agnosai_task_result_metadata(result), str_from(key));
}

fn _t_md_str(result, key): i64 {
    var v = _t_md(result, key);
    if (v == 0) { return 0; }
    return bayan_json_v_str(v);
}

# ── narrowing, as a pure read ──────────────────────────────────────────────

fn test_narrowing(): i64 {
    _t_agents();
    var a = default_alloc();
    var w = agnosai_worker_within_a(a, _t_writer, _t_boss);
    assert_eq(vec_len(agnosai_agent_tools(w)), 1, "a worker keeps what its manager holds too");
    assert(str_eq_cstr(vec_get(agnosai_agent_tools(w), 0), "report_writer") == 1, "which is this");
    assert(str_eq_cstr(agnosai_agent_key(w), "writer") == 1, "and the rest is its own");
    assert(w != _t_writer, "on a copy");
    assert_eq(vec_len(agnosai_agent_tools(_t_writer)), 2, "its definition is untouched");
    var held = agnosai_tools_withheld_a(a, _t_writer, _t_boss);
    assert_eq(vec_len(held), 1, "the rest is withheld");
    sakshi_set_level(SK_WARN);
    assert_eq(agnosai_log_withheld(_t_boss, _t_writer, held), 0, "and warned of, naming the worker");
    sakshi_set_level(SK_FATAL);
    assert(str_eq_cstr(vec_get(held, 0), "docker") == 1, "and named");
    assert_eq(vec_len(agnosai_agent_tools(agnosai_worker_within_a(a, _t_deployer, _t_boss))), 0,
      "a worker holding nothing its manager holds is left nothing");
    assert_eq(vec_len(agnosai_tools_withheld_a(a, _t_analyst, _t_boss)), 0,
      "and one holding only what its manager holds loses nothing");
    var none = agnosai_agent_new(str_from("bare"), str_from("r"), str_from("g"));
    agnosai_agent_with_tools(none, 0);
    assert_eq(vec_len(agnosai_agent_tools(agnosai_worker_within_a(a, none, _t_boss))), 0,
      "a worker with no tool list keeps none");
    assert_eq(vec_len(agnosai_tools_withheld_a(a, _t_writer, none)), 2,
      "and a manager with none withholds everything");

    var agents = _t_agents();
    assert(agnosai_find_manager(agents, str_from("boss")) == _t_boss, "a manager is found by its key");
    assert_eq(agnosai_find_manager(agents, str_from("nobody")), 0, "and one that is not there is not");
    assert_eq(agnosai_find_manager(agents, 0), 0, "nor is no key at all");
    var workers = agnosai_hierarchical_workers_a(a, agents, _t_boss);
    assert_eq(vec_len(workers), 3, "every agent but its manager works");
    for (var i = 0; i < 3; i = i + 1) {
        assert_eq(str_eq_cstr(agnosai_agent_key(vec_get(workers, i)), "boss"), 0, "the manager is none of them");
    }
    var alone = vec_new();
    vec_push(alone, _t_boss);
    var self = agnosai_hierarchical_workers_a(a, alone, _t_boss);
    assert(vec_len(self) == 1 && vec_get(self, 0) == _t_boss,
      "a manager with no workers is its own, with its own tools");
    return 0;
}

# ── a run ──────────────────────────────────────────────────────────────────

fn test_managed_run(): i64 {
    _t_reset();
    var spec = _t_spec("boss");
    var state = _t_run(spec);
    var results = agnosai_crew_state_results(state);
    assert_eq(agnosai_crew_state_status(state), AGNOSAI_CREW_COMPLETED, "a managed crew completes");
    assert_eq(vec_len(results), 4, "with its three tasks' results and its manager's answer");

    assert(str_eq_cstr(_t_md_str(vec_get(results, 0), "agent"), "analyst") == 1,
      "the task needing sql_query goes to the analyst, though the manager holds it too");
    assert(str_eq_cstr(_t_md_str(vec_get(results, 1), "agent"), "writer") == 1,
      "the one needing report_writer to the writer");
    for (var i = 0; i < 3; i = i + 1) {
        assert(str_eq_cstr(_t_md_str(vec_get(results, i), "assigned_by"), "boss") == 1,
          "each result says who assigned it");
        assert_eq(str_eq_cstr(_t_md_str(vec_get(results, i), "agent"), "boss"), 0,
          "and no task is the manager's while it has workers");
    }

    # The record matches the definitions, worker by worker.
    var a = default_alloc();
    var tasks = agnosai_crew_tasks(spec);
    var workers = agnosai_hierarchical_workers_a(a, agnosai_crew_agents(spec), _t_boss);
    var assigned = agnosai_delegate_tasks(_t_boss, workers, tasks);
    for (var j = 0; j < 3; j = j + 1) {
        var ran = _t_md_str(vec_get(results, j), "agent");
        var explained = agnosai_explain_selection_a(a, workers, vec_get(tasks, j));
        var top = vec_get(workers, agnosai_scored_index(vec_get(explained, 0)));
        assert(str_eq(agnosai_agent_key(top), ran) == 1,
          "the selection explained over the workers names the agent that ran");
        assert(str_eq(agnosai_assignment_agent_key(vec_get(assigned, j)), ran) == 1,
          "as the Rust line's delegate_tasks does");
    }

    var held = _t_md(vec_get(results, 1), "withheld_tools");
    assert(held != 0 && bayan_json_v_arr_len(held) == 1, "the writer's result names what it was withheld");
    assert(str_eq_cstr(bayan_json_v_str(bayan_json_v_arr_get(held, 0)), "docker") == 1, "docker");
    assert_eq(_t_md(vec_get(results, 0), "withheld_tools"), 0, "and the analyst's names nothing");

    var writer_offered = _t_offered(1);
    assert(_t_holds(writer_offered, "report_writer") == 1, "the writer is offered what it holds");
    assert_eq(_t_holds(writer_offered, "docker"), 0, "and not what its manager withheld");
    assert_eq(str_contains_cstr(_t_content(1, 0), "docker"), 0, "nor told of it in its prompt");
    assert_eq(vec_len(agnosai_agent_tools(_t_writer)), 2, "its definition still holds both");

    # The manager's answer.
    var last = vec_get(results, 3);
    assert(str_eq_cstr(_t_md_str(last, "role"), "manager") == 1, "the last result is the manager's");
    assert(str_eq_cstr(_t_md_str(last, "agent"), "boss") == 1, "by the manager");
    assert_eq(_t_md(last, "assigned_by"), 0, "which nobody assigned");
    assert(str_eq_cstr(agnosai_task_result_output(last), "the crew's answer") == 1, "its own answer");
    assert_eq(_t_sent_by(3), 1, "in one call");
    assert_eq(vec_len(_t_offered(3)), 0, "offered no tool: the manager writes and calls nothing");
    assert_eq(str_contains_cstr(_t_content(3, 0), "Available tools"), 0, "and told of none");
    var handed = _t_content(3, 1);
    assert(str_contains_cstr(handed, "the numbers are up") == 1, "it is handed every worker's answer");
    assert(str_contains_cstr(handed, "nothing was deployed") == 1, "the last one too");
    assert(str_index_of_cstr(handed, "the numbers are up") < str_index_of_cstr(handed, "the report is written"),
      "in the crew's order");
    var turn = _t_content(3, 0 - 1);
    assert(str_contains_cstr(turn, "do the ALPHA part") == 1, "and told what each task was");
    assert(str_contains_cstr(turn, "do the CHARLIE part") == 1, "every one");
    return 0;
}

fn test_alone(): i64 {
    _t_reset();
    var spec = agnosai_crew_new(str_from("alone"));
    var only = vec_new();
    vec_push(only, _t_agent("boss", "sql_query", 0));
    agnosai_crew_with_agents(spec, only);
    agnosai_crew_with_tasks(spec, _t_tasks());
    agnosai_crew_with_process(spec, agnosai_process_hierarchical(str_from("boss")));
    var results = agnosai_crew_state_results(_t_run(spec));
    assert_eq(vec_len(results), 4, "a manager with no workers does every task, then answers");
    assert(str_eq_cstr(_t_md_str(vec_get(results, 0), "agent"), "boss") == 1, "itself");
    assert(_t_holds(_t_offered(0), "sql_query") == 1, "with its own tools, as nobody is above it");
    return 0;
}

fn test_no_answer_after_a_failure(): i64 {
    _t_reset();
    _t_says(1, 0);
    var state = _t_run(_t_spec("boss"));
    assert_eq(agnosai_crew_state_status(state), AGNOSAI_CREW_FAILED, "a crew whose worker failed fails");
    assert(str_eq(agnosai_crew_state_reason(state), AGNOSAI_CREW_REASON_TASK_FAILED) == 1, "task_failed");
    assert_eq(vec_len(agnosai_crew_state_results(state)), 3, "with every worker's result");
    assert_eq(_t_sent_by(3), 0, "and no manager's answer, which would be a call wasted");
    return 0;
}

fn test_no_answer_once_spent(): i64 {
    _t_reset();
    var r = _t_runner(_t_spec("boss"));
    agnosai_crew_runner_with_budget(r, agnosai_budget_tracker_limits_a(default_alloc(), 45, AGNOSAI_NO_LIMIT, 0,
        "crew"));
    var err: i64[1];
    store64(&err, 0);
    var state = agnosai_crew_runner_run(r, &err);
    assert_eq(_t_sent_by(2), 1, "the three workers spend the budget");
    assert_eq(_t_sent_by(3), 0, "so the manager does not answer");
    assert_eq(agnosai_crew_state_status(state), AGNOSAI_CREW_FAILED,
      "and the crew has not completed: it owes its manager's answer");
    assert(str_eq(agnosai_crew_state_reason(state), AGNOSAI_CREW_REASON_BUDGET_EXCEEDED) == 1,
      "because its budget ran out");
    return 0;
}

fn test_no_answer_once_cancelled(): i64 {
    _t_reset();
    var r = _t_runner(_t_spec("boss"));
    _t_cancel_on = r;
    var err: i64[1];
    store64(&err, 0);
    var state = agnosai_crew_runner_run(r, &err);
    assert_eq(_t_sent_by(3), 0, "a crew cancelled during its last worker's task gets no manager's answer");
    assert_eq(agnosai_crew_state_status(state), AGNOSAI_CREW_CANCELLED, "and ends cancelled");
    return 0;
}

fn test_events(): i64 {
    _t_reset();
    var spec = _t_spec("boss");
    var tx = agnosai_event_bus_sender(agnosai_event_bus_new(), agnosai_crew_id(spec));
    var sub = agnosai_event_sender_subscribe(tx);
    var r = agnosai_crew_runner_with_events(_t_runner(spec), tx);
    var err: i64[1];
    store64(&err, 0);
    agnosai_crew_runner_run(r, &err);
    var started = 0;
    var completed = 0;
    var task_count = 0 - 1;
    var last_agent = 0;
    var ev = agnosai_event_sub_try_recv(sub);
    while (ev != 0) {
        var type = agnosai_crew_event_event_type(ev);
        var d = agnosai_crew_event_data(ev);
        if (str_eq_cstr(type, "crew_started") == 1) {
            task_count = bayan_json_v_int(bayan_json_v_obj_get_by_cstr(d, "task_count"));
        }
        if (str_eq_cstr(type, "task_started") == 1) {
            started = started + 1;
            last_agent = bayan_json_v_str(bayan_json_v_obj_get_by_cstr(d, "agent"));
        }
        if (str_eq_cstr(type, "task_completed") == 1) { completed = completed + 1; }
        ev = agnosai_event_sub_try_recv(sub);
    }
    assert_eq(task_count, 4, "crew_started counts the manager's answer among its tasks");
    assert_eq(started, 4, "every task starts, the manager's answer too");
    assert_eq(completed, 4, "and ends");
    assert(str_eq_cstr(last_agent, "boss") == 1, "the last by the manager");
    return 0;
}

fn test_no_such_manager(): i64 {
    _t_reset();
    var err: i64[1];
    store64(&err, 0);
    assert_eq(agnosai_crew_runner_run(_t_runner(_t_spec("nobody")), &err), 0,
      "a manager that names no agent of the crew's cannot run");
    assert_eq(agnosai_error_kind(load64(&err)), AGNOSAI_ERR_INVALID_DEFINITION, "an invalid definition");
    assert(str_contains_cstr(agnosai_error_message(load64(&err)), "nobody") == 1, "naming the key");
    assert(str_eq(agnosai_crew_unrunnable_reason(load64(&err)), AGNOSAI_CREW_REASON_INVALID_MANAGER) == 1,
      "which ends a crew invalid_manager");
    assert(str_eq(agnosai_crew_unrunnable_reason(agnosai_error_cyclic_dag()), AGNOSAI_CREW_REASON_INVALID_DAG) == 1,
      "where a cycle ends it invalid_dag");
    assert_eq(_t_sent_by(0), 0, "and no task ran");

    var o = agnosai_orchestrator_new(0);
    var spec = _t_spec("nobody");
    store64(&err, 0);
    assert_eq(agnosai_orchestrator_run_crew_err(o, spec, &err), 0, "the orchestrator runs none either");
    var held = agnosai_orchestrator_crew(o, agnosai_crew_id(spec));
    assert(held != 0, "and keeps the crew");
    assert_eq(agnosai_crew_state_status(held), AGNOSAI_CREW_FAILED, "failed");
    assert(str_eq(agnosai_crew_state_reason(held), AGNOSAI_CREW_REASON_INVALID_MANAGER) == 1,
      "invalid_manager, not invalid_dag");
    assert(agnosai_crew_reason_from_wire(str_from("invalid_manager")) == AGNOSAI_CREW_REASON_INVALID_MANAGER,
      "a word the wire reads back");
    return 0;
}

fn main(): i64 {
    alloc_init();
    sakshi_set_level(SK_FATAL);
    agnosai_model_set_tier_override(AGNOSAI_TIER_FAST, str_from("stub-model"));
    agnosai_model_set_tier_override(AGNOSAI_TIER_CAPABLE, str_from("stub-model"));
    agnosai_model_set_tier_override(AGNOSAI_TIER_PREMIUM, str_from("stub-model"));
    test_narrowing();
    test_managed_run();
    test_alone();
    test_no_answer_after_a_failure();
    test_no_answer_once_spent();
    test_no_answer_once_cancelled();
    test_events();
    test_no_such_manager();
    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
sys_exit_group(f);
