# =========================================================================
# server_routes_a2a — rust-old/src/server/routes/a2a.rs.
#
# All five of the oracle's tests are plain `#[test]`s over
# `is_safe_callback_url`, which is a one-line delegate to the shared SSRF
# module. They port here even though `server_ssrf.tcyr`'s 81 assertions already
# cover the underlying function — because they are this file's tests, and
# because a refactor that stopped delegating would only be caught at this level.
#
# The oracle has **no test for `receive` at all**, so the length caps, the
# metadata cap, the crew-name construction, the response shape and every
# rejection arm are covered here for the first time.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
# telemetry — `tools/native` and `orchestrator/crew_runner` record GenAI
# spans (ADR 017), so every suite that reaches them needs the module that
# defines the recorder. It depends on nothing in `src/` except `id`.
include "src/telemetry/mod.cyr"
include "src/core/mod.cyr"
include "src/learning/mod.cyr"
include "src/llm/mod.cyr"
include "src/server/ssrf.cyr"
include "src/server/prompt_guard.cyr"
include "src/server/output_filter.cyr"
include "src/server/prometheus.cyr"
include "src/server/auth.cyr"
include "src/guarded_fetch.cyr"
include "src/chan_lossy.cyr"
include "src/server/sse.cyr"
include "src/tools/mod.cyr"
include "src/orchestrator/mod.cyr"
include "src/server/state.cyr"
include "src/server/routes/mod.cyr"
include "src/server/routes/health.cyr"
include "src/server/routes/tools.cyr"
include "src/server/routes/agents.cyr"
include "src/server/routes/approval.cyr"
include "src/server/routes/dashboard.cyr"
include "src/server/routes/crews.cyr"
include "src/server/routes/a2a.cyr"
include "tests/test_helpers.cyr"

# The same state over a caller-supplied orchestrator, so a test can hold the
# registry and the audit chain it wants to inspect afterwards.
fn _t_state_with(o): i64 {
    return agnosai_app_state_new(o,
    agnosai_tool_registry_new(), agnosai_auth_config_new(),
    agnosai_event_bus_new(), agnosai_audit_chain_new(),
    agnosai_approval_gate_new());
}

fn _t_state(): i64 {
    return agnosai_app_state_new(agnosai_orchestrator_new(0),
    agnosai_tool_registry_new(), agnosai_auth_config_new(),
    agnosai_event_bus_new(), agnosai_audit_chain_new(),
    agnosai_approval_gate_new());
}

fn _t_body_str(r, key): Str {
    var v = bayan_json_v_obj_get(agnosai_route_body(r), key);
    if (v == 0 || bayan_json_v_is_str(v) == 0) { return str_from(""); }
    return bayan_json_v_str(v);
}

fn _t_str_of(n, ch): Str {
    var sb = str_builder_new();
    for (var i = 0; i < n; i = i + 1) { str_builder_putc(sb, ch); }
    return str_builder_build(sb);
}

# `{"task_id":"t1","description":"d"}` plus any extra members.
fn _t_req_body(extra): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"task_id\":\"t1\",\"description\":\"do the thing\"");
    str_builder_add_cstr(sb, extra);
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# --- The oracle's five sync tests ----------------------------------------

# Oracle: `safe_callback_rejects_loopback`.
fn _t_rejects_loopback(): i64 {
    assert(agnosai_route_a2a_callback_allowed(str_from("http://127.0.0.1/callback")) == 0,
    "127.0.0.1 is rejected");
    assert(agnosai_route_a2a_callback_allowed(str_from("http://[::1]/callback")) == 0,
    "[::1] is rejected");
    return 0;
}

# Oracle: `safe_callback_rejects_ipv6_mapped_ipv4`.
fn _t_rejects_ipv6_mapped(): i64 {
    assert(agnosai_route_a2a_callback_allowed(str_from("http://[::ffff:10.0.0.1]/path")) == 0,
    "an IPv6-mapped private IPv4 is rejected");
    assert(agnosai_route_a2a_callback_allowed(str_from("http://[::ffff:127.0.0.1]/path")) == 0,
    "an IPv6-mapped loopback is rejected");
    return 0;
}

# Oracle: `safe_callback_rejects_localhost_variants`.
fn _t_rejects_localhost_variants(): i64 {
    assert(agnosai_route_a2a_callback_allowed(str_from("http://localhost/cb")) == 0,
    "localhost is rejected");
    assert(agnosai_route_a2a_callback_allowed(str_from("http://LOCALHOST/cb")) == 0,
    "...case-insensitively");
    assert(agnosai_route_a2a_callback_allowed(str_from("http://0.0.0.0/cb")) == 0,
    "0.0.0.0 is rejected");
    return 0;
}

# Oracle: `safe_callback_rejects_non_http`.
fn _t_rejects_non_http(): i64 {
    assert(agnosai_route_a2a_callback_allowed(str_from("file:///etc/passwd")) == 0,
    "file:// is rejected");
    assert(agnosai_route_a2a_callback_allowed(str_from("ftp://example.com/x")) == 0,
    "ftp:// is rejected");
    assert(agnosai_route_a2a_callback_allowed(str_from("not a url")) == 0,
    "a non-URL is rejected");
    return 0;
}

# Oracle: `safe_callback_accepts_public_urls` and `safe_callback_rejects_metadata_ip`.
fn _t_accepts_public_rejects_metadata(): i64 {
    assert(agnosai_route_a2a_callback_allowed(str_from("https://example.com/cb")) == 1,
    "a public https URL is accepted");
    assert(agnosai_route_a2a_callback_allowed(str_from("http://example.com/cb")) == 1,
    "a public http URL is accepted");
    # The cloud metadata endpoint — the SSRF target that matters most.
    assert(agnosai_route_a2a_callback_allowed(str_from("http://169.254.169.254/latest/meta-data")) == 0,
    "the link-local metadata IP is rejected");
    return 0;
}

# --- `receive`, which the oracle never tests -----------------------------

fn _t_receive_success(): i64 {
    var r = agnosai_route_a2a_receive(_t_state(), _t_req_body(""));
    assert(agnosai_route_status(r) == HTTP_OK, "a valid delegation is 200");
    assert(str_eq(_t_body_str(r, "task_id"), str_from("t1")) == 1,
    "the task_id is echoed from the request");
    assert(str_eq(_t_body_str(r, "status"), str_from("completed")) == 1, "status is completed");

    var b = agnosai_route_body(r);
    assert(bayan_json_v_is_null(bayan_json_v_obj_get(b, "error")) == 1,
    "error is null on success");
    var result = bayan_json_v_obj_get(b, "result");
    assert(bayan_json_v_is_obj(result) == 1, "result is an object");
    var tasks = bayan_json_v_obj_get(result, "tasks");
    assert(bayan_json_v_is_arr(tasks) == 1, "...wrapping a tasks array");
    assert(bayan_json_v_arr_len(tasks) == 1, "...with one entry for the one task");
    var e0 = bayan_json_v_arr_get(tasks, 0);
    assert(bayan_json_v_obj_get(e0, "task_id") != 0, "an entry carries task_id");
    assert(bayan_json_v_obj_get(e0, "output") != 0, "...and output");
    # The oracle's entries carry ONLY those two members.
    assert(bayan_json_v_obj_len(e0) == 2, "...and nothing else");
    assert(bayan_json_v_obj_len(b) == 4, "the response has the oracle's four fields");
    return 0;
}

# The failure arms return the full A2AResponse shape, not the routes tier's
# `{"error": ..}` — the oracle types this handler `(StatusCode, Json<A2AResponse>)`.
fn _t_receive_field_too_long(): i64 {
    var s = _t_state();
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"task_id\":\"t1\",\"description\":\"");
    str_builder_add_str(sb, _t_str_of(AGNOSAI_A2A_MAX_STRING_LEN + 1, 100));
    str_builder_add_cstr(sb, "\"}");
    var r = agnosai_route_a2a_receive(s, str_builder_build(sb));
    assert(agnosai_route_status(r) == HTTP_BAD_REQUEST, "an over-long description is 400");
    assert(str_eq(_t_body_str(r, "status"), str_from("failed")) == 1, "...status failed");
    assert(str_eq(_t_body_str(r, "error"), str_from("field exceeds max length")) == 1,
    "...with the oracle's message");
    assert(str_eq(_t_body_str(r, "task_id"), str_from("t1")) == 1,
    "...still echoing the task_id");
    assert(bayan_json_v_is_null(bayan_json_v_obj_get(agnosai_route_body(r), "result")) == 1,
    "...and a null result");

    # The task_id arm of the same check.
    var sb2 = str_builder_new();
    str_builder_add_cstr(sb2, "{\"task_id\":\"");
    str_builder_add_str(sb2, _t_str_of(AGNOSAI_A2A_MAX_STRING_LEN + 1, 116));
    str_builder_add_cstr(sb2, "\",\"description\":\"d\"}");
    assert(agnosai_route_status(agnosai_route_a2a_receive(s, str_builder_build(sb2)))
    == HTTP_BAD_REQUEST, "an over-long task_id is 400");

    # Exactly at the cap is accepted.
    var sb3 = str_builder_new();
    str_builder_add_cstr(sb3, "{\"task_id\":\"t1\",\"description\":\"");
    str_builder_add_str(sb3, _t_str_of(AGNOSAI_A2A_MAX_STRING_LEN, 100));
    str_builder_add_cstr(sb3, "\"}");
    assert(agnosai_route_status(agnosai_route_a2a_receive(s, str_builder_build(sb3)))
    == HTTP_OK, "a description exactly at the cap is accepted");
    return 0;
}

# The oracle measures metadata by RE-SERIALIZING it, so the cap is on the
# canonical form and whitespace in the incoming body does not count.
fn _t_receive_metadata_cap(): i64 {
    var s = _t_state();
    var sb = str_builder_new();
    str_builder_add_cstr(sb, ",\"metadata\":{\"blob\":\"");
    str_builder_add_str(sb, _t_str_of(AGNOSAI_A2A_MAX_METADATA_BYTES + 100, 120));
    str_builder_add_cstr(sb, "\"}");
    var r = agnosai_route_a2a_receive(s, _t_req_body_raw(str_builder_build(sb)));
    assert(agnosai_route_status(r) == HTTP_BAD_REQUEST, "oversized metadata is 400");
    assert(str_eq(_t_body_str(r, "error"), str_from("metadata exceeds 64 KiB limit")) == 1,
    "...with the oracle's message");

    # A small metadata object passes, and any JSON shape is allowed there.
    assert(agnosai_route_status(agnosai_route_a2a_receive(s,
    _t_req_body(",\"metadata\":{\"k\":\"v\"}"))) == HTTP_OK, "small object metadata passes");
    assert(agnosai_route_status(agnosai_route_a2a_receive(s,
    _t_req_body(",\"metadata\":[1,2,3]"))) == HTTP_OK, "an array is valid metadata");
    assert(agnosai_route_status(agnosai_route_a2a_receive(s,
    _t_req_body(",\"metadata\":42"))) == HTTP_OK, "a scalar is valid metadata");
    assert(agnosai_route_status(agnosai_route_a2a_receive(s,
    _t_req_body(",\"metadata\":null"))) == HTTP_OK, "null is valid metadata");
    return 0;
}

# Body builder that takes a raw suffix Str rather than a cstr.
fn _t_req_body_raw(extra: Str): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"task_id\":\"t1\",\"description\":\"do the thing\"");
    str_builder_add_str(sb, extra);
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# A rejected callback URL is logged and SKIPPED, never an error — the oracle's
# `else` branch warns and falls through, leaving the response untouched.
fn _t_bad_callback_does_not_fail_the_request(): i64 {
    var s = _t_state();
    var r = agnosai_route_a2a_receive(s,
    _t_req_body(",\"callback_url\":\"http://127.0.0.1/steal\""));
    assert(agnosai_route_status(r) == HTTP_OK,
    "an SSRF-rejected callback URL does NOT fail the request");
    assert(str_eq(_t_body_str(r, "status"), str_from("completed")) == 1,
    "...the delegation still completed");
    assert(bayan_json_v_is_null(bayan_json_v_obj_get(agnosai_route_body(r), "error")) == 1,
    "...and no error is reported to the caller");

    # A safe URL is equally invisible in the response.
    var r2 = agnosai_route_a2a_receive(s,
    _t_req_body(",\"callback_url\":\"https://example.com/cb\""));
    assert(agnosai_route_status(r2) == HTTP_OK, "an accepted callback URL is also 200");
    assert(bayan_json_v_obj_len(agnosai_route_body(r2)) == 4,
    "...and adds nothing to the response shape");
    return 0;
}

# --- The reader ----------------------------------------------------------

fn _t_reader(): i64 {
    var fb = str_builder_new();
    str_builder_add_cstr(fb, ",\"domain\":\"quality\",\"size\":\"lean\",\"preset\":\"p\",");
    str_builder_add_cstr(fb, "\"callback_url\":\"https://x.com/c\",\"metadata\":{\"a\":1}");
    var full = _t_req_body_raw(str_builder_build(fb));
    var req = agnosai_a2a_req_from_value(
    bayan_json_v_parse_buf(str_data(full), str_len(full)));
    assert(req != 0, "a full A2ARequest reads");
    assert(str_eq(agnosai_a2a_req_task_id(req), str_from("t1")) == 1, "task_id");
    assert(str_eq(agnosai_a2a_req_description(req), str_from("do the thing")) == 1,
    "description");
    assert(str_eq(agnosai_a2a_req_domain(req), str_from("quality")) == 1, "domain");
    assert(str_eq(agnosai_a2a_req_size(req), str_from("lean")) == 1, "size");
    assert(str_eq(agnosai_a2a_req_preset(req), str_from("p")) == 1, "preset");
    assert(str_eq(agnosai_a2a_req_callback_url(req), str_from("https://x.com/c")) == 1,
    "callback_url");
    assert(agnosai_a2a_req_metadata(req) != 0, "metadata");

    # Only task_id and description are required.
    var min = _t_req_body("");
    var m = agnosai_a2a_req_from_value(bayan_json_v_parse_buf(str_data(min), str_len(min)));
    assert(m != 0, "task_id and description alone are enough");
    assert(agnosai_a2a_req_domain(m) == 0, "domain defaults to absent");
    assert(agnosai_a2a_req_callback_url(m) == 0, "callback_url defaults to absent");

    # The constructor on its own: every optional slot starts absent, so a reader
    # that forgot to clear one would surface here rather than as a stale value
    # carried over from whatever the allocator handed back.
    var blank = agnosai_a2a_req_new(str_from("id"), str_from("desc"));
    assert(str_eq(agnosai_a2a_req_task_id(blank), str_from("id")) == 1, "new stores task_id");
    assert(str_eq(agnosai_a2a_req_description(blank), str_from("desc")) == 1,
    "new stores description");
    assert(agnosai_a2a_req_domain(blank) == 0, "new leaves domain absent");
    assert(agnosai_a2a_req_size(blank) == 0, "new leaves size absent");
    assert(agnosai_a2a_req_preset(blank) == 0, "new leaves preset absent");
    assert(agnosai_a2a_req_callback_url(blank) == 0, "new leaves callback_url absent");
    assert(agnosai_a2a_req_metadata(blank) == 0, "new leaves metadata absent");
    return 0;
}

fn _t_reader_rejections(): i64 {
    var s = _t_state();
    assert(agnosai_route_status(agnosai_route_a2a_receive(s, str_from("not json")))
    == HTTP_BAD_REQUEST, "malformed JSON is 400");
    assert(agnosai_route_status(agnosai_route_a2a_receive(s, str_from("{}")))
    == AGNOSAI_HTTP_UNPROCESSABLE, "missing required fields is 422");
    assert(agnosai_route_status(agnosai_route_a2a_receive(s,
    str_from("{\"task_id\":\"t\"}"))) == AGNOSAI_HTTP_UNPROCESSABLE,
    "missing description is 422");
    assert(agnosai_route_status(agnosai_route_a2a_receive(s,
    str_from("{\"description\":\"d\"}"))) == AGNOSAI_HTTP_UNPROCESSABLE,
    "missing task_id is 422");
    assert(agnosai_route_status(agnosai_route_a2a_receive(s,
    str_from("{\"task_id\":1,\"description\":\"d\"}"))) == AGNOSAI_HTTP_UNPROCESSABLE,
    "a non-string task_id is 422");

    # `deny_unknown_fields`.
    assert(agnosai_route_status(agnosai_route_a2a_receive(s, _t_req_body(",\"nope\":1")))
    == AGNOSAI_HTTP_UNPROCESSABLE, "an unknown field is 422");

    # A present-but-wrong-typed optional is a deserialization failure.
    assert(agnosai_route_status(agnosai_route_a2a_receive(s, _t_req_body(",\"domain\":5")))
    == AGNOSAI_HTTP_UNPROCESSABLE, "a non-string domain is 422");
    assert(agnosai_route_status(agnosai_route_a2a_receive(s,
    _t_req_body(",\"callback_url\":5"))) == AGNOSAI_HTTP_UNPROCESSABLE,
    "a non-string callback_url is 422");
    # ...but an explicit null is the same as absent, matching `Option`.
    assert(agnosai_route_status(agnosai_route_a2a_receive(s, _t_req_body(",\"domain\":null")))
    == HTTP_OK, "an explicit null domain is treated as absent");
    return 0;
}

# --- status --------------------------------------------------------------

fn _t_status(): i64 {
    var r = agnosai_route_a2a_status();
    assert(agnosai_route_status(r) == HTTP_OK, "GET a2a/status is 200");
    assert(str_eq(_t_body_str(r, "status"), str_from("not_implemented")) == 1,
    "...answering not_implemented, as the oracle's placeholder does");
    assert(bayan_json_v_obj_len(agnosai_route_body(r)) == 1, "...with one member");
    return 0;
}

# The A2A deserialiser's `_a` forms, named directly — both are reached only
# through `agnosai_route_a2a_receive_a`, which reference coverage cannot see.
fn _t_a2a_req_takes_an_allocator(): i64 {
    var ar = arena_allocator(65536);

    var r = agnosai_a2a_req_new_a(ar, str_from_a(ar, "t"), str_from_a(ar, "d"));
    assert(r != 0, "a2a_req_new_a builds in the arena");
    assert(str_eq_cstr(agnosai_a2a_req_task_id(r), "t") == 1, "...carrying the task id");

    var body = str_from("{\"task_id\":\"t-9\",\"description\":\"work\",\"domain\":\"ops\"}");
    var v = bayan_json_v_parse_buf_a(ar, str_data(body), str_len(body));
    var req = agnosai_a2a_req_from_value_a(ar, v);
    assert(req != 0, "a2a_req_from_value_a deserialises through the arena");
    assert(str_eq_cstr(agnosai_a2a_req_description(req), "work") == 1, "...the description");
    assert(str_eq_cstr(agnosai_a2a_req_domain(req), "ops") == 1,
    "...and an optional field, which goes through the same clone");

    reset_via(ar);
    return 0;
}

# --- The retention boundary --------------------------------------------

# **The description and task id outlive the request, so they are cloned.**
#
# `agnosai_a2a_req_from_value` borrowed both from the parse tree.
# `agnosai_route_a2a_receive` then hands the description to `agnosai_task_new`
# and runs the crew, and on the placeholder path `crew_runner` makes that
# description the task result's *output* (`crew_runner.cyr:460`) — which lives in
# the registered `CrewState`. The crew name, built from the task id, reaches
# `agnosai_audit_record`, which stores its message **without cloning**.
#
# So: run the whole route through an arena, release it, scribble over it, and
# read both back. The crew-name builder deliberately stays on the global
# allocator for the same reason — `str_builder_build` copies, but building it in
# the request arena would make the copy the *arena's*.
fn _t_a2a_retained_state_survives_its_arena(): i64 {
    var o = agnosai_orchestrator_new(0);
    var s = _t_state_with(o);
    var chain = agnosai_audit_chain_new();
    agnosai_orchestrator_with_audit(o, chain);
    var ar = arena_allocator(262144);

    var r = agnosai_route_a2a_receive_a(ar, s,
    str_from("{\"task_id\":\"t-1\",\"description\":\"do the thing\"}"));
    assert(agnosai_route_status(r) == HTTP_OK, "the threaded route answers 200");

    # Read anything from the response BEFORE the reset — it lives in `ar`.
    assert(agnosai_audit_chain_count(chain) > 0, "the run left an audit trail");

    reset_via(ar);
    var scribble = str_builder_new_a(ar);
    for (var i = 0; i < 2048; i = i + 1) { str_builder_add_cstr_a(ar, scribble, "ZZZZ"); }
    str_builder_build_a(ar, scribble);

    # The crew name is `a2a-general-t-1`, and it is an audit message.
    var recent = agnosai_audit_chain_recent(chain, 16);
    var named = 0;
    for (var j = 0; j < vec_len(recent); j = j + 1) {
        if (str_eq_cstr(agnosai_audit_entry_message(vec_get(recent, j)),
        "a2a-general-t-1") == 1) { named = named + 1; }
    }
    assert(named > 0,
    "the crew name in the audit trail survives the arena being released and \
    overwritten");

    # And the description, which became the task result's output.
    var ids = agnosai_orchestrator_crew_ids(o);
    assert(vec_len(ids) == 1, "one crew was registered");
    var st = agnosai_orchestrator_crew(o, vec_get(ids, 0));
    var results = agnosai_crew_state_results(st);
    assert(vec_len(results) == 1, "...with one task result");
    assert(str_eq_cstr(agnosai_task_result_output(vec_get(results, 0)),
    "do the thing") == 1,
    "**and the description carried into that result survives too** — the \
    request owns its strings rather than borrowing the body");
    return 0;
}

fn main(): i64 {
    alloc_init();
    sakshi_set_level(SK_FATAL);

    _t_rejects_loopback();
    _t_rejects_ipv6_mapped();
    _t_rejects_localhost_variants();
    _t_rejects_non_http();
    _t_accepts_public_rejects_metadata();
    _t_receive_success();
    _t_receive_field_too_long();
    _t_receive_metadata_cap();
    _t_bad_callback_does_not_fail_the_request();
    _t_reader();
    _t_reader_rejections();
    _t_status();

    _t_a2a_req_takes_an_allocator();
    _t_a2a_retained_state_survives_its_arena();

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
