# =========================================================================
# orch_crew_runner.tcyr — parity tests for src/orchestrator/crew_runner.cyr
#
# Oracle: the #[cfg(test)] block in rust-old/src/orchestrator/crew_runner.rs.
# Twelve of its thirty tests cover this bite's pure leaves; the other eighteen
# belong to `execute_task` and the three process modes, in later bites.
#
# **Five of those twelve are `contains`-only or single-agent**, which means a
# byte-wrong or tie-wrong port passes the oracle's own suite. Each is
# strengthened here: every `contains` on a built string becomes full `str_eq`
# plus an explicit length, and the single-agent picker tests gain a mixed-score
# and a fully-tied roster. The oracle's rosters are always two identical agents,
# so its suite is structurally blind to both the sort direction and the tie rule.
#
# The oracle also leaves three of `infer_provider`'s nine needles completely
# untested (`gemini`, `grok`, `mistral`/`mixtral`) and never exercises
# `strip_provider_prefix`'s case sensitivity or whole-segment matching. Matching
# its test set would not have been sufficient diligence.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
# strcase — `prompt_guard`, `cost_planning` and `definitions/assembler` all
# fold ASCII case; the shared helpers live here (extracted at the third use).
include "src/strcase.cyr"
# telemetry — `tools/native` and `orchestrator/crew_runner` record GenAI
# spans (ADR 017), so every suite that reaches them needs the module that
# defines the recorder. It depends on nothing in `src/` except `id`.
include "src/telemetry/mod.cyr"
include "src/core/error.cyr"
include "src/core/json.cyr"
include "src/core/message.cyr"
include "src/core/resource.cyr"
include "src/core/task.cyr"
include "src/core/agent.cyr"
include "src/core/crew.cyr"
include "src/orchestrator/scheduler.cyr"
include "src/orchestrator/audit.cyr"
include "src/llm/retry.cyr"
include "src/llm/hoosh.cyr"
include "src/llm/router.cyr"
include "src/orchestrator/scoring.cyr"
include "src/orchestrator/output_validation.cyr"
include "src/server/prompt_guard.cyr"
include "src/server/output_filter.cyr"
include "src/chan_lossy.cyr"
include "src/server/sse.cyr"
include "src/server/prometheus.cyr"
# `_agnosai_crew_build_profile` scores the crew's sandbox policy, which the
# oracle does too (`crew_runner.rs:198-214`), so both producers are needed here.
# `_agnosai_crew_build_request` pools an arena for the per-task context tree
# (roadmap B2's tail), so this file needs the pool alongside crew_runner.
include "src/arena_pool.cyr"
include "src/sandbox/policy.cyr"
include "src/sandbox/kavach_bridge.cyr"
include "src/orchestrator/crew_runner.cyr"
include "tests/test_helpers.cyr"

# The oracle's test_agent(key), field for field: name = key, role "tester",
# goal "test things", complexity "medium", and **no tools, no backstory, no
# domain**. The empty tool vec is load-bearing — it is what makes the oracle's
# minimal-prompt test assert `!contains("Available tools")`, and adding a tool
# here would also silently change every scoring result below.
fn _t_agent(key): i64 {
    var a = agnosai_agent_new(str_from(key), str_from("tester"), str_from("test things"));
    agnosai_agent_with_name(a, str_from(key));
    return a;
}

# The same, plus one tool — for the cases that need tool coverage to differ.
fn _t_agent_tooled(key, tool): i64 {
    var a = _t_agent(key);
    var tools = vec_new();
    vec_push(tools, str_from(tool));
    agnosai_agent_with_tools(a, tools);
    return a;
}

# A bare task, the oracle's test_task(desc).
# A two-task sequential spec, fresh each call — `run` mutates task status, so a
# measuring loop needs its own.
fn _t_seq_spec(): i64 {
    var s = agnosai_crew_new(str_from("seq-crew"));
    var ts = vec_new();
    vec_push(ts, agnosai_task_new(str_from("first")));
    vec_push(ts, agnosai_task_new(str_from("second")));
    agnosai_crew_with_tasks(s, ts);
    return s;
}

fn _t_task(desc): i64 {
    return agnosai_task_new(str_from(desc));
}

# ── the stub gateway (ADR 022's seam) ──────────────────────────────────────
# With no gateway listening, `agnosai_execute_task`'s LLM SUCCESS arm is
# unreachable offline, so everything that happens only there — the `token`
# event, the result's `agent` metadata, ADR 020's output filter on model output
# — could be unwired without failing a test. The hoosh client's chat pointer
# lets this suite answer instead of a gateway.

# The body the stub answers with, or 0 for `_t_ok_body()`. A global so one block
# can swap in a leaky answer for the output-filter check.
var _t_stub_body = 0;

# A gateway answer: content "done", 1500 tokens, 450 micro-USD, served by openai.
fn _t_ok_body(): i64 {
    return str_cat(str_cat(
        str_from("{\"model\":\"gpt-4o-mini\",\"choices\":[{\"message\":{\"content\":\"done\"}}],"),
        str_from("\"usage\":{\"prompt_tokens\":1000,\"completion_tokens\":500,\"total_tokens\":1500,")),
      str_from("\"cost_micro_usd\":450,\"provider\":\"openai\"}}"));
}

# The stub chat call — `agnosai_hoosh_chat`'s contract, with no network.
fn _t_stub_chat(client, request, out_response, parent_sc): i64 {
    var body = _t_stub_body;
    if (body == 0) { body = _t_ok_body(); }
    store64(out_response, agnosai_hoosh_response_from_body(body));
    return 0;
}

# The runner whose deadline `_t_stub_chat_expire` moves into the past, or 0.
var _t_expire_runner = 0;

# The stub, plus a deadline that passes MID-RUN — deterministically. Answering a
# task moves the runner's deadline into the past, so the NEXT loop head observes
# it: exactly one task has run when the crew times out, with no clock involved.
fn _t_stub_chat_expire(client, request, out_response, parent_sc): i64 {
    if (_t_expire_runner != 0) { agnosai_crew_runner_set_deadline_ns(_t_expire_runner, 1); }
    return _t_stub_chat(client, request, out_response, parent_sc);
}

# The stub, refusing every task whose request names FAILME — not a retryable error, so
# that task fails at once. One branch of a DAG fails while its sibling succeeds.
fn _t_stub_chat_failme(client, request, out_response, parent_sc): i64 {
    if (str_contains_cstr(agnosai_inference_request_to_json(request), "FAILME") == 1) {
        return str_from("model refused");
    }
    return _t_stub_chat(client, request, out_response, parent_sc);
}

# A client whose chat call is the stub. The URL is a port nothing listens on, so
# a call that bypassed the pointer would fail rather than reach a real gateway.
fn _t_stub_client(): i64 {
    return agnosai_hoosh_client_with_chat(
      agnosai_hoosh_client_new(str_from("http://127.0.0.1:1"), str_from("")), &_t_stub_chat);
}

# A runner over `spec` whose tasks take the LLM success arm through the stub.
fn _t_llm_runner(spec): i64 {
    return agnosai_crew_runner_with_llm(agnosai_crew_runner_new(spec), _t_stub_client());
}

# The bytes one run of `r` allocates. The runner is built before the count
# starts, so only the run is measured — worker threads included, because
# `alloc` is one global bump behind a lock.
fn _t_run_cost(r): i64 {
    var err: i64[1];
    store64(&err, 0);
    var before = alloc_used();
    agnosai_crew_runner_run(r, &err);
    return alloc_used() - before;
}

# ── reading an event stream ────────────────────────────────────────────────

# Every event `sub` holds, in delivery order.
fn _t_drain(sub): i64 {
    var v = vec_new();
    var ev = agnosai_event_sub_try_recv(sub);
    while (ev != 0) {
        vec_push(v, ev);
        ev = agnosai_event_sub_try_recv(sub);
    }
    return v;
}

# Whether event `ev` is of type `t` (a C string).
fn _t_is(ev, t): i64 {
    return str_eq_cstr(agnosai_crew_event_event_type(ev), t);
}

# How many events in `evs` are of type `t`.
fn _t_count(evs, t): i64 {
    var n = 0;
    for (var i = 0; i < vec_len(evs); i = i + 1) {
        if (_t_is(vec_get(evs, i), t) == 1) { n = n + 1; }
    }
    return n;
}

# How many `token` events in `evs` name crew `crew_id`.
fn _t_tokens_for(evs, crew_id): i64 {
    var n = 0;
    for (var i = 0; i < vec_len(evs); i = i + 1) {
        var ev = vec_get(evs, i);
        if (_t_is(ev, "token") == 1 && str_eq(agnosai_crew_event_crew_id(ev), crew_id) == 1) {
            n = n + 1;
        }
    }
    return n;
}

# The first event in `evs` of type `t`, or 0.
fn _t_find(evs, t): i64 {
    for (var i = 0; i < vec_len(evs); i = i + 1) {
        if (_t_is(vec_get(evs, i), t) == 1) { return vec_get(evs, i); }
    }
    return 0;
}

# A string field of an event's data.
fn _t_ev_str(ev, key): i64 {
    return bayan_json_v_str(bayan_json_v_obj_get_by_cstr(agnosai_crew_event_data(ev), key));
}

# An integer field of an event's data.
fn _t_ev_int(ev, key): i64 {
    return bayan_json_v_int(bayan_json_v_obj_get_by_cstr(agnosai_crew_event_data(ev), key));
}

# The index in `evs` of the first event of type `t` for task `task_id`, or -1.
fn _t_index_of(evs, t, task_id): i64 {
    for (var i = 0; i < vec_len(evs); i = i + 1) {
        var ev = vec_get(evs, i);
        if (_t_is(ev, t) == 1 && str_eq(_t_ev_str(ev, "task_id"), task_id) == 1) { return i; }
    }
    return 0 - 1;
}

# The most tasks in flight — started and not yet completed — at any point.
fn _t_max_in_flight(evs): i64 {
    var cur = 0;
    var peak = 0;
    for (var i = 0; i < vec_len(evs); i = i + 1) {
        var ev = vec_get(evs, i);
        if (_t_is(ev, "task_started") == 1) { cur = cur + 1; }
        if (_t_is(ev, "task_completed") == 1) { cur = cur - 1; }
        if (cur > peak) { peak = cur; }
    }
    return peak;
}

# How many events of type `t` in `evs` have NO earlier event of type `before`
# for the same task — 0 when every one is preceded.
fn _t_unpreceded(evs, t, before): i64 {
    var bad = 0;
    for (var i = 0; i < vec_len(evs); i = i + 1) {
        var ev = vec_get(evs, i);
        if (_t_is(ev, t) == 1) {
            var at = _t_index_of(evs, before, _t_ev_str(ev, "task_id"));
            if (at < 0 || at > i) { bad = bad + 1; }
        }
    }
    return bad;
}

# How many `token` events in `evs` come AFTER their task's `task_completed` —
# 0 when every token precedes it.
fn _t_tokens_late(evs): i64 {
    var bad = 0;
    for (var i = 0; i < vec_len(evs); i = i + 1) {
        var ev = vec_get(evs, i);
        if (_t_is(ev, "token") == 1) {
            var done_at = _t_index_of(evs, "task_completed", _t_ev_str(ev, "task_id"));
            if (done_at < i) { bad = bad + 1; }
        }
    }
    return bad;
}

# What `_t_stub_chat_peer` watches: a second subscription on the crew's sender,
# the task whose `task_completed` it waits for, and what came of the wait — 0
# not asked, 1 the event arrived, 2 the wait ran out.
var _t_peer_sub = 0;
var _t_peer_task = 0;
var _t_peer_seen = 0;

# Whether any message of `request` contains `marker` (a C string).
fn _t_request_mentions(request, marker): i64 {
    var msgs = agnosai_inference_request_messages(request);
    for (var i = 0; i < vec_len(msgs); i = i + 1) {
        if (str_contains_cstr(agnosai_chat_message_content(vec_get(msgs, i)), marker) == 1) {
            return 1;
        }
    }
    return 0;
}

# The stub, except that a task whose prompt says "await-peer" first waits for
# `_t_peer_task`'s `task_completed` on `_t_peer_sub` — for at most 5 s, so a
# runner that never sends it fails an assertion instead of hanging the suite.
fn _t_stub_chat_peer(client, request, out_response, parent_sc): i64 {
    if (_t_request_mentions(request, "await-peer") == 1) {
        _t_peer_seen = 2;
        var until = clock_now_ns() + 5000 * AGNOSAI_NS_PER_MS;
        var ev = 0;
        while (clock_now_ns() < until) {
            ev = agnosai_event_sub_try_recv(_t_peer_sub);
            if (ev == 0) {
                sleep_ms(1);
            } elif (_t_is(ev, "task_completed") == 1) {
                if (str_eq(_t_ev_str(ev, "task_id"), _t_peer_task) == 1) {
                    _t_peer_seen = 1;
                    break;
                }
            }
        }
    }
    return _t_stub_chat(client, request, out_response, parent_sc);
}

# A crew of `n` placeholder tasks named `name`, run by `process`.
fn _t_crew(name, n, process): i64 {
    var s = agnosai_crew_new(str_from(name));
    var ts = vec_new();
    for (var i = 0; i < n; i = i + 1) {
        vec_push(ts, agnosai_task_new(str_cat(str_from("t-"), str_from_int(i))));
    }
    agnosai_crew_with_tasks(s, ts);
    agnosai_crew_with_process(s, process);
    return s;
}

# A fresh subscribed sender for crew `spec`; the subscription goes through `out_sub`.
fn _t_watch(spec, out_sub): i64 {
    var tx = agnosai_event_bus_sender(agnosai_event_bus_new(), agnosai_crew_id(spec));
    store64(out_sub, agnosai_event_sender_subscribe(tx));
    return tx;
}

# A vec of up to three agents.
fn _t_roster(a, b, c): i64 {
    var v = vec_new();
    if (a != 0) { vec_push(v, a); }
    if (b != 0) { vec_push(v, b); }
    if (c != 0) { vec_push(v, c); }
    return v;
}

# The agent `agnosai_explain_selection_a` ranks first for `task`, or 0 when it
# explains no candidate — the shape `_agnosai_crew_pick_best_agent` answers in.
fn _t_explained_pick(xa, roster, task): i64 {
    var ex = agnosai_explain_selection_a(xa, roster, task);
    if (vec_len(ex) == 0) { return 0; }
    return vec_get(roster, agnosai_scored_index(vec_get(ex, 0)));
}

# `n` agents "v0".. whose complexity (low, medium, high), domain (quality,
# devops, none, finance) and one tool (every fifth agent) all cycle, so scores
# genuinely differ and the sort does real work.
fn _t_varied_roster(n): i64 {
    var v = vec_new();
    for (var i = 0; i < n; i = i + 1) {
        var key = str_cat(str_from("v"), str_from_int(i));
        var a = agnosai_agent_new(key, str_from("tester"), str_from("test things"));
        agnosai_agent_with_name(a, key);
        if (i % 5 == 0) {
            var tools = vec_new();
            vec_push(tools, str_from("hammer"));
            agnosai_agent_with_tools(a, tools);
        }
        if (i % 3 == 0) { agnosai_agent_with_complexity(a, str_from("low")); }
        if (i % 3 == 2) { agnosai_agent_with_complexity(a, str_from("high")); }
        if (i % 4 == 0) { agnosai_agent_with_domain(a, str_from("quality")); }
        if (i % 4 == 1) { agnosai_agent_with_domain(a, str_from("devops")); }
        if (i % 4 == 3) { agnosai_agent_with_domain(a, str_from("finance")); }
        vec_push(v, a);
    }
    return v;
}

# Assert infer_provider maps a model name to a provider.
fn _t_prov(model, want, name): i64 {
    return assert_eq(_agnosai_crew_infer_provider(str_from(model)), want, name);
}

# Assert strip_provider_prefix's output.
fn _t_strip(model, want, name): i64 {
    return assert(str_eq(_agnosai_crew_strip_provider_prefix(str_from(model)),
        str_from(want)) == 1, name);
}

# Assert select_model's output for an agent whose llm_model is set.
fn _t_model_override(model, want, name): i64 {
    var a = _t_agent("m");
    agnosai_agent_with_llm_model(a, str_from(model));
    return assert(str_eq(_agnosai_crew_select_model(a), str_from(want)) == 1, name);
}

# Assert select_model's output for an agent routed by complexity.
fn _t_model_complexity(complexity, want, name): i64 {
    var a = _t_agent("c");
    agnosai_agent_with_complexity(a, str_from(complexity));
    return assert(str_eq(_agnosai_crew_select_model(a), str_from(want)) == 1, name);
}

fn main() {
    alloc_init();

    test_group("orch_crew_runner");

    # =====================================================================
    # pick_best_agent
    # =====================================================================

    # --- test_pick_best_agent_empty_roster ---
    assert_eq(_agnosai_crew_pick_best_agent(vec_new(), _t_task("anything")), 0,
      "an empty roster picks no agent — 0, and NOT index 0, which is a real agent");

    # --- test_pick_best_agent_returns_some ---
    var solo = _t_agent("a1");
    var picked = _agnosai_crew_pick_best_agent(_t_roster(solo, 0, 0), _t_task("do it"));
    assert(picked != 0, "a one-agent roster picks that agent");
    assert(str_eq(agnosai_agent_key(picked), str_from("a1")) == 1, "by key");
    assert_eq(picked, solo,
      "and it is the same pointer, not a copy — the oracle clones, but nothing mutates an agent \
    definition mid-crew and its own benchmark takes the borrow");

    # --- PORT-ADDED: a mixed roster proves the sort is DESCENDING ---
    # The oracle only ever passes identical agents, so its suite would pass with
    # the comparison inverted.
    var poor = _t_agent("poor");
    agnosai_agent_with_complexity(poor, str_from("high"));
    agnosai_agent_with_domain(poor, str_from("devops"));
    var good = _t_agent_tooled("good", "hammer");
    agnosai_agent_with_domain(good, str_from("quality"));
    var fitted = agnosai_task_new(str_from("review the code"));
    agnosai_task_with_context(fitted, str_from("domain"),
      bayan_json_v_str_new(str_from("quality")));
    var tools_req = bayan_json_v_arr_new();
    bayan_json_v_arr_push(tools_req, bayan_json_v_str_new(str_from("hammer")));
    agnosai_task_with_context(fitted, str_from("required_tools"), tools_req);

    var best_of_two = _agnosai_crew_pick_best_agent(_t_roster(poor, good, 0), fitted);
    assert(str_eq(agnosai_agent_key(best_of_two), str_from("good")) == 1,
      "the better-scoring agent wins even when it is second in the roster — proving the sort is \
    descending, which the oracle's identical-agent rosters cannot show");

    # --- PORT-ADDED: a fully tied roster proves the stable tie rule ---
    var tie_a = _t_agent("agent-a");
    var tie_b = _t_agent("agent-b");
    var tied = _agnosai_crew_pick_best_agent(_t_roster(tie_a, tie_b, 0), _t_task("bare"));
    assert(str_eq(agnosai_agent_key(tied), str_from("agent-a")) == 1,
      "a tie goes to the earlier roster entry — Rust's sort_by is stable, and this is the property \
    the oracle's suite is structurally blind to");

    # --- F7: an explanation's winner IS the runner's pick ---
    # agnostic's plan route recomputes the explanation from the crew spec rather
    # than recording it at run time, which is exact only while this holds. Same
    # pointer, not just the same key: every fixture above, plus a varied roster
    # past _vec_introsort's 16-element threshold.
    var xa = arena_allocator(65536);
    assert_eq(_t_explained_pick(xa, _t_roster(solo, 0, 0), _t_task("do it")), solo,
      "a one-agent roster explains the agent the runner picks");
    assert_eq(_t_explained_pick(xa, _t_roster(poor, good, 0), fitted), best_of_two,
      "a mixed roster explains the runner's pick, the second agent");
    assert_eq(_t_explained_pick(xa, _t_roster(tie_a, tie_b, 0), _t_task("bare")), tied,
      "a tie explains the runner's pick, the first agent");
    var varied = _t_varied_roster(20);
    var varied_task = agnosai_task_new(str_from("ship the release"));
    agnosai_task_with_context(varied_task, str_from("complexity"),
      bayan_json_v_str_new(str_from("high")));
    agnosai_task_with_context(varied_task, str_from("domain"),
      bayan_json_v_str_new(str_from("devops")));
    agnosai_task_with_context(varied_task, str_from("required_tools"), tools_req);
    var varied_pick = _agnosai_crew_pick_best_agent(varied, varied_task);
    assert_eq(_t_explained_pick(xa, varied, varied_task), varied_pick,
      "twenty varied agents explain the runner's pick");
    assert(str_eq(agnosai_agent_key(varied_pick), str_from("v5")) == 1,
      "which is the first agent that is high, in devops and tooled — a winner the roster \
    order alone would not give");
    var empty_ex = agnosai_explain_selection_a(xa, vec_new(), fitted);
    assert_eq(vec_len(empty_ex), 0, "an empty roster explains as no candidates");
    assert_eq(_agnosai_crew_pick_best_agent(vec_new(), fitted), 0,
      "matching the runner, which picks no agent");

    # =====================================================================
    # infer_provider — the default is OLLAMA, not OPENAI
    # =====================================================================

    # --- test_infer_provider_openai ---
    _t_prov("gpt-4o", AGNOSAI_PROVIDER_OPENAI, "gpt-4o is OpenAI");
    _t_prov("gpt-4o-mini", AGNOSAI_PROVIDER_OPENAI, "and gpt-4o-mini");
    _t_prov("o1", AGNOSAI_PROVIDER_OPENAI, "a bare o1 is OpenAI — the needle has no hyphen");
    _t_prov("o3-mini", AGNOSAI_PROVIDER_OPENAI, "and o3-mini");

    # --- test_infer_provider_anthropic ---
    _t_prov("claude-sonnet-4", AGNOSAI_PROVIDER_ANTHROPIC, "claude-sonnet-4 is Anthropic");
    _t_prov("claude-sonnet-4-20250514", AGNOSAI_PROVIDER_ANTHROPIC,
      "and a dated variant — it is a prefix test, not a model table");
    _t_prov("claude-opus-4", AGNOSAI_PROVIDER_ANTHROPIC, "and claude-opus-4");

    # --- test_infer_provider_deepseek ---
    _t_prov("deepseek-chat", AGNOSAI_PROVIDER_DEEPSEEK, "deepseek-chat is DeepSeek");
    _t_prov("deepseek-coder", AGNOSAI_PROVIDER_DEEPSEEK, "and deepseek-coder");

    # --- test_infer_provider_local_models ---
    _t_prov("llama3", AGNOSAI_PROVIDER_OLLAMA, "llama3 falls through to Ollama");
    _t_prov("llama3:70b", AGNOSAI_PROVIDER_OLLAMA, "and llama3:70b");
    _t_prov("phi3", AGNOSAI_PROVIDER_OLLAMA, "and phi3");
    _t_prov("unknown-model", AGNOSAI_PROVIDER_OLLAMA,
      "and anything unrecognised — this is the assertion standing between the port and a bare \
    `return 0`, which would silently mean OpenAI");

    # --- test_infer_provider_case_insensitive ---
    _t_prov("GPT-4o", AGNOSAI_PROVIDER_OPENAI, "matching ignores case");
    _t_prov("Claude-Opus-4", AGNOSAI_PROVIDER_ANTHROPIC, "for the Anthropic arm too");
    _t_prov("DEEPSEEK-CHAT", AGNOSAI_PROVIDER_DEEPSEEK, "and DeepSeek");

    # --- PORT-ADDED: the three arms the oracle never tests ---
    _t_prov("gemini-1.5-pro", AGNOSAI_PROVIDER_GOOGLE, "gemini is Google — untested upstream");
    _t_prov("grok-2", AGNOSAI_PROVIDER_GROK, "grok is Grok — untested upstream");
    _t_prov("mistral-large-latest", AGNOSAI_PROVIDER_MISTRAL, "mistral is Mistral");
    _t_prov("mixtral-8x7b", AGNOSAI_PROVIDER_MISTRAL,
      "and so is mixtral — one letter from mistral, so a transcription slip reads as correct at a \
    glance and would send Mixtral traffic to the free Ollama arm");
    _t_prov("GEMINI-1.5-PRO", AGNOSAI_PROVIDER_GOOGLE, "the untested arms fold case as well");
    _t_prov("MIXTRAL-8X7B", AGNOSAI_PROVIDER_MISTRAL, "including mixtral");

    # --- PORT-ADDED: the anchoring and boundary guards ---
    _t_prov("", AGNOSAI_PROVIDER_OLLAMA, "an empty model name is Ollama, and does not fault");
    _t_prov("gpt4", AGNOSAI_PROVIDER_OLLAMA, "gpt4 without the hyphen misses the needle");
    _t_prov("gpt", AGNOSAI_PROVIDER_OLLAMA, "and a bare gpt");
    _t_prov("o4-mini", AGNOSAI_PROVIDER_OLLAMA, "o4 is not o1 or o3 — there is no generalisation");
    _t_prov("groq", AGNOSAI_PROVIDER_OLLAMA,
      "groq is not grok — q is not k, and the oracle's provider enum has no Groq variant at all");
    _t_prov("openai/gpt-4o", AGNOSAI_PROVIDER_OLLAMA,
      "a prefixed id is Ollama — the match is anchored at position 0, with no substring fallback");
    _t_prov("anthropic/claude-3", AGNOSAI_PROVIDER_OLLAMA, "for Anthropic too");
    _t_prov(" gpt-4o", AGNOSAI_PROVIDER_OLLAMA, "a leading space defeats it — nothing is trimmed");
    _t_prov("gpt-4o ", AGNOSAI_PROVIDER_OPENAI, "but a trailing space does not");

    # the caller's Str is untouched: the fold works on a copy
    var orig = str_from("GPT-4o");
    _agnosai_crew_infer_provider(orig);
    assert(str_eq(orig, str_from("GPT-4o")) == 1,
      "the caller's model string is unchanged — the lowercase fold allocates rather than mutating");

    # =====================================================================
    # build_system_prompt — full equality, never `contains`
    # =====================================================================

    # --- test_build_system_prompt_no_agent ---
    var generic = _agnosai_crew_build_system_prompt(0);
    assert(str_eq(generic,
        str_from("You are a helpful AI assistant executing tasks within a crew.")) == 1,
      "no agent yields the generic prompt, byte for byte");
    assert_eq(str_len(generic), 61, "which is 61 bytes");

    # --- test_build_system_prompt_minimal_agent ---
    # The oracle asserts three `contains` negatives and one positive. Full
    # equality catches what they cannot: a stray separator.
    var minimal = _t_agent("min");
    var min_prompt = _agnosai_crew_build_system_prompt(minimal);
    assert(str_eq(min_prompt, str_from("You are min, a tester.\n\nGoal: test things")) == 1,
      "a minimal agent renders name, role and goal — and nothing else");
    assert_eq(str_len(min_prompt), 41, "which is 41 bytes");
    assert(str_contains(min_prompt, str_from("Backstory")) == 0, "no backstory section");
    assert(str_contains(min_prompt, str_from("Domain")) == 0, "no domain section");
    assert(str_contains(min_prompt, str_from("Available tools")) == 0,
      "and no tools section — the oracle's fixture has an EMPTY tool vec, which is the one field \
    gated on emptiness rather than presence");

    # --- test_build_system_prompt_full_agent ---
    var full = agnosai_agent_new(str_from("qa"), str_from("quality assurance"),
      str_from("ensure zero defects"));
    agnosai_agent_with_name(full, str_from("QA Lead"));
    agnosai_agent_with_backstory(full, str_from("10 years in QA"));
    agnosai_agent_with_domain(full, str_from("testing"));
    var qa_tools = vec_new();
    vec_push(qa_tools, str_from("selenium"));
    vec_push(qa_tools, str_from("pytest"));
    agnosai_agent_with_tools(full, qa_tools);

    var full_prompt = _agnosai_crew_build_system_prompt(full);
    assert(str_eq(full_prompt, str_cat(
          str_from("You are QA Lead, a quality assurance.\n\nGoal: ensure zero defects"),
          str_cat(str_from("\n\nBackstory: 10 years in QA\n\nDomain expertise: testing"),
            str_from("\n\nAvailable tools: selenium, pytest")))) == 1,
      "every section renders in the oracle's order, separated by \\n\\n, with tools joined by ', ' \
    — the oracle's only format assertion is a `contains` on the join separator");
    assert_eq(str_len(full_prompt), 153, "at the oracle's exact byte length");

    # --- PORT-ADDED: presence, not emptiness, gates each section ---
    # `if let Some(ref backstory)` fires for Some(""), so an explicitly empty
    # backstory emits the header with nothing after it.
    var empty_fields = _t_agent("e");
    agnosai_agent_with_backstory(empty_fields, str_from(""));
    agnosai_agent_with_domain(empty_fields, str_from(""));
    var ef_prompt = _agnosai_crew_build_system_prompt(empty_fields);
    assert(str_eq(ef_prompt, str_cat(str_from("You are e, a tester.\n\nGoal: test things"),
          str_from("\n\nBackstory: \n\nDomain expertise: "))) == 1,
      "an explicitly EMPTY backstory or domain still emits its header — the gate is presence, not \
    non-emptiness, so Some(\"\") and None are different answers");

    # tools, by contrast, gate on non-empty — the oracle uses !is_empty()
    var no_tools = _t_agent("n");
    assert(str_eq(_agnosai_crew_build_system_prompt(no_tools),
        str_from("You are n, a tester.\n\nGoal: test things")) == 1,
      "an EMPTY tool vec emits no tools section at all — the one field gated on emptiness rather \
    than presence");

    # a single empty tool string is a non-empty vec, so the section IS emitted
    var blank_tool = _t_agent_tooled("b", "");
    assert(str_eq(_agnosai_crew_build_system_prompt(blank_tool),
        str_from("You are b, a tester.\n\nGoal: test things\n\nAvailable tools: ")) == 1,
      "but a vec holding one empty string is non-empty, so the header ships with nothing after it");

    # one tool means no trailing separator
    var one_tool = _t_agent_tooled("o", "hammer");
    assert(str_contains(_agnosai_crew_build_system_prompt(one_tool), str_from("hammer, ")) == 0,
      "a single tool leaves no trailing ', '");

    # the article is not agreed with the role, and that is the oracle's output
    var vowel = agnosai_agent_new(str_from("v"), str_from("engineer"), str_from("g"));
    agnosai_agent_with_name(vowel, str_from("v"));
    # (built directly rather than via _t_agent, since the role differs)
    assert(str_contains(_agnosai_crew_build_system_prompt(vowel),
        str_from("You are v, a engineer.")) == 1,
      "\"a engineer\", not \"an engineer\" — pinned so nobody corrects the grammar and diverges");

    # =====================================================================
    # strip_provider_prefix
    # =====================================================================

    # --- test_strip_provider_prefix_preserves_unknown ---
    _t_strip("custom/model", "custom/model", "an unknown segment is left alone");
    _t_strip("llama3:70b", "llama3:70b", "and a model with no slash at all");

    # every one of the twelve known segments strips
    _t_strip("ollama/llama3", "llama3", "ollama/ strips");
    _t_strip("openai/gpt-4o", "gpt-4o", "openai/ strips");
    _t_strip("anthropic/claude-3", "claude-3", "anthropic/ strips");
    _t_strip("groq/mixtral", "mixtral", "groq/ strips");
    _t_strip("deepseek/chat", "chat", "deepseek/ strips");
    _t_strip("mistral/large", "large", "mistral/ strips");
    _t_strip("together/x", "x", "together/ strips");
    _t_strip("fireworks/x", "x", "fireworks/ strips");
    _t_strip("anyscale/x", "x", "anyscale/ strips");
    _t_strip("perplexity/x", "x", "perplexity/ strips");
    _t_strip("bedrock/x", "x", "bedrock/ strips");
    _t_strip("azure/x", "x", "azure/ strips");

    # --- PORT-ADDED: the boundary and case cases the oracle never touches ---
    var empty_model = _agnosai_crew_strip_provider_prefix(str_from(""));
    assert_eq(str_len(empty_model), 0, "an empty model yields an empty result");
    assert(empty_model != 0, "as a valid zero-length Str rather than 0");

    _t_strip("/model", "/model",
      "a leading slash is an EMPTY segment, which matches nothing — index 0 is a real hit, so the \
    guard has to be `idx < 0` and not `idx <= 0`");
    _t_strip("/", "/", "and a bare slash");

    var bare_prefix = _agnosai_crew_strip_provider_prefix(str_from("ollama/"));
    assert_eq(str_len(bare_prefix), 0,
      "`ollama/` yields the EMPTY remainder — the oracle ships it as-is, with no validation and no \
    fallback to the default model");

    _t_strip("ollama/openai/gpt-4o", "openai/gpt-4o",
      "only ONE level is stripped — a while loop here would be wrong and no oracle test catches it");
    _t_strip("anthropic/models/claude-3", "models/claude-3", "the remainder keeps its own slashes");

    _t_strip("Ollama/llama3", "Ollama/llama3",
      "matching is case-SENSITIVE — reusing the ASCII-case-insensitive helper would break this");
    _t_strip("OPENAI/gpt-4o", "OPENAI/gpt-4o", "for openai too");

    _t_strip("open_ai/foo", "open_ai/foo",
      "the WIRE spelling open_ai is not a strippable segment — the two vocabularies differ");
    _t_strip("deep_seek/foo", "deep_seek/foo",
      "and neither is deep_seek, though `deepseek/` above does strip");

    _t_strip("openai-custom/foo", "openai-custom/foo",
      "matching is whole-segment — a str_starts_with(\"openai\") reformulation would break this");
    _t_strip("ollama", "ollama", "a bare segment name with no slash is untouched");
    _t_strip("ollama-custom:7b", "ollama-custom:7b", "and a model that merely begins with one");

    _t_strip(" ollama/x", " ollama/x", "nothing is trimmed on the left");
    _t_strip("ollama/ x", " x", "nor on the right of the slash");

    _t_strip("google/gemini-pro", "google/gemini-pro",
      "google is a provider but NOT a strippable prefix — the twelve-name list is deliberately \
    narrower than the enum, so do not complete it from agnosai_provider_to_wire");
    _t_strip("grok/grok-2", "grok/grok-2", "and neither is grok");
    _t_strip("cohere/command-r", "cohere/command-r", "nor cohere");
    _t_strip("vertex_ai/x", "vertex_ai/x", "nor vertex_ai");

    # =====================================================================
    # select_model
    # =====================================================================

    # --- test_select_model_no_agent ---
    assert(str_eq(_agnosai_crew_select_model(0),
        agnosai_default_model(AGNOSAI_TIER_CAPABLE)) == 1,
      "no agent uses the Capable tier default");
    assert(str_eq(_agnosai_crew_select_model(0), str_from("llama3:70b")) == 1,
      "which is llama3:70b");

    # --- test_select_model_agent_override ---
    _t_model_override("gpt-4o", "gpt-4o", "an agent's llm_model overrides the routing");

    # --- test_select_model_strips_provider_prefix ---
    _t_model_override("ollama/llama3.2:1b", "llama3.2:1b",
      "and the override runs THROUGH the strip, not around it");
    _t_model_override("openai/gpt-4o", "gpt-4o", "for openai/");
    _t_model_override("anthropic/claude-sonnet-4-20250514", "claude-sonnet-4-20250514",
      "and anthropic/ — this is the case that catches a strip list built from the wire spellings");

    # --- test_select_model_routes_by_complexity ---
    _t_model_complexity("low", "llama3:70b",
      "low complexity routes to CAPABLE, not Fast — Simple + Reason never reaches the fast tier, \
    so a direct complexity-to-model table would write llama3 here and pass every other test");
    _t_model_complexity("high", "llama3:405b", "high complexity routes to Premium");

    # --- PORT-ADDED: the complexity spellings the oracle skips ---
    _t_model_complexity("medium", "llama3:70b", "medium routes to Capable");
    _t_model_complexity("MEDIUM", "llama3:70b", "case-insensitively");
    _t_model_complexity("simple", "llama3:70b", "simple is Simple, which still routes Capable");
    _t_model_complexity("complex", "llama3:405b", "complex is Complex, which routes Premium");
    _t_model_complexity("HIGH", "llama3:405b", "and HIGH");
    _t_model_complexity("CoMpLeX", "llama3:405b", "and mixed case");
    _t_model_complexity("", "llama3:70b", "an empty complexity falls back to Medium");
    _t_model_complexity("unknown", "llama3:70b", "as does an unrecognised spelling");
    _t_model_complexity("lowe", "llama3:70b",
      "and a near-miss — parse_complexity compares whole strings, not prefixes");

    # the Fast tier's model is unreachable from select_model at all
    assert(str_eq(agnosai_default_model(AGNOSAI_TIER_FAST), str_from("llama3")) == 1,
      "the Fast tier's model is llama3 — recorded here because select_model can never return it: \
    every complexity level routes Reason to Capable or Premium");

    # --- PORT-ADDED: precedence proven on visibly different answers ---
    var high_override = _t_agent("h");
    agnosai_agent_with_complexity(high_override, str_from("high"));
    agnosai_agent_with_llm_model(high_override, str_from("gpt-4o"));
    assert(str_eq(_agnosai_crew_select_model(high_override), str_from("gpt-4o")) == 1,
      "an override beats a HIGH-complexity route — the oracle's medium fixture makes its own \
    precedence evidence weaker than it looks, since both arms could agree");

    # --- PORT-ADDED: an explicitly empty override survives ---
    var blank_override = _t_agent("z");
    agnosai_agent_with_llm_model(blank_override, str_from(""));
    var blank_model = _agnosai_crew_select_model(blank_override);
    assert_eq(str_len(blank_model), 0,
      "an llm_model of \"\" yields \"\", NOT the routed default — the presence test is `!= 0`, and \
    `if (m != 0 && str_len(m) > 0)` is the likeliest silent divergence in this function");

    # an agent with no llm_model set is genuinely absent, not empty
    var routed = _t_agent("r");
    assert_eq(agnosai_agent_llm_model(routed), 0, "an unset llm_model is 0");
    assert(str_eq(_agnosai_crew_select_model(routed), str_from("llama3:70b")) == 1,
      "so it routes by complexity instead");

    # =====================================================================
    # execute_task (bite 15)
    # =====================================================================

    # --- test_execute_task_placeholder_when_no_llm ---
    # client == 0 is the oracle's `llm: None`.
    var ph_task = agnosai_task_new(str_from("summarize the document"));
    var ph = agnosai_execute_task(ph_task, 0, 0, 0);
    assert(ph != 0, "the placeholder path returns a result");
    assert_eq(agnosai_task_result_status(ph), AGNOSAI_STATUS_COMPLETED, "marked completed");
    assert(str_eq(agnosai_task_result_output(ph), str_from("summarize the document")) == 1,
      "with the task description echoed VERBATIM as the output — not a message about it");
    assert(str_eq(agnosai_task_result_task_id(ph), agnosai_task_id(ph_task)) == 1,
      "carrying the task's own id");

    # --- test_execute_task_placeholder_has_duration ---
    var ph_md = agnosai_task_result_metadata(ph);
    assert(map_get(ph_md, str_from("task_duration_ms")) != 0,
      "the placeholder still reports a duration");
    assert_eq(map_size(ph_md), 1,
      "and NOTHING else — no model, no provider, no cost, because none were involved");

    # a placeholder with an agent behaves identically: the agent only shapes the
    # prompt, which the placeholder path never builds
    var ph_agent = agnosai_execute_task(ph_task, _t_agent("a1"), 0, 0);
    assert(str_eq(agnosai_task_result_output(ph_agent), str_from("summarize the document")) == 1,
      "an agent does not change the placeholder output");

    # --- the request the LLM path would send ---
    # Built directly, since driving a real inference needs a gateway.
    var rq_task = agnosai_task_new(str_from("write the report"));
    var rq = _agnosai_crew_build_request(rq_task, 0, str_from("llama3:70b"), 0);
    var msgs = agnosai_inference_request_messages(rq);
    assert_eq(vec_len(msgs), 2,
      "a context-free task sends exactly two turns: system, then user");
    assert_eq(agnosai_chat_message_role(vec_get(msgs, 0)), AGNOSAI_ROLE_SYSTEM,
      "the system prompt is folded into messages[0] — the port's request has no separate `system` \
    field, so execute_task does the merge the Rust hoosh client used to do at the wire");
    assert(str_contains(agnosai_chat_message_content(vec_get(msgs, 0)),
        str_from("<system_instructions>")) == 1, "and it is the guarded wrapper, not the raw prompt");
    assert_eq(agnosai_chat_message_role(vec_get(msgs, 1)), AGNOSAI_ROLE_USER, "then the user turn");
    assert(str_contains(agnosai_chat_message_content(vec_get(msgs, 1)),
        str_from("<user_input field=\"task_description\">")) == 1,
      "sanitized — every user-supplied field is wrapped before it reaches the model");

    assert_eq(agnosai_inference_request_max_tokens(rq), 4096, "max_tokens is the oracle's 4096");
    assert_eq(agnosai_inference_request_temperature_milli(rq), 700,
      "and the temperature is the oracle's flat 0.7 — the personality adjustment needs bhava, which \
    is deferred, so that arm is unreachable rather than skipped");

    # --- a task WITH context gains the preamble pair ---
    var ctx_task = agnosai_task_new(str_from("continue"));
    agnosai_task_with_context(ctx_task, str_from("prior"),
      bayan_json_v_str_new(str_from("step one done")));
    var ctx_rq = _agnosai_crew_build_request(ctx_task, 0, str_from("m"), 0);
    var ctx_msgs = agnosai_inference_request_messages(ctx_rq);
    assert_eq(vec_len(ctx_msgs), 4,
      "a task with context sends FOUR turns — system, the context as a user turn, a canned \
    assistant acknowledgement, then the real user turn");
    assert_eq(agnosai_chat_message_role(vec_get(ctx_msgs, 2)), AGNOSAI_ROLE_ASSISTANT,
      "the third is the assistant acknowledgement");
    assert(str_eq(agnosai_chat_message_content(vec_get(ctx_msgs, 2)),
        str_from("Understood, I have the context.")) == 1, "with the oracle's exact wording");
    assert(str_contains(agnosai_chat_message_content(vec_get(ctx_msgs, 1)),
        str_from("<user_input field=\"context\">")) == 1,
      "and the context itself is sanitized too — it can carry upstream task output");

    # --- expected_output is appended to the user turn ---
    var eo_task = agnosai_task_new(str_from("do it"));
    agnosai_task_with_expected_output(eo_task, str_from("a markdown table"));
    var eo_msg = _agnosai_crew_user_message(eo_task);
    assert(str_contains(eo_msg, str_from("<user_input field=\"task_description\">")) == 1,
      "the description is present");
    assert(str_contains(eo_msg, str_from("<user_input field=\"expected_output\">")) == 1,
      "and the expected output, separately sanitized under its own field name");
    assert(str_contains(eo_msg, str_from("</user_input>\n\n<user_input")) == 1,
      "joined by a blank line");

    # --- a retry request rebuilds from the ORIGINAL prompt ---
    # The oracle rebuilds rather than accumulating, so a second retry's prompt is
    # not the first retry's prompt plus more. Passing the retry text explicitly
    # is what makes that structural rather than a discipline the caller must keep.
    var rt = _agnosai_crew_build_request(rq_task, 0, str_from("m"), str_from("RETRY PROMPT"));
    var rt_msgs = agnosai_inference_request_messages(rt);
    assert(str_eq(agnosai_chat_message_content(vec_get(rt_msgs, vec_len(rt_msgs) - 1)),
        str_from("RETRY PROMPT")) == 1,
      "the retry prompt REPLACES the user turn rather than being appended, which is what stops the \
    prompt growing exponentially across validation retries");

    # --- the STANDALONE crew id for events comes from the task context ---
    # `agnosai_execute_task` outside a runner has no spec, so it keeps the
    # oracle's fallback. A runner passes its spec id instead — ADR 022, below.
    assert(str_eq(_agnosai_crew_event_crew_id(rq_task), str_from("unknown")) == 1,
      "a STANDALONE task with no crew_id in its context emits under the literal \"unknown\" — the \
    oracle's fallback, kept for a call outside a runner; a runner passes its spec id instead");
    var stamped = agnosai_task_new(str_from("t"));
    agnosai_task_with_context(stamped, str_from("crew_id"),
      bayan_json_v_str_new(str_from("crew-7")));
    assert(str_eq(_agnosai_crew_event_crew_id(stamped), str_from("crew-7")) == 1,
      "a stamped task uses its own crew id");

    # --- the token event's crew id: a GIVEN id wins (ADR 022) ---
    var tk_bus = agnosai_event_bus_new();
    var tk_tx = agnosai_event_bus_sender(tk_bus, str_from("tk"));
    var tk_sub = agnosai_event_sender_subscribe(tk_tx);
    _agnosai_crew_emit_token(tk_tx, stamped, str_from("spec-9"), str_from("out"));
    var tk_ev = agnosai_event_sub_try_recv(tk_sub);
    assert(tk_ev != 0, "a token event is sent");
    assert(str_eq(agnosai_crew_event_crew_id(tk_ev), str_from("spec-9")) == 1,
      "a runner-supplied crew id WINS over the task context's crew_id — the event goes out on \
    that crew's channel, and the context is client-supplied data that could name any crew");
    _agnosai_crew_emit_token(tk_tx, stamped, 0, str_from("out"));
    assert(str_eq(agnosai_crew_event_crew_id(agnosai_event_sub_try_recv(tk_sub)),
        str_from("crew-7")) == 1, "with no crew id, the stamped context's id is used");
    _agnosai_crew_emit_token(tk_tx, rq_task, 0, str_from("out"));
    assert(str_eq(agnosai_crew_event_crew_id(agnosai_event_sub_try_recv(tk_sub)),
        str_from("unknown")) == 1, "and with neither, the oracle's \"unknown\"");
    assert_eq(_agnosai_crew_emit_token(0, rq_task, str_from("spec-9"), str_from("out")), 0,
      "no sender is a no-op");

    # The entry point a runner uses: `agnosai_execute_task_in_crew` carries the
    # given crew id onto the token of an LLM-answered task, over the context's.
    var ic_res = agnosai_execute_task_in_crew(stamped, 0, _t_stub_client(), tk_tx,
      str_from("spec-9"), 0);
    assert_eq(agnosai_task_result_status(ic_res), AGNOSAI_STATUS_COMPLETED,
      "execute_task_in_crew answers through the stub");
    var ic_ev = agnosai_event_sub_try_recv(tk_sub);
    assert(ic_ev != 0 && str_eq_cstr(agnosai_crew_event_crew_id(ic_ev), "spec-9") == 1,
      "and its token names the crew it was given, not the context's \"crew-7\"");
    agnosai_execute_task(stamped, 0, _t_stub_client(), tk_tx);
    var sa_ev = agnosai_event_sub_try_recv(tk_sub);
    assert(sa_ev != 0 && str_eq_cstr(agnosai_crew_event_crew_id(sa_ev), "crew-7") == 1,
      "while plain execute_task, outside a crew, keeps the oracle's context fallback");

    # A parent span context changes nothing about the RESULT (ADR 023): it only
    # parents spans, and with telemetry off — this suite's state — not even that.
    var tp_parent = agnosai_otlp_span_context_parse(
      str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01"));
    var tr_task = agnosai_task_new(str_from("placeholder under a trace"));
    var ph_plain = agnosai_execute_task(tr_task, 0, 0, 0);
    var ph_traced = agnosai_execute_task_in_crew(tr_task, 0, 0, 0, 0, tp_parent);
    assert(str_eq(agnosai_task_result_output(ph_traced), agnosai_task_result_output(ph_plain)) == 1,
      "a traced placeholder answers the same output as execute_task");
    assert_eq(agnosai_task_result_status(ph_traced), agnosai_task_result_status(ph_plain),
      "and the same status");

    # --- the agent label ---
    assert(str_eq(_agnosai_crew_agent_label(0), str_from("unassigned")) == 1,
      "no agent logs as \"unassigned\"");
    assert(str_eq(_agnosai_crew_agent_label(_t_agent("worker")), str_from("worker")) == 1,
      "and an agent by its key");

    # --- the error result ---
    var er = _agnosai_crew_error_result(rq_task, str_from("connection refused"), clock_now_ns());
    assert_eq(agnosai_task_result_status(er), AGNOSAI_STATUS_FAILED, "a failed inference FAILS");
    assert(str_eq(agnosai_task_result_output(er),
        str_from("LLM error: connection refused")) == 1, "with the oracle's exact output prefix");
    var er_md = agnosai_task_result_metadata(er);
    assert_eq(map_size(er_md), 2, "and exactly two metadata keys");
    assert(map_get(er_md, str_from("error")) != 0, "the error");
    assert(map_get(er_md, str_from("task_duration_ms")) != 0, "and the duration");

    # --- success metadata, including the cost decision ---
    var ok_body = str_cat(str_cat(
        str_from("{\"model\":\"gpt-4o-mini\",\"choices\":[{\"message\":{\"content\":\"done\"}}],"),
        str_from("\"usage\":{\"prompt_tokens\":1000,\"completion_tokens\":500,\"total_tokens\":1500,")),
      str_from("\"cost_micro_usd\":450,\"provider\":\"openai\"}}"));
    var ok_resp = agnosai_hoosh_response_from_body(ok_body);
    var ok_r = agnosai_task_result_new(agnosai_task_id(rq_task), str_from("done"),
      AGNOSAI_STATUS_COMPLETED);
    _agnosai_crew_success_metadata(ok_r, ok_resp, clock_now_ns(), 0);
    var ok_md = agnosai_task_result_metadata(ok_r);
    assert_eq(map_get(ok_md, str_from("agent")), 0,
      "an UNASSIGNED task's success metadata carries no agent key");
    assert(map_get(ok_md, str_from("model")) != 0, "success metadata carries the model");
    assert(map_get(ok_md, str_from("tokens")) != 0, "the token breakdown");
    assert(map_get(ok_md, str_from("task_duration_ms")) != 0, "the duration");
    assert(map_get(ok_md, str_from("cost_micro_usd")) != 0,
      "and cost_micro_usd — NOT the oracle's cost_usd, because the value is integer micro-USD and \
    emitting it under the old key would multiply every consumer's dashboard by 1e6");
    assert_eq(map_get(ok_md, str_from("cost_usd")), 0, "the old f64 key is gone");
    assert(str_eq(bayan_json_v_str(map_get(ok_md, str_from("provider"))),
        str_from("openai")) == 1, "the provider is hoosh's real serving route");

    # a pre-2.6.0 gateway reports no cost, and the key is OMITTED rather than
    # defaulted to zero — zero is a real cost for a local model
    var old_body = str_cat(
      str_from("{\"model\":\"llama3\",\"choices\":[{\"message\":{\"content\":\"d\"}}],"),
      str_from("\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1}}"));
    var old_r = agnosai_task_result_new(agnosai_task_id(rq_task), str_from("d"),
      AGNOSAI_STATUS_COMPLETED);
    _agnosai_crew_success_metadata(old_r, agnosai_hoosh_response_from_body(old_body),
      clock_now_ns(), 0);
    assert_eq(map_get(agnosai_task_result_metadata(old_r), str_from("cost_micro_usd")), 0,
      "an older gateway's response OMITS cost_micro_usd rather than publishing a fabricated 0 — a \
    real 0 means a free local inference, and the two must stay distinguishable");
    assert(str_eq(bayan_json_v_str(map_get(agnosai_task_result_metadata(old_r),
            str_from("provider"))), str_from("ollama")) == 1,
      "and the provider falls back to the model-name inference, which is what the oracle did");

    # --- an ASSIGNED task's success metadata names its agent (ADR 022) ---
    # The oracle's profile aggregates `agent_cost_usd` from `metadata["agent"]`
    # and its success arm never wrote the key, so the map was always empty.
    var ag_r = agnosai_task_result_new(agnosai_task_id(rq_task), str_from("done"),
      AGNOSAI_STATUS_COMPLETED);
    _agnosai_crew_success_metadata(ag_r, ok_resp, clock_now_ns(), _t_agent("writer"));
    var ag_v = map_get(agnosai_task_result_metadata(ag_r), str_from("agent"));
    assert(ag_v != 0 && bayan_json_v_is_str(ag_v) == 1,
      "an assigned task's success metadata carries `agent`, as a string");
    assert(ag_v != 0 && str_eq(bayan_json_v_str(ag_v), str_from("writer")) == 1,
      "the agent's KEY");

    # The profile SUMS per agent, over results built by hand: two tasks by one
    # agent, 450 micro-USD each. The oracle's `+=` gives 900; a replacing
    # recorder gives 450.
    var bp_results = vec_new();
    for (var bpi = 0; bpi < 2; bpi = bpi + 1) {
        var bp_r = agnosai_task_result_new(agnosai_uuid_v4_str(), str_from("x"),
          AGNOSAI_STATUS_COMPLETED);
        agnosai_task_result_with_metadata(bp_r, str_from("cost_micro_usd"),
          bayan_json_v_int_new(450));
        agnosai_task_result_with_metadata(bp_r, str_from("agent"),
          bayan_json_v_str_new(str_from("a1")));
        vec_push(bp_results, bp_r);
    }
    var bp_prof = _agnosai_crew_build_profile(agnosai_crew_runner_new(_t_seq_spec()),
      bp_results, 1);
    assert_eq(map_get(agnosai_crew_profile_agent_cost(bp_prof), str_from("a1")), 900,
      "build_profile charges an agent for ALL its tasks — 900, not the last task's 450");
    assert_eq(agnosai_crew_profile_cost_micro_usd(bp_prof), 900, "and the crew total is 900");

    # --- the LLM SUCCESS arm, end to end, through the stub gateway ---
    # Unreachable offline before ADR 022's chat pointer: every assertion above
    # builds the success metadata by hand, and none drives `agnosai_execute_task`
    # down the arm a real gateway answer takes.
    var llm_task = agnosai_task_new(str_from("answer me"));
    var llm_res = agnosai_execute_task(llm_task, 0, _t_stub_client(), 0);
    assert_eq(agnosai_task_result_status(llm_res), AGNOSAI_STATUS_COMPLETED,
      "a task answered by the stub gateway COMPLETES — the success arm is reachable offline");
    assert(str_eq(agnosai_task_result_output(llm_res), str_from("done")) == 1,
      "with the gateway's content as its output, not the task description");
    var llm_cost = map_get(agnosai_task_result_metadata(llm_res), str_from("cost_micro_usd"));
    assert(llm_cost != 0 && bayan_json_v_int(llm_cost) == 450,
      "and the gateway's cost on its metadata, so the call went through the client's pointer");

    # ADR 020's filter on MODEL output — the half tests/orch_crew_runner.tcyr's
    # output-filter block below used to admit no offline test could reach.
    _t_stub_body = str_cat(str_cat(
        str_from("{\"model\":\"m\",\"choices\":[{\"message\":{\"content\":"),
        str_from("\"the key is sk-ABCDEFGHIJKLMNOPQRST0123\"}}],")),
      str_from("\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}"));
    agnosai_output_redact_set_enabled(1);
    var leak_res = agnosai_execute_task(agnosai_task_new(str_from("leak it")), 0,
      _t_stub_client(), 0);
    agnosai_output_redact_set_enabled(0);
    _t_stub_body = 0;
    assert(agnosai_str_contains_ci_cstr(agnosai_task_result_output(leak_res),
        "sk-ABCDEFGHIJKLMNOPQRST0123") == 0,
      "with redaction on, a key in the MODEL's answer is redacted on the LLM arm too");
    assert(str_len(agnosai_task_result_output(leak_res)) > 0, "leaving the rest of the answer");

    # =====================================================================
    # the CrewRunner (bite 16)
    # =====================================================================

    # A crew of `n` placeholder tasks, sequential.
    var seq_spec = agnosai_crew_new(str_from("seq-crew"));
    var seq_tasks = vec_new();
    vec_push(seq_tasks, agnosai_task_new(str_from("first")));
    vec_push(seq_tasks, agnosai_task_new(str_from("second")));
    agnosai_crew_with_tasks(seq_spec, seq_tasks);

    var runner = agnosai_crew_runner_new(seq_spec);
    var run_err: i64[1];
    store64(&run_err, 0);
    var state = agnosai_crew_runner_run(runner, &run_err);
    assert_eq(load64(&run_err), 0, "a sequential crew runs without error");
    assert(state != 0, "and returns a state");
    assert_eq(agnosai_crew_state_status(state), AGNOSAI_CREW_COMPLETED, "completed");
    assert_eq(vec_len(agnosai_crew_state_results(state)), 2, "with a result per task");
    assert(str_eq(agnosai_task_result_output(vec_get(agnosai_crew_state_results(state), 0)),
        str_from("first")) == 1, "in task order");

    # --- test_sequential_empty ---
    var empty_spec = agnosai_crew_new(str_from("empty"));
    var empty_state = agnosai_crew_runner_run(agnosai_crew_runner_new(empty_spec), &run_err);
    assert_eq(load64(&run_err), 0, "an empty crew is not an error");
    assert_eq(agnosai_crew_state_status(empty_state), AGNOSAI_CREW_COMPLETED,
      "and completes — `all()` over an empty result set is TRUE, so it must not read as failed");
    assert_eq(vec_len(agnosai_crew_state_results(empty_state)), 0, "with no results");

    # --- the profile ---
    var prof = agnosai_crew_state_profile(state);
    assert(prof != 0, "a completed run carries a profile");
    assert_eq(agnosai_crew_profile_task_count(prof), 2, "counting the tasks");
    assert_eq(map_size(agnosai_crew_profile_task_ms(prof)), 2,
      "with a duration per task, taken from each result's metadata");
    assert_eq(agnosai_crew_profile_cost_micro_usd(prof), 0,
      "and zero cost — the placeholder path never calls an LLM, so no task reports one");

    # ⚠ **`sandbox_strength` must be SET.** The oracle scores
    # `SandboxPolicy::process()` through `kavach_bridge::strength_for_policy` on
    # every crew run (`crew_runner.rs:198-214`). The port had the field, the
    # setter and the serialization — all covered by `tests/core_crew.tcyr` — and
    # **no caller outside a test**, so every profile the server emitted omitted a
    # number the oracle emits. `AGNOSAI_NO_LIMIT` is the unset sentinel.
    assert(agnosai_crew_profile_sandbox_strength(prof) != AGNOSAI_NO_LIMIT,
      "the profile carries a sandbox strength — unset here is the pre-2026-08-13 gap");
    assert_eq(agnosai_crew_profile_sandbox_strength(prof),
      agnosai_kavach_strength_for_policy(agnosai_sandbox_policy_process()),
      "and it is the score for SandboxPolicy::process(), which is what the oracle scores");
    assert(agnosai_crew_profile_sandbox_strength(prof) > 0,
      "a real 0-100 score, not a zero standing in for absent");

    # --- test_parallel_execution / test_parallel_single_concurrency ---
    # Real OS threads: alloc has been thread-safe since cyrius 6.0.64.
    var par_spec = agnosai_crew_new(str_from("par-crew"));
    var par_tasks = vec_new();
    for (var pi = 0; pi < 5; pi = pi + 1) {
        vec_push(par_tasks, agnosai_task_new(str_cat(str_from("job-"), str_from_int(pi))));
    }
    agnosai_crew_with_tasks(par_spec, par_tasks);
    agnosai_crew_with_process(par_spec, agnosai_process_parallel(2));
    var par_state = agnosai_crew_runner_run(agnosai_crew_runner_new(par_spec), &run_err);
    assert_eq(load64(&run_err), 0, "a parallel crew runs");
    assert_eq(vec_len(agnosai_crew_state_results(par_state)), 5,
      "every task produces a result even though only 2 run at a time");
    assert_eq(agnosai_crew_state_status(par_state), AGNOSAI_CREW_COMPLETED, "and the crew completes");

    var single = agnosai_crew_new(str_from("single"));
    agnosai_crew_with_tasks(single, par_tasks);
    agnosai_crew_with_process(single, agnosai_process_parallel(1));
    assert_eq(vec_len(agnosai_crew_state_results(
          agnosai_crew_runner_run(agnosai_crew_runner_new(single), &run_err))), 5,
      "concurrency 1 still runs all five — it is a limit, not a cap on the work");

    # ⚠ **A PARALLEL crew must observe the deadline.** Until 2026-08-13 the
    # cooperative check sat on the sequential and DAG loop heads only, so a
    # Parallel crew ran to completion however far past its budget it went:
    # `agnosai_crew_runner_timed_out` stayed 0 and `_agnosai_orch_finish` never
    # substituted the Failed/empty-results state, reporting the results as if
    # they had arrived in time.
    #
    # A deadline already in the past is the cleanest discriminator — the check
    # is at the batch head, so it fires before any thread is spawned.
    var dl_spec = agnosai_crew_new(str_from("deadline-par"));
    var dl_tasks = vec_new();
    for (var di = 0; di < 6; di = di + 1) {
        vec_push(dl_tasks, agnosai_task_new(str_cat(str_from("d-"), str_from_int(di))));
    }
    agnosai_crew_with_tasks(dl_spec, dl_tasks);
    agnosai_crew_with_process(dl_spec, agnosai_process_parallel(2));
    var dl_runner = agnosai_crew_runner_new(dl_spec);
    agnosai_crew_runner_set_deadline_ns(dl_runner, 1);
    var dl_state = agnosai_crew_runner_run(dl_runner, &run_err);
    assert_eq(agnosai_crew_runner_timed_out(dl_runner), 1,
      "a PARALLEL crew past its deadline reports timed_out — 0 here is the pre-2026-08-13 bug");
    assert(vec_len(agnosai_crew_state_results(dl_state)) < 6,
      "and it stopped early rather than running every task to completion");

    # The same runner with no deadline still runs everything, so the check is a
    # deadline and not a blanket refusal.
    var nd_spec = agnosai_crew_new(str_from("no-deadline-par"));
    agnosai_crew_with_tasks(nd_spec, dl_tasks);
    agnosai_crew_with_process(nd_spec, agnosai_process_parallel(2));
    var nd_runner = agnosai_crew_runner_new(nd_spec);
    assert_eq(vec_len(agnosai_crew_state_results(
          agnosai_crew_runner_run(nd_runner, &run_err))), 6,
      "with no deadline a parallel crew still runs all six");
    assert_eq(agnosai_crew_runner_timed_out(nd_runner), 0, "and does not report a timeout");

    # --- a timeout's crew_completed agrees with the stored state (ADR 022) ---
    # The deadline is cooperative, so a timed-out runner still finishes. It used
    # to compute its status from the partial results — COMPLETED when they all
    # completed, including when there were NONE — and announce that, while the
    # orchestrator stored FAILED afterwards. The runner now builds the oracle's
    # timeout state itself, and announces that.
    var to_seq = _t_crew("timeout-seq", 3, agnosai_process_sequential());
    var to_seq_sub: i64[1];
    var to_seq_r = agnosai_crew_runner_with_events(agnosai_crew_runner_new(to_seq),
      _t_watch(to_seq, &to_seq_sub));
    agnosai_crew_runner_set_deadline_ns(to_seq_r, 1);
    store64(&run_err, 0);
    var to_seq_state = agnosai_crew_runner_run(to_seq_r, &run_err);
    assert_eq(agnosai_crew_state_status(to_seq_state), AGNOSAI_CREW_FAILED,
      "a timed-out SEQUENTIAL crew's state is FAILED — COMPLETED here is the pre-ADR-022 bug");
    assert_eq(vec_len(agnosai_crew_state_results(to_seq_state)), 0, "with no results");
    assert_eq(agnosai_crew_state_profile(to_seq_state), 0, "and no profile — the oracle's shape");
    var to_seq_done = _t_find(_t_drain(load64(&to_seq_sub)), "crew_completed");
    assert(to_seq_done != 0, "it still closes with crew_completed");
    assert(str_eq_cstr(_t_ev_str(to_seq_done, "status"), "failed") == 1,
      "which says \"failed\", agreeing with the state — it said \"completed\" before ADR 022");
    assert_eq(_t_ev_int(to_seq_done, "task_count"), 0, "with task_count 0, the state's count");

    var to_par = _t_crew("timeout-par", 4, agnosai_process_parallel(2));
    var to_par_sub: i64[1];
    var to_par_r = agnosai_crew_runner_with_events(agnosai_crew_runner_new(to_par),
      _t_watch(to_par, &to_par_sub));
    agnosai_crew_runner_set_deadline_ns(to_par_r, 1);
    var to_par_state = agnosai_crew_runner_run(to_par_r, &run_err);
    assert_eq(agnosai_crew_state_status(to_par_state), AGNOSAI_CREW_FAILED,
      "a timed-out PARALLEL crew is FAILED too");
    assert_eq(vec_len(agnosai_crew_state_results(to_par_state)), 0, "with no results");
    assert_eq(agnosai_crew_state_profile(to_par_state), 0, "and no profile");
    var to_par_done = _t_find(_t_drain(load64(&to_par_sub)), "crew_completed");
    assert(str_eq_cstr(_t_ev_str(to_par_done, "status"), "failed") == 1,
      "and its crew_completed says \"failed\"");
    assert_eq(_t_ev_int(to_par_done, "task_count"), 0, "with task_count 0");

    # The control: the same crew with no deadline still announces "completed",
    # so the assertions above are about the deadline and not a blanket FAILED.
    var to_ok = _t_crew("timeout-ctl", 3, agnosai_process_sequential());
    var to_ok_sub: i64[1];
    var to_ok_state = agnosai_crew_runner_run(agnosai_crew_runner_with_events(
        agnosai_crew_runner_new(to_ok), _t_watch(to_ok, &to_ok_sub)), &run_err);
    assert_eq(agnosai_crew_state_status(to_ok_state), AGNOSAI_CREW_COMPLETED,
      "with no deadline the crew completes");
    var to_ok_done = _t_find(_t_drain(load64(&to_ok_sub)), "crew_completed");
    assert(str_eq_cstr(_t_ev_str(to_ok_done, "status"), "completed") == 1,
      "and says \"completed\"");
    assert_eq(_t_ev_int(to_ok_done, "task_count"), 3, "counting all three results");

    # A deadline that passes MID-RUN, after one task ran. The stub gateway moves
    # the deadline into the past while answering task 1, so loop head 2 sees it.
    # This is what separates "the state's count" from "the run's count" — with a
    # deadline already past, both are 0 and a `vec_len(results)` mutant survives.
    var mid = _t_crew("timeout-mid", 3, agnosai_process_sequential());
    var mid_sub: i64[1];
    var mid_r = agnosai_crew_runner_with_events(agnosai_crew_runner_with_llm(
        agnosai_crew_runner_new(mid), agnosai_hoosh_client_with_chat(
          agnosai_hoosh_client_new(str_from("http://127.0.0.1:1"), str_from("")),
          &_t_stub_chat_expire)), _t_watch(mid, &mid_sub));
    var mid_m = agnosai_metrics_global();
    var mid_done_before = agnosai_metrics_tasks_completed(mid_m);
    _t_expire_runner = mid_r;
    var mid_state = agnosai_crew_runner_run(mid_r, &run_err);
    _t_expire_runner = 0;
    assert_eq(agnosai_crew_runner_timed_out(mid_r), 1, "the mid-run deadline is observed");
    assert_eq(agnosai_crew_state_status(mid_state), AGNOSAI_CREW_FAILED, "the crew is FAILED");
    assert_eq(vec_len(agnosai_crew_state_results(mid_state)), 0,
      "and its one PARTIAL result is discarded, as the oracle's timeout does");
    assert_eq(agnosai_crew_state_profile(mid_state), 0, "with no profile");
    var mid_evs = _t_drain(load64(&mid_sub));
    assert_eq(_t_count(mid_evs, "task_completed"), 1,
      "exactly one task ran before the deadline was seen — the fixture works as described");
    assert_eq(_t_ev_int(_t_find(mid_evs, "crew_completed"), "task_count"), 0,
      "crew_completed counts the STATE's results, 0 — not the run's 1 — so event and state agree");
    assert(str_eq_cstr(_t_ev_str(_t_find(mid_evs, "crew_completed"), "status"), "failed") == 1,
      "and says \"failed\" although every task that ran COMPLETED");
    assert_eq(agnosai_metrics_tasks_completed(mid_m) - mid_done_before, 1,
      "the task that ran is still COUNTED in the metrics — its tokens were spent");

    # Timeout outranks cancel in the status ladder. The two coincide only if a
    # cancel lands between the loop head that saw the deadline and the status
    # read; the loop heads check cancel FIRST, so no suite can produce both
    # deterministically. Stated rather than tested.

    # --- test_dag_execution_with_dependencies ---
    var dag_spec = agnosai_crew_new(str_from("dag"));
    var a_task = agnosai_task_new(str_from("A"));
    var b_task = agnosai_task_new(str_from("B"));
    agnosai_task_with_dependency(b_task, agnosai_task_id(a_task));
    var dag_tasks = vec_new();
    vec_push(dag_tasks, b_task);
    vec_push(dag_tasks, a_task);
    agnosai_crew_with_tasks(dag_spec, dag_tasks);
    agnosai_crew_with_process(dag_spec, agnosai_process_dag());
    var dag_state = agnosai_crew_runner_run(agnosai_crew_runner_new(dag_spec), &run_err);
    assert_eq(load64(&run_err), 0, "a DAG crew runs");
    var dag_results = agnosai_crew_state_results(dag_state);
    assert_eq(vec_len(dag_results), 2, "both tasks run");
    assert(str_eq(agnosai_task_result_task_id(vec_get(dag_results, 0)),
        agnosai_task_id(a_task)) == 1,
      "the DEPENDENCY runs first even though it was listed second — dependency order, not spec order");

    # --- test_dag_no_deps_runs_all: one wave ---
    var flat = agnosai_crew_new(str_from("flat"));
    var flat_tasks = vec_new();
    vec_push(flat_tasks, agnosai_task_new(str_from("x")));
    vec_push(flat_tasks, agnosai_task_new(str_from("y")));
    vec_push(flat_tasks, agnosai_task_new(str_from("z")));
    agnosai_crew_with_tasks(flat, flat_tasks);
    agnosai_crew_with_process(flat, agnosai_process_dag());
    assert_eq(vec_len(agnosai_crew_state_results(
          agnosai_crew_runner_run(agnosai_crew_runner_new(flat), &run_err))), 3,
      "independent tasks all run in a single wave");

    # --- test_topo_sort_detects_cycle, at the run() layer ---
    var cyc = agnosai_crew_new(str_from("cyclic"));
    var c1 = agnosai_task_new(str_from("c1"));
    var c2 = agnosai_task_new(str_from("c2"));
    agnosai_task_with_dependency(c1, agnosai_task_id(c2));
    agnosai_task_with_dependency(c2, agnosai_task_id(c1));
    var cyc_tasks = vec_new();
    vec_push(cyc_tasks, c1);
    vec_push(cyc_tasks, c2);
    agnosai_crew_with_tasks(cyc, cyc_tasks);
    agnosai_crew_with_process(cyc, agnosai_process_dag());
    store64(&run_err, 0);
    var cyc_state = agnosai_crew_runner_run(agnosai_crew_runner_new(cyc), &run_err);
    assert_eq(cyc_state, 0,
      "a cyclic DAG returns NO STATE — the oracle's `?` means it never builds one, so a consumer \
    can tell \"the spec was wrong\" from \"the work failed\"");
    assert(load64(&run_err) != 0, "and reports an error instead");
    assert_eq(agnosai_error_kind(load64(&run_err)), AGNOSAI_ERR_CYCLIC_DAG, "a CyclicDAG error");

    # --- 2.1.6: a failed branch beside a successful one ends FAILED ----------
    # `[A fails, X, B <- A, Y <- X]`: wave 1 {A, X}, A fails; wave 2 {Y} succeeds;
    # then nothing is ready, because B waits on A. Through 2.1.5 the failure flag
    # was per wave, so wave 2 skipped the stranded check and wave 3 took the
    # DAG-deadlock arm: no state, no crew_completed, and an orchestrator that put
    # PENDING back forever. agnostic accepts this crew — its dependencies are in
    # range and acyclic — and read it `running` for good.
    var sd_spec = agnosai_crew_new(str_from("dag-stranded"));
    var sd_a = agnosai_task_new(str_from("A FAILME"));
    var sd_x = agnosai_task_new(str_from("X"));
    var sd_b = agnosai_task_new(str_from("B"));
    var sd_y = agnosai_task_new(str_from("Y"));
    agnosai_task_with_dependency(sd_b, agnosai_task_id(sd_a));
    agnosai_task_with_dependency(sd_y, agnosai_task_id(sd_x));
    var sd_tasks = vec_new();
    vec_push(sd_tasks, sd_a);
    vec_push(sd_tasks, sd_x);
    vec_push(sd_tasks, sd_b);
    vec_push(sd_tasks, sd_y);
    agnosai_crew_with_tasks(sd_spec, sd_tasks);
    agnosai_crew_with_process(sd_spec, agnosai_process_dag());
    var sd_sub: i64[1];
    var sd_runner = agnosai_crew_runner_with_llm(agnosai_crew_runner_new(sd_spec),
      agnosai_hoosh_client_with_chat(
        agnosai_hoosh_client_new(str_from("http://127.0.0.1:1"), str_from("")), &_t_stub_chat_failme));
    agnosai_crew_runner_with_events(sd_runner, _t_watch(sd_spec, &sd_sub));
    store64(&run_err, 0);
    var sd_state = agnosai_crew_runner_run(sd_runner, &run_err);
    assert(sd_state != 0, "a DAG stranded by a failed branch still returns a STATE (2.1.6)");
    assert_eq(load64(&run_err), 0, "and no scheduling error — no deadlock");
    if (sd_state != 0) {
        assert_eq(agnosai_crew_state_status(sd_state), AGNOSAI_CREW_FAILED, "the state is FAILED");
        assert_eq(vec_len(agnosai_crew_state_results(sd_state)), 3,
          "with the three tasks that ran: A failed, X and Y completed; B never ran");
    }
    var sd_last = 0;
    var sd_ev = agnosai_event_sub_try_recv(load64(&sd_sub));
    while (sd_ev != 0) {
        sd_last = sd_ev;
        sd_ev = agnosai_event_sub_try_recv(load64(&sd_sub));
    }
    assert(sd_last != 0, "events were published");
    assert(str_eq_cstr(agnosai_crew_event_event_type(sd_last), "crew_completed") == 1,
      "and the last is crew_completed, as for every crew that ends");

    # A dangling dependency — no failure explains it — still takes the deadlock arm.
    var dd_spec = agnosai_crew_new(str_from("dag-dangling"));
    var dd_t = agnosai_task_new(str_from("waits on nothing that exists"));
    agnosai_task_with_dependency(dd_t, str_from("00000000-0000-4000-8000-000000000000"));
    var dd_tasks = vec_new();
    vec_push(dd_tasks, dd_t);
    agnosai_crew_with_tasks(dd_spec, dd_tasks);
    agnosai_crew_with_process(dd_spec, agnosai_process_dag());
    store64(&run_err, 0);
    assert_eq(agnosai_crew_runner_run(agnosai_crew_runner_new(dd_spec), &run_err), 0,
      "a dependency on a task the spec does not hold is still a scheduling error");
    assert(load64(&run_err) != 0, "reported as one");

    # --- ADR 011's producer side: /metrics must stop rendering zeros ---------
    # Counters are process-global and accumulate across this whole file, so every
    # assertion here is a DELTA around one run, never an absolute.
    var _m = agnosai_metrics_global();

    # The gauge must balance on the cyclic-DAG path too. That run returned an
    # error before any task executed and deliberately emits no `crew_completed`
    # EVENT — but the gauge is a different contract, and if it does not unwind
    # here it ratchets upward for the life of the process on one malformed spec.
    # This is the assertion that catches that; it failed on the first cut.
    var _act_before_cyc = agnosai_metrics_crews_active(_m);
    var cyc2 = agnosai_crew_new(str_from("cyclic-2"));
    var d1 = agnosai_task_new(str_from("d1"));
    var d2 = agnosai_task_new(str_from("d2"));
    agnosai_task_with_dependency(d1, agnosai_task_id(d2));
    agnosai_task_with_dependency(d2, agnosai_task_id(d1));
    var cyc2_tasks = vec_new();
    vec_push(cyc2_tasks, d1);
    vec_push(cyc2_tasks, d2);
    agnosai_crew_with_tasks(cyc2, cyc2_tasks);
    agnosai_crew_with_process(cyc2, agnosai_process_dag());
    store64(&run_err, 0);
    agnosai_crew_runner_run(agnosai_crew_runner_new(cyc2), &run_err);
    assert_eq(agnosai_metrics_crews_active(_m), _act_before_cyc,
      "a cyclic DAG leaves crews_active exactly where it found it — the error return must still \
    balance the gauge even though it emits no crew_completed event");

    # A crew that actually runs moves crews_total, balances the gauge, and folds
    # its tasks into the task counters.
    var _tot_before = agnosai_metrics_crews_total(_m);
    var _act_before = agnosai_metrics_crews_active(_m);
    var _done_before = agnosai_metrics_tasks_completed(_m);
    var mspec = agnosai_crew_new(str_from("metrics-crew"));
    var mt = vec_new();
    vec_push(mt, agnosai_task_new(str_from("m1")));
    vec_push(mt, agnosai_task_new(str_from("m2")));
    agnosai_crew_with_tasks(mspec, mt);
    store64(&run_err, 0);
    # No LLM client, exactly like the sequential test above: each task falls to
    # the placeholder path and still lands a COMPLETED result, which is all the
    # counters read.
    agnosai_crew_runner_run(agnosai_crew_runner_new(mspec), &run_err);
    assert_eq(agnosai_metrics_crews_total(_m) - _tot_before, 1,
      "one completed run increments crews_total exactly once");
    assert_eq(agnosai_metrics_crews_active(_m), _act_before,
      "and leaves crews_active balanced");
    assert_eq(agnosai_metrics_tasks_completed(_m) - _done_before, 2,
      "with both tasks folded into tasks_completed — the counter ADR 011 staged and \
    left rendering zeros");

    # --- test_hierarchical_falls_back_to_sequential ---
    var hier = agnosai_crew_new(str_from("hier"));
    agnosai_crew_with_tasks(hier, seq_tasks);
    agnosai_crew_with_process(hier, agnosai_process_hierarchical(_t_agent("mgr")));
    store64(&run_err, 0);
    var hier_state = agnosai_crew_runner_run(agnosai_crew_runner_new(hier), &run_err);
    assert_eq(load64(&run_err), 0, "hierarchical mode runs");
    assert_eq(vec_len(agnosai_crew_state_results(hier_state)), 2,
      "by falling back to SEQUENTIAL — orch_hierarchical's delegation exists and is tested, but the \
    oracle has not wired it in, and doing so here would diverge from Phase 2 upstream");

    # --- cancellation ---
    var cancel_spec = agnosai_crew_new(str_from("cancelled"));
    agnosai_crew_with_tasks(cancel_spec, seq_tasks);
    var cancel_runner = agnosai_crew_runner_new(cancel_spec);
    assert_eq(agnosai_crew_runner_is_cancelled(cancel_runner), 0, "a new runner is not cancelled");
    agnosai_crew_runner_cancel(cancel_runner);
    assert_eq(agnosai_crew_runner_is_cancelled(cancel_runner), 1, "until it is");
    store64(&run_err, 0);
    var cancel_state = agnosai_crew_runner_run(cancel_runner, &run_err);
    assert_eq(agnosai_crew_state_status(cancel_state), AGNOSAI_CREW_CANCELLED,
      "a cancelled crew reports CANCELLED, which beats both completed and failed");
    assert_eq(vec_len(agnosai_crew_state_results(cancel_state)), 0,
      "and runs nothing — cancellation is checked BEFORE each task, so results hold what actually \
    ran rather than a set of synthetic failures");

    # --- the client and the shared cancel flag ---
    # with_llm attaches the gateway; without it every task takes the placeholder
    # path, which is what the whole test file above relies on.
    var llm_runner = agnosai_crew_runner_with_llm(agnosai_crew_runner_new(seq_spec),
      agnosai_hoosh_client_new(str_from("http://127.0.0.1:8088"), str_from("")));
    assert(llm_runner != 0, "a client can be attached");
    var flag = agnosai_crew_runner_cancel_flag(llm_runner);
    assert(flag != 0, "the cancel flag is a shared pointer, not a copy");
    assert_eq(load64(flag), 0, "starting clear");
    agnosai_crew_runner_cancel(llm_runner);
    assert_eq(load64(flag), 1,
      "and cancelling writes THROUGH it — which is what lets a worker thread spawned earlier see a \
    cancellation raised while its wave is in flight");

    # --- events ---
    var bus = agnosai_event_bus_new();
    var ev_spec = agnosai_crew_new(str_from("evented"));
    agnosai_crew_with_tasks(ev_spec, seq_tasks);
    var tx = agnosai_event_bus_sender(bus, agnosai_crew_id(ev_spec));
    var sub = agnosai_event_sender_subscribe(tx);
    var ev_runner = agnosai_crew_runner_with_events(agnosai_crew_runner_new(ev_spec), tx);
    agnosai_crew_runner_run(ev_runner, &run_err);

    var first_ev = agnosai_event_sub_try_recv(sub);
    assert(first_ev != 0, "the run emits events");
    assert(str_eq(agnosai_crew_event_event_type(first_ev), str_from("crew_started")) == 1,
      "starting with crew_started");
    var seen_completed = 0;
    var seen_task_started = 0;
    for (var e = 0; e < 12; e = e + 1) {
        var ev = agnosai_event_sub_try_recv(sub);
        if (ev == 0) { break; }
        if (str_eq(agnosai_crew_event_event_type(ev), str_from("task_started")) == 1) {
            seen_task_started = seen_task_started + 1;
        }
        if (str_eq(agnosai_crew_event_event_type(ev), str_from("crew_completed")) == 1) {
            seen_completed = 1;
        }
    }
    assert_eq(seen_task_started, 2, "one task_started per task");
    assert_eq(seen_completed, 1, "and a closing crew_completed");

    # --- token events name their crew (ADR 022) ---
    # Through the stub gateway, so the LLM success arm — the only arm that emits
    # a `token` — runs. The runner passes its spec id down; before ADR 022 every
    # one of these said "unknown", because nothing stamps the task context.
    var tok_spec = _t_seq_spec();
    var tok_sub: i64[1];
    var tok_tx = _t_watch(tok_spec, &tok_sub);
    store64(&run_err, 0);
    agnosai_crew_runner_run(agnosai_crew_runner_with_events(_t_llm_runner(tok_spec), tok_tx),
      &run_err);
    var tok_evs = _t_drain(load64(&tok_sub));
    assert_eq(_t_count(tok_evs, "token"), 2,
      "a sequential crew of two LLM-answered tasks sends two token events");
    assert_eq(_t_tokens_for(tok_evs, agnosai_crew_id(tok_spec)), 2,
      "and BOTH carry the spec's crew id, like every other event the runner emits");

    # --- agent cost, end to end through the stub gateway (ADR 022) ---
    # One agent answers two tasks at 450 micro-USD each. Before ADR 022 nothing
    # wrote `metadata["agent"]`, so `agent_cost_usd` was empty whatever ran.
    var ac_spec = _t_seq_spec();
    agnosai_crew_with_agents(ac_spec, _t_roster(_t_agent("solo"), 0, 0));
    store64(&run_err, 0);
    var ac_state = agnosai_crew_runner_run(_t_llm_runner(ac_spec), &run_err);
    var ac_results = agnosai_crew_state_results(ac_state);
    assert_eq(vec_len(ac_results), 2, "both tasks are answered");
    var ac_named = 0;
    for (var aci = 0; aci < vec_len(ac_results); aci = aci + 1) {
        var ac_v = map_get(agnosai_task_result_metadata(vec_get(ac_results, aci)),
          str_from("agent"));
        if (ac_v != 0 && str_eq_cstr(bayan_json_v_str(ac_v), "solo") == 1) {
            ac_named = ac_named + 1;
        }
    }
    assert_eq(ac_named, 2, "each LLM-answered result names its agent, \"solo\"");
    var ac_prof = agnosai_crew_state_profile(ac_state);
    assert_eq(map_get(agnosai_crew_profile_agent_cost(ac_prof), str_from("solo")), 900,
      "and the profile charges \"solo\" for BOTH tasks — 900; empty before ADR 022, 450 if the \
    recorder replaced instead of summing");
    assert_eq(map_size(agnosai_crew_profile_task_cost(ac_prof)), 2, "with a cost per task");
    assert_eq(agnosai_crew_profile_cost_micro_usd(ac_prof), 900, "and a crew total of 900");

    # --- wave events: started at dispatch, completed at join (ADR 022) ---
    # The placeholder path, which is deterministic: 5 tasks at concurrency 2 run
    # as batches of 2, 2 and 1. Before ADR 022 all five `task_started` went out
    # before the first batch ran and all five `task_completed` after the last,
    # so a watcher saw five tasks "running" at once.
    var wv = _t_crew("wave-events", 5, agnosai_process_parallel(2));
    var wv_sub: i64[1];
    store64(&run_err, 0);
    agnosai_crew_runner_run(agnosai_crew_runner_with_events(agnosai_crew_runner_new(wv),
        _t_watch(wv, &wv_sub)), &run_err);
    var wv_evs = _t_drain(load64(&wv_sub));
    assert_eq(_t_count(wv_evs, "task_started"), 5, "five task_started");
    assert_eq(_t_count(wv_evs, "task_completed"), 5, "and five task_completed");
    assert_eq(_t_max_in_flight(wv_evs), 2,
      "and never more than TWO tasks in flight — the concurrency limit; 5 before ADR 022");
    assert_eq(_t_unpreceded(wv_evs, "task_completed", "task_started"), 0,
      "every task_completed follows its own task_started");
    assert(_t_is(vec_get(wv_evs, 0), "crew_started") == 1, "crew_started is first");
    assert(_t_is(vec_get(wv_evs, vec_len(wv_evs) - 1), "crew_completed") == 1,
      "and crew_completed last");

    # A task stopped before dispatch is announced as NEITHER started nor
    # completed — before ADR 022 all six were announced as started.
    var wv_dl = _t_crew("wave-deadline", 6, agnosai_process_parallel(2));
    var wv_dl_sub: i64[1];
    var wv_dl_r = agnosai_crew_runner_with_events(agnosai_crew_runner_new(wv_dl),
      _t_watch(wv_dl, &wv_dl_sub));
    agnosai_crew_runner_set_deadline_ns(wv_dl_r, 1);
    agnosai_crew_runner_run(wv_dl_r, &run_err);
    var wv_dl_evs = _t_drain(load64(&wv_dl_sub));
    assert_eq(_t_count(wv_dl_evs, "task_started"), 0,
      "a parallel crew past its deadline announces NO task_started — six before ADR 022");
    assert_eq(_t_count(wv_dl_evs, "task_completed"), 0, "and no task_completed");

    # DAG A -> B: two waves of one, so each task finishes before the next starts.
    var wd_spec = agnosai_crew_new(str_from("dag-events"));
    var wd_a = agnosai_task_new(str_from("A"));
    var wd_b = agnosai_task_new(str_from("B"));
    agnosai_task_with_dependency(wd_b, agnosai_task_id(wd_a));
    var wd_tasks = vec_new();
    vec_push(wd_tasks, wd_b);
    vec_push(wd_tasks, wd_a);
    agnosai_crew_with_tasks(wd_spec, wd_tasks);
    agnosai_crew_with_process(wd_spec, agnosai_process_dag());
    var wd_sub: i64[1];
    agnosai_crew_runner_run(agnosai_crew_runner_with_events(agnosai_crew_runner_new(wd_spec),
        _t_watch(wd_spec, &wd_sub)), &run_err);
    var wd_evs = _t_drain(load64(&wd_sub));
    var wd_sa = _t_index_of(wd_evs, "task_started", agnosai_task_id(wd_a));
    var wd_ca = _t_index_of(wd_evs, "task_completed", agnosai_task_id(wd_a));
    var wd_sb = _t_index_of(wd_evs, "task_started", agnosai_task_id(wd_b));
    var wd_cb = _t_index_of(wd_evs, "task_completed", agnosai_task_id(wd_b));
    assert(wd_sa >= 0 && wd_sa < wd_ca, "DAG: started(A) precedes completed(A)");
    assert(wd_ca < wd_sb, "completed(A) precedes started(B) — B's wave starts after A's ends");
    assert(wd_sb < wd_cb, "and started(B) precedes completed(B)");

    # --- workers send token events (ADR 022) ---
    # Through the stub gateway. The oracle's workers passed no sender, so a
    # parallel or DAG crew sent no `token` at all — this was 0.
    var wt = _t_crew("wave-tokens", 4, agnosai_process_parallel(2));
    var wt_sub: i64[1];
    agnosai_crew_runner_run(agnosai_crew_runner_with_events(_t_llm_runner(wt),
        _t_watch(wt, &wt_sub)), &run_err);
    var wt_evs = _t_drain(load64(&wt_sub));
    assert_eq(_t_count(wt_evs, "token"), 4,
      "a parallel crew of four LLM-answered tasks sends four token events — 0 before ADR 022");
    assert_eq(_t_tokens_for(wt_evs, agnosai_crew_id(wt)), 4, "each naming the spec's crew");
    assert_eq(_t_tokens_late(wt_evs), 0,
      "and each before its own task_completed — the worker sends it, the join reports after");
    assert_eq(_t_max_in_flight(wt_evs), 2, "with the batches still bounded at two");

    var wtd_spec = agnosai_crew_new(str_from("dag-tokens"));
    var wtd_a = agnosai_task_new(str_from("A"));
    var wtd_b = agnosai_task_new(str_from("B"));
    agnosai_task_with_dependency(wtd_b, agnosai_task_id(wtd_a));
    var wtd_tasks = vec_new();
    vec_push(wtd_tasks, wtd_a);
    vec_push(wtd_tasks, wtd_b);
    agnosai_crew_with_tasks(wtd_spec, wtd_tasks);
    agnosai_crew_with_process(wtd_spec, agnosai_process_dag());
    var wtd_sub: i64[1];
    agnosai_crew_runner_run(agnosai_crew_runner_with_events(_t_llm_runner(wtd_spec),
        _t_watch(wtd_spec, &wtd_sub)), &run_err);
    var wtd_evs = _t_drain(load64(&wtd_sub));
    assert_eq(_t_tokens_for(wtd_evs, agnosai_crew_id(wtd_spec)), 2,
      "a DAG crew A -> B sends two token events, naming its crew");

    # --- task_completed goes out as ITS worker is joined, not at batch end ---
    # One batch of two, where the second task's answer waits for the FIRST
    # task's `task_completed`. The join walks dispatch order, so the runner
    # joins the first worker and reports it while the second is still waiting,
    # and the second then sees the event and answers. A runner that joined the
    # whole batch before reporting any of it would block on the second worker
    # while that worker waited for an event due only after its own join: the
    # bounded wait runs out and `_t_peer_seen` says 2. The batch-granularity
    # checks above pass either way — both shapes keep two tasks in flight.
    var wj = agnosai_crew_new(str_from("wave-join"));
    var wj_first = agnosai_task_new(str_from("answer at once"));
    var wj_second = agnosai_task_new(str_from("await-peer"));
    var wj_tasks = vec_new();
    vec_push(wj_tasks, wj_first);
    vec_push(wj_tasks, wj_second);
    agnosai_crew_with_tasks(wj, wj_tasks);
    agnosai_crew_with_process(wj, agnosai_process_parallel(2));
    var wj_sub: i64[1];
    var wj_tx = _t_watch(wj, &wj_sub);
    _t_peer_sub = agnosai_event_sender_subscribe(wj_tx);
    _t_peer_task = agnosai_task_id(wj_first);
    _t_peer_seen = 0;
    var wj_client = agnosai_hoosh_client_with_chat(
      agnosai_hoosh_client_new(str_from("http://127.0.0.1:1"), str_from("")), &_t_stub_chat_peer);
    var wj_state = agnosai_crew_runner_run(agnosai_crew_runner_with_events(
        agnosai_crew_runner_with_llm(agnosai_crew_runner_new(wj), wj_client), wj_tx), &run_err);
    assert_eq(_t_peer_seen, 1,
      "the second task saw the first's task_completed while it was still running — 2 if \
    completions waited for the whole batch to join");
    assert_eq(vec_len(agnosai_crew_state_results(wj_state)), 2, "and both tasks answered");
    var wj_evs = _t_drain(load64(&wj_sub));
    var wj_c1 = _t_index_of(wj_evs, "task_completed", agnosai_task_id(wj_first));
    var wj_c2 = _t_index_of(wj_evs, "task_completed", agnosai_task_id(wj_second));
    assert(wj_c1 >= 0 && wj_c1 < wj_c2, "so the first task's completion precedes the second's");

    # Nobody subscribed: the workers get no sender, so they build no payloads.
    # A crew with a bus but no subscriber still completes normally.
    var wq = _t_crew("wave-quiet", 3, agnosai_process_parallel(2));
    var wq_tx = agnosai_event_bus_sender(agnosai_event_bus_new(), agnosai_crew_id(wq));
    var wq_state = agnosai_crew_runner_run(agnosai_crew_runner_with_events(_t_llm_runner(wq),
        wq_tx), &run_err);
    assert_eq(vec_len(agnosai_crew_state_results(wq_state)), 3,
      "an unwatched parallel LLM crew still answers every task");

    # **An unwatched bus costs a wave exactly nothing.**
    #
    # The assertion above passes whether or not the wave's two gates exist, so
    # this compares the same crew run with a bus nobody is subscribed to against
    # a run with no bus at all, and requires the SAME byte count. A worker handed
    # the sender anyway builds a `token` payload and event per task; an ungated
    # `task_started` builds an event per dispatch. Either reaches nobody, and
    # either makes the quiet run dearer than the bare one. The bare run is the
    # baseline rather than a fixed byte count, so a payload changing shape does
    # not need this re-calibrated.
    #
    # Exact rather than approximate: `alloc_used` sums request sizes, which no
    # thread interleaving changes, and one warm-up pair absorbs first-use growth.
    var wz_tx = agnosai_event_bus_sender(agnosai_event_bus_new(), str_from("wave-zero"));
    _t_run_cost(_t_llm_runner(_t_crew("wz", 4, agnosai_process_parallel(2))));
    _t_run_cost(agnosai_crew_runner_with_events(
        _t_llm_runner(_t_crew("wz", 4, agnosai_process_parallel(2))), wz_tx));
    var wz_bare = _t_run_cost(_t_llm_runner(_t_crew("wz", 4, agnosai_process_parallel(2))));
    var wz_quiet = _t_run_cost(agnosai_crew_runner_with_events(
        _t_llm_runner(_t_crew("wz", 4, agnosai_process_parallel(2))), wz_tx));
    assert(wz_bare > 0, "the bare parallel run is measured at all");
    assert_eq(wz_quiet, wz_bare,
      "a parallel LLM crew allocates the same with an unwatched bus as with none");

    var wzd_bare = _t_run_cost(_t_llm_runner(_t_crew("wzd", 3, agnosai_process_dag())));
    var wzd_quiet = _t_run_cost(agnosai_crew_runner_with_events(
        _t_llm_runner(_t_crew("wzd", 3, agnosai_process_dag())), wz_tx));
    assert_eq(wzd_quiet, wzd_bare, "and so does a DAG crew, whose waves share the gates");

    # **A bus with nobody listening builds no payloads.**
    #
    # `_agnosai_crew_emit` already returned early with no bus attached, but the
    # caller had built the payload by then, and `agnosai_event_sender_send` with
    # zero subscribers takes the mutex, iterates nothing and drops it. The two
    # per-task payloads measured **344 + 304 = 648 bytes** — about 28% of what
    # this module allocates on its own — all discarded.
    #
    # Zero subscribers is the *normal* state: a client attaches to
    # `/api/v1/crews/{id}/stream` only when someone is watching that crew. So
    # this measures a bus that exists with nobody on it, which is the common
    # case, and compares it against the same run with a live subscriber.
    var q_bus = agnosai_event_bus_new();
    var q_tx = agnosai_event_bus_sender(q_bus, str_from("quiet"));
    var q_err: i64[1];
    store64(&q_err, 0);

    # warm
    agnosai_crew_runner_run(agnosai_crew_runner_with_events(
        agnosai_crew_runner_new(_t_seq_spec()), q_tx), &q_err);

    var qb = alloc_used();
    for (var qi = 0; qi < 4; qi = qi + 1) {
        agnosai_crew_runner_run(agnosai_crew_runner_with_events(
            agnosai_crew_runner_new(_t_seq_spec()), q_tx), &q_err);
    }
    var per_quiet = (alloc_used() - qb) / 4;

    var q_sub = agnosai_event_sender_subscribe(q_tx);
    agnosai_crew_runner_run(agnosai_crew_runner_with_events(
        agnosai_crew_runner_new(_t_seq_spec()), q_tx), &q_err);
    var lb = alloc_used();
    for (var li = 0; li < 4; li = li + 1) {
        agnosai_crew_runner_run(agnosai_crew_runner_with_events(
            agnosai_crew_runner_new(_t_seq_spec()), q_tx), &q_err);
        while (agnosai_event_sub_try_recv(q_sub) != 0) { }
    }
    var per_listened = (alloc_used() - lb) / 4;

    assert(per_quiet < per_listened,
      "**a run with nobody subscribed allocates less than the same run with a \
    listener** — the payloads are not built when there is no one to send them \
    to, which is the ordinary state of a server nobody is watching");

    # ⚠ **What this does and does not catch.** Removing the subscriber check —
    # or breaking the guard so it always answers no — both fail here (the
    # second by losing events the assertions above require). Un-guarding a
    # *single* one of the four emit sites does not: it raises `per_quiet` and
    # `per_listened` toward each other without crossing, and it is below this
    # comparison's resolution.
    #
    # The exact comparison below catches that one, with the baseline the wave
    # check above uses: a run with no bus at all, so no byte count has to be
    # re-calibrated when a payload changes shape. It runs the PLACEHOLDER path.
    # On the LLM path the sequential loop hands `agnosai_execute_task_in_crew`
    # the sender whether or not anyone listens, so an answer's `token` payload
    # is built for nobody, and the two runs differ by that much.
    _t_run_cost(agnosai_crew_runner_new(_t_seq_spec()));
    var sq_bare = _t_run_cost(agnosai_crew_runner_new(_t_seq_spec()));
    var sq_quiet = _t_run_cost(agnosai_crew_runner_with_events(
        agnosai_crew_runner_new(_t_seq_spec()), agnosai_event_bus_sender(q_bus, str_from("idle"))));
    assert_eq(sq_quiet, sq_bare,
      "a sequential crew allocates the same with an unwatched bus as with none");

    # --- audit ---
    var chain = agnosai_audit_chain_new();
    var au_spec = agnosai_crew_new(str_from("audited"));
    agnosai_crew_with_tasks(au_spec, seq_tasks);
    agnosai_crew_runner_run(
      agnosai_crew_runner_with_audit(agnosai_crew_runner_new(au_spec), chain), &run_err);
    assert_eq(agnosai_audit_chain_count(chain), 2,
      "the sequential path audits one entry per task");
    assert_eq(agnosai_audit_verify(chain), 0, "and the chain verifies");
    assert(str_eq(agnosai_audit_entry_event(vec_get(agnosai_audit_chain_recent(chain, 1), 0)),
        str_from("task_completed")) == 1, "under the task_completed event name");

    # the parallel path does NOT audit — the oracle's asymmetry, reproduced
    var au2 = agnosai_audit_chain_new();
    var au_par = agnosai_crew_new(str_from("audited-par"));
    agnosai_crew_with_tasks(au_par, seq_tasks);
    agnosai_crew_with_process(au_par, agnosai_process_parallel(2));
    agnosai_crew_runner_run(
      agnosai_crew_runner_with_audit(agnosai_crew_runner_new(au_par), au2), &run_err);
    assert_eq(agnosai_audit_chain_count(au2), 0,
      "the PARALLEL path audits nothing — only run_sequential calls audit_record in the oracle, and \
    making the others audit would change what a consumer's trail contains");

    # --- output_filter is WIRED (ADR 020) ------------------------------------
    #
    # ⚠ This is a DELIBERATE DIVERGENCE. The oracle never calls `output_filter`:
    # `rust-old/src/server/mod.rs:11` is `pub mod output_filter;` and that is the
    # module's only mention in the whole Rust tree, so the port was at parity
    # with 20 functions and no caller. `prompt_guard` — the inbound half — IS
    # wired in the oracle and here, which is the asymmetry ADR 020 closes.
    #
    # Scanning is unconditional; REDACTION is off unless AGNOSAI_OUTPUT_REDACT=1,
    # because redaction rewrites a legitimate answer that happens to look like a
    # secret. These assert the gate in both positions.
    var of_agent = agnosai_agent_new(str_from("filter-agent"), str_from("tester"),
      str_from("test output filtering"));
    var of_task = str_from("task-of");
    var leaky = str_from("here is the key sk-ABCDEFGHIJKLMNOPQRST0123 and mail a@b.com");

    # Default: content passes through untouched, findings are only logged.
    assert_eq(agnosai_output_redact_enabled(), 0, "redaction is OFF by default");
    assert(str_eq(_agnosai_crew_filter_output(leaky, of_agent, of_task), leaky) == 1,
      "with redaction off the response is returned verbatim");

    # ⚠ **This is the assertion that pins the WIRING, not just the helper.** It
    # drives `agnosai_execute_task` — the real entry point — and checks the
    # result content changed. An earlier version of this block tested
    # `_agnosai_crew_filter_output` directly, and a mutation that unwired the
    # filter from `agnosai_execute_task` passed the whole suite: exactly the
    # "built, tested, never called" failure ADR 020 exists to end.
    #
    # The no-client placeholder path is checked here; the LLM arm is checked
    # through the stub gateway in the execute_task block above. A test process
    # has no `setenv`, which is why the gate is a settable flag rather than a
    # getenv.
    #
    # ✅ **Both arms are now covered.** Until ADR 022 gave the hoosh client a chat
    # pointer, unwiring the filter from the LLM path in `agnosai_execute_task`
    # passed the entire suite, because nothing offline reached it. The stub
    # gateway's leaky answer above is what closes that.
    agnosai_output_redact_set_enabled(1);
    assert_eq(agnosai_output_redact_enabled(), 1, "the gate flips");
    var of_leaky_task = agnosai_task_new(leaky);
    var of_res = agnosai_execute_task(of_leaky_task, of_agent, 0, 0);
    assert(str_eq(agnosai_task_result_output(of_res), leaky) == 0,
      "agnosai_execute_task ROUTES its output through the filter — the key is gone");
    assert(agnosai_str_contains_ci_cstr(agnosai_task_result_output(of_res),
        "sk-ABCDEFGHIJKLMNOPQRST0123") == 0, "and specifically the API key is not present");
    agnosai_output_redact_set_enabled(0);
    assert_eq(agnosai_output_redact_enabled(), 0, "and flips back");

    # The scan itself must actually find something, or the assertion above is
    # vacuous — it would pass for a filter that scanned nothing at all.
    var of_findings = agnosai_output_scan(leaky, str_from("unrelated system prompt"));
    assert(vec_len(of_findings) > 0,
      "and the scan DOES flag that content — otherwise the pass-through proves nothing");

    # Clean content produces no findings, so the flag path is not a constant.
    assert_eq(vec_len(agnosai_output_scan(str_from("an ordinary answer"),
          str_from("unrelated system prompt"))), 0, "clean output flags nothing");

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
