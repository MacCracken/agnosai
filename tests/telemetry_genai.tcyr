# =========================================================================
# telemetry_genai.tcyr — tests for src/telemetry/genai.cyr
#
# Oracle: rust-old/src/telemetry/genai.rs's seven `#[test]` fns. Four are
# **vacuous** by construction — `assert!(span.is_disabled() || !span.is_disabled())`
# is a tautology, and three others build a span and drop it with
# `let _ = span; // Verify creation doesn't panic`. The three that assert
# anything check only the *shape* of the attribute constants.
#
# So the constants are ported and their shape re-asserted, and then the module
# is actually tested — through the key-addressed accessors, which is what makes
# the constants load-bearing rather than decorative.
#
# Since ADR 023 the vocabulary is the pinned semconv's, not the oracle's: the
# chat call is `chat`, a task is `invoke_agent`, a crew is `invoke_workflow`
# and a tool call is `execute_tool`. The oracle's tests are ported against the
# new names; what they asserted (shape, prefixes, creation) still holds.
#
# Past the oracle in nine places, the sharpest being:
#
#   * **the workflow span CARRIES `gen_ai.operation.name`.** The oracle's
#     `crew_span!` omitted it and the port reproduced that until ADR 023.
#   * **unset is distinguishable from zero.** The oracle declares three fields
#     `tracing::field::Empty` on the inference span; a 0/empty default would
#     make "no usage recorded" identical to "recorded 0 tokens".
#   * a **declared-but-Empty** field and an **undeclared** one both read back
#     absent — they collapse, because the wire carries neither.
#   * `record_usage` overwrites, matching `Span::record`, and every setter
#     takes span 0 — the off path builds no span at all.
#   * three prefix families, exclusive: `gen_ai.` for spec attributes,
#     `agnosai.` for the four this project invented, and `error.type`, base
#     semconv, with neither.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/core/mod.cyr"
include "src/telemetry/genai.cyr"
include "tests/test_helpers.cyr"

# Every attribute constant, for the sweeps the oracle does over an array.
fn _t_all_attrs(): i64 {
    var v = vec_new();
    vec_push(v, AGNOSAI_GENAI_OPERATION_NAME);
    vec_push(v, AGNOSAI_GENAI_PROVIDER_NAME);
    vec_push(v, AGNOSAI_GENAI_REQUEST_MODEL);
    vec_push(v, AGNOSAI_GENAI_RESPONSE_MODEL);
    vec_push(v, AGNOSAI_GENAI_USAGE_INPUT_TOKENS);
    vec_push(v, AGNOSAI_GENAI_USAGE_OUTPUT_TOKENS);
    vec_push(v, AGNOSAI_GENAI_RESPONSE_FINISH_REASONS);
    vec_push(v, AGNOSAI_GENAI_AGENT_NAME);
    vec_push(v, AGNOSAI_GENAI_AGENT_ID);
    vec_push(v, AGNOSAI_GENAI_TOOL_NAME);
    vec_push(v, AGNOSAI_GENAI_WORKFLOW_NAME);
    vec_push(v, AGNOSAI_GENAI_CREW_ID);
    vec_push(v, AGNOSAI_GENAI_TASK_ID);
    vec_push(v, AGNOSAI_GENAI_AGENT_KEY);
    vec_push(v, AGNOSAI_GENAI_REQUEST_TEMPERATURE);
    vec_push(v, AGNOSAI_GENAI_REQUEST_MAX_TOKENS);
    vec_push(v, AGNOSAI_GENAI_ERROR_TYPE);
    return v;
}

# The thirteen the OTel GenAI spec owns. `tool.name` and `workflow.name` moved
# here in ADR 023; the oracle had spelled them `agnosai.tool.name` and
# `agnosai.crew.name`.
fn _t_otel_attrs(): i64 {
    var v = vec_new();
    vec_push(v, AGNOSAI_GENAI_OPERATION_NAME);
    vec_push(v, AGNOSAI_GENAI_PROVIDER_NAME);
    vec_push(v, AGNOSAI_GENAI_REQUEST_MODEL);
    vec_push(v, AGNOSAI_GENAI_RESPONSE_MODEL);
    vec_push(v, AGNOSAI_GENAI_USAGE_INPUT_TOKENS);
    vec_push(v, AGNOSAI_GENAI_USAGE_OUTPUT_TOKENS);
    vec_push(v, AGNOSAI_GENAI_RESPONSE_FINISH_REASONS);
    vec_push(v, AGNOSAI_GENAI_AGENT_NAME);
    vec_push(v, AGNOSAI_GENAI_AGENT_ID);
    vec_push(v, AGNOSAI_GENAI_TOOL_NAME);
    vec_push(v, AGNOSAI_GENAI_WORKFLOW_NAME);
    vec_push(v, AGNOSAI_GENAI_REQUEST_TEMPERATURE);
    vec_push(v, AGNOSAI_GENAI_REQUEST_MAX_TOKENS);
    return v;
}

# The three this project invented and lists — not in the OTel spec.
# `agnosai.crew.task_count` is the fourth, spelled inline and checked below.
fn _t_agnosai_attrs(): i64 {
    var v = vec_new();
    vec_push(v, AGNOSAI_GENAI_CREW_ID);
    vec_push(v, AGNOSAI_GENAI_TASK_ID);
    vec_push(v, AGNOSAI_GENAI_AGENT_KEY);
    return v;
}

fn _t_starts_with(s, prefix): i64 {
    var n = strlen(prefix);
    if (strlen(s) < n) { return 0; }
    for (var i = 0; i < n; i = i + 1) {
        if (load8(s + i) != load8(prefix + i)) { return 0; }
    }
    return 1;
}

fn _t_has_dot(s): i64 {
    var n = strlen(s);
    for (var i = 0; i < n; i = i + 1) {
        if (load8(s + i) == 46) { return 1; }
    }
    return 0;
}

fn main(): i64 {
    # --- oracle: attr_constants_follow_otel_naming ----------------------
    assert_eq(_t_starts_with(AGNOSAI_GENAI_OPERATION_NAME, "gen_ai."), 1, "operation.name");
    assert_eq(_t_starts_with(AGNOSAI_GENAI_PROVIDER_NAME, "gen_ai."), 1, "provider.name");
    assert_eq(_t_starts_with(AGNOSAI_GENAI_REQUEST_MODEL, "gen_ai."), 1, "request.model");
    assert_eq(_t_starts_with(AGNOSAI_GENAI_USAGE_INPUT_TOKENS, "gen_ai."), 1, "input_tokens");
    assert_eq(_t_starts_with(AGNOSAI_GENAI_USAGE_OUTPUT_TOKENS, "gen_ai."), 1, "output_tokens");
    assert_eq(_t_starts_with(AGNOSAI_GENAI_AGENT_NAME, "gen_ai."), 1, "agent.name");

    # --- oracle: all_attr_constants_are_non_empty -----------------------
    var all = _t_all_attrs();
    assert_eq(vec_len(all), 17, "all seventeen attribute constants are present");
    var nonempty = 1;
    var dotted = 1;
    for (var i = 0; i < vec_len(all); i = i + 1) {
        if (strlen(vec_get(all, i)) == 0) { nonempty = 0; }
        if (_t_has_dot(vec_get(all, i)) == 0) { dotted = 0; }
    }
    assert_eq(nonempty, 1, "no attribute constant is empty");
    assert_eq(dotted, 1, "every attribute constant uses dotted naming");

    # --- oracle: otel_standard_attrs_use_gen_ai_prefix ------------------
    var otel = _t_otel_attrs();
    assert_eq(vec_len(otel), 13, "thirteen attributes come from the OTel GenAI spec");
    var all_gen_ai = 1;
    for (var i = 0; i < vec_len(otel); i = i + 1) {
        if (_t_starts_with(vec_get(otel, i), "gen_ai.") == 0) { all_gen_ai = 0; }
    }
    assert_eq(all_gen_ai, 1, "every OTel GenAI attribute carries the gen_ai. prefix");

    # --- oracle: agnosai_attrs_use_agnosai_prefix -----------------------
    var custom = _t_agnosai_attrs();
    assert_eq(vec_len(custom), 3, "three listed attributes are AgnosAI's own");
    var all_agnosai = 1;
    for (var i = 0; i < vec_len(custom); i = i + 1) {
        if (_t_starts_with(vec_get(custom, i), "agnosai.") == 0) { all_agnosai = 0; }
    }
    assert_eq(all_agnosai, 1, "every custom attribute carries the agnosai. prefix");

    # --- past the oracle: the prefix families are EXCLUSIVE -------------
    # The oracle checks each family separately, so an attribute in both lists —
    # or one renamed into the wrong family — passes both of its tests.
    var no_overlap = 1;
    for (var i = 0; i < vec_len(otel); i = i + 1) {
        if (_t_starts_with(vec_get(otel, i), "agnosai.") == 1) { no_overlap = 0; }
    }
    for (var i = 0; i < vec_len(custom); i = i + 1) {
        if (_t_starts_with(vec_get(custom, i), "gen_ai.") == 1) { no_overlap = 0; }
    }
    assert_eq(no_overlap, 1, "no attribute is in both families");
    # `error.type` is base semconv: the ONE key with neither prefix.
    assert_eq(_t_starts_with(AGNOSAI_GENAI_ERROR_TYPE, "gen_ai."), 0, "error.type is not gen_ai.");
    assert_eq(_t_starts_with(AGNOSAI_GENAI_ERROR_TYPE, "agnosai."), 0, "nor agnosai.");
    assert_eq(vec_len(otel) + vec_len(custom) + 1, vec_len(all),
      "and the families plus error.type partition the whole set — none is unclassified");

    # ⚠ Past the oracle: `agnosai.crew.task_count` is spelled INLINE in the
    # oracle's `crew_span!` rather than in `attrs`, so it is in neither of the
    # lists above and no oracle test covers it. It is still an emitted
    # attribute name and still has to be right.
    assert(str_eq_cstr(str_from(AGNOSAI_GENAI_CREW_TASK_COUNT),
        "agnosai.crew.task_count") == 1, "the inline crew task_count key is exact");

    # --- past the oracle: the exact spelling of every key ---------------
    # `starts_with("gen_ai.")` passes for a typo'd suffix. These are wire names
    # an OTLP backend matches literally, so they are asserted literally — and
    # each was read from the pinned semconv commit (ADR 023).
    assert(str_eq_cstr(str_from(AGNOSAI_GENAI_OPERATION_NAME), "gen_ai.operation.name") == 1,
      "operation.name is exact");
    assert(str_eq_cstr(str_from(AGNOSAI_GENAI_USAGE_INPUT_TOKENS),
        "gen_ai.usage.input_tokens") == 1, "input_tokens is exact");
    assert(str_eq_cstr(str_from(AGNOSAI_GENAI_USAGE_OUTPUT_TOKENS),
        "gen_ai.usage.output_tokens") == 1, "output_tokens is exact");
    assert(str_eq_cstr(str_from(AGNOSAI_GENAI_PROVIDER_NAME), "gen_ai.provider.name") == 1,
      "provider.name is exact — it replaced the deprecated gen_ai.system");
    assert(str_eq_cstr(str_from(AGNOSAI_GENAI_TOOL_NAME), "gen_ai.tool.name") == 1,
      "tool.name is exact — gen_ai., no longer agnosai.");
    assert(str_eq_cstr(str_from(AGNOSAI_GENAI_WORKFLOW_NAME), "gen_ai.workflow.name") == 1,
      "workflow.name is exact");
    assert(str_eq_cstr(str_from(AGNOSAI_GENAI_AGENT_ID), "gen_ai.agent.id") == 1,
      "agent.id is exact");
    assert(str_eq_cstr(str_from(AGNOSAI_GENAI_ERROR_TYPE), "error.type") == 1,
      "error.type is exact");
    assert(str_eq_cstr(str_from(AGNOSAI_GENAI_RESPONSE_FINISH_REASONS),
        "gen_ai.response.finish_reasons") == 1,
      "finish_reasons is exact — plural, the spec's string[]");
    assert(str_eq_cstr(str_from(AGNOSAI_GENAI_AGENT_KEY), "agnosai.agent.key") == 1,
      "agent.key is exact");

    # The four operation values, which are also the first word of every name.
    assert(str_eq_cstr(str_from(AGNOSAI_GENAI_OP_CHAT), "chat") == 1, "op chat");
    assert(str_eq_cstr(str_from(AGNOSAI_GENAI_OP_INVOKE_AGENT), "invoke_agent") == 1,
      "op invoke_agent");
    assert(str_eq_cstr(str_from(AGNOSAI_GENAI_OP_INVOKE_WORKFLOW), "invoke_workflow") == 1,
      "op invoke_workflow");
    assert(str_eq_cstr(str_from(AGNOSAI_GENAI_OP_EXECUTE_TOOL), "execute_tool") == 1,
      "op execute_tool");

    var al = default_alloc();

    # --- oracle: inference_span_creates_span — now the chat span --------
    var inf = agnosai_genai_chat_span(str_from("llama3:70b"), str_from("hoosh"));
    assert(inf != 0, "a chat span is created");
    assert(str_eq_cstr(str_from(agnosai_genai_span_name(inf)), "chat") == 1,
      "its operation is chat");
    assert(str_eq_cstr(agnosai_genai_span_full_name_a(al, inf), "chat llama3:70b") == 1,
      "and it is named `chat {request.model}`");

    # --- past the oracle: its attributes are readable and correct -------
    assert(str_eq_cstr(agnosai_genai_span_attr_str(inf, AGNOSAI_GENAI_OPERATION_NAME),
        "chat") == 1, "gen_ai.operation.name is chat");
    assert(str_eq_cstr(agnosai_genai_span_attr_str(inf, AGNOSAI_GENAI_PROVIDER_NAME),
        "hoosh") == 1, "the provider round-trips");
    assert(str_eq_cstr(agnosai_genai_span_attr_str(inf, AGNOSAI_GENAI_REQUEST_MODEL),
        "llama3:70b") == 1, "requested model round-trips");
    assert_eq(agnosai_genai_span_attr_str(inf, AGNOSAI_GENAI_AGENT_NAME), 0,
      "a chat span names no agent — that is its invoke_agent parent's");
    assert_eq(agnosai_genai_span_attr_str(inf, AGNOSAI_GENAI_ERROR_TYPE), 0,
      "and has no error.type until one is set");

    # ⚠ The three `tracing::field::Empty` fields read back UNSET, and unset is
    # not zero: a 0/empty default would make "no usage recorded" identical to
    # "recorded 0 tokens", which is the whole reason the oracle declares them
    # Empty rather than defaulting them.
    assert_eq(agnosai_genai_span_attr_int(inf, AGNOSAI_GENAI_USAGE_INPUT_TOKENS), 0 - 1,
      "input tokens start UNSET, not 0");
    assert_eq(agnosai_genai_span_attr_int(inf, AGNOSAI_GENAI_USAGE_OUTPUT_TOKENS), 0 - 1,
      "output tokens start UNSET");
    assert_eq(agnosai_genai_span_attr_str(inf, AGNOSAI_GENAI_RESPONSE_MODEL), 0,
      "and the response model starts absent");

    # --- oracle: record_usage_does_not_panic ----------------------------
    # The oracle asserts nothing beyond "no panic". Here it has to land.
    var rec = agnosai_genai_chat_span(str_from("gpt-4"), str_from("hoosh"));
    agnosai_genai_record_usage(rec, 100, 50, str_from("gpt-4-0613"));
    assert_eq(agnosai_genai_span_attr_int(rec, AGNOSAI_GENAI_USAGE_INPUT_TOKENS), 100,
      "input tokens recorded");
    assert_eq(agnosai_genai_span_attr_int(rec, AGNOSAI_GENAI_USAGE_OUTPUT_TOKENS), 50,
      "output tokens recorded");
    assert(str_eq_cstr(agnosai_genai_span_attr_str(rec, AGNOSAI_GENAI_RESPONSE_MODEL),
        "gpt-4-0613") == 1, "and the responding model, which DIFFERS from the requested one");
    assert(str_eq_cstr(agnosai_genai_span_attr_str(rec, AGNOSAI_GENAI_REQUEST_MODEL),
        "gpt-4") == 1, "the requested model is untouched by record_usage");
    assert(str_eq_cstr(agnosai_genai_span_full_name_a(al, rec), "chat gpt-4") == 1,
      "so the name keeps the REQUESTED model, as the spec says");

    # ⚠ Zero tokens is a real recording, distinct from unset.
    var zero = agnosai_genai_chat_span(str_from("m"), str_from("s"));
    agnosai_genai_record_usage(zero, 0, 0, str_from("m"));
    assert_eq(agnosai_genai_span_attr_int(zero, AGNOSAI_GENAI_USAGE_INPUT_TOKENS), 0,
      "recording 0 tokens reads back 0, not unset");

    # ⚠ `Span::record` overwrites, so a second call wins.
    agnosai_genai_record_usage(rec, 7, 8, str_from("second"));
    assert_eq(agnosai_genai_span_attr_int(rec, AGNOSAI_GENAI_USAGE_INPUT_TOKENS), 7,
      "a second record_usage overwrites rather than accumulating");
    assert(str_eq_cstr(agnosai_genai_span_attr_str(rec, AGNOSAI_GENAI_RESPONSE_MODEL),
        "second") == 1, "including the model");

    # --- the invoke_agent span (ADR 023) --------------------------------
    var ag = agnosai_genai_agent_span(str_from("Analyst"), str_from("analyst"),
      str_from("task-9"));
    assert(str_eq_cstr(str_from(agnosai_genai_span_name(ag)), "invoke_agent") == 1,
      "an agent span's operation is invoke_agent");
    assert(str_eq_cstr(agnosai_genai_span_full_name_a(al, ag), "invoke_agent Analyst") == 1,
      "named `invoke_agent {agent.name}`");
    assert(str_eq_cstr(agnosai_genai_span_attr_str(ag, AGNOSAI_GENAI_OPERATION_NAME),
        "invoke_agent") == 1, "carrying the operation");
    assert(str_eq_cstr(agnosai_genai_span_attr_str(ag, AGNOSAI_GENAI_AGENT_NAME),
        "Analyst") == 1, "the agent's name");
    assert(str_eq_cstr(agnosai_genai_span_attr_str(ag, AGNOSAI_GENAI_AGENT_KEY),
        "analyst") == 1, "its key, as agnosai.agent.key");
    assert(str_eq_cstr(agnosai_genai_span_attr_str(ag, AGNOSAI_GENAI_TASK_ID),
        "task-9") == 1, "and the task id");
    # ⚠ The key is NOT `gen_ai.agent.id`, which the pinned registry reserves
    # for a hosted agent's provider-assigned id.
    assert_eq(agnosai_genai_span_attr_str(ag, AGNOSAI_GENAI_AGENT_ID), 0,
      "gen_ai.agent.id stays absent — an in-process agent has no hosted id");
    assert_eq(agnosai_genai_span_attr_str(ag, AGNOSAI_GENAI_REQUEST_MODEL), 0,
      "no model until the runner chooses one");
    agnosai_genai_span_set_request_model(ag, str_from("llama3"));
    assert(str_eq_cstr(agnosai_genai_span_attr_str(ag, AGNOSAI_GENAI_REQUEST_MODEL),
        "llama3") == 1, "set_request_model sets it");
    assert(str_eq_cstr(agnosai_genai_span_full_name_a(al, ag), "invoke_agent Analyst") == 1,
      "without changing the agent span's name");
    agnosai_genai_span_set_error_type(ag, str_from("task_failed"));
    assert(str_eq_cstr(agnosai_genai_span_attr_str(ag, AGNOSAI_GENAI_ERROR_TYPE),
        "task_failed") == 1, "set_error_type sets error.type");

    # Every argument may be 0: an unassigned task still runs.
    var anon = agnosai_genai_agent_span(0, 0, 0);
    assert_eq(agnosai_genai_span_attr_str(anon, AGNOSAI_GENAI_AGENT_NAME), 0, "no name");
    assert_eq(agnosai_genai_span_attr_str(anon, AGNOSAI_GENAI_AGENT_KEY), 0, "no key");
    assert_eq(agnosai_genai_span_attr_str(anon, AGNOSAI_GENAI_TASK_ID), 0, "no task id");
    assert(str_eq_cstr(agnosai_genai_span_full_name_a(al, anon), "invoke_agent") == 1,
      "and a span with no subject is named by its bare operation");
    var blank = agnosai_genai_agent_span(str_from(""), 0, 0);
    assert(str_eq_cstr(agnosai_genai_span_full_name_a(al, blank), "invoke_agent") == 1,
      "an EMPTY subject too — never `invoke_agent ` with a trailing space");

    # --- oracle: tool_span_creates_span ---------------------------------
    var tool = agnosai_genai_tool_span(str_from("echo"), str_from("agent-a"),
      str_from("task-1"));
    assert(tool != 0, "a tool span is created");
    assert(str_eq_cstr(str_from(agnosai_genai_span_name(tool)), "execute_tool") == 1,
      "its operation is execute_tool");
    assert(str_eq_cstr(agnosai_genai_span_full_name_a(al, tool), "execute_tool echo") == 1,
      "named `execute_tool {tool.name}`");
    assert(str_eq_cstr(agnosai_genai_span_attr_str(tool, AGNOSAI_GENAI_OPERATION_NAME),
        "execute_tool") == 1, "operation is execute_tool");
    assert(str_eq_cstr(agnosai_genai_span_attr_str(tool, AGNOSAI_GENAI_TOOL_NAME),
        "echo") == 1, "the tool name round-trips");

    # ⚠ Past the oracle: a tool span carries NO model or token fields — not even
    # empty ones. A declared-but-Empty field and an undeclared one both read
    # absent, because the wire carries neither.
    assert_eq(agnosai_genai_span_attr_str(tool, AGNOSAI_GENAI_REQUEST_MODEL), 0,
      "a tool span has no requested model");
    assert_eq(agnosai_genai_span_attr_int(tool, AGNOSAI_GENAI_USAGE_INPUT_TOKENS), 0 - 1,
      "and no token fields");
    assert_eq(agnosai_genai_span_attr_str(tool, AGNOSAI_GENAI_PROVIDER_NAME), 0,
      "and no provider");

    # --- oracle: crew_span_creates_span — now the workflow span ---------
    var crew = agnosai_genai_workflow_span(str_from("crew-123"), str_from("test-crew"), 5);
    assert(crew != 0, "a workflow span is created");
    assert(str_eq_cstr(str_from(agnosai_genai_span_name(crew)), "invoke_workflow") == 1,
      "its operation is invoke_workflow");
    assert(str_eq_cstr(agnosai_genai_span_full_name_a(al, crew),
        "invoke_workflow test-crew") == 1, "named `invoke_workflow {workflow.name}`");
    assert(str_eq_cstr(agnosai_genai_span_attr_str(crew, AGNOSAI_GENAI_CREW_ID),
        "crew-123") == 1, "the crew id round-trips");
    assert(str_eq_cstr(agnosai_genai_span_attr_str(crew, AGNOSAI_GENAI_WORKFLOW_NAME),
        "test-crew") == 1, "and the crew name, as gen_ai.workflow.name");
    assert_eq(agnosai_genai_span_attr_int(crew, AGNOSAI_GENAI_CREW_TASK_COUNT), 5,
      "and the task count");

    # ⚠ ADR 023 REVERSES the oracle here. Its `crew_span!` omits
    # `gen_ai.operation.name` while its other two spans set it, so a backend
    # grouping by operation saw crew runs as unclassified. The port reproduced
    # that until ADR 023; the pinned convention makes the operation Required.
    assert(str_eq_cstr(agnosai_genai_span_attr_str(crew, AGNOSAI_GENAI_OPERATION_NAME),
        "invoke_workflow") == 1,
      "a workflow span CARRIES gen_ai.operation.name = invoke_workflow (ADR 023)");

    # ⚠ A task count of 0 is a real value, distinct from the -1 the other spans
    # report for it.
    var empty_crew = agnosai_genai_workflow_span(str_from("c"), str_from("n"), 0);
    assert_eq(agnosai_genai_span_attr_int(empty_crew, AGNOSAI_GENAI_CREW_TASK_COUNT), 0,
      "a crew with no tasks reports 0");
    assert_eq(agnosai_genai_span_attr_int(inf, AGNOSAI_GENAI_CREW_TASK_COUNT), 0 - 1,
      "while a non-crew span reports the count as unset");

    # --- the subject of each name, and the bare-op fallback --------------
    assert(str_eq_cstr(agnosai_genai_span_full_name_a(al,
          agnosai_genai_chat_span(0, str_from("hoosh"))), "chat") == 1,
      "a chat span with no model is just `chat`");
    assert(str_eq_cstr(agnosai_genai_span_full_name_a(al,
          agnosai_genai_workflow_span(0, str_from(""), 1)), "invoke_workflow") == 1,
      "a crew with an empty name is just `invoke_workflow`");
    assert(str_eq_cstr(agnosai_genai_span_full_name_a(al,
          agnosai_genai_tool_span(0, 0, 0)), "execute_tool") == 1,
      "and a tool with no name is just `execute_tool`");
    # Each operation takes ITS subject, not another span kind's: a chat span
    # that happened to carry a tool name is still named by its model.
    var mixed = agnosai_genai_chat_span(str_from("gpt-4o"), 0);
    store64(mixed + AGN_GAS_TOOL_NAME, str_from("not-me"));
    store64(mixed + AGN_GAS_AGENT_NAME, str_from("nor-me"));
    store64(mixed + AGN_GAS_WORKFLOW_NAME, str_from("nor-this"));
    assert(str_eq_cstr(agnosai_genai_span_full_name_a(al, mixed), "chat gpt-4o") == 1,
      "chat takes the request model and nothing else");
    store64(mixed + AGN_GAS_NAME, AGNOSAI_GENAI_OP_EXECUTE_TOOL);
    store64(mixed + AGN_GAS_OPERATION, str_from("execute_tool"));
    assert(str_eq_cstr(agnosai_genai_span_full_name_a(al, mixed), "execute_tool not-me") == 1,
      "execute_tool takes the tool name");
    store64(mixed + AGN_GAS_NAME, AGNOSAI_GENAI_OP_INVOKE_AGENT);
    store64(mixed + AGN_GAS_OPERATION, str_from("invoke_agent"));
    assert(str_eq_cstr(agnosai_genai_span_full_name_a(al, mixed), "invoke_agent nor-me") == 1,
      "invoke_agent takes the agent name");
    store64(mixed + AGN_GAS_NAME, AGNOSAI_GENAI_OP_INVOKE_WORKFLOW);
    store64(mixed + AGN_GAS_OPERATION, str_from("invoke_workflow"));
    assert(str_eq_cstr(agnosai_genai_span_full_name_a(al, mixed),
        "invoke_workflow nor-this") == 1, "invoke_workflow takes the workflow name");

    # The subject on its own: what the encoder appends after the operation.
    assert(str_eq_cstr(agnosai_genai_span_name_suffix(rec), "gpt-4") == 1,
      "a chat span's subject is its requested model");
    assert(str_eq_cstr(agnosai_genai_span_name_suffix(crew), "test-crew") == 1,
      "a workflow span's is its crew name");
    assert_eq(agnosai_genai_span_name_suffix(anon), 0, "an absent subject is 0");
    assert_eq(agnosai_genai_span_name_suffix(blank), 0, "and so is an empty one");

    # --- setters take span 0 (ADR 023: the off path builds no span) -----
    assert_eq(agnosai_genai_record_usage(0, 1, 2, str_from("m")), 0,
      "record_usage on span 0 is a no-op, not a fault");
    assert_eq(agnosai_genai_span_set_request_model(0, str_from("m")), 0,
      "set_request_model on span 0 too");
    assert_eq(agnosai_genai_span_set_error_type(0, str_from("x")), 0,
      "and set_error_type");

    # --- past the oracle: unknown keys are absent, not a fault ----------
    assert_eq(agnosai_genai_span_attr_str(inf, "not.a.real.key"), 0,
      "an unknown string key answers absent");
    assert_eq(agnosai_genai_span_attr_int(inf, "not.a.real.key"), 0 - 1,
      "an unknown integer key answers unset");
    # A key from the *other* accessor's family is likewise absent, not crossed.
    assert_eq(agnosai_genai_span_attr_str(inf, AGNOSAI_GENAI_USAGE_INPUT_TOKENS), 0,
      "an integer attribute is not readable as a string");
    assert_eq(agnosai_genai_span_attr_int(inf, AGNOSAI_GENAI_REQUEST_MODEL), 0 - 1,
      "nor a string attribute as an integer");

    # --- past the oracle: spans are independent -------------------------
    # One record holds each span's attributes, so two spans of the same kind
    # must not share. A file-scope record would pass every single-span test.
    var a = agnosai_genai_tool_span(str_from("first"), str_from("agent"), str_from("t1"));
    var b = agnosai_genai_tool_span(str_from("second"), str_from("agent"), str_from("t2"));
    assert(str_eq_cstr(agnosai_genai_span_attr_str(a, AGNOSAI_GENAI_TOOL_NAME),
        "first") == 1, "the first tool span keeps its own name");
    assert(str_eq_cstr(agnosai_genai_span_attr_str(b, AGNOSAI_GENAI_TOOL_NAME),
        "second") == 1, "and the second keeps its own");
    agnosai_genai_record_usage(inf, 1, 2, str_from("x"));
    assert_eq(agnosai_genai_span_attr_int(rec, AGNOSAI_GENAI_USAGE_INPUT_TOKENS), 7,
      "recording on one inference span does not touch another");

    # --- past the oracle: scope is explicit, and balanced ---------------
    # `info_span!` builds without entering — the oracle's own example never
    # enters — so construction must not have touched sakshi's span stack.
    var depth0 = sakshi_span_depth();
    var scoped = agnosai_genai_tool_span(str_from("t"), str_from("a"), str_from("1"));
    assert_eq(sakshi_span_depth(), depth0, "creating a span does NOT enter it");
    agnosai_genai_span_enter(scoped);
    assert_eq(sakshi_span_depth(), depth0 + 1, "entering pushes one frame");
    agnosai_genai_span_enter(scoped);
    assert_eq(sakshi_span_depth(), depth0 + 2, "and nests");
    agnosai_genai_span_exit();
    agnosai_genai_span_exit();
    assert_eq(sakshi_span_depth(), depth0, "and exits unwind back to where they started");

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
