# =========================================================================
# test_helpers — shared assertion helpers for agnosai's .tcyr suites.
#
# NOT a test file itself (`cyrius tests` only picks up .tcyr), and NOT part of
# the coverage corpus. Include it from a .tcyr after the src modules under test.
#
# Every symbol here is `_t_`-prefixed: the port plan bans a .tcyr from defining
# any fn that shadows a src/ symbol, and the prefix makes that impossible by
# construction while keeping these out of the coverage denominator.
# =========================================================================

# 1e-9 as an f64 bit pattern — the tolerance rust-old's learning tests use.
fn _t_f64_epsilon(): i64 {
    return 0x3E112E0BE826D695;
}

# Whether two f64 bit patterns are within 1e-9 of each other.
fn _t_f64_near(a, b): i64 {
    return f64_lt(f64_abs(f64_sub(a, b)), _t_f64_epsilon());
}

# Assert that an f64 bit pattern is within 1e-9 of `expected`.
fn _t_assert_f64(actual, expected, name): i64 {
    return assert(_t_f64_near(actual, expected), name);
}

# Build an f64 bit pattern for the rational num/den — the readable spelling for
# the exact fractions the oracle's tests assert against (2/3, 1/2, 0/1).
fn _t_f64_ratio(num, den): i64 {
    return f64_div(f64_from(num), f64_from(den));
}
