# =========================================================================
# server_prometheus.tcyr — parity tests for src/server/prometheus.cyr
#
# Oracle: the #[cfg(test)] block in rust-old/src/server/prometheus.rs — 8 tests.
#
# The exposition format is a wire contract: a scraper's dashboards key on the
# metric names and the HELP/TYPE lines, so this asserts the whole output byte
# for byte rather than the oracle's `contains` spot-checks.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/server/prometheus.cyr"
include "tests/test_helpers.cyr"

# One metric family's three lines, exactly as the exposition format wants them.
fn _t_family(name, help, kind, value): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "# HELP ");
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, help);
    str_builder_add_cstr(sb, "\n# TYPE ");
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, kind);
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, value);
    str_builder_add_cstr(sb, "\n");
    return str_builder_build(sb);
}

# Assert a rendered line appears in the exposition.
fn _t_line(out, line, name): i64 {
    return assert(str_contains(out, str_from(line)) == 1, name);
}

fn main() {
    alloc_init();

    test_group("server_prometheus");

    assert_eq(AGNOSAI_MICRO_PER_USD, 1000000, "a dollar is a million micro-USD");

    # --- new_metrics_all_zero / default_is_same_as_new ---
    var m = agnosai_metrics_new();
    assert_eq(agnosai_metrics_crews_total(m), 0, "a new metrics set starts at zero");
    assert_eq(agnosai_metrics_crews_active(m), 0, "for the active gauge");
    assert_eq(agnosai_metrics_tasks_completed(m), 0, "completed tasks");
    assert_eq(agnosai_metrics_tasks_failed(m), 0, "failed tasks");
    assert_eq(agnosai_metrics_tokens_total(m), 0, "tokens");
    assert_eq(agnosai_metrics_cost_micro_usd(m), 0, "and cost");

    # --- record_crew_lifecycle ---
    agnosai_metrics_record_crew_started(m);
    assert_eq(agnosai_metrics_crews_total(m), 1, "starting a crew raises the total");
    assert_eq(agnosai_metrics_crews_active(m), 1, "and the active gauge");

    agnosai_metrics_record_crew_started(m);
    assert_eq(agnosai_metrics_crews_total(m), 2, "a second crew raises both again");
    assert_eq(agnosai_metrics_crews_active(m), 2, "to two active");

    agnosai_metrics_record_crew_completed(m);
    assert_eq(agnosai_metrics_crews_active(m), 1, "finishing one lowers the gauge");
    assert_eq(agnosai_metrics_crews_total(m), 2,
    "but NOT the total — it is monotonic, which is what makes it a counter rather than a gauge");

    # --- crew_completed_does_not_underflow ---
    var u = agnosai_metrics_new();
    agnosai_metrics_record_crew_completed(u);
    assert_eq(agnosai_metrics_crews_active(u), 0,
    "completing a crew that never started leaves the gauge at zero — a plain decrement would \
    WRAP to a huge value and the metric would read as nonsense rather than merely wrong");
    agnosai_metrics_record_crew_completed(u);
    agnosai_metrics_record_crew_completed(u);
    assert_eq(agnosai_metrics_crews_active(u), 0, "and repeating it stays at zero");

    # --- record_tasks ---
    agnosai_metrics_record_task_completed(m);
    agnosai_metrics_record_task_completed(m);
    agnosai_metrics_record_task_failed(m);
    assert_eq(agnosai_metrics_tasks_completed(m), 2, "completed tasks accumulate");
    assert_eq(agnosai_metrics_tasks_failed(m), 1, "and failed ones separately");

    # --- record_inference ---
    # The port takes micro-USD directly; the oracle takes an f64 USD and
    # truncates it into the same integer slot.
    agnosai_metrics_record_inference(m, 500, 25000);
    assert_eq(agnosai_metrics_tokens_total(m), 500, "tokens accumulate");
    assert_eq(agnosai_metrics_cost_micro_usd(m), 25000, "and cost, in micro-USD");
    agnosai_metrics_record_inference(m, 250, 12500);
    assert_eq(agnosai_metrics_tokens_total(m), 750, "across calls");
    assert_eq(agnosai_metrics_cost_micro_usd(m), 37500, "for both");

    # --- gather_empty_metrics, byte for byte ---
    # A family's three lines, built the way the module builds them.
    var empty = agnosai_metrics_gather(agnosai_metrics_new());
    assert(str_eq(empty, str_cat(str_cat(
    _t_family("agnosai_crews_total", "Total number of crews created.", "counter", "0"),
    _t_family("agnosai_crews_active", "Number of currently active crews.", "gauge", "0")),
    str_cat(str_cat(
    _t_family("agnosai_tasks_completed_total", "Total tasks completed successfully.",
    "counter", "0"),
    _t_family("agnosai_tasks_failed_total", "Total tasks that failed.", "counter", "0")),
    str_cat(
    _t_family("agnosai_inference_tokens_total", "Total inference tokens processed.",
    "counter", "0"),
    _t_family("agnosai_inference_cost_usd_total", "Total inference cost in USD.",
    "counter", "0.000000"))))) == 1,
    "an empty metrics set renders all six families in full — the oracle only spot-checks with \
    `contains`, but the names and HELP text are a wire contract a scraper's dashboards key on");

    # every line is newline-terminated, including the last
    assert_eq(load8(str_data(empty) + str_len(empty) - 1), 10,
    "the exposition ends with a newline, as the format requires");

    # --- gather_format ---
    var g = agnosai_metrics_new();
    agnosai_metrics_record_crew_started(g);
    agnosai_metrics_record_task_completed(g);
    agnosai_metrics_record_inference(g, 500, 25000);
    var out = agnosai_metrics_gather(g);
    _t_line(out, "# TYPE agnosai_crews_total counter", "the total is typed as a counter");
    _t_line(out, "agnosai_crews_total 1", "and reports one crew");
    _t_line(out, "# TYPE agnosai_crews_active gauge",
    "the active metric is typed as a GAUGE, not a counter — it can go down");
    _t_line(out, "agnosai_crews_active 1", "with one active");
    _t_line(out, "agnosai_tasks_completed_total 1", "one task completed");
    _t_line(out, "agnosai_tasks_failed_total 0", "none failed");
    _t_line(out, "agnosai_inference_tokens_total 500", "500 tokens");
    _t_line(out, "agnosai_inference_cost_usd_total 0.025000",
    "and the cost as dollars to six decimals — 25000 micro-USD is $0.025000");

    # --- the fixed-point renderer, which replaces the oracle's f64 round trip ---
    # Integer split rather than micro/1e6 formatted as {:.6}, so the value that
    # arrives is the value printed. This is the only place in the port's cost
    # path where a float could have introduced representation error.
    var fp = agnosai_metrics_new();
    agnosai_metrics_record_inference(fp, 0, 1);
    assert(str_contains(agnosai_metrics_gather(fp),
    str_from("agnosai_inference_cost_usd_total 0.000001")) == 1,
    "one micro-USD renders as 0.000001 — the smallest representable amount is not lost");

    var big = agnosai_metrics_new();
    agnosai_metrics_record_inference(big, 0, 1234567890);
    assert(str_contains(agnosai_metrics_gather(big),
    str_from("agnosai_inference_cost_usd_total 1234.567890")) == 1,
    "and $1234.567890 renders exactly, with no float rounding at the dollar boundary");

    var whole = agnosai_metrics_new();
    agnosai_metrics_record_inference(whole, 0, 2000000);
    assert(str_contains(agnosai_metrics_gather(whole),
    str_from("agnosai_inference_cost_usd_total 2.000000")) == 1,
    "a whole number of dollars keeps all six decimal places rather than collapsing to \"2\"");

    var sub = agnosai_metrics_new();
    agnosai_metrics_record_inference(sub, 0, 999999);
    assert(str_contains(agnosai_metrics_gather(sub),
    str_from("agnosai_inference_cost_usd_total 0.999999")) == 1,
    "and just under a dollar does not round up to 1.000000");

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
