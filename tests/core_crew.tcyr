# =========================================================================
# core_crew.tcyr — parity tests for src/core/crew.cyr
#
# Oracle: the #[cfg(test)] tests in rust-old/src/core/crew.rs, plus explicit
# coverage of the `skip_serializing_if` omissions, which are wire-visible and
# which a round-trip test alone would not catch.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/core/error.cyr"
include "src/core/json.cyr"
include "src/id.cyr"
include "src/core/message.cyr"
include "src/core/resource.cyr"
include "src/core/task.cyr"
include "src/core/agent.cyr"
include "src/core/crew.cyr"
include "tests/test_helpers.cyr"

# **The JSON keys are minted once, not per serialised object.**
#
# `AGN_JK_*` in `core/crew.cyr` and `core/task.cyr` are process-lifetime `Str`s
# over static literals. Re-allocating them with `str_from_a` costs ~32 ns and a
# 16-byte header *each*, and there are fifteen across the crew serialisers —
# measured at 27% of `agnosai_crew_state_to_value_a` (1,661 → 1,216 ns) and 17%
# of `GET /api/v1/crews/{id}`.
#
# The bound is on **arena bytes for one call**, because that is where a
# re-allocated key would land now that the route is threaded. Baseline 1,488 B;
# putting the fifteen keys back adds 15 × 16 = 240 B, so 1,600 separates them
# with headroom on both sides.
fn _t_crew_json_keys_are_hoisted(): i64 {
    var st = agnosai_crew_state_new(str_from("id-1"), AGNOSAI_CREW_COMPLETED);
    agnosai_crew_state_with_result(st, agnosai_task_result_new(str_from("t-1"),
    str_from("out"), AGNOSAI_STATUS_COMPLETED));
    agnosai_crew_state_with_profile(st, agnosai_crew_profile_new());

    var ar = arena_allocator(65536);
    agnosai_crew_state_to_value_a(ar, st);
    reset_via(ar);
    agnosai_crew_state_to_value_a(ar, st);
    var used = arena_used(allocator_state(ar));

    assert(used > 0, "the serialiser does build into the arena");
    assert(used < 1600,
    "one crew_state_to_value_a stays under 1,600 arena bytes — re-minting the \
    fifteen AGN_JK_* keys per call would add 240 and cross it");

    # **Pointer identity, which is exact where the byte bound is not.** A single
    # re-allocated key is 16 bytes and vanishes inside any usable threshold; the
    # key the object actually carries either *is* the global or it is not.
    var v = agnosai_crew_state_to_value_a(ar, st);
    assert(bayan_json_v_obj_key(v, 0) == AGN_JK_CREW_ID,
    "the crew_id key in the built object IS the global — not a copy of it");
    assert(bayan_json_v_obj_key(v, 1) == AGN_JK_STATUS, "...and status");
    assert(bayan_json_v_obj_key(v, 2) == AGN_JK_RESULTS, "...and results");
    assert(bayan_json_v_obj_key(v, 3) == AGN_JK_PROFILE, "...and profile");

    var res_v = bayan_json_v_arr_get(bayan_json_v_obj_val(v, 2), 0);
    assert(bayan_json_v_obj_key(res_v, 0) == AGN_JK_TASK_ID,
    "...and `core/task.cyr`'s keys likewise, through the nested result");

    var prof_v = bayan_json_v_obj_val(v, 3);
    assert(bayan_json_v_obj_key(prof_v, 0) == AGN_JK_WALL_MS,
    "...and the profile's, through the nested object");

    assert(str_eq_cstr(AGN_JK_CREW_ID, "crew_id") == 1, "and the spelling is the wire key");
    assert(str_eq_cstr(AGN_JK_TASK_ID, "task_id") == 1, "...for task.cyr too");
    return 0;
}

# The wire **values** are hoisted the same way the keys are, and need the same
# exact assertion for the same reason: a status spelling re-minted per call is
# one 16-byte allocation, invisible to any byte bound, and the only difference
# a caller can observe is the pointer.
#
# These also pin the sharing. `core/json.cyr` deliberately holds ONE `"completed"`
# for the crew status, the task status and the agent state — so if a later edit
# gives any of them a private copy, the identity here fails even though every
# spelling still matches. That is the point: one literal, one `Str`.
fn _t_wire_values_are_hoisted(): i64 {
    var ar = arena_allocator(4096);
    assert(agnosai_crew_status_to_wire_a(ar, AGNOSAI_CREW_COMPLETED) == AGN_JV_COMPLETED,
    "a crew status IS the global, not a fresh Str");
    assert(agnosai_crew_status_to_wire_a(ar, AGNOSAI_CREW_PENDING) == AGN_JV_PENDING,
    "...including the fall-through arm");
    assert(agnosai_task_status_to_wire_a(ar, AGNOSAI_STATUS_COMPLETED) == AGN_JV_COMPLETED,
    "a task status is the SAME global the crew status uses");
    assert(agnosai_task_risk_to_wire_a(ar, AGNOSAI_RISK_HIGH) == AGN_JV_HIGH,
    "risk likewise");
    assert(agnosai_task_priority_to_wire_a(ar, AGNOSAI_PRIORITY_HIGH) == AGN_JV_HIGH,
    "...and priority shares risk's `high`");

    # The arena is the proof that nothing was drawn from it: had any arm called
    # `str_from_a`, this would be non-zero.
    assert_eq(arena_used(allocator_state(ar)), 0,
    "five wire lookups allocate nothing at all");

    # The bare forms delegate through `default_alloc()`, so they answer the same
    # pointers — this is what stops the crew_runner event path from leaking a
    # spelling per task onto the no-free global bump.
    assert(agnosai_crew_status_to_wire(AGNOSAI_CREW_FAILED) == AGN_JV_FAILED,
    "the bare form answers the global too");
    assert(agnosai_task_status_to_wire(AGNOSAI_STATUS_CANCELLED) == AGN_JV_CANCELLED,
    "...for tasks as well");

    # Spelling is still the wire's, not just a shared pointer.
    assert(str_eq_cstr(AGN_JV_COMPLETED, "completed") == 1, "and the spelling is snake_case");
    assert(str_eq_cstr(AGN_JV_HIGH, "high") == 1, "...for the shared `high` too");
    return 0;
}

fn main() {
    alloc_init();

    test_group("core_crew");

    # --- crew_spec_new_generates_unique_id ---
    var c1 = agnosai_crew_new(str_from("crew-a"));
    var c2 = agnosai_crew_new(str_from("crew-b"));
    assert_eq(str_eq(agnosai_crew_id(c1), agnosai_crew_id(c2)), 0, "crew ids are unique");

    # --- crew_spec_new_defaults ---
    var c = agnosai_crew_new(str_from("my crew"));
    assert(str_eq(agnosai_crew_name(c), str_from("my crew")) == 1, "name set");
    assert_eq(vec_len(agnosai_crew_agents(c)), 0, "agents default to empty");
    assert_eq(vec_len(agnosai_crew_tasks(c)), 0, "tasks default to empty");
    assert_eq(agnosai_process_kind(agnosai_crew_process(c)), AGNOSAI_PROCESS_SEQUENTIAL,
    "process defaults to sequential");
    assert_eq(map_size(agnosai_crew_metadata(c)), 0, "metadata defaults to empty");
    assert(str_eq(agnosai_crew_trust_level(c), str_from("basic")) == 1, "trust_level defaults to basic");
    assert(str_eq(agnosai_default_trust_level(), str_from("basic")) == 1, "default trust level is basic");

    # --- crew_status_default_is_pending + snake_case round trip ---
    assert_eq(AGNOSAI_CREW_PENDING, 0, "pending is the default status");
    var st_ok = 1;
    for (var s = AGNOSAI_CREW_PENDING; s <= AGNOSAI_CREW_CANCELLED; s = s + 1) {
        if (agnosai_crew_status_from_wire(agnosai_crew_status_to_wire(s)) != s) { st_ok = 0; }
    }
    assert(st_ok, "every crew status round-trips through its wire spelling");
    assert(str_eq(agnosai_crew_status_to_wire(AGNOSAI_CREW_PENDING), str_from("pending")) == 1, "wire pending");
    assert(str_eq(agnosai_crew_status_to_wire(AGNOSAI_CREW_RUNNING), str_from("running")) == 1, "wire running");
    assert(str_eq(agnosai_crew_status_to_wire(AGNOSAI_CREW_CANCELLED), str_from("cancelled")) == 1, "wire cancelled");
    assert_eq(agnosai_crew_status_from_wire(str_from("bogus")), AGNOSAI_CREW_PENDING, "unknown status -> pending");

    # --- builders ---
    var agents = vec_new();
    vec_push(agents, agnosai_agent_new(str_from("a1"), str_from("worker"), str_from("work")));
    var tasks = vec_new();
    vec_push(tasks, agnosai_task_new(str_from("t1")));
    agnosai_crew_with_agents(c, agents);
    agnosai_crew_with_tasks(c, tasks);
    agnosai_crew_with_process(c, agnosai_process_parallel(4));
    agnosai_crew_with_trust_level(c, str_from("strict"));
    agnosai_crew_with_metadata(c, str_from("owner"), bayan_json_v_str_new(str_from("ops")));
    assert_eq(vec_len(agnosai_crew_agents(c)), 1, "with_agents");
    assert_eq(vec_len(agnosai_crew_tasks(c)), 1, "with_tasks");
    assert_eq(agnosai_process_kind(agnosai_crew_process(c)), AGNOSAI_PROCESS_PARALLEL, "with_process");
    assert(str_eq(agnosai_crew_trust_level(c), str_from("strict")) == 1, "with_trust_level");
    assert_eq(map_size(agnosai_crew_metadata(c)), 1, "with_metadata");

    # --- crew spec round trip, nested agents and tasks included ---
    var c_back = agnosai_crew_from_json(agnosai_crew_to_json(c));
    assert(c_back != 0, "crew round-trips through JSON");
    assert_eq(str_eq(agnosai_crew_id(c_back), agnosai_crew_id(c)), 1, "crew id survives");
    assert(str_eq(agnosai_crew_name(c_back), str_from("my crew")) == 1, "crew name survives");
    assert_eq(vec_len(agnosai_crew_agents(c_back)), 1, "nested agent survives");
    assert(str_eq(agnosai_agent_key(vec_get(agnosai_crew_agents(c_back), 0)), str_from("a1")) == 1,
    "nested agent_key survives");
    assert_eq(vec_len(agnosai_crew_tasks(c_back)), 1, "nested task survives");
    assert(str_eq(agnosai_task_description(vec_get(agnosai_crew_tasks(c_back), 0)), str_from("t1")) == 1,
    "nested task description survives");
    assert_eq(agnosai_process_kind(agnosai_crew_process(c_back)), AGNOSAI_PROCESS_PARALLEL,
    "crew process survives");
    assert_eq(agnosai_process_max_concurrency(agnosai_crew_process(c_back)), 4, "crew concurrency survives");
    assert(str_eq(agnosai_crew_trust_level(c_back), str_from("strict")) == 1, "trust_level survives");
    assert_eq(map_size(agnosai_crew_metadata(c_back)), 1, "metadata survives");
    assert_eq(agnosai_crew_from_json(str_from("{\"name\":\"no id\"}")), 0, "crew without an id is rejected");
    assert(agnosai_crew_from_value(agnosai_crew_to_value(c)) != 0,
    "agnosai_crew_from_value accepts a crew value tree");

    # --- field order matches serde's declaration order ---
    var cv = agnosai_crew_to_value(c);
    assert(str_eq(bayan_json_v_obj_key(cv, 0), str_from("id")) == 1, "crew field 0 is id");
    assert(str_eq(bayan_json_v_obj_key(cv, 6), str_from("trust_level")) == 1, "crew field 6 is trust_level");

    # --- CrewProfile: skip_serializing_if omissions are wire-visible ---
    var empty_prof = agnosai_crew_profile_new();
    var ev = agnosai_crew_profile_to_value(empty_prof);
    assert_eq(bayan_json_v_obj_get(ev, "cost_usd"), 0, "zero cost_usd is omitted");
    assert_eq(bayan_json_v_obj_get(ev, "agent_cost_usd"), 0, "empty agent_cost_usd is omitted");
    assert_eq(bayan_json_v_obj_get(ev, "task_cost_usd"), 0, "empty task_cost_usd is omitted");
    assert_eq(bayan_json_v_obj_get(ev, "sandbox_strength"), 0, "unset sandbox_strength is omitted");
    assert(bayan_json_v_obj_get(ev, "wall_ms") != 0, "wall_ms is always present");
    assert(bayan_json_v_obj_get(ev, "task_count") != 0, "task_count is always present");

    # --- CrewProfile: populated, with micro-USD costs ---
    var task_id = agnosai_uuid_v4_str();
    var prof = agnosai_crew_profile_new();
    agnosai_crew_profile_with_wall_ms(prof, 1500);
    agnosai_crew_profile_with_task_count(prof, 3);
    agnosai_crew_profile_record_task_ms(prof, task_id, 420);
    agnosai_crew_profile_with_cost(prof, 2500);
    agnosai_crew_profile_record_agent_cost(prof, str_from("a1"), 1500);
    agnosai_crew_profile_record_task_cost(prof, task_id, 1000);
    agnosai_crew_profile_with_sandbox_strength(prof, 85);

    var pv = agnosai_crew_profile_to_value(prof);
    assert(str_eq(bayan_json_v_build(bayan_json_v_obj_get(pv, "cost_usd")), str_from("0.0025")) == 1,
    "2500 micro-USD renders as 0.0025");
    assert(bayan_json_v_obj_get(pv, "agent_cost_usd") != 0, "populated agent_cost_usd is emitted");
    assert(bayan_json_v_obj_get(pv, "task_cost_usd") != 0, "populated task_cost_usd is emitted");
    assert(bayan_json_v_obj_get(pv, "sandbox_strength") != 0, "set sandbox_strength is emitted");

    var prof_back = agnosai_crew_profile_from_value(pv);
    assert_eq(agnosai_crew_profile_wall_ms(prof_back), 1500, "wall_ms survives");
    assert_eq(agnosai_crew_profile_task_count(prof_back), 3, "task_count survives");
    assert_eq(agnosai_crew_profile_cost_micro_usd(prof_back), 2500, "micro-USD cost survives exactly");
    assert_eq(map_size(agnosai_crew_profile_task_ms(prof_back)), 1, "task_ms survives");
    assert_eq(map_get(agnosai_crew_profile_task_ms(prof_back), task_id), 420,
    "per-task duration survives keyed by uuid string");
    assert_eq(map_get(agnosai_crew_profile_agent_cost(prof_back), str_from("a1")), 1500,
    "per-agent micro-USD cost survives exactly");
    assert_eq(map_get(agnosai_crew_profile_task_cost(prof_back), task_id), 1000,
    "per-task micro-USD cost survives exactly");
    assert_eq(agnosai_crew_profile_sandbox_strength(prof_back), 85, "sandbox_strength survives");

    # a cost that is not exactly representable in binary still round-trips
    # through the micro-USD boundary
    var odd = agnosai_crew_profile_with_cost(agnosai_crew_profile_new(), 123457);
    assert_eq(agnosai_crew_profile_cost_micro_usd(
    agnosai_crew_profile_from_value(agnosai_crew_profile_to_value(odd))), 123457,
    "0.123457 USD survives the f64 wire boundary exactly");

    # --- CrewState ---
    var state = agnosai_crew_state_new(agnosai_crew_id(c), AGNOSAI_CREW_RUNNING);
    assert_eq(agnosai_crew_state_status(state), AGNOSAI_CREW_RUNNING, "state status set");
    assert_eq(vec_len(agnosai_crew_state_results(state)), 0, "state results start empty");
    assert_eq(agnosai_crew_state_profile(state), 0, "state profile starts unset");

    var sv_empty = agnosai_crew_state_to_value(state);
    assert_eq(bayan_json_v_obj_get(sv_empty, "profile"), 0, "unset profile is omitted from the wire");

    agnosai_crew_state_with_result(state,
    agnosai_task_result_new(task_id, str_from("done"), AGNOSAI_STATUS_COMPLETED));
    agnosai_crew_state_with_profile(state, prof);
    var sv = agnosai_crew_state_to_value(state);
    assert(bayan_json_v_obj_get(sv, "profile") != 0, "set profile is emitted");

    var state_back = agnosai_crew_state_from_value(sv);
    assert(state_back != 0, "crew state round-trips");
    assert_eq(str_eq(agnosai_crew_state_crew_id(state_back), agnosai_crew_id(c)), 1,
    "state crew_id survives");
    assert_eq(agnosai_crew_state_status(state_back), AGNOSAI_CREW_RUNNING, "state status survives");
    assert_eq(vec_len(agnosai_crew_state_results(state_back)), 1, "state results survive");
    assert_eq(agnosai_task_result_status(vec_get(agnosai_crew_state_results(state_back), 0)),
    AGNOSAI_STATUS_COMPLETED, "nested result status survives");
    assert(agnosai_crew_state_profile(state_back) != 0, "state profile survives");
    assert_eq(agnosai_crew_profile_cost_micro_usd(agnosai_crew_state_profile(state_back)), 2500,
    "nested profile cost survives");
    assert_eq(agnosai_crew_state_from_value(bayan_json_v_obj_new()), 0, "state without a crew_id is rejected");

    # =====================================================================
    # [6.5.5] the whole core group on one arena
    #
    # core/task went first (its own suite pins that). This is the group result:
    # a crew carries agents, tasks, a process, a profile with three maps, and
    # every one of those has to be threaded or the response still grows the
    # global bump. Serializing a 10x10 crew is the widest core path there is.
    # =====================================================================
    var g_c = agnosai_crew_new(str_from("arena-crew"));
    var g_ts = vec_new();
    var g_as = vec_new();
    for (var gi = 0; gi < 10; gi = gi + 1) {
        vec_push(g_ts, agnosai_task_new(str_from("t")));
        vec_push(g_as, agnosai_agent_new(str_from("k"), str_from("r"), str_from("g")));
    }
    agnosai_crew_with_tasks(g_c, g_ts);
    agnosai_crew_with_agents(g_c, g_as);

    var g_ar = arena_allocator(4194304);
    agnosai_crew_to_json_a(g_ar, g_c);       # warm any lazily-built global
    reset_via(g_ar);

    var g_before = alloc_used();
    var g_i = 0;
    while (g_i < 20) {
        agnosai_crew_to_json_a(g_ar, g_c);
        reset_via(g_ar);
        g_i = g_i + 1;
    }
    assert_eq(alloc_used() - g_before, 0,
    "20 serializations of a 10-agent 10-task crew through an arena grow the global bump by 0 \
    bytes — agents, tasks, process, profile maps, wire spellings and the serialized text");

    assert_eq(str_eq(agnosai_crew_to_json(g_c), agnosai_crew_to_json_a(g_ar, g_c)), 1,
    "and the arena path emits byte-identical JSON");

    # The profile's three maps are the piece that needed a slot walk rather than
    # map_keys — that helper allocates its key vec on the global bump.
    var g_p = agnosai_crew_profile_new();
    agnosai_crew_profile_record_task_cost(g_p, str_from("t1"), 1500);
    agnosai_crew_profile_record_agent_cost(g_p, str_from("a1"), 2500);
    agnosai_crew_profile_record_task_ms(g_p, str_from("t1"), 42);
    reset_via(g_ar);
    var g_pb = alloc_used();
    var g_j = 0;
    while (g_j < 20) { agnosai_crew_profile_to_value_a(g_ar, g_p); reset_via(g_ar); g_j = g_j + 1; }
    assert_eq(alloc_used() - g_pb, 0,
    "a profile carrying all three maps serializes with zero global growth");

    # [6.5.5] crew's remaining `_a` forms agree with their global twins.
    var cw_ar = arena_allocator(262144);
    assert_eq(str_eq(agnosai_crew_status_to_wire_a(cw_ar, AGNOSAI_CREW_FAILED),
    agnosai_crew_status_to_wire(AGNOSAI_CREW_FAILED)), 1, "crew_status_to_wire_a agrees");
    assert_eq(str_eq(bayan_json_v_build(agnosai_crew_to_value_a(cw_ar, g_c)),
    bayan_json_v_build(agnosai_crew_to_value(g_c))), 1, "crew_to_value_a agrees byte-for-byte");
    var cw_st = agnosai_crew_state_new(str_from("cid"), AGNOSAI_CREW_COMPLETED);
    assert_eq(str_eq(bayan_json_v_build(agnosai_crew_state_to_value_a(cw_ar, cw_st)),
    bayan_json_v_build(agnosai_crew_state_to_value(cw_st))), 1, "crew_state_to_value_a agrees");
    var cw_cm = map_new_str();
    map_set(cw_cm, str_from("a1"), 2500);
    assert_eq(str_eq(bayan_json_v_build(_agnosai_cost_map_to_value_a(cw_ar, cw_cm)),
    bayan_json_v_build(_agnosai_cost_map_to_value(cw_cm))), 1, "cost_map_to_value_a agrees");
    var cw_im = map_new_str();
    map_set(cw_im, str_from("t1"), 42);
    assert_eq(str_eq(bayan_json_v_build(_agnosai_int_map_to_value_a(cw_ar, cw_im)),
    bayan_json_v_build(_agnosai_int_map_to_value(cw_im))), 1, "int_map_to_value_a agrees");
    _t_crew_json_keys_are_hoisted();
    _t_wire_values_are_hoisted();

    # ⚠ **Three CrewProfile fields are required**, not defaulted: `wall_ms`,
    # `task_ms` and `task_count` carry no `#[serde(default)]` (only the two cost
    # maps, `cost_usd` and `sandbox_strength` do, `crew.rs:106-118`). The port
    # defaulted all three and returned a plausible profile reporting a
    # zero-length run of zero tasks instead of an error.
    var no_wall = bayan_json_v_obj_new();
    bayan_json_v_obj_set(no_wall, str_from("task_count"), bayan_json_v_int_new(1));
    bayan_json_v_obj_set(no_wall, str_from("task_ms"), bayan_json_v_obj_new());
    assert_eq(agnosai_crew_profile_from_value(no_wall), 0,
    "a profile without `wall_ms` is rejected, not defaulted to 0");

    var no_count = bayan_json_v_obj_new();
    bayan_json_v_obj_set(no_count, str_from("wall_ms"), bayan_json_v_int_new(100));
    bayan_json_v_obj_set(no_count, str_from("task_ms"), bayan_json_v_obj_new());
    assert_eq(agnosai_crew_profile_from_value(no_count), 0,
    "nor without `task_count`");

    # ⚠ Oracle `crew_profile_deserializes_missing_cost_as_zero` (crew.rs:279):
    # the three required fields present and `cost_usd` ABSENT must give zero
    # cost — the defaulted half, which had no pin here.
    var no_cost = bayan_json_v_obj_new();
    bayan_json_v_obj_set(no_cost, str_from("wall_ms"), bayan_json_v_int_new(100));
    bayan_json_v_obj_set(no_cost, str_from("task_count"), bayan_json_v_int_new(1));
    bayan_json_v_obj_set(no_cost, str_from("task_ms"), bayan_json_v_obj_new());
    var okp = agnosai_crew_profile_from_value(no_cost);
    assert(okp != 0, "with all three required fields it parses");
    assert_eq(agnosai_crew_profile_cost_micro_usd(okp), 0,
    "and an absent `cost_usd` is zero, which IS serde-defaulted");
    assert_eq(agnosai_crew_profile_wall_ms(okp), 100, "carrying the wall_ms it was given");

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
