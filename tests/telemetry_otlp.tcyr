# =========================================================================
# telemetry_otlp.tcyr — tests for src/telemetry/otlp.cyr
#
# No oracle test block: `rust-old` gets OTLP from an OpenTelemetry SDK, so what
# must hold here is the **OTLP/JSON wire contract**, not a Rust function's
# behaviour. That makes the byte layout the whole parity surface — a collector
# accepts or silently drops a batch, and there is no local symptom either way.
#
# The two rules that bite, both asserted literally rather than by shape:
#
#   * **64-bit integers are STRINGS.** `"intValue":"42"` and
#     `"startTimeUnixNano":"..."`. A bare number is valid JSON and invalid
#     OTLP — the protobuf JSON mapping requires the quotes because IEEE-754
#     doubles cannot hold the int64 range.
#   * **Ids are fixed-width lowercase hex** — 32 for a trace id, 16 for a span
#     id, zero-padded. The collector parses by length, so a short id is not a
#     short id, it is a rejected span.
#
# Also pinned: absent attributes are OMITTED rather than sent as null (OTLP has
# no null attribute value); the comma placement that omission has to get right;
# `SpanKind` CLIENT for `chat` and INTERNAL for local work; the all-zero
# trace id, which `sakshi_trace_id_hi`/`_lo` answer with when nothing ever set
# one and which the W3C spec declares invalid; and, since ADR 023, the span
# context — strict `traceparent` parsing, children, roots, and `parentSpanId`
# on every span that has a parent.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/core/mod.cyr"
include "src/telemetry/genai.cyr"
include "src/telemetry/otlp.cyr"
include "tests/test_helpers.cyr"

# The hex rendering of a trace id, on its own.

# How many threads this process has: the entries of /proc/self/task (2.1.7).
fn _t_threads(): i64 {
    return vec_len(dir_list(str_from("/proc/self/task")));
}

fn _t_trace_hex(hi, lo): i64 {
    var sb = str_builder_new();
    agnosai_otlp_add_trace_id(sb, hi, lo);
    return str_builder_build(sb);
}

fn _t_span_hex(id): i64 {
    var sb = str_builder_new();
    agnosai_otlp_add_span_id(sb, id);
    return str_builder_build(sb);
}

# A context with everything fixed, so encodings are byte-comparable.
fn _t_ctx(): i64 {
    return agnosai_otlp_ctx_new(0x0102030405060708, 0x090a0b0c0d0e0f10,
      0x1122334455667788, 1000, 2000, AGNOSAI_OTLP_STATUS_OK);
}

# The byte-exact OTLP Span object for the tool-span fixture, assembled from
# short pieces so the literal stays under 120 columns. The assembly is the
# point: change any piece and the comparison fails.
fn _t_expect_tool_span(): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"traceId\":\"0102030405060708090a0b0c0d0e0f10\"");
    str_builder_add_cstr(sb, ",\"spanId\":\"1122334455667788\"");
    str_builder_add_cstr(sb, ",\"name\":\"execute_tool echo\",\"kind\":1");
    str_builder_add_cstr(sb, ",\"startTimeUnixNano\":\"1000\"");
    str_builder_add_cstr(sb, ",\"endTimeUnixNano\":\"2000\",\"attributes\":[");
    str_builder_add_cstr(sb, "{\"key\":\"gen_ai.operation.name\"");
    str_builder_add_cstr(sb, ",\"value\":{\"stringValue\":\"execute_tool\"}},");
    str_builder_add_cstr(sb, "{\"key\":\"gen_ai.agent.name\"");
    str_builder_add_cstr(sb, ",\"value\":{\"stringValue\":\"agent-a\"}},");
    str_builder_add_cstr(sb, "{\"key\":\"gen_ai.tool.name\"");
    str_builder_add_cstr(sb, ",\"value\":{\"stringValue\":\"echo\"}},");
    str_builder_add_cstr(sb, "{\"key\":\"agnosai.task.id\"");
    str_builder_add_cstr(sb, ",\"value\":{\"stringValue\":\"task-1\"}}]");
    str_builder_add_cstr(sb, ",\"status\":{\"code\":1}}");
    return str_builder_build(sb);
}

# ⭐ 2.1.7 (ADR 024): an HTTP server span — SERVER, named `<method> <route>`, with the HTTP
# semantic-convention attributes and none of the GenAI ones, built in the caller's arena.
fn _t_http_server_span(): i64 {
    var a = arena_allocator(65536);
    var before = alloc_used();
    var sp = agnosai_http_server_span_a(a, str_from_a(a, "GET"), str_from_a(a, "/api/v1/crews/{id}"),
      str_from_a(a, "/api/v1/crews/6ba7b810-9dad-41d1-80b4-00c04fd430c8"), str_from_a(a, "http"), 200);
    assert_eq(alloc_used() - before, 0, "⭐ the span lives in the caller's arena, not the global heap");
    assert(sp != 0, "an HTTP server span is built");
    assert_eq(agnosai_span_is_http_server(sp), 1, "and is one");
    assert_eq(agnosai_otlp_span_kind(sp), AGNOSAI_OTLP_KIND_SERVER, "⭐ of kind SERVER");
    assert(str_eq_cstr(agnosai_http_span_method(sp), "GET") == 1, "it keeps the method");
    assert(str_eq_cstr(agnosai_http_span_route(sp), "/api/v1/crews/{id}") == 1, "the route's pattern");
    assert(str_eq_cstr(agnosai_http_span_path(sp), "/api/v1/crews/6ba7b810-9dad-41d1-80b4-00c04fd430c8") == 1,
      "the path as sent");
    assert(str_eq_cstr(agnosai_http_span_scheme(sp), "http") == 1, "the scheme");
    assert_eq(agnosai_http_span_status(sp), 200, "and the status");
    var j = agnosai_otlp_span_json(sp, _t_ctx());
    assert(str_contains_cstr(j, "\"name\":\"GET /api/v1/crews/{id}\"") == 1,
      "⭐ named <method> <route>, the route's pattern — low-cardinality");
    assert(str_contains_cstr(j, "\"kind\":2") == 1, "kind 2 on the wire");
    assert(str_contains_cstr(j, "{\"key\":\"http.request.method\",\"value\":{\"stringValue\":\"GET\"}}") == 1,
      "http.request.method");
    assert(str_contains_cstr(j, "{\"key\":\"http.route\",\"value\":{\"stringValue\":\"/api/v1/crews/{id}\"}}") == 1,
      "http.route");
    assert(str_contains_cstr(j, "{\"key\":\"http.response.status_code\",\"value\":{\"intValue\":\"200\"}}") == 1,
      "http.response.status_code, as a quoted int");
    assert(str_contains_cstr(j, "\"url.path\"") == 1, "url.path");
    assert(str_contains_cstr(j, "{\"key\":\"url.scheme\",\"value\":{\"stringValue\":\"http\"}}") == 1, "url.scheme");
    assert(str_contains_cstr(j, "gen_ai.") == 0, "⭐ and no gen_ai attribute at all");
    assert(str_contains_cstr(j, "\"traceId\":\"0102030405060708090a0b0c0d0e0f10\"") == 1, "the context's identity");
    assert_eq(agnosai_http_server_span_a(a, 0, 0, 0, 0, 200), 0, "no method, no span");
    var tool = agnosai_genai_tool_span(str_from("echo"), 0, 0);
    assert_eq(agnosai_http_span_method(tool), 0, "a GenAI span has no HTTP method");
    assert_eq(agnosai_http_span_route(tool) + agnosai_http_span_path(tool) + agnosai_http_span_scheme(tool), 0,
      "nor route, path or scheme");
    assert_eq(agnosai_http_span_status(tool), -1, "and no status");
    assert_eq(agnosai_http_span_route(0) + agnosai_http_span_path(0) + agnosai_http_span_scheme(0), 0,
      "no span answers 0");
    assert_eq(agnosai_http_span_status(0), -1, "and status -1");
    return 0;
}

fn main(): i64 {
    # --- ids are fixed-width lowercase hex ------------------------------
    assert(str_eq_cstr(_t_trace_hex(0x0102030405060708, 0x090a0b0c0d0e0f10),
        "0102030405060708090a0b0c0d0e0f10") == 1, "a trace id is 32 lowercase hex, high half first");
    assert_eq(str_len(_t_trace_hex(1, 1)), 32, "and always 32 digits");
    assert(str_eq_cstr(_t_trace_hex(0, 1), "00000000000000000000000000000001") == 1,
      "zero-padded — a small id is not a short id");
    assert(str_eq_cstr(_t_trace_hex(0, 0), "00000000000000000000000000000000") == 1,
      "the all-zero id renders in full");
    assert(str_eq_cstr(_t_trace_hex(0 - 1, 0 - 1),
        "ffffffffffffffffffffffffffffffff") == 1, "and the all-ones id is lowercase f, not F");

    assert(str_eq_cstr(_t_span_hex(0x1122334455667788), "1122334455667788") == 1,
      "a span id is 16 lowercase hex");
    assert_eq(str_len(_t_span_hex(1)), 16, "always 16 digits");
    assert(str_eq_cstr(_t_span_hex(0), "0000000000000000") == 1, "zero-padded too");
    assert(str_eq_cstr(_t_span_hex(0xabcdef), "0000000000abcdef") == 1,
      "with the digits right-aligned");

    # ⚠ The all-zero trace id is INVALID per W3C, and it is exactly what
    # sakshi answers before anything calls `sakshi_trace_set_128` — so an
    # un-instrumented process would export batches every collector drops.
    assert_eq(agnosai_otlp_trace_id_is_zero(0, 0), 1, "0/0 is the invalid all-zero id");
    assert_eq(agnosai_otlp_trace_id_is_zero(0, 1), 0, "a low-half-only id is valid");
    assert_eq(agnosai_otlp_trace_id_is_zero(1, 0), 0, "as is a high-half-only id");

    # --- span kind -------------------------------------------------------
    var inf = agnosai_genai_chat_span(str_from("llama3"), str_from("hoosh"));
    var tool = agnosai_genai_tool_span(str_from("echo"), str_from("agent-a"),
      str_from("task-1"));
    var crew = agnosai_genai_workflow_span(str_from("crew-1"), str_from("c"), 3);
    var agent = agnosai_genai_agent_span(str_from("Analyst"), str_from("analyst"),
      str_from("task-1"));
    # ⚠ A backend's service-dependency graph is built from CLIENT/SERVER pairs,
    # so a mislabelled inference span drops the edge to the model provider.
    assert_eq(agnosai_otlp_span_kind(inf), AGNOSAI_OTLP_KIND_CLIENT,
      "chat is CLIENT — it leaves the process");
    assert_eq(agnosai_otlp_span_kind(tool), AGNOSAI_OTLP_KIND_INTERNAL,
      "tool execution is INTERNAL");
    assert_eq(agnosai_otlp_span_kind(crew), AGNOSAI_OTLP_KIND_INTERNAL,
      "and so is a workflow (crew) run");
    # ⚠ The regression guard for ADR 023: `invoke_agent` used to be the chat
    # call's name and was exported CLIENT. It is now the in-process task span.
    assert_eq(agnosai_otlp_span_kind(agent), AGNOSAI_OTLP_KIND_INTERNAL,
      "invoke_agent is INTERNAL — an in-process agent, no longer the chat call");
    assert_eq(AGNOSAI_OTLP_KIND_CLIENT, 3, "CLIENT is the wire value 3");
    assert_eq(AGNOSAI_OTLP_KIND_INTERNAL, 1, "and INTERNAL is 1");

    # ⚠ UNSET is not OK. A collector reads UNSET as "no opinion" and OK as an
    # explicit success assertion, so defaulting one to the other is a lie.
    assert_eq(AGNOSAI_OTLP_STATUS_UNSET, 0, "UNSET is 0");
    assert_eq(AGNOSAI_OTLP_STATUS_OK, 1, "OK is 1");
    assert_eq(AGNOSAI_OTLP_STATUS_ERROR, 2, "ERROR is 2");

    # --- a whole span, byte for byte -------------------------------------
    # A tool span carries exactly three attributes, so this pins the full
    # object including every separator.
    var j = agnosai_otlp_span_json(tool, _t_ctx());
    assert(str_eq(j, _t_expect_tool_span()) == 1,
      "a tool span encodes byte-for-byte to the OTLP/JSON Span object");
    # The encoder writes the name in two parts rather than building it; it must
    # agree with the one place that does build it.
    var fa = default_alloc();
    var four = vec_new();
    vec_push(four, inf);
    vec_push(four, tool);
    vec_push(four, crew);
    vec_push(four, agent);
    var names_agree = 1;
    for (var ni = 0; ni < 4; ni = ni + 1) {
        var nsb = str_builder_new();
        str_builder_add_cstr(nsb, "\"name\":\"");
        str_builder_add(nsb, agnosai_genai_span_full_name_a(fa, vec_get(four, ni)));
        str_builder_add_cstr(nsb, "\",\"kind\":");
        if (str_contains(agnosai_otlp_span_json(vec_get(four, ni), _t_ctx()),
            str_builder_build(nsb)) == 0) { names_agree = 0; }
    }
    assert_eq(names_agree, 1, "the encoded name is full_name_a's, for all four operations");
    assert_eq(str_contains_cstr(agnosai_otlp_span_json(inf, _t_ctx()),
        "\"name\":\"chat llama3\""), 1, "chat {model}");
    assert_eq(str_contains_cstr(agnosai_otlp_span_json(agent, _t_ctx()),
        "\"name\":\"invoke_agent Analyst\""), 1, "invoke_agent {agent name}");
    assert_eq(str_contains_cstr(agnosai_otlp_span_json(crew, _t_ctx()),
        "\"name\":\"invoke_workflow c\""), 1, "invoke_workflow {crew name}");
    # A name is caller data like any attribute, so it is escaped.
    assert_eq(str_contains_cstr(agnosai_otlp_span_json(
          agnosai_genai_chat_span(str_from("m\"x"), 0), _t_ctx()),
        "\"name\":\"chat m\\\"x\""), 1, "a quote in a span name's subject is escaped");
    # A subject that is absent or empty leaves the bare operation.
    assert_eq(str_contains_cstr(agnosai_otlp_span_json(agnosai_genai_agent_span(0, 0, 0),
          _t_ctx()), "\"name\":\"invoke_agent\",\"kind\":1"), 1,
      "an agent span with no name is the bare operation");
    # The agent span's attributes, in the pinned order.
    assert_eq(str_contains_cstr(agnosai_otlp_span_json(agent, _t_ctx()),
        "\"gen_ai.agent.name\",\"value\":{\"stringValue\":\"Analyst\"}},{\"key\":\"agnosai.task.id\""
        ), 1, "agent name, then the task id");
    assert_eq(str_contains_cstr(agnosai_otlp_span_json(agent, _t_ctx()),
        "{\"key\":\"agnosai.agent.key\",\"value\":{\"stringValue\":\"analyst\"}}]"), 1,
      "and the agent key last");
    # error.type sits after the gen_ai. attributes and before agnosai.'s.
    var errspan = agnosai_genai_workflow_span(str_from("cid"), str_from("w"), 2);
    agnosai_genai_span_set_error_type(errspan, str_from("timeout"));
    var esb = str_builder_new();
    str_builder_add_cstr(esb, "\"gen_ai.workflow.name\",\"value\":{\"stringValue\":\"w\"}},");
    str_builder_add_cstr(esb, "{\"key\":\"error.type\",\"value\":{\"stringValue\":\"timeout\"}},");
    str_builder_add_cstr(esb, "{\"key\":\"agnosai.crew.id\"");
    assert_eq(str_contains(agnosai_otlp_span_json(errspan, _t_ctx()), str_builder_build(esb)), 1,
      "error.type is emitted between the spec attributes and agnosai's");
    # ⚠ An EMPTY string attribute is absent, like a 0 one. The call sites used
    # to pass `str_from("")` and this emitted `"stringValue":""` for each.
    var empties = agnosai_genai_tool_span(str_from("t"), str_from(""), str_from(""));
    var je0 = agnosai_otlp_span_json(empties, _t_ctx());
    assert_eq(str_contains_cstr(je0, "gen_ai.agent.name"), 0, "an empty agent name is omitted");
    assert_eq(str_contains_cstr(je0, "agnosai.task.id"), 0, "as is an empty task id");
    assert_eq(str_contains_cstr(je0, "\"stringValue\":\"\""), 0, "no empty string value at all");

    # ⚠ The timestamps are QUOTED. This is the rule that fails silently.
    assert_eq(str_contains_cstr(j, "\"startTimeUnixNano\":\"1000\""), 1,
      "startTimeUnixNano is a STRING, not a number");
    assert_eq(str_contains_cstr(j, "\"endTimeUnixNano\":\"2000\""), 1,
      "and so is endTimeUnixNano");
    assert_eq(str_contains_cstr(j, "UnixNano\":1000"), 0,
      "the unquoted form appears nowhere");

    # --- integer attributes are quoted too -------------------------------
    agnosai_genai_record_usage(inf, 100, 50, str_from("llama3-instruct"));
    var ji = agnosai_otlp_span_json(inf, _t_ctx());
    assert_eq(str_contains_cstr(ji,
        "{\"key\":\"gen_ai.usage.input_tokens\",\"value\":{\"intValue\":\"100\"}}"), 1,
      "intValue is a STRING — a bare number is valid JSON and invalid OTLP");
    assert_eq(str_contains_cstr(ji, "\"intValue\":100"), 0,
      "the unquoted form appears nowhere");
    assert_eq(str_contains_cstr(ji,
        "{\"key\":\"gen_ai.usage.output_tokens\",\"value\":{\"intValue\":\"50\"}}"), 1,
      "output tokens likewise");
    assert_eq(str_contains_cstr(ji, "\"kind\":3"), 1,
      "but `kind` IS a bare number — it is an enum, not an int64");
    assert_eq(str_contains_cstr(ji, "\"code\":1"), 1, "and so is the status code");

    # The responding model is carried, and differs from the requested one.
    assert_eq(str_contains_cstr(ji, "\"gen_ai.response.model\""), 1,
      "the response model is emitted once recorded");
    assert_eq(str_contains_cstr(ji, "\"llama3-instruct\""), 1, "with its value");

    # --- absent attributes are OMITTED, not null -------------------------
    # OTLP has no null attribute value; a collector reading one drops the span.
    var bare = agnosai_genai_chat_span(str_from("m"), str_from("s"));
    var jb = agnosai_otlp_span_json(bare, _t_ctx());
    assert_eq(str_contains_cstr(jb, "null"), 0, "an unrecorded span emits no null anywhere");
    assert_eq(str_contains_cstr(jb, "gen_ai.usage.input_tokens"), 0,
      "an unset integer attribute is omitted entirely");
    assert_eq(str_contains_cstr(jb, "gen_ai.response.model"), 0,
      "as is an unset string attribute");
    assert_eq(str_contains_cstr(jb, "gen_ai.tool.name"), 0,
      "and an attribute this span kind never carries");

    # ⚠ Omission has to get the commas right. A span with ONE attribute must
    # have no comma at all, and none may lead or trail the array.
    var crew_only = agnosai_genai_workflow_span(str_from("only"), 0, 0);
    var jc = agnosai_otlp_span_json(crew_only, _t_ctx());
    assert_eq(str_contains_cstr(jc, "[,"), 0, "no leading comma in the attribute array");
    assert_eq(str_contains_cstr(jc, ",]"), 0, "no trailing comma");
    assert_eq(str_contains_cstr(jc, ",,"), 0, "and no doubled comma from a skipped attribute");
    # A tool span with only its name skips five attributes between the
    # operation and the tool name, and the task id after it — the omissions sit
    # in the MIDDLE and at the END, where a naive "comma before every attribute
    # but the first index" gets it wrong. (Before ADR 023 the crew span set no
    # operation name, which put the omission at the front instead; every span
    # now opens on its operation.)
    assert_eq(str_contains_cstr(jc,
        "\"attributes\":[{\"key\":\"gen_ai.operation.name\""), 1,
      "the array opens on the operation, which every span carries");
    assert_eq(str_contains_cstr(jc,
        "\"stringValue\":\"invoke_workflow\"}},{\"key\":\"agnosai.crew.id\""), 1,
      "and a workflow span with no name skips straight to the crew id");
    var lone = agnosai_otlp_span_json(agnosai_genai_tool_span(str_from("x"), 0, 0), _t_ctx());
    var lsb = str_builder_new();
    str_builder_add_cstr(lsb, "\"stringValue\":\"execute_tool\"}},");
    str_builder_add_cstr(lsb, "{\"key\":\"gen_ai.tool.name\",\"value\":{\"stringValue\":\"x\"}}]");
    assert_eq(str_contains(lone, str_builder_build(lsb)), 1,
      "a lone tool name closes the array with no trailing comma");
    assert_eq(str_contains_cstr(jc,
        "{\"key\":\"agnosai.crew.task_count\",\"value\":{\"intValue\":\"0\"}}]"), 1,
      "and closes on the last present one — a 0 task count is present, not unset");

    # --- values are JSON-escaped -----------------------------------------
    # Model and tool names are caller data. An unescaped quote does not corrupt
    # one attribute, it corrupts the whole batch.
    var evil = agnosai_genai_tool_span(str_from("say \"hi\""), str_from("a\\b"),
      str_from("t"));
    var je = agnosai_otlp_span_json(evil, _t_ctx());
    assert_eq(str_contains_cstr(je, "\\\"hi\\\""), 1, "a quote in a value is escaped");
    assert_eq(str_contains_cstr(je, "a\\\\b"), 1, "and a backslash is doubled");

    # --- the batch envelope ----------------------------------------------
    var frags = alloc(24);
    store64(frags, agnosai_otlp_span_json(tool, _t_ctx()));
    store64(frags + 8, agnosai_otlp_span_json(crew, _t_ctx()));
    var batch = agnosai_otlp_build_batch(str_from("agnosai"), frags, 2);
    assert_eq(str_contains_cstr(batch, "{\"resourceSpans\":[{\"resource\":{\"attributes\":["), 1,
      "the batch opens with a resourceSpans envelope");
    assert_eq(str_contains_cstr(batch,
        "{\"key\":\"service.name\",\"value\":{\"stringValue\":\"agnosai\"}}]}"), 1,
      "whose resource carries service.name — what a backend groups by");
    assert_eq(str_contains_cstr(batch, "\"scopeSpans\":[{\"scope\":{\"name\":\"agnosai\"},\"spans\":["), 1,
      "and the scope names the instrumentation");
    assert_eq(str_contains_cstr(batch, "}},{\"traceId\":"), 1,
      "the two spans are comma-separated");
    assert_eq(str_contains_cstr(batch, "]}]}]}"), 1, "and the envelope closes");

    # A single-span batch has no separator, and an empty one is still a valid
    # document rather than a truncated one.
    var one = agnosai_otlp_build_batch(str_from("agnosai"), frags, 1);
    assert_eq(str_contains_cstr(one, "},{\"traceId\":"), 0, "one span means no separator");
    var none = agnosai_otlp_build_batch(str_from("agnosai"), frags, 0);
    assert_eq(str_contains_cstr(none, "\"spans\":[]}]}]}"), 1,
      "an empty batch is a well-formed document with an empty span list");

    # The service name is caller-supplied too, so it is escaped.
    assert_eq(str_contains_cstr(agnosai_otlp_build_batch(str_from("a\"b"), frags, 0),
        "\"stringValue\":\"a\\\"b\""), 1, "the service name is escaped");

    # --- endpoint parsing -------------------------------------------------
    assert(str_eq_cstr(str_from(agnosai_otlp_path("http://localhost:4318/v1/traces")),
        "/v1/traces") == 1, "the path is taken from the URL");
    assert(str_eq_cstr(str_from(agnosai_otlp_path("http://localhost:4318")),
        "/v1/traces") == 1, "and defaults when the URL has none");
    assert(str_eq_cstr(str_from(agnosai_otlp_path("http://host/custom/path")),
        "/custom/path") == 1, "a non-default path is honoured");

    # ⚠ The scheme decides where the scan starts. hoosh hardcodes 7 because it
    # only ever sees `http://`; on an `https://` URL that lands on the second
    # `/` of `//` and answers `/` — a POST to the collector root, which 404s.
    assert(str_eq_cstr(str_from(agnosai_otlp_path("https://collector:4318/v1/traces")),
        "/v1/traces") == 1, "an https URL's path is found, not the '//' of its scheme");
    assert(str_eq_cstr(str_from(agnosai_otlp_path("https://collector:4318")),
        "/v1/traces") == 1, "and an https URL with no path defaults");

    assert_eq(agnosai_otlp_is_https("https://c:4318"), 1, "https is detected");
    assert_eq(agnosai_otlp_is_https("http://c:4318"), 0, "http is not");
    assert_eq(agnosai_otlp_is_https(0), 0, "a 0 endpoint is not https");
    assert_eq(agnosai_otlp_is_https("https"), 0,
      "and a truncated scheme is not — the check is 8 bytes, not 5");
    assert_eq(agnosai_otlp_is_https("httpsX//c"), 0, "nor a lookalike");

    # --- the context round-trips -----------------------------------------
    assert_eq(agnosai_otlp_ctx_status(_t_ctx()), AGNOSAI_OTLP_STATUS_OK, "the status round-trips");
    var errctx = agnosai_otlp_ctx_new(1, 2, 3, 10, 20, AGNOSAI_OTLP_STATUS_ERROR);
    assert_eq(agnosai_otlp_ctx_status(errctx), AGNOSAI_OTLP_STATUS_ERROR, "as does an error one");
    assert_eq(str_contains_cstr(agnosai_otlp_span_json(tool, errctx), "\"status\":{\"code\":2}"), 1,
      "and it reaches the encoded span");

    # --- parentSpanId (ADR 023) -------------------------------------------
    # ⚠ A ROOT span omits the key. Sixteen zeros are an invalid span id, not
    # "no parent", and a collector would render a missing parent for every root.
    assert_eq(agnosai_otlp_ctx_parent_span_id(_t_ctx()), 0, "ctx_new makes a root");
    assert_eq(str_contains_cstr(agnosai_otlp_span_json(tool, _t_ctx()), "parentSpanId"), 0,
      "and a root span carries NO parentSpanId key");
    var cctx = agnosai_otlp_ctx_new_child(0x0102030405060708, 0x090a0b0c0d0e0f10,
      0x1122334455667788, 0xaabbccddeeff0011, 1000, 2000, AGNOSAI_OTLP_STATUS_OK);
    assert_eq(agnosai_otlp_ctx_parent_span_id(cctx), 0xaabbccddeeff0011,
      "ctx_new_child keeps the parent");
    assert_eq(str_contains_cstr(agnosai_otlp_span_json(tool, cctx),
        "\"spanId\":\"1122334455667788\",\"parentSpanId\":\"aabbccddeeff0011\",\"name\":"), 1,
      "a child carries parentSpanId right after spanId, as 16 lowercase hex");
    # The parent is the only difference: everything after the name is the same.
    var root_tail = str_index_of_cstr(agnosai_otlp_span_json(tool, _t_ctx()), "\"name\":");
    var child_j = agnosai_otlp_span_json(tool, cctx);
    assert_eq(str_index_of_cstr(child_j, "\"name\":") - root_tail, 34,
      "and adds exactly the 34 bytes of one parentSpanId member");
    # A parent with the top bit set is a NEGATIVE i64 and still a valid id.
    var neg = agnosai_otlp_ctx_new_child(1, 2, 3, 0 - 1, 10, 20, AGNOSAI_OTLP_STATUS_OK);
    assert_eq(str_contains_cstr(agnosai_otlp_span_json(tool, neg),
        "\"parentSpanId\":\"ffffffffffffffff\""), 1, "a top-bit parent id is still emitted");

    # --- span context: parse ----------------------------------------------
    # The W3C spec's own example.
    var w3c = str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01");
    var sc = agnosai_otlp_span_context_parse(w3c);
    assert(sc != 0, "the W3C example parses");
    assert_eq(agnosai_otlp_span_context_trace_hi(sc), 0x4bf92f3577b34da6, "trace id high half");
    assert_eq(agnosai_otlp_span_context_trace_lo(sc), 0xa3ce929d0e0e4736, "trace id low half");
    assert_eq(agnosai_otlp_span_context_span_id(sc), 0x00f067aa0ba902b7,
      "the parent-id becomes the context's span id");
    assert_eq(agnosai_otlp_span_context_flags(sc), 1, "flags 01");
    assert_eq(agnosai_otlp_span_context_sampled(sc), 1, "are sampled");
    assert(str_eq(agnosai_otlp_span_context_format_a(default_alloc(), sc), w3c) == 1,
      "and format(parse(x)) is x byte for byte");

    # The shape agnostic mints (`agnostic_trace_generate_a`): version 00, random
    # ids, flags 01 — with top-bit-set halves, which are negative as i64.
    var ag = str_from("00-f0e1d2c3b4a5968778695a4b3c2d1e0f-8899aabbccddeeff-01");
    var agc = agnosai_otlp_span_context_parse(ag);
    assert(agc != 0, "an agnostic-shaped traceparent parses");
    assert_eq(agnosai_otlp_span_context_trace_hi(agc), 0xf0e1d2c3b4a59687,
      "a top-bit trace half round-trips as its bit pattern");
    assert_eq(agnosai_otlp_span_context_span_id(agc), 0x8899aabbccddeeff, "and so does the span id");
    assert(str_eq(agnosai_otlp_span_context_format_a(default_alloc(), agc), ag) == 1,
      "and it formats back byte for byte");

    # Flags other than 01 are kept whole, and only bit 0 is `sampled`.
    var unsampled = agnosai_otlp_span_context_parse(
      str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-00"));
    assert(unsampled != 0, "flags 00 parse");
    assert_eq(agnosai_otlp_span_context_sampled(unsampled), 0, "and are NOT sampled");
    var f02 = agnosai_otlp_span_context_parse(
      str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-02"));
    assert_eq(agnosai_otlp_span_context_flags(f02), 2, "an unknown flag bit is kept");
    assert_eq(agnosai_otlp_span_context_sampled(f02), 0, "and is not `sampled`");
    assert(str_eq_cstr(agnosai_otlp_span_context_format_a(default_alloc(), f02),
        "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-02") == 1,
      "and is passed on as it arrived");

    # Everything else is a new root, never an error.
    assert_eq(agnosai_otlp_span_context_parse(0), 0, "0 is not a traceparent");
    assert_eq(agnosai_otlp_span_context_parse(str_from("")), 0, "nor is the empty Str");
    assert_eq(agnosai_otlp_span_context_parse(
        str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-0")), 0, "54 bytes");
    assert_eq(agnosai_otlp_span_context_parse(
        str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-011")), 0, "56 bytes");
    assert_eq(agnosai_otlp_span_context_parse(
        str_from("00-4BF92F3577B34DA6A3CE929D0E0E4736-00F067AA0BA902B7-01")), 0,
      "uppercase hex — W3C writes HEXDIGLC");
    assert_eq(agnosai_otlp_span_context_parse(
        str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902B7-01")), 0,
      "even one uppercase digit");
    assert_eq(agnosai_otlp_span_context_parse(
        str_from("ff-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01")), 0,
      "version ff, which the spec forbids");
    assert_eq(agnosai_otlp_span_context_parse(
        str_from("01-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01")), 0,
      "version 01, which does not exist");
    assert_eq(agnosai_otlp_span_context_parse(
        str_from("00-00000000000000000000000000000000-00f067aa0ba902b7-01")), 0,
      "the all-zero trace id");
    assert_eq(agnosai_otlp_span_context_parse(
        str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-0000000000000000-01")), 0,
      "the all-zero parent id");
    assert(agnosai_otlp_span_context_parse(
        str_from("00-00000000000000000000000000000001-0000000000000001-01")) != 0,
      "but a trace id with only its low bit set is valid");
    assert_eq(agnosai_otlp_span_context_parse(
        str_from("00_4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01")), 0,
      "a missing first dash");
    assert_eq(agnosai_otlp_span_context_parse(
        str_from("00-4bf92f3577b34da6a3ce929d0e0e47-3600f067aa0ba902b7-01")), 0, "a moved dash");
    assert_eq(agnosai_otlp_span_context_parse(
        str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7+01")), 0, "a wrong last dash");
    assert_eq(agnosai_otlp_span_context_parse(
        str_from("00-4bf92f3577b34da6a3ce929d0e0e473g-00f067aa0ba902b7-01")), 0, "a non-hex byte");
    assert_eq(agnosai_otlp_span_context_parse(
        str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-0x")), 0,
      "a non-hex flags byte");

    # An exhausted allocator answers 0, not a context it could not store.
    # (ARENA_FULL_NULL, the default policy, answers 0 when full.)
    var tiny = arena_allocator(16);
    assert_eq(agnosai_otlp_span_context_parse_a(tiny, w3c), 0,
      "parse_a in an arena too small for 32 bytes answers 0");

    # --- span context: children and roots ---------------------------------
    var kid = agnosai_otlp_span_context_child(sc);
    assert_eq(agnosai_otlp_span_context_trace_hi(kid), 0x4bf92f3577b34da6,
      "a child keeps the parent's trace id");
    assert_eq(agnosai_otlp_span_context_trace_lo(kid), 0xa3ce929d0e0e4736, "both halves");
    assert_eq(agnosai_otlp_span_context_flags(kid), 1, "and its flags");
    assert(agnosai_otlp_span_context_span_id(kid) != 0, "with a non-zero span id");
    assert(agnosai_otlp_span_context_span_id(kid) != agnosai_otlp_span_context_span_id(sc),
      "different from the parent's");
    var kid2 = agnosai_otlp_span_context_child(sc);
    assert(agnosai_otlp_span_context_span_id(kid2) != agnosai_otlp_span_context_span_id(kid),
      "and two children of one parent differ");
    assert_eq(agnosai_otlp_span_context_flags(agnosai_otlp_span_context_child(unsampled)), 0,
      "an unsampled parent's children are unsampled too");

    var root = agnosai_otlp_span_context_child(0);
    assert_eq(agnosai_otlp_trace_id_is_zero(agnosai_otlp_span_context_trace_hi(root),
        agnosai_otlp_span_context_trace_lo(root)), 0, "child(0) is a root with a trace id");
    assert(agnosai_otlp_span_context_span_id(root) != 0, "and a span id");
    assert_eq(agnosai_otlp_span_context_flags(root), 1, "sampled — flags 01");
    var root2 = agnosai_otlp_span_context_child(0);
    assert(agnosai_otlp_span_context_trace_hi(root2) != agnosai_otlp_span_context_trace_hi(root)
      || agnosai_otlp_span_context_trace_lo(root2) != agnosai_otlp_span_context_trace_lo(root),
      "two roots are two traces");
    # ⚠ The old identity reused the trace id's high half as the span id.
    assert(agnosai_otlp_span_context_span_id(root) != agnosai_otlp_span_context_trace_hi(root),
      "a root's span id is drawn, not the high half of its trace id");
    # A formatted root is a traceparent this parser accepts.
    var rtp = agnosai_otlp_span_context_format_a(default_alloc(), root);
    assert_eq(str_len(rtp), 55, "a formatted root is 55 bytes");
    var rback = agnosai_otlp_span_context_parse(rtp);
    assert(rback != 0, "and parses back");
    assert_eq(agnosai_otlp_span_context_span_id(rback), agnosai_otlp_span_context_span_id(root),
      "to the same span id");
    var made = agnosai_otlp_span_context_new(7, 8, 9, 1);
    assert(str_eq_cstr(agnosai_otlp_span_context_format_a(default_alloc(), made),
        "00-00000000000000070000000000000008-0000000000000009-01") == 1,
      "span_context_new formats zero-padded");

    # --- the export ring --------------------------------------------------
    var ring = agnosai_otlp_ring_new();
    assert(ring != 0, "a ring is created");
    assert_eq(agnosai_otlp_ring_count(ring), 0, "and starts empty");
    assert_eq(agnosai_otlp_ring_dropped(ring), 0, "with nothing dropped");
    assert_eq(agnosai_otlp_ring_capacity(), 256, "capacity is 256, as hoosh's is");

    # ⚠ The ring holds TWO distinct arenas. This kills the obvious
    # simplification — collapsing them into one, which would have `drain` reset
    # the arena holding the fragments it is about to read.
    #
    # It does NOT kill a mis-targeted allocation (enqueue writing into the
    # document arena): that has the same observable output, because a bump
    # reset only rewinds an offset and the stale bytes survive intact. Neither
    # does reading a document after its arena is reset. Both are correct by
    # construction and **unverifiable by assertion here** — recorded in
    # roadmap section E rather than claimed as tested.
    assert(agnosai_otlp_ring_frag_arena(ring) != 0, "the fragment arena exists");
    assert(agnosai_otlp_ring_doc_arena(ring) != 0, "the document arena exists");
    assert(agnosai_otlp_ring_frag_arena(ring) != agnosai_otlp_ring_doc_arena(ring),
      "and they are SEPARATE — fragments must not live where the document is built");

    # An empty drain is 0, not an empty document — the exporter must be able to
    # tell "nothing to send" from "send this".
    assert_eq(agnosai_otlp_ring_drain(ring, str_from("agnosai")), 0,
      "draining an empty ring answers 0, not an empty batch");

    assert_eq(agnosai_otlp_ring_enqueue(ring, tool, _t_ctx()), 1, "a span enqueues");
    assert_eq(agnosai_otlp_ring_count(ring), 1, "and is counted");
    agnosai_otlp_ring_enqueue(ring, crew, _t_ctx());
    assert_eq(agnosai_otlp_ring_count(ring), 2, "as is a second");

    var doc = agnosai_otlp_ring_drain(ring, str_from("agnosai"));
    assert(doc != 0, "the drain yields a document");
    assert_eq(str_contains_cstr(doc, "\"service.name\""), 1, "with the resource envelope");
    assert_eq(str_contains_cstr(doc, "\"execute_tool echo\""), 1, "carrying the first span");
    assert_eq(str_contains_cstr(doc, "\"invoke_workflow c\""), 1, "and the second");
    assert_eq(str_contains_cstr(doc, "}},{\"traceId\":"), 1, "comma-separated");
    assert_eq(agnosai_otlp_ring_count(ring), 0, "and the ring is emptied");
    assert_eq(agnosai_otlp_ring_drain(ring, str_from("agnosai")), 0,
      "a second drain has nothing left");

    # ⚠ Order is OLDEST FIRST. A collector orders by timestamp, but a batch that
    # reverses insertion order makes the ring's own arithmetic untestable — and
    # `head - n + i` is exactly where an off-by-one hides.
    var ord = agnosai_otlp_ring_new();
    var s1 = agnosai_genai_tool_span(str_from("first"), str_from("a"), str_from("t"));
    var s2 = agnosai_genai_tool_span(str_from("second"), str_from("a"), str_from("t"));
    agnosai_otlp_ring_enqueue(ord, s1, _t_ctx());
    agnosai_otlp_ring_enqueue(ord, s2, _t_ctx());
    var od = agnosai_otlp_ring_drain(ord, str_from("agnosai"));
    assert(str_index_of_cstr(od, "\"first\"") < str_index_of_cstr(od, "\"second\""),
      "the batch is oldest-first");

    # --- overflow is counted, not silent ------------------------------------
    # ⚠ hoosh's ring overwrites and counts nothing, so loss is invisible. Fill
    # past capacity and the excess must show up in `dropped`.
    var full = agnosai_otlp_ring_new();
    for (var i = 0; i < 300; i = i + 1) {
        agnosai_otlp_ring_enqueue(full, tool, _t_ctx());
    }
    assert_eq(agnosai_otlp_ring_count(full), 256, "the ring holds at most its capacity");
    assert_eq(agnosai_otlp_ring_dropped(full), 44, "and the other 44 are COUNTED as dropped");
    assert_eq(agnosai_otlp_ring_enqueue(full, tool, _t_ctx()), 0,
      "an enqueue into a full ring reports failure");
    assert_eq(agnosai_otlp_ring_dropped(full), 45, "and increments the drop count");

    # The overflowed ring still drains to a well-formed document of exactly
    # capacity spans — a wrapped ring is where the modulo arithmetic breaks.
    var fd = agnosai_otlp_ring_drain(full, str_from("agnosai"));
    assert(fd != 0, "a wrapped ring still drains");
    assert_eq(str_contains_cstr(fd, "]}]}]}"), 1, "to a closed document");
    assert_eq(str_contains_cstr(fd, ",,"), 0, "with no empty slot leaking a doubled comma");
    assert_eq(agnosai_otlp_ring_count(full), 0, "and empties");
    # Drops are cumulative across drains — they describe the process, not the batch.
    assert_eq(agnosai_otlp_ring_dropped(full), 45, "the drop count survives a drain");

    # --- rings are independent ----------------------------------------------
    var r1 = agnosai_otlp_ring_new();
    var r2 = agnosai_otlp_ring_new();
    agnosai_otlp_ring_enqueue(r1, tool, _t_ctx());
    assert_eq(agnosai_otlp_ring_count(r1), 1, "one ring holds its span");
    assert_eq(agnosai_otlp_ring_count(r2), 0, "and the other stays empty");

    # --- a drained document survives until the NEXT drain -------------------
    # The lifetime rule the two-arena split buys. Enqueueing after a drain must
    # not disturb the document already handed out, because the fragments live in
    # a different arena from the document.
    var lr = agnosai_otlp_ring_new();
    agnosai_otlp_ring_enqueue(lr, tool, _t_ctx());
    var held = agnosai_otlp_ring_drain(lr, str_from("agnosai"));
    var held_len = str_len(held);
    for (var i = 0; i < 20; i = i + 1) {
        agnosai_otlp_ring_enqueue(lr, crew, _t_ctx());
    }
    assert_eq(str_len(held), held_len, "the handed-out document is unchanged by later enqueues");
    assert_eq(str_contains_cstr(held, "\"execute_tool echo\""), 1,
      "and still holds its own span");
    assert_eq(str_contains_cstr(held, "invoke_workflow"), 0,
      "with none of the spans queued after it");

    # --- the exporter -------------------------------------------------------
    # `flush` is the testable half: it decides whether and what to send. Only
    # the final byte-moving POST needs a collector, and it is skipped when no
    # endpoint is configured — which is also the shape a disabled exporter has.
    var ex = agnosai_otlp_exporter_new(0, str_from("agnosai"), 1000);
    assert(ex != 0, "an exporter is created");
    assert(agnosai_otlp_exporter_ring(ex) != 0, "with a ring");
    assert_eq(agnosai_otlp_exporter_exported(ex), 0, "and nothing exported yet");
    assert_eq(agnosai_otlp_exporter_stopping(ex), 0, "and is not stopping");

    assert_eq(agnosai_otlp_exporter_flush(ex), 0, "flushing an empty exporter sends nothing");

    agnosai_otlp_ring_enqueue(agnosai_otlp_exporter_ring(ex), tool, _t_ctx());
    agnosai_otlp_ring_enqueue(agnosai_otlp_exporter_ring(ex), crew, _t_ctx());
    assert_eq(agnosai_otlp_exporter_flush(ex), 2, "a flush reports the spans in the batch");
    assert_eq(agnosai_otlp_exporter_exported(ex), 2, "and accumulates them");
    assert_eq(agnosai_otlp_ring_count(agnosai_otlp_exporter_ring(ex)), 0,
      "leaving the ring empty");
    assert_eq(agnosai_otlp_exporter_flush(ex), 0, "a second flush has nothing to send");

    # ⚠ The drain happens even with NO endpoint. Skipping it would let the ring
    # fill and every span report as dropped, which reads like an exporter bug
    # rather than an absent collector.
    var noep = agnosai_otlp_exporter_new(0, str_from("agnosai"), 1000);
    for (var i = 0; i < 400; i = i + 1) {
        agnosai_otlp_ring_enqueue(agnosai_otlp_exporter_ring(noep), tool, _t_ctx());
        if (i % 100 == 0) { agnosai_otlp_exporter_flush(noep); }
    }
    assert_eq(agnosai_otlp_ring_dropped(agnosai_otlp_exporter_ring(noep)), 0,
      "an endpoint-less exporter still drains, so nothing is dropped");
    assert(agnosai_otlp_exporter_exported(noep) > 0, "and it counts what it discarded");

    # --- stop flushes what is left -------------------------------------------
    # ⚠ The oracle's TracingGuard exports pending spans when it drops. Without a
    # final flush every span queued in the last interval is lost on a clean
    # shutdown — the batch most likely to explain why the process is stopping.
    var st = agnosai_otlp_exporter_new(0, str_from("agnosai"), 1000);
    agnosai_otlp_ring_enqueue(agnosai_otlp_exporter_ring(st), tool, _t_ctx());
    agnosai_otlp_ring_enqueue(agnosai_otlp_exporter_ring(st), crew, _t_ctx());
    agnosai_otlp_ring_enqueue(agnosai_otlp_exporter_ring(st), tool, _t_ctx());
    assert_eq(agnosai_otlp_exporter_stop(st), 3, "stop flushes the pending spans");
    assert_eq(agnosai_otlp_exporter_stopping(st), 1, "and marks the exporter stopping");
    assert_eq(agnosai_otlp_ring_count(agnosai_otlp_exporter_ring(st)), 0,
      "leaving nothing behind");
    assert_eq(agnosai_otlp_exporter_stop(st), 0, "and stopping twice is a no-op");

    # --- the background thread actually runs --------------------------------
    # Everything above drives `flush` directly. This starts the real detached
    # thread on a short interval and lets it do a cycle on its own, which is the
    # only thing that proves the loop reaches `flush` at all — and that stopping
    # it terminates the thread rather than leaving the process unable to exit.
    #
    # ⚠ Cheap only because the sleep is sliced. With one `sleep_ms(interval)`
    # this suite would wait a full interval for the stop to land, and
    # `syscall(60, ..)` exits one thread — a still-sleeping detached thread
    # holds the process open. That was measured at 1004 ms before slicing.
    var before_bg = _t_threads();
    var bg = agnosai_otlp_exporter_new(0, str_from("agnosai"), 30);
    agnosai_otlp_ring_enqueue(agnosai_otlp_exporter_ring(bg), tool, _t_ctx());
    agnosai_otlp_exporter_start(bg);
    assert_eq(_t_threads(), before_bg + 1, "start runs one exporter thread");
    sleep_ms(200);
    assert(agnosai_otlp_exporter_exported(bg) >= 1,
      "the background thread flushed the queued span on its own");
    assert_eq(agnosai_otlp_ring_count(agnosai_otlp_exporter_ring(bg)), 0,
      "draining the ring as it went");

    # It keeps going, rather than flushing once and falling out of the loop.
    agnosai_otlp_ring_enqueue(agnosai_otlp_exporter_ring(bg), crew, _t_ctx());
    sleep_ms(200);
    assert(agnosai_otlp_exporter_exported(bg) >= 2, "and keeps flushing on each interval");

    agnosai_otlp_exporter_stop(bg);
    assert_eq(agnosai_otlp_exporter_stopping(bg), 1, "and stops when asked");
    # ⭐ 2.1.7 (roadmap B15): and its thread is gone when `stop` returns. It was detached and
    # never joined, so it could outlive `main` and turn a failing suite's exit status into 0.
    assert_eq(_t_threads(), before_bg, "⭐ no exporter thread is left once stop returns");
    var twice = agnosai_otlp_exporter_new(0, str_from("agnosai"), 30);
    agnosai_otlp_exporter_start(twice);
    agnosai_otlp_exporter_start(twice);
    assert_eq(_t_threads(), before_bg + 1, "starting twice starts one thread");
    agnosai_otlp_exporter_stop(twice);
    assert_eq(_t_threads(), before_bg, "and stopping it leaves none");

    # --- 2.1.6: a POST is bounded, in memory and in time --------------------
    # Through 2.1.5 every POST went through the bare `sandhi_http_post`: its URL,
    # headers, request and a 256 KiB receive buffer on the no-free global bump —
    # ~258 KiB of RSS per batch against a live collector — and no timeouts, so a
    # collector that never answered held the exporter, and its stop, forever.
    #
    # (a) Memory. A port nothing listens on: the POST fails at connect, which
    # still exercises the whole request build. After the first flush (which
    # grows the exporter's arena once), what a flush leaves on the global bump
    # is sandhi's own connect path, not the exporter's: ~120 B a POST measured
    # here (16 of it `sockaddr_in` in lib/net.cyr), ~480 B against a collector
    # that answers — against 2.1.5's ~1.5 KB and ~258 KB. Filed upstream with
    # sandhi; the bound below is what a regression to the bare form breaks.
    var cl = agnosai_otlp_exporter_new(str_from("http://127.0.0.1:1"), str_from("agnosai"), 1000);
    assert(str_eq_cstr(str_from(agnosai_otlp_exporter_url(cl)), "http://127.0.0.1:1/v1/traces") == 1,
      "the POST URL is built once, at creation");
    agnosai_otlp_ring_enqueue(agnosai_otlp_exporter_ring(cl), tool, _t_ctx());
    agnosai_otlp_exporter_flush(cl);
    var cl_before = alloc_used();
    for (var cli = 0; cli < 20; cli = cli + 1) {
        agnosai_otlp_ring_enqueue(agnosai_otlp_exporter_ring(cl), tool, _t_ctx());
        agnosai_otlp_exporter_flush(cl);
    }
    var cl_per = (alloc_used() - cl_before) / 20;
    assert(cl_per < 512,
      "a POST leaves under 512 B on the global bump (sandhi's connect path) — 2.1.5 left ~1.5 KB, and ~258 KB live");

    # (b) Time. A socket that listens and never accepts: the connect completes
    # in the kernel's backlog, the request is sent, and no answer ever comes.
    var lt, lfd = tcp_socket();
    sock_reuse(lfd);
    var lport = 0;
    var lp = 47817;
    while (lp < 47833 && lport == 0) {
        var bt, bv = sock_bind(lfd, INADDR_LOOPBACK(), lp);
        if (is_err_result(bt) == 0) { lport = lp; }
        lp = lp + 1;
    }
    var hung_ok = 0;
    if (lport != 0) {
        var st2, sv2 = sock_listen(lfd, 8);
        if (is_err_result(st2) == 0) { hung_ok = 1; }
    }
    if (hung_ok == 1) {
        var hsb = str_builder_new();
        str_builder_add_cstr(hsb, "http://127.0.0.1:");
        str_builder_add_int(hsb, lport);
        var hung = agnosai_otlp_exporter_with_timeouts(
          agnosai_otlp_exporter_new(str_builder_build(hsb), str_from("agnosai"), 1000), 200, 200, 400);
        agnosai_otlp_ring_enqueue(agnosai_otlp_exporter_ring(hung), tool, _t_ctx());
        var h0 = clock_now_ns();
        agnosai_otlp_exporter_flush(hung);
        var hung_ms = (clock_now_ns() - h0) / 1000000;
        assert(hung_ms < 3000,
          "a collector that never answers costs a flush its timeout — not forever, as through 2.1.5");
    } else {
        println("telemetry_otlp: no loopback port to listen on; the hung-collector check did not run");
    }
    sock_close(lfd);

    # --- the export path allocates NOTHING on the global bump ----------------
    #
    # ⚠ This suite had no allocator assertion at all, and that is exactly why
    # the module shipped constructing its builders with `str_builder_new_a` and
    # then making 29 bare `str_builder_add*` + 4 bare `str_builder_build` calls.
    # A `str_builder` does not remember its allocator (`lib/str.cyr:428`), so the
    # arenas received only 88-byte headers and every fragment and document went
    # to the no-free global bump — ~2.7 KB per span, for process lifetime.
    #
    # Absolute equality against ZERO, not a bound: state.md's own note is that a
    # round-number threshold asserts less than it looks like it does.
    #
    # ⚠ **What this does and does NOT catch — mutation-verified 2026-08-12, and
    # the first version of this comment overclaimed.** Reverting any call that
    # actually allocates kills it (2 failures each):
    #   `str_builder_build_a` -> `str_builder_build`, frag arena       KILLED
    #   `str_builder_build_a` -> `str_builder_build`, doc arena        KILLED
    #   `_agnosai_otlp_json_str_a` -> stdlib `add_json_str`            KILLED
    #   `str_from_a` -> `str_from`                                     KILLED
    # But reverting ONE small `str_builder_add_cstr_a` -> `add_cstr`   SURVIVED,
    # because `_sb_grow` only allocates when capacity is exceeded — a short
    # constant appended into an already-grown buffer never reaches the allocator,
    # so which allocator it would have used is unobservable. A bare `add` is
    # still wrong (it allocates as soon as it is the call that triggers a grow),
    # it is simply not detectable here. Read the calls, don't rely on this alone.
    var ar = agnosai_otlp_ring_new();
    var asvc = str_from("alloc-probe");
    var aspan = agnosai_genai_chat_span(str_from("gpt-4o"), str_from("hoosh"));
    agnosai_genai_record_usage(aspan, 1234, 567, str_from("gpt-4o"));
    # A CHILD context, so the probe covers `parentSpanId` and the composed
    # `chat gpt-4o` name too (ADR 023) — both must write into the arena.
    var actx = agnosai_otlp_ctx_new_child(0x0102030405060708, 0x090a0b0c0d0e0f10,
      0x1122334455667788, 0xaabbccddeeff0011, 1000, 2000, AGNOSAI_OTLP_STATUS_OK);

    # Warm once — the first cycle faults in the arena chunks.
    agnosai_otlp_ring_enqueue(ar, aspan, actx);
    agnosai_otlp_ring_drain(ar, asvc);

    var g_before = alloc_used();
    for (var ai = 0; ai < 64; ai = ai + 1) {
        agnosai_otlp_ring_enqueue(ar, aspan, actx);
    }
    var doc64 = agnosai_otlp_ring_drain(ar, asvc);
    assert_eq(alloc_used() - g_before, 0,
      "64 spans encoded, batched and drained charge the global bump ZERO bytes");
    assert(str_len(doc64) > 0, "and still produce a document");

    # A FULL ring must not spill either — ARENA_FULL_SPILL spills to the global
    # bump, so an undersized arena silently reintroduces the leak at load.
    # AGNOSAI_OTLP_ARENA_BYTES is sized from AGNOSAI_OTLP_RING_MAX for this.
    var g_full = alloc_used();
    for (var aj = 0; aj < AGNOSAI_OTLP_RING_MAX; aj = aj + 1) {
        agnosai_otlp_ring_enqueue(ar, aspan, actx);
    }
    agnosai_otlp_ring_drain(ar, asvc);
    assert_eq(alloc_used() - g_full, 0,
      "a completely full ring drains without spilling to the global bump");

    # --- the POST target carries the OTLP path -------------------------------
    #
    # ⚠ `agnosai_otlp_path` existed and had ZERO production callers: the exporter
    # posted the raw endpoint, so the documented `http://localhost:4318` sidecar
    # form received `POST /` and 404'd. The whole tier was non-functional.
    var pa = default_alloc();
    assert(str_eq_cstr(_agnosai_otlp_post_url(pa, str_from("http://localhost:4318")),
        "http://localhost:4318/v1/traces"),
      "a path-less endpoint gets /v1/traces appended");
    assert(str_eq_cstr(_agnosai_otlp_post_url(pa, str_from("https://collector:4318")),
        "https://collector:4318/v1/traces"),
      "https too — the scheme offset, not a hardcoded 7");
    # ⚠ 2.1.6: the generic endpoint is a BASE URL (the OTel spec). Through 2.1.5 a
    # base naming any path — a trailing `/`, a gateway's `/otlp` — was posted to as
    # given, and the collector's 404 was ignored: every span lost in silence.
    assert(str_eq_cstr(_agnosai_otlp_post_url(pa, str_from("http://host/custom/path")),
        "http://host/custom/path/v1/traces"),
      "a base with a path gets /v1/traces appended to it (2.1.6)");
    assert(str_eq_cstr(_agnosai_otlp_post_url(pa, str_from("http://localhost:4318/")),
        "http://localhost:4318/v1/traces"),
      "a trailing slash is not doubled");
    assert(str_eq_cstr(_agnosai_otlp_post_url(pa, str_from("https://gw.example.com/otlp/")),
        "https://gw.example.com/otlp/v1/traces"),
      "nor is a gateway path's");
    assert(str_eq_cstr(_agnosai_otlp_post_url(pa, str_from("HTTPS://otlp.example.com")),
        "HTTPS://otlp.example.com/v1/traces"),
      "the scheme in any case — through 2.1.5 an upper-case https read as pathed and posted to /");
    assert(str_eq_cstr(_agnosai_otlp_post_url(pa, str_from("http://localhost:4318/v1/traces")),
        "http://localhost:4318/v1/traces"),
      "a base already ending in /v1/traces is used as given, not doubled (kept from 2.1.5)");
    assert_eq(agnosai_otlp_is_https("HTTPS://c:4318"), 1, "https is detected in any case");

    # The per-signal form is used exactly as given (OTEL_EXPORTER_OTLP_TRACES_ENDPOINT).
    var tx = agnosai_otlp_exporter_new_traces(str_from("http://gw:4318/custom"), str_from("agnosai"), 1000);
    assert(str_eq_cstr(str_from(agnosai_otlp_exporter_url(tx)), "http://gw:4318/custom") == 1,
      "a traces endpoint is posted to as-is");
    var bx = agnosai_otlp_exporter_new(str_from("http://gw:4318/custom"), str_from("agnosai"), 1000);
    assert(str_eq_cstr(str_from(agnosai_otlp_exporter_url(bx)), "http://gw:4318/custom/v1/traces") == 1,
      "where the same URL as a generic endpoint is a base");
    assert_eq(agnosai_otlp_exporter_url(agnosai_otlp_exporter_new_traces(0, str_from("agnosai"), 1000)), 0,
      "and a traces exporter with no URL posts nowhere");

    _t_http_server_span();
    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
