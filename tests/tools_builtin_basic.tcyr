# =========================================================================
# tools_builtin_basic.tcyr — parity tests for src/tools_builtin_basic.cyr
#
# Oracle: the #[cfg(test)] blocks in rust-old/src/tools/builtin/echo.rs (3
# tests) and json_transform.rs (3 tests).
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/core_error.cyr"
include "src/core_json.cyr"
include "src/tools_native.cyr"
include "src/tools_registry.cyr"
include "src/tools_builtin_basic.cyr"
include "tests/test_helpers.cyr"

# Parse JSON text into a bayan value.
fn _t_json(src): i64 {
    var s = str_from(src);
    return bayan_json_v_parse_buf(str_data(s), str_len(s));
}

fn main() {
    alloc_init();

    test_group("tools_builtin_basic");

    var echo = agnosai_echo_tool();
    var jt = agnosai_json_transform_tool();

    # --- echo_schema ---
    var es = agnosai_tool_schema(echo);
    assert(str_eq(agnosai_tool_schema_name(es), str_from("echo")) == 1, "echo schema name");
    assert_eq(vec_len(agnosai_tool_schema_parameters(es)), 1, "echo has one parameter");
    assert_eq(agnosai_param_schema_required(vec_get(agnosai_tool_schema_parameters(es), 0)), 1,
    "echo's message parameter is required");
    assert(str_eq(agnosai_param_schema_name(vec_get(agnosai_tool_schema_parameters(es), 0)),
    str_from("message")) == 1, "echo's parameter is named message");

    # --- echo_returns_message ---
    var in1 = agnosai_tool_input_new();
    agnosai_tool_input_set(in1, str_from("message"), bayan_json_v_str_new(str_from("hello")));
    var out1 = agnosai_tool_execute(echo, in1);
    assert_eq(agnosai_tool_output_success(out1), 1, "echo succeeds");
    assert(str_eq(bayan_json_v_str(agnosai_tool_output_result(out1)), str_from("hello")) == 1,
    "echo returns the message");
    assert_eq(agnosai_tool_output_error(out1), 0, "echo has no error");

    # --- echo_missing_param ---
    var out2 = agnosai_tool_execute(echo, agnosai_tool_input_new());
    assert_eq(agnosai_tool_output_success(out2), 0, "echo without a message fails");
    assert(agnosai_tool_output_error(out2) != 0, "echo's failure carries a message");
    assert(str_eq(agnosai_tool_output_error(out2),
    str_from("missing required parameter: message")) == 1, "echo's error text");

    # --- echo returns the whole VALUE, not a stringified form ---
    var in3 = agnosai_tool_input_new();
    agnosai_tool_input_set(in3, str_from("message"), _t_json("{\"a\":1}"));
    var out3 = agnosai_tool_execute(echo, in3);
    assert_eq(agnosai_tool_output_success(out3), 1, "echo accepts a non-string message");
    assert_eq(bayan_json_v_is_obj(agnosai_tool_output_result(out3)), 1,
    "echo returns an object unchanged, not narrowed to a string");
    assert(str_eq(bayan_json_v_build(agnosai_tool_output_result(out3)), str_from("{\"a\":1}")) == 1,
    "the echoed object is byte-identical");

    var in4 = agnosai_tool_input_new();
    agnosai_tool_input_set(in4, str_from("message"), bayan_json_v_int_new(42));
    assert_eq(bayan_json_v_int(agnosai_tool_output_result(agnosai_tool_execute(echo, in4))), 42,
    "echo returns an integer unchanged");

    # --- json_transform schema ---
    var js = agnosai_tool_schema(jt);
    assert(str_eq(agnosai_tool_schema_name(js), str_from("json_transform")) == 1,
    "json_transform schema name");
    assert_eq(vec_len(agnosai_tool_schema_parameters(js)), 2, "json_transform has two parameters");
    assert(str_eq(agnosai_param_schema_type(vec_get(agnosai_tool_schema_parameters(js), 0)),
    str_from("object")) == 1, "the data parameter is an object");

    # --- extract_field ---
    var jin = agnosai_tool_input_new();
    agnosai_tool_input_set(jin, str_from("data"), _t_json("{\"name\":\"Alice\",\"age\":30}"));
    agnosai_tool_input_set(jin, str_from("field"), bayan_json_v_str_new(str_from("name")));
    var jout = agnosai_tool_execute(jt, jin);
    assert_eq(agnosai_tool_output_success(jout), 1, "json_transform succeeds");
    assert(str_eq(bayan_json_v_str(agnosai_tool_output_result(jout)), str_from("Alice")) == 1,
    "json_transform extracts the field");

    # a non-string field extracts as its own type
    var jin2 = agnosai_tool_input_new();
    agnosai_tool_input_set(jin2, str_from("data"), _t_json("{\"name\":\"Alice\",\"age\":30}"));
    agnosai_tool_input_set(jin2, str_from("field"), bayan_json_v_str_new(str_from("age")));
    assert_eq(bayan_json_v_int(agnosai_tool_output_result(agnosai_tool_execute(jt, jin2))), 30,
    "an integer field extracts as an integer");

    # --- missing_field ---
    var jin3 = agnosai_tool_input_new();
    agnosai_tool_input_set(jin3, str_from("data"), _t_json("{\"name\":\"Alice\"}"));
    agnosai_tool_input_set(jin3, str_from("field"), bayan_json_v_str_new(str_from("email")));
    var jout3 = agnosai_tool_execute(jt, jin3);
    assert_eq(agnosai_tool_output_success(jout3), 0, "an absent field fails");
    assert(str_contains(agnosai_tool_output_error(jout3), str_from("not found")) == 1,
    "the error says not found");
    assert(str_contains(agnosai_tool_output_error(jout3), str_from("email")) == 1,
    "the error names the missing field");

    # --- missing_data_param ---
    var jin4 = agnosai_tool_input_new();
    agnosai_tool_input_set(jin4, str_from("field"), bayan_json_v_str_new(str_from("name")));
    var jout4 = agnosai_tool_execute(jt, jin4);
    assert_eq(agnosai_tool_output_success(jout4), 0, "a missing data parameter fails");
    assert(str_eq(agnosai_tool_output_error(jout4),
    str_from("missing required parameter: data")) == 1, "the data error text");

    # --- a missing or non-string field parameter ---
    var jin5 = agnosai_tool_input_new();
    agnosai_tool_input_set(jin5, str_from("data"), _t_json("{\"a\":1}"));
    var jout5 = agnosai_tool_execute(jt, jin5);
    assert_eq(agnosai_tool_output_success(jout5), 0, "a missing field parameter fails");
    assert(str_contains(agnosai_tool_output_error(jout5), str_from("must be a string")) == 1,
    "the field error explains the type requirement");

    var jin6 = agnosai_tool_input_new();
    agnosai_tool_input_set(jin6, str_from("data"), _t_json("{\"a\":1}"));
    agnosai_tool_input_set(jin6, str_from("field"), bayan_json_v_int_new(7));
    assert_eq(agnosai_tool_output_success(agnosai_tool_execute(jt, jin6)), 0,
    "a non-string field parameter fails rather than being coerced");

    # --- a non-object data value fails cleanly rather than crashing ---
    var jin7 = agnosai_tool_input_new();
    agnosai_tool_input_set(jin7, str_from("data"), bayan_json_v_str_new(str_from("not an object")));
    agnosai_tool_input_set(jin7, str_from("field"), bayan_json_v_str_new(str_from("a")));
    var jout7 = agnosai_tool_execute(jt, jin7);
    assert_eq(agnosai_tool_output_success(jout7), 0, "a non-object data value fails");
    assert(agnosai_tool_output_error(jout7) != 0, "and carries an error rather than crashing");

    # --- the builtins register and dispatch through the registry ---
    var reg = agnosai_register_basic_builtins(agnosai_tool_registry_new());
    assert_eq(agnosai_tool_registry_count(reg), 2, "both builtins registered");
    assert_eq(agnosai_tool_registry_has(reg, str_from("echo")), 1, "echo is registered");
    assert_eq(agnosai_tool_registry_has(reg, str_from("json_transform")), 1,
    "json_transform is registered");

    var looked_up = agnosai_tool_registry_get(reg, str_from("echo"));
    assert(looked_up != 0, "echo resolves from the registry");
    var rin = agnosai_tool_input_new();
    agnosai_tool_input_set(rin, str_from("message"), bayan_json_v_str_new(str_from("via registry")));
    assert(str_eq(bayan_json_v_str(agnosai_tool_output_result(agnosai_tool_execute(looked_up, rin))),
    str_from("via registry")) == 1, "a registry-resolved tool executes correctly");

    # and the allow-list still gates them
    var allow = vec_new();
    vec_push(allow, str_from("echo"));
    assert(agnosai_tool_registry_get_allowed(reg, str_from("echo"), allow) != 0,
    "a permitted builtin resolves");
    assert_eq(agnosai_tool_registry_get_allowed(reg, str_from("json_transform"), allow), 0,
    "an unlisted builtin is blocked");

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
