# =========================================================================
# sandbox_wasm.tcyr — tests for src/sandbox/wasm.cyr
#
# Oracle test block: rust-old/src/sandbox/wasm.rs, eleven `#[test]`s. Six port
# directly; five need a real `wasmtime` to execute anything and are guarded.
#
# ⚠ **`wasmtime` 47.0.3 IS installed as of 2026-08-11**, so the guarded five now
# run. Both arms are real assertions rather than skips: with no runtime,
# `agnosai_wasm_available()` is 0 and `execute` must return a `Sandbox` error
# naming the binary rather than half-working; with one, a real module must
# actually execute. The loud-skip guard below is the same shape
# `tests/sandbox_python.tcyr` uses: if a runtime is demonstrably present, the
# guarded tests MUST have run.
#
# ⚠ **The first end-to-end run found a bug the guards could never reach.**
# `agnosai_wasm_execute` reaches `sandbox_create`/`sandbox_exec` directly instead
# of through `agnosai_kavach_execute`, which is the only other caller of
# kavach's lazy initialiser — so kavach's dispatch table was empty and every
# execute answered "backend not available: wasm". `agnosai_wasm_available()` did
# not catch it because `backend_is_available` probes the FILESYSTEM for the
# wasmtime binary while `backend_dispatch_exec` looks for a registered function
# pointer: availability said 1 and the next call said missing. Fixed in
# `src/sandbox/wasm.cyr`; `_t_execute_real_module` below is the guard.
#
# ⚠ **No `.wasm` fixture exists anywhere in this repo**, and none can be
# compiled here — `rustup target list --installed` has only the host. The
# oracle builds its modules from inline WAT via the `wat` dev-dep. So the
# fixtures here are **hand-encoded byte literals**: an 8-byte header for
# everything the loader and validator need, and a minimal `_start` module for
# the execute path.
#
# What is pinned past the oracle:
#
#   * **the header check is the WHOLE header**, magic AND version. A magic-only
#     check accepts a version-2 module that wasmtime will refuse later.
#   * **`load_module_from_file` re-validates.** A caller must not be able to
#     make the sandbox execute an arbitrary path it never proved was WASM.
#   * **the exit taxonomy.** `-1` deadline, `-2` fuel, `-3` trap — and a guest's
#     OWN `proc_exit(n)` passes through as `n`, which a blanket "non-zero is -3"
#     would erase. The classifier is fed captured stderr as data, so this is
#     testable without a runtime.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/strcase.cyr"
include "src/core/mod.cyr"
include "src/definitions/presets_data.cyr"
include "src/definitions/loader.cyr"
include "src/sandbox/mod.cyr"
include "tests/test_helpers.cyr"

var _T_ROOT = "/tmp/agnosai-sandbox-wasm-test";

# Assert two Strs are equal.
fn _t_seq(a: Str, b: Str, name): i64 {
    return assert(str_eq(a, b), name);
}

# Join two pieces into a NUL-terminated Str.
fn _t_join(a: Str, b: Str): i64 {
    var sb = str_builder_new();
    str_builder_add(sb, a);
    str_builder_add(sb, b);
    return str_builder_build(sb);
}

# The eight-byte WASM header: `\0asm` + little-endian version 1. Every module
# begins with exactly these bytes, so a header-only buffer is a valid fixture
# for anything that does not execute.
fn _t_wasm_header(): i64 {
    var b = alloc(8);
    store8(b + 0, 0);
    store8(b + 1, 97);
    store8(b + 2, 115);
    store8(b + 3, 109);
    store8(b + 4, 1);
    store8(b + 5, 0);
    store8(b + 6, 0);
    store8(b + 7, 0);
    return b;
}

# The same with a tampered byte at `at`, for the rejection cases.
fn _t_wasm_header_bad(at, to): i64 {
    var b = _t_wasm_header();
    store8(b + at, to);
    return b;
}

# A module that reads stdin and writes it back to stdout — 184 bytes.
#
# ⚠ **The two behaviours the oracle pins that this suite did not.**
# `execute_wasi_module_captures_stdout` (`wasm.rs:322`) and
# `execute_wasi_module_with_stdin_input` (`wasm.rs:353`) are the module's core
# contract, and ADR 019 says "the stdin contract is preserved exactly" — but the
# only end-to-end test here ran a 36-byte nop and asserted the exit code, so
# `config_stdin` could have been dropped entirely, or stdout could have come
# back empty, with the suite green.
#
# Sections: two `fd_read`/`fd_write` imports, one memory page, an `_start` that
# reads into offset 64, copies the returned byte count into the write iovec's
# length field, and writes it back out. Memory map: read iovec at 0, write
# iovec at 8, nread at 16, nwritten at 24, buffer at 64.
fn _t_echo_module_bytes(): i64 {
    var m = alloc(184);
    store8(m + 0, 0); store8(m + 1, 97); store8(m + 2, 115); store8(m + 3, 109); store8(m + 4, 1); store8(m + 5, 0); store8(m + 6, 0); store8(m + 7, 0);
    store8(m + 8, 1); store8(m + 9, 12); store8(m + 10, 2); store8(m + 11, 96); store8(m + 12, 4); store8(m + 13, 127); store8(m + 14, 127); store8(m + 15, 127);
    store8(m + 16, 127); store8(m + 17, 1); store8(m + 18, 127); store8(m + 19, 96); store8(m + 20, 0); store8(m + 21, 0); store8(m + 22, 2); store8(m + 23, 68);
    store8(m + 24, 2); store8(m + 25, 22); store8(m + 26, 119); store8(m + 27, 97); store8(m + 28, 115); store8(m + 29, 105); store8(m + 30, 95); store8(m + 31, 115);
    store8(m + 32, 110); store8(m + 33, 97); store8(m + 34, 112); store8(m + 35, 115); store8(m + 36, 104); store8(m + 37, 111); store8(m + 38, 116); store8(m + 39, 95);
    store8(m + 40, 112); store8(m + 41, 114); store8(m + 42, 101); store8(m + 43, 118); store8(m + 44, 105); store8(m + 45, 101); store8(m + 46, 119); store8(m + 47, 49);
    store8(m + 48, 7); store8(m + 49, 102); store8(m + 50, 100); store8(m + 51, 95); store8(m + 52, 114); store8(m + 53, 101); store8(m + 54, 97); store8(m + 55, 100);
    store8(m + 56, 0); store8(m + 57, 0); store8(m + 58, 22); store8(m + 59, 119); store8(m + 60, 97); store8(m + 61, 115); store8(m + 62, 105); store8(m + 63, 95);
    store8(m + 64, 115); store8(m + 65, 110); store8(m + 66, 97); store8(m + 67, 112); store8(m + 68, 115); store8(m + 69, 104); store8(m + 70, 111); store8(m + 71, 116);
    store8(m + 72, 95); store8(m + 73, 112); store8(m + 74, 114); store8(m + 75, 101); store8(m + 76, 118); store8(m + 77, 105); store8(m + 78, 101); store8(m + 79, 119);
    store8(m + 80, 49); store8(m + 81, 8); store8(m + 82, 102); store8(m + 83, 100); store8(m + 84, 95); store8(m + 85, 119); store8(m + 86, 114); store8(m + 87, 105);
    store8(m + 88, 116); store8(m + 89, 101); store8(m + 90, 0); store8(m + 91, 0); store8(m + 92, 3); store8(m + 93, 2); store8(m + 94, 1); store8(m + 95, 1);
    store8(m + 96, 5); store8(m + 97, 3); store8(m + 98, 1); store8(m + 99, 0); store8(m + 100, 1); store8(m + 101, 7); store8(m + 102, 19); store8(m + 103, 2);
    store8(m + 104, 6); store8(m + 105, 109); store8(m + 106, 101); store8(m + 107, 109); store8(m + 108, 111); store8(m + 109, 114); store8(m + 110, 121); store8(m + 111, 2);
    store8(m + 112, 0); store8(m + 113, 6); store8(m + 114, 95); store8(m + 115, 115); store8(m + 116, 116); store8(m + 117, 97); store8(m + 118, 114); store8(m + 119, 116);
    store8(m + 120, 0); store8(m + 121, 2); store8(m + 122, 10); store8(m + 123, 36); store8(m + 124, 1); store8(m + 125, 34); store8(m + 126, 0); store8(m + 127, 65);
    store8(m + 128, 0); store8(m + 129, 65); store8(m + 130, 0); store8(m + 131, 65); store8(m + 132, 1); store8(m + 133, 65); store8(m + 134, 16); store8(m + 135, 16);
    store8(m + 136, 0); store8(m + 137, 26); store8(m + 138, 65); store8(m + 139, 8); store8(m + 140, 65); store8(m + 141, 16); store8(m + 142, 40); store8(m + 143, 2);
    store8(m + 144, 0); store8(m + 145, 54); store8(m + 146, 2); store8(m + 147, 4); store8(m + 148, 65); store8(m + 149, 1); store8(m + 150, 65); store8(m + 151, 8);
    store8(m + 152, 65); store8(m + 153, 1); store8(m + 154, 65); store8(m + 155, 24); store8(m + 156, 16); store8(m + 157, 1); store8(m + 158, 26); store8(m + 159, 11);
    store8(m + 160, 11); store8(m + 161, 22); store8(m + 162, 1); store8(m + 163, 0); store8(m + 164, 65); store8(m + 165, 0); store8(m + 166, 11); store8(m + 167, 16);
    store8(m + 168, 64); store8(m + 169, 0); store8(m + 170, 0); store8(m + 171, 0); store8(m + 172, 64); store8(m + 173, 0); store8(m + 174, 0); store8(m + 175, 0);
    store8(m + 176, 64); store8(m + 177, 0); store8(m + 178, 0); store8(m + 179, 0); store8(m + 180, 0); store8(m + 181, 0); store8(m + 182, 0); store8(m + 183, 0);
    return m;
}

fn _t_write_echo_module(path: Str): i64 {
    return file_write_all(str_data(path), _t_echo_module_bytes(), 184);
}

# A minimal valid WASM module with an exported `_start` — 36 bytes.
# A module declaring a 4 MiB (64-page) memory — 41 bytes. Identical to the nop
# below plus a memory section, so the pair isolates the memory bound.
fn _t_write_mem_module(path: Str): i64 {
    var b[64];
    var n = 0;
    store8(&b + n, 0); n = n + 1; store8(&b + n, 97); n = n + 1;
    store8(&b + n, 115); n = n + 1; store8(&b + n, 109); n = n + 1;
    store8(&b + n, 1); n = n + 1; store8(&b + n, 0); n = n + 1;
    store8(&b + n, 0); n = n + 1; store8(&b + n, 0); n = n + 1;
    store8(&b + n, 1); n = n + 1; store8(&b + n, 4); n = n + 1;
    store8(&b + n, 1); n = n + 1; store8(&b + n, 96); n = n + 1;
    store8(&b + n, 0); n = n + 1; store8(&b + n, 0); n = n + 1;
    store8(&b + n, 3); n = n + 1; store8(&b + n, 2); n = n + 1;
    store8(&b + n, 1); n = n + 1; store8(&b + n, 0); n = n + 1;
    # memory section: 1 memory, limits flag 0 (min only), min = 64 pages
    store8(&b + n, 5); n = n + 1; store8(&b + n, 3); n = n + 1;
    store8(&b + n, 1); n = n + 1; store8(&b + n, 0); n = n + 1;
    store8(&b + n, 64); n = n + 1;
    store8(&b + n, 7); n = n + 1; store8(&b + n, 10); n = n + 1;
    store8(&b + n, 1); n = n + 1; store8(&b + n, 6); n = n + 1;
    store8(&b + n, 95); n = n + 1; store8(&b + n, 115); n = n + 1;
    store8(&b + n, 116); n = n + 1; store8(&b + n, 97); n = n + 1;
    store8(&b + n, 114); n = n + 1; store8(&b + n, 116); n = n + 1;
    store8(&b + n, 0); n = n + 1; store8(&b + n, 0); n = n + 1;
    store8(&b + n, 10); n = n + 1; store8(&b + n, 4); n = n + 1;
    store8(&b + n, 1); n = n + 1; store8(&b + n, 2); n = n + 1;
    store8(&b + n, 0); n = n + 1; store8(&b + n, 11); n = n + 1;
    file_write_all(str_data(path), &b, n);
    return n;
}

fn _t_write_nop_module(path: Str): i64 {
    var b[64];
    var n = 0;
    store8(&b + n, 0); n = n + 1; store8(&b + n, 97); n = n + 1;
    store8(&b + n, 115); n = n + 1; store8(&b + n, 109); n = n + 1;
    store8(&b + n, 1); n = n + 1; store8(&b + n, 0); n = n + 1;
    store8(&b + n, 0); n = n + 1; store8(&b + n, 0); n = n + 1;
    store8(&b + n, 1); n = n + 1; store8(&b + n, 4); n = n + 1;
    store8(&b + n, 1); n = n + 1; store8(&b + n, 96); n = n + 1;
    store8(&b + n, 0); n = n + 1; store8(&b + n, 0); n = n + 1;
    store8(&b + n, 3); n = n + 1; store8(&b + n, 2); n = n + 1;
    store8(&b + n, 1); n = n + 1; store8(&b + n, 0); n = n + 1;
    store8(&b + n, 7); n = n + 1; store8(&b + n, 10); n = n + 1;
    store8(&b + n, 1); n = n + 1; store8(&b + n, 6); n = n + 1;
    store8(&b + n, 95); n = n + 1; store8(&b + n, 115); n = n + 1;
    store8(&b + n, 116); n = n + 1; store8(&b + n, 97); n = n + 1;
    store8(&b + n, 114); n = n + 1; store8(&b + n, 116); n = n + 1;
    store8(&b + n, 0); n = n + 1; store8(&b + n, 0); n = n + 1;
    store8(&b + n, 10); n = n + 1; store8(&b + n, 4); n = n + 1;
    store8(&b + n, 1); n = n + 1; store8(&b + n, 2); n = n + 1;
    store8(&b + n, 0); n = n + 1; store8(&b + n, 11); n = n + 1;
    file_write_all(str_data(path), &b, n);
    return n;
}

fn main(): i64 {
    var err = 0;
    store64(&err, 0);

    # --- Oracle: create_sandbox_with_defaults -----------------------------
    var s = agnosai_wasm_sandbox_new();
    assert_neq(s, 0, "a default sandbox is created");
    assert_eq(agnosai_wasm_sandbox_max_memory_bytes(s), 67108864,
      "with the oracle's 64 MiB memory ceiling");
    assert_eq(agnosai_wasm_sandbox_timeout_ms(s), 30000,
      "and its 30-second timeout");
    # Past the oracle, which asserts only the two fields its struct exposes.
    assert_eq(agnosai_wasm_sandbox_fuel(s), 1000000000,
      "and the 1e9 fuel budget it never asserts");

    # --- Oracle: create_sandbox_with_custom_limits ------------------------
    var custom = agnosai_wasm_sandbox_with_limits(33554432, 10000);
    assert_eq(agnosai_wasm_sandbox_max_memory_bytes(custom), 33554432,
      "custom memory is kept");
    assert_eq(agnosai_wasm_sandbox_timeout_ms(custom), 10000, "and a custom timeout");
    # ⚠ `with_limits` does NOT take fuel, upstream or here — it stays default.
    assert_eq(agnosai_wasm_sandbox_fuel(custom), 1000000000,
      "while fuel stays at the default, because with_limits cannot set it");

    # --- Oracle: load_invalid_bytes_returns_error -------------------------
    store64(&err, 0);
    var junk = str_from("not valid wasm");
    assert_eq(agnosai_wasm_load_module(s, str_data(junk), str_len(junk), &err), 0,
      "bytes that are not WASM do not load");
    assert_eq(agnosai_error_kind(load64(&err)), AGNOSAI_ERR_SANDBOX,
      "reporting a Sandbox error");
    # ⚠ The oracle asserts the message CONTAINS "expected" — it is checking the
    # caller is told the bytes are not WASM, not merely that something failed.
    assert_eq(str_contains_cstr(agnosai_error_detail(load64(&err)), "expected"), 1,
      "with a message naming what was EXPECTED");

    # --- Oracle: load_empty_bytes_returns_error ---------------------------
    store64(&err, 0);
    assert_eq(agnosai_wasm_load_module(s, str_data(str_from("")), 0, &err), 0,
      "empty bytes do not load");
    assert_neq(load64(&err), 0, "and set an error");

    # --- the header check, past the oracle --------------------------------
    var hdr = _t_wasm_header();
    store64(&err, 0);
    var m = agnosai_wasm_load_module(s, hdr, 8, &err);
    assert_neq(m, 0, "a valid eight-byte header loads");
    assert_eq(load64(&err), 0, "with no error");
    assert_eq(agnosai_wasm_module_len(m), 8, "and remembers its length");
    assert_eq(file_exists(str_data(agnosai_wasm_module_path(m))), 1,
      "and stages the bytes where wasmtime can read them");

    # ⚠ Seven bytes is one short and must be refused — the length check has to
    # come before the byte reads, or this reads past the buffer.
    store64(&err, 0);
    assert_eq(agnosai_wasm_load_module(s, hdr, 7, &err), 0,
      "a seven-byte buffer is too short to be a header");

    # Each magic byte matters.
    assert_eq(agnosai_wasm_load_module(s, _t_wasm_header_bad(0, 1), 8, &err), 0,
      "a wrong first magic byte is refused");
    assert_eq(agnosai_wasm_load_module(s, _t_wasm_header_bad(3, 110), 8, &err), 0,
      "and a wrong fourth");

    # ⚠ **The VERSION matters too.** A magic-only check accepts a version-2
    # module and defers the failure to wasmtime, where it becomes an exec-time
    # trap instead of a load-time refusal — which is the distinction the
    # oracle's `Module::new` draws.
    assert_eq(agnosai_wasm_load_module(s, _t_wasm_header_bad(4, 2), 8, &err), 0,
      "a version-2 module is refused at LOAD, not deferred to exec");
    assert_eq(agnosai_wasm_load_module(s, _t_wasm_header_bad(7, 1), 8, &err), 0,
      "and a version with a high byte set");

    # --- Oracle: load_module_from_nonexistent_file_returns_error ----------
    store64(&err, 0);
    assert_eq(agnosai_wasm_load_module_from_file(s,
        str_from("/nonexistent/module.wasm"), &err), 0, "a missing file does not load");
    assert_neq(load64(&err), 0, "and sets an error");

    # A real file round-trips, and ⚠ is RE-VALIDATED: a caller cannot hand the
    # sandbox an arbitrary path and have it executed unchecked.
    sys_mkdir(_T_ROOT, 0x1FF);
    var good_path = _t_join(str_from(_T_ROOT), str_from("/good.wasm"));
    file_write_all(str_data(good_path), _t_wasm_header(), 8);
    store64(&err, 0);
    var fm = agnosai_wasm_load_module_from_file(s, good_path, &err);
    assert_neq(fm, 0, "a valid module file loads");
    assert_eq(agnosai_wasm_module_len(fm), 8, "with its length");

    var bad_path = _t_join(str_from(_T_ROOT), str_from("/bad.wasm"));
    var notwasm = str_from("#!/bin/sh\nrm -rf /\n");
    file_write_all(str_data(bad_path), str_data(notwasm), str_len(notwasm));
    store64(&err, 0);
    assert_eq(agnosai_wasm_load_module_from_file(s, bad_path, &err), 0,
      "a file that is NOT WASM is refused even though it exists");
    assert_eq(str_contains_cstr(agnosai_error_detail(load64(&err)), "expected"), 1,
      "by the same header check, not by the filesystem");

    # --- the exit taxonomy ------------------------------------------------
    # ⚠ Fed captured stderr as DATA, so the classifier is testable without a
    # runtime. This is the whole of the oracle's `extract_exit_code`, which its
    # own tests only reach through real traps.
    assert_eq(agnosai_wasm_classify_exit(0, 0, str_from("")), 0,
      "a clean run is 0");
    assert_eq(agnosai_wasm_classify_exit(1, 1, str_from("")), AGNOSAI_WASM_EXIT_TIMEOUT,
      "a timeout is -1");
    # ⚠ **A timeout that reports exit 0 is still a timeout.** This is the only
    # input where the order of the first two checks is observable, and it is the
    # one that matters: reversed, a run killed at the deadline reads as a clean
    # success and the caller ships whatever partial stdout it had.
    assert_eq(agnosai_wasm_classify_exit(0, 1, str_from("")), AGNOSAI_WASM_EXIT_TIMEOUT,
      "and a timeout reporting exit 0 is STILL a timeout, never a success");
    # ⚠ The deadline wins over the exit code, and over stderr. A timed-out run
    # also carries a non-zero code, so checking the code first mislabels it.
    assert_eq(agnosai_wasm_classify_exit(2, 1, str_from("all fuel consumed")),
      AGNOSAI_WASM_EXIT_TIMEOUT, "and the deadline WINS over a fuel message");

    assert_eq(agnosai_wasm_classify_exit(1, 0, str_from("Error: all fuel consumed")),
      AGNOSAI_WASM_EXIT_FUEL, "exhausted fuel is -2");
    assert_eq(agnosai_wasm_classify_exit(1, 0,
        str_from("wasm trap: interrupt\nepoch deadline reached")),
      AGNOSAI_WASM_EXIT_TIMEOUT, "an epoch interrupt is -1");
    assert_eq(agnosai_wasm_classify_exit(1, 0,
        str_from("Error: wasm trap: integer divide by zero")), AGNOSAI_WASM_EXIT_TRAP,
      "any other trap is -3");

    # ⚠ A guest's OWN exit code passes through. wasmtime surfaces WASI
    # `proc_exit(n)` as its own process exit, and the oracle preserves it via
    # `I32Exit`. Mapping every non-zero code onto -3 would erase it — and every
    # assertion above would still pass.
    assert_eq(agnosai_wasm_classify_exit(3, 0, str_from("")), 3,
      "a guest's own proc_exit(3) is reported as 3, not as a trap");
    assert_eq(agnosai_wasm_classify_exit(42, 0, str_from("some unrelated noise")), 42,
      "and is not overwritten by unrelated stderr");

    # The result struct carries both halves.
    var r = agnosai_wasm_result_new(str_from("hello"), 0);
    _t_seq(agnosai_wasm_result_stdout(r), str_from("hello"), "a result keeps its stdout");
    assert_eq(agnosai_wasm_result_exit_code(r), 0, "and its exit code");

    # --- availability, and the arm this box takes -------------------------
    var have = agnosai_wasm_available();
    assert(have == 0 || have == 1, "availability is a clean boolean");
    # ⚠ It must AGREE with what `sandbox_create` will do. Before kavach 3.11.8
    # `backend_is_available` answered a hardcoded 0 while `wasm_health` probed,
    # and the two contradicted each other.
    assert_eq(have, wasm_health(0),
      "and agrees with wasm_health — these used to contradict each other");

    store64(&err, 0);
    var out = agnosai_wasm_execute(s, m, str_from(""), &err);
    if (have == 0) {
        # The reachable arm on this box, and a real assertion rather than a skip.
        assert_eq(out, 0, "with no runtime, execute does not half-work");
        assert_eq(agnosai_error_kind(load64(&err)), AGNOSAI_ERR_SANDBOX,
          "it is a Sandbox error");
        assert_eq(str_contains_cstr(agnosai_error_detail(load64(&err)), "wasmtime"), 1,
          "naming the missing binary, so the operator knows what to install");
    } else {
        # ⚠ Guarded, and the guard is LOUD: if a runtime is present these must
        # run, so a regression in detection cannot quietly skip them.
        assert_neq(out, 0, "with a runtime present, a header-only module executes");
        assert_eq(agnosai_wasm_result_exit_code(out), 0,
          "and an empty module exits cleanly");
    }

    # --- a REAL module, end to end -------------------------------------------
    #
    # ⚠ This is the only test in the tree that reaches wasmtime. It is what
    # exposed the missing `kavach_init` — every other assertion here stops at
    # the header check, the path resolution or the error text, all of which pass
    # against a backend that can never run anything.
    #
    # The module is 36 bytes, hand-assembled: magic + version, a `() -> ()`
    # type, one function, an exported `_start`, and a body of a single END
    # opcode. Nothing to check in, no toolchain needed.
    if (agnosai_wasm_available() == 1) {
        var rp = _t_join(str_from(_T_ROOT), str_from("/real-nop.wasm"));
        assert_eq(_t_write_nop_module(rp), 36, "a real 36-byte module is written");
        store64(&err, 0);
        var rs = agnosai_wasm_sandbox_new();
        var rm = agnosai_wasm_load_module_from_file(rs, rp, &err);
        assert_neq(rm, 0, "and loads");
        var rr = agnosai_wasm_execute(rs, rm, str_from("{\"parameters\":{}}"), &err);
        assert_neq(rr, 0, "and EXECUTES — no result here means kavach was never initialised");
        assert_eq(agnosai_wasm_result_exit_code(rr), 0,
          "and the guest exited 0, so wasmtime accepted kavach's argv");
        sys_unlink(str_data(rp));

        # ⚠ **stdin must reach the guest, and stdout must come back.** The nop
        # above proves only that wasmtime ran; these are the two behaviours the
        # oracle pins (`execute_wasi_module_captures_stdout` at wasm.rs:322,
        # `execute_wasi_module_with_stdin_input` at :353) and ADR 019 claims are
        # preserved exactly. The echo module returns whatever it is fed, so one
        # run covers both directions: a stdout that came back empty, or a
        # `config_stdin` that was never wired, both fail here.
        var ep = _t_join(str_from(_T_ROOT), str_from("/echo.wasm"));
        assert_eq(_t_write_echo_module(ep), 184, "the echo module is written");
        store64(&err, 0);
        var es = agnosai_wasm_sandbox_new();
        var em = agnosai_wasm_load_module_from_file(es, ep, &err);
        assert_neq(em, 0, "and loads");
        var payload = str_from("{\"parameters\":{\"name\":\"world\"}}");
        var er = agnosai_wasm_execute(es, em, payload, &err);
        assert_neq(er, 0, "and executes");
        assert_eq(agnosai_wasm_result_exit_code(er), 0, "exiting 0");
        var got = agnosai_wasm_result_stdout(er);
        assert(str_len(got) > 0,
          "STDOUT IS CAPTURED — an empty result here means the guest's output is dropped");
        assert(str_eq(got, payload) == 1,
          "and it is exactly what was written to STDIN — proving config_stdin reaches the guest");
        sys_unlink(str_data(ep));

        # ⚠ **The FUEL ceiling must reach wasmtime too, and until kavach 3.11.11
        # there was no way to send it.** `agnosai_wasm_sandbox_fuel` reported the
        # oracle's 1e9 while kavach derived `timeout_ms * 1e6` — 3e10 at the
        # default 30 s, thirty times the oracle's bound. Same shape as the memory
        # check below: a budget of 1 is enough to instantiate nothing, so the
        # guest must NOT exit 0.
        var fp = _t_join(str_from(_T_ROOT), str_from("/fuel-nop.wasm"));
        assert_eq(_t_write_nop_module(fp), 36, "a module for the fuel check is written");
        store64(&err, 0);
        var starved = agnosai_wasm_sandbox_with_limits(67108864, 10000);
        agnosai_wasm_sandbox_set_fuel(starved, 1);
        assert_eq(agnosai_wasm_sandbox_fuel(starved), 1, "the sandbox carries a budget of 1");
        var fm = agnosai_wasm_load_module_from_file(starved, fp, &err);
        assert_neq(fm, 0, "it loads");
        var fr = agnosai_wasm_execute(starved, fm, str_from("{}"), &err);
        assert_neq(fr, 0, "and execute returns a result");
        assert_neq(agnosai_wasm_result_exit_code(fr), 0,
          "and the guest was STARVED — a 0 here means the fuel never reached wasmtime");
        sys_unlink(str_data(fp));

        # ⚠ **The memory ceiling must actually REACH wasmtime.** Until
        # 2026-08-11 `agnosai_wasm_execute` sent no policy, kavach's
        # `_wasm_append_limits` saw `memory_limit_mb == 0` and emitted no
        # `-W max-memory-size=`, so the guest ran unbounded while
        # `agnosai_wasm_sandbox_max_memory_bytes` reported 64 MiB. A sandbox that
        # advertises a limit it does not enforce is worse than one with none.
        #
        # The discriminator is a module declaring a 4 MiB memory: unbounded it
        # runs, under a 1 MiB ceiling wasmtime refuses to instantiate it. A
        # module with no memory section cannot tell the two apart, which is why
        # the nop above is not enough.
        var mp = _t_join(str_from(_T_ROOT), str_from("/mem4mib.wasm"));
        assert_eq(_t_write_mem_module(mp), 41, "a module declaring 4 MiB is written");
        store64(&err, 0);
        var tight = agnosai_wasm_sandbox_with_limits(1048576, 10000);
        var tm = agnosai_wasm_load_module_from_file(tight, mp, &err);
        assert_neq(tm, 0, "it loads");
        var tr = agnosai_wasm_execute(tight, tm, str_from("{}"), &err);
        assert_neq(tr, 0, "and execute returns a result");
        assert_neq(agnosai_wasm_result_exit_code(tr), 0,
          "and the guest was REFUSED — a 0 here means the ceiling never reached wasmtime");
        sys_unlink(str_data(mp));
    }

    # --- teardown -----------------------------------------------------------
    sys_unlink(str_data(agnosai_wasm_module_path(m)));
    sys_unlink(str_data(agnosai_wasm_module_path(fm)));
    sys_unlink(str_data(good_path));
    sys_unlink(str_data(bad_path));
    sys_rmdir(_T_ROOT);

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
