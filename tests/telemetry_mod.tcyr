# =========================================================================
# telemetry_mod.tcyr — tests for src/telemetry/mod.cyr
#
# Oracle: rust-old/src/telemetry/mod.rs's four `#[test]` fns. All four are
# **vacuous** — one asserts a constant equals its own literal, and the other
# three call something and discard the result (`let _ = result;`, `drop(guard);
# // Should not panic`, `let _ = filter;`). They are ported so the count is
# honest, and then the module is actually tested.
#
# What is tested past them is the JSON line, because that is the whole point of
# this module: the port emits it itself through `sakshi_set_emit_hook` rather
# than through a subscriber, so **the byte layout is the parity surface**. A
# formatter that produced valid-but-different JSON would satisfy every oracle
# test and break every log shipper.
#
#   * the exact key order and shape `tracing_subscriber::fmt().json()` emits
#   * RFC 3339 with microseconds, over leap years, month ends and midnight
#   * JSON escaping — quote, backslash, newline, tab, control bytes
#   * `RUST_LOG` parsing, including the multi-directive forms the port
#     deliberately refuses rather than half-applying
#
# The hook itself IS tested, end to end: `sys_pipe` + `sys_dup2` redirect fd 2,
# sakshi emits through the installed hook, and the bytes are read back. That is
# the only thing that catches a hook which ignores sakshi's fields block — it
# passes every formatter assertion and drops every field in production, which is
# exactly the regression the sakshi 2.4.10 bump would have caused.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/core/mod.cyr"
include "src/telemetry/mod.cyr"
include "tests/test_helpers.cyr"

# Format one line and return it as a Str for comparison.
fn _t_json(epoch_ns, level, msg): i64 {
    var buf = alloc(4096);
    var n = agnosai_telemetry_format_json(buf, 4096, epoch_ns, level, msg, strlen(msg));
    return str_new(buf, n);
}

# Format one line with a sakshi fields block.
fn _t_json_f(epoch_ns, level, msg, fields): i64 {
    var buf = alloc(4096);
    var n = agnosai_telemetry_format_json_f(buf, 4096, epoch_ns, level, msg,
      strlen(msg), fields);
    return str_new(buf, n);
}

# The same, for a message carrying bytes a literal cannot hold.
fn _t_json_raw(epoch_ns, level, data, len): i64 {
    var buf = alloc(4096);
    var n = agnosai_telemetry_format_json(buf, 4096, epoch_ns, level, data, len);
    return str_new(buf, n);
}

# The exact line `tracing_subscriber::fmt().json()` produces, assembled from
# short pieces so the byte-exact literal does not run past 120 columns. The
# assembly is the point: change any piece and the comparison fails.
fn _t_expect(ts_lit, level_lit, msg_lit): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"timestamp\":\"");
    str_builder_add_cstr(sb, ts_lit);
    str_builder_add_cstr(sb, "\",\"level\":\"");
    str_builder_add_cstr(sb, level_lit);
    str_builder_add_cstr(sb, "\",\"fields\":{\"message\":\"");
    str_builder_add_cstr(sb, msg_lit);
    str_builder_add_cstr(sb, "\"},\"target\":\"agnosai\"}\n");
    return str_builder_build(sb);
}

# Just the `timestamp` value, for the date tests. `{"timestamp":"` is 14
# bytes, and the RFC 3339 value that follows is always 27.
fn _t_ts(epoch_ns): i64 {
    var line = _t_json(epoch_ns, SK_INFO, "x");
    return str_new(str_data(line) + 14, 27);
}

fn main(): i64 {
    _agnosai_telemetry_init_mdays();

    # --- oracle: default_service_name_is_agnosai ------------------------
    assert(str_eq_cstr(agnosai_telemetry_default_service_name(), "agnosai") == 1,
      "the default service name is agnosai");

    # --- oracle: otlp_endpoint_from_env_returns_none_when_unset ---------
    # The oracle's own body is `let result = otlp_endpoint_from_env(); let _ =
    # result;` — it asserts nothing, because the test process may have the
    # variable set. Reproduced as a call that must not fault, and then made
    # meaningful below by driving the parse directly.
    var ep = agnosai_otlp_endpoint_from_env();
    assert(ep >= 0, "reading the OTLP endpoint from the environment does not fault");

    # --- oracle: tracing_guard_can_be_created_without_otel --------------
    var g = agnosai_telemetry_init_tracing(0);
    assert(g != 0, "a guard is returned with no OTLP endpoint");
    assert_eq(agnosai_tracing_guard_otel_active(g), 0, "and it holds no exporter");
    assert_eq(agnosai_telemetry_shutdown(g), 0, "shutting it down is a no-op");

    # --- past the oracle: the OTLP guard ---------------------------------
    assert_eq(agnosai_tracing_guard_exporter(g), 0,
      "with no endpoint the guard holds NO exporter");

    var g2 = agnosai_telemetry_init_tracing(str_from("http://localhost:4317"));
    assert_eq(agnosai_tracing_guard_otel_active(g2), 1, "an endpoint yields a live exporter");
    assert(agnosai_tracing_guard_service_name(g2) != 0, "carrying a service name");
    var gex = agnosai_tracing_guard_exporter(g2);
    assert(gex != 0, "the guard owns the exporter — the oracle's OtelGuard");
    assert_eq(agnosai_otlp_exporter_stopping(gex), 0, "which starts out running");

    # ⚠ Shutdown must STOP the exporter, not just clear a flag. The oracle's
    # `TracingGuard` flushes pending spans when it drops; the last interval's
    # batch is the one most likely to explain why the process is stopping.
    agnosai_telemetry_shutdown(g2);
    assert_eq(agnosai_otlp_exporter_stopping(gex), 1, "and shutdown stops it");
    assert_eq(agnosai_tracing_guard_exporter(g2), 0, "releasing it from the guard");
    assert_eq(agnosai_tracing_guard_otel_active(g2), 0, "which shutdown releases");
    assert_eq(agnosai_telemetry_shutdown(g2), 0, "and a second shutdown is a no-op");

    # --- past the oracle: the env-reading wrappers' invariants -----------
    # None of these can be driven with a chosen value — `getenv` reads
    # `/proc/self/environ` and there is no `setenv` — so what is pinned is what
    # holds for *any* environment. That is not nothing: each feeds something
    # that would misbehave on a bad answer.

    # `service_name` feeds the OTLP resource attributes; a 0 here would fault
    # the exporter rather than degrade it.
    var sn = agnosai_telemetry_service_name();
    assert(sn != 0, "the service name is never 0, whatever the environment");
    assert(str_len(sn) >= 0, "and is a readable Str");

    # ⚠ `env_filter_level`'s result is handed straight to `sakshi_set_level`,
    # so it must be -1 (meaning "use the default") or a real level — never a
    # value that would silently set an out-of-range threshold.
    var lvl = agnosai_telemetry_env_filter_level();
    assert(lvl >= 0 - 1, "the env filter level is never below -1");
    assert(lvl <= SK_TRACE, "and never above TRACE — it is fed to sakshi_set_level");

    # Installing the formatter is idempotent, which matters because
    # `init_tracing` may run after something else already set a hook.
    assert_eq(agnosai_telemetry_init_json_logging(), 0, "installing the JSON hook succeeds");
    assert_eq(agnosai_telemetry_init_json_logging(), 0, "and installing it twice is a no-op");

    # Put logging back the way the rest of the suite expects.
    sakshi_clear_emit_hook();
    sakshi_set_level(SK_INFO);

    # --- oracle: default_env_filter_parses -------------------------------
    # The oracle builds `EnvFilter::new("agnosai=info")` and discards it. Here
    # the equivalent is that the string the port falls back to maps to INFO.
    assert_eq(_agnosai_telemetry_level_of("info", 4), SK_INFO,
      "the fallback directive's level is INFO");

    # --- past the oracle: every level word, and case folding -------------
    assert_eq(_agnosai_telemetry_level_of("trace", 5), SK_TRACE, "trace maps");
    assert_eq(_agnosai_telemetry_level_of("debug", 5), SK_DEBUG, "debug maps");
    assert_eq(_agnosai_telemetry_level_of("warn", 4), SK_WARN, "warn maps");
    assert_eq(_agnosai_telemetry_level_of("error", 5), SK_ERROR, "error maps");
    assert_eq(_agnosai_telemetry_level_of("INFO", 4), SK_INFO, "uppercase maps too");
    assert_eq(_agnosai_telemetry_level_of("WaRn", 4), SK_WARN, "and mixed case");
    # ⚠ `tracing` takes `warn`, not `warning` — accepting the latter would let a
    # typo silently become a level the oracle would have rejected.
    assert_eq(_agnosai_telemetry_level_of("warning", 7), 0 - 1, "'warning' is NOT a level");
    assert_eq(_agnosai_telemetry_level_of("", 0), 0 - 1, "nor is the empty string");
    assert_eq(_agnosai_telemetry_level_of("inf", 3), 0 - 1, "nor a prefix of one");
    assert_eq(_agnosai_telemetry_level_of("infoo", 5), 0 - 1, "nor a superstring");

    # --- past the oracle: RUST_LOG directive parsing ---------------------
    # The decision half is split from the `getenv` so it can be driven with
    # inputs a CI runner's environment never produces.
    assert_eq(agnosai_telemetry_parse_directive("debug", 5), SK_DEBUG,
      "a bare level is honoured");
    assert_eq(agnosai_telemetry_parse_directive("agnosai=debug", 13), SK_DEBUG,
      "and so is a directive naming this crate");
    assert_eq(agnosai_telemetry_parse_directive("AGNOSAI=WARN", 12), SK_WARN,
      "case-insensitively on both halves");
    assert_eq(agnosai_telemetry_parse_directive("", 0), 0 - 1, "an empty RUST_LOG is ignored");
    assert_eq(agnosai_telemetry_parse_directive("hoosh=debug", 11), 0 - 1,
      "a directive for another crate is ignored — not applied globally");
    assert_eq(agnosai_telemetry_parse_directive("nonsense", 8), 0 - 1,
      "an unparseable value is ignored");

    # ⚠ A multi-target filter is refused OUTRIGHT rather than partially
    # applied. `agnosai=warn,hoosh=trace` asks for two different levels and
    # sakshi has one; honouring the first would silently raise verbosity for a
    # target the operator had turned down, which is worse than ignoring it.
    assert_eq(agnosai_telemetry_parse_directive("agnosai=warn,hoosh=trace", 24), 0 - 1,
      "a comma-separated filter is refused, not half-applied");
    assert_eq(agnosai_telemetry_parse_directive("agnosai=debug,", 14), 0 - 1,
      "even with an empty second directive");
    assert_eq(agnosai_telemetry_parse_directive("a=b=c", 5), 0 - 1,
      "and so is a second '=' — that is not a directive this binary can honour");
    assert_eq(agnosai_telemetry_parse_directive("agnosai=", 8), 0 - 1,
      "a directive with no level is ignored");
    assert_eq(agnosai_telemetry_parse_directive("=info", 5), 0 - 1,
      "as is one with no target");

    # --- past the oracle: the ASCII fold is ASCII-only -------------------
    # Folding by `| 32` would map '[' (0x5B) onto '{' and '@' onto '`'. The
    # guarded range is what stops that.
    assert_eq(_agnosai_telemetry_eq_ci("INFO", 4, "info"), 1, "letters fold");
    assert_eq(_agnosai_telemetry_eq_ci("[", 1, "{"), 0, "'[' does not fold to '{'");
    assert_eq(_agnosai_telemetry_eq_ci("@", 1, "`"), 0, "nor '@' to backtick");
    assert_eq(_agnosai_telemetry_eq_ci("ab", 2, "abc"), 0, "a length mismatch is unequal");

    # --- the JSON line ---------------------------------------------------
    # 1786320000 is 2026-08-10T00:00:00Z.
    assert(str_eq(_t_json(1786320000123456789, SK_INFO, "AgnosAI server starting"),
        _t_expect("2026-08-10T00:00:00.123456Z", "INFO", "AgnosAI server starting")) == 1,
      "the line is byte-exact against tracing_subscriber's JSON layout");

    # ⚠ Every line ends with exactly one newline — a log shipper reads one
    # object per line, and a missing or doubled terminator breaks framing.
    var line = _t_json(1786320000000000000, SK_WARN, "x");
    assert_eq(load8(str_data(line) + str_len(line) - 1), 10, "the line ends with a newline");
    assert_eq(load8(str_data(line) + str_len(line) - 2), 125, "preceded by the closing brace");

    # --- level names -----------------------------------------------------
    assert(str_eq_cstr(str_from(_agnosai_telemetry_level_name(SK_ERROR)), "ERROR") == 1, "ERROR renders");
    assert(str_eq_cstr(str_from(_agnosai_telemetry_level_name(SK_WARN)), "WARN") == 1, "WARN renders");
    assert(str_eq_cstr(str_from(_agnosai_telemetry_level_name(SK_DEBUG)), "DEBUG") == 1, "DEBUG renders");
    assert(str_eq_cstr(str_from(_agnosai_telemetry_level_name(SK_TRACE)), "TRACE") == 1, "TRACE renders");
    # ⚠ sakshi has FATAL and `tracing` does not. It is emitted as FATAL rather
    # than folded into ERROR — collapsing it would make a process-ending event
    # indistinguishable from a handled one.
    assert(str_eq_cstr(str_from(_agnosai_telemetry_level_name(SK_FATAL)), "FATAL") == 1,
      "FATAL renders as itself, not as ERROR");
    assert(str_eq_cstr(str_from(_agnosai_telemetry_level_name(99)), "UNKNOWN") == 1,
      "and an unmapped level is UNKNOWN rather than a stray byte");

    # --- timestamps ------------------------------------------------------
    assert(str_eq_cstr(_t_ts(0), "1970-01-01T00:00:00.000000Z") == 1, "the epoch itself");
    assert(str_eq_cstr(_t_ts(951782400000000000), "2000-02-29T00:00:00.000000Z") == 1,
      "2000-02-29 — the century leap year the /100 rule would drop");
    assert(str_eq_cstr(_t_ts(1709164800000000000), "2024-02-29T00:00:00.000000Z") == 1,
      "and an ordinary leap day");
    assert(str_eq_cstr(_t_ts(1735689599000000000), "2024-12-31T23:59:59.000000Z") == 1,
      "the last second of a leap year");
    assert(str_eq_cstr(_t_ts(1767225600000000000), "2026-01-01T00:00:00.000000Z") == 1,
      "and the first of the next");

    # ⚠ Sub-second digits are zero-PADDED, not truncated: 1 ms must render as
    # `.001000`, not `.1000` or `.1`.
    assert(str_eq_cstr(_t_ts(1000000), "1970-01-01T00:00:00.001000Z") == 1,
      "one millisecond is .001000");
    assert(str_eq_cstr(_t_ts(1000), "1970-01-01T00:00:00.000001Z") == 1,
      "one microsecond is .000001");
    assert(str_eq_cstr(_t_ts(999), "1970-01-01T00:00:00.000000Z") == 1,
      "and sub-microsecond truncates rather than rounding up");
    assert(str_eq_cstr(_t_ts(999999999), "1970-01-01T00:00:00.999999Z") == 1,
      "the last microsecond before a second rolls");

    # ⚠ Every field is fixed-width. A single-digit month or day must be padded,
    # or the timestamp stops being RFC 3339 and stops sorting lexicographically.
    assert(str_eq_cstr(_t_ts(1767225600000000000), "2026-01-01T00:00:00.000000Z") == 1,
      "January is 01, not 1");
    assert_eq(str_len(_t_ts(0)), 27, "the timestamp is always 27 bytes");
    assert_eq(str_len(_t_ts(1786320000123456789)), 27, "whatever the value");

    # --- JSON escaping ---------------------------------------------------
    assert(str_eq(_t_json(0, SK_INFO, "say \"hi\""),
        _t_expect("1970-01-01T00:00:00.000000Z", "INFO", "say \\\"hi\\\"")) == 1,
      "a quote in the message is escaped — otherwise the line is not parseable");

    var bs = alloc(8);
    store8(bs, 92);
    store8(bs + 1, 110);
    assert(_t_json_raw(0, SK_INFO, bs, 2) != 0, "a literal backslash-n formats");
    var bsline = _t_json_raw(0, SK_INFO, bs, 2);
    assert(str_contains_cstr(bsline, "\\\\n") == 1,
      "a literal backslash is doubled, so it does not become an escape");

    var ctl = alloc(8);
    store8(ctl, 97);
    store8(ctl + 1, 10);
    store8(ctl + 2, 98);
    assert(str_contains_cstr(_t_json_raw(0, SK_INFO, ctl, 3), "a\\nb") == 1,
      "a newline becomes \\n, keeping one JSON object per line");
    store8(ctl + 1, 13);
    assert(str_contains_cstr(_t_json_raw(0, SK_INFO, ctl, 3), "a\\rb") == 1,
      "a carriage return becomes \\r");
    store8(ctl + 1, 9);
    assert(str_contains_cstr(_t_json_raw(0, SK_INFO, ctl, 3), "a\\tb") == 1,
      "a tab becomes \\t");
    store8(ctl + 1, 1);
    assert(str_contains_cstr(_t_json_raw(0, SK_INFO, ctl, 3), "a\\u0001b") == 1,
      "and any other control byte becomes a \\u escape");
    store8(ctl + 1, 27);
    assert(str_contains_cstr(_t_json_raw(0, SK_INFO, ctl, 3), "a\\u001bb") == 1,
      "with lowercase hex, as tracing emits — ESC is 0x1b");
    store8(ctl + 1, 31);
    assert(str_contains_cstr(_t_json_raw(0, SK_INFO, ctl, 3), "a\\u001fb") == 1,
      "0x1f is the last byte that needs escaping");
    store8(ctl + 1, 32);
    assert(str_contains_cstr(_t_json_raw(0, SK_INFO, ctl, 3), "a b") == 1,
      "and 0x20 — space — is the first that does not");

    # ⚠ Non-ASCII passes through unescaped: RFC 8259 permits raw UTF-8 inside a
    # string, and escaping it would change bytes a consumer compares.
    var utf = alloc(8);
    store8(utf, 0xC3);
    store8(utf + 1, 0xA9);
    assert(str_contains_cstr(_t_json_raw(0, SK_INFO, utf, 2), "\"message\":\"") == 1,
      "a UTF-8 message still formats");
    assert_eq(str_len(_t_json_raw(0, SK_INFO, utf, 2)), str_len(_t_json(0, SK_INFO, "ab")),
      "and its two bytes pass through unescaped — same length as two ASCII bytes");

    # --- the message is length-delimited, not NUL-terminated -------------
    # sakshi hands the hook a pointer and a length; the message may carry an
    # embedded NUL and must not be truncated at it.
    var nul = alloc(8);
    store8(nul, 97);
    store8(nul + 1, 0);
    store8(nul + 2, 98);
    assert(str_contains_cstr(_t_json_raw(0, SK_INFO, nul, 3), "\\u0000b") == 1,
      "an embedded NUL is escaped and the message continues past it");

    # --- the buffer bound ------------------------------------------------
    # A message longer than the buffer must stop short, not run past `cap`.
    var big = alloc(9000);
    for (var i = 0; i < 9000; i = i + 1) { store8(big + i, 65); }
    var small = alloc(4096);
    var bn = agnosai_telemetry_format_json(small, 4096, 0, SK_INFO, big, 9000);
    assert(bn <= 4096, "an oversized message is truncated inside the buffer");
    assert_eq(load8(small + bn - 1), 10, "and the line still ends with a newline");
    assert(str_contains_cstr(str_new(small, bn), "\"target\":\"agnosai\"") == 1,
      "with the closing fields intact — truncation cannot lose the JSON tail");

    # ⚠ Only the MESSAGE is bounded against `cap` — the prefix, timestamp,
    # level and tail are written unconditionally. A buffer too small to hold
    # them is therefore refused outright rather than half-written, which would
    # be a stack smash in the hook's frame.
    var tiny = alloc(AGNOSAI_TELEMETRY_MIN_CAP);
    store8(tiny, 88);
    assert_eq(agnosai_telemetry_format_json(tiny, AGNOSAI_TELEMETRY_MIN_CAP - 1, 0,
        SK_INFO, "hello", 5), 0, "a buffer below the minimum is refused, not partly written");
    assert_eq(load8(tiny), 88, "and nothing is written into it");
    assert_eq(agnosai_telemetry_format_json(tiny, 0, 0, SK_INFO, "hello", 5), 0,
      "a zero-length buffer likewise");
    assert(agnosai_telemetry_format_json(tiny, AGNOSAI_TELEMETRY_MIN_CAP, 0,
        SK_INFO, "hello", 5) > 0, "and the minimum itself does produce a line");
    assert_eq(AGNOSAI_TELEMETRY_LINE_CAP, 4096,
      "the hook's buffer is PIPE_BUF — a larger one would give up atomic writes to a pipe");

    # --- sakshi 2.4.10's fields block --------------------------------------
    # The gap this port reported upstream, now consumed. A log event's sixth
    # hook argument is 0 or `{count}{key,key_len,val,val_len}*`, and the fields
    # become their own JSON members — which is what the Rust oracle's
    # subscriber emits and what a log shipper can index on.
    var f1 = alloc(40);
    store64(f1, 1);
    store64(f1 + 8, "hoosh_url");
    store64(f1 + 16, 9);
    store64(f1 + 24, "http://x");
    store64(f1 + 32, 8);
    var jf = _t_json_f(0, SK_INFO, "LLM client configured", f1);
    assert_eq(str_contains_cstr(jf,
        "\"fields\":{\"message\":\"LLM client configured\",\"hoosh_url\":\"http://x\"}"), 1,
      "a field becomes its own member inside `fields`, beside `message`");

    # ⚠ No fields block means no extra members and no stray comma — the object
    # must close straight after `message`.
    assert_eq(str_contains_cstr(_t_json(0, SK_INFO, "plain"),
        "\"fields\":{\"message\":\"plain\"},\"target\""), 1,
      "an event with no fields closes straight after message");
    assert_eq(str_contains_cstr(_t_json(0, SK_INFO, "plain"), ",}"), 0,
      "with no trailing comma");

    # Several fields all land, in order.
    var f2 = alloc(72);
    store64(f2, 2);
    store64(f2 + 8, "a");
    store64(f2 + 16, 1);
    store64(f2 + 24, "1");
    store64(f2 + 32, 1);
    store64(f2 + 40, "b");
    store64(f2 + 48, 1);
    store64(f2 + 56, "2");
    store64(f2 + 64, 1);
    assert_eq(str_contains_cstr(_t_json_f(0, SK_INFO, "m", f2),
        "\"message\":\"m\",\"a\":\"1\",\"b\":\"2\""), 1, "two fields land in order");

    # ⚠ Keys and values are both ESCAPED. A field value is caller data — an
    # unescaped quote does not corrupt one member, it corrupts the line.
    var f3 = alloc(40);
    store64(f3, 1);
    store64(f3 + 8, "k\"q");
    store64(f3 + 16, 3);
    store64(f3 + 24, "v\"q");
    store64(f3 + 32, 3);
    assert_eq(str_contains_cstr(_t_json_f(0, SK_INFO, "m", f3), "\"k\\\"q\":\"v\\\"q\""), 1,
      "both key and value are JSON-escaped");

    # ⚠ Values are emitted as STRINGS. sakshi carries every value as bytes with
    # no type tag, so an integer field renders quoted where `tracing` would
    # render it bare. Sniffing digits would mis-type an id like `007`, so the
    # divergence is stated rather than guessed at.
    var f4 = alloc(40);
    store64(f4, 1);
    store64(f4 + 8, "tools");
    store64(f4 + 16, 5);
    store64(f4 + 24, "4");
    store64(f4 + 32, 1);
    assert_eq(str_contains_cstr(_t_json_f(0, SK_INFO, "m", f4), "\"tools\":\"4\""), 1,
      "an integer-valued field is quoted — sakshi has no type tag to recover");

    # A zero count is the same as no block.
    var f0 = alloc(8);
    store64(f0, 0);
    assert_eq(str_contains_cstr(_t_json_f(0, SK_INFO, "m", f0),
        "\"fields\":{\"message\":\"m\"}"), 1, "a zero-count block adds nothing");

    # ⚠ A field that will not fit is dropped WHOLE, never half-written — a
    # truncated `"key":"va` is unparseable, where a missing field is merely
    # incomplete.
    var wide = alloc(9000);
    for (var wi = 0; wi < 9000; wi = wi + 1) { store8(wide + wi, 65); }
    var fbig = alloc(40);
    store64(fbig, 1);
    store64(fbig + 8, "k");
    store64(fbig + 16, 1);
    store64(fbig + 24, wide);
    store64(fbig + 32, 9000);
    var jbig = alloc(4096);
    var nbig = agnosai_telemetry_format_json_f(jbig, 4096, 0, SK_INFO, "m", 1, fbig);
    assert(nbig > 0, "an oversized field still yields a line");
    assert_eq(load8(jbig + nbig - 1), 10, "terminated with a newline");
    assert_eq(str_contains_cstr(str_new(jbig, nbig), "\"target\":\"agnosai\""), 1,
      "with the JSON tail intact");
    # The point: the field is absent ENTIRELY. Its key must not appear, because
    # a written key with a truncated value is unparseable JSON.
    assert_eq(str_contains_cstr(str_new(jbig, nbig), "\"k\":"), 0,
      "and the oversized field is dropped WHOLE — not a key with a cut-off value");
    assert_eq(str_contains_cstr(str_new(jbig, nbig), "\"message\":\"m\"}"), 1,
      "so `fields` closes right after the message");

    # --- the hook end to end, through fd 2 ----------------------------------
    # Everything above drives the formatter directly. This installs the real
    # hook, redirects fd 2 into a pipe, emits through sakshi, and reads the
    # bytes back — the only thing that proves the hook forwards sakshi's fields
    # block at all. A hook that ignores its sixth argument passes every
    # formatter test above and drops every field in production.
    var pfds = alloc(16);
    if (sys_pipe(pfds) == 0) {
        var rfd = load64(pfds) & 0xFFFFFFFF;
        var wfd = (load64(pfds) >> 32) & 0xFFFFFFFF;
        var saved = syscall(SYS_DUP, 2);
        sys_dup2(wfd, 2);
        agnosai_telemetry_init_json_logging();
        sakshi_set_level(SK_INFO);
        sakshi_log_kv(SK_INFO, "captured", 8, "unit", 4, "42", 2);
        sakshi_clear_emit_hook();
        sys_dup2(saved, 2);
        sys_close(saved);
        sys_close(wfd);
        var cap_buf = alloc(4096);
        var cn = sys_read(rfd, cap_buf, 4096);
        sys_close(rfd);
        assert(cn > 0, "the hook wrote a line to fd 2");
        var captured = str_new(cap_buf, cn);
        assert_eq(str_contains_cstr(captured, "\"message\":\"captured\""), 1,
          "carrying the message unflattened");
        assert_eq(str_contains_cstr(captured, "\"unit\":\"42\""), 1,
          "and the field as its own member — the whole point of sakshi 2.4.10");
        assert_eq(str_contains_cstr(captured, "captured unit=42"), 0,
          "with no flattened tail left in the message");
        assert_eq(load8(cap_buf + cn - 1), 10, "and one newline terminating it");
    }

    # --- the global exporter handle (ADR 017) --------------------------------
    # The span call sites in `llm`, `tools` and `orchestrator` reach the
    # exporter through a process global, the way every `info_span!` in a Rust
    # program reaches `set_global_default`'s subscriber.
    assert_eq(agnosai_telemetry_exporter(), 0, "no exporter is installed at rest");

    # ⚠ With telemetry OFF, recording a span must be a cheap no-op rather than
    # an error — that is the normal state, and every call site runs it.
    var quiet = agnosai_genai_tool_span(str_from("t"), str_from("a"), str_from("1"));
    assert_eq(agnosai_telemetry_record_span(quiet, 1, 2, AGNOSAI_OTLP_STATUS_OK), 0,
      "recording a span with telemetry off queues nothing");

    var g3 = agnosai_telemetry_init_tracing(str_from("http://localhost:4318"));
    assert(agnosai_telemetry_exporter() != 0, "init_tracing installs the global");
    assert_eq(agnosai_telemetry_exporter(), agnosai_tracing_guard_exporter(g3),
      "and it is the same exporter the guard owns");

    var ring3 = agnosai_otlp_exporter_ring(agnosai_telemetry_exporter());
    assert_eq(agnosai_telemetry_record_span(quiet, 1, 2, AGNOSAI_OTLP_STATUS_OK), 1,
      "with telemetry on, a span is queued");
    assert_eq(agnosai_otlp_ring_count(ring3), 1, "and reaches the exporter's ring");

    # ⚠ Shutdown must clear the global too. A span created during shutdown would
    # otherwise enqueue into a stopped exporter and never be drained.
    agnosai_telemetry_shutdown(g3);
    assert_eq(agnosai_telemetry_exporter(), 0, "shutdown clears the global");
    assert_eq(agnosai_telemetry_record_span(quiet, 1, 2, AGNOSAI_OTLP_STATUS_OK), 0,
      "so a span created after shutdown queues nothing");

    # --- status folding ------------------------------------------------------
    assert_eq(agnosai_telemetry_status_of(1), AGNOSAI_OTLP_STATUS_OK, "1 folds to OK");
    assert_eq(agnosai_telemetry_status_of(0), AGNOSAI_OTLP_STATUS_ERROR, "0 folds to ERROR");
    # ⚠ Anything that is not exactly 1 is an error. A tool returning 2 for
    # "partial" must not be recorded as a success.
    assert_eq(agnosai_telemetry_status_of(2), AGNOSAI_OTLP_STATUS_ERROR,
      "and so does any other value — only 1 is success");

    # --- the log target --------------------------------------------------
    assert(str_eq_cstr(str_from(agnosai_telemetry_log_target()), "agnosai") == 1,
      "the target is the crate name");

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
