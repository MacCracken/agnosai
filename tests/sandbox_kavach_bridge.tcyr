# =========================================================================
# sandbox_kavach_bridge — parity tests for src/sandbox/kavach_bridge.cyr.
#
# **All 16 of the oracle's tests port.** `build_config_enables_externalization`
# was the holdout — Cyrius kavach's `SandboxConfig` had no `externalization`
# field — and agnosai filed for one, which shipped as kavach 3.11.2.
#
# Where this goes past the oracle:
#
#   * **`scan_output`'s collapse in both directions.** The oracle asserts a
#     clean string passes and a secret blocks. It cannot assert what happens to
#     WARN and QUARANTINE, because its `Result` never sees them — and those are
#     exactly the two a careless port gets wrong.
#   * **Exact strength values.** The oracle asserts `<= 20` and `>= 60` and an
#     ordering. The concrete numbers are pinned here, because the modifier that
#     produces them (`policy_basic()`'s seccomp) is silently droppable.
#   * **The trust table's inversion**, which reads backwards and is correct.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/core/mod.cyr"
include "src/sandbox/mod.cyr"
include "tests/test_helpers.cyr"

# --- map_backend ---------------------------------------------------------

# `map_backend_none_to_noop`, `_wasm`, `_process`, `_oci`.
fn _t_kv_map_backend(): i64 {
    assert(agnosai_kavach_map_backend(AGNOSAI_ISOLATION_NONE) == Backend.NOOP,
    "None maps to Noop — NOT Process; an unsandboxed tool must not look isolated");
    assert(agnosai_kavach_map_backend(AGNOSAI_ISOLATION_WASM) == Backend.WASM, "Wasm");
    assert(agnosai_kavach_map_backend(AGNOSAI_ISOLATION_PROCESS) == Backend.PROCESS, "Process");
    assert(agnosai_kavach_map_backend(AGNOSAI_ISOLATION_OCI) == Backend.OCI, "Oci");

    # Noop is the backend that scores 0 — the mapping is what makes "no sandbox"
    # visible in the strength number rather than merely absent.
    assert(base_score(Backend.NOOP) == 0, "Noop's base score is 0");
    return 0;
}

# --- Strength ------------------------------------------------------------

# `strength_for_native_policy`, `_wasm`, `_process`, `strength_ordering_*`.
fn _t_kv_strength(): i64 {
    var native = agnosai_kavach_strength_for_policy(agnosai_sandbox_policy_native());
    var wasm = agnosai_kavach_strength_for_policy(agnosai_sandbox_policy_wasm());
    var process = agnosai_kavach_strength_for_policy(agnosai_sandbox_policy_process());
    var container = agnosai_kavach_strength_for_policy(agnosai_sandbox_policy_container());

    # The oracle's bounds.
    assert(native <= 20, "native is low, as the oracle asserts");
    assert(wasm >= 60, "wasm is >= 60, as the oracle asserts");

    # The exact values. Pinned because the +5 seccomp modifier that produces
    # them comes from `policy_basic()`, and starting from `policy_new()` instead
    # would move wasm 75 -> 70 with every bound above still satisfied.
    assert(native == 10, "native scores exactly 10 (Noop 0, +5 seccomp, +5 no-network)");
    assert(wasm == 75, "wasm scores exactly 75 — the value that drops to 70 without policy_basic()");
    assert(process == 60, "process scores exactly 60");
    assert(container == 60, "container scores 60 — Oci 55 +5 seccomp, and NO no-network bonus");

    # **The oracle's ordering test asserts only these two**, and deliberately
    # not `wasm < process`, because that is FALSE: kavach scores WASM (65 base)
    # above Process (50 base). A port that "completed" the ordering would fail.
    assert(native < wasm, "native < wasm");
    assert(native < process, "native < process");
    assert(wasm > process,
    "and wasm OUTSCORES process — higher isolation level, lower kavach score, by design");
    return 0;
}

# `strength_label_ranges`.
fn _t_kv_strength_label(): i64 {
    assert(str_eq_cstr(str_from(agnosai_kavach_strength_label(0)), "minimal") == 1, "0 is minimal");
    assert(str_eq_cstr(str_from(agnosai_kavach_strength_label(50)), "standard") == 1,
    "50 is standard — the boundary is < 50 for basic, so 50 lands above it");
    assert(str_eq_cstr(str_from(agnosai_kavach_strength_label(90)), "fortress") == 1,
    "90 is fortress");
    # The bands the oracle does not check.
    assert(str_eq_cstr(str_from(agnosai_kavach_strength_label(29)), "minimal") == 1, "29 minimal");
    assert(str_eq_cstr(str_from(agnosai_kavach_strength_label(30)), "basic") == 1, "30 basic");
    assert(str_eq_cstr(str_from(agnosai_kavach_strength_label(69)), "standard") == 1, "69 standard");
    assert(str_eq_cstr(str_from(agnosai_kavach_strength_label(70)), "hardened") == 1, "70 hardened");
    assert(str_eq_cstr(str_from(agnosai_kavach_strength_label(84)), "hardened") == 1, "84 hardened");
    assert(str_eq_cstr(str_from(agnosai_kavach_strength_label(85)), "fortress") == 1, "85 fortress");
    return 0;
}

# --- build_config --------------------------------------------------------

# `build_config_sets_backend`, plus what the oracle cannot reach.
fn _t_kv_build_config(): i64 {
    var c = agnosai_kavach_build_config(agnosai_sandbox_policy_process(), 0);
    assert(SandboxConfig_backend(c) == Backend.PROCESS, "the backend comes from effective isolation");
    assert(SandboxConfig_timeout_ms(c) == 60000,
    "max_duration_secs is converted to MILLISECONDS — 60 s becomes 60000");

    var n = agnosai_kavach_build_config(agnosai_sandbox_policy_native(), 0);
    assert(SandboxConfig_backend(n) == Backend.NOOP, "native builds a Noop config");
    assert(SandboxConfig_timeout_ms(n) == 300000, "and its 300 s timeout");

    # `agent_id` is optional; 0 is the oracle's `None`.
    var a = agnosai_kavach_build_config(agnosai_sandbox_policy_process(), str_from("agent-7"));
    assert(SandboxConfig_agent_id(a) != 0, "an agent id is attached when given");
    assert(streq(SandboxConfig_agent_id(a), "agent-7") == 1, "...and it is the id given");

    # **kavach stores the pointer verbatim** (`lib/kavach.cyr:3459`) and every
    # reader of it is `strlen`-based, so the id has to be a C string — and a
    # `Str` is not one. `str_substr` shares its source's bytes and adds no
    # terminator (`lib/str.cyr:634-640`), so until 2026-08-05 a borrowed id read
    # on past its own length into whatever the arena held next.
    var sliced = str_substr(str_from("agent-42|trailing-garbage"), 0, 8);
    var b = agnosai_kavach_build_config(agnosai_sandbox_policy_process(), sliced);
    assert(streq(SandboxConfig_agent_id(b), "agent-42") == 1,
    "a borrowed agent id ends at ITS length, not at the next NUL further along the arena");

    # A container policy needs network, so the config must carry it — this is
    # the field whose default would otherwise silently isolate a tool that
    # asked for a network, or vice versa.
    var ct = agnosai_kavach_build_config(agnosai_sandbox_policy_container(), 0);
    assert(SandboxPolicy_network_enabled(SandboxConfig_policy(ct)) == 1,
    "a container policy's network requirement reaches the kavach config");
    assert(SandboxPolicy_network_enabled(SandboxConfig_policy(c)) == 0,
    "and a process policy's does not");
    return 0;
}

# **`max_memory_bytes` is never read**, and that is the oracle's behaviour, not
# an oversight to fix.
fn _t_kv_memory_is_not_wired(): i64 {
    var p = agnosai_sandbox_policy_new(AGNOSAI_ISOLATION_PROCESS, 1, 0, 60, 268435456);
    var c = agnosai_kavach_build_config(p, 0);
    assert(agnosai_sandbox_policy_max_memory_bytes(p) == 268435456,
    "the policy carries a memory limit");
    assert(SandboxPolicy_memory_limit_mb(SandboxConfig_policy(c)) == 0,
    "...and build_config does NOT forward it — matching the oracle, which never reads the field");
    return 0;
}

# `build_config_enables_externalization` — **the oracle test that could not be
# written until kavach 3.11.2 added the field.** It is the whole reason for that
# release, so it is asserted through `build_config`, not just standalone.
fn _t_kv_build_config_externalization(): i64 {
    var c = agnosai_kavach_build_config(agnosai_sandbox_policy_process(), 0);
    var e = SandboxConfig_externalization(c);
    assert(e != 0, "build_config attaches an externalization policy");
    assert(ExternalizationPolicy_enabled(e) == 1, "...and it is enabled");
    assert(ExternalizationPolicy_block_threshold(e) == Severity.CRITICAL,
    "...with the default thresholds the oracle passes");

    # Unconditional — every isolation level, not just the sandboxed ones. A
    # native (Noop) config gets it too, which is what the oracle does.
    var n = agnosai_kavach_build_config(agnosai_sandbox_policy_native(), 0);
    assert(SandboxConfig_externalization(n) != 0,
    "even a Noop config carries the gate policy — the oracle attaches it unconditionally");
    return 0;
}

# The default policy's own values.
fn _t_kv_ext_policy(): i64 {
    var e = agnosai_kavach_default_ext_policy();
    assert(ExternalizationPolicy_enabled(e) == 1, "the default gate is enabled");
    assert(ExternalizationPolicy_max_artifact_size_bytes(e) == 52428800, "50 MiB artifact cap");
    assert(ExternalizationPolicy_block_threshold(e) == Severity.CRITICAL, "blocks at Critical");
    assert(ExternalizationPolicy_quarantine_threshold(e) == Severity.HIGH, "quarantines at High");
    assert(ExternalizationPolicy_redact_secrets(e) == 1, "and redacts secrets");
    return 0;
}

# --- policy_for_trust ----------------------------------------------------

# `policy_for_trust_minimal`, `_strict`, `_default`.
fn _t_kv_policy_for_trust(): i64 {
    # **The inversion**: "minimal" TRUST gets the STRICTEST thresholds.
    var m = agnosai_kavach_policy_for_trust(str_from("minimal"));
    assert(ExternalizationPolicy_max_artifact_size_bytes(m) == 1048576, "minimal: 1 MiB");
    assert(ExternalizationPolicy_block_threshold(m) == Severity.MEDIUM,
    "minimal trust BLOCKS at Medium — the strictest of the three, because least trusted");
    assert(ExternalizationPolicy_quarantine_threshold(m) == Severity.LOW, "and quarantines at Low");

    var s = agnosai_kavach_policy_for_trust(str_from("strict"));
    assert(ExternalizationPolicy_max_artifact_size_bytes(s) == 10485760, "strict: 10 MiB");
    assert(ExternalizationPolicy_block_threshold(s) == Severity.HIGH, "strict blocks at High");
    assert(ExternalizationPolicy_quarantine_threshold(s) == Severity.MEDIUM, "quarantines at Medium");

    # **`enabled` decides whether any of the above runs at all.** `gate_apply`
    # short-circuits to PASS before it scans anything when the flag is clear
    # (`lib/kavach.cyr:5712-5715`), so the carefully pinned thresholds are
    # inert without it — and until 2026-08-05 both hand-built policies could be
    # constructed disabled with the suite still at 93/93. `redact_secrets` is
    # the sole guard on the WARN redaction block, and was equally unpinned.
    assert(ExternalizationPolicy_enabled(m) == 1,
    "minimal's gate is ENABLED — a disabled policy passes everything, thresholds and all");
    assert(ExternalizationPolicy_redact_secrets(m) == 1, "...and redacts");
    assert(ExternalizationPolicy_enabled(s) == 1, "so is strict's");
    assert(ExternalizationPolicy_redact_secrets(s) == 1, "...and it redacts too");

    # Ordering: minimal is strictly tighter than strict, which is tighter than
    # the default. Asserting the relationship catches a table transposed.
    var d = agnosai_kavach_policy_for_trust(str_from("basic"));
    assert(ExternalizationPolicy_max_artifact_size_bytes(m)
    < ExternalizationPolicy_max_artifact_size_bytes(s),
    "minimal's cap is tighter than strict's");
    assert(ExternalizationPolicy_max_artifact_size_bytes(s)
    < ExternalizationPolicy_max_artifact_size_bytes(d),
    "and strict's is tighter than the default's");
    assert(ExternalizationPolicy_block_threshold(m) < ExternalizationPolicy_block_threshold(s),
    "minimal blocks at a LOWER severity than strict — it is more aggressive");

    # Unrecognised falls to the default, and matching is case-sensitive.
    assert(ExternalizationPolicy_max_artifact_size_bytes(d) == 52428800,
    "'basic' is not a table entry — it falls to the default");
    assert(ExternalizationPolicy_max_artifact_size_bytes(
    agnosai_kavach_policy_for_trust(str_from("nonsense"))) == 52428800, "so does anything unknown");
    assert(ExternalizationPolicy_max_artifact_size_bytes(
    agnosai_kavach_policy_for_trust(str_from("Minimal"))) == 52428800,
    "matching is case-SENSITIVE, as the oracle's `match` is — 'Minimal' is not 'minimal'");
    assert(ExternalizationPolicy_max_artifact_size_bytes(
    agnosai_kavach_policy_for_trust(str_from(""))) == 52428800, "and empty is the default");
    return 0;
}

# --- scan_output ---------------------------------------------------------

# An ExecResult carrying `out` as stdout, for reaching kavach's gate directly.
fn _t_kv_exec_of(out: Str): i64 {
    var r = exec_result_new();
    ExecResult_set_exit_code(r, 0);
    # `str_cstr`, not `str_data` — kavach measures this with `strlen`, and a
    # `Str` built by `str_new`/`str_substr` carries no terminator. The tests
    # below hand it exactly those.
    ExecResult_set_stdout(r, str_cstr(out));
    ExecResult_set_stderr(r, "");
    ExecResult_set_duration_ms(r, 0);
    ExecResult_set_timed_out(r, 0);
    return r;
}

# `scan_clean_output_passes`, `scan_secret_output_blocks`, plus the collapse.
fn _t_kv_scan_output(): i64 {
    assert(agnosai_kavach_scan_output(str_from("hello world")) == ScanVerdict.PASS,
    "clean output passes");
    assert(agnosai_kavach_scan_output(str_from("")) == ScanVerdict.PASS, "so does empty");

    # An AWS-shaped key is what the oracle uses to force a block.
    var creds = str_from("AKIAIOSFODNN7EXAMPLE aws_secret_access_key=wJalrXUtnFEMI/K7MDENG/bPxRfiCY");
    assert(agnosai_kavach_scan_output(creds) == ScanVerdict.BLOCK,
    "output carrying a credential blocks");

    # **The collapse.** Only two values may ever come back. A port returning
    # `ScanResult_verdict` unchanged would emit WARN or QUARANTINE here, and
    # both would be silent divergences — WARN where the oracle passes, and
    # QUARANTINE where it blocks.
    # **The case that makes the collapse observable**, and without which the
    # assertions below are vacuous. A JWT is scanned at `Severity.HIGH`
    # (`lib/kavach.cyr:4184`), and the default policy blocks at CRITICAL and
    # quarantines at HIGH — so the RAW gate verdict here is QUARANTINE. The
    # oracle's `gate.apply` returns `Err` for it, which it maps to Block.
    #
    # A port returning the raw verdict answers QUARANTINE (2) where the oracle
    # answers Block (3). Verified as load-bearing: removing the collapse makes
    # exactly this assertion fail.
    var jwt = str_from(
    "token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk");
    var raw = ScanResult_verdict(gate_apply(_t_kv_exec_of(jwt), ext_policy_default()));
    assert(raw == ScanVerdict.QUARANTINE,
    "a JWT makes kavach's gate answer QUARANTINE — the fourth verdict the oracle cannot see");
    assert(agnosai_kavach_scan_output(jwt) == ScanVerdict.BLOCK,
    "...and scan_output collapses it to BLOCK, as the oracle's Err arm does");

    # **The WARN half of the collapse**, which nothing pinned until 2026-08-05.
    # The QUARANTINE case above is real, but it only exercises the arm that maps
    # to BLOCK; deleting the `WARN -> PASS` line left the suite at 93/93 while
    # the port started withholding artifacts the oracle releases (`Ok(_)` covers
    # `Warn`, `kavach_bridge.rs:164`). A weak-hash mention is scanned at
    # `Severity.LOW`, below the default policy's quarantine threshold, so the
    # raw verdict is WARN — the fourth value, reached from the other side.
    var weak = str_from("digest = md5(payload)");
    var rawwarn = ScanResult_verdict(gate_apply(_t_kv_exec_of(weak), ext_policy_default()));
    assert(rawwarn == ScanVerdict.WARN,
    "a weak-hash mention makes kavach's gate answer WARN");
    assert(agnosai_kavach_scan_output(weak) == ScanVerdict.PASS,
    "...and scan_output collapses it to PASS, as the oracle's Ok arm does");

    var v1 = agnosai_kavach_scan_output(str_from("hello world"));
    var v2 = agnosai_kavach_scan_output(creds);
    assert(v1 == ScanVerdict.PASS || v1 == ScanVerdict.BLOCK, "clean is PASS or BLOCK, never WARN");
    assert(v2 == ScanVerdict.PASS || v2 == ScanVerdict.BLOCK,
    "and a secret is PASS or BLOCK, never QUARANTINE — the oracle's Result has only two arms");
    return 0;
}

# The gate measures with `strlen`, and a `Str` is not a C string.
#
# **Both directions were live and both released the wrong verdict.** The audit
# of 2026-08-04 measured them: a secret after an embedded NUL was scanned as two
# bytes and PASSed, and ten borrowed bytes were scanned as thirty-one and
# BLOCKed. Every input in this file was a `str_from` literal, whose bytes happen
# to be NUL-terminated in the binary, so no assertion could see either half.
#
# The oracle has neither problem — `kavach_bridge.rs:159` hands the gate a
# `String`, which carries its own length.
fn _t_kv_scan_output_measures_the_str_not_the_arena(): i64 {
    # `"ok" NUL "AKIAIOSFODNN7EXAMPLE"` — 23 bytes, a credential after the NUL.
    var nb = alloc(32);
    memcpy(nb, "ok", 2);
    store8(nb + 2, 0);
    memcpy(nb + 3, "AKIAIOSFODNN7EXAMPLE", 20);
    var hidden = str_new(nb, 23);
    assert(str_len(hidden) == 23, "the payload is 23 bytes, NUL included");
    assert(agnosai_kavach_scan_output(hidden) == ScanVerdict.BLOCK,
    "a credential AFTER an embedded NUL is still scanned — strlen would stop at 2 and PASS it");

    # The control: the same 23 bytes with a space where the NUL was. If this did
    # not BLOCK, the assertion above would be measuring nothing.
    var sb = alloc(32);
    memcpy(sb, "ok", 2);
    store8(sb + 2, 32);
    memcpy(sb + 3, "AKIAIOSFODNN7EXAMPLE", 20);
    assert(agnosai_kavach_scan_output(str_new(sb, 23)) == ScanVerdict.BLOCK,
    "...and the same bytes with a space instead are BLOCKed, so the payload is detectable");

    # The other direction: a borrowed slice must be scanned to ITS length, not
    # to the next NUL somewhere further along the arena. `str_substr` shares
    # data and adds no terminator, so `strlen` here runs on into the credential.
    var whole = str_from("clean-part|AKIAIOSFODNN7EXAMPLE");
    var head = str_substr(whole, 0, 10);
    assert(str_len(head) == 10, "the slice is ten clean bytes");
    assert(agnosai_kavach_scan_output(head) == ScanVerdict.PASS,
    "ten clean bytes PASS — reading past the slice would find the credential behind it");
    return 0;
}

# --- Result --------------------------------------------------------------

fn _t_kv_result(): i64 {
    var r = agnosai_kavach_result_new(str_from("out"), str_from("err"), 0, 0, 42, 75,
    ScanVerdict.PASS);
    assert(str_eq_cstr(agnosai_kavach_result_output(r), "out") == 1, "output");
    assert(str_eq_cstr(agnosai_kavach_result_stderr(r), "err") == 1, "stderr held separately");
    assert(agnosai_kavach_result_exit_code(r) == 0, "exit code");
    assert(agnosai_kavach_result_timed_out(r) == 0, "not timed out");
    assert(agnosai_kavach_result_duration_ms(r) == 42, "duration");
    assert(agnosai_kavach_result_strength(r) == 75, "strength travels with the result");
    assert(agnosai_kavach_result_scan_verdict(r) == ScanVerdict.PASS, "and the verdict");

    # `None` must not be confused with PASS — 0 IS PASS, so the sentinel is -1.
    var u = agnosai_kavach_result_new(str_from(""), str_from(""), 0, 0, 0, 0,
    AGNOSAI_KAVACH_NO_VERDICT);
    assert(agnosai_kavach_result_scan_verdict(u) == AGNOSAI_KAVACH_NO_VERDICT,
    "an unscanned result reports NO verdict");
    assert(agnosai_kavach_result_scan_verdict(u) != ScanVerdict.PASS,
    "...which is explicitly NOT 'passed' — 0 is a real verdict, so the sentinel cannot be 0");
    return 0;
}

# --- Execution ------------------------------------------------------------

fn _t_kb_execute_runs_a_command(): i64 {
    # A process-level policy maps to kavach's Process backend and really forks.
    var e[8];
    store64(&e, 0);
    var r = agnosai_kavach_execute(str_from("/bin/echo bridged"),
    agnosai_sandbox_policy_process(), 0, &e);

    assert(load64(&e) == 0, "a kavach sandbox executes");
    assert(r != 0, "...returning a result");
    assert(str_contains_cstr(agnosai_kavach_result_output(r), "bridged") == 1,
    "the command's stdout comes back through the bridge");
    assert(agnosai_kavach_result_exit_code(r) == 0, "...with its exit code");
    assert(agnosai_kavach_result_strength(r)
    == agnosai_kavach_strength_for_policy(agnosai_sandbox_policy_process()),
    "...and the strength score for the policy that ran it");
    assert(agnosai_kavach_result_scan_verdict(r) == AGNOSAI_KAVACH_NO_VERDICT,
    "scan_verdict is None - kavach applies the gate internally (kavach_bridge.rs:146)");
    return 0;
}

fn _t_kb_execute_needs_no_explicit_init(): i64 {
    # **Every `sandbox_create` fails with "backend not available" until
    # `kavach_init` has run**, and nothing else in agnosai calls it. The bridge
    # initializes lazily so a caller does not have to know that; this asserts
    # the caller really does not have to.
    var e[8];
    store64(&e, 0);
    var r = agnosai_kavach_execute(str_from("/bin/echo first-call"),
    agnosai_sandbox_policy_process(), 0, &e);
    assert(load64(&e) == 0,
    "the FIRST call into the bridge works with no initialization step");
    assert(str_contains_cstr(agnosai_kavach_result_output(r), "first-call") == 1,
    "...and actually ran");

    # And a second call is not broken by the first having initialized.
    store64(&e, 0);
    var again = agnosai_kavach_execute(str_from("/bin/echo second-call"),
    agnosai_sandbox_policy_process(), 0, &e);
    assert(load64(&e) == 0, "and so does the second");
    assert(str_contains_cstr(agnosai_kavach_result_output(again), "second-call") == 1,
    "...with its own output, not the first call's");
    return 0;
}

fn _t_kb_execute_reports_the_exit_code(): i64 {
    # `/bin/false` needs no arguments and no shell, so kavach's command splitter
    # and runtime guard cannot turn it into something else. It exits 1.
    #
    # **This asserted the opposite until kavach 3.11.3.** `backend_capture_finish`
    # hardcodes `exit_code = 0`, so every command that ran reported success -
    # filed, and pinned here so the fix would announce itself. It did: 3.11.3
    # routes a confining policy through `confine_capture`, whose tail sets the
    # payload's real code via `confine_last_exit()`. A policy that asks for NO
    # confinement still takes the plain capture and still reports 0, so the
    # filing stays open on that half.
    var e[8];
    store64(&e, 0);
    var r = agnosai_kavach_execute(str_from("/bin/false"),
    agnosai_sandbox_policy_process(), 0, &e);

    assert(load64(&e) == 0,
    "a command that EXITS non-zero is a result, not a bridge error");
    assert(r != 0, "...so a result comes back");
    assert(agnosai_kavach_result_exit_code(r) != 0,
    "...carrying the real non-zero code, not flattened to 0");
    return 0;
}
fn _t_kb_execute_honours_the_policy_deadline(): i64 {
    # `max_duration_secs` -> `timeout_ms` -> kavach's process backend. Every
    # link existed before 3.11.4 except the last, where the value was dropped:
    # a 1-second deadline let `/bin/sleep 8` run its full 8 seconds and report
    # timed_out = 0.
    var p = agnosai_sandbox_policy_new(AGNOSAI_ISOLATION_PROCESS, 0, 0, 1, 0);
    var e[8];
    store64(&e, 0);
    var t0 = clock_now_ms();
    var r = agnosai_kavach_execute(str_from("/bin/sleep 8"), p, 0, &e);
    var dt = clock_now_ms() - t0;

    assert(load64(&e) == 0, "a timeout is a result, not a bridge error");
    assert(r != 0, "...so a result comes back");
    assert(agnosai_kavach_result_timed_out(r) == 1,
    "the policy's 1-second deadline is ENFORCED by kavach, not merely stored");
    assert(dt < 15000, "...and fired rather than waiting out the sleep");
    return 0;
}

fn _t_kb_execute_with_agent_id(): i64 {
    var e[8];
    store64(&e, 0);
    var r = agnosai_kavach_execute(str_from("/bin/echo tagged"),
    agnosai_sandbox_policy_process(), str_from("agent-7"), &e);
    assert(load64(&e) == 0, "an agent-tagged sandbox executes");
    assert(str_contains_cstr(agnosai_kavach_result_output(r), "tagged") == 1,
    "...and the agent id does not disturb the command");
    return 0;
}

# The bridge's exec-failure arm, which no test reached until 2026-08-05.
#
# **All eight `load64(&e)` assertions in this file asserted `== 0`** — none ever
# checked that `out_err` was set — so the audit of 2026-08-04 deleted the
# `store64` at the exec arm and the suite stayed at 93/93. The branch is not
# theoretical: `sandbox_exec` returns 0 on BLOCK and on QUARANTINE
# (`lib/kavach.cyr:11011-11018`), so the ordinary "a tool printed a credential"
# case lands on exactly this exit.
fn _t_kb_blocked_output_is_an_error(): i64 {
    var e[8];
    store64(&e, 0);
    var r = agnosai_kavach_execute(str_from("/bin/echo AKIAIOSFODNN7EXAMPLE"),
    agnosai_sandbox_policy_process(), 0, &e);

    assert(r == 0, "an artifact the gate blocks is not released as a result");
    assert(load64(&e) != 0, "...out_err is SET — the one thing no assertion checked");
    if (load64(&e) == 0) { return 0; }
    assert(agnosai_error_kind(load64(&e)) == AGNOSAI_ERR_SANDBOX, "...as a sandbox error");
    assert(str_contains_cstr(agnosai_error_message(load64(&e)), "kavach exec failed") == 1,
    "...carrying the exec arm's message");

    # And the contrast: a command whose PROGRAM is missing is not this. kavach's
    # process backend answers with a diagnostic result and exit 127, which is a
    # successful execution reporting a failure — the distinction the old
    # `_t_kb_repeated_failures_do_not_break_the_bridge` was accidentally relying
    # on while claiming the opposite.
    store64(&e, 0);
    var m = agnosai_kavach_execute(str_from("/nonexistent/definitely-not-a-program"),
    agnosai_sandbox_policy_process(), 0, &e);
    assert(m != 0, "a missing PROGRAM is not a bridge failure — kavach diagnoses it");
    assert(load64(&e) == 0, "...so out_err stays clear");
    return 0;
}

fn _t_kb_repeated_failures_do_not_break_the_bridge(): i64 {
    # **This does NOT prove the sandbox is destroyed on the failure path, and
    # nothing available here can.** The oracle puts the `?` on the exec result
    # after both teardown transitions (kavach_bridge.rs:120-127), and the port
    # matches that ordering - but kavach's `process_destroy` returns 0 without
    # releasing anything, and a transition records no audit event, so a sandbox
    # that is never destroyed is an abandoned heap struct holding no OS
    # resource and leaving no trace. Moving the early return above the teardown
    # passes every assertion in this suite.
    #
    # It is written down rather than left implied: the ordering is correct by
    # construction, and will start mattering the moment kavach attaches a real
    # resource - a cgroup, a namespace, a container - to destroy.
    #
    # What this DOES check is that a run of failures leaves the bridge usable.
    #
    # **The failures have to be real ones.** This loop used to drive
    # `/nonexistent/definitely-not-a-program`, which is not a bridge failure at
    # all: kavach's process backend answers a missing program with a diagnostic
    # `ExecResult` carrying exit 127, so the bridge saw twelve *successful*
    # executions and the function repeated the happy path under a name that said
    # otherwise. The audit of 2026-08-04 swapped the command for `/bin/true` and
    # nothing changed. A command whose output the gate blocks is the failure
    # that does reach the exec arm.
    var e[8];
    var i = 0;
    while (i < 12) {
        store64(&e, 0);
        var f = agnosai_kavach_execute(str_from("/bin/echo AKIAIOSFODNN7EXAMPLE"),
        agnosai_sandbox_policy_process(), 0, &e);
        assert(f == 0, "a blocked artifact is a bridge FAILURE, not a result");
        assert(load64(&e) != 0, "...with out_err set — the exec arm's message");
        i = i + 1;
    }

    store64(&e, 0);
    var good = agnosai_kavach_execute(str_from("/bin/echo still-working"),
    agnosai_sandbox_policy_process(), 0, &e);
    assert(load64(&e) == 0, "the bridge still works after a dozen failed executions");
    assert(str_contains_cstr(agnosai_kavach_result_output(good), "still-working") == 1,
    "...and produces correct output, so nothing was left in a bad state");
    return 0;
}

fn _t_kb_execute_none_policy_uses_the_noop_backend(): i64 {
    # A native policy maps to Backend::Noop, which is a real registered backend
    # rather than an error - map_backend has no "unsupported" arm.
    var e[8];
    store64(&e, 0);
    var r = agnosai_kavach_execute(str_from("/bin/echo noop"),
    agnosai_sandbox_policy_native(), 0, &e);
    assert(load64(&e) == 0, "the Noop backend is available and executes");
    assert(r != 0, "...returning a result");
    return 0;
}

fn main(): i64 {
    alloc_init();
    sakshi_set_level(SK_FATAL);

    _t_kv_map_backend();
    _t_kv_strength();
    _t_kv_strength_label();
    _t_kv_build_config();
    _t_kv_memory_is_not_wired();
    _t_kv_ext_policy();
    _t_kv_build_config_externalization();
    _t_kv_policy_for_trust();
    _t_kv_scan_output();
    _t_kv_scan_output_measures_the_str_not_the_arena();
    _t_kv_result();

    # **Order matters here.** The lazy-init assertion is only meaningful as the
    # first call into the bridge; any earlier execute would have initialized it.
    _t_kb_execute_needs_no_explicit_init();
    _t_kb_execute_runs_a_command();
    _t_kb_execute_reports_the_exit_code();
    _t_kb_execute_honours_the_policy_deadline();
    _t_kb_execute_with_agent_id();
    _t_kb_blocked_output_is_an_error();
    _t_kb_repeated_failures_do_not_break_the_bridge();
    _t_kb_execute_none_policy_uses_the_noop_backend();

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
