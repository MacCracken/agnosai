# =========================================================================
# fleet_relay.tcyr — tests for src/fleet/relay.cyr
#
# Oracle: rust-old/src/fleet/relay.rs's nine `#[test]` fns, all ported.
#
# ⚠ **This module is a wrapper, so the tests are the contract check.** The
# behaviour lives in majra; what this suite pins is that agnosai gets the
# ORACLE's semantics out of it. Wrapping majra 2.5.3 would have passed a
# name-level review and shipped four defects — the reentrancy race, a discarded
# broadcast flag, no gap detection, and an undocumented replay window. All four
# were fixed in majra 2.6.0 on agnosai's report, and the assertions below are
# what would catch a regression or a dependency downgrade.
#
# Past the oracle: sequence numbering starts at 1 and is per-relay; a duplicate
# is not counted as a gap; a first message arriving past seq 1 IS a gap; and the
# two documented divergences (ignored channel capacity, monotonic timestamp) are
# asserted as they actually behave rather than as the oracle behaves, so nobody
# reads them as accidental.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/core/mod.cyr"
include "src/fleet/relay.cyr"
include "tests/test_helpers.cyr"

# Build an inbound message from `from`, addressed to `to` ("" = broadcast).
fn _t_msg(seq, from, to, topic): i64 {
    return agnosai_relay_message_new(seq, str_from(from), str_from(to), str_from(topic), 0);
}

fn main(): i64 {
    # --- oracle: send_increments_seq ------------------------------------
    var r = agnosai_relay_with_defaults(str_from("node-1"));
    assert(str_eq_cstr(agnosai_relay_node_id(r), "node-1") == 1, "the relay knows its node id");
    assert_eq(agnosai_relay_send(r, str_from("node-2"), str_from("t"), 0), 1,
      "the first send is sequence 1");
    assert_eq(agnosai_relay_send(r, str_from("node-2"), str_from("t"), 0), 2,
      "the second is 2");
    assert_eq(agnosai_relay_send(r, str_from("node-3"), str_from("t"), 0), 3,
      "sequence is per-relay, not per-target");

    # --- oracle: broadcast_uses_empty_to --------------------------------
    assert_eq(agnosai_relay_broadcast(r, str_from("ann"), 0), 4,
      "broadcast draws from the same sequence");

    # --- past the oracle: sequences are per-relay -----------------------
    var r2 = agnosai_relay_with_defaults(str_from("other"));
    assert_eq(agnosai_relay_send(r2, str_from("x"), str_from("t"), 0), 1,
      "a second relay starts its own sequence at 1");

    # --- oracle: receive_skips_own_messages -----------------------------
    var rx = agnosai_relay_with_defaults(str_from("node-1"));
    assert_eq(agnosai_relay_receive(rx, _t_msg(1, "node-1", "", "t")), 0,
      "a relay drops its own message");

    # --- oracle: receive_skips_messages_for_other_nodes -----------------
    assert_eq(agnosai_relay_receive(rx, _t_msg(1, "node-2", "node-99", "t")), 0,
      "a message addressed elsewhere is dropped");

    # --- oracle: receive_accepts_broadcast ------------------------------
    var inc = agnosai_relay_receive(rx, _t_msg(1, "node-2", "", "ann"));
    assert(inc != 0, "a broadcast from another node is accepted");
    assert_eq(agnosai_incoming_is_broadcast(inc), 1, "and is flagged a broadcast");
    var m = agnosai_incoming_message(inc);
    assert_eq(agnosai_relay_message_seq(m), 1, "the message keeps its sequence");
    assert(str_eq_cstr(agnosai_relay_message_from(m), "node-2") == 1, "and its sender");
    assert(str_eq_cstr(agnosai_relay_message_topic(m), "ann") == 1, "and its topic");

    # A targeted message is accepted and NOT flagged a broadcast. Before majra
    # 2.6.0 this flag was computed and thrown away, so this assertion is the
    # one that pins the dependency fix.
    var inc2 = agnosai_relay_receive(rx, _t_msg(2, "node-2", "node-1", "cmd"));
    assert(inc2 != 0, "a message addressed to this node is accepted");
    assert_eq(agnosai_incoming_is_broadcast(inc2), 0, "and is NOT flagged a broadcast");
    assert(str_eq_cstr(agnosai_relay_message_to(agnosai_incoming_message(inc2)),
        "node-1") == 1, "and carries its explicit target");

    # --- oracle: receive_dedup_drops_duplicate --------------------------
    assert_eq(agnosai_relay_receive(rx, _t_msg(2, "node-2", "", "t")), 0,
      "a replayed sequence is dropped");
    assert_eq(agnosai_relay_receive(rx, _t_msg(1, "node-2", "", "t")), 0,
      "an older sequence is dropped too");
    assert(agnosai_relay_receive(rx, _t_msg(3, "node-2", "", "t")) != 0,
      "the next sequence is accepted");

    # --- oracle: receive_detects_sequence_gap ---------------------------
    # The oracle warns; majra counts. Same information, and assertable.
    var rg = agnosai_relay_with_defaults(str_from("node-1"));
    assert_eq(agnosai_relay_sequence_gaps(rg), 0, "a fresh relay has seen no gaps");
    assert(agnosai_relay_receive(rg, _t_msg(1, "peer", "", "t")) != 0, "seq 1 accepted");
    assert_eq(agnosai_relay_sequence_gaps(rg), 0, "a first message at seq 1 is not a gap");
    assert(agnosai_relay_receive(rg, _t_msg(2, "peer", "", "t")) != 0, "seq 2 accepted");
    assert_eq(agnosai_relay_sequence_gaps(rg), 0, "a contiguous sequence records no gap");
    assert(agnosai_relay_receive(rg, _t_msg(5, "peer", "", "t")) != 0,
      "a gapped message is still DELIVERED — a gap is not a rejection");
    assert_eq(agnosai_relay_sequence_gaps(rg), 1, "but the gap is counted");

    # --- past the oracle: a duplicate is not a gap ----------------------
    assert_eq(agnosai_relay_receive(rg, _t_msg(5, "peer", "", "t")), 0, "the replay is dropped");
    assert_eq(agnosai_relay_sequence_gaps(rg), 1, "and does not add a gap");
    assert_eq(agnosai_relay_stats_duplicates_dropped(agnosai_relay_stats(rg)), 1,
      "it is counted as a duplicate instead");

    # --- past the oracle: a new sender starting past 1 is a gap ---------
    assert(agnosai_relay_receive(rg, _t_msg(7, "latecomer", "", "t")) != 0,
      "a new sender's first message is accepted");
    assert_eq(agnosai_relay_sequence_gaps(rg), 2,
      "and starting past seq 1 counts as a gap — messages were missed before we saw it");

    # --- past the oracle: last-seq tracking is per sender ---------------
    assert_eq(agnosai_relay_last_seq(rg, str_from("peer")), 5, "peer's last seq is tracked");
    assert_eq(agnosai_relay_last_seq(rg, str_from("latecomer")), 7,
      "and latecomer's independently");
    assert_eq(agnosai_relay_last_seq(rg, str_from("never-seen")), 0 - 1,
      "an unknown sender answers -1, distinct from a real sequence 0");

    # --- oracle: stats_tracking -----------------------------------------
    var rs = agnosai_relay_with_defaults(str_from("node-1"));
    var s0 = agnosai_relay_stats(rs);
    assert_eq(agnosai_relay_stats_messages_sent(s0), 0, "a fresh relay has sent nothing");
    assert_eq(agnosai_relay_stats_messages_received(s0), 0, "and received nothing");
    assert_eq(agnosai_relay_stats_duplicates_dropped(s0), 0, "and dropped nothing");

    agnosai_relay_send(rs, str_from("node-2"), str_from("t"), 0);
    agnosai_relay_send(rs, str_from("node-2"), str_from("t"), 0);
    agnosai_relay_receive(rs, _t_msg(1, "node-2", "", "t"));
    agnosai_relay_receive(rs, _t_msg(1, "node-2", "", "t"));

    var s1 = agnosai_relay_stats(rs);
    assert_eq(agnosai_relay_stats_messages_sent(s1), 2, "two sends counted");
    assert_eq(agnosai_relay_stats_messages_received(s1), 1, "one accepted receive counted");
    assert_eq(agnosai_relay_stats_duplicates_dropped(s1), 1, "one duplicate counted");
    # A skipped message is neither received nor a duplicate — it never reached
    # the dedup step at all.
    agnosai_relay_receive(rs, _t_msg(9, "node-1", "", "t"));
    var s2 = agnosai_relay_stats(rs);
    assert_eq(agnosai_relay_stats_messages_received(s2), 1, "our own message is not received");
    assert_eq(agnosai_relay_stats_duplicates_dropped(s2), 1, "nor counted as a duplicate");

    # --- oracle: subscriber_receives_sent_messages ----------------------
    var rsub = agnosai_relay_with_defaults(str_from("node-1"));
    var ch = agnosai_relay_subscribe(rsub);
    assert(ch != 0, "subscribe returns a channel");
    agnosai_relay_send(rsub, str_from("node-2"), str_from("evt"), 0);
    var got = chan_recv(ch);
    assert(got != 0, "the subscriber receives the sent message");
    assert_eq(agnosai_relay_message_seq(got), 1, "with its sequence");
    assert(str_eq_cstr(agnosai_relay_message_topic(got), "evt") == 1, "and its topic");

    # An inbound message accepted by receive also fans out to subscribers.
    agnosai_relay_receive(rsub, _t_msg(1, "node-2", "", "inbound"));
    var got2 = chan_recv(ch);
    assert(got2 != 0, "an accepted inbound message also reaches subscribers");
    assert(str_eq_cstr(agnosai_relay_message_topic(got2), "inbound") == 1,
      "and it is the inbound one");

    # --- the two divergences that were owed to majra, now CLOSED -------
    # ✅ Both fixed in majra 2.6.5, filed from here. These used to assert the
    # broken behaviour, written down so a reader saw them as known rather than
    # accidental; they now assert the oracle's.

    # 1. Channel capacity REACHES the channel. A depth of 2 is the
    # discriminator: with nobody draining, the third send must be refused, where
    # the old hardcoded 256 swallowed it.
    var rcap = agnosai_relay_new(str_from("node-1"), 2);
    assert_eq(agnosai_relay_capacity(rcap), 2, "the requested capacity is recorded");
    var cap_ch = agnosai_relay_subscribe(rcap);
    assert(cap_ch != 0, "and subscribe hands back a channel");
    assert_eq(chan_try_send(cap_ch, 1), 0, "first send fits");
    assert_eq(chan_try_send(cap_ch, 2), 0, "second send fits");
    assert_eq(chan_try_send(cap_ch, 3), 0 - 2,
      "the THIRD is refused — the capacity is APPLIED, not advisory");

    # 2. The timestamp is a WALL-CLOCK epoch instant, as the oracle's
    # `DateTime<Utc>` is. A monotonic reading is uptime and orders of magnitude
    # smaller; 1.577e18 is 2020-01-01.
    var tm = agnosai_relay_message_timestamp(_t_msg(1, "a", "", "t"));
    assert(tm > 1577836800000000000,
      "the stamp is an epoch instant, not monotonic uptime");
    assert(tm <= clock_epoch_ns(), "and it is not in the future");

    # --- past the oracle: the inner relay is reachable ------------------
    # For the majra APIs this wrapper deliberately does not re-export.
    assert(agnosai_relay_inner(rs) != 0, "the underlying majra relay is reachable");
    assert_eq(relay_dedup_table_size(agnosai_relay_inner(rs)), 1,
      "and answers majra's own accessors — one sender tracked");

    # --- past the oracle: the payload is carried BY REFERENCE -----------
    # ⚠ On its OWN relay. An earlier revision put this inline and used seq 9,
    # which advanced node-2's last-seen and turned the NEXT test's seq 2 into a
    # duplicate — a reminder that these assertions share per-sender sequence
    # state and order matters.
    # The payload is carried BY REFERENCE — majra stores the pointer it was
    # given, it does not copy. So the value a subscriber reads is the caller's
    # object, and a caller that mutates or frees it after sending changes what
    # every receiver sees. Pinned because it is the kind of aliasing that only
    # bites once something real is put through the relay.
    var pay = bayan_json_v_int_new(4242);
    var pm = agnosai_relay_message_new(9, str_from("node-2"), str_from(""),
      str_from("payload-test"), pay);
    assert_eq(agnosai_relay_message_payload(pm), pay,
      "the payload round-trips as the SAME object, not a copy");
    var rpay = agnosai_relay_with_defaults(str_from("node-1"));
    var pinc = agnosai_relay_receive(rpay, pm);
    assert(pinc != 0, "and a message carrying one is accepted");
    assert_eq(agnosai_relay_message_payload(agnosai_incoming_message(pinc)), pay,
      "and survives receive by reference");
    assert_eq(agnosai_relay_message_payload(_t_msg(1, "a", "", "t")), 0,
      "a message built with no payload carries 0");


    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
