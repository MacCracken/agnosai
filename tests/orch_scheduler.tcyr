# =========================================================================
# orch_scheduler.tcyr — parity tests for src/orchestrator/scheduler.cyr
#
# Oracle: the #[cfg(test)] block in rust-old/src/orchestrator/scheduler.rs —
# 16 tests across the priority queue, the DAG loader, both topological sorts
# and cycle detection. All portable.
#
# The determinism cases get more than the oracle gives them, because that is
# where a port of this module goes wrong: `kahn_sort`'s two sorts are
# deliberate and observable, while `ready_tasks`' and `topological_sort_tasks`'
# tie order is unspecified in the oracle and pinned here.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/core/error.cyr"
include "src/core/json.cyr"
include "src/core/message.cyr"
include "src/core/resource.cyr"
include "src/core/task.cyr"
include "src/orchestrator/scheduler.cyr"
include "tests/test_helpers.cyr"

# A task with a description and priority.
fn _t_task(desc, priority): i64 {
    var t = agnosai_task_new(str_from(desc));
    agnosai_task_with_priority(t, priority);
    return t;
}

# A DAG over the given keys, with edges added separately.
fn _t_dag(): i64 {
    return agnosai_task_dag_new(map_new_str(), vec_new(), str_from("sequential"));
}

# Add a keyed task to a DAG, returning the task.
fn _t_dag_add(dag, key, priority): i64 {
    var t = _t_task(key, priority);
    map_set(agnosai_task_dag_tasks(dag), str_from(key), t);
    return t;
}

# Add a `from -> to` edge to a DAG.
fn _t_edge(dag, from, to): i64 {
    vec_push(agnosai_task_dag_edges(dag), agnosai_edge_new(str_from(from), str_from(to)));
    return 0;
}

# The i-th key of a topological order, as a Str.
fn _t_at(order, i): i64 {
    return vec_get(order, i);
}

# Assert the i-th entry of an order is a given key.
fn _t_order_is(order, i, want, name): i64 {
    return assert(str_eq(_t_at(order, i), str_from(want)) == 1, name);
}

# A vec of the given tasks.
fn _t_vec2(a, b): i64 {
    var v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    return v;
}

fn main() {
    alloc_init();

    test_group("orch_scheduler");

    # =====================================================================
    # priority queue
    # =====================================================================

    # --- priority_ordering ---
    var s = agnosai_scheduler_new();
    assert_eq(agnosai_scheduler_is_empty(s), 1, "a new scheduler is empty");
    assert_eq(agnosai_scheduler_len(s), 0, "with no queued tasks");
    assert_eq(agnosai_scheduler_dequeue(s), 0, "and dequeues nothing");

    agnosai_scheduler_enqueue(s, _t_task("bg", AGNOSAI_PRIORITY_BACKGROUND));
    agnosai_scheduler_enqueue(s, _t_task("crit", AGNOSAI_PRIORITY_CRITICAL));
    agnosai_scheduler_enqueue(s, _t_task("norm", AGNOSAI_PRIORITY_NORMAL));
    agnosai_scheduler_enqueue(s, _t_task("high", AGNOSAI_PRIORITY_HIGH));
    agnosai_scheduler_enqueue(s, _t_task("low", AGNOSAI_PRIORITY_LOW));
    assert_eq(agnosai_scheduler_len(s), 5, "five tasks queued");
    assert_eq(agnosai_scheduler_is_empty(s), 0, "so not empty");

    assert(str_eq(agnosai_task_description(agnosai_scheduler_dequeue(s)), str_from("crit")) == 1,
    "Critical dequeues first");
    assert(str_eq(agnosai_task_description(agnosai_scheduler_dequeue(s)), str_from("high")) == 1,
    "then High");
    assert(str_eq(agnosai_task_description(agnosai_scheduler_dequeue(s)), str_from("norm")) == 1,
    "then Normal");
    assert(str_eq(agnosai_task_description(agnosai_scheduler_dequeue(s)), str_from("low")) == 1,
    "then Low");
    assert(str_eq(agnosai_task_description(agnosai_scheduler_dequeue(s)), str_from("bg")) == 1,
    "then Background");
    assert_eq(agnosai_scheduler_dequeue(s), 0, "and then nothing");
    assert_eq(agnosai_scheduler_is_empty(s), 1, "leaving it empty again");

    # --- fifo_within_same_priority ---
    var f = agnosai_scheduler_new();
    agnosai_scheduler_enqueue(f, _t_task("first", AGNOSAI_PRIORITY_NORMAL));
    agnosai_scheduler_enqueue(f, _t_task("second", AGNOSAI_PRIORITY_NORMAL));
    agnosai_scheduler_enqueue(f, _t_task("third", AGNOSAI_PRIORITY_NORMAL));
    assert(str_eq(agnosai_task_description(agnosai_scheduler_dequeue(f)), str_from("first")) == 1,
    "within a tier the order is FIFO");
    assert(str_eq(agnosai_task_description(agnosai_scheduler_dequeue(f)), str_from("second")) == 1,
    "second out is second in");
    assert(str_eq(agnosai_task_description(agnosai_scheduler_dequeue(f)), str_from("third")) == 1,
    "and third");

    # a lower tier does not jump a higher one queued later
    var g = agnosai_scheduler_new();
    agnosai_scheduler_enqueue(g, _t_task("bg-first", AGNOSAI_PRIORITY_BACKGROUND));
    agnosai_scheduler_enqueue(g, _t_task("crit-later", AGNOSAI_PRIORITY_CRITICAL));
    assert(str_eq(agnosai_task_description(agnosai_scheduler_dequeue(g)),
    str_from("crit-later")) == 1, "a Critical queued later still pre-empts a Background");

    # =====================================================================
    # topological_sort over a DAG
    # =====================================================================

    # --- topo_sort_chain ---
    var chain = _t_dag();
    _t_dag_add(chain, "a", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(chain, "b", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(chain, "c", AGNOSAI_PRIORITY_NORMAL);
    _t_edge(chain, "a", "b");
    _t_edge(chain, "b", "c");
    var chain_order = agnosai_scheduler_topological_sort(chain);
    assert(chain_order != 0, "an acyclic chain sorts");
    assert_eq(vec_len(chain_order), 3, "with every node present");
    _t_order_is(chain_order, 0, "a", "a comes first");
    _t_order_is(chain_order, 1, "b", "then b");
    _t_order_is(chain_order, 2, "c", "then c");

    # --- topo_sort_diamond ---
    # a -> b, a -> c, b -> d, c -> d. The middle wave is sorted, so b precedes c.
    var diamond = _t_dag();
    _t_dag_add(diamond, "a", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(diamond, "b", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(diamond, "c", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(diamond, "d", AGNOSAI_PRIORITY_NORMAL);
    _t_edge(diamond, "a", "b");
    _t_edge(diamond, "a", "c");
    _t_edge(diamond, "b", "d");
    _t_edge(diamond, "c", "d");
    var dia_order = agnosai_scheduler_topological_sort(diamond);
    assert(dia_order != 0, "a diamond sorts");
    assert_eq(vec_len(dia_order), 4, "with all four nodes");
    _t_order_is(dia_order, 0, "a", "the root first");
    _t_order_is(dia_order, 1, "b", "then b — successors are sorted, so b before c");
    _t_order_is(dia_order, 2, "c", "then c");
    _t_order_is(dia_order, 3, "d", "and the join last");

    # --- topo_sort_cycle_detected ---
    var cyc = _t_dag();
    _t_dag_add(cyc, "a", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(cyc, "b", AGNOSAI_PRIORITY_NORMAL);
    _t_edge(cyc, "a", "b");
    _t_edge(cyc, "b", "a");
    assert_eq(agnosai_scheduler_topological_sort(cyc), 0, "a two-node cycle is detected");

    var self_cyc = _t_dag();
    _t_dag_add(self_cyc, "a", AGNOSAI_PRIORITY_NORMAL);
    _t_edge(self_cyc, "a", "a");
    assert_eq(agnosai_scheduler_topological_sort(self_cyc), 0, "and so is a self-edge");

    # a cycle that does not include every node is still a cycle
    var partial = _t_dag();
    _t_dag_add(partial, "free", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(partial, "x", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(partial, "y", AGNOSAI_PRIORITY_NORMAL);
    _t_edge(partial, "x", "y");
    _t_edge(partial, "y", "x");
    assert_eq(agnosai_scheduler_topological_sort(partial), 0,
    "a cycle among a subset is still detected, since not every node can be consumed");

    # an empty DAG sorts to nothing rather than erroring
    var empty_dag = _t_dag();
    var empty_order = agnosai_scheduler_topological_sort(empty_dag);
    assert(empty_order != 0, "an empty DAG is acyclic");
    assert_eq(vec_len(empty_order), 0, "and sorts to an empty order");

    # unconnected nodes come back in sorted order — the initial seed is sorted
    var loose = _t_dag();
    _t_dag_add(loose, "zulu", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(loose, "alpha", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(loose, "mike", AGNOSAI_PRIORITY_NORMAL);
    var loose_order = agnosai_scheduler_topological_sort(loose);
    _t_order_is(loose_order, 0, "alpha", "unconnected nodes are seeded in sorted order");
    _t_order_is(loose_order, 1, "mike", "regardless of insertion order");
    _t_order_is(loose_order, 2, "zulu", "which is what makes the output reproducible");

    # ⚠ A WIDER version of the case above, added 2026-08-11 as the guard for
    # deleting the redundant pre-sort in `load_dag`/`topological_sort`.
    #
    # `agnosai_scheduler_kahn_sort` sorts the zero-in-degree seed itself
    # (`scheduler.cyr:169`) and sorts each successor list inside its loop
    # (`:180`), so the CALLER's key order cannot reach the output. The two
    # callers were nonetheless insertion-sorting every key first — dead work,
    # O(n^2), and the only thing that could have made it load-bearing is a case
    # like this one. Twelve roots inserted in descending order, so an
    # unsorted-seed regression would be visible at the very first element.
    var many = _t_dag();
    _t_dag_add(many, "l", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(many, "k", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(many, "j", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(many, "i", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(many, "h", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(many, "g", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(many, "f", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(many, "e", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(many, "d", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(many, "c", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(many, "b", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(many, "a", AGNOSAI_PRIORITY_NORMAL);
    var many_order = agnosai_scheduler_topological_sort(many);
    assert_eq(vec_len(many_order), 12, "twelve roots all sort");
    _t_order_is(many_order, 0, "a", "and come out ascending from the FIRST element");
    _t_order_is(many_order, 5, "f", "through the middle");
    _t_order_is(many_order, 11, "l", "to the last — insertion order was exactly reversed");

    # Roots AND dependents together: the seed is sorted, then each wave is
    # appended as its in-degree reaches zero. `m` and `n` both depend on `z`, so
    # they cannot appear before it however the keys arrive.
    var mixed = _t_dag();
    _t_dag_add(mixed, "z", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(mixed, "n", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(mixed, "m", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(mixed, "b", AGNOSAI_PRIORITY_NORMAL);
    _t_edge(mixed, "z", "m");
    _t_edge(mixed, "z", "n");
    var mixed_order = agnosai_scheduler_topological_sort(mixed);
    assert_eq(vec_len(mixed_order), 4, "the mixed DAG sorts");
    _t_order_is(mixed_order, 0, "b", "the sorted seed puts b before z");
    _t_order_is(mixed_order, 1, "z", "then z, the only other root");
    _t_order_is(mixed_order, 2, "m", "then z's successors, themselves sorted");
    _t_order_is(mixed_order, 3, "n", "m before n");

    # duplicate edges do not double-count the in-degree
    var dup = _t_dag();
    _t_dag_add(dup, "a", AGNOSAI_PRIORITY_NORMAL);
    _t_dag_add(dup, "b", AGNOSAI_PRIORITY_NORMAL);
    _t_edge(dup, "a", "b");
    _t_edge(dup, "a", "b");
    var dup_order = agnosai_scheduler_topological_sort(dup);
    assert(dup_order != 0, "a duplicated edge is not a cycle");
    assert_eq(vec_len(dup_order), 2,
    "because the adjacency is a set — a vec would leave b's in-degree at 1 forever");

    # --- kahn_sort directly, over hand-built adjacency ---
    # Exposed because the two sorts inside it are the whole reason the output is
    # reproducible, and driving it without a DAG makes the wave structure
    # visible: the seed is sorted, later waves are appended in the order their
    # in-degree reaches zero.
    var k_keys = vec_new();
    vec_push(k_keys, str_from("b"));
    vec_push(k_keys, str_from("a"));
    var k_dependents = map_new_str();
    var k_dependencies = map_new_str();
    map_set(k_dependents, str_from("a"), vec_new());
    map_set(k_dependents, str_from("b"), vec_new());
    map_set(k_dependencies, str_from("a"), vec_new());
    map_set(k_dependencies, str_from("b"), vec_new());
    var k_order = agnosai_scheduler_kahn_sort(k_keys, k_dependents, k_dependencies);
    assert(k_order != 0, "two unconnected nodes are acyclic");
    assert_eq(vec_len(k_order), 2, "and both are consumed");

    # a node whose in-degree never reaches zero is a cycle
    var c_keys = vec_new();
    vec_push(c_keys, str_from("x"));
    var c_dependents = map_new_str();
    var c_dependencies = map_new_str();
    var c_self = vec_new();
    vec_push(c_self, str_from("x"));
    map_set(c_dependents, str_from("x"), c_self);
    map_set(c_dependencies, str_from("x"), c_self);
    assert_eq(agnosai_scheduler_kahn_sort(c_keys, c_dependents, c_dependencies), 0,
    "a node depending on itself can never be consumed, so kahn_sort reports a cycle");

    # =====================================================================
    # load_dag and ready_tasks
    # =====================================================================

    # --- load_dag_rejects_cycle ---
    var sch = agnosai_scheduler_new();
    assert_eq(agnosai_scheduler_load_dag(sch, cyc), 0, "loading a cyclic DAG fails");
    assert_eq(vec_len(agnosai_scheduler_ready_tasks(sch, vec_new())), 0,
    "and leaves no DAG state behind");

    # --- ready_tasks_chain ---
    var chain_sch = agnosai_scheduler_new();
    assert_eq(agnosai_scheduler_load_dag(chain_sch, chain), 1, "an acyclic DAG loads");
    assert_eq(agnosai_scheduler_len(chain_sch), 0,
    "and does not touch the priority queues — the two modes are independent");

    var ready0 = agnosai_scheduler_ready_tasks(chain_sch, vec_new());
    assert_eq(vec_len(ready0), 1, "with nothing completed only the chain head is ready");
    assert(str_eq(agnosai_task_description(vec_get(ready0, 0)), str_from("a")) == 1, "which is a");

    var done_a = vec_new();
    vec_push(done_a, agnosai_task_id(map_get(agnosai_task_dag_tasks(chain), str_from("a"))));
    var ready1 = agnosai_scheduler_ready_tasks(chain_sch, done_a);
    assert_eq(vec_len(ready1), 1, "completing a unlocks exactly one task");
    assert(str_eq(agnosai_task_description(vec_get(ready1, 0)), str_from("b")) == 1, "namely b");

    var done_ab = vec_new();
    vec_push(done_ab, agnosai_task_id(map_get(agnosai_task_dag_tasks(chain), str_from("a"))));
    vec_push(done_ab, agnosai_task_id(map_get(agnosai_task_dag_tasks(chain), str_from("b"))));
    var ready2 = agnosai_scheduler_ready_tasks(chain_sch, done_ab);
    assert_eq(vec_len(ready2), 1, "and then c");
    assert(str_eq(agnosai_task_description(vec_get(ready2, 0)), str_from("c")) == 1, "is ready");

    # completing everything leaves nothing ready
    var done_abc = vec_new();
    vec_push(done_abc, agnosai_task_id(map_get(agnosai_task_dag_tasks(chain), str_from("a"))));
    vec_push(done_abc, agnosai_task_id(map_get(agnosai_task_dag_tasks(chain), str_from("b"))));
    vec_push(done_abc, agnosai_task_id(map_get(agnosai_task_dag_tasks(chain), str_from("c"))));
    assert_eq(vec_len(agnosai_scheduler_ready_tasks(chain_sch, done_abc)), 0,
    "a fully completed DAG has nothing ready");

    # --- ready_tasks_diamond ---
    var dia_sch = agnosai_scheduler_new();
    agnosai_scheduler_load_dag(dia_sch, diamond);
    var d_ready0 = agnosai_scheduler_ready_tasks(dia_sch, vec_new());
    assert_eq(vec_len(d_ready0), 1, "the diamond starts with one ready task");

    var d_done_a = vec_new();
    vec_push(d_done_a, agnosai_task_id(map_get(agnosai_task_dag_tasks(diamond), str_from("a"))));
    var d_ready1 = agnosai_scheduler_ready_tasks(dia_sch, d_done_a);
    assert_eq(vec_len(d_ready1), 2, "completing the root unlocks BOTH branches at once");

    # d is not ready until both branches finish
    var d_done_ab = vec_new();
    vec_push(d_done_ab, agnosai_task_id(map_get(agnosai_task_dag_tasks(diamond), str_from("a"))));
    vec_push(d_done_ab, agnosai_task_id(map_get(agnosai_task_dag_tasks(diamond), str_from("b"))));
    var d_ready2 = agnosai_scheduler_ready_tasks(dia_sch, d_done_ab);
    assert_eq(vec_len(d_ready2), 1, "with only one branch done, the join is not ready");
    assert(str_eq(agnosai_task_description(vec_get(d_ready2, 0)), str_from("c")) == 1,
    "only the other branch is");

    # --- ready_tasks_with_priority ---
    var prio = _t_dag();
    _t_dag_add(prio, "lo", AGNOSAI_PRIORITY_LOW);
    _t_dag_add(prio, "hi", AGNOSAI_PRIORITY_CRITICAL);
    _t_dag_add(prio, "mid", AGNOSAI_PRIORITY_NORMAL);
    var prio_sch = agnosai_scheduler_new();
    agnosai_scheduler_load_dag(prio_sch, prio);
    var p_ready = agnosai_scheduler_ready_tasks(prio_sch, vec_new());
    assert_eq(vec_len(p_ready), 3, "three independent tasks are all ready");
    assert_eq(agnosai_task_priority(vec_get(p_ready, 0)), AGNOSAI_PRIORITY_CRITICAL,
    "highest priority first");
    assert_eq(agnosai_task_priority(vec_get(p_ready, 1)), AGNOSAI_PRIORITY_NORMAL, "then normal");
    assert_eq(agnosai_task_priority(vec_get(p_ready, 2)), AGNOSAI_PRIORITY_LOW, "then low");

    # an unknown completed id is ignored rather than treated as a key
    var bogus = vec_new();
    vec_push(bogus, agnosai_uuid_to_str(agnosai_uuid_nil()));
    assert_eq(vec_len(agnosai_scheduler_ready_tasks(chain_sch, bogus)), 1,
    "a completed id that maps to no key is dropped, as the oracle's filter_map does");

    # =====================================================================
    # topological_sort_tasks over a task vec
    # =====================================================================

    # --- topo_sort_tasks_empty / single ---
    var empty_tasks = agnosai_topological_sort_tasks(vec_new());
    assert(empty_tasks != 0, "an empty task list is acyclic");
    assert_eq(vec_len(empty_tasks), 0, "and orders to nothing");

    var one = vec_new();
    vec_push(one, _t_task("only", AGNOSAI_PRIORITY_NORMAL));
    assert_eq(vec_len(agnosai_topological_sort_tasks(one)), 1, "a single task orders to itself");

    # --- topo_sort_tasks_linear_chain ---
    var t0 = _t_task("t0", AGNOSAI_PRIORITY_NORMAL);
    var t1 = _t_task("t1", AGNOSAI_PRIORITY_NORMAL);
    var t2 = _t_task("t2", AGNOSAI_PRIORITY_NORMAL);
    agnosai_task_with_dependency(t1, agnosai_task_id(t0));
    agnosai_task_with_dependency(t2, agnosai_task_id(t1));
    var lin = vec_new();
    vec_push(lin, t2);
    vec_push(lin, t1);
    vec_push(lin, t0);
    var lin_order = agnosai_topological_sort_tasks(lin);
    assert(lin_order != 0, "a linear chain orders");
    assert_eq(vec_len(lin_order), 3, "with every task");
    assert(str_eq(vec_get(lin_order, 0), agnosai_task_id(t0)) == 1,
    "the dependency-free task first, regardless of input order");
    assert(str_eq(vec_get(lin_order, 1), agnosai_task_id(t1)) == 1,
    "then its dependent");
    assert(str_eq(vec_get(lin_order, 2), agnosai_task_id(t2)) == 1,
    "then the last");

    # --- topo_sort_tasks_cycle_detected ---
    var c0 = _t_task("c0", AGNOSAI_PRIORITY_NORMAL);
    var c1 = _t_task("c1", AGNOSAI_PRIORITY_NORMAL);
    agnosai_task_with_dependency(c0, agnosai_task_id(c1));
    agnosai_task_with_dependency(c1, agnosai_task_id(c0));
    assert_eq(agnosai_topological_sort_tasks(_t_vec2(c0, c1)), 0,
    "a mutual dependency is detected as a cycle");

    # --- topo_sort_tasks_independent ---
    var i0 = _t_task("i0", AGNOSAI_PRIORITY_NORMAL);
    var i1 = _t_task("i1", AGNOSAI_PRIORITY_NORMAL);
    assert_eq(vec_len(agnosai_topological_sort_tasks(_t_vec2(i0, i1))), 2,
    "independent tasks all order");

    # --- topo_sort_tasks_respects_priority ---
    var p0 = _t_task("p0", AGNOSAI_PRIORITY_BACKGROUND);
    var p1 = _t_task("p1", AGNOSAI_PRIORITY_CRITICAL);
    var p2 = _t_task("p2", AGNOSAI_PRIORITY_NORMAL);
    var ptasks = vec_new();
    vec_push(ptasks, p0);
    vec_push(ptasks, p1);
    vec_push(ptasks, p2);
    var p_order = agnosai_topological_sort_tasks(ptasks);
    assert(str_eq(vec_get(p_order, 0), agnosai_task_id(p1)) == 1, "Critical orders first");
    assert(str_eq(vec_get(p_order, 1), agnosai_task_id(p2)) == 1, "then Normal");
    assert(str_eq(vec_get(p_order, 2), agnosai_task_id(p0)) == 1, "then Background");

    # a dependency naming a task OUTSIDE the input is ignored, not unsatisfiable
    var lone = _t_task("lone", AGNOSAI_PRIORITY_NORMAL);
    agnosai_task_with_dependency(lone, agnosai_uuid_to_str(agnosai_uuid_nil()));
    var lone_v = vec_new();
    vec_push(lone_v, lone);
    var lone_order = agnosai_topological_sort_tasks(lone_v);
    assert(lone_order != 0,
    "a dependency on a task not in the set is ignored, so this is not a cycle");
    assert_eq(vec_len(lone_order), 1, "and the task is ready immediately");

    # priority is respected only among tasks that are actually ready
    var d0 = _t_task("d0", AGNOSAI_PRIORITY_CRITICAL);
    var d1 = _t_task("d1", AGNOSAI_PRIORITY_BACKGROUND);
    agnosai_task_with_dependency(d0, agnosai_task_id(d1));
    var dep_order = agnosai_topological_sort_tasks(_t_vec2(d0, d1));
    assert(str_eq(vec_get(dep_order, 0), agnosai_task_id(d1)) == 1,
    "a Background task blocking a Critical one still orders first — dependencies outrank priority");
    assert(str_eq(vec_get(dep_order, 1), agnosai_task_id(d0)) == 1, "and the Critical follows");

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
