# =========================================================================
# tools_native.tcyr — parity tests for src/tools/native.cyr and
# src/tools/registry.cyr
#
# Oracle: the #[cfg(test)] blocks in rust-old/src/tools/native.rs and
# rust-old/src/tools/registry.rs.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/id.cyr"
# telemetry — `tools/native` and `orchestrator/crew_runner` record GenAI
# spans (ADR 017), so every suite that reaches them needs the module that
# defines the recorder. It depends on nothing in `src/` except `id`.
include "src/telemetry/mod.cyr"
include "src/core/error.cyr"
include "src/core/json.cyr"
include "src/tools/native.cyr"
include "src/tools/registry.cyr"
include "tests/test_helpers.cyr"

# A stateless echo tool: returns its "text" parameter, or an error when absent.
#
# **`schema_fp` is `fn(a, ctx)` — allocator first.** A test tool declaring the
# old one-parameter shape still compiles and still passes, because `callptr`
# does not check arity: `ctx` silently receives the allocator and the real ctx
# is dropped. That is fine for a schema ignoring `ctx` and wrong the moment one
# does not, so both test tools here take the allocator whether they use it or
# not.
fn _t_echo_schema(a, ctx): i64 {
    var s = agnosai_tool_schema_new_a(a, str_from_a(a, "echo"),
      str_from_a(a, "Echo the input back"));
    agnosai_tool_schema_param_a(a, s, str_from_a(a, "text"), str_from_a(a, "text to echo"),
      str_from_a(a, "string"), 1);
    return s;
}

fn _t_echo_execute(ctx, input): i64 {
    var text = agnosai_tool_input_get_str(input, str_from("text"));
    if (text == 0) { return agnosai_tool_output_err(str_from("missing required parameter: text")); }
    return agnosai_tool_output_ok(bayan_json_v_str_new(text));
}

fn _t_echo_tool(): i64 {
    return agnosai_tool_new(str_from("echo"), str_from("Echo the input back"),
      &_t_echo_schema, &_t_echo_execute, 0);
}

# A stateful counter tool, to prove `ctx` reaches the implementation.
fn _t_counter_schema(a, ctx): i64 {
    return agnosai_tool_schema_new_a(a, str_from_a(a, "counter"),
      str_from_a(a, "Count calls"));
}

fn _t_counter_execute(ctx, input): i64 {
    store64(ctx, load64(ctx) + 1);
    return agnosai_tool_output_ok(bayan_json_v_int_new(load64(ctx)));
}

fn _t_counter_tool(ctx): i64 {
    return agnosai_tool_new(str_from("counter"), str_from("Count calls"),
      &_t_counter_schema, &_t_counter_execute, ctx);
}

# A vec of Str, for allow-list tests.
fn _t_names(a, b): i64 {
    var v = vec_new();
    if (a != 0) { vec_push(v, a); }
    if (b != 0) { vec_push(v, b); }
    return v;
}

fn _t_tn_schema_fp(ctx): i64 {
    return agnosai_tool_schema_new(str_from("t"), str_from("d"));
}

fn _t_tn_exec_fp(ctx, input): i64 {
    return agnosai_tool_output_ok(bayan_json_v_null());
}

# The `_a` forms, named directly.
#
# Each is reached through its bare twin, so the behaviour is covered — but
# reference coverage counts the SYMBOL, and an indirectly-used public fn reads
# as dead. Asserted the way the rest of the arena work is: byte-identical wire
# between the two paths.
fn _t_tn_a_forms(): i64 {
    var ar = arena_allocator(16384);
    var s = agnosai_tool_schema_new(str_from("t"), str_from("d"));
    agnosai_tool_schema_param(s, str_from("p"), str_from("pd"), str_from("string"), 1);

    assert(str_eq(bayan_json_v_build(agnosai_tool_schema_to_value(s)),
        bayan_json_v_build(agnosai_tool_schema_to_value_a(ar, s))) == 1,
      "tool_schema_to_value_a emits byte-identical JSON to the global form");

    var p0 = vec_get(agnosai_tool_schema_parameters(s), 0);
    assert(str_eq(bayan_json_v_build(agnosai_param_schema_to_value(p0)),
        bayan_json_v_build(agnosai_param_schema_to_value_a(ar, p0))) == 1,
      "...and so does param_schema_to_value_a");

    var o = agnosai_tool_output_ok(bayan_json_v_int_new(7));
    assert(str_eq(bayan_json_v_build(agnosai_tool_output_to_value(o)),
        bayan_json_v_build(agnosai_tool_output_to_value_a(ar, o))) == 1,
      "...and tool_output_to_value_a");

    # A locally-built tool, not a builtin — this suite deliberately includes
    # only native + registry, and pulling in `builtin/basic` to get one would
    # widen its scope for a coverage reference.
    var reg = agnosai_tool_registry_new();
    agnosai_tool_registry_register(reg, agnosai_tool_new(str_from("t"), str_from("d"),
        &_t_tn_schema_fp, &_t_tn_exec_fp, 0));
    assert(vec_len(agnosai_tool_registry_list_a(ar, reg)) == 1,
      "registry_list_a walks slots through the arena");
    return 0;
}

# --- Oracle: `concurrent_access` (registry.rs:163-195) --------------------
#
# ⚠ **The one behaviour the oracle pins that nothing here exercised.** The
# oracle got no-lost-updates from `DashMap`; the port replaced it with a hashmap
# behind a futex mutex and the module header calls that mutex mandatory, because
# `sandhi_server_run_pooled` makes every worker a real OS thread. Until
# 2026-08-13 no test drove the registry from more than one thread, so the mutex
# could have been removed entirely with the suite green.
#
# Shaped like the oracle's: 20 workers alternating register/list/get/has/count,
# both tools registered at the end, and a count of exactly 2 — registering the
# same name twice must replace, not duplicate. The two tools are built locally
# rather than pulled from `builtin/basic`, for the same reason the rest of this
# suite does: including a builtin to get a fixture would widen the file's
# coverage reference.
var _T_REG_THREADS = 20;
var _T_REG_PER_THREAD = 50;
var _t_reg_shared = 0;

fn _t_reg_worker(id): i64 {
    if (id % 2 == 0) {
        agnosai_tool_registry_register(_t_reg_shared, agnosai_tool_new(str_from("alpha"),
            str_from("d"), &_t_tn_schema_fp, &_t_tn_exec_fp, 0));
    } else {
        agnosai_tool_registry_register(_t_reg_shared, agnosai_tool_new(str_from("beta"),
            str_from("d"), &_t_tn_schema_fp, &_t_tn_exec_fp, 0));
    }
    # Concurrent reads while the writes above are in flight.
    agnosai_tool_registry_list(_t_reg_shared);
    agnosai_tool_registry_get(_t_reg_shared, str_from("alpha"));
    agnosai_tool_registry_has(_t_reg_shared, str_from("beta"));
    agnosai_tool_registry_count(_t_reg_shared);
    return 0;
}

# Each worker owns a disjoint name range, so a lost update is a count shortfall
# rather than a value that happens to converge.
fn _t_reg_disjoint_worker(id): i64 {
    for (var i = 0; i < _T_REG_PER_THREAD; i = i + 1) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "w");
        str_builder_add_int(sb, id);
        str_builder_add_cstr(sb, "-");
        str_builder_add_int(sb, i);
        var nm = str_builder_build(sb);
        agnosai_tool_registry_register(_t_reg_shared, agnosai_tool_new(nm, nm,
            &_t_tn_schema_fp, &_t_tn_exec_fp, 0));
    }
    return 0;
}

fn _t_registry_concurrent_access(): i64 {
    _t_reg_shared = agnosai_tool_registry_new();
    var threads = vec_new();
    for (var t = 0; t < _T_REG_THREADS; t = t + 1) {
        var h = thread_create(&_t_reg_worker, t);
        if (h == 0) { _t_reg_worker(t); } else { vec_push(threads, h); }
    }
    for (var j = 0; j < vec_len(threads); j = j + 1) { thread_join(vec_get(threads, j)); }

    assert_eq(agnosai_tool_registry_has(_t_reg_shared, str_from("alpha")), 1,
      "alpha is registered after 20 concurrent workers");
    assert_eq(agnosai_tool_registry_has(_t_reg_shared, str_from("beta")), 1,
      "and so is beta");
    assert_eq(agnosai_tool_registry_count(_t_reg_shared), 2,
      "exactly 2 — re-registering a name REPLACES, so 20 writers leave 2 entries");
    assert_eq(vec_len(agnosai_tool_registry_list(_t_reg_shared)), 2,
      "and the snapshot agrees, so no torn entry survived the race");

    # ⚠ **The oracle's shape alone CANNOT detect a lost update, and neither
    # could this until the disjoint pass below.** Twenty writers contending over
    # two names converge on the same final state whether or not the map is
    # guarded — mutation-verified: commenting out every `mutex_lock`/`unlock` in
    # `registry.cyr` left the assertions above green across five runs. A lost
    # update is only visible when each writer owns keys nobody else writes, so
    # the shortfall shows up in the count. Same construction as
    # `_t_definitions_concurrent_inserts` in `tests/server_state.tcyr`.
    _t_reg_shared = agnosai_tool_registry_new();
    var dthreads = vec_new();
    for (var d = 0; d < _T_REG_THREADS; d = d + 1) {
        var dh = thread_create(&_t_reg_disjoint_worker, d);
        if (dh == 0) { _t_reg_disjoint_worker(d); } else { vec_push(dthreads, dh); }
    }
    for (var k = 0; k < vec_len(dthreads); k = k + 1) { thread_join(vec_get(dthreads, k)); }

    var want = _T_REG_THREADS * _T_REG_PER_THREAD;
    assert_eq(agnosai_tool_registry_count(_t_reg_shared), want,
      "every concurrent registration landed — a shortfall here is a lost update");
    assert_eq(vec_len(agnosai_tool_registry_list(_t_reg_shared)), want,
      "and the snapshot agrees");
    assert_eq(agnosai_tool_registry_has(_t_reg_shared, str_from("w0-0")), 1,
      "the first worker's first tool is present, not merely the right count");
    return 0;
}

fn main() {
    _t_registry_concurrent_access();
    _t_tn_a_forms();
    alloc_init();

    test_group("tools_native");

    # --- tool_output_ok_has_correct_fields ---
    var ok = agnosai_tool_output_ok(bayan_json_v_int_new(42));
    assert_eq(agnosai_tool_output_success(ok), 1, "ok output succeeds");
    assert_eq(bayan_json_v_int(agnosai_tool_output_result(ok)), 42, "ok output carries the result");
    assert_eq(agnosai_tool_output_error(ok), 0, "ok output has no error");

    # --- tool_output_err_has_correct_fields ---
    var bad = agnosai_tool_output_err(str_from("something broke"));
    assert_eq(agnosai_tool_output_success(bad), 0, "err output fails");
    assert_eq(bayan_json_v_is_null(agnosai_tool_output_result(bad)), 1, "err output result is null");
    assert(str_eq(agnosai_tool_output_error(bad), str_from("something broke")) == 1,
      "err output carries the message");

    # error is omitted, not null, when absent — a wire-visible distinction
    assert_eq(bayan_json_v_obj_get(agnosai_tool_output_to_value(ok), "error"), 0,
      "a successful output omits the error field");
    assert(bayan_json_v_obj_get(agnosai_tool_output_to_value(bad), "error") != 0,
      "a failed output emits the error field");

    # --- tool_input_get_str: missing, wrong type, present ---
    var empty = agnosai_tool_input_new();
    assert_eq(agnosai_tool_input_get_str(empty, str_from("missing")), 0,
      "get_str returns none for a missing key");

    var typed = agnosai_tool_input_new();
    agnosai_tool_input_set(typed, str_from("count"), bayan_json_v_int_new(42));
    assert_eq(agnosai_tool_input_get_str(typed, str_from("count")), 0,
      "get_str returns none for a wrong-typed value rather than coercing");

    var named = agnosai_tool_input_new();
    agnosai_tool_input_set(named, str_from("name"), bayan_json_v_str_new(str_from("alice")));
    assert(str_eq(agnosai_tool_input_get_str(named, str_from("name")), str_from("alice")) == 1,
      "get_str returns the value");

    # --- tool_input_get_f64 accepts floats and ints, as serde's as_f64 does ---
    var found: i64[1];
    var ratio = agnosai_tool_input_new();
    agnosai_tool_input_set(ratio, str_from("ratio"),
      bayan_json_v_float_new(f64_div(f64_from(3), f64_from(2))));
    _t_assert_f64(agnosai_tool_input_get_f64(ratio, str_from("ratio"), &found),
      f64_div(f64_from(3), f64_from(2)), "get_f64 returns a float value");
    assert_eq(load64(&found), 1, "get_f64 reports found");

    agnosai_tool_input_set(ratio, str_from("n"), bayan_json_v_int_new(7));
    _t_assert_f64(agnosai_tool_input_get_f64(ratio, str_from("n"), &found), f64_from(7),
      "get_f64 widens an integer");
    agnosai_tool_input_get_f64(ratio, str_from("nope"), &found);
    assert_eq(load64(&found), 0, "get_f64 reports not-found for a missing key");

    # --- get_int rejects a float rather than truncating ---
    assert_eq(agnosai_tool_input_get_int(ratio, str_from("n")), 7, "get_int returns an integer");
    assert_eq(agnosai_tool_input_get_int(ratio, str_from("ratio")), AGNOSAI_NO_LIMIT,
      "get_int rejects a float rather than silently truncating it");
    # ⚠ **A NEGATIVE reads as absent** — the oracle's `as_u64` is unsigned, so
    # `Some(-5)` is `None`, pinned by its own
    # `tool_input_get_u64_returns_none_for_negative` (`native.rs:190`). The port
    # passed every negative through as a real value, and `-1` only looked right
    # because it collides with the `AGNOSAI_NO_LIMIT` sentinel. It reached the
    # wire: `synapse_infer` sent `"max_tokens": -5` where the oracle omits the
    # key, `mneme_search` sent `&limit=-5` where the oracle sends its default.
    agnosai_tool_input_set(ratio, str_from("neg"), bayan_json_v_int_new(0 - 5));
    assert_eq(agnosai_tool_input_get_int(ratio, str_from("neg")), AGNOSAI_NO_LIMIT,
      "a negative integer reads as ABSENT, not as -5");
    agnosai_tool_input_set(ratio, str_from("negbig"), bayan_json_v_int_new(0 - 999999));
    assert_eq(agnosai_tool_input_get_int(ratio, str_from("negbig")), AGNOSAI_NO_LIMIT,
      "and so does a large negative");
    agnosai_tool_input_set(ratio, str_from("zero"), bayan_json_v_int_new(0));
    assert_eq(agnosai_tool_input_get_int(ratio, str_from("zero")), 0,
      "but ZERO is a real value — `as_u64` accepts it, and the sentinel is -1");

    assert_eq(agnosai_tool_input_get_int(ratio, str_from("missing")), AGNOSAI_NO_LIMIT,
      "get_int returns no-limit for a missing key");

    # --- input round-trips through a bayan object ---
    var from_v = agnosai_tool_input_from_value(
      bayan_json_v_parse_buf(str_data(str_from("{\"a\":1,\"b\":\"x\"}")),
        str_len(str_from("{\"a\":1,\"b\":\"x\"}"))));
    assert_eq(map_size(agnosai_tool_input_parameters(from_v)), 2, "input built from a JSON object");
    assert_eq(agnosai_tool_input_get_int(from_v, str_from("a")), 1, "parsed int parameter");
    assert(str_eq(agnosai_tool_input_get_str(from_v, str_from("b")), str_from("x")) == 1,
      "parsed string parameter");

    # --- schemas ---
    var schema = agnosai_tool_schema_new(str_from("t"), str_from("d"));
    agnosai_tool_schema_param(schema, str_from("p"), str_from("pd"), str_from("string"), 1);
    agnosai_tool_schema_with_param(schema,
      agnosai_param_schema_new(str_from("q"), str_from("qd"), str_from("number"), 0));
    assert_eq(vec_len(agnosai_tool_schema_parameters(schema)), 2, "two parameters on the schema");
    assert(str_eq(agnosai_tool_schema_name(schema), str_from("t")) == 1, "schema name");
    assert(str_eq(agnosai_tool_schema_description(schema), str_from("d")) == 1, "schema description");

    var p0 = vec_get(agnosai_tool_schema_parameters(schema), 0);
    assert(str_eq(agnosai_param_schema_name(p0), str_from("p")) == 1, "parameter name");
    assert(str_eq(agnosai_param_schema_description(p0), str_from("pd")) == 1, "parameter description");
    assert(str_eq(agnosai_param_schema_type(p0), str_from("string")) == 1, "parameter type");
    assert_eq(agnosai_param_schema_required(p0), 1, "parameter required flag");
    assert_eq(agnosai_param_schema_required(vec_get(agnosai_tool_schema_parameters(schema), 1)), 0,
      "optional parameter");

    var pv = agnosai_param_schema_to_value(p0);
    assert(str_eq(bayan_json_v_obj_key(pv, 0), str_from("name")) == 1, "parameter field 0 is name");
    assert(str_eq(bayan_json_v_str(bayan_json_v_obj_get(pv, "param_type")), str_from("string")) == 1,
      "parameter serializes its type");
    assert_eq(bayan_json_v_bool(bayan_json_v_obj_get(pv, "required")), 1,
      "parameter serializes required as a JSON bool");

    var sv = agnosai_tool_schema_to_value(schema);
    assert(str_eq(bayan_json_v_obj_key(sv, 0), str_from("name")) == 1, "schema field 0 is name");
    assert_eq(bayan_json_v_arr_len(bayan_json_v_obj_get(sv, "parameters")), 2,
      "schema serializes both parameters");

    # --- the vtable dispatches to the implementation ---
    var echo = _t_echo_tool();
    assert(str_eq(agnosai_tool_name(echo), str_from("echo")) == 1, "tool name");
    assert(str_eq(agnosai_tool_description(echo), str_from("Echo the input back")) == 1,
      "tool description");
    assert(str_eq(agnosai_tool_schema_name(agnosai_tool_schema(echo)), str_from("echo")) == 1,
      "schema_fp dispatches through the vtable");

    var echo_in = agnosai_tool_input_new();
    agnosai_tool_input_set(echo_in, str_from("text"), bayan_json_v_str_new(str_from("hi")));
    var echo_out = agnosai_tool_execute(echo, echo_in);
    assert_eq(agnosai_tool_output_success(echo_out), 1, "execute_fp dispatches and succeeds");
    assert(str_eq(bayan_json_v_str(agnosai_tool_output_result(echo_out)), str_from("hi")) == 1,
      "the tool echoed its input");

    var missing_out = agnosai_tool_execute(echo, agnosai_tool_input_new());
    assert_eq(agnosai_tool_output_success(missing_out), 0, "a missing required parameter fails");
    assert(agnosai_tool_output_error(missing_out) != 0, "the failure carries a message");

    # --- ctx reaches the implementation and persists across calls ---
    var counter_ctx = alloc(8);
    store64(counter_ctx, 0);
    var counter = _t_counter_tool(counter_ctx);
    assert_eq(agnosai_tool_ctx(counter), counter_ctx, "the tool carries its ctx");
    agnosai_tool_execute(counter, agnosai_tool_input_new());
    agnosai_tool_execute(counter, agnosai_tool_input_new());
    var third = agnosai_tool_execute(counter, agnosai_tool_input_new());
    assert_eq(bayan_json_v_int(agnosai_tool_output_result(third)), 3,
      "ctx state persists across executions");

    # =============================================================
    test_group("tools_registry");

    var reg = agnosai_tool_registry_new();
    assert_eq(agnosai_tool_registry_count(reg), 0, "a new registry is empty");
    assert_eq(agnosai_tool_registry_get(reg, str_from("echo")), 0, "lookup misses on an empty registry");
    assert_eq(agnosai_tool_registry_has(reg, str_from("echo")), 0, "has is false on an empty registry");

    agnosai_tool_registry_register(reg, echo);
    assert_eq(agnosai_tool_registry_count(reg), 1, "one tool registered");
    assert_eq(agnosai_tool_registry_has(reg, str_from("echo")), 1, "has finds the tool");
    assert_eq(agnosai_tool_registry_get(reg, str_from("echo")), echo, "get returns the tool");
    assert_eq(agnosai_tool_registry_get(reg, str_from("nope")), 0, "get misses an unknown name");

    # re-registering the same name replaces rather than duplicating — and the
    # registry then hands back the REPLACEMENT, not the original
    var echo2 = _t_echo_tool();
    agnosai_tool_registry_register(reg, echo2);
    assert_eq(agnosai_tool_registry_count(reg), 1, "re-registering the same name replaces it");
    assert_eq(agnosai_tool_registry_get(reg, str_from("echo")), echo2,
      "lookup returns the replacement, not the original");

    agnosai_tool_registry_register(reg, counter);
    assert_eq(agnosai_tool_registry_count(reg), 2, "a second tool registers alongside");
    assert_eq(vec_len(agnosai_tool_registry_names(reg)), 2, "names lists both tools");
    assert_eq(vec_len(agnosai_tool_registry_list(reg)), 2, "list returns both schemas");

    # --- remove ---
    assert_eq(agnosai_tool_registry_remove(reg, str_from("counter")), 1, "remove reports it was present");
    assert_eq(agnosai_tool_registry_count(reg), 1, "remove drops the tool");
    assert_eq(agnosai_tool_registry_remove(reg, str_from("counter")), 0,
      "removing an absent tool reports false");

    # --- is_tool_allowed: an EMPTY list means no restriction ---
    assert_eq(agnosai_is_tool_allowed(str_from("echo"), vec_new()), 1,
      "an empty allow-list permits everything");
    assert_eq(agnosai_is_tool_allowed(str_from("echo"), _t_names(str_from("echo"), 0)), 1,
      "a listed tool is permitted");
    assert_eq(agnosai_is_tool_allowed(str_from("echo"), _t_names(str_from("other"), 0)), 0,
      "an unlisted tool is denied");
    assert_eq(agnosai_is_tool_allowed(str_from("echo"),
        _t_names(str_from("other"), str_from("echo"))), 1, "a tool later in the list is permitted");

    # a prefix of a listed name is NOT permitted — matching is exact
    assert_eq(agnosai_is_tool_allowed(str_from("ech"), _t_names(str_from("echo"), 0)), 0,
      "allow-list matching is exact, not prefix-based");

    # --- get_allowed enforces the list ---
    assert_eq(agnosai_tool_registry_get_allowed(reg, str_from("echo"), vec_new()), echo2,
      "an empty allow-list lets the lookup through");
    assert_eq(agnosai_tool_registry_get_allowed(reg, str_from("echo"),
        _t_names(str_from("echo"), 0)), echo2, "a permitted tool resolves");
    assert_eq(agnosai_tool_registry_get_allowed(reg, str_from("echo"),
        _t_names(str_from("other"), 0)), 0, "a denied tool resolves to 0");
    assert_eq(agnosai_tool_registry_get_allowed(reg, str_from("ghost"),
        _t_names(str_from("ghost"), 0)), 0, "a permitted but unregistered tool resolves to 0");

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
