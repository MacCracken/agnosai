# =========================================================================
# sandbox_spawn — tests for src/sandbox/spawn.cyr.
#
# **No oracle tests exist for any of this.** In Rust the work is
# `Command::env_remove` plus tokio's `Stdio` and `kill_on_drop`, and the
# roadmap's "Carried over from the Rust line" table already records env
# sanitization as an area `rust-old` never tested. It is a security control, so
# it is tested here.
#
# The exec-errno pipe is exercised for real by the later spawn sub-bites; what
# is asserted here is the piece that needs no fork.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/core/mod.cyr"
include "src/sandbox/mod.cyr"
include "tests/test_helpers.cyr"

# --- Entry name parsing --------------------------------------------------

# Matching is on the NAME, and the name is everything before the first `=`.
fn _t_sp_entry_name(): i64 {
    assert(agnosai_env_entry_is_sanitized("LD_PRELOAD=/tmp/evil.so") == 1,
    "a sanitized variable is caught by its NAME, with a value attached");
    assert(agnosai_env_entry_is_sanitized("LD_LIBRARY_PATH=/x") == 1, "LD_LIBRARY_PATH");
    assert(agnosai_env_entry_is_sanitized("DYLD_INSERT_LIBRARIES=/y") == 1,
    "DYLD_INSERT_LIBRARIES — stripped on Linux too");
    assert(agnosai_env_entry_is_sanitized("DYLD_LIBRARY_PATH=/z") == 1, "DYLD_LIBRARY_PATH");

    assert(agnosai_env_entry_is_sanitized("PATH=/usr/bin") == 0, "PATH survives");
    assert(agnosai_env_entry_is_sanitized("HOME=/root") == 0, "so does HOME");

    # **The value must not participate.** A variable whose VALUE mentions
    # LD_PRELOAD is not the variable LD_PRELOAD — testing the whole entry would
    # drop innocent variables, and would let attacker-supplied data steer which
    # variables the filter removes.
    assert(agnosai_env_entry_is_sanitized("NOTES=see LD_PRELOAD docs") == 0,
    "a value MENTIONING a sanitized name is not itself sanitized");
    assert(agnosai_env_entry_is_sanitized("CFLAGS=-DLD_PRELOAD=1") == 0,
    "...even when it looks like an assignment");

    # Prefix and suffix are not matches — the loader reads exact names.
    assert(agnosai_env_entry_is_sanitized("LD_PRELOAD_EXTRA=/x") == 0, "no prefix matching");
    assert(agnosai_env_entry_is_sanitized("MY_LD_PRELOAD=/x") == 0, "no suffix matching");

    # A malformed entry with no `=` is still testable, not silently passed.
    assert(agnosai_env_entry_is_sanitized("LD_PRELOAD") == 1,
    "an entry with NO '=' is matched whole — it is not waved through");
    assert(agnosai_env_entry_is_sanitized("HARMLESS") == 0, "...and an innocent one still passes");

    assert(agnosai_env_entry_is_sanitized(0) == 0, "a null entry is not a variable");
    assert(agnosai_env_entry_is_sanitized("") == 0, "nor an empty one");
    assert(agnosai_env_entry_is_sanitized("=value") == 0, "nor one with an empty name");
    return 0;
}

# --- Explicit envp -------------------------------------------------------

fn _t_sp_envp_from(): i64 {
    var e = vec_new();
    vec_push(e, str_from("PATH=/usr/bin"));
    vec_push(e, str_from("LD_PRELOAD=/tmp/evil.so"));
    vec_push(e, str_from("HOME=/root"));
    vec_push(e, str_from("DYLD_INSERT_LIBRARIES=/tmp/e.dylib"));

    var envp = agnosai_sanitized_envp_from(e);
    assert(agnosai_envp_len(envp) == 2, "two of four entries survive");
    assert(agnosai_envp_has(envp, str_from("PATH")) == 1, "PATH is kept");
    assert(agnosai_envp_has(envp, str_from("HOME")) == 1, "HOME is kept");

    # **The filter applies to an explicitly supplied environment too.** A
    # sanitizer covering only the inherited case is one an attacker routes
    # around by passing the variable instead.
    assert(agnosai_envp_has(envp, str_from("LD_PRELOAD")) == 0,
    "LD_PRELOAD is removed even when the CALLER supplied it, not the parent env");
    assert(agnosai_envp_has(envp, str_from("DYLD_INSERT_LIBRARIES")) == 0, "and DYLD_ too");

    # NULL-terminated, so execve can walk it.
    assert(load64(envp + 2 * 8) == 0, "the array is NULL-terminated");

    # An all-sanitized input yields an empty but valid envp, never 0.
    var bad = vec_new();
    vec_push(bad, str_from("LD_PRELOAD=/a"));
    vec_push(bad, str_from("LD_LIBRARY_PATH=/b"));
    var only = agnosai_sanitized_envp_from(bad);
    assert(only != 0, "an all-sanitized environment still yields an ARRAY, not 0");
    assert(agnosai_envp_len(only) == 0, "...an empty one");
    assert(load64(only) == 0, "...that is properly terminated");

    var none = agnosai_sanitized_envp_from(vec_new());
    assert(agnosai_envp_len(none) == 0, "an empty input is an empty envp");
    return 0;
}

# --- Inherited envp ------------------------------------------------------

# The real parent environment, filtered. This process has a PATH, so the
# positive half is checkable without constructing anything.
fn _t_sp_envp_inherited(): i64 {
    var envp = agnosai_sanitized_envp();
    assert(envp != 0, "an envp is always returned, never 0");

    # None of the four may survive, whatever this environment happens to hold.
    assert(agnosai_envp_has(envp, str_from("LD_PRELOAD")) == 0, "no LD_PRELOAD reaches a child");
    assert(agnosai_envp_has(envp, str_from("LD_LIBRARY_PATH")) == 0, "no LD_LIBRARY_PATH");
    assert(agnosai_envp_has(envp, str_from("DYLD_INSERT_LIBRARIES")) == 0, "no DYLD_INSERT_LIBRARIES");
    assert(agnosai_envp_has(envp, str_from("DYLD_LIBRARY_PATH")) == 0, "no DYLD_LIBRARY_PATH");

    # And the filter is subtractive, not a wipe — an ordinary variable survives.
    assert(agnosai_envp_has(envp, str_from("PATH")) == 1,
    "PATH survives — the filter removes four names, it does not empty the environment");

    var i = 0;
    while (load64(envp + i * 8) != 0) {
        assert(agnosai_env_entry_is_sanitized(load64(envp + i * 8)) == 0,
        "every surviving entry passes the filter it was filtered by");
        i = i + 1;
    }
    return 0;
}

# --- CLOEXEC -------------------------------------------------------------

# The bit the exec-errno pipe is built on. Marking must succeed on a real fd and
# fail on a bogus one — a version that reported success either way would make
# every spawn hang rather than report.
fn _t_sp_cloexec(): i64 {
    var fds[8];
    assert(sys_pipe(&fds) >= 0, "a pipe opens");
    var rfd = load32(&fds);
    var wfd = load32(&fds + 4);

    assert(agnosai_fd_set_cloexec(wfd) == 1, "the write end is marked close-on-exec");
    # F_GETFD = 1; the flag must actually be set, not merely reported.
    assert((syscall(SYS_FCNTL, wfd, 1, 0) & AGNOSAI_FD_CLOEXEC) == AGNOSAI_FD_CLOEXEC,
    "...and reading the flags back confirms it — the syscall did the thing");

    sys_close(rfd);
    sys_close(wfd);

    assert(agnosai_fd_set_cloexec(0 - 1) == 0,
    "marking a bogus fd REPORTS failure — silently succeeding would hang every spawn");
    return 0;
}

# --- Spawn ---------------------------------------------------------------

# Spawn `/bin/sh -c <script>` and hand back the result.
fn _t_sh(script): i64 {
    var argv = alloc(32);
    store64(argv, "/bin/sh");
    store64(argv + 8, "-c");
    store64(argv + 16, script);
    store64(argv + 24, 0);
    return agnosai_spawn_capture("/bin/sh", argv, agnosai_sanitized_envp(), AGNOSAI_SPAWN_NO_TIMEOUT, 0);
}

fn _t_sp_capture_basics(): i64 {
    var r = _t_sh("echo hello; echo oops >&2; exit 3");
    assert(agnosai_spawn_status(r) == AGNOSAI_SPAWN_OK, "a real program spawns");
    assert(agnosai_spawn_exit_code(r) == 3, "its exit code comes back");
    assert(agnosai_spawn_signal(r) == 0, "and it was not signalled");
    assert(str_contains_cstr(agnosai_spawn_stdout(r), "hello") == 1, "stdout is captured");
    assert(str_contains_cstr(agnosai_spawn_stderr(r), "oops") == 1, "stderr is captured");
    # The two streams are SEPARATE — a port that merged them would pass the two
    # assertions above and still be wrong.
    assert(str_contains_cstr(agnosai_spawn_stdout(r), "oops") == 0,
    "...and stderr does NOT leak into stdout");
    assert(str_contains_cstr(agnosai_spawn_stderr(r), "hello") == 0, "nor the reverse");
    return 0;
}

# **The distinction the whole exec-errno pipe exists for.**
fn _t_sp_failure_vs_exit_127(): i64 {
    var real = _t_sh("exit 127");
    assert(agnosai_spawn_status(real) == AGNOSAI_SPAWN_OK,
    "a program that genuinely exits 127 SPAWNED — it is not a spawn failure");
    assert(agnosai_spawn_exit_code(real) == 127, "...and reports 127");

    var argv = alloc(16);
    store64(argv, "/nonexistent/binary");
    store64(argv + 8, 0);
    var bad = agnosai_spawn_capture("/nonexistent/binary", argv, agnosai_sanitized_envp(), AGNOSAI_SPAWN_NO_TIMEOUT, 0);
    assert(agnosai_spawn_status(bad) == AGNOSAI_SPAWN_FAILED,
    "a missing executable is a SPAWN FAILURE, not exit 127 — three oracle sites need this");
    assert(agnosai_spawn_status(bad) != agnosai_spawn_status(real),
    "...and the two are distinguishable, which fork+execve alone cannot do");
    return 0;
}

# A signalled child has no exit code; -1 matches the oracle's
# `status.code().unwrap_or(-1)`, where 0 would read as success.
fn _t_sp_signalled(): i64 {
    var r = _t_sh("kill -9 $$");
    assert(agnosai_spawn_status(r) == AGNOSAI_SPAWN_OK, "it did spawn");
    assert(agnosai_spawn_signal(r) == 9, "SIGKILL is reported as the signal");
    assert(agnosai_spawn_exit_code(r) == 0 - 1,
    "and the exit code is -1, NOT 0 — a signalled child did not succeed");
    return 0;
}

# **The deadlock case.** A child filling BOTH pipes past the 64 KiB buffer is
# captured whole only because the drain interleaves. Drain-then-drain hangs.
fn _t_sp_large_dual_output(): i64 {
    var r = _t_sh("i=0; while [ $i -lt 700 ]; do echo AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA; echo BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB >&2; i=$((i+1)); done");
    assert(agnosai_spawn_status(r) == AGNOSAI_SPAWN_OK, "the child ran to completion");
    assert(str_len(agnosai_spawn_stdout(r)) == 70700,
    "70,700 bytes of stdout captured — past the 64 KiB pipe buffer");
    assert(str_len(agnosai_spawn_stderr(r)) == 70700,
    "...and 70,700 of stderr, which is the half that deadlocks a sequential drain");
    return 0;
}

# **Why CLOEXEC on the errno pipe is load-bearing**, which the simpler cases do
# not show. Reading the errno pipe after the drain means EOF arrives anyway once
# the child exits — so dropping CLOEXEC looks harmless right up until a
# GRANDCHILD inherits the descriptor and outlives its parent.
#
# `sh -c 'sleep 30 &'` returns immediately but leaves `sleep` holding every fd it
# inherited. With CLOEXEC the write end was closed at `execve`, so the parent
# sees EOF at once. Without it, `sleep` holds the pipe open and the parent blocks
# for 30 seconds — a hang, not a wrong answer.
fn _t_sp_cloexec_survives_a_grandchild(): i64 {
    var r = _t_sh("sleep 30 & echo started");
    assert(agnosai_spawn_status(r) == AGNOSAI_SPAWN_OK, "the child spawned");
    assert(str_contains_cstr(agnosai_spawn_stdout(r), "started") == 1,
    "...and returned promptly, because CLOEXEC closed the errno pipe at execve");
    return 0;
}

# The sanitized environment actually reaches the child, rather than only being
# built correctly.
fn _t_sp_env_reaches_child(): i64 {
    var r = _t_sh("echo \"P=$PATH\"; echo \"L=$LD_PRELOAD\"");
    assert(agnosai_spawn_status(r) == AGNOSAI_SPAWN_OK, "spawned");
    assert(str_contains_cstr(agnosai_spawn_stdout(r), "P=/") == 1,
    "PATH reaches the child — the filter is subtractive, not a wipe");
    assert(str_contains_cstr(agnosai_spawn_stdout(r), "L=\n") == 1
    || str_contains_cstr(agnosai_spawn_stdout(r), "L=") == 1,
    "and LD_PRELOAD is empty in the child");
    return 0;
}

# --- stdin feed ----------------------------------------------------------

fn _t_sh_in(script, input): i64 {
    var argv = alloc(32);
    store64(argv, "/bin/sh");
    store64(argv + 8, "-c");
    store64(argv + 16, script);
    store64(argv + 24, 0);
    return agnosai_spawn_capture_input("/bin/sh", argv, agnosai_sanitized_envp(), input, AGNOSAI_SPAWN_NO_TIMEOUT, 0);
}

fn _t_sp_stdin_basics(): i64 {
    var r = _t_sh_in("cat", str_from("hello stdin"));
    assert(agnosai_spawn_status(r) == AGNOSAI_SPAWN_OK, "spawned with stdin");
    assert(str_eq_cstr(agnosai_spawn_stdout(r), "hello stdin") == 1,
    "the input is fed through and comes back verbatim");
    assert(agnosai_spawn_exit_code(r) == 0, "and the child exited cleanly");

    # A child that reads to EOF must SEE EOF — an empty input still has to close
    # the pipe, or `cat` waits forever for a byte that is never coming.
    var e = _t_sh_in("cat", str_from(""));
    assert(agnosai_spawn_status(e) == AGNOSAI_SPAWN_OK, "an EMPTY input still terminates");
    assert(str_len(agnosai_spawn_stdout(e)) == 0, "...producing nothing");

    # A child that ignores stdin entirely must not hang the writer.
    var ig = _t_sh_in("echo ignored", str_from("unread input"));
    assert(agnosai_spawn_status(ig) == AGNOSAI_SPAWN_OK,
    "a child that never READS stdin does not hang the parent's write");
    assert(str_contains_cstr(agnosai_spawn_stdout(ig), "ignored") == 1, "...and still runs");
    return 0;
}

# **The second deadlock.** The oracle writes its whole input before reading. Here
# that hangs: the parent fills the child's 64 KiB stdin pipe while the child
# blocks on its own full stdout pipe that nobody is draining.
#
# 200,000 bytes in and the same 200,000 back out — both far past the buffer.
fn _t_sp_stdin_large_roundtrip(): i64 {
    var sb = str_builder_new();
    var i = 0;
    while (i < 2000) {
        str_builder_add_cstr(sb,
        "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789");
        i = i + 1;
    }
    var big = str_builder_build(sb);
    assert(str_len(big) == 200000, "the input is 200,000 bytes");

    var r = _t_sh_in("cat", big);
    assert(agnosai_spawn_status(r) == AGNOSAI_SPAWN_OK, "the round trip completes");
    assert(str_len(agnosai_spawn_stdout(r)) == 200000,
    "all 200,000 bytes come back — the write interleaves with the drain");
    assert(str_eq(agnosai_spawn_stdout(r), big) == 1, "...byte for byte, in order");
    return 0;
}

# stdin does not disturb the other guarantees.
fn _t_sp_stdin_keeps_the_contract(): i64 {
    var r = _t_sh_in("cat; echo err >&2; exit 5", str_from("x"));
    assert(agnosai_spawn_exit_code(r) == 5, "the exit code still comes back");
    assert(str_contains_cstr(agnosai_spawn_stderr(r), "err") == 1, "stderr is still separate");
    assert(str_contains_cstr(agnosai_spawn_stdout(r), "err") == 0, "...still not merged");

    var argv = alloc(16);
    store64(argv, "/nonexistent/binary");
    store64(argv + 8, 0);
    var bad = agnosai_spawn_capture_input("/nonexistent/binary", argv,
    agnosai_sanitized_envp(), str_from("ignored"), AGNOSAI_SPAWN_NO_TIMEOUT, 0);
    assert(agnosai_spawn_status(bad) == AGNOSAI_SPAWN_FAILED,
    "spawn failure is still distinguishable when input was supplied");
    return 0;
}


# This process's own consumed CPU time in ms, or -1 where unavailable.
#
# `CLOCK_PROCESS_CPUTIME_ID` (2) advances only while the process is actually
# running on a CPU, which is exactly what separates a sleeping drain loop from a
# spinning one. Off Linux the id and the syscall route both differ (see the
# notes in lib/chrono.cyr), so it reports unavailable rather than a wrong number.
fn _t_sp_self_cpu_ms(): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    var ts[16];
    store64(&ts, 0);
    store64(&ts + 8, 0);
    if (syscall(228, 2, &ts) < 0) { return 0 - 1; }
    return load64(&ts) * 1000 + load64(&ts + 8) / 1000000;
    #endif
    #ifndef CYRIUS_TARGET_LINUX
    return 0 - 1;
    #endif
}

# ---------------------------------------------------------------------------
# The deadline: SIGKILL and reap (bite 7)
# ---------------------------------------------------------------------------

# Run `script` under `sh -c` with a deadline.
fn _t_sp_deadline(script, ms): i64 {
    var argv = alloc(32);
    store64(argv, "/bin/sh");
    store64(argv + 8, "-c");
    store64(argv + 16, script);
    store64(argv + 24, 0);
    return agnosai_spawn_capture("/bin/sh", argv, agnosai_sanitized_envp(), ms, 0);
}

fn _t_sp_timeout_kills(): i64 {
    var t0 = clock_now_ms();
    var r = _t_sp_deadline("sleep 60", 300);
    var dt = clock_now_ms() - t0;

    assert(agnosai_spawn_timed_out(r) == 1, "a child past its deadline reports timed_out");
    assert(agnosai_spawn_status(r) == AGNOSAI_SPAWN_OK,
    "a timeout is a result, not a spawn failure - oracle process.rs:308");
    assert(agnosai_spawn_exit_code(r) == 0 - 1,
    "exit_code is -1 on timeout, matching ProcessResult");
    assert(agnosai_spawn_signal(r) == 9, "SIGKILL is what stopped it");

    # The whole point: the call RETURNED, rather than waiting out the sleep.
    # Without the deadline check this is 60_000.
    assert(dt < 5000, "the deadline fires instead of waiting for the child");
    return 0;
}

fn _t_sp_timeout_reaps(): i64 {
    # A timed-out child must be reaped, not merely killed. An unreaped child is
    # a zombie: still in the process table, still owning its end of the pipes.
    # `waitpid(-1)` here would find it; ECHILD means there is nothing left.
    var r = _t_sp_deadline("sleep 60", 200);
    assert(agnosai_spawn_timed_out(r) == 1, "the child hit its deadline");

    var st[8];
    store64(&st, 0);
    var orphan = sys_waitpid(0 - 1, &st, WNOHANG);
    assert(orphan <= 0, "no reapable child is left behind after a timeout");
    return 0;
}

fn _t_sp_timeout_kills_a_child_that_traps_term(): i64 {
    # SIGTERM is catchable and SIGKILL is not. A tool that installs a TERM
    # handler - or ignores it, as here - would outlive a polite signal, and the
    # reap that follows would then block forever waiting on a child that never
    # died. The deadline has to be unignorable to mean anything.
    var t0 = clock_now_ms();
    var r = _t_sp_deadline("trap '' TERM; sleep 60", 300);
    var dt = clock_now_ms() - t0;

    assert(agnosai_spawn_timed_out(r) == 1, "a child IGNORING SIGTERM is still stopped");
    assert(agnosai_spawn_signal(r) == 9, "...by SIGKILL, which it cannot trap");
    assert(dt < 5000, "...promptly, rather than blocking on a reap that never returns");
    return 0;
}

fn _t_sp_deadline_lets_fast_children_finish(): i64 {
    # The deadline must not truncate work that fits inside it. A generous
    # timeout has to be invisible.
    var r = _t_sp_deadline("echo quick", 30000);
    assert(agnosai_spawn_timed_out(r) == 0, "a child inside its deadline is not a timeout");
    assert(agnosai_spawn_exit_code(r) == 0, "...and its exit code is its own");
    assert(str_contains_cstr(agnosai_spawn_stdout(r), "quick") == 1,
    "...and its output survives");
    return 0;
}

fn _t_sp_timeout_keeps_partial_output(): i64 {
    # The primitive returns what it drained before the kill. `process` blanks it
    # to match ProcessResult; spawn does not, and that split is deliberate -
    # see the note on agnosai_spawn_timed_out.
    var r = _t_sp_deadline("echo early; sleep 60", 500);
    assert(agnosai_spawn_timed_out(r) == 1, "the child was killed");
    assert(str_contains_cstr(agnosai_spawn_stdout(r), "early") == 1,
    "output produced before the deadline is still readable");
    return 0;
}

fn _t_sp_idle_child_does_not_burn_the_cpu(): i64 {
    # The unslept loop measured 100% of a core for as long as the child ran.
    # Compare the parent's own CPU time against the wall time it waited: a
    # spinning loop drives the ratio to ~1, a sleeping one keeps it near 0.
    var c0 = _t_sp_self_cpu_ms();
    if (c0 < 0) { return 0; }
    var t0 = clock_now_ms();
    var r = _t_sp_deadline("sleep 1", 30000);
    var wall = clock_now_ms() - t0;
    var cpu = _t_sp_self_cpu_ms() - c0;

    assert(agnosai_spawn_timed_out(r) == 0, "the child finished on its own");
    assert(wall >= 900, "...after actually sleeping");
    # A tenth of the wall clock is enormous headroom for a loop that should be
    # asleep, and far under the ~100% a spinning one spends.
    assert(cpu * 10 < wall, "the drain loop sleeps instead of spinning");
    return 0;
}

# --- work_dir ------------------------------------------------------------

fn _t_sp_work_dir(): i64 {
    var argv = alloc(32);
    store64(argv, "/bin/sh");
    store64(argv + 8, "-c");
    store64(argv + 16, "pwd");
    store64(argv + 24, 0);

    # `/tmp` is the one directory guaranteed to exist and differ from cwd.
    var r = agnosai_spawn_capture("/bin/sh", argv, agnosai_sanitized_envp(),
    AGNOSAI_SPAWN_NO_TIMEOUT, "/tmp");
    assert(agnosai_spawn_status(r) == AGNOSAI_SPAWN_OK, "a child runs in a work_dir");
    assert(str_contains_cstr(agnosai_spawn_stdout(r), "/tmp") == 1,
    "...and it is the directory the child reports");

    # **The PARENT must not have moved.** A chdir on the parent side would
    # relocate the whole server, and every later relative path with it.
    var here = agnosai_spawn_capture("/bin/sh", argv, agnosai_sanitized_envp(),
    AGNOSAI_SPAWN_NO_TIMEOUT, 0);
    assert(str_contains_cstr(agnosai_spawn_stdout(here), "/tmp") == 0,
    "the next spawn with NO work_dir is unaffected - the parent never moved");

    # A work_dir that does not exist must not silently run in the wrong place.
    var bad = agnosai_spawn_capture("/bin/sh", argv, agnosai_sanitized_envp(),
    AGNOSAI_SPAWN_NO_TIMEOUT, "/nonexistent/work/dir");
    assert(agnosai_spawn_status(bad) == AGNOSAI_SPAWN_FAILED,
    "a missing work_dir FAILS the spawn rather than running somewhere else");
    assert(agnosai_spawn_fail_reason(bad) == AGNOSAI_SPAWN_FAIL_CHDIR,
    "...and says it was the chdir, not the exec - an operator typo is findable");
    return 0;
}

fn _t_sp_fail_reason(): i64 {
    var argv = alloc(16);
    store64(argv, "/nonexistent/binary");
    store64(argv + 8, 0);
    var bad = agnosai_spawn_capture("/nonexistent/binary", argv,
    agnosai_sanitized_envp(), AGNOSAI_SPAWN_NO_TIMEOUT, 0);
    assert(agnosai_spawn_fail_reason(bad) == AGNOSAI_SPAWN_FAIL_EXEC,
    "a missing executable reports EXEC, distinct from a bad work_dir");

    var ok = _t_sh("exit 7");
    assert(agnosai_spawn_fail_reason(ok) == AGNOSAI_SPAWN_FAIL_NONE,
    "a program that RAN and exited non-zero is not a spawn failure");
    return 0;
}

fn main(): i64 {
    alloc_init();
    sakshi_set_level(SK_FATAL);

    _t_sp_entry_name();
    _t_sp_envp_from();
    _t_sp_envp_inherited();
    _t_sp_cloexec();
    _t_sp_capture_basics();
    _t_sp_failure_vs_exit_127();
    _t_sp_signalled();
    _t_sp_large_dual_output();
    _t_sp_cloexec_survives_a_grandchild();
    _t_sp_env_reaches_child();
