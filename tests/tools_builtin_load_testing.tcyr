# =========================================================================
# tools_builtin_load_testing.tcyr — parity tests for
# src/tools/builtin/load_testing.cyr
#
# Oracle: the #[cfg(test)] block in rust-old/src/tools/builtin/load_testing.rs.
# Its two live tests drive an axum mock server; those do not port directly —
# `is_safe_url` correctly rejects loopback, so the tool cannot be aimed at a
# local server, and pointing a test suite at a public host is not acceptable.
#
# Instead the **real thread fan-out** runs against a synthetic executor. That
# exercises worker threads, per-worker arenas, the deadline and budget loops,
# status aggregation, the sort and the percentile indices with no network at
# all. The real executor runs against a loopback server here (`_t_http_suite`),
# driven directly, as the tool's own SSRF guard refuses loopback.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/arena_pool.cyr"
include "src/id.cyr"
# telemetry — `tools/native` and `orchestrator/crew_runner` record GenAI
# spans (ADR 017), so every suite that reaches them needs the module that
# defines the recorder. It depends on nothing in `src/` except `id`.
include "src/telemetry/mod.cyr"
include "src/order.cyr"
include "src/core/error.cyr"
include "src/core/json.cyr"
include "src/core/message.cyr"
include "src/core/resource.cyr"
include "src/core/task.cyr"
include "src/strcase.cyr"
include "src/llm/retry.cyr"
include "src/server/ssrf.cyr"
include "src/server/output_filter.cyr"
include "src/tools/native.cyr"
include "src/tools/registry.cyr"
include "src/tool_call.cyr"
include "src/tools/builtin/load_testing.cyr"
include "tests/test_helpers.cyr"

# A synthetic executor: always "200 OK", no network. Each call also burns a
# little time so the recorded latencies are non-degenerate.
fn _t_exec_ok(w): i64 {
    return 200;
}

# A synthetic executor that always reports a transport error.
fn _t_exec_fail(w): i64 {
    return 0;
}

# A synthetic executor whose status depends on the worker id, so the
# aggregation across workers is observable.
fn _t_exec_mixed(w): i64 {
    if (agnosai_lt_worker_id(w) % 2 == 0) { return 200; }
    return 503;
}

# ── a loopback server that keeps its connections ────────────────────────────
#
# One thread per connection, as a run opens one per user. What it answers is `_T_ANSWER`, and 0 closes
# the connection unanswered. `_T_CLOSE_AFTER` closes one with no warning after that many answers, and
# `_T_HANG_AFTER` stops answering after that many, keeping the connection open.
var _T_LFD = 0;
var _T_PORT = 0;
var _T_ANSWER = 0;
var _T_CLOSE_AFTER = 0;
var _T_HANG_AFTER = 0;
var _T_ACCEPTS = 0;
var _T_SEEN = 0;
var _T_ENDED = 0;

var _T_KEEP = "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok";
var _T_CLOSES = "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Length: 2\r\n\r\nok";
var _T_MISSING = "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n";
var _T_CHUNKED = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nok\r\n0\r\n\r\n";

# ⚠ `sys_read` and `sys_write`, and not `sock_recv`: its `Ok` is 16 B on the global heap per request,
# which is what `_t_http_cost` is measuring the client for.
fn _t_conn(cfd): i64 {
    var buf[2048];
    var served = 0;
    while (sys_read(cfd, &buf, 2048) > 0) {
        atomic_fetch_add(&_T_SEEN, 1);
        var r = _T_ANSWER;
        if (r == 0) { break; }
        if (_T_HANG_AFTER != 0 && served >= _T_HANG_AFTER) { continue; }
        sys_write(cfd, r, strlen(r));
        served = served + 1;
        if (_T_CLOSE_AFTER != 0 && served >= _T_CLOSE_AFTER) { break; }
    }
    sock_close(cfd);
    atomic_fetch_add(&_T_ENDED, 1);
    return 0;
}

fn _t_server(arg): i64 {
    while (1 == 1) {
        var at, cfd = sock_accept(_T_LFD);
        if (is_err_result(at) == 0) {
            atomic_fetch_add(&_T_ACCEPTS, 1);
            thread_create_detached(&_t_conn, cfd);
        }
    }
    return 0;
}

# Listen on a free loopback port: 1, or 0 when there is none.
fn _t_server_start(): i64 {
    var lt, lfd = tcp_socket();
    sock_reuse(lfd);
    var lp = 47941;
    while (lp < 47973 && _T_PORT == 0) {
        var bt, bv = sock_bind(lfd, INADDR_LOOPBACK(), lp);
        if (is_err_result(bt) == 0) { _T_PORT = lp; }
        lp = lp + 1;
    }
    if (_T_PORT == 0) { return 0; }
    var st, sv = sock_listen(lfd, 64);
    if (is_err_result(st) == 1) { return 0; }
    _T_LFD = lfd;
    thread_create_detached(&_t_server, 0);
    return 1;
}

fn _t_url(): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "http://127.0.0.1:");
    str_builder_add_int(sb, _T_PORT);
    str_builder_add_cstr(sb, "/");
    return str_builder_build(sb);
}

# Point the server at `answer`, and zero its counts.
fn _t_serve(answer, close_after): i64 {
    _T_ANSWER = answer;
    _T_CLOSE_AFTER = close_after;
    _T_HANG_AFTER = 0;
    atomic_store(&_T_ACCEPTS, 0);
    atomic_store(&_T_SEEN, 0);
    atomic_store(&_T_ENDED, 0);
    return 0;
}

# A real-executor worker with `budget` requests, run to its end. Hands back the worker, unreleased.
fn _t_http_run(budget): i64 {
    var w = agnosai_lt_worker_new(_t_url(), clock_now_ns() + 30000000000, budget,
      &agnosai_lt_http_executor, 0);
    agnosai_lt_worker_run(w);
    return w;
}

# Wait up to a second for the server to have seen `n` connections end.
fn _t_await_ended(n): i64 {
    for (var i = 0; i < 1000 && atomic_load(&_T_ENDED) < n; i = i + 1) { sleep_ms(1); }
    return atomic_load(&_T_ENDED);
}

fn _t_status(w, code): i64 {
    return agnosai_lt_status_count(agnosai_lt_worker_status_counts(w), code);
}

# What a request on a kept connection leaves on the global heap, its arenas warm.
#
# ⚠ Sandhi's own, exact and for this response, so that a copy of ours shows above it (roadmap:
# waiting on sandhi). 256 B of it is the pool's route key, built on the global heap for each take
# and each put. Lower it when sandhi moves.
var _T_SANDHI_BYTES_PER_KEPT_REQUEST = 568;

fn _t_http_cost(): i64 {
    _t_serve(_T_KEEP, 0);
    var w = agnosai_lt_worker_new(_t_url(), clock_now_ns() + 30000000000, 20, &agnosai_lt_http_executor, 0);
    agnosai_lt_worker_run(w);
    store64(w + AGN_LT_MAX_REQUESTS, 220);
    var pool = load64(w + AGN_LT_POOL);
    # One request to open the worker's connection again, which the first run closed as it ended.
    agnosai_lt_http_executor(w);
    reset_via(agnosai_lt_worker_scratch(w));
    var before = alloc_used();
    for (var i = 0; i < 200; i = i + 1) {
        assert_eq(agnosai_lt_http_executor(w), 200, "every kept-connection request answers");
        reset_via(agnosai_lt_worker_scratch(w));
    }
    var cost = (alloc_used() - before) / 200;
    assert_eq(sandhi_http_pool_idle_count(pool), 1, "and the connection is still there to measure");
    assert(cost <= _T_SANDHI_BYTES_PER_KEPT_REQUEST,
      "a kept-connection request leaves only sandhi's own: nothing of ours");
    sandhi_http_pool_close(pool);
    agnosai_lt_worker_release(w);
    return 0;
}

fn _t_http_suite(): i64 {
    test_group("the real executor, on a real socket");
    if (_t_server_start() == 0) {
        println("tools_builtin_load_testing: no loopback port to listen on; these checks did not run");
        return 0;
    }

    _t_serve(_T_KEEP, 0);
    var w = _t_http_run(50);
    assert_eq(vec_len(agnosai_lt_worker_latencies(w)), 50, "every request is measured");
    assert_eq(agnosai_lt_worker_errors(w), 0, "and none failed");
    assert_eq(_t_status(w, 200), 50, "and each is counted under the status the server sent");
    assert_eq(atomic_load(&_T_ACCEPTS), 1, "on one connection: a request is not a handshake");
    assert_eq(atomic_load(&_T_SEEN), 50, "and the server saw each once");
    assert_eq(_t_await_ended(1), 1, "and the worker closes it as it ends");
    assert_eq(sandhi_http_pool_idle_count(load64(w + AGN_LT_POOL)), 0, "leaving nothing in its pool");
    agnosai_lt_worker_release(w);

    _t_serve(_T_CHUNKED, 0);
    w = _t_http_run(20);
    assert_eq(_t_status(w, 200), 20, "a chunked answer is read to its end");
    assert_eq(atomic_load(&_T_ACCEPTS), 1, "so its connection can be used again");
    agnosai_lt_worker_release(w);

    _t_serve(_T_MISSING, 0);
    w = _t_http_run(5);
    assert_eq(_t_status(w, 404), 5, "a 404 is a status, not a transport error");
    assert_eq(agnosai_lt_worker_errors(w), 0, "and is not an error here");
    assert_eq(atomic_load(&_T_ACCEPTS), 5, "sandhi keeps no connection after one");
    agnosai_lt_worker_release(w);

    _t_serve(_T_CLOSES, 0);
    w = _t_http_run(5);
    assert_eq(_t_status(w, 200), 5, "a server that says it is closing is answered in full");
    assert_eq(atomic_load(&_T_ACCEPTS), 5, "and gets a new connection per request");
    assert_eq(atomic_load(&_T_SEEN), 5, "with no request sent twice");
    agnosai_lt_worker_release(w);

    # Each new connection takes the place of the last in its arena. Without the reset that arena
    # grows by a whole response buffer a request, which is 16 MiB.
    w = agnosai_lt_worker_new(_t_url(), clock_now_ns() + 30000000000, 1, &agnosai_lt_http_executor, 0);
    agnosai_lt_http_executor(w);
    reset_via(agnosai_lt_worker_scratch(w));
    var grown = alloc_used();
    for (var ar_i = 0; ar_i < 30; ar_i = ar_i + 1) {
        agnosai_lt_http_executor(w);
        reset_via(agnosai_lt_worker_scratch(w));
    }
    assert(alloc_used() - grown < 1048576, "and thirty more connections take the first one's place");
    agnosai_lt_worker_release(w);

    # The one that decides whether a run's numbers can be trusted against a real server.
    _t_serve(_T_KEEP, 3);
    w = _t_http_run(30);
    assert_eq(agnosai_lt_worker_errors(w), 0,
      "a server closing a kept connection without warning is not reported as a failing target");
    assert_eq(_t_status(w, 200), 30, "every request still got its answer");
    assert_eq(atomic_load(&_T_ACCEPTS), 10, "on a new connection each time one went");
    agnosai_lt_worker_release(w);

    # A kept connection that goes quiet is a finding about the target. A retry would wait out the
    # deadline twice over and call the result an answer.
    _t_serve(_T_KEEP, 0);
    _T_HANG_AFTER = 1;
    var keep_ms = AGNOSAI_LT_REQUEST_TIMEOUT_MS;
    AGNOSAI_LT_REQUEST_TIMEOUT_MS = 150;
    w = _t_http_run(2);
    AGNOSAI_LT_REQUEST_TIMEOUT_MS = keep_ms;
    assert_eq(_t_status(w, 200), 1, "the answer that came is counted");
    assert_eq(agnosai_lt_worker_errors(w), 1, "and the one that never did is an error");
    assert_eq(atomic_load(&_T_ACCEPTS), 1, "with no second connection tried: a timeout is not retried");
    agnosai_lt_worker_release(w);

    _t_serve(0, 0);
    w = _t_http_run(3);
    assert_eq(agnosai_lt_worker_errors(w), 3, "a target that accepts and never answers is a failure");
    assert_eq(atomic_load(&_T_ACCEPTS), 3, "and a fresh connection is not tried twice: that would hide it");
    assert_eq(vec_len(agnosai_lt_worker_latencies(w)), 3, "with each attempt measured");
    agnosai_lt_worker_release(w);

    # A request can fail without touching the connection, here on a URL sandhi will not parse. The
    # connection is still in the pool and still alive in its arena, which must not be reset for it.
    _t_serve(_T_KEEP, 0);
    w = agnosai_lt_worker_new(_t_url(), clock_now_ns() + 30000000000, 1, &agnosai_lt_http_executor, 0);
    assert_eq(agnosai_lt_http_executor(w), 200, "a connection is opened");
    reset_via(agnosai_lt_worker_scratch(w));
    var conn_arena = load64(w + AGN_LT_CONN);
    var holds = arena_used(load64(conn_arena + 32));
    assert(holds > 0, "and lives in the worker's connection arena");
    var good_url = load64(w + AGN_LT_URL);
    store64(w + AGN_LT_URL, str_from("http://"));
    assert_eq(agnosai_lt_http_executor(w), 0, "a URL that does not parse is a transport error");
    assert_eq(arena_used(load64(conn_arena + 32)), holds, "and the connection's arena is left alone");
    assert_eq(sandhi_http_pool_idle_count(load64(w + AGN_LT_POOL)), 1, "with the connection still kept");
    store64(w + AGN_LT_URL, good_url);
    reset_via(agnosai_lt_worker_scratch(w));
    assert_eq(agnosai_lt_http_executor(w), 200, "so the next request answers");
    assert_eq(atomic_load(&_T_ACCEPTS), 1, "on the same connection");
    sandhi_http_pool_close(load64(w + AGN_LT_POOL));
    # The server counts this one going, and the fan-out below counts its own.
    _t_await_ended(1);
    agnosai_lt_worker_release(w);

    # A pause cannot make a kept connection stale. sandhi would close one it thought stale and open
    # another in the arena this worker had picked for a reuse, which is reset after the request.
    _t_serve(_T_KEEP, 0);
    w = agnosai_lt_worker_new(_t_url(), clock_now_ns() + 30000000000, 1, &agnosai_lt_http_executor, 0);
    assert_eq(agnosai_lt_http_executor(w), 200, "a connection is opened");
    reset_via(agnosai_lt_worker_scratch(w));
    sleep_ms(25);
    assert_eq(agnosai_lt_http_executor(w), 200, "a request after a pause answers");
    assert_eq(atomic_load(&_T_ACCEPTS), 1, "on the connection it had");
    sandhi_http_pool_close(load64(w + AGN_LT_POOL));
    _t_await_ended(1);
    agnosai_lt_worker_release(w);

    # The fan-out, end to end: four threads, four connections, and a report built from what they saw.
    _t_serve(_T_KEEP, 0);
    var ar = arena_allocator_growable(65536);
    var r = agnosai_load_test_run_a(ar, _t_url(), 4, 1, &agnosai_lt_http_executor);
    assert_neq(r, 0, "a run against a real socket finishes");
    assert(agnosai_lt_result_total_requests(r) > 4, "and made more than one request each");
    assert_eq(agnosai_lt_result_failed(r), 0, "with none failing");
    assert_eq(agnosai_lt_status_count(agnosai_lt_result_status_codes(r), 200),
      agnosai_lt_result_total_requests(r), "and every answer in the report");
    assert_eq(atomic_load(&_T_ACCEPTS), 4, "one connection per user, whatever the requests");
    assert_eq(_t_await_ended(4), 4, "each closed by the end of the run");
    assert(agnosai_lt_result_p50_ns(r) > 0, "and a real latency, not a zero");

    _t_http_cost();
    return 0;
}

# What a load test leaves on the global heap.
fn _t_cost_suite(): i64 {
    test_group("what a call leaves on the global heap");
    var url = str_from("http://example.com/");
    var deadline = clock_now_ns() + 50000000;
    var workers = vec_new();
    var w0 = agnosai_lt_worker_new(url, deadline, 4, &_t_exec_mixed, 0);
    var w1 = agnosai_lt_worker_new(url, deadline, 6, &_t_exec_mixed, 1);
    agnosai_lt_worker_run(w0);
    agnosai_lt_worker_run(w1);
    vec_push(workers, w0);
    vec_push(workers, w1);

    # The report: what the workers measured, merged and written up, in the call's allocator.
    var ar = arena_allocator_growable(65536);
    var in_arena = agnosai_lt_worker_new_a(ar, url, deadline, 4, &_t_exec_mixed, 2);
    assert_neq(in_arena, 0, "a worker builds in the call's allocator");
    assert_eq(agnosai_lt_worker_id(in_arena), 2, "with its id");
    agnosai_lt_worker_release(in_arena);
    reset_via(ar);
    var before = alloc_used();
    for (var i = 0; i < 50; i = i + 1) {
        agnosai_lt_result_to_value_a(ar, agnosai_lt_aggregate_a(ar, workers, url, 2, 5));
        reset_via(ar);
    }
    assert_eq(alloc_used() - before, 0, "a report leaves nothing");

    # A worker's url is a C string of its own, or the HTTP executor makes one per request.
    assert_eq(load8(str_data(load64(w0 + AGN_LT_URL)) + str_len(url)), 0, "a worker's url is NUL-terminated");
    assert_neq(str_data(load64(w0 + AGN_LT_URL)), str_data(url), "and a copy, for the worker's life");

    # Everything a run builds is in `a` or a pooled arena, and its threads are detached: this was
    # 4,120 B a user, for good, through 2.3.5.
    #
    # ⚠ The pool hands arenas out first in, first out, so a first run warms only the slots it took,
    # and a second of the same size takes fresh ones and reads 1 MiB a user. One worker per slot
    # warms them all.
    var tool = agnosai_load_testing_tool();
    agnosai_load_test_run_a(ar, url, _AGNOSAI_LT_POOL_SLOTS, 1, &_t_exec_ok);
    reset_via(ar);
    var run_before = alloc_used();
    var r = agnosai_load_test_run_a(ar, url, _AGNOSAI_LT_POOL_SLOTS, 1, &_t_exec_ok);
    var per_user = (alloc_used() - run_before) / _AGNOSAI_LT_POOL_SLOTS;
    assert_neq(r, 0, "a run on the call's allocator finishes");
    assert_eq(agnosai_lt_result_total_requests(r), AGNOSAI_LT_MAX_TOTAL_REQUESTS,
      "having made enough requests that a per-request cost could not hide");
    assert_eq(per_user, 0, "and leaves nothing, whatever the requests or the users");
    reset_via(ar);

    var missing = agnosai_tool_input_with_alloc(agnosai_tool_input_new(), ar);
    agnosai_tool_execute(tool, missing);
    reset_via(ar);
    var private_url = agnosai_tool_input_new();
    agnosai_tool_input_set(private_url, str_from("target_url"), bayan_json_v_str_new(str_from("http://127.0.0.1/")));
    agnosai_tool_input_with_alloc(private_url, ar);
    agnosai_tool_execute(tool, private_url);
    reset_via(ar);
    var quiet = alloc_used();
    for (var j = 0; j < 50; j = j + 1) {
        agnosai_tool_execute(tool, missing);
        reset_via(ar);
    }
    assert_eq(alloc_used() - quiet, 0, "a call with a parameter missing leaves nothing");

    # The SSRF guard's parse is in the call's arena since 2.3.6, 136 B a check before that.
    var guarded = alloc_used();
    for (var k = 0; k < 50; k = k + 1) {
        agnosai_tool_execute(tool, private_url);
        reset_via(ar);
    }
    assert_eq(alloc_used() - guarded, 0, "a refused target leaves nothing, the guard's parse included");
    return 0;
}

fn main() {
    alloc_init();
    _t_cost_suite();
    _t_http_suite();

    test_group("tools_builtin_load_testing");

    var tool = agnosai_load_testing_tool();

    # --- load_testing_name ---
    assert(str_eq(agnosai_tool_name(tool), str_from("load_testing")) == 1, "tool name");

    # --- load_testing_schema_has_target_url ---
    var schema = agnosai_tool_schema(tool);
    assert_eq(vec_len(agnosai_tool_schema_parameters(schema)), 3, "three parameters");
    var p0 = vec_get(agnosai_tool_schema_parameters(schema), 0);
    assert(str_eq(agnosai_param_schema_name(p0), str_from("target_url")) == 1,
      "the first parameter is target_url");
    assert_eq(agnosai_param_schema_required(p0), 1, "target_url is required");
    assert_eq(agnosai_param_schema_required(vec_get(agnosai_tool_schema_parameters(schema), 1)), 0,
      "concurrent_users is optional");
    assert_eq(agnosai_param_schema_required(vec_get(agnosai_tool_schema_parameters(schema), 2)), 0,
      "duration_seconds is optional");

    # --- load_testing_missing_url ---
    var out = agnosai_tool_execute(tool, agnosai_tool_input_new());
    assert_eq(agnosai_tool_output_success(out), 0, "a missing target_url fails");
    assert(str_contains(agnosai_tool_output_error(out), str_from("target_url")) == 1,
      "the error names target_url");

    # --- the SSRF guard runs before any network work ---
    var priv_in = agnosai_tool_input_new();
    agnosai_tool_input_set(priv_in, str_from("target_url"),
      bayan_json_v_str_new(str_from("http://127.0.0.1:8080/")));
    var priv_out = agnosai_tool_execute(tool, priv_in);
    assert_eq(agnosai_tool_output_success(priv_out), 0, "a loopback target is refused");
    assert(str_contains(agnosai_tool_output_error(priv_out), str_from("private/internal")) == 1,
      "the refusal names the reason");

    var meta_in = agnosai_tool_input_new();
    agnosai_tool_input_set(meta_in, str_from("target_url"),
      bayan_json_v_str_new(str_from("http://169.254.169.254/latest/meta-data/")));
    assert_eq(agnosai_tool_output_success(agnosai_tool_execute(tool, meta_in)), 0,
      "the cloud metadata endpoint is refused");

    var octal_in = agnosai_tool_input_new();
    agnosai_tool_input_set(octal_in, str_from("target_url"),
      bayan_json_v_str_new(str_from("http://0177.0.0.1/")));
    assert_eq(agnosai_tool_output_success(agnosai_tool_execute(tool, octal_in)), 0,
      "an octal-encoded loopback target is refused");

    # --- clamps ---
    # ⚠ **There is NO lower clamp — the oracle applies only `.min(500)`.**
    # `concurrent_users: 0` is a legal `u64`: it spawns nothing, collects no
    # latencies, and the tool answers `"load test failed: no requests
    # completed"`. Raising 0 to 1 made the port run a real one-worker load test
    # against the target for the full duration — traffic the caller explicitly
    # asked not to send, and a success where the oracle reports a failure.
    assert_eq(agnosai_lt_clamp_users(0), 0, "zero users passes through — no lower clamp");
    # A negative cannot arrive through the tool: `concurrent_users` is `u64` in
    # the oracle, and `agnosai_tool_input_get_int` reads any negative as absent
    # (which then defaults to 10), so this only pins that the clamp itself adds
    # no floor.
    assert_eq(agnosai_lt_clamp_users(0 - 5), 0 - 5, "and no floor is invented for a negative");

    # ⚠ **The floor lives at the DIVIDE, and asserting the clamp alone missed
    # it.** `load_testing.rs:135` is `MAX_TOTAL_REQUESTS / concurrent_users.max(1)`.
    # Removing the clamp's floor to match `.min(500)` without porting that guard
    # left `100000 / 0` reachable from an unauthenticated `POST /mcp`, and an
    # i64 divide by a runtime zero raises SIGFPE — not per-thread recoverable, so
    # the whole server dies. This drives `agnosai_load_test_run` with 0, which
    # the clamp assertions above never did.
    assert_neq(agnosai_load_test_run(str_from("https://example.com"), 0, 1,
        &_t_exec_ok), 0 - 1,
      "zero users does NOT divide by zero — a SIGFPE here kills the process");
    assert_neq(agnosai_load_test_run(str_from("https://example.com"), 0 - 3, 1,
        &_t_exec_ok), 0 - 1,
      "and neither does a negative");
    assert_eq(agnosai_lt_clamp_users(10), 10, "a normal user count passes through");
    assert_eq(agnosai_lt_clamp_users(9999), 500, "user count clamps down to 500");
    assert_eq(agnosai_lt_clamp_duration(0), 1, "duration clamps up to 1s");
    assert_eq(agnosai_lt_clamp_duration(10), 10, "a normal duration passes through");
    assert_eq(agnosai_lt_clamp_duration(9999), 300, "duration clamps down to 300s");

    # --- the percentile index is the ORACLE's, not nearest-rank ---
    # For n=100 the oracle's p50 is index 50; order.cyr's nearest-rank
    # percentile would give 49. The reported figure must be the oracle's.
    assert_eq(_agnosai_lt_pct_index(100, 50), 50, "p50 of 100 is index 50, not 49");
    assert_eq(_agnosai_lt_pct_index(100, 95), 95, "p95 of 100 is index 95");
    assert_eq(_agnosai_lt_pct_index(100, 99), 99, "p99 of 100 is index 99");
    assert_eq(_agnosai_lt_pct_index(1, 99), 0, "p99 of a single sample is index 0");
    assert_eq(_agnosai_lt_pct_index(10, 99), 9, "the index clamps to len-1");
    assert_eq(_agnosai_lt_pct_index(3, 50), 1, "p50 of 3 is index 1");

    # --- status-count pair vec ---
    var pairs = vec_new();
    _agnosai_lt_status_bump(default_alloc(), pairs, 200, 1);
    _agnosai_lt_status_bump(default_alloc(), pairs, 200, 2);
    _agnosai_lt_status_bump(default_alloc(), pairs, 404, 5);
    assert_eq(vec_len(pairs), 2, "two distinct status codes recorded");
    assert_eq(agnosai_lt_status_count(pairs, 200), 3, "repeat codes accumulate");
    assert_eq(agnosai_lt_status_count(pairs, 404), 5, "a second code is tracked separately");
    assert_eq(agnosai_lt_status_count(pairs, 500), 0, "an unseen code counts zero");

    # --- the real thread fan-out, against a synthetic executor ---
    # 4 OS threads, each with its own arena, each hammering the stub until the
    # 1s deadline or its share of the 100k budget.
    var r = agnosai_load_test_run(str_from("http://example.com/"), 4, 1, &_t_exec_ok);
    assert(r != 0, "the run produced a result");
    assert(agnosai_lt_result_total_requests(r) > 0, "requests were recorded");
    assert_eq(agnosai_lt_result_failed(r), 0, "an always-200 executor reports no failures");
    assert_eq(agnosai_lt_result_successful(r), agnosai_lt_result_total_requests(r),
      "every request counted as successful");
    assert_eq(agnosai_lt_status_count(agnosai_lt_result_status_codes(r), 200),
      agnosai_lt_result_total_requests(r), "every request recorded a 200");

    # the per-user budget caps the total: 4 users x (100000/4) each
    assert(agnosai_lt_result_total_requests(r) <= AGNOSAI_LT_MAX_TOTAL_REQUESTS,
      "the total stays within the 100k cap");

    # latency ordering invariants hold after the sort
    assert(agnosai_lt_result_min_ns(r) <= agnosai_lt_result_p50_ns(r), "min <= p50");
    assert(agnosai_lt_result_p50_ns(r) <= agnosai_lt_result_p95_ns(r), "p50 <= p95");
    assert(agnosai_lt_result_p95_ns(r) <= agnosai_lt_result_p99_ns(r), "p95 <= p99");
    assert(agnosai_lt_result_p99_ns(r) <= agnosai_lt_result_max_ns(r), "p99 <= max");
    assert(agnosai_lt_result_avg_ns(r) >= agnosai_lt_result_min_ns(r), "avg >= min");
    assert(agnosai_lt_result_avg_ns(r) <= agnosai_lt_result_max_ns(r), "avg <= max");

    # --- an all-failing executor: every attempt still records a latency ---
    var rf = agnosai_load_test_run(str_from("http://example.com/"), 2, 1, &_t_exec_fail);
    assert(rf != 0, "the failing run still produced a result");
    assert_eq(agnosai_lt_result_failed(rf), agnosai_lt_result_total_requests(rf),
      "every request failed");
    assert_eq(agnosai_lt_result_successful(rf), 0, "none succeeded");
    assert_eq(vec_len(agnosai_lt_result_status_codes(rf)), 0, "no status codes were recorded");
    assert_eq(load64(rf + AGN_LTR_ERROR_RATE_PPM), 1000000, "the error rate is 100%");

    # --- mixed statuses aggregate across workers ---
    var rm = agnosai_load_test_run(str_from("http://example.com/"), 4, 1, &_t_exec_mixed);
    assert(rm != 0, "the mixed run produced a result");
    assert_eq(vec_len(agnosai_lt_result_status_codes(rm)), 2,
      "both status codes survived aggregation across threads");
    assert(agnosai_lt_status_count(agnosai_lt_result_status_codes(rm), 200) > 0, "some 200s");
    assert(agnosai_lt_status_count(agnosai_lt_result_status_codes(rm), 503) > 0, "some 503s");
    assert_eq(agnosai_lt_status_count(agnosai_lt_result_status_codes(rm), 200)
      + agnosai_lt_status_count(agnosai_lt_result_status_codes(rm), 503),
      agnosai_lt_result_total_requests(rm), "the status counts account for every request");

    # --- the result serializes in the oracle's field order ---
    var rv = agnosai_lt_result_to_value(r);
    assert(str_eq(bayan_json_v_obj_key(rv, 0), str_from("target_url")) == 1, "field 0 is target_url");
    assert(str_eq(bayan_json_v_obj_key(rv, 3), str_from("total_requests")) == 1,
      "field 3 is total_requests");
    assert(str_eq(bayan_json_v_obj_key(rv, 14), str_from("status_codes")) == 1,
      "field 14 is status_codes");
    assert(bayan_json_v_is_float(bayan_json_v_obj_get_by_cstr(rv, "p99_latency_ms")) == 1,
      "latencies serialize as floats in milliseconds");
    assert(bayan_json_v_is_obj(bayan_json_v_obj_get_by_cstr(rv, "status_codes")) == 1,
      "status_codes serializes as an object keyed by code");
    assert(bayan_json_v_obj_get_by_cstr(bayan_json_v_obj_get_by_cstr(rv, "status_codes"), "200") != 0,
      "the 200 count is keyed by its decimal string");

    # --- rounding matches the oracle's 2- and 4-decimal quantisation ---
    assert(str_eq(bayan_json_v_build(_agnosai_lt_ms_value_a(default_alloc(), 1500000)), str_from("1.5")) == 1,
      "1.5ms renders as 1.5");
    assert(str_eq(bayan_json_v_build(_agnosai_lt_ms_value_a(default_alloc(), 1234567)), str_from("1.23")) == 1,
      "latency rounds to 2 decimals");
    assert(str_eq(bayan_json_v_build(_agnosai_lt_rps_value_a(default_alloc(), 1500)), str_from("1.5")) == 1,
      "throughput renders in requests per second");
    assert(str_eq(bayan_json_v_build(_agnosai_lt_rate_value_a(default_alloc(), 1000000)), str_from("1.0")) == 1,
      "a 100% error rate renders as 1.0");
    assert(str_eq(bayan_json_v_build(_agnosai_lt_rate_value_a(default_alloc(), 0)), str_from("0.0")) == 1,
      "a 0% error rate renders as 0.0");

    # --- the tool registers and resolves ---
    var reg = agnosai_register_load_testing_builtin(agnosai_tool_registry_new());
    assert_eq(agnosai_tool_registry_count(reg), 1, "load_testing registered");
    assert(agnosai_tool_registry_get(reg, str_from("load_testing")) != 0,
      "load_testing resolves from the registry");

    # --- worker accessors ---
    var probe = agnosai_lt_worker_new(str_from("http://example.com/"),
      clock_now_ns() + 50000000, 5, &_t_exec_ok, 3);
    assert(probe != 0, "a worker allocates its arenas");
    assert_eq(agnosai_lt_worker_id(probe), 3, "the worker knows its id");
    assert(agnosai_lt_worker_arena(probe) != 0, "the worker has a persistent arena");
    assert(agnosai_lt_worker_scratch(probe) != 0, "the worker has a scratch arena");
    assert_eq(load64(probe + AGN_LT_CONN), 0, "and no connection arena before a real request wants one");
    assert(agnosai_lt_worker_arena(probe) != agnosai_lt_worker_scratch(probe),
      "the two arenas are distinct — a shared one would accumulate every response");
    agnosai_lt_worker_run(probe);
    assert_eq(vec_len(agnosai_lt_worker_latencies(probe)), 5,
      "the worker stops at its request budget");
    assert_eq(agnosai_lt_worker_errors(probe), 0, "an always-200 executor records no errors");
    assert_eq(agnosai_lt_status_count(agnosai_lt_worker_status_counts(probe), 200), 5,
      "the worker recorded five 200s");

    # --- agnosai_lt_aggregate directly, across workers ---
    # Two workers, one returning 200 and one 503, so the cross-worker merge of
    # the status-count pair vecs is observable rather than inferred.
    var deadline = clock_now_ns() + 50000000;
    var w0 = agnosai_lt_worker_new(str_from("http://example.com/"), deadline, 4, &_t_exec_mixed, 0);
    var w1 = agnosai_lt_worker_new(str_from("http://example.com/"), deadline, 6, &_t_exec_mixed, 1);
    agnosai_lt_worker_run(w0);
    agnosai_lt_worker_run(w1);

    var pair_workers = vec_new();
    vec_push(pair_workers, w0);
    vec_push(pair_workers, w1);
    var agg = agnosai_lt_aggregate(pair_workers, str_from("http://example.com/"), 2, 5);
    assert(agg != 0, "aggregate returned a result");
    assert_eq(agnosai_lt_result_total_requests(agg), 10, "both workers' latencies merged");
    assert_eq(agnosai_lt_status_count(agnosai_lt_result_status_codes(agg), 200), 4,
      "worker 0's four 200s survived the merge");
    assert_eq(agnosai_lt_status_count(agnosai_lt_result_status_codes(agg), 503), 6,
      "worker 1's six 503s merged alongside them, not over them");
    # 503 is still a *response*, so it is a success by the oracle's accounting —
    # only a transport error increments `failed`.
    assert_eq(agnosai_lt_result_failed(agg), 0, "an HTTP error status is not a transport failure");
    assert_eq(agnosai_lt_result_successful(agg), 10, "every response counted as successful");

    # aggregate divides by the CONFIGURED duration, not the measured elapsed
    # time — 10 requests over the requested 5s window is 2.0 req/s, and the
    # wire form is the oracle's float, not the integer carrier.
    var agg_v = agnosai_lt_result_to_value(agg);
    assert(str_eq(bayan_json_v_build(bayan_json_v_obj_get_by_cstr(agg_v, "throughput_rps")),
        str_from("2.0")) == 1, "throughput divides by the configured window, not elapsed time");
    assert(str_eq(bayan_json_v_build(bayan_json_v_obj_get_by_cstr(agg_v, "error_rate")),
        str_from("0.0")) == 1, "a clean run serialises a 0.0 error rate");
    assert(str_eq(bayan_json_v_build(
          bayan_json_v_obj_get_by_cstr(bayan_json_v_obj_get_by_cstr(agg_v, "status_codes"), "503")),
        str_from("6")) == 1, "status_codes is keyed by the code as a string");

    # --- the no-request case ---
    assert_eq(agnosai_lt_aggregate(vec_new(), str_from("http://example.com/"), 1, 1), 0,
      "aggregating zero workers yields no result rather than dividing by zero");

    var empty_workers = vec_new();
    vec_push(empty_workers,
      agnosai_lt_worker_new(str_from("http://example.com/"), 0, 0, &_t_exec_ok, 0));
    assert_eq(agnosai_lt_aggregate(empty_workers, str_from("http://example.com/"), 1, 1), 0,
      "a worker that never fired a request yields no result");

    # --- the real HTTP executor fails closed ---
    # `.invalid` is reserved by RFC 2606 and is guaranteed never to resolve, so
    # this exercises the transport-error path identically on and off a network.
    var dead = agnosai_lt_worker_new(str_from("http://nonexistent.invalid/"),
      clock_now_ns() + 1000000000, 1, &agnosai_lt_http_executor, 0);
    assert_eq(agnosai_lt_http_executor(dead), 0,
      "an unresolvable host reports a transport error, not a status code");
    agnosai_lt_worker_run(dead);
    assert_eq(agnosai_lt_worker_errors(dead), 1, "the worker loop counted it as an error");
    assert_eq(vec_len(agnosai_lt_worker_latencies(dead)), 1,
      "a failed attempt still records a latency — that is why total counts errors");

    # --- an exhausted persistent arena stops the worker, it does not spin ---
    # Unreachable through agnosai_lt_worker_new, which sizes the arena from the
    # budget — so the guard is pinned white-box by swapping in a tiny arena.
    # Without the guard the loop would run to the deadline issuing requests
    # whose latencies are all discarded, so the failing shape is a 3s hang
    # rather than a wrong number.
    var starved = agnosai_lt_worker_new(str_from("http://example.com/"),
      clock_now_ns() + 3000000000, 100000, &_t_exec_ok, 0);
    store64(starved + AGN_LT_ARENA, arena_allocator(64));
    var t0 = clock_now_ns();
    agnosai_lt_worker_run(starved);
    var spent = clock_now_ns() - t0;
    assert(spent < 1000000000,
      "the worker stopped on arena exhaustion instead of spinning to its deadline");
    assert(vec_len(agnosai_lt_worker_latencies(starved)) < 100000,
      "it stopped short of its budget");

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
sys_exit_group(f);
