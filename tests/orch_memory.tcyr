# =========================================================================
# orch_memory.tcyr — parity tests for src/orch_memory.cyr
#
# Oracle: the #[cfg(test)] block in rust-old/src/orchestrator/memory.rs —
# 9 tests, all portable.
#
# The two trimming strategies get more than the oracle gives them, because
# their off-by-one boundaries are where a port of this goes wrong: the trim
# guard is `<=` so a buffer exactly at its cap is untouched, `Full` ignores a
# configured cap entirely, and `HeadTail` at max == 1 keeps the LAST message
# rather than the first — sacrificing the head the strategy is named for.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/core_error.cyr"
include "src/core_json.cyr"
include "src/llm_retry.cyr"
include "src/llm_hoosh.cyr"
include "src/orch_memory.cyr"
include "tests/test_helpers.cyr"

# The content of the i-th message in a buffer.
fn _t_at(b, i): i64 {
    return agnosai_chat_message_content(vec_get(agnosai_conv_buffer_messages(b), i));
}

# The role of the i-th message.
fn _t_role(b, i): i64 {
    return agnosai_chat_message_role(vec_get(agnosai_conv_buffer_messages(b), i));
}

# Assert the i-th message's content.
fn _t_is(b, i, want, name): i64 {
    return assert(str_eq(_t_at(b, i), str_from(want)) == 1, name);
}

fn main() {
    alloc_init();

    test_group("orch_memory");

    # --- the strategy wire form ---
    assert(str_eq(agnosai_memory_strategy_to_wire(AGNOSAI_MEMORY_FULL), str_from("full")) == 1,
    "Full is snake_case on the wire");
    assert(str_eq(agnosai_memory_strategy_to_wire(AGNOSAI_MEMORY_SLIDING_WINDOW),
    str_from("sliding_window")) == 1, "and SlidingWindow becomes sliding_window");
    assert(str_eq(agnosai_memory_strategy_to_wire(AGNOSAI_MEMORY_HEAD_TAIL),
    str_from("head_tail")) == 1, "and HeadTail becomes head_tail");

    # --- strategy_serde_roundtrip ---
    assert_eq(agnosai_memory_strategy_from_wire(str_from("full")), AGNOSAI_MEMORY_FULL,
    "full parses back");
    assert_eq(agnosai_memory_strategy_from_wire(str_from("sliding_window")),
    AGNOSAI_MEMORY_SLIDING_WINDOW, "sliding_window parses back");
    assert_eq(agnosai_memory_strategy_from_wire(str_from("head_tail")),
    AGNOSAI_MEMORY_HEAD_TAIL, "head_tail parses back");
    assert_eq(agnosai_memory_strategy_from_wire(str_from("nonsense")), AGNOSAI_MEMORY_FULL,
    "and an unknown spelling falls back to the #[default] Full, which is non-destructive");

    # --- empty_buffer ---
    var e = agnosai_conv_buffer_new(str_from("agent-1"));
    assert_eq(agnosai_conv_buffer_is_empty(e), 1, "a new buffer is empty");
    assert_eq(agnosai_conv_buffer_len(e), 0, "with no messages");
    assert_eq(agnosai_conv_buffer_max_messages(e), 0, "an unlimited cap reads as 0");
    assert_eq(agnosai_conv_buffer_strategy(e), AGNOSAI_MEMORY_FULL, "and the strategy is Full");
    assert(str_eq(agnosai_conv_buffer_agent_id(e), str_from("agent-1")) == 1,
    "and it remembers its agent");

    # --- full_strategy_keeps_all ---
    var full = agnosai_conv_buffer_new(str_from("agent-1"));
    for (var i = 0; i < 100; i = i + 1) {
        agnosai_conv_buffer_add_user(full, str_from("msg"));
    }
    assert_eq(agnosai_conv_buffer_len(full), 100, "Full keeps all 100 messages");
    assert_eq(agnosai_conv_buffer_is_empty(full), 0, "so it is not empty");

    # Full ignores a configured cap. That reads like a bug and is not — the cap
    # is inert unless a trimming strategy is chosen.
    var capped_full = agnosai_conv_buffer_with_strategy(str_from("a"), 3, AGNOSAI_MEMORY_FULL);
    for (var j = 0; j < 10; j = j + 1) { agnosai_conv_buffer_add_user(capped_full, str_from("m")); }
    assert_eq(agnosai_conv_buffer_len(capped_full), 10,
    "Full with a cap of 3 still keeps 10 — the cap is inert without a trimming strategy");

    # --- roles are recorded ---
    var roles = agnosai_conv_buffer_new(str_from("a"));
    agnosai_conv_buffer_add_user(roles, str_from("u"));
    agnosai_conv_buffer_add_assistant(roles, str_from("a"));
    assert_eq(_t_role(roles, 0), AGNOSAI_ROLE_USER, "add_user records the User role");
    assert_eq(_t_role(roles, 1), AGNOSAI_ROLE_ASSISTANT, "add_assistant records Assistant");

    # pushing a pre-built message works too, including a system message, which
    # neither add_* helper produces
    agnosai_conv_buffer_push(roles, agnosai_chat_message_new(AGNOSAI_ROLE_SYSTEM,
    str_from("sys")));
    assert_eq(_t_role(roles, 2), AGNOSAI_ROLE_SYSTEM, "push takes any role");

    # --- sliding_window_no_trim_under_limit ---
    var under = agnosai_conv_buffer_with_sliding_window(str_from("a"), 10);
    agnosai_conv_buffer_add_user(under, str_from("a"));
    agnosai_conv_buffer_add_user(under, str_from("b"));
    assert_eq(agnosai_conv_buffer_len(under), 2, "under the cap nothing is evicted");

    # exactly AT the cap is also untouched — the guard is `<=`, not `<`
    var at_cap = agnosai_conv_buffer_with_sliding_window(str_from("a"), 2);
    agnosai_conv_buffer_add_user(at_cap, str_from("a"));
    agnosai_conv_buffer_add_user(at_cap, str_from("b"));
    assert_eq(agnosai_conv_buffer_len(at_cap), 2, "a buffer exactly at its cap is not trimmed");
    _t_is(at_cap, 0, "a", "so the first message is still there");

    # --- sliding_window_evicts_oldest ---
    var sw = agnosai_conv_buffer_with_sliding_window(str_from("agent-1"), 4);
    agnosai_conv_buffer_add_user(sw, str_from("a"));
    agnosai_conv_buffer_add_assistant(sw, str_from("b"));
    agnosai_conv_buffer_add_user(sw, str_from("c"));
    agnosai_conv_buffer_add_assistant(sw, str_from("d"));
    assert_eq(agnosai_conv_buffer_len(sw), 4, "four messages fit the cap");

    agnosai_conv_buffer_add_user(sw, str_from("e"));
    assert_eq(agnosai_conv_buffer_len(sw), 4, "a fifth does not grow the buffer");
    _t_is(sw, 0, "b", "the oldest message was evicted, so 'b' is now first");
    _t_is(sw, 3, "e", "and the newest is last");

    # trimming happens on every push, so the buffer is never observed over its
    # cap rather than being trimmed lazily on read
    for (var k = 0; k < 20; k = k + 1) { agnosai_conv_buffer_add_user(sw, str_from("x")); }
    assert_eq(agnosai_conv_buffer_len(sw), 4, "twenty more pushes still leave exactly four");

    # a cap of 1 keeps only the newest
    var one = agnosai_conv_buffer_with_sliding_window(str_from("a"), 1);
    agnosai_conv_buffer_add_user(one, str_from("first"));
    agnosai_conv_buffer_add_user(one, str_from("second"));
    assert_eq(agnosai_conv_buffer_len(one), 1, "a sliding cap of 1 holds one message");
    _t_is(one, 0, "second", "which is the newest");

    # --- head_tail_keeps_first_and_last ---
    var ht = agnosai_conv_buffer_with_head_tail(str_from("agent-1"), 3);
    agnosai_conv_buffer_add_user(ht, str_from("first"));
    agnosai_conv_buffer_add_assistant(ht, str_from("mid-1"));
    agnosai_conv_buffer_add_user(ht, str_from("mid-2"));
    assert_eq(agnosai_conv_buffer_len(ht), 3, "three fit the cap");

    agnosai_conv_buffer_add_assistant(ht, str_from("last"));
    assert_eq(agnosai_conv_buffer_len(ht), 3, "a fourth does not grow it");
    _t_is(ht, 0, "first", "the FIRST message is kept — it carries the task framing");
    _t_is(ht, 1, "mid-2", "the middle was dropped");
    _t_is(ht, 2, "last", "and the newest is last");

    # pushing more keeps dropping from the middle, never the head
    agnosai_conv_buffer_add_user(ht, str_from("newer"));
    assert_eq(agnosai_conv_buffer_len(ht), 3, "still three");
    _t_is(ht, 0, "first", "the head survives every subsequent eviction");
    _t_is(ht, 2, "newer", "and the tail tracks the newest message");

    # --- head_tail_max_one_keeps_last ---
    # The asymmetry worth pinning: at max == 1 there is no room for both ends,
    # and the oracle's special case keeps the LAST message, sacrificing the head
    # the strategy is named for.
    var ht1 = agnosai_conv_buffer_with_head_tail(str_from("a"), 1);
    agnosai_conv_buffer_add_user(ht1, str_from("first"));
    agnosai_conv_buffer_add_user(ht1, str_from("second"));
    agnosai_conv_buffer_add_user(ht1, str_from("third"));
    assert_eq(agnosai_conv_buffer_len(ht1), 1, "a head-tail cap of 1 holds one message");
    _t_is(ht1, 0, "third",
    "and it is the LAST, not the first — head-tail at max 1 sacrifices the head");

    # max == 2 keeps first + last, with no middle at all
    var ht2 = agnosai_conv_buffer_with_head_tail(str_from("a"), 2);
    agnosai_conv_buffer_add_user(ht2, str_from("first"));
    agnosai_conv_buffer_add_user(ht2, str_from("mid"));
    agnosai_conv_buffer_add_user(ht2, str_from("last"));
    assert_eq(agnosai_conv_buffer_len(ht2), 2, "a cap of 2 holds two");
    _t_is(ht2, 0, "first", "the head");
    _t_is(ht2, 1, "last", "and the tail, with the middle gone");

    # --- clear_removes_all ---
    var cl = agnosai_conv_buffer_new(str_from("a"));
    agnosai_conv_buffer_add_user(cl, str_from("a"));
    agnosai_conv_buffer_add_user(cl, str_from("b"));
    assert_eq(agnosai_conv_buffer_len(cl), 2, "two before the clear");
    agnosai_conv_buffer_clear(cl);
    assert_eq(agnosai_conv_buffer_len(cl), 0, "none after");
    assert_eq(agnosai_conv_buffer_is_empty(cl), 1, "and it reports empty");
    agnosai_conv_buffer_add_user(cl, str_from("c"));
    assert_eq(agnosai_conv_buffer_len(cl), 1, "and it is reusable afterwards");
    _t_is(cl, 0, "c", "holding only what was pushed since");

    # --- to_vec_clones_messages ---
    var tv = agnosai_conv_buffer_new(str_from("a"));
    agnosai_conv_buffer_add_user(tv, str_from("a"));
    var snapshot = agnosai_conv_buffer_to_vec(tv);
    assert_eq(vec_len(snapshot), 1, "the snapshot has the message");
    assert(snapshot != agnosai_conv_buffer_messages(tv),
    "and is a distinct vec, not the live one");
    agnosai_conv_buffer_add_user(tv, str_from("b"));
    assert_eq(vec_len(snapshot), 1,
    "so a later push does not change it — which is what to_vec is for");
    assert_eq(agnosai_conv_buffer_len(tv), 2, "while the buffer itself grew");

    # clearing the buffer does not empty a snapshot taken beforehand
    agnosai_conv_buffer_clear(tv);
    assert_eq(vec_len(snapshot), 1, "and clear does not reach into an earlier snapshot");

    # --- trim is idempotent and safe to call directly ---
    var idem = agnosai_conv_buffer_with_sliding_window(str_from("a"), 2);
    agnosai_conv_buffer_add_user(idem, str_from("a"));
    agnosai_conv_buffer_add_user(idem, str_from("b"));
    agnosai_conv_buffer_trim(idem);
    agnosai_conv_buffer_trim(idem);
    assert_eq(agnosai_conv_buffer_len(idem), 2, "trimming an in-bounds buffer changes nothing");
    agnosai_conv_buffer_trim(agnosai_conv_buffer_new(str_from("a")));
    assert_eq(agnosai_conv_buffer_len(e), 0, "and trimming an empty buffer is a no-op");

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
