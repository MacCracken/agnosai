# =========================================================================
# orch_output_validation.tcyr — parity tests for src/orchestrator/output_validation.cyr
#
# Oracle: the #[cfg(test)] block in
# rust-old/src/orchestrator/output_validation.rs — 11 tests, all portable
# verbatim since the module is a pure leaf with no I/O.
#
# The fence extractor gets substantially more attention than the oracle gives
# it, because its control flow is subtle in a way the oracle's tests do not
# reach: the `?` on the closing-fence lookup abandons the whole function rather
# than trying the next opening marker, and an *empty* block does fall through.
# Those two behaviours are one character apart in Rust and easy to get backwards
# in a port.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/orchestrator/output_validation.cyr"
include "tests/test_helpers.cyr"

# Parse a JSON literal into a value, for building schemas.
fn _t_json(src): i64 {
    return bayan_json_v_parse_buf(src, strlen(src));
}

# Validate a literal against a schema literal; returns 0 or the error Str.
fn _t_val(output, schema_src): i64 {
    return agnosai_validate_output(str_from(output), _t_json(schema_src));
}

# Assert a literal validates clean.
fn _t_valid(output, schema_src, name): i64 {
    return assert_eq(_t_val(output, schema_src), 0, name);
}

# Assert a literal fails validation with a message containing `want`.
fn _t_invalid(output, schema_src, want, name): i64 {
    var r = _t_val(output, schema_src);
    if (r == 0) { return assert(0, name); }
    return assert(str_contains(r, str_from(want)) == 1, name);
}

fn main() {
    alloc_init();

    test_group("orch_output_validation");

    assert_eq(AGNOSAI_MAX_VALIDATION_RETRIES, 2, "the retry cap is 2");

    # --- valid_json_object_with_required_fields ---
    _t_valid("{\"name\": \"test\", \"score\": 42}",
      "{\"type\":\"object\",\"required\":[\"name\",\"score\"]}", "an object with both fields passes");

    # --- missing_required_field ---
    _t_invalid("{\"name\": \"test\"}", "{\"type\":\"object\",\"required\":[\"name\",\"score\"]}",
      "score", "a missing field is named in the error");
    assert(str_eq(_t_val("{\"name\": \"test\"}",
          "{\"type\":\"object\",\"required\":[\"name\",\"score\"]}"),
        str_from("Missing required fields: score")) == 1, "with the oracle's exact wording");

    # several missing fields join with ", " in the schema's order
    assert(str_eq(_t_val("{}", "{\"required\":[\"a\",\"b\",\"c\"]}"),
        str_from("Missing required fields: a, b, c")) == 1,
      "several missing fields join in the schema's order, not the object's");

    # --- not_valid_json ---
    _t_invalid("this is not json", "{\"type\":\"object\"}", "not valid JSON",
      "unparseable input is reported as such");
    assert(str_contains(_t_val("this is not json", "{\"type\":\"object\"}"),
        str_from("Response is not valid JSON: ")) == 1,
      "the wrapper wording is the oracle's; the detail after the colon is bayan's");
    _t_invalid("", "{}", "not valid JSON", "empty input is not valid JSON");
    _t_invalid("{\"unterminated\": ", "{}", "not valid JSON", "truncated input is not valid JSON");

    # --- wrong_type ---
    _t_invalid("[1, 2, 3]", "{\"type\":\"object\"}", "array", "an array against object names array");
    assert(str_eq(_t_val("[1, 2, 3]", "{\"type\":\"object\"}"),
        str_from("Expected top-level type \"object\", got \"array\"")) == 1,
      "with the oracle's exact wording and quoting");

    # --- array_type_valid ---
    _t_valid("[1, 2, 3]", "{\"type\":\"array\"}", "an array against array passes");

    # --- no_schema_constraints_passes_any_json ---
    _t_valid("{\"anything\": true}", "{}", "an empty schema admits an object");
    _t_valid("42", "{}", "an empty schema admits a number");
    _t_valid("\"hello\"", "{}", "an empty schema admits a string");
    _t_valid("null", "{}", "an empty schema admits null");
    _t_valid("[]", "{}", "an empty schema admits an array");

    # --- required_on_non_object_fails ---
    _t_invalid("\"just a string\"", "{\"type\":\"string\",\"required\":[\"field\"]}",
      "not a JSON object", "required against a non-object is refused");
    assert(str_eq(_t_val("\"just a string\"", "{\"type\":\"string\",\"required\":[\"field\"]}"),
        str_from("Schema requires fields but response is not a JSON object")) == 1,
      "with the oracle's exact wording");

    # ...but an EMPTY required list does not, because the oracle guards on
    # `!required.is_empty()`. One character of difference in the port.
    _t_valid("\"just a string\"", "{\"type\":\"string\",\"required\":[]}",
      "an empty required list still admits a non-object");
    _t_valid("42", "{\"required\":[]}", "likewise a number");

    # --- the type check runs before the required check ---
    # Both are wrong here; the oracle reports the type, because step 2 precedes
    # step 3 and returns early.
    assert(str_contains(_t_val("[1]", "{\"type\":\"object\",\"required\":[\"x\"]}"),
        str_from("Expected top-level type")) == 1,
      "with both checks failing the type error wins, matching the oracle's order");

    # --- json_type_name covers every serde variant ---
    assert(str_eq_cstr(str_from(agnosai_json_type_name(_t_json("null"))), "null") == 1,
      "null names null");
    assert(str_eq_cstr(str_from(agnosai_json_type_name(_t_json("true"))), "boolean") == 1,
      "a bool names boolean, not bool");
    assert(str_eq_cstr(str_from(agnosai_json_type_name(_t_json("42"))), "number") == 1,
      "an integer names number");
    assert(str_eq_cstr(str_from(agnosai_json_type_name(_t_json("1.5"))), "number") == 1,
      "a float names number too — serde does not distinguish them here");
    assert(str_eq_cstr(str_from(agnosai_json_type_name(_t_json("\"s\""))), "string") == 1,
      "a string names string");
    assert(str_eq_cstr(str_from(agnosai_json_type_name(_t_json("[]"))), "array") == 1,
      "an array names array");
    assert(str_eq_cstr(str_from(agnosai_json_type_name(_t_json("{}"))), "object") == 1,
      "an object names object");

    _t_valid("true", "{\"type\":\"boolean\"}", "a boolean schema matches a bool");
    _t_valid("1.5", "{\"type\":\"number\"}", "a number schema matches a float");
    _t_valid("null", "{\"type\":\"null\"}", "a null schema matches null");
    _t_invalid("42", "{\"type\":\"string\"}", "got \"number\"", "a number against string fails");

    # the type match is case-sensitive, as `!=` is in the oracle
    _t_invalid("{}", "{\"type\":\"Object\"}", "Expected top-level type",
      "the type comparison is case-sensitive");

    # a non-string `type` is ignored — the oracle's `.and_then(as_str)`
    _t_valid("{}", "{\"type\":42}", "a non-string type is ignored, not an error");
    # a non-array `required` is likewise ignored
    _t_valid("{}", "{\"required\":\"name\"}", "a non-array required is ignored");
    # a non-string entry INSIDE required is skipped, not reported missing
    _t_valid("{\"a\":1}", "{\"required\":[\"a\",7]}",
      "a non-string entry in required is skipped, matching filter_map(as_str)");

    # --- extract_json_from_markdown_fence ---
    var out = 0;
    var text1 = str_from("Here is the result:\n```json\n{\"key\": \"value\"}\n```\nDone.");
    assert_eq(agnosai_extract_and_validate(text1, _t_json("{\"type\":\"object\",\"required\":[\"key\"]}"),
        &out), 0, "a fenced object validates");
    assert(str_eq(out, str_from("{\"key\": \"value\"}")) == 1,
      "and the extracted text is the block, trimmed");

    # --- extract_json_from_plain_fence ---
    var out2 = 0;
    assert_eq(agnosai_extract_and_validate(str_from("Result:\n```\n{\"a\": 1}\n```"),
        _t_json("{\"type\":\"object\"}"), &out2), 0, "a plain fence works too");

    # --- no_fence_falls_back_to_raw ---
    var out3 = 0;
    assert_eq(agnosai_extract_and_validate(str_from("{\"valid\": true}"),
        _t_json("{\"type\":\"object\"}"), &out3), 0, "raw JSON needs no fence");
    assert(str_eq(out3, str_from("{\"valid\": true}")) == 1, "and comes back unchanged");

    # --- fence_with_backticks_in_json_value ---
    # The closing delimiter is newline-plus-backticks, which is what lets a JSON
    # string value carry literal triple backticks.
    var out4 = 0;
    var text4 = str_from("Result:\n```json\n{\"code\": \"use ```markdown``` here\"}\n```\nDone.");
    assert_eq(agnosai_extract_and_validate(text4,
        _t_json("{\"type\":\"object\",\"required\":[\"code\"]}"), &out4), 0,
      "triple backticks inside a JSON string do not break extraction");
    assert(str_contains(out4, str_from("markdown")) == 1, "and the value survives intact");

    # --- the extractor's control flow, which the oracle's tests do not reach ---
    assert_eq(agnosai_extract_json_block(str_from("no fences here")), 0, "no fence yields 0");
    assert(str_eq(agnosai_extract_json_block(str_from("a\n```json\n{\"x\":1}\n```\nb")),
        str_from("{\"x\":1}")) == 1, "a json fence extracts its block");
    assert(str_eq(agnosai_extract_json_block(str_from("a\n```\n{\"x\":1}\n```\nb")),
        str_from("{\"x\":1}")) == 1, "a bare fence extracts its block");

    # an UNTERMINATED first marker abandons the whole search — the oracle's `?`
    # returns from extract_json_block rather than trying the next marker, so the
    # well-formed bare fence below is NOT reached
    assert_eq(agnosai_extract_json_block(str_from("```json\nunterminated and then\n{\"x\":1}")), 0,
      "an unterminated fence yields 0 rather than falling through to a later marker");

    # An EMPTY block does fall through to the next marker — the one case where
    # the oracle's loop actually iterates. The result is deliberately quirky and
    # is pinned as-is rather than tidied, because it is what the oracle returns.
    #
    # Trace for "```json\n" + "\n```\n```\n{\"y\":2}\n```":
    #   marker "```json\n" matches at 0; remainder starts "\n```", so the
    #   closing fence is found at offset 0 and the block trims to empty ->
    #   fall through. Marker "```\n" then re-scans FROM THE START and matches
    #   the *closing* fence of that empty block at index 9, so its remainder
    #   opens with the next "```" and the extracted block carries a fence.
    assert(str_eq(agnosai_extract_json_block(str_from("```json\n\n```\n```\n{\"y\":2}\n```")),
        str_from("```\n{\"y\":2}")) == 1,
      "an empty first block falls through, and the re-scan can capture a fence with it");

    # the block is trimmed
    assert(str_eq(agnosai_extract_json_block(str_from("```json\n   {\"x\":1}   \n```")),
        str_from("{\"x\":1}")) == 1, "surrounding whitespace is trimmed off the block");

    # CRLF fences
    assert(str_eq(agnosai_extract_json_block(str_from("```json\r\n{\"x\":1}\r\n```")),
        str_from("{\"x\":1}")) == 1, "a CRLF fence works and the \\r is trimmed away");

    # --- the fenced error is preferred over the raw error ---
    # The oracle returns the FENCED block's failure even when it also fails,
    # because that block "is more likely what was intended".
    var out5 = 0;
    var text5 = str_from("Sure!\n```json\n{\"wrong\": 1}\n```");
    var r5 = agnosai_extract_and_validate(text5,
      _t_json("{\"type\":\"object\",\"required\":[\"right\"]}"), &out5);
    assert(r5 != 0, "a fenced block that fails validation still fails");
    assert(str_contains(r5, str_from("right")) == 1,
      "and the error is the FENCED block's, not the surrounding prose's parse failure");
    assert(str_eq(out5, str_from("{\"wrong\": 1}")) == 1,
      "with the extracted block returned as the text that was checked");

    # with no fence at all, the raw error comes back with the raw text
    var out6 = 0;
    var r6 = agnosai_extract_and_validate(str_from("just prose"), _t_json("{}"), &out6);
    assert(r6 != 0, "prose with no fence fails");
    assert(str_eq(out6, str_from("just prose")) == 1, "and the raw text is what comes back");

    # --- build_retry_prompt_includes_error ---
    var prompt = agnosai_build_retry_prompt(str_from("Summarize this"), str_from("not json"),
      str_from("not valid JSON"), _t_json("{\"type\":\"object\"}"));
    assert(str_contains(prompt, str_from("Summarize this")) == 1, "the prompt carries the original");
    assert(str_contains(prompt, str_from("not valid JSON")) == 1, "and the error");
    assert(str_contains(prompt, str_from("not json")) == 1, "and the failed output");
    assert(str_contains(prompt, str_from("schema")) == 1, "and mentions the schema");

    # the layout is the oracle's template, not merely a bag of the right pieces
    assert(str_starts_with(prompt, str_from("Summarize this\n\nYour previous response failed")) == 1,
      "the prompt opens with the original followed by the failure line");
    assert(str_contains(prompt, str_from("Error: not valid JSON\nYour previous response was:\n```\n"))
      == 1, "the error and the fenced failed output follow in the oracle's order");
    assert(str_contains(prompt,
        str_from("Please respond with ONLY valid JSON matching this schema:\n```json\n")) == 1,
      "and the schema fence closes it");
    assert(str_ends_with(prompt, str_from("\n```")) == 1, "the prompt ends with the closing fence");
    assert(str_contains(prompt, str_from("{\"type\":\"object\"}")) == 1,
      "the schema is rendered compactly, as serde_json's Display does");

    # --- validate_value directly, without a parse ---
    assert_eq(agnosai_validate_value(_t_json("{\"a\":1}"), _t_json("{\"required\":[\"a\"]}")), 0,
      "validate_value takes an already-parsed value");
    assert(agnosai_validate_value(_t_json("{}"), _t_json("{\"required\":[\"a\"]}")) != 0,
      "and reports the same failures");
    assert_eq(agnosai_validate_value(_t_json("{}"), 0), 0,
      "a null schema constrains nothing rather than crashing");

    # --- the retry log is guarded on level, not on content ---
    assert_eq(agnosai_validation_log_retry(str_from("task-1"), 1, str_from("boom")), 0,
      "logging a retry is side-effect only and returns 0");

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
