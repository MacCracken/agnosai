fn _t_state_auth(auth): i64 {
    var o = agnosai_orchestrator_new(agnosai_resource_budget_default());
    agnosai_orchestrator_with_audit(o, 0);
    agnosai_orchestrator_with_events(o, agnosai_event_bus_new());
    return agnosai_app_state_new(o, agnosai_tool_registry_new(), auth, load64(o + AGN_OR_EVENTS), 0,
      agnosai_orchestrator_approval_gate(o));
}

fn _t_state(): i64 { return _t_state_auth(agnosai_auth_config_new()); }

# A request's text as it arrives: the request line, `headers` (each line ending CRLF) and `body`.
fn _t_hdrs(headers, body: Str): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "POST /a2a HTTP/1.1\r\nHost: agnosai.test\r\n");
    str_builder_add_cstr(sb, headers);
    str_builder_add_cstr(sb, "\r\n");
    str_builder_add(sb, body);
    return agnosai_http_headers_of_a(default_alloc(), str_builder_build(sb));
}

# A JSON-RPC request for `method`, `params` a JSON literal or 0.
fn _t_rpc(method, params): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"");
    str_builder_add_cstr(sb, method);
    str_builder_add_cstr(sb, "\"");
    if (params != 0) {
        str_builder_add_cstr(sb, ",\"params\":");
        str_builder_add_cstr(sb, params);
    }
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# `method` sent with `A2A-Version: 1.0`.
fn _t_call(s, method, params): i64 {
    var body = _t_rpc(method, params);
    return agnosai_route_a2a_rpc_h_a(default_alloc(), s, body, 0, _t_hdrs("A2A-Version: 1.0\r\n", body));
}

# A SendMessage's params: a user message saying `text`, and `extra` fields of params (a JSON
# fragment ending in a comma, or "").
fn _t_send_params(text, extra): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    str_builder_add_cstr(sb, extra);
    str_builder_add_cstr(sb, "\"message\":{\"messageId\":\"m-1\",\"role\":\"ROLE_USER\",\"parts\":[{\"text\":\"");
    str_builder_add_cstr(sb, text);
    str_builder_add_cstr(sb, "\"}]}}");
    return str_cstr(str_builder_build(sb));
}

fn _t_obj(v, key): i64 { return bayan_json_v_obj_get_by_cstr(v, key); }

fn _t_str_is(v, key, want): i64 {
    var x = _t_obj(v, key);
    if (x == 0 || bayan_json_v_is_str(x) == 0) { return 0; }
    return str_eq_cstr(bayan_json_v_str(x), want);
}

fn _t_result(r): i64 { return _t_obj(agnosai_route_body(r), "result"); }

fn _t_code(r): i64 {
    var e = _t_obj(agnosai_route_body(r), "error");
    if (e == 0) { return 0; }
    return bayan_json_v_int(_t_obj(e, "code"));
}

# The `ErrorInfo` reason an error carries, 1 when it is `want`.
fn _t_reason_is(r, want): i64 {
    var d = _t_obj(_t_obj(agnosai_route_body(r), "error"), "data");
    if (d == 0 || bayan_json_v_arr_len(d) != 1) { return 0; }
    var info = bayan_json_v_arr_get(d, 0);
    if (_t_str_is(info, "@type", "type.googleapis.com/google.rpc.ErrorInfo") == 0) { return 0; }
    if (_t_str_is(info, "domain", "a2a-protocol.org") == 0) { return 0; }
    return _t_str_is(info, "reason", want);
}

fn _t_state_of(task): i64 { return _t_obj(_t_obj(task, "status"), "state"); }

fn _t_task_state_is(task, want): i64 {
    var s = _t_state_of(task);
    if (s == 0) { return 0; }
    return str_eq_cstr(bayan_json_v_str(s), want);
}

# --- the Agent Card ---------------------------------------------------------

fn _t_card_suite(): i64 {
    var s = _t_state();
    var r = agnosai_route_a2a_card_a(default_alloc(), s, _t_hdrs("", str_from("")));
    assert_eq(agnosai_route_status(r), HTTP_OK, "the card is served");
    var c = agnosai_route_body(r);
    assert(_t_str_is(c, "name", "agnosai") == 1, "naming the agent");
    assert(_t_obj(c, "description") != 0, "and saying what it does");
    assert(_t_str_is(c, "version", AGNOSAI_VERSION) == 1, "at its version");
    var ifs = _t_obj(c, "supportedInterfaces");
    assert_eq(bayan_json_v_arr_len(ifs), 1, "with one interface");
    var i0 = bayan_json_v_arr_get(ifs, 0);
    assert(_t_str_is(i0, "url", "http://agnosai.test/a2a") == 1, "at the request's host, without a public URL");
    assert(_t_str_is(i0, "protocolBinding", "JSONRPC") == 1, "on the JSON-RPC binding");
    assert(_t_str_is(i0, "protocolVersion", "1.0") == 1, "at 1.0");
    var caps = _t_obj(c, "capabilities");
    assert_eq(bayan_json_v_bool(_t_obj(caps, "streaming")), 1, "it streams");
    assert_eq(bayan_json_v_bool(_t_obj(caps, "pushNotifications")), 0, "and sends no push notifications");
    assert_eq(bayan_json_v_bool(_t_obj(caps, "extendedAgentCard")), 0, "and has no extended card");
    assert_eq(bayan_json_v_arr_len(_t_obj(c, "defaultInputModes")), 2, "it reads text and JSON");
    assert_eq(bayan_json_v_arr_len(_t_obj(c, "defaultOutputModes")), 1, "and answers text");
    var sk = bayan_json_v_arr_get(_t_obj(c, "skills"), 0);
    assert(_t_str_is(sk, "id", "run-crew") == 1, "its skill is running a crew");
    assert(_t_obj(sk, "name") != 0 && _t_obj(sk, "description") != 0, "named and described");
    assert_eq(bayan_json_v_arr_len(_t_obj(sk, "tags")), 3, "and tagged");
    assert_eq(_t_obj(c, "securitySchemes"), 0, "with auth off, no scheme");
    assert_eq(_t_obj(c, "url"), 0, "and none of 0.3's fields: no top-level url");
    assert_eq(_t_obj(c, "protocolVersion"), 0, "nor protocolVersion");
    assert(streq(agnosai_route_headers(r), "Cache-Control: no-cache\r\n") == 1,
      "naming a request's host, no shared cache may keep it");

    var bad = agnosai_route_a2a_card_a(default_alloc(), s,
      agnosai_http_headers_of_a(default_alloc(), str_from("GET / HTTP/1.1\r\nHost: evil.test/x?\r\n\r\n")));
    var bi = bayan_json_v_arr_get(_t_obj(agnosai_route_body(bad), "supportedInterfaces"), 0);
    assert(_t_str_is(bi, "url", "http://localhost/a2a") == 1, "a host a URL cannot carry is not written into it");
    var none = agnosai_route_a2a_card_a(default_alloc(), s, 0);
    var ni = bayan_json_v_arr_get(_t_obj(agnosai_route_body(none), "supportedInterfaces"), 0);
    assert(_t_str_is(ni, "url", "http://localhost/a2a") == 1, "nor is a missing one");

    var cfg = agnosai_a2a_config_with_public_url(agnosai_a2a_config_new(), str_from("https://agents.example.com/"));
    assert(str_eq_cstr(agnosai_a2a_config_public_url(cfg), "https://agents.example.com") == 1,
      "a public URL is kept without its trailing slash");
    assert_eq(agnosai_a2a_config_public_url(agnosai_a2a_config_new()), 0, "and there is none unless set");
    agnosai_app_state_with_a2a(s, cfg);
    assert_eq(agnosai_app_state_a2a(s), cfg, "the app state holds the endpoint's settings");
    var pr = agnosai_route_a2a_card_a(default_alloc(), s, _t_hdrs("", str_from("")));
    var pi = bayan_json_v_arr_get(_t_obj(agnosai_route_body(pr), "supportedInterfaces"), 0);
    assert(_t_str_is(pi, "url", "https://agents.example.com/a2a") == 1,
      "the configured public URL wins, its trailing slash dropped");
    assert(streq(agnosai_route_headers(pr), "Cache-Control: public, max-age=300\r\n") == 1,
      "and then any cache may keep the card five minutes");

    var auth = agnosai_auth_config_with_secret(str_from("s3cret"));
    var sa = _t_state_auth(auth);
    var ac = agnosai_route_body(agnosai_route_a2a_card_a(default_alloc(), sa, 0));
    var http = _t_obj(_t_obj(_t_obj(ac, "securitySchemes"), "bearer"), "httpAuthSecurityScheme");
    assert(_t_str_is(http, "scheme", "Bearer") == 1, "with auth on, the card declares the bearer scheme");
    assert_eq(_t_obj(http, "bearerFormat"), 0, "a shared secret's, which is no JWT");
    var req = bayan_json_v_arr_get(_t_obj(ac, "securityRequirements"), 0);
    assert(_t_obj(_t_obj(_t_obj(req, "schemes"), "bearer"), "list") != 0, "and requires it");

    # Through the router: public, whatever auth says; and the endpoint it names, not.
    var g = agnosai_route_dispatch_h_a(default_alloc(), sa, AGNOSAI_METHOD_GET,
      str_from("/.well-known/agent-card.json"), str_from(""), 0, str_from(""), 1, 0, 0);
    assert_eq(agnosai_route_status(g), HTTP_OK, "the card needs no token, as discovery cannot have one");
    var p = agnosai_route_dispatch_h_a(default_alloc(), sa, AGNOSAI_METHOD_POST,
      str_from("/a2a"), str_from(""), 0, _t_rpc("GetTask", "{\"id\":\"x\"}"), 1, 0, 0);
    assert_eq(agnosai_route_status(p), HTTP_UNAUTHORIZED, "and the endpoint needs one");
    var pc = agnosai_route_dispatch_h_a(default_alloc(), sa, AGNOSAI_METHOD_POST,
      str_from("/.well-known/agent-card.json"), str_from(""), 0, str_from(""), 1, 0, 0);
    assert_eq(agnosai_route_status(pc), HTTP_METHOD_NOT_ALLOWED, "the card is GET only");
    return 0;
}

# --- the version, and the envelope -----------------------------------------------

# A stream that marks its job and answers its descriptor.
fn _t_any_stream(job, cfd): i64 {
    store64(job, 1);
    return cfd;
}

fn _t_version_suite(): i64 {
    var s = _t_state();
    var body = _t_rpc("GetTask", "{\"id\":\"nope\"}");
    var none = agnosai_route_a2a_rpc_h_a(default_alloc(), s, body, 0, _t_hdrs("", body));
    assert_eq(agnosai_route_status(none), HTTP_OK, "a JSON-RPC error is in band, on a 200");
    assert_eq(_t_code(none), AGNOSAI_A2A_VERSION_NOT_SUPPORTED, "a request naming no version is 0.3's, and refused");
    assert(_t_reason_is(none, "VERSION_NOT_SUPPORTED") == 1, "with an ErrorInfo saying so");
    assert_eq(bayan_json_v_int(_t_obj(agnosai_route_body(none), "id")), 7, "echoing the request's id");
    var old = agnosai_route_a2a_rpc_h_a(default_alloc(), s, body, 0, _t_hdrs("A2A-Version: 0.3\r\n", body));
    assert_eq(_t_code(old), AGNOSAI_A2A_VERSION_NOT_SUPPORTED, "so is one naming 0.3");
    var newer = agnosai_route_a2a_rpc_h_a(default_alloc(), s, body, 0, _t_hdrs("A2A-Version: 1.1\r\n", body));
    assert_eq(_t_code(newer), AGNOSAI_A2A_VERSION_NOT_SUPPORTED, "and one naming 1.1");
    var patch = agnosai_route_a2a_rpc_h_a(default_alloc(), s, body, 0, _t_hdrs("A2A-Version: 1.0.3\r\n", body));
    assert_eq(_t_code(patch), AGNOSAI_A2A_TASK_NOT_FOUND, "a patch number is ignored");
    var junk = agnosai_route_a2a_rpc_h_a(default_alloc(), s, body, 0, _t_hdrs("A2A-Version: 1.0.x\r\n", body));
    assert_eq(_t_code(junk), AGNOSAI_A2A_VERSION_NOT_SUPPORTED, "and a version that is not one is refused");

    var parse = agnosai_route_a2a_rpc_h_a(default_alloc(), s, str_from("{\"jsonrpc\""), 0,
      _t_hdrs("A2A-Version: 1.0\r\n", str_from("")));
    assert_eq(_t_code(parse), AGNOSAI_A2A_PARSE_ERROR, "a body that is not JSON is -32700");
    assert_eq(_t_reason_is(parse, "x"), 0, "and a JSON-RPC error carries no ErrorInfo");
    var noid = str_from("{\"jsonrpc\":\"2.0\",\"method\":\"GetTask\",\"params\":{\"id\":\"x\"}}");
    var ni = agnosai_route_a2a_rpc_h_a(default_alloc(), s, noid, 0, _t_hdrs("A2A-Version: 1.0\r\n", noid));
    assert_eq(_t_code(ni), AGNOSAI_A2A_INVALID_REQUEST, "every A2A method is a request: one with no id is -32600");
    var nover = str_from("{\"id\":1,\"method\":\"GetTask\"}");
    var nv = agnosai_route_a2a_rpc_h_a(default_alloc(), s, nover, 0, _t_hdrs("A2A-Version: 1.0\r\n", nover));
    assert_eq(_t_code(nv), AGNOSAI_A2A_INVALID_REQUEST, "and so is one with no jsonrpc");

    assert_eq(_t_code(_t_call(s, "message/send", 0)), AGNOSAI_A2A_METHOD_NOT_FOUND, "0.3's names are gone: -32601");
    assert_eq(_t_code(agnosai_route_a2a_rpc_a(default_alloc(), s, body)), AGNOSAI_A2A_VERSION_NOT_SUPPORTED,
      "the form with no request has no version header, so is refused as 0.3");
    var job = alloc(8);
    var sr = agnosai_route_stream_a(default_alloc(), &_t_any_stream, job);
    assert_eq(agnosai_route_is_stream(sr), 1, "a route can answer with a stream");
    assert_eq(agnosai_route_stream_run(sr, 9), 9, "which runs with its job, on the descriptor it is given");
    assert_eq(load64(job), 1, "its job the one it was made with");
    assert_eq(agnosai_route_is_stream(agnosai_route_json_a(default_alloc(), HTTP_OK, 0)), 0, "a body is no stream");
    assert_eq(_t_code(_t_call(s, "CreateTaskPushNotificationConfig", "{}")), AGNOSAI_A2A_PUSH_NOT_SUPPORTED,
      "push notifications are not supported");
    assert(_t_reason_is(_t_call(s, "ListTaskPushNotificationConfigs", "{}"), "PUSH_NOTIFICATION_NOT_SUPPORTED") == 1,
      "by any of the four methods");
    assert_eq(_t_code(_t_call(s, "GetExtendedAgentCard", 0)), AGNOSAI_A2A_UNSUPPORTED_OPERATION,
      "nor an extended card");
    return 0;
}

# --- SendMessage, GetTask ------------------------------------------------------

fn _t_send_suite(): i64 {
    var s = _t_state();
    var r = _t_call(s, "SendMessage", _t_send_params("check the release notes", ""));
    assert_eq(_t_code(r), 0, "a message is taken");
    var t = _t_obj(_t_result(r), "task");
    assert(t != 0, "and answered with its task");
    var id = bayan_json_v_str(_t_obj(t, "id"));
    assert_eq(str_len(id), 36, "whose id is its crew's");
    assert(agnosai_orchestrator_crew(agnosai_app_state_orchestrator(s), id) != 0, "a crew in the registry");
    assert(_t_task_state_is(t, "TASK_STATE_COMPLETED") == 1, "run to its end, as SendMessage blocks by default");
    var ctx = bayan_json_v_str(_t_obj(t, "contextId"));
    assert_eq(str_len(ctx), 36, "in a context the agent made, the client naming none");
    var arts = _t_obj(t, "artifacts");
    assert_eq(bayan_json_v_arr_len(arts), 1, "its one result an artifact");
    var art = bayan_json_v_arr_get(arts, 0);
    assert(_t_obj(art, "artifactId") != 0, "named by its crew task's id");
    var part = bayan_json_v_arr_get(_t_obj(art, "parts"), 0);
    assert(_t_obj(part, "text") != 0 && _t_str_is(part, "mediaType", "text/plain") == 1, "as plain text");
    var h = _t_obj(t, "history");
    assert_eq(bayan_json_v_arr_len(h), 1, "its history the message that started it");
    var hm = bayan_json_v_arr_get(h, 0);
    assert(_t_str_is(hm, "messageId", "m-1") == 1 && _t_str_is(hm, "role", "ROLE_USER") == 1, "as the client sent it");
    assert(str_eq(bayan_json_v_str(_t_obj(hm, "taskId")), id) == 1, "in its task");
    assert(str_eq(bayan_json_v_str(_t_obj(hm, "contextId")), ctx) == 1, "and its context");

    var g = _t_call(s, "GetTask", str_cstr(str_cat(str_cat(str_from("{\"id\":\""), id), str_from("\"}"))));
    var gt = _t_result(g);
    assert(str_eq(bayan_json_v_str(_t_obj(gt, "id")), id) == 1, "GetTask reads it back");
    assert(_t_task_state_is(gt, "TASK_STATE_COMPLETED") == 1, "as it ended");
    assert(str_eq(bayan_json_v_str(_t_obj(gt, "contextId")), ctx) == 1, "in its context");
    var g0 = _t_call(s, "GetTask", str_cstr(str_cat(str_cat(str_from("{\"historyLength\":0,\"id\":\""), id),
          str_from("\"}"))));
    assert_eq(_t_obj(_t_result(g0), "history"), 0, "with no history when historyLength is 0");
    var gu = _t_call(s, "GetTask", str_cstr(str_cat(str_cat(str_from("{\"id\":\""),
            str_from(str_upper_cstr(str_cstr(id)))), str_from("\"}"))));
    assert_eq(_t_code(gu), 0, "and by its id in capitals, as every crew route reads one");

    var wcm = str_cat(str_from("{\"message\":{\"messageId\":\"m-2\",\"role\":\"ROLE_USER\",\"contextId\":\"ctx-9\","),
      str_from("\"parts\":[{\"data\":{\"k\":1}},{\"text\":\"and this\"}]}}"));
    var wc = _t_result(_t_call(s, "SendMessage", str_cstr(wcm)));
    assert(_t_str_is(_t_obj(wc, "task"), "contextId", "ctx-9") == 1, "a context the client names is the task's");

    var nh = _t_result(_t_call(s, "SendMessage", _t_send_params("x", "\"configuration\":{\"historyLength\":0},")));
    assert_eq(_t_obj(_t_obj(nh, "task"), "history"), 0, "historyLength 0 on a message leaves the task's history out");
    var ok = _t_call(s, "SendMessage", _t_send_params("x",
        "\"configuration\":{\"acceptedOutputModes\":[\"text/plain\"]},"));
    assert_eq(_t_code(ok), 0, "a client that reads text is answered");
    return 0;
}

# A task that fails says why: with a gateway nothing answers on, its crew's task fails, and the
# status message carries the crew's reason and the task's own error.
fn _t_failure_suite(): i64 {
    var s = _t_state();
    agnosai_orchestrator_with_llm_url(agnosai_app_state_orchestrator(s), str_from("http://127.0.0.1:1"), str_from(""));
    var t = _t_obj(_t_result(_t_call(s, "SendMessage", _t_send_params("fail it", ""))), "task");
    assert(_t_task_state_is(t, "TASK_STATE_FAILED") == 1, "a crew that fails is a failed task");
    var m = _t_obj(_t_obj(t, "status"), "message");
    assert(_t_str_is(m, "role", "ROLE_AGENT") == 1, "its status carries the agent's message");
    var text = bayan_json_v_str(_t_obj(bayan_json_v_arr_get(_t_obj(m, "parts"), 0), "text"));
    assert(str_starts_with(text, str_from("task_failed: ")) == 1, "saying the crew's reason");
    assert(str_len(text) > 13, "and what went wrong, the task's own error");
    assert_eq(_t_obj(t, "artifacts"), 0, "and a failed result is no artifact");

    # The failed result's text, not the first result's: a crew state with a completed one first.
    var a = default_alloc();
    var cst = agnosai_crew_state_new_a(a, str_from("00000000-0000-4000-8000-000000000001"), AGNOSAI_CREW_FAILED);
    agnosai_crew_state_with_reason(cst, str_from("task_failed"));
    agnosai_crew_state_with_result(cst, agnosai_task_result_new(str_from("t1"), str_from("fine"),
        AGNOSAI_STATUS_COMPLETED));
    agnosai_crew_state_with_result(cst, agnosai_task_result_new(str_from("t2"), str_from("boom"),
        AGNOSAI_STATUS_FAILED));
    var cm = _t_obj(_agnosai_a2a_status_a(a, cst, str_from("x"), str_from("c")), "message");
    assert(str_eq_cstr(bayan_json_v_str(_t_obj(bayan_json_v_arr_get(_t_obj(cm, "parts"), 0), "text")),
        "task_failed: boom") == 1,
      "the error is the failed result's, not the first result's");
    return 0;
}

fn _t_refusal_suite(): i64 {
    var s = _t_state();
    assert_eq(_t_code(_t_call(s, "SendMessage", "{}")), AGNOSAI_A2A_INVALID_PARAMS, "a SendMessage needs its message");
    assert_eq(_t_code(_t_call(s, "SendMessage", 0)), AGNOSAI_A2A_INVALID_PARAMS, "and its params");
    assert_eq(_t_code(_t_call(s, "SendMessage", "{\"message\":{\"role\":\"ROLE_USER\",\"parts\":[{\"text\":\"x\"}]}}")),
      AGNOSAI_A2A_INVALID_PARAMS, "a message needs its messageId");
    assert_eq(_t_code(_t_call(s, "SendMessage",
          "{\"message\":{\"messageId\":\"m\",\"role\":\"ROLE_AGENT\",\"parts\":[{\"text\":\"x\"}]}}")),
      AGNOSAI_A2A_INVALID_PARAMS, "and is the user's");
    assert_eq(_t_code(_t_call(s, "SendMessage",
          "{\"message\":{\"messageId\":\"m\",\"role\":\"ROLE_USER\",\"parts\":[]}}")),
      AGNOSAI_A2A_INVALID_PARAMS, "with a part at least");
    assert_eq(_t_code(_t_call(s, "SendMessage",
          "{\"message\":{\"messageId\":\"m\",\"role\":\"ROLE_USER\",\"parts\":[{\"text\":\"x\",\"data\":1}]}}")),
      AGNOSAI_A2A_INVALID_PARAMS, "each carrying one of text, raw, url or data");
    var raw = _t_call(s, "SendMessage",
      "{\"message\":{\"messageId\":\"m\",\"role\":\"ROLE_USER\",\"parts\":[{\"raw\":\"aGk=\"}]}}");
    assert_eq(_t_code(raw), AGNOSAI_A2A_CONTENT_TYPE_NOT_SUPPORTED, "a raw part is content this agent does not read");
    assert(_t_reason_is(raw, "CONTENT_TYPE_NOT_SUPPORTED") == 1, "saying so");
    assert_eq(_t_code(_t_call(s, "SendMessage",
          "{\"message\":{\"messageId\":\"m\",\"role\":\"ROLE_USER\",\"parts\":[{\"url\":\"https://x.test/f\"}]}}")),
      AGNOSAI_A2A_CONTENT_TYPE_NOT_SUPPORTED, "nor is a URL part");
    assert_eq(_t_code(_t_call(s, "SendMessage", _t_send_params("x",
            "\"configuration\":{\"acceptedOutputModes\":[\"image/png\"]},"))),
      AGNOSAI_A2A_CONTENT_TYPE_NOT_SUPPORTED, "a client that reads no text cannot be answered");
    assert_eq(_t_code(_t_call(s, "SendMessage",
          _t_send_params("x", "\"configuration\":{\"taskPushNotificationConfig\":{\"url\":\"https://x.test\"}},"))),
      AGNOSAI_A2A_PUSH_NOT_SUPPORTED, "nor told by push");
    assert_eq(_t_code(_t_call(s, "SendMessage", _t_send_params("x", "\"configuration\":{\"historyLength\":-1},"))),
      AGNOSAI_A2A_INVALID_PARAMS, "a historyLength is not negative");
    assert_eq(_t_code(_t_call(s, "SendMessage", _t_send_params("x", "\"metadata\":7,"))), AGNOSAI_A2A_INVALID_PARAMS,
      "and metadata is an object");

    var long = str_builder_new();
    for (var i = 0; i < 1001; i = i + 1) { str_builder_add_cstr(long, "0123456789"); }
    assert_eq(_t_code(_t_call(s, "SendMessage", _t_send_params(str_cstr(str_builder_build(long)), ""))),
      AGNOSAI_A2A_INVALID_PARAMS, "and its text is 10000 bytes at most, as /api/v1/a2a/receive's is");

    var unknown = str_cstr(str_cat(str_from("{\"message\":{\"messageId\":\"m\",\"role\":\"ROLE_USER\","),
        str_from("\"taskId\":\"00000000-0000-4000-8000-000000000000\",\"parts\":[{\"text\":\"x\"}]}}")));
    assert_eq(_t_code(_t_call(s, "SendMessage", unknown)), AGNOSAI_A2A_TASK_NOT_FOUND,
      "a message to no task is -32001");
    var first = _t_obj(_t_result(_t_call(s, "SendMessage", _t_send_params("first", ""))), "task");
    var fid = bayan_json_v_str(_t_obj(first, "id"));
    var again = str_cat(str_cat(str_from("{\"message\":{\"messageId\":\"m\",\"role\":\"ROLE_USER\",\"taskId\":\""),
        fid),
      str_from("\",\"parts\":[{\"text\":\"more\"}]}}"));
    var ag = _t_call(s, "SendMessage", str_cstr(again));
    assert_eq(_t_code(ag), AGNOSAI_A2A_UNSUPPORTED_OPERATION, "and one to a task that has ended is unsupported");
    assert(_t_reason_is(ag, "UNSUPPORTED_OPERATION") == 1, "as the spec has it");

    assert_eq(_t_code(_t_call(s, "GetTask", "{\"id\":\"not-a-task\"}")), AGNOSAI_A2A_TASK_NOT_FOUND,
      "an id no task has");
    assert(_t_reason_is(_t_call(s, "GetTask", "{\"id\":\"00000000-0000-4000-8000-000000000000\"}"),
        "TASK_NOT_FOUND") == 1,
      "is TaskNotFoundError");
    assert_eq(_t_code(_t_call(s, "GetTask", "{}")), AGNOSAI_A2A_INVALID_PARAMS, "and no id is -32602");

    # A crew the REST API started is no task: it has no context.
    var ra = arena_allocator_growable(65536);
    var rbody = str_cat(str_from("{\"name\":\"rest\",\"agents\":[{\"agent_key\":\"t\",\"name\":\"T\","),
      str_from("\"role\":\"tester\","));
    rbody = str_cat(rbody,
      str_from("\"goal\":\"test\"}],\"tasks\":[{\"description\":\"one\"}],\"process\":\"sequential\"}"));
    var rest = agnosai_route_create_crew_tp_a(ra, s, rbody, 0);
    assert_eq(agnosai_route_status(rest), HTTP_OK, "a crew posted to the REST API runs");
    var rid = bayan_json_v_str(bayan_json_v_obj_get_by_cstr(agnosai_route_body(rest), "crew_id"));
    var rq = str_cstr(str_cat(str_cat(str_from("{\"id\":\""), str_clone(rid)), str_from("\"}")));
    assert_eq(_t_code(_t_call(s, "GetTask", rq)), AGNOSAI_A2A_TASK_NOT_FOUND, "a REST crew is not an A2A task");
    assert_eq(_t_code(_t_call(s, "CancelTask", rq)), AGNOSAI_A2A_TASK_NOT_FOUND, "nor can it be cancelled as one");
    return 0;
}

# An A2A task whose one task is high-risk, submitted: its answer waits on the gate for a reviewer, so
# it stays WORKING, holding a slot, until it is decided or cancelled. Its id.
fn _t_risky_task(s, mid): Str {
    var o = agnosai_app_state_orchestrator(s);
    var mb = str_builder_new();
    str_builder_add_cstr(mb, "{\"messageId\":\"");
    str_builder_add_cstr(mb, mid);
    str_builder_add_cstr(mb, "\",\"role\":\"ROLE_USER\",\"parts\":[{\"text\":\"risky\"}]}");
    var msg = bayan_json_v_parse(str_builder_build(mb));
    var hold: i64[1];
    var spec = _agnosai_a2a_crew_a(default_alloc(), s, msg, str_from("risky"), str_from("ctx-r"), 0, &hold);
    agnosai_task_with_risk(vec_get(agnosai_crew_tasks(spec), 0), AGNOSAI_RISK_HIGH);
    var id = str_clone(agnosai_crew_id(spec));
    agnosai_orchestrator_submit_crew(o, spec);
    agnosai_orchestrator_let_go(o, load64(&hold));
    var g = agnosai_orchestrator_approval_gate(o);
    for (var w = 0; w < 2000 && agnosai_approval_gate_pending_count(g) < 1; w = w + 1) { sleep_ms(2); }
    return id;
}

fn _t_id_params(id: Str): i64 { return str_cstr(str_cat(str_cat(str_from("{\"id\":\""), id), str_from("\"}"))); }

# `returnImmediately` answers before the crew runs. One crew at a time, and that one waiting on its
# reviewer: a message's crew can only wait its turn, so the task comes back SUBMITTED, where a
# blocking SendMessage would wait for the slot.
fn _t_return_now_suite(): i64 {
    var o = agnosai_orchestrator_new(agnosai_resource_budget_new(AGNOSAI_NO_LIMIT, AGNOSAI_NO_LIMIT, AGNOSAI_NO_LIMIT,
        1));
    agnosai_orchestrator_with_audit(o, 0);
    agnosai_orchestrator_with_events(o, agnosai_event_bus_new());
    var s = agnosai_app_state_new(o, agnosai_tool_registry_new(), agnosai_auth_config_new(), load64(o + AGN_OR_EVENTS),
      0,
      agnosai_orchestrator_approval_gate(o));
    var held = _t_risky_task(s, "m-hold");
    var later = _t_result(_t_call(s, "SendMessage", _t_send_params("x",
          "\"configuration\":{\"returnImmediately\":true},")));
    var lt = _t_obj(later, "task");
    assert(_t_task_state_is(lt, "TASK_STATE_SUBMITTED") == 1,
      "returnImmediately answers with the task before its crew runs, waiting its turn");
    _t_call(s, "CancelTask", _t_id_params(held));
    var lq = _t_id_params(bayan_json_v_str(_t_obj(lt, "id")));
    var done = 0;
    for (var w = 0; w < 2000 && done == 0; w = w + 1) {
        if (_t_task_state_is(_t_result(_t_call(s, "GetTask", lq)), "TASK_STATE_COMPLETED") == 1) { done = 1; }
        else { sleep_ms(2); }
    }
    assert_eq(done, 1, "and the crew runs once the slot is free, to its end, where GetTask reads it");
    return 0;
}

# --- CancelTask, on a task that waits ---------------------------------------------

fn _t_cancel_suite(): i64 {
    var s = _t_state();
    var o = agnosai_app_state_orchestrator(s);
    # An A2A task whose one task is high-risk, so its answer waits on the gate for a reviewer.
    var msg = bayan_json_v_parse(str_cat(str_from("{\"messageId\":\"m-c\",\"role\":\"ROLE_USER\","),
        str_from("\"parts\":[{\"text\":\"risky\"}]}")));
    var hold: i64[1];
    var spec = _agnosai_a2a_crew_a(default_alloc(), s, msg, str_from("risky"), str_from("ctx-c"), 0, &hold);
    agnosai_task_with_risk(vec_get(agnosai_crew_tasks(spec), 0), AGNOSAI_RISK_HIGH);
    var id = str_clone(agnosai_crew_id(spec));
    assert(agnosai_orchestrator_submit_crew(o, spec) != 0, "the crew starts");
    agnosai_orchestrator_let_go(o, load64(&hold));
    var g = agnosai_orchestrator_approval_gate(o);
    for (var w = 0; w < 2000 && agnosai_approval_gate_pending_count(g) < 1; w = w + 1) { sleep_ms(2); }
    var q = str_cstr(str_cat(str_cat(str_from("{\"id\":\""), id), str_from("\"}")));
    var waiting = _t_result(_t_call(s, "GetTask", q));
    assert(_t_task_state_is(waiting, "TASK_STATE_WORKING") == 1,
      "a task waiting on a reviewer is WORKING: the input it waits for is not the client's");
    var lw = _t_result(_t_call(s, "ListTasks", "{\"status\":\"TASK_STATE_WORKING\"}"));
    assert_eq(bayan_json_v_int(_t_obj(lw, "totalSize")), 1, "and ListTasks finds it among the working");

    var c = _t_call(s, "CancelTask", q);
    assert_eq(_t_code(c), 0, "CancelTask cancels it");
    assert(_t_task_state_is(_t_result(c), "TASK_STATE_CANCELED") == 1, "and answers the task, canceled");
    var again = _t_call(s, "CancelTask", q);
    assert_eq(_t_code(again), AGNOSAI_A2A_TASK_NOT_CANCELABLE, "a task that has ended is not cancelable");
    assert(_t_reason_is(again, "TASK_NOT_CANCELABLE") == 1, "saying so");
    for (var w2 = 0; w2 < 2000 && agnosai_approval_gate_pending_count(g) > 0; w2 = w2 + 1) { sleep_ms(2); }
    assert_eq(agnosai_approval_gate_pending_count(g), 0, "and the cancel released what it waited for");
    var nres = 0;
    for (var w3 = 0; w3 < 2000 && nres == 0; w3 = w3 + 1) {
        var cs = agnosai_orchestrator_crew(o, id);
        if (cs != 0) { nres = vec_len(agnosai_crew_state_results(cs)); }
        if (nres == 0) { sleep_ms(2); }
    }
    assert(nres > 0, "the cancelled crew's task has its result, not completed");
    assert_eq(_t_obj(_t_result(_t_call(s, "GetTask", q)), "artifacts"), 0,
      "and a result its reviewer never approved is no artifact");
    return 0;
}

# --- ListTasks ------------------------------------------------------------------

fn _t_list_suite(): i64 {
    var s = _t_state();
    for (var i = 0; i < 5; i = i + 1) {
        var ctx = "\"configuration\":{},";
        _t_call(s, "SendMessage", _t_send_params("x", ctx));
    }
    _t_call(s, "SendMessage",
      str_cstr(str_cat(str_from("{\"message\":{\"messageId\":\"m-z\",\"role\":\"ROLE_USER\",\"contextId\":\"ctx-z\","),
          str_from("\"parts\":[{\"text\":\"z\"}]}}"))));
    var all = _t_result(_t_call(s, "ListTasks", "{}"));
    assert_eq(bayan_json_v_int(_t_obj(all, "totalSize")), 6, "ListTasks lists every task");
    assert_eq(bayan_json_v_arr_len(_t_obj(all, "tasks")), 6, "in one page of 50");
    assert_eq(bayan_json_v_int(_t_obj(all, "pageSize")), 50, "saying its page size");
    assert(_t_str_is(all, "nextPageToken", "") == 1, "and that it was the last page");
    assert_eq(_t_obj(bayan_json_v_arr_get(_t_obj(all, "tasks"), 0), "artifacts"), 0, "without artifacts unless asked");
    var with = _t_result(_t_call(s, "ListTasks", "{\"includeArtifacts\":true}"));
    assert(_t_obj(bayan_json_v_arr_get(_t_obj(with, "tasks"), 0), "artifacts") != 0, "and with them when asked");

    var p1 = _t_result(_t_call(s, "ListTasks", "{\"pageSize\":4}"));
    assert_eq(bayan_json_v_arr_len(_t_obj(p1, "tasks")), 4, "a page is its size");
    assert(_t_str_is(p1, "nextPageToken", "4") == 1, "and names the next");
    var p2 = _t_result(_t_call(s, "ListTasks", "{\"pageSize\":4,\"pageToken\":\"4\"}"));
    assert_eq(bayan_json_v_arr_len(_t_obj(p2, "tasks")), 2, "which holds the rest");
    assert(_t_str_is(p2, "nextPageToken", "") == 1, "and is the last");
    var a1 = bayan_json_v_str(_t_obj(bayan_json_v_arr_get(_t_obj(p1, "tasks"), 3), "id"));
    var b1 = bayan_json_v_str(_t_obj(bayan_json_v_arr_get(_t_obj(p2, "tasks"), 0), "id"));
    assert(agnosai_order_str_cmp(a1, b1) < 0, "in one order, by id, across pages");

    var q1 = _t_result(_t_call(s, "ListTasks", "{\"pageSize\":3}"));
    assert(_t_str_is(q1, "nextPageToken", "3") == 1, "pages of 3 over 6 tasks");
    var q2 = _t_result(_t_call(s, "ListTasks", "{\"pageSize\":3,\"pageToken\":\"3\"}"));
    assert_eq(bayan_json_v_arr_len(_t_obj(q2, "tasks")), 3, "the second holding the last 3");
    assert(_t_str_is(q2, "nextPageToken", "") == 1, "and naming no next, though it ends where a page would");

    var cz = _t_result(_t_call(s, "ListTasks", "{\"contextId\":\"ctx-z\"}"));
    assert_eq(bayan_json_v_int(_t_obj(cz, "totalSize")), 1, "a context filters");
    var done = _t_result(_t_call(s, "ListTasks", "{\"status\":\"TASK_STATE_COMPLETED\"}"));
    assert_eq(bayan_json_v_int(_t_obj(done, "totalSize")), 6, "and so does a state");
    var rej = _t_result(_t_call(s, "ListTasks", "{\"status\":\"TASK_STATE_REJECTED\"}"));
    assert_eq(bayan_json_v_int(_t_obj(rej, "totalSize")), 0, "a rejected task is never registered, so none lists");

    assert_eq(_t_code(_t_call(s, "ListTasks", "{\"pageSize\":0}")), AGNOSAI_A2A_INVALID_PARAMS, "a page is 1 at least");
    assert_eq(_t_code(_t_call(s, "ListTasks", "{\"pageSize\":101}")), AGNOSAI_A2A_INVALID_PARAMS, "and 100 at most");
    assert_eq(_t_code(_t_call(s, "ListTasks", "{\"pageToken\":\"abc\"}")), AGNOSAI_A2A_INVALID_PARAMS,
      "a token this endpoint never issued is refused");
    assert_eq(_t_code(_t_call(s, "ListTasks", "{\"status\":\"DONE\"}")), AGNOSAI_A2A_INVALID_PARAMS,
      "as is a state that is none");
    assert_eq(_t_code(_t_call(s, "ListTasks", "{\"statusTimestampAfter\":\"2026-01-01T00:00:00Z\"}")),
      AGNOSAI_A2A_UNSUPPORTED_OPERATION, "and a timestamp filter it could not apply");
    return 0;
}

# --- the streams ------------------------------------------------------------------

var _T_CAP = _tt_tmp_path("a2a-stream-capture", "");

fn _t_open_capture(): i64 {
    return file_open(str_cstr(str_from(_T_CAP)), O_WRONLY | O_CREAT | O_TRUNC, 420);
}

fn _t_captured(): Str {
    var buf = alloc(65536);
    var n = file_read_all(str_cstr(str_from(_T_CAP)), buf, 65536);
    if (n < 0) { n = 0; }
    return str_from_buf(buf, n);
}

# The `data:` payloads in a captured stream, each a parsed JSON-RPC response, in order.
fn _t_frames(cap: Str): i64 {
    var out = vec_new();
    var d = str_data(cap);
    var n = str_len(cap);
    var i = 0;
    while (i + 6 <= n) {
        if (memeq(d + i, "data: ", 6) == 1) {
            var e = i + 6;
            while (e < n && load8(d + e) != 10) { e = e + 1; }
            vec_push(out, bayan_json_v_parse(str_new(d + i + 6, e - i - 6)));
            i = e;
        }
        i = i + 1;
    }
    return out;
}

# The StreamResponse in frame `f`, and its one member `kind`, or 0.
fn _t_member(f, kind): i64 { return _t_obj(_t_obj(f, "result"), kind); }

fn _t_stream_to_capture(r): Str {
    var fd = _t_open_capture();
    agnosai_route_stream_run(r, fd);
    file_close(fd);
    return _t_captured();
}

var _t_sub_resp = 0;
var _t_sub_fd = 0;
var _t_sub_done = 0;

fn _t_sub_thread(arg): i64 {
    agnosai_route_stream_run(_t_sub_resp, _t_sub_fd);
    file_close(_t_sub_fd);
    atomic_store(&_t_sub_done, 1);
    return 0;
}

fn _t_stream_suite(): i64 {
    var s = _t_state();
    var r = _t_call(s, "SendStreamingMessage", _t_send_params("stream it", ""));
    assert_eq(agnosai_route_is_stream(r), 1, "SendStreamingMessage answers with a stream");
    var cap = _t_stream_to_capture(r);
    assert(str_contains_cstr(cap, "HTTP/1.1 200") == 1, "on a 200");
    assert(str_contains_cstr(cap, "Content-Type: text/event-stream") == 1, "of text/event-stream");
    assert(str_contains_cstr(cap, "X-Accel-Buffering: no") == 1, "that no proxy buffers");
    var fr = _t_frames(cap);
    assert(vec_len(fr) >= 3, "the task, its artifact and its end");
    var f0 = vec_get(fr, 0);
    assert_eq(bayan_json_v_int(_t_obj(f0, "id")), 7, "each event a JSON-RPC response to the request");
    var t0 = _t_member(f0, "task");
    assert(t0 != 0, "the first, the task");
    assert(_t_task_state_is(t0, "TASK_STATE_SUBMITTED") == 1, "as it was before it ran");
    var id = bayan_json_v_str(_t_obj(t0, "id"));
    var last = vec_get(fr, vec_len(fr) - 1);
    var lu = _t_member(last, "statusUpdate");
    assert(lu != 0, "the last a status update");
    assert(str_eq_cstr(bayan_json_v_str(_t_obj(_t_obj(lu, "status"), "state")), "TASK_STATE_COMPLETED") == 1,
      "saying the task completed");
    assert(str_eq(bayan_json_v_str(_t_obj(lu, "taskId")), id) == 1, "for the task the stream began with");
    var au = _t_member(vec_get(fr, vec_len(fr) - 2), "artifactUpdate");
    assert(au != 0, "after its artifact");
    assert_eq(bayan_json_v_bool(_t_obj(au, "lastChunk")), 1, "in one chunk");
    assert(_t_obj(_t_obj(au, "artifact"), "parts") != 0, "carrying the result");
    assert(_t_task_state_is(_t_result(_t_call(s, "GetTask",
            str_cstr(str_cat(str_cat(str_from("{\"id\":\""), id), str_from("\"}"))))), "TASK_STATE_COMPLETED") == 1,
      "and GetTask reads the same task back");

    var bad = _t_call(s, "SendStreamingMessage", "{}");
    assert_eq(agnosai_route_is_stream(bad), 0, "a message it refuses is no stream");
    assert_eq(_t_code(bad), AGNOSAI_A2A_INVALID_PARAMS, "but the error SendMessage would answer");
    var ended = _t_call(s, "SubscribeToTask", str_cstr(str_cat(str_cat(str_from("{\"id\":\""), id), str_from("\"}"))));
    assert_eq(_t_code(ended), AGNOSAI_A2A_UNSUPPORTED_OPERATION, "a task that has ended has no stream to subscribe to");
    assert_eq(_t_code(_t_call(s, "SubscribeToTask", "{\"id\":\"00000000-0000-4000-8000-000000000000\"}")),
      AGNOSAI_A2A_TASK_NOT_FOUND, "nor has a task there is not");

    # A task that waits on its reviewer, subscribed to on a thread, then cancelled.
    var o = agnosai_app_state_orchestrator(s);
    var msg = bayan_json_v_parse(str_cat(str_from("{\"messageId\":\"m-s\",\"role\":\"ROLE_USER\","),
        str_from("\"parts\":[{\"text\":\"risky\"}]}")));
    var hold: i64[1];
    var spec = _agnosai_a2a_crew_a(default_alloc(), s, msg, str_from("risky"), str_from("ctx-s"), 0, &hold);
    agnosai_task_with_risk(vec_get(agnosai_crew_tasks(spec), 0), AGNOSAI_RISK_HIGH);
    var wid = str_clone(agnosai_crew_id(spec));
    agnosai_orchestrator_submit_crew(o, spec);
    agnosai_orchestrator_let_go(o, load64(&hold));
    var g = agnosai_orchestrator_approval_gate(o);
    for (var w = 0; w < 2000 && agnosai_approval_gate_pending_count(g) < 1; w = w + 1) { sleep_ms(2); }
    var q = str_cstr(str_cat(str_cat(str_from("{\"id\":\""), wid), str_from("\"}")));
    _t_sub_resp = _t_call(s, "SubscribeToTask", q);
    assert_eq(agnosai_route_is_stream(_t_sub_resp), 1, "SubscribeToTask answers a working task with a stream");
    _t_sub_fd = _t_open_capture();
    _t_sub_done = 0;
    assert(thread_create_detached(&_t_sub_thread, 0) != 0, "run on a thread of its own");
    sleep_ms(150);
    assert_eq(atomic_load(&_t_sub_done), 0, "which stays open while the task works");
    _t_call(s, "CancelTask", q);
    for (var w2 = 0; w2 < 2000 && atomic_load(&_t_sub_done) == 0; w2 = w2 + 1) { sleep_ms(2); }
    assert_eq(atomic_load(&_t_sub_done), 1, "and ends once the task does");
    var sf = _t_frames(_t_captured());
    assert(_t_task_state_is(_t_member(vec_get(sf, 0), "task"), "TASK_STATE_WORKING") == 1,
      "its first event the task, working");
    var sl = _t_member(vec_get(sf, vec_len(sf) - 1), "statusUpdate");
    assert(str_eq_cstr(bayan_json_v_str(_t_obj(_t_obj(sl, "status"), "state")), "TASK_STATE_CANCELED") == 1,
      "and its last, canceled");

    # Through the router, as the binary dispatches it.
    var body = _t_rpc("SendStreamingMessage", _t_send_params("via the router", ""));
    var h = _t_hdrs("A2A-Version: 1.0\r\n", body);
    var rr = agnosai_route_dispatch_h_a(default_alloc(), s, AGNOSAI_METHOD_POST, str_from("/a2a"),
      str_from(""), 0, body, 1, 0, h);
    assert_eq(agnosai_route_is_stream(rr), 1, "the router hands the stream back for the serve layer to run");
    _t_stream_to_capture(rr);
    return 0;
}

# --- JCS, RFC 8785 ---------------------------------------------------------------

fn _t_jcs(json): i64 {
    var v = bayan_json_v_parse(str_from(json));
    var c = agnosai_jcs_a(default_alloc(), v);
    if (c == 0) { return 0; }
    return str_cstr(c);
}

fn _t_jcs_suite(): i64 {
    assert(streq(_t_jcs("{ \"b\" : 1, \"a\" : [true, false, null, \"x\"] }"),
        "{\"a\":[true,false,null,\"x\"],\"b\":1}") == 1,
      "members sorted, no whitespace");
    assert(streq(_t_jcs("{\"z\":{\"y\":2,\"x\":1},\"aa\":0,\"a\":0}"),
        "{\"a\":0,\"aa\":0,\"z\":{\"x\":1,\"y\":2}}") == 1,
      "at every depth, a prefix first");
    assert(streq(_t_jcs("[\"q\\\"b\\\\s\\n\\t\\r\\b\\f\\u0001\\u001f\"]"),
        "[\"q\\\"b\\\\s\\n\\t\\r\\b\\f\\u0001\\u001f\"]") == 1,
      "a string as JSON.stringify writes it: two-letter escapes, and \\u00xx for the other controls");
    assert(streq(_t_jcs("[\"\\u007f\\u00e9\\u20ac\"]"), "[\"\x7f\xc3\xa9\xe2\x82\xac\"]") == 1,
      "and everything else as it is, in UTF-8");
    assert(streq(_t_jcs("[-7,0,12345678901]"), "[-7,0,12345678901]") == 1, "an integer in decimal");
    assert_eq(_t_jcs("[1.5]"), 0, "a float is refused, as its shortest form is not written here");
    # bayan's parser refuses a name twice, so the value is built: `obj_set` appends.
    var dup = bayan_json_v_obj_new();
    bayan_json_v_obj_set(dup, str_from("a"), bayan_json_v_int_new(1));
    bayan_json_v_obj_set(dup, str_from("a"), bayan_json_v_int_new(2));
    assert_eq(agnosai_jcs_a(default_alloc(), dup), 0, "and so is a name twice");
    assert(agnosai_jcs_cmp(str_from("a"), str_from("b")) < 0 && agnosai_jcs_cmp(str_from("b"), str_from("a")) > 0,
      "names compare by their units");
    assert(agnosai_jcs_cmp(str_from("ab"), str_from("a")) > 0 && agnosai_jcs_cmp(str_from("ab"), str_from("ab")) == 0,
      "a prefix first, and a name equal to itself");
    assert(agnosai_jcs_cmp(str_from("\xef\xbd\xa1"), str_from("\xf0\x9f\x98\x80")) > 0,
      "and U+FF61 after U+1F600, whose high surrogate 0xD83D is the smaller unit");
    # RFC 8785 §3.2.3: names sort by UTF-16 code units, so U+1F600, a surrogate pair from 0xD83D,
    # sorts before U+FF61, though its code point is the larger.
    assert(streq(_t_jcs("{\"\\uff61\":1,\"\\ud83d\\ude00\":2,\"a\":3}"),
        "{\"a\":3,\"\xf0\x9f\x98\x80\":2,\"\xef\xbd\xa1\":1}") == 1,
      "by UTF-16 code units, not code points");
    return 0;
}

