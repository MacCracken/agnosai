fn _t_card_canon(): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb,
      "{\"capabilities\":{\"extendedAgentCard\":false,\"pushNotifications\":false,\"streaming\":true},\"de");
    str_builder_add_cstr(sb,
      "faultInputModes\":[\"text/plain\",\"application/json\"],\"defaultOutputModes\":[\"text/plain\"],\"de");
    str_builder_add_cstr(sb,
      "scription\":\"Runs a crew of AI agents for a task: provider-agnostic orchestration, with san");
    str_builder_add_cstr(sb,
      "dboxed tools.\",\"name\":\"agnosai\",\"securityRequirements\":[{\"schemes\":{\"bearer\":{\"list\":[]}}}");
    str_builder_add_cstr(sb,
      "],\"securitySchemes\":{\"bearer\":{\"httpAuthSecurityScheme\":{\"scheme\":\"Bearer\"}}},\"skills\":[{\"");
    str_builder_add_cstr(sb,
      "description\":\"Takes a task in plain text, runs a crew of agents for it, and answers with e");
    str_builder_add_cstr(sb,
      "ach result as an artifact.\",\"id\":\"run-crew\",\"name\":\"Run a crew\",\"tags\":[\"orchestration\",\"c");
    str_builder_add_cstr(sb,
      "rew\",\"agents\"]}],\"supportedInterfaces\":[{\"protocolBinding\":\"JSONRPC\",\"protocolVersion\":\"1.");
    str_builder_add_cstr(sb, "0\",\"url\":\"https://agents.example.com/a2a\"}],\"version\":\"");
    str_builder_add_cstr(sb, AGNOSAI_VERSION);
    str_builder_add_cstr(sb, "\"}");
    return str_builder_build(sb);
}

# base64url, RFC 4648 §10's vectors, unpadded.
fn _t_b64u_is(text, want): i64 {
    return streq(str_cstr(_agnosai_a2a_b64url_a(default_alloc(), text, strlen(text))), want);
}

fn _t_sign_suite(): i64 {
    var a = default_alloc();
    assert(_t_b64u_is("f", "Zg") == 1 && _t_b64u_is("fo", "Zm8") == 1 && _t_b64u_is("foo", "Zm9v") == 1,
      "base64url is RFC 4648's");
    assert(_t_b64u_is("foob", "Zm9vYg") == 1 && _t_b64u_is("fooba", "Zm9vYmE") == 1 && _t_b64u_is("foobar",
        "Zm9vYmFy") == 1,
      "unpadded, every last group");
    assert(_t_b64u_is("\xfb\xff", "-_8") == 1, "in the URL alphabet");
    var dl: i64[1];
    var db = _agnosai_a2a_b64url_decode_a(a, str_from("Zm9vYmE"), &dl);
    assert(load64(&dl) == 5 && memeq(db, "fooba", 5) == 1, "and decodes back");
    # The canonical form of a card, checked against Python's `json.dumps(sort_keys=True,
    # separators=(",", ":"))`, which is RFC 8785's for an ASCII card with no floats.
    var kc = agnosai_a2a_card_a(a, agnosai_auth_config_with_secret(str_from("k")),
      str_from("https://agents.example.com"));
    assert(str_eq(agnosai_jcs_a(a, kc), _t_card_canon()) == 1, "a card's canonical form is RFC 8785's");
    var es = agnosai_a2a_signer_from_pem(_t_ec_pem(), str_from("test-key"), 0);
    assert(es != 0, "a P-256 key in PKCS #8 is read");
    assert(streq(agnosai_a2a_signer_alg(es), "ES256") == 1, "and signs ES256");
    var card = agnosai_a2a_card_a(a, 0, str_from("https://agents.example.com"));
    var sig = agnosai_a2a_card_sign_a(a, card, es);
    assert(sig != 0, "a card is signed");
    var hl: i64[1];
    var hb = _agnosai_a2a_b64url_decode_a(a, bayan_json_v_str(_t_obj(sig, "protected")), &hl);
    assert(streq(str_cstr(str_new(hb, load64(&hl))), "{\"alg\":\"ES256\",\"kid\":\"test-key\",\"typ\":\"JOSE\"}") == 1,
      "its protected header naming the algorithm, the key and the type, canonically");
    var sl: i64[1];
    _agnosai_a2a_b64url_decode_a(a, bayan_json_v_str(_t_obj(sig, "signature")), &sl);
    assert_eq(load64(&sl), 64, "an ES256 signature is r || s, 64 bytes");
    var sigs = bayan_json_v_arr_new_a(a);
    bayan_json_v_arr_push_a(a, sigs, sig);
    bayan_json_v_obj_set_a(a, card, str_from("signatures"), sigs);
    assert_eq(agnosai_a2a_card_verify_es256_a(a, card, _t_ec_pub()), 1, "and the key's public half verifies it");
    # Over what the spec says it signs, built here: the protected header, `.`, and the card's canonical
    # form in base64url, `signatures` left out.
    var unsigned_card = agnosai_a2a_card_a(a, 0, str_from("https://agents.example.com"));
    var canon = agnosai_jcs_a(a, unsigned_card);
    var input = str_cat(str_cat(bayan_json_v_str(_t_obj(sig, "protected")), str_from(".")),
      _agnosai_a2a_b64url_a(a, str_data(canon), str_len(canon)));
    var raw_len: i64[1];
    var raw_sig = _agnosai_a2a_b64url_decode_a(a, bayan_json_v_str(_t_obj(sig, "signature")), &raw_len);
    assert_eq(ecdsa_p256_verify(_t_ec_pub(), str_data(input), str_len(input), raw_sig), 1,
      "the signature is sigil's ES256 over the spec's signing input");
    bayan_json_v_obj_set_a(a, card, str_from("description"), bayan_json_v_str_new_a(a, str_from("someone else")));
    assert_eq(agnosai_a2a_card_verify_es256_a(a, card, _t_ec_pub()), 0,
      "a card changed after it was signed does not verify");
    var other = alloc(64);
    memcpy(other, _t_ec_pub(), 64);
    store8(other + 63, load8(other + 63) ^ 1);
    var card2 = agnosai_a2a_card_a(a, 0, str_from("https://agents.example.com"));
    var sigs2 = bayan_json_v_arr_new_a(a);
    bayan_json_v_arr_push_a(a, sigs2, agnosai_a2a_card_sign_a(a, card2, es));
    bayan_json_v_obj_set_a(a, card2, str_from("signatures"), sigs2);
    assert_eq(agnosai_a2a_card_verify_es256_a(a, card2, other), 0, "nor does one under another key");
    assert_eq(agnosai_a2a_card_verify_rs256_a(a, card2, _t_rsa_n(), 256, "\x01\x00\x01", 3), 0,
      "nor as an RS256 signature, which it is not");

    var rs = agnosai_a2a_signer_from_pem(_t_rsa_pem(), str_from("rsa-key"),
      str_from("https://agents.example.com/jwks.json"));
    assert(rs != 0 && streq(agnosai_a2a_signer_alg(rs), "RS256") == 1, "an RSA key signs RS256");
    var card3 = agnosai_a2a_card_a(a, 0, str_from("https://agents.example.com"));
    var rsig = agnosai_a2a_card_sign_a(a, card3, rs);
    var rh: i64[1];
    var rhb = _agnosai_a2a_b64url_decode_a(a, bayan_json_v_str(_t_obj(rsig, "protected")), &rh);
    assert(str_contains_cstr(str_new(rhb, load64(&rh)), "\"jku\":\"https://agents.example.com/jwks.json\"") == 1,
      "naming where its keys are published, when it is told");
    var sigs3 = bayan_json_v_arr_new_a(a);
    bayan_json_v_arr_push_a(a, sigs3, rsig);
    bayan_json_v_obj_set_a(a, card3, str_from("signatures"), sigs3);
    assert_eq(agnosai_a2a_card_verify_rs256_a(a, card3, _t_rsa_n(), 256, "\x01\x00\x01", 3), 1,
      "and the RSA key's public half verifies it");
    assert_eq(agnosai_a2a_signer_from_pem(str_from("-----BEGIN PUBLIC KEY-----\nAAAA\n-----END PUBLIC KEY-----\n"),
        str_from("k"), 0), 0, "a PEM with no private key is no signer");

    # Sealed: built once, for the public URL, signed, and served as it is.
    var cfg = agnosai_a2a_config_with_public_url(agnosai_a2a_config_new(), str_from("https://agents.example.com"));
    assert_eq(agnosai_a2a_config_seal(agnosai_a2a_config_new(), 0), 0 - 1, "a card is sealed only for a public URL");
    agnosai_a2a_config_with_signer(cfg, es);
    assert_eq(agnosai_a2a_config_seal(cfg, 0), 0, "and then is");
    var s = _t_state();
    agnosai_app_state_with_a2a(s, cfg);
    var served = agnosai_route_body(agnosai_route_a2a_card_a(a, s, _t_hdrs("", str_from(""))));
    assert_eq(bayan_json_v_arr_len(_t_obj(served, "signatures")), 1, "the card served carries its signature");
    assert_eq(agnosai_a2a_card_verify_es256_a(a, served, _t_ec_pub()), 1, "which verifies");
    var text = bayan_json_v_build_a(a, served);
    var reparsed = bayan_json_v_parse(text);
    assert_eq(agnosai_a2a_card_verify_es256_a(a, reparsed, _t_ec_pub()), 1,
      "and still does once the card has been through the wire, as a client reads it");
    var ra = arena_allocator_growable(4096);
    agnosai_route_a2a_card_a(ra, s, 0);
    reset_via(ra);
    var before = alloc_used();
    for (var i = 0; i < 16; i = i + 1) {
        agnosai_route_a2a_card_a(ra, s, 0);
        reset_via(ra);
    }
    assert_eq(alloc_used() - before, 0, "a sealed card is answered as it is, built for no request");
    return 0;
}

# --- what a task costs the global heap ------------------------------------------------

# A message sent and its task read, in a request arena reset after, with the registry at a cap of 8
# so every message past it evicts a crew, which goes back (ADR 037).
fn _t_heap_suite(): i64 {
    var cap = AGNOSAI_MAX_RETAINED_CREWS;
    var low = AGNOSAI_CREWS_LOW_WATER;
    AGNOSAI_MAX_RETAINED_CREWS = 8;
    AGNOSAI_CREWS_LOW_WATER = 4;
    var s = _t_state();
    var ra = arena_allocator_growable(65536);
    var body = _t_rpc("SendMessage", _t_send_params("run it", ""));
    var lbody = _t_rpc("ListTasks", "{\"includeArtifacts\":true}");
    var text = str_cat(str_from("POST /a2a HTTP/1.1\r\nA2A-Version: 1.0\r\n\r\n"), body);
    var ltext = str_cat(str_from("POST /a2a HTTP/1.1\r\nA2A-Version: 1.0\r\n\r\n"), lbody);
    for (var w = 0; w < 1100; w = w + 1) {
        agnosai_route_a2a_rpc_h_a(ra, s, body, 0, agnosai_http_headers_of_a(ra, text));
        reset_via(ra);
    }
    var before = alloc_used();
    var bad = 0;
    for (var i = 0; i < 200; i = i + 1) {
        var r = agnosai_route_a2a_rpc_h_a(ra, s, body, 0, agnosai_http_headers_of_a(ra, text));
        if (_t_code(r) != 0) { bad = bad + 1; }
        agnosai_route_a2a_rpc_h_a(ra, s, lbody, 0, agnosai_http_headers_of_a(ra, ltext));
        reset_via(ra);
    }
    assert_eq(bad, 0, "every message is taken");
    assert_eq(alloc_used() - before, 0, "and a task, sent and listed, leaves nothing once its crew is evicted");

    # And a stream: its frames in a scratch of the pool's, reset after each, its crew given back.
    var sbody = _t_rpc("SendStreamingMessage", _t_send_params("stream it", ""));
    var stext = str_cat(str_from("POST /a2a HTTP/1.1\r\nA2A-Version: 1.0\r\n\r\n"), sbody);
    var null_fd = file_open("/dev/null", O_WRONLY, 0);
    for (var ws = 0; ws < 24; ws = ws + 1) {
        agnosai_route_stream_run(agnosai_route_a2a_rpc_h_a(ra, s, sbody, 0, agnosai_http_headers_of_a(ra, stext)),
          null_fd);
        reset_via(ra);
    }
    var sbefore = alloc_used();
    for (var j = 0; j < 40; j = j + 1) {
        agnosai_route_stream_run(agnosai_route_a2a_rpc_h_a(ra, s, sbody, 0, agnosai_http_headers_of_a(ra, stext)),
          null_fd);
        reset_via(ra);
    }
    assert_eq(alloc_used() - sbefore, 0, "a streamed task leaves nothing either");
    file_close(null_fd);
    AGNOSAI_MAX_RETAINED_CREWS = cap;
    AGNOSAI_CREWS_LOW_WATER = low;
    return 0;
}

fn main(): i64 {
    alloc_init();
    sakshi_set_level(SK_FATAL);
    _t_card_suite();
    _t_version_suite();
    _t_send_suite();
    _t_return_now_suite();
    _t_refusal_suite();
    _t_failure_suite();
    _t_cancel_suite();
    _t_list_suite();
    _t_stream_suite();
    _t_jcs_suite();
    _t_sign_suite();
    _t_heap_suite();
    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
sys_exit_group(f);
