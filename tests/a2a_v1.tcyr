fn _t_unhex(h: Str): i64 {
    var n = str_len(h) / 2;
    var out = alloc(n);
    for (var i = 0; i < n; i = i + 1) {
        var hi = load8(str_data(h) + i * 2);
        var lo = load8(str_data(h) + i * 2 + 1);
        if (hi >= 97) { hi = hi - 87; } else { hi = hi - 48; }
        if (lo >= 97) { lo = lo - 87; } else { lo = lo - 48; }
        store8(out + i, hi * 16 + lo);
    }
    return out;
}

# The P-256 test key's public half, Qx || Qy, and the RSA test key's modulus. Test keys only: they
# sign nothing outside this suite.
fn _t_ec_pub(): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb,
      "c9684d55b690e111361b151f49ccf359b6caef93176fd992b51d6297d84c9418fc42b467716f2b01011947b2b651287d");
    str_builder_add_cstr(sb, "00c09b7eab6c12c80fb8587f18060eeb");
    return _t_unhex(str_builder_build(sb));
}

