# =========================================================================
# orch_scoring.tcyr — parity tests for src/orch_scoring.cyr
#
# Oracle: the #[cfg(test)] block in rust-old/src/orchestrator/scoring.rs —
# 10 tests, all portable, with the oracle's own `expected_score` helper
# reproduced so the weights are recomputed rather than hardcoded. If a weight
# constant moves, these tests move with it, which is what the oracle's helper
# is for.
#
# Stdlib is auto-prepended from cyrius.cyml — do NOT include stdlib modules.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/core_error.cyr"
include "src/core_json.cyr"
include "src/core_message.cyr"
include "src/core_resource.cyr"
include "src/core_task.cyr"
include "src/core_agent.cyr"
include "src/orch_scoring.cyr"
include "tests/test_helpers.cyr"

# The oracle's make_agent(tools, complexity, domain).
fn _t_agent(tools, complexity, domain): i64 {
    var a = agnosai_agent_new(str_from("test-agent"), str_from("tester"),
    str_from("test things"));
    agnosai_agent_with_name(a, str_from("Test Agent"));
    agnosai_agent_with_complexity(a, str_from(complexity));
    if (domain != 0) { agnosai_agent_with_domain(a, str_from(domain)); }
    if (tools != 0) { agnosai_agent_with_tools(a, tools); }
    return a;
}

# A vec of Str from up to two tool names; pass 0 to omit.
fn _t_tools(a, b): i64 {
    var v = vec_new();
    if (a != 0) { vec_push(v, str_from(a)); }
    if (b != 0) { vec_push(v, str_from(b)); }
    return v;
}

# A task whose context is the given JSON object literal.
fn _t_task(ctx_src): i64 {
    var t = agnosai_task_new(str_from("test task"));
    var ctx = bayan_json_v_parse_buf(ctx_src, strlen(ctx_src));
    for (var i = 0; i < bayan_json_v_obj_len(ctx); i = i + 1) {
        agnosai_task_with_context(t, bayan_json_v_obj_key(ctx, i), bayan_json_v_obj_val(ctx, i));
    }
    return t;
}

# The oracle's expected_score(tool, complexity, gpu, domain), with personality
# pinned at the neutral 0.5 the oracle's own helper hardcodes.
fn _t_expected(tool, complexity, gpu, domain): i64 {
    var s = f64_mul(agnosai_weight_tool_coverage(), tool);
    s = f64_add(s, f64_mul(agnosai_weight_complexity(), complexity));
    s = f64_add(s, f64_mul(agnosai_weight_gpu(), gpu));
    s = f64_add(s, f64_mul(agnosai_weight_domain(), domain));
    s = f64_add(s, f64_mul(agnosai_weight_personality(), f64_div(f64_from(1), f64_from(2))));
    return s;
}

# An f64 from a simple ratio.
fn _t_ratio(n, d): i64 {
    return f64_div(f64_from(n), f64_from(d));
}

fn main() {
    alloc_init();

    test_group("orch_scoring");

    # --- the weights are the constants, and they sum to 1.0 ---
    var sum = f64_add(agnosai_weight_tool_coverage(), agnosai_weight_complexity());
    sum = f64_add(sum, agnosai_weight_gpu());
    sum = f64_add(sum, agnosai_weight_domain());
    sum = f64_add(sum, agnosai_weight_personality());
    _t_assert_f64(sum, f64_from(1), "the five weights sum to exactly 1.0");
    _t_assert_f64(agnosai_weight_tool_coverage(), _t_ratio(35, 100),
    "tool coverage is 0.35 — the constant, not the rustdoc's stale 0.40");
    _t_assert_f64(agnosai_weight_complexity(), _t_ratio(25, 100), "complexity is 0.25");
    _t_assert_f64(agnosai_weight_gpu(), _t_ratio(10, 100), "gpu is 0.10");
    _t_assert_f64(agnosai_weight_domain(), _t_ratio(15, 100), "domain is 0.15");
    _t_assert_f64(agnosai_weight_personality(), _t_ratio(15, 100), "personality is 0.15");

    # --- complexity_level ---
    assert_eq(agnosai_complexity_level(str_from("low")), 1, "low is 1");
    assert_eq(agnosai_complexity_level(str_from("medium")), 2, "medium is 2");
    assert_eq(agnosai_complexity_level(str_from("high")), 3, "high is 3");
    assert_eq(agnosai_complexity_level(str_from("LOW")), 1, "the match is case-insensitive");
    assert_eq(agnosai_complexity_level(str_from("HiGh")), 3, "in either direction");
    assert_eq(agnosai_complexity_level(str_from("banana")), 2,
    "an unrecognised value degrades to medium rather than erroring");
    assert_eq(agnosai_complexity_level(str_from("")), 2, "and so does an empty one");

    # --- test_perfect_score ---
    var perfect_agent = _t_agent(_t_tools("lint", "test"), "medium", "quality");
    var perfect_task = _t_task(
    "{\"required_tools\":[\"lint\",\"test\"],\"complexity\":\"medium\",\"domain\":\"quality\"}");
    _t_assert_f64(agnosai_score_agent(perfect_agent, perfect_task),
    _t_expected(f64_from(1), f64_from(1), f64_from(1), f64_from(1)),
    "a perfectly matched agent scores every factor 1.0");

    # the personality floor means a perfect score is NOT 1.0 — it is
    # 0.85 + 0.15*0.5 = 0.925 — because bhava is absent
    _t_assert_f64(agnosai_score_agent(perfect_agent, perfect_task), _t_ratio(925, 1000),
    "which is 0.925, not 1.0, since personality contributes its neutral half");

    # --- test_no_tools_match ---
    var no_tools = _t_agent(0, "medium", "quality");
    _t_assert_f64(agnosai_score_agent(no_tools, perfect_task),
    _t_expected(f64_from(0), f64_from(1), f64_from(1), f64_from(1)),
    "an agent with none of the required tools scores 0 on coverage");

    # --- test_partial_tool_coverage ---
    var half = _t_agent(_t_tools("lint", 0), "medium", "quality");
    _t_assert_f64(agnosai_score_agent(half, perfect_task),
    _t_expected(_t_ratio(1, 2), f64_from(1), f64_from(1), f64_from(1)),
    "one of two required tools scores 0.5 on coverage");

    # --- test_complexity_mismatch ---
    var mismatched = _t_agent(_t_tools("lint", "test"), "high", "quality");
    _t_assert_f64(agnosai_score_agent(mismatched, perfect_task),
    _t_expected(f64_from(1), _t_ratio(2, 3), f64_from(1), f64_from(1)),
    "high against medium is one level off, so 1 - 1/3");

    var far = _t_agent(_t_tools("lint", "test"), "high", "quality");
    var low_task = _t_task(
    "{\"required_tools\":[\"lint\",\"test\"],\"complexity\":\"low\",\"domain\":\"quality\"}");
    _t_assert_f64(agnosai_score_agent(far, low_task),
    _t_expected(f64_from(1), _t_ratio(1, 3), f64_from(1), f64_from(1)),
    "high against low is two levels off, so 1 - 2/3");

    # --- complexity_score directly, at every step of the 1 - |diff|/3 ladder ---
    var med_agent = _t_agent(0, "medium", 0);
    _t_assert_f64(agnosai_complexity_score(med_agent, _t_task("{\"complexity\":\"medium\"}")),
    f64_from(1), "an exact complexity match is 1.0");
    _t_assert_f64(agnosai_complexity_score(med_agent, _t_task("{\"complexity\":\"low\"}")),
    _t_ratio(2, 3), "one level off is 2/3");
    _t_assert_f64(agnosai_complexity_score(_t_agent(0, "high", 0),
    _t_task("{\"complexity\":\"low\"}")), _t_ratio(1, 3), "two levels off is 1/3");
    _t_assert_f64(agnosai_complexity_score(med_agent, _t_task("{}")), f64_from(1),
    "a task with no complexity defaults to medium, so a medium agent scores 1.0");
    _t_assert_f64(agnosai_complexity_score(_t_agent(0, "high", 0), _t_task("{}")),
    _t_ratio(2, 3), "and a high agent is one level off that default");
    _t_assert_f64(agnosai_complexity_score(med_agent,
    _t_task("{\"complexity\":\"nonsense\"}")), f64_from(1),
    "an unrecognised task complexity also degrades to medium");
    _t_assert_f64(agnosai_complexity_score(med_agent, _t_task("{\"complexity\":42}")),
    f64_from(1), "as does a non-string one");

    # --- gpu ---
    var gpu_task = _t_task("{\"gpu_required\":true}");
    var plain = _t_agent(0, "medium", 0);
    _t_assert_f64(agnosai_gpu_score(plain, gpu_task), f64_from(0),
    "an agent with no GPU scores 0 when the task demands one");

    var gpu_req = _t_agent(0, "medium", 0);
    agnosai_agent_with_gpu(gpu_req, 1, 0, AGNOSAI_NO_LIMIT);
    _t_assert_f64(agnosai_gpu_score(gpu_req, gpu_task), f64_from(1), "gpu_required satisfies it");

    var gpu_pref = _t_agent(0, "medium", 0);
    agnosai_agent_with_gpu(gpu_pref, 0, 1, AGNOSAI_NO_LIMIT);
    _t_assert_f64(agnosai_gpu_score(gpu_pref, gpu_task), f64_from(1),
    "and so does gpu_preferred — the oracle accepts either");

    _t_assert_f64(agnosai_gpu_score(plain, _t_task("{}")), f64_from(1),
    "a task with no GPU requirement scores every agent 1.0");
    _t_assert_f64(agnosai_gpu_score(gpu_req, _t_task("{}")), f64_from(1),
    "including one that has a GPU — having one is never a penalty");
    _t_assert_f64(agnosai_gpu_score(plain, _t_task("{\"gpu_required\":false}")), f64_from(1),
    "an explicit false is the same as absent");

    # --- domain ---
    var dom_task = _t_task("{\"domain\":\"quality\"}");
    _t_assert_f64(agnosai_domain_score(_t_agent(0, "medium", "quality"), dom_task), f64_from(1),
    "a matching domain scores 1.0");
    _t_assert_f64(agnosai_domain_score(_t_agent(0, "medium", "QUALITY"), dom_task), f64_from(1),
    "compared case-insensitively");
    _t_assert_f64(agnosai_domain_score(_t_agent(0, "medium", "devops"), dom_task), f64_from(0),
    "a mismatched domain scores 0");
    _t_assert_f64(agnosai_domain_score(_t_agent(0, "medium", 0), dom_task), f64_from(1),
    "an agent with NO domain constraint is compatible with any, scoring 1.0");
    _t_assert_f64(agnosai_domain_score(_t_agent(0, "medium", "devops"), _t_task("{}")),
    f64_from(1), "and a task with no domain scores every agent 1.0");

    # --- test_no_context_full_score ---
    # An empty context means no required tools, medium complexity, no GPU and no
    # domain — every factor at 1.0 for a medium agent.
    var bare_task = _t_task("{}");
    _t_assert_f64(agnosai_score_agent(_t_agent(0, "medium", 0), bare_task),
    _t_expected(f64_from(1), f64_from(1), f64_from(1), f64_from(1)),
    "a task with no context scores a medium agent at the ceiling");

    # --- required_tools extraction ---
    assert_eq(agnosai_extract_required_tools(bare_task), 0, "an absent required_tools yields 0");
    var extracted = agnosai_extract_required_tools(perfect_task);
    assert(extracted != 0, "a well-formed list extracts");
    assert_eq(vec_len(extracted), 2, "with both entries");
    assert(str_eq(vec_get(extracted, 0), str_from("lint")) == 1, "in order");

    # a malformed list yields 0, which scores as NO requirement — a full 1.0.
    # That makes a malformed context flatter the agent rather than penalise it,
    # which is the oracle's behaviour and worth pinning as such.
    var bad_task = _t_task("{\"required_tools\":[\"lint\",7]}");
    assert_eq(agnosai_extract_required_tools(bad_task), 0,
    "one non-string entry rejects the whole list, as serde's Vec<String> does");
    _t_assert_f64(agnosai_tool_coverage_score(_t_agent(0, "medium", 0),
    agnosai_extract_required_tools(bad_task)), f64_from(1),
    "and a malformed list scores FULL coverage, not zero — the oracle flatters it");

    var not_arr = _t_task("{\"required_tools\":\"lint\"}");
    assert_eq(agnosai_extract_required_tools(not_arr), 0, "a non-array required_tools yields 0");

    var empty_req = _t_task("{\"required_tools\":[]}");
    var empty_extracted = agnosai_extract_required_tools(empty_req);
    assert(empty_extracted != 0, "an empty list extracts as an empty vec, not as absent");
    assert_eq(vec_len(empty_extracted), 0, "with no entries");
    _t_assert_f64(agnosai_tool_coverage_score(_t_agent(0, "medium", 0), empty_extracted),
    f64_from(1), "and scores full coverage");

    # extra tools on the agent are not a penalty
    _t_assert_f64(agnosai_tool_coverage_score(_t_agent(_t_tools("lint", "extra"), "medium", 0),
    agnosai_extract_required_tools(_t_task("{\"required_tools\":[\"lint\"]}"))), f64_from(1),
    "an agent carrying tools the task did not ask for still scores full coverage");

    # --- personality is the oracle's None arm ---
    _t_assert_f64(agnosai_personality_score(_t_agent(0, "medium", 0), bare_task),
    _t_ratio(1, 2), "personality is the neutral 0.5 — bhava defers, so every agent takes None");

    # --- the score is clamped to 0..1 ---
    var worst = _t_agent(0, "high", "devops");
    var worst_task = _t_task(
    "{\"required_tools\":[\"a\",\"b\"],\"complexity\":\"low\",\"domain\":\"quality\",\"gpu_required\":true}");
    var worst_score = agnosai_score_agent(worst, worst_task);
    assert_eq(f64_lt(worst_score, f64_from(0)), 0, "even the worst case is not negative");
    assert_eq(f64_gt(agnosai_score_agent(perfect_agent, perfect_task), f64_from(1)), 0,
    "and the best case does not exceed 1.0");

    # --- test_rank_agents_ordering ---
    var good = _t_agent(_t_tools("lint", "test"), "medium", "quality");
    var bad = _t_agent(0, "high", "devops");
    var pair = vec_new();
    vec_push(pair, bad);
    vec_push(pair, good);
    var ranked = agnosai_rank_agents(pair, perfect_task);
    assert_eq(vec_len(ranked), 2, "both agents are ranked");
    assert_eq(agnosai_scored_index(vec_get(ranked, 0)), 1,
    "the better agent ranks first, by its ORIGINAL index");
    assert_eq(f64_gt(agnosai_scored_score(vec_get(ranked, 0)),
    agnosai_scored_score(vec_get(ranked, 1))), 1, "and scores higher");

    # --- test_rank_agents_empty ---
    assert_eq(vec_len(agnosai_rank_agents(vec_new(), perfect_task)), 0,
    "ranking no agents yields no results");

    # --- ties keep input order ---
    # The oracle sorts with sort_by, which is a stable merge sort; order.cyr's
    # heapsort is not stable, so this is the behaviour most at risk in the port.
    var tied = vec_new();
    for (var i = 0; i < 6; i = i + 1) { vec_push(tied, _t_agent(0, "medium", 0)); }
    var tied_ranked = agnosai_rank_agents(tied, bare_task);
    assert_eq(vec_len(tied_ranked), 6, "six identical agents all rank");
    for (var j = 0; j < 6; j = j + 1) {
        assert_eq(agnosai_scored_index(vec_get(tied_ranked, j)), j,
        "identically-scoring agents keep their input order");
    }

    # a tie in the middle of a mixed set also holds its order
    var mixed = vec_new();
    vec_push(mixed, _t_agent(0, "high", 0));
    vec_push(mixed, _t_agent(_t_tools("lint", "test"), "medium", 0));
    vec_push(mixed, _t_agent(0, "high", 0));
    vec_push(mixed, _t_agent(_t_tools("lint", "test"), "medium", 0));
    var mixed_ranked = agnosai_rank_agents(mixed, perfect_task);
    assert_eq(agnosai_scored_index(vec_get(mixed_ranked, 0)), 1, "the first of the two best");
    assert_eq(agnosai_scored_index(vec_get(mixed_ranked, 1)), 3, "then the second");
    assert_eq(agnosai_scored_index(vec_get(mixed_ranked, 2)), 0, "then the first of the two worst");
    assert_eq(agnosai_scored_index(vec_get(mixed_ranked, 3)), 2, "then the second");

    # --- score_agent_with_tools matches score_agent ---
    _t_assert_f64(agnosai_score_agent_with_tools(perfect_agent, perfect_task,
    agnosai_extract_required_tools(perfect_task)),
    agnosai_score_agent(perfect_agent, perfect_task),
    "pre-extracting the tools does not change the score — only the work done");

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
