# =========================================================================
# tools_builtin_delegate — tests for src/tools/builtin/delegate.cyr.
#
# **No oracle tests exist**, and no oracle tool either: `rust-old/`'s registry
# is echo, json_transform, load_testing and security_audit, and its crews are
# driven by a human client over `POST /api/v1/crews`. This is the tool that lets
# the *model* delegate instead.
#
# What is pinned here is the contract that makes it usable by a model:
# it answers immediately with a `crew_id`, that id is live before the answer
# comes back, and a bad `agent` is a synchronous error rather than a crew that
# can only fail.
#
# **`delegate` is library surface the default binary does not register**, so
# nothing here asserts about `tools/list` — that suite pins the oracle's four,
# and it must keep doing so.
# =========================================================================

include "src/units.cyr"
include "src/arena_pool.cyr"
include "src/order.cyr"
include "src/id.cyr"
# strcase — `prompt_guard`, `cost_planning` and `definitions/assembler` all
# fold ASCII case; the shared helpers live here (extracted at the third use).
include "src/strcase.cyr"
# telemetry — `tools/native` and `orchestrator/crew_runner` record GenAI
# spans (ADR 017), so every suite that reaches them needs the module that
# defines the recorder. It depends on nothing in `src/` except `id`.
include "src/telemetry/mod.cyr"
include "src/core/mod.cyr"
include "src/learning/mod.cyr"
include "src/llm/mod.cyr"
include "src/server/ssrf.cyr"
include "src/server/prompt_guard.cyr"
include "src/server/output_filter.cyr"
include "src/server/prometheus.cyr"
include "src/server/auth.cyr"
include "src/guarded_fetch.cyr"
include "src/chan_lossy.cyr"
include "src/server/sse.cyr"
include "src/sandbox/mod.cyr"
include "src/tools/mod.cyr"
include "src/orchestrator/mod.cyr"
include "src/server/state.cyr"
include "src/tools/builtin/delegate.cyr"
include "tests/test_helpers.cyr"

fn _t_dl_state(): i64 {
    var s = agnosai_app_state_new(agnosai_orchestrator_new(0),
      agnosai_tool_registry_new(), agnosai_auth_config_new(),
      agnosai_event_bus_new(), agnosai_audit_chain_new(),
      agnosai_approval_gate_new());
    agnosai_app_state_definition_insert(s, str_from("researcher"),
      agnosai_agent_new(str_from("researcher"), str_from("finds things"), str_from("research")));
    return s;
}

fn _t_dl_input(agent, task): i64 {
    var i = agnosai_tool_input_new();
    if (agent != 0) {
        agnosai_tool_input_set(i, str_from("agent"), bayan_json_v_str_new(str_from(agent)));
    }
    if (task != 0) {
        agnosai_tool_input_set(i, str_from("task"), bayan_json_v_str_new(str_from(task)));
    }
    return i;
}

# The public constructor, named directly.
#
# `agnosai_register_delegate_builtin` goes through it, so the behaviour was
# covered — but reference coverage counts the SYMBOL, and an indirectly-used
# public fn reads as dead. Same for `agnosai_orchestrator_submit_crew` below.
fn _t_dl_tool_constructor(): i64 {
    var tool = agnosai_delegate_tool(_t_dl_state());
    assert(tool != 0, "the tool constructs");
    assert(str_eq_cstr(agnosai_tool_name(tool), "delegate") == 1, "...named delegate");
    return 0;
}

# The orchestrator entry point the tool is a thin wrapper over.
fn _t_dl_submit_crew_directly(): i64 {
    var st = _t_dl_state();
    var spec = agnosai_crew_new(str_from("direct"));
    var agents = vec_new();
    vec_push(agents, agnosai_agent_new(str_from("a"), str_from("r"), str_from("g")));
    agnosai_crew_with_agents(spec, agents);
    var tasks = vec_new();
    vec_push(tasks, agnosai_task_new(str_from("do it")));
    agnosai_crew_with_tasks(spec, tasks);

    var cid = agnosai_orchestrator_submit_crew(agnosai_app_state_orchestrator(st), spec);
    assert(cid != 0, "submit_crew returns a crew id");
    assert(agnosai_orchestrator_crew(agnosai_app_state_orchestrator(st), cid) != 0,
      "...and the crew is registered under it");
    return 0;
}

# A minimal runnable crew spec.
fn _t_dl_spec(): i64 {
    var spec = agnosai_crew_new(str_from("leakcheck"));
    var agents = vec_new();
    vec_push(agents, agnosai_agent_new(str_from("a"), str_from("r"), str_from("g")));
    agnosai_crew_with_agents(spec, agents);
    var tasks = vec_new();
    vec_push(tasks, agnosai_task_new(str_from("do it")));
    agnosai_crew_with_tasks(spec, tasks);
    return spec;
}

# --- The detached thread leaks nothing ----------------------------------

# Virtual-memory size in KiB, read from `/proc/self/statm` field 1 (pages).
#
# **VA, not RSS.** A thread stack is `mmap`ed and mostly untouched, so RSS
# barely moves whether or not it is freed — the leak is address space, and
# `statm`'s first field is the only one that shows it.
fn _t_dl_va_kib(): i64 {
    var fd = sys_open("/proc/self/statm", 0, 0);
    if (fd < 0) { return 0 - 1; }
    var buf[128];
    var n = sys_read(fd, &buf, 127);
    sys_close(fd);
    if (n <= 0) { return 0 - 1; }
    store8(&buf + n, 0);
    var pages = 0;
    var i = 0;
    while (i < n && (load8(&buf + i) & 255) >= 48 && (load8(&buf + i) & 255) <= 57) {
        pages = pages * 10 + ((load8(&buf + i) & 255) - 48);
        i = i + 1;
    }
    return pages * 4;
}

# **The leak this closed, measured rather than asserted away.**
#
# Before cyrius 6.5.8 this called `thread_create` and never joined, stranding
# 2 MiB of stack plus 4 KiB of TLS per submitted crew — upstream measured 100
# unjoined threads at 210,124,800 B of VA. `thread_create_detached` has the
# child unmap its own stack in the trampoline tail, with the TLS carved from the
# top of that same mapping so one `munmap` frees both.
#
# 32 crews at the old cost would be ~67 MiB. The bound below is 16 MiB, which is
# far under that and far above the few hundred KiB of ordinary allocator growth
# 32 crew runs produce — so it discriminates without being tight enough to fail
# on an unrelated allocation. Reverting to `thread_create` fails it.
fn _t_dl_detached_threads_do_not_leak_va(): i64 {
    var st = _t_dl_state();
    var o = agnosai_app_state_orchestrator(st);

    # Warm every one-time path first — the first thread arms the shared-heap
    # lock and the allocator grows once.
    agnosai_orchestrator_submit_crew(o, _t_dl_spec());
    sleep_ms(50);

    var before = _t_dl_va_kib();
    if (before < 0) { return 0; }
    for (var i = 0; i < 32; i = i + 1) {
        agnosai_orchestrator_submit_crew(o, _t_dl_spec());
        # Let each finish before the next, so what is measured is retention
        # after exit rather than 32 live stacks.
        sleep_ms(15);
    }
    sleep_ms(200);
    var grew = _t_dl_va_kib() - before;

    assert(grew < 16384,
      "32 detached crews retain under 16 MiB of address space — at the pre-6.5.8 \
    2 MiB per unjoined stack this would be ~67 MiB");
    return 0;
}

fn _t_dl_schema(): i64 {
    # `schema_fp` takes the allocator first; passing 0 there is not a null
    # ctx, it is a null allocator, and `alloc_via` follows it.
    var s = _agnosai_delegate_schema(default_alloc(), 0);
    assert(str_eq_cstr(agnosai_tool_schema_name(s), "delegate") == 1, "the tool is named delegate");
    # **Two parameters, not the crew request's full shape.** Everything else a
    # crew carries is something the model would have to invent.
    assert(vec_len(agnosai_tool_schema_parameters(s)) == 2, "exactly agent and task");
    return 0;
}

fn _t_dl_returns_an_id_not_a_result(): i64 {
    var st = _t_dl_state();
    var out = _agnosai_delegate_execute(st, _t_dl_input("researcher", "find things"));
    assert(agnosai_tool_output_success(out) == 1, "a valid delegation succeeds");

    var v = agnosai_tool_output_result(out);
    var cid = bayan_json_v_obj_get_by_cstr(v, "crew_id");
    assert(cid != 0 && bayan_json_v_is_str(cid) == 1, "it answers with a crew_id");
    assert(agnosai_uuid_parse(bayan_json_v_str(cid)) != 0, "...a real UUID");
    # **Not the crew's output.** The whole point is that the tool call does not
    # wait for the crew; a `results` key here would mean it did.
    assert(bayan_json_v_obj_get_by_cstr(v, "results") == 0, "and NOT the crew's results");
    return 0;
}

fn _t_dl_id_is_live_before_the_call_returns(): i64 {
    # The contract a polling caller depends on: the id is resolvable the moment
    # it is handed over. `_agnosai_orch_register` puts the crew in the map as
    # pending before execution starts, so this holds without waiting.
    var st = _t_dl_state();
    var out = _agnosai_delegate_execute(st, _t_dl_input("researcher", "find things"));
    var cid = bayan_json_v_str(bayan_json_v_obj_get_by_cstr(agnosai_tool_output_result(out), "crew_id"));

    var crew = agnosai_orchestrator_crew(agnosai_app_state_orchestrator(st), cid);
    assert(crew != 0, "the crew is registered before delegate returns");
    assert(str_eq(agnosai_crew_state_crew_id(crew), cid) == 1, "...under the id handed back");

    # **This is the assertion that makes the tool asynchronous rather than
    # merely id-returning**, and the first version of this suite did not have
    # it — swapping `submit_crew` for the blocking `run_crew` passed 17/17,
    # because every other assertion here holds for a crew that already
    # finished. Measured: `delegate` returns in 0 ms with the crew PENDING, and
    # the same crew reads COMPLETED 300 ms later.
    #
    # ⚠ **Not finished, rather than PENDING.** The worker stores RUNNING as soon as its thread
    # starts (ADR 022), so this read can see either, and neither means delegate waited. It
    # asserted PENDING alone until 2.3.1, which failed about 1 run in 150 on four CPUs, every
    # failure reading RUNNING, and failed CI on 2.3.1's merge.
    #
    # Narrow race, stated rather than hidden: the worker could in principle
    # finish between `submit_crew` returning and this read, which would show a
    # terminal status and fail spuriously. It has not been observed — the crew
    # needs milliseconds and this is microseconds behind it — and the
    # alternative is no assertion on the property at all, which is what the
    # mutation caught.
    var seen = agnosai_crew_state_status(crew);
    assert(seen == AGNOSAI_CREW_PENDING || seen == AGNOSAI_CREW_RUNNING,
      "...and not finished — delegate did NOT wait for the crew to finish");
    return 0;
}

# The crew really does run, on its own thread, after delegate has returned.
#
# The pair matters: the assertion above proves `delegate` did not wait, and this
# one proves the work was not simply dropped. Neither alone distinguishes async
# execution from no execution.
fn _t_dl_crew_completes_on_its_thread(): i64 {
    var st = _t_dl_state();
    var out = _agnosai_delegate_execute(st, _t_dl_input("researcher", "find things"));
    var cid = bayan_json_v_str(bayan_json_v_obj_get_by_cstr(agnosai_tool_output_result(out), "crew_id"));

    # Poll rather than sleep a fixed span, so a slower box does not flake.
    var waited = 0;
    var status = AGNOSAI_CREW_PENDING;
    while (waited < 5000 && status != AGNOSAI_CREW_COMPLETED && status != AGNOSAI_CREW_FAILED) {
        sleep_ms(10);
        waited = waited + 10;
        status = agnosai_crew_state_status(
          agnosai_orchestrator_crew(agnosai_app_state_orchestrator(st), cid));
    }
    assert(status != AGNOSAI_CREW_PENDING,
      "the submitted crew reaches a terminal status on its own thread");
    return 0;
}

fn _t_dl_unknown_agent_is_synchronous(): i64 {
    # A bad agent name must fail here, not become a crew that can only fail —
    # otherwise the model has to poll to discover a typo.
    var st = _t_dl_state();
    var out = _agnosai_delegate_execute(st, _t_dl_input("nobody", "find things"));
    assert(agnosai_tool_output_success(out) == 0, "an unknown agent is an error");
    assert(str_contains_cstr(agnosai_tool_output_error(out), "no such agent") == 1,
      "...saying so");

    # And nothing was registered for it.
    assert(vec_len(agnosai_orchestrator_crew_ids(
          agnosai_app_state_orchestrator(st))) == 0, "...with no crew left behind");
    return 0;
}

fn _t_dl_missing_params(): i64 {
    var st = _t_dl_state();
    var no_agent = _agnosai_delegate_execute(st, _t_dl_input(0, "do it"));
    assert(agnosai_tool_output_success(no_agent) == 0, "a missing agent is an error");
    var no_task = _agnosai_delegate_execute(st, _t_dl_input("researcher", 0));
    assert(agnosai_tool_output_success(no_task) == 0, "a missing task is an error");
    return 0;
}

# An input lasts as long as its call, and the crew does not (ADR 029). Pinned by pointer, as the bug
# reads fine until something else is written over the arena.
fn _t_dl_keeps_nothing_of_its_input(): i64 {
    var st = _t_dl_state();
    var def = agnosai_app_state_definition_get(st, str_from("researcher"));
    var text = str_from("look at this");
    var spec = _agnosai_delegate_spec(def, str_from("researcher"), text);
    var kept = agnosai_task_description(vec_get(agnosai_crew_tasks(spec), 0));
    assert_neq(str_data(kept), str_data(text), "a delegated task holds its own copy of the text");
    assert(str_eq(kept, text) == 1, "of the same words");
    return 0;
}

# ADR 029: the delegated crew stays in the trace through `agnosai_tool_input_span_ctx`. Off, there
# is no context to hand on. With the exporter on, the chokepoint's half and the runner's are in
# `telemetry_wiring`, which drives a delegated crew through both.
fn _t_dl_stays_in_the_trace(): i64 {
    var state = _t_dl_state();
    var tool = agnosai_delegate_tool(state);
    var input = _t_dl_input("researcher", "look at this");
    assert_eq(agnosai_tool_input_span_ctx(input), 0, "with telemetry off an input carries no context");
    var out = agnosai_tool_execute(tool, input);
    assert_eq(agnosai_tool_output_success(out), 1, "and delegating still works");
    return 0;
}

# Roadmap B7 item 9's repro. A `delegate` call under a `traceparent` used to start a new root: the
# crew's spans went to a trace of their own. Now they join the call's, and the crew reports no
# `invoke_workflow` span, as the conventions say a tool delegating to a sub-agent SHOULD NOT.
fn _t_dl_joins_the_trace_with_telemetry_on(): i64 {
    var g = agnosai_telemetry_init_tracing(str_from("http://localhost:4318"));
    var ring = agnosai_otlp_exporter_ring(agnosai_telemetry_exporter());
    var st = _t_dl_state();
    var tool = agnosai_delegate_tool(st);
    var parent = agnosai_otlp_span_context_parse(
      str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01"));
    var input = _t_dl_input("researcher", "find things");
    var out = agnosai_tool_execute_in(tool, input, parent);
    assert(agnosai_tool_input_span_ctx(input) != 0, "the chokepoint gives the call its own context");
    assert_eq(agnosai_otlp_span_context_span_id(agnosai_tool_input_span_ctx(input)) ==
      agnosai_otlp_span_context_span_id(parent), 0, "which is a span of its own, not its parent's");

    var cid = bayan_json_v_str(bayan_json_v_obj_get_by_cstr(agnosai_tool_output_result(out), "crew_id"));
    var o = agnosai_app_state_orchestrator(st);
    var waited = 0;
    var status = AGNOSAI_CREW_PENDING;
    while (waited < 5000 && status != AGNOSAI_CREW_COMPLETED && status != AGNOSAI_CREW_FAILED) {
        sleep_ms(10);
        waited = waited + 10;
        status = agnosai_crew_state_status(agnosai_orchestrator_crew(o, cid));
    }
    var doc = agnosai_otlp_ring_drain(ring, str_from("agnosai"));
    agnosai_telemetry_shutdown(g);
    assert_eq(str_contains_cstr(doc, "invoke_workflow"), 0, "a delegated crew reports no workflow span");
    assert_eq(str_contains_cstr(doc, "\"name\":\"invoke_agent"), 1, "its agent's span is there");
    assert_eq(str_contains_cstr(doc, "\"execute_tool delegate\""), 1, "beside the tool's");
    # Every span in the document is in the call's trace: two trace ids would be the old bug.
    var first = str_index_of_cstr(doc, "\"traceId\":\"");
    assert(first >= 0, "there is a trace");
    assert_eq(str_contains_cstr(doc, "4bf92f3577b34da6a3ce929d0e0e4736"), 1, "the caller's");
    var n = 0;
    var off = 0;
    while (off < str_len(doc)) {
        var i = str_index_of_cstr(str_sub(doc, off, str_len(doc) - off), "\"traceId\":\"");
        if (i < 0) { break; }
        off = off + i + 11;
        n = n + 1;
        assert(memeq(str_data(doc) + off, "4bf92f3577b34da6a3ce929d0e0e4736", 32) == 1,
          "every span of the delegated crew is in the call's trace");
    }
    assert(n >= 2, "and there is more than the tool's own");
    return 0;
}

# What a call refused for its parameters leaves on the global heap.
#
# ⚠ **First of all, as `alloc_used` counts every thread.** The tests below leave detached crews
# running, and one still allocating while this measures reads as this call's: run after them it
# read 912 and 1,208 B in two runs of the whole suite, and 0 alone.
fn _t_dl_refusal_leaves_nothing(): i64 {
    var st = _t_dl_state();
    var ar = arena_allocator_growable(4096);
    var missing = agnosai_tool_input_with_alloc(agnosai_tool_input_new(), ar);
    _agnosai_delegate_execute(st, missing);
    reset_via(ar);
    var before = alloc_used();
    for (var i = 0; i < 50; i = i + 1) {
        _agnosai_delegate_execute(st, missing);
        reset_via(ar);
    }
    assert_eq(alloc_used() - before, 0, "a call refused for its parameters leaves nothing");
    return 0;
}

# What goes back with the call is its answer. The crew it starts outlives the call, so that stays
# off the call's allocator: a crew reading memory its parent's turn has given back would be the
# worst failure this tool could have.
fn _t_dl_answers_in_the_calls_allocator(): i64 {
    var st = _t_dl_state();
    var ar = arena_allocator_growable(4096);
    var input = agnosai_tool_input_with_alloc(_t_dl_input("researcher", "find things"), ar);
    # A bump arena hands out rising addresses, so what lands between two markers is in it.
    var below = alloc_via(ar, 8);
    var out = _agnosai_delegate_execute(st, input);
    var above = alloc_via(ar, 8);
    assert(out > below && out < above, "its answer is in the call's allocator");
    var answer = agnosai_tool_output_result(out);
    assert(answer > below && answer < above, "all of it");
    var cid = str_clone(bayan_json_v_str(bayan_json_v_obj_get_by_cstr(answer, "crew_id")));
    # Scribble over what the call held, and the crew must still run.
    reset_via(ar);
    memset(alloc_via(ar, 4000), 90, 4000);
    var o = agnosai_app_state_orchestrator(st);
    var waited = 0;
    var status = AGNOSAI_CREW_PENDING;
    while (waited < 5000 && status != AGNOSAI_CREW_COMPLETED && status != AGNOSAI_CREW_FAILED) {
        sleep_ms(10);
        waited = waited + 10;
        status = agnosai_crew_state_status(agnosai_orchestrator_crew(o, cid));
    }
    assert(status == AGNOSAI_CREW_COMPLETED || status == AGNOSAI_CREW_FAILED,
      "the crew it started finishes with the call's arena long gone");
    assert(str_eq(agnosai_crew_state_crew_id(agnosai_orchestrator_crew(o, cid)), cid) == 1,
      "and holds its own id");
    return 0;
}

fn _t_dl_is_not_registered_by_default(): i64 {
    # **The parity guard.** `delegate` is library surface; a default registry
    # must not carry it, or the binary's tools/list stops matching the oracle's
    # four. Registration is opt-in and this proves the default is untouched.
    var reg = agnosai_tool_registry_new();
    agnosai_register_basic_builtins(reg);
    agnosai_register_load_testing_builtin(reg);
    agnosai_register_security_audit_builtin(reg);
    assert(agnosai_tool_registry_count(reg) == 4, "the default set is the oracle's four");
    assert(agnosai_tool_registry_get(reg, str_from("delegate")) == 0,
      "...and delegate is NOT among them");

    # Opting in adds exactly one.
    agnosai_register_delegate_builtin(reg, _t_dl_state());
    assert(agnosai_tool_registry_count(reg) == 5, "opting in adds it");
    assert(agnosai_tool_registry_get(reg, str_from("delegate")) != 0, "...by name");
    return 0;
}

fn main(): i64 {
    alloc_init();
    sakshi_set_level(SK_FATAL);

    # Measures the global heap, so it goes before any thread exists. Starts no crew.
    _t_dl_refusal_leaves_nothing();
    # ⚠ **First, before any crew exists.** The tests below leave detached crews running, and the
    # exporter is process-wide, so a crew still going when this starts writes a trace of its own
    # into the document this test reads. Run after them, that failed about 1 run in 300.
    _t_dl_joins_the_trace_with_telemetry_on();
    _t_dl_tool_constructor();
    _t_dl_submit_crew_directly();
    _t_dl_detached_threads_do_not_leak_va();
    _t_dl_schema();
    _t_dl_returns_an_id_not_a_result();
    _t_dl_id_is_live_before_the_call_returns();
    _t_dl_crew_completes_on_its_thread();
    _t_dl_unknown_agent_is_synchronous();
    _t_dl_missing_params();
    _t_dl_keeps_nothing_of_its_input();
    _t_dl_stays_in_the_trace();
    _t_dl_answers_in_the_calls_allocator();
    _t_dl_is_not_registered_by_default();

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
