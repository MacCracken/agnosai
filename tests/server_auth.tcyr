# =========================================================================
# server_auth — rust-old/src/server/auth.rs, both halves.
#
# All TEN of the oracle's tests port directly, because `agnosai_auth_check` is
# shaped as `fn(config, inputs) -> status` rather than as a transport handler.
# The oracle needs `#[tokio::test]` + an axum `oneshot` only because its
# middleware signature is async; the decision it makes is synchronous, and here
# it is tested as such.
#
# The suite then goes well past the oracle, which never exercises: the
# `to_str()` visible-ASCII gate, case-sensitivity of the `Bearer ` prefix, the
# length-independence of the secret compare, the JwtConfig builders, ANY
# algorithm-confusion case, base64url strictness, the `exp` leeway boundary, or
# the pre-auth allocation bound.
#
# Two behaviours here differ from the oracle on purpose, each with an ADR and
# each pinned by a test that names the divergence: the constant-time secret
# compare (ADR 009) and requiring a configured `iss`/`aud` (ADR 010).
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/core.cyr"
include "src/learning.cyr"
include "src/llm.cyr"
include "src/server_ssrf.cyr"
include "src/server_prompt_guard.cyr"
include "src/server_output_filter.cyr"
include "src/server_prometheus.cyr"
include "src/server_auth.cyr"
include "tests/test_helpers.cyr"
include "tests/server_auth_vectors.cyr"

# base64url-encode, no padding — the JWT segment encoding. Only used to build
# an oversized header for the pre-auth allocation bound below; every token the
# suite actually validates is a frozen vector.
fn _t_b64u(s: Str): Str {
    var alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
    var p = str_data(s);
    var n = str_len(s);
    var sb = str_builder_new();
    var i = 0;
    while (i + 3 <= n) {
        var w = ((load8(p + i) & 255) << 16) | ((load8(p + i + 1) & 255) << 8)
        | (load8(p + i + 2) & 255);
        str_builder_putc(sb, load8(alpha + ((w >> 18) & 63)));
        str_builder_putc(sb, load8(alpha + ((w >> 12) & 63)));
        str_builder_putc(sb, load8(alpha + ((w >> 6) & 63)));
        str_builder_putc(sb, load8(alpha + (w & 63)));
        i = i + 3;
    }
    var rem = n - i;
    if (rem == 1) {
        var a = load8(p + i) & 255;
        str_builder_putc(sb, load8(alpha + ((a >> 2) & 63)));
        str_builder_putc(sb, load8(alpha + ((a << 4) & 63)));
    }
    if (rem == 2) {
        var b0 = load8(p + i) & 255;
        var b1 = load8(p + i + 1) & 255;
        str_builder_putc(sb, load8(alpha + ((b0 >> 2) & 63)));
        str_builder_putc(sb, load8(alpha + (((b0 << 4) | (b1 >> 4)) & 63)));
        str_builder_putc(sb, load8(alpha + ((b1 << 2) & 63)));
    }
    return str_builder_build(sb);
}

# Build an `Authorization: Bearer <token>` value.
fn _t_bearer(token: Str): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Bearer ");
    str_builder_add_str(sb, token);
    return str_builder_build(sb);
}

# --- The oracle's five shared-secret tests -------------------------------

# Oracle: `passes_when_disabled`. No header at all, auth off -> 200.
fn _t_passes_when_disabled(): i64 {
    var c = agnosai_auth_config_new();
    assert(agnosai_auth_config_enabled(c) == 0, "default config is disabled");
    assert(agnosai_auth_check(c, 0, str_from("")) == HTTP_OK,
    "disabled passes with no header");
    # ...and stays open even when a wrong token *is* supplied, which is what
    # "passes through unconditionally" means.
    assert(agnosai_auth_check(c, 1, _t_bearer(str_from("anything"))) == HTTP_OK,
    "disabled passes with a wrong token");
    return 0;
}

# Oracle: `rejects_missing_token_when_enabled`.
fn _t_rejects_missing_token(): i64 {
    var c = agnosai_auth_config_with_secret(str_from("my-secret"));
    assert(agnosai_auth_check(c, 0, str_from("")) == HTTP_UNAUTHORIZED,
    "missing header rejected");
    return 0;
}

# Oracle: `rejects_wrong_token_when_enabled`.
fn _t_rejects_wrong_token(): i64 {
    var c = agnosai_auth_config_with_secret(str_from("my-secret"));
    assert(agnosai_auth_check(c, 1, _t_bearer(str_from("wrong-token"))) == HTTP_UNAUTHORIZED,
    "wrong token rejected");
    return 0;
}

# Oracle: `passes_with_correct_token`.
fn _t_passes_with_correct_token(): i64 {
    var c = agnosai_auth_config_with_secret(str_from("my-secret"));
    assert(agnosai_auth_check(c, 1, _t_bearer(str_from("my-secret"))) == HTTP_OK,
    "correct token passes");
    return 0;
}

# Oracle: `rejects_empty_bearer_token` — the header is exactly `Bearer `.
fn _t_rejects_empty_bearer(): i64 {
    var c = agnosai_auth_config_with_secret(str_from("my-secret"));
    assert(agnosai_auth_check(c, 1, str_from("Bearer ")) == HTTP_UNAUTHORIZED,
    "empty bearer token rejected");
    # The distinction that makes this test non-redundant: an empty *secret*
    # would otherwise match an empty token. It must still be rejected, because
    # the oracle bails before it ever compares.
    var c2 = agnosai_auth_config_with_secret(str_from(""));
    assert(agnosai_auth_check(c2, 1, str_from("Bearer ")) == HTTP_UNAUTHORIZED,
    "empty bearer rejected even against an empty secret");
    return 0;
}

# --- Beyond the oracle: header parsing -----------------------------------

fn _t_bearer_extraction(): i64 {
    assert(str_eq(agnosai_auth_bearer_token(str_from("Bearer abc")), str_from("abc")) == 1,
    "extracts the token after the prefix");
    assert(str_len(agnosai_auth_bearer_token(str_from("Bearer a b c"))) == 5,
    "token keeps interior spaces");
    assert(agnosai_auth_bearer_token(str_from("Bearer ")) == 0, "empty token is 0");
    assert(agnosai_auth_bearer_token(str_from("")) == 0, "empty header is 0");
    assert(agnosai_auth_bearer_token(str_from("Bearer")) == 0,
    "prefix without its trailing space is 0");
    assert(agnosai_auth_bearer_token(str_from("Basic abc")) == 0, "wrong scheme is 0");
    assert(agnosai_auth_bearer_token(str_from(" Bearer abc")) == 0,
    "leading space defeats the prefix match");
    return 0;
}

# The oracle's `starts_with("Bearer ")` is case-SENSITIVE, so RFC 7235's
# case-insensitive scheme rule does not apply. Reproduced deliberately: a client
# sending `bearer ` gets a 401 from Rust today, and must here too.
fn _t_bearer_is_case_sensitive(): i64 {
    var c = agnosai_auth_config_with_secret(str_from("s"));
    assert(agnosai_auth_bearer_token(str_from("bearer s")) == 0, "lowercase rejected");
    assert(agnosai_auth_bearer_token(str_from("BEARER s")) == 0, "uppercase rejected");
    assert(agnosai_auth_bearer_token(str_from("BeArEr s")) == 0, "mixed case rejected");
    assert(agnosai_auth_check(c, 1, str_from("bearer s")) == HTTP_UNAUTHORIZED,
    "lowercase scheme is a 401, not a pass");
    return 0;
}

# The oracle's `.and_then(|v| v.to_str().ok())`: a header carrying a byte
# outside visible ASCII is `None`, so it takes the missing-header arm.
fn _t_to_str_gate(): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Bearer ok");
    str_builder_putc(sb, 200);
    var high = str_builder_build(sb);
    assert(agnosai_auth_bearer_token(high) == 0, "high byte fails the to_str gate");

    var sb2 = str_builder_new();
    str_builder_add_cstr(sb2, "Bearer a");
    str_builder_putc(sb2, 9);
    str_builder_add_cstr(sb2, "b");
    assert(agnosai_auth_bearer_token(str_builder_build(sb2)) != 0,
    "tab is visible-ASCII for to_str and passes the gate");

    var sb3 = str_builder_new();
    str_builder_add_cstr(sb3, "Bearer a");
    str_builder_putc(sb3, 0);
    str_builder_add_cstr(sb3, "b");
    assert(agnosai_auth_bearer_token(str_builder_build(sb3)) == 0,
    "an embedded NUL fails the gate");

    var c = agnosai_auth_config_with_secret(str_from("ok"));
    assert(agnosai_auth_check(c, 1, high) == HTTP_UNAUTHORIZED,
    "a header failing to_str is a 401");
    return 0;
}

# --- Beyond the oracle: the secret comparison ----------------------------

# The compare is over SHA-256 digests, so it is total on the value and
# independent of length. These pin the accept/reject set the oracle asserts.
fn _t_secret_compare(): i64 {
    var c = agnosai_auth_config_with_secret(str_from("my-secret"));
    assert(agnosai_auth_check(c, 1, _t_bearer(str_from("my-secre"))) == HTTP_UNAUTHORIZED,
    "prefix of the secret rejected");
    assert(agnosai_auth_check(c, 1, _t_bearer(str_from("my-secret "))) == HTTP_UNAUTHORIZED,
    "secret plus a trailing space rejected");
    assert(agnosai_auth_check(c, 1, _t_bearer(str_from("my-secretX"))) == HTTP_UNAUTHORIZED,
    "secret plus a trailing byte rejected");
    assert(agnosai_auth_check(c, 1, _t_bearer(str_from("My-Secret"))) == HTTP_UNAUTHORIZED,
    "secret compare is case-sensitive");
    assert(agnosai_auth_check(c, 1, _t_bearer(str_from("my-secret"))) == HTTP_OK,
    "exact match accepted");
    return 0;
}

# A long secret and a 1-byte token must both be rejected and must exercise the
# same fixed-width compare. This is the regression guard on the module header's
# claim: if someone "simplifies" this to `ct_eq_bytes_lens` or to the oracle's
# max-length loop, behaviour here is unchanged but the timing leak returns — so
# this test cannot catch that alone, and the ADR is what carries the reasoning.
# What it *does* catch is a compare that reads past a short input.
fn _t_secret_length_extremes(): i64 {
    var sb = str_builder_new();
    var i = 0;
    while (i < 4096) { str_builder_putc(sb, 97 + (i % 26)); i = i + 1; }
    var long = str_builder_build(sb);

    var c = agnosai_auth_config_with_secret(long);
    assert(agnosai_auth_check(c, 1, _t_bearer(str_from("a"))) == HTTP_UNAUTHORIZED,
    "1-byte token against a 4096-byte secret rejected");
    assert(agnosai_auth_check(c, 1, _t_bearer(long)) == HTTP_OK,
    "4096-byte secret matches itself");

    var c2 = agnosai_auth_config_with_secret(str_from("a"));
    assert(agnosai_auth_check(c2, 1, _t_bearer(long)) == HTTP_UNAUTHORIZED,
    "4096-byte token against a 1-byte secret rejected");
    return 0;
}

# --- Config surface ------------------------------------------------------

fn _t_config_surface(): i64 {
    var d = agnosai_auth_config_new();
    assert(agnosai_auth_config_enabled(d) == 0, "default disabled");
    assert(str_len(agnosai_auth_config_secret(d)) == 0, "default secret empty");
    assert(agnosai_auth_config_jwt(d) == 0, "default has no jwt");

    var s = agnosai_auth_config_with_secret(str_from("k"));
    assert(agnosai_auth_config_enabled(s) == 1, "with_secret enables");
    assert(str_eq(agnosai_auth_config_secret(s), str_from("k")) == 1, "with_secret stores");
    assert(agnosai_auth_config_jwt(s) == 0, "with_secret has no jwt");

    agnosai_auth_config_set_enabled(s, 0);
    assert(agnosai_auth_config_enabled(s) == 0, "set_enabled disables");
    agnosai_auth_config_set_enabled(s, 1);
    assert(agnosai_auth_config_enabled(s) == 1, "set_enabled re-enables");

    var j = agnosai_jwt_config_new(str_from("-----BEGIN PUBLIC KEY-----"));
    var w = agnosai_auth_config_with_jwt(j);
    assert(agnosai_auth_config_enabled(w) == 1, "with_jwt enables");
    assert(agnosai_auth_config_jwt(w) == j, "with_jwt stores the config");
    assert(str_len(agnosai_auth_config_secret(w)) == 0, "with_jwt leaves the secret empty");
    return 0;
}

fn _t_jwt_config_builders(): i64 {
    var j = agnosai_jwt_config_new(str_from("PEM"));
    assert(str_eq(agnosai_jwt_config_public_key_pem(j), str_from("PEM")) == 1, "pem stored");
    assert(agnosai_jwt_config_issuer(j) == 0, "issuer defaults to none");
    assert(agnosai_jwt_config_audience(j) == 0, "audience defaults to none");

    agnosai_jwt_config_with_issuer(j, str_from("test-issuer"));
    assert(str_eq(agnosai_jwt_config_issuer(j), str_from("test-issuer")) == 1, "issuer set");
    assert(agnosai_jwt_config_audience(j) == 0, "audience untouched by with_issuer");

    agnosai_jwt_config_with_audience(j, str_from("agnosai"));
    assert(str_eq(agnosai_jwt_config_audience(j), str_from("agnosai")) == 1, "audience set");
    return 0;
}

# --- JWT: the key -------------------------------------------------------

# The full RS256 config the oracle's `jwt_config()` builds.
fn _t_jwt_cfg(): i64 {
    var j = agnosai_jwt_config_new(_t_jwt_pubkey_pem());
    agnosai_jwt_config_with_issuer(j, str_from("test-issuer"));
    agnosai_jwt_config_with_audience(j, str_from("agnosai"));
    return agnosai_auth_config_with_jwt(j);
}

# Check a token at a fixed `now`, so nothing here depends on the wall clock.
fn _t_jwt_at(c, token: Str, now): i64 {
    return agnosai_auth_check_at(c, 1, _t_bearer(token), now);
}

# Check a token at a time comfortably before the far-future `exp`.
fn _t_jwt_check(c, token: Str): i64 {
    return _t_jwt_at(c, token, 1700000000);
}

fn _t_jwt_key_prepare(): i64 {
    var j = agnosai_jwt_config_new(_t_jwt_pubkey_pem());
    assert(agnosai_jwt_config_prepare(j) == 1, "the oracle's SPKI PEM parses");
    assert(agnosai_jwt_config_modulus_len(j) == 256,
    "a 2048-bit key yields a 256-byte modulus");
    # Preparing twice is idempotent, not a re-parse.
    assert(agnosai_jwt_config_prepare(j) == 1, "prepare is idempotent");
    assert(agnosai_jwt_config_modulus_len(j) == 256, "modulus unchanged after re-prepare");

    var bad = agnosai_jwt_config_new(str_from("not a pem at all"));
    assert(agnosai_jwt_config_prepare(bad) == 0, "garbage PEM is refused");

    var trunc = agnosai_jwt_config_new(str_from("-----BEGIN PUBLIC KEY-----\nAAAA\n"));
    assert(agnosai_jwt_config_prepare(trunc) == 0, "PEM with no END marker is refused");

    var empty = agnosai_jwt_config_new(str_from(""));
    assert(agnosai_jwt_config_prepare(empty) == 0, "empty PEM is refused");
    return 0;
}

# A config whose key does not parse is a *server* fault, so it answers 500 on
# every request that reaches the JWT path — the oracle's behaviour
# (auth.rs:120-123), decided once here instead of per request.
fn _t_jwt_bad_key_is_500(): i64 {
    var c = agnosai_auth_config_with_jwt(agnosai_jwt_config_new(str_from("nope")));
    assert(_t_jwt_check(c, _t_jwt_valid()) == HTTP_INTERNAL, "bad PEM is a 500");
    # But a request that never reaches the JWT path is still a 401.
    assert(agnosai_auth_check_at(c, 0, str_from(""), 1700000000) == HTTP_UNAUTHORIZED,
    "missing header is a 401 even with a broken key");
    assert(agnosai_auth_check_at(c, 1, str_from("Bearer "), 1700000000) == HTTP_UNAUTHORIZED,
    "empty bearer is a 401 even with a broken key");
    return 0;
}

# --- JWT: the oracle's four cases ---------------------------------------

fn _t_jwt_oracle_cases(): i64 {
    var c = _t_jwt_cfg();
    assert(_t_jwt_check(c, _t_jwt_valid()) == HTTP_OK,
    "oracle jwt_valid_token_passes");
    assert(_t_jwt_check(c, _t_jwt_expired()) == HTTP_UNAUTHORIZED,
    "oracle jwt_expired_token_rejected");
    assert(_t_jwt_check(c, _t_jwt_wrong_issuer()) == HTTP_UNAUTHORIZED,
    "oracle jwt_wrong_issuer_rejected");
    assert(_t_jwt_check(c, _t_jwt_wrong_audience()) == HTTP_UNAUTHORIZED,
    "oracle jwt_wrong_audience_rejected");
    # The oracle asserts 401 and NOT 500 here, so this only passes if the PEM
    # genuinely parsed — it is the test that proves the key path works.
    assert(_t_jwt_check(c, _t_jwt_garbage()) == HTTP_UNAUTHORIZED,
    "oracle jwt_garbage_token_rejected — 401, not 500");
    return 0;
}

# --- Decision 1: the iss/aud tightening (ADR 010) ------------------------

fn _t_jwt_absent_iss_aud_rejected(): i64 {
    var c = _t_jwt_cfg();
    # THE DIVERGENCE. jsonwebtoken accepts both of these, because set_issuer
    # and set_audience never touch required_spec_claims.
    assert(_t_jwt_check(c, _t_jwt_no_iss()) == HTTP_UNAUTHORIZED,
    "a token with no iss is rejected when an issuer is configured");
    assert(_t_jwt_check(c, _t_jwt_no_aud()) == HTTP_UNAUTHORIZED,
    "a token with no aud is rejected when an audience is configured");
    return 0;
}

# The tightening is CONDITIONAL — it mirrors the oracle's `if let Some(..)`
# shape. With nothing configured, an absent claim is still fine, so
# `JwtConfig::new(key)` keeps behaving exactly as the oracle's does.
fn _t_jwt_tightening_is_conditional(): i64 {
    var bare = agnosai_auth_config_with_jwt(agnosai_jwt_config_new(_t_jwt_pubkey_pem()));
    assert(_t_jwt_check(bare, _t_jwt_no_iss()) == HTTP_OK,
    "no iss passes when no issuer is configured");
    assert(_t_jwt_check(bare, _t_jwt_no_aud()) == HTTP_OK,
    "no aud passes when no audience is configured");
    assert(_t_jwt_check(bare, _t_jwt_wrong_issuer()) == HTTP_OK,
    "any iss passes when no issuer is configured");

    # Issuer configured, audience not: only iss is enforced.
    var jo = agnosai_jwt_config_new(_t_jwt_pubkey_pem());
    agnosai_jwt_config_with_issuer(jo, str_from("test-issuer"));
    var only_iss = agnosai_auth_config_with_jwt(jo);
    assert(_t_jwt_check(only_iss, _t_jwt_no_aud()) == HTTP_OK,
    "absent aud is fine when only an issuer is configured");
    assert(_t_jwt_check(only_iss, _t_jwt_no_iss()) == HTTP_UNAUTHORIZED,
    "absent iss still rejected when an issuer is configured");
    assert(_t_jwt_check(only_iss, _t_jwt_wrong_audience()) == HTTP_OK,
    "wrong aud is fine when no audience is configured");
    return 0;
}

# --- Decision 3: array aud, inherited ------------------------------------

fn _t_jwt_array_aud_rejected(): i64 {
    var c = _t_jwt_cfg();
    assert(_t_jwt_check(c, _t_jwt_aud_array()) == HTTP_UNAUTHORIZED,
    "a multi-element array aud is rejected");
    # The surprising half, and the one an Auth0 or Cognito token trips: a
    # single-element array naming exactly the configured audience is rejected
    # too. Inherited from the oracle, where Claims.aud is Option<String> and
    # deserialization fails before validation runs.
    assert(_t_jwt_check(c, _t_jwt_aud_array_single()) == HTTP_UNAUTHORIZED,
    "a single-element array aud is rejected too");
    return 0;
}

# --- exp: required, and Decision 4's 60-second leeway --------------------

fn _t_jwt_exp_required(): i64 {
    var c = _t_jwt_cfg();
    assert(_t_jwt_check(c, _t_jwt_no_exp()) == HTTP_UNAUTHORIZED,
    "a token with no exp is rejected");
    return 0;
}

# jsonwebtoken rejects when `exp < now - leeway`, so it accepts while
# `exp >= now - leeway`. With leeway 60 and the vector's exp fixed, the boundary
# is exactly `now = exp + 60`.
#
# This is the test that could not exist without an injectable `now`: a frozen
# token vector plus the wall clock can only ever probe one side.
fn _t_jwt_leeway_boundary(): i64 {
    var c = _t_jwt_cfg();
    var e = AGNOSAI_T_LEEWAY_EXP;
    assert(_t_jwt_at(c, _t_jwt_leeway(), e) == HTTP_OK, "still valid exactly at exp");
    assert(_t_jwt_at(c, _t_jwt_leeway(), e + 30) == HTTP_OK,
    "30s past exp is inside the 60s leeway");
    assert(_t_jwt_at(c, _t_jwt_leeway(), e + 60) == HTTP_OK,
    "exactly 60s past exp is still accepted");
    assert(_t_jwt_at(c, _t_jwt_leeway(), e + 61) == HTTP_UNAUTHORIZED,
    "61s past exp is rejected — the boundary");
    assert(_t_jwt_at(c, _t_jwt_leeway(), e + 90) == HTTP_UNAUTHORIZED,
    "90s past exp is rejected");
    # Without the leeway this would be the whole story; with it, a token is
    # live for a full minute after it nominally expires.
    assert(_t_jwt_at(c, _t_jwt_leeway(), e - 1000) == HTTP_OK, "well before exp");
    return 0;
}

# --- Algorithm confusion -------------------------------------------------

# The bypass class the oracle gets free from `Validation::new(Algorithm::RS256)`
# and that this port has to enforce itself. None of these has an oracle test.
fn _t_jwt_algorithm_confusion(): i64 {
    var c = _t_jwt_cfg();
    assert(_t_jwt_check(c, _t_jwt_alg_none()) == HTTP_UNAUTHORIZED,
    "alg:none with an empty signature is rejected");
    # The reason `alg` must be read as a parsed JSON field and never scanned
    # for as a substring: this header contains the text "RS256" in its kid.
    assert(_t_jwt_check(c, _t_jwt_alg_none_kid_rs256()) == HTTP_UNAUTHORIZED,
    "alg:none with kid RS256-2024 is rejected — no substring scan");
    # The three below are the ones that ISOLATE the alg check: each is
    # genuinely RS256-signed, so the signature verifies and nothing but the alg
    # check can reject them. The two `alg:none` vectors above do not isolate it
    # — their signature segment is empty, so the structural check catches them
    # first. Verified by mutation: deleting the alg check fails exactly these
    # three and none of the others.
    assert(_t_jwt_check(c, _t_jwt_alg_hs256()) == HTTP_UNAUTHORIZED,
    "a header claiming HS256 is rejected even though the body is RS256-signed");
    assert(_t_jwt_check(c, _t_jwt_alg_missing()) == HTTP_UNAUTHORIZED,
    "a header with no alg member is rejected though its signature verifies");
    assert(_t_jwt_check(c, _t_jwt_alg_not_string()) == HTTP_UNAUTHORIZED,
    "alg as a JSON number is rejected — the check reads a typed field");
    return 0;
}

# --- Signature integrity --------------------------------------------------

fn _t_jwt_tampering(): i64 {
    var c = _t_jwt_cfg();
    assert(_t_jwt_check(c, _t_jwt_tampered_sig()) == HTTP_UNAUTHORIZED,
    "a flipped signature byte is rejected");
    assert(_t_jwt_check(c, _t_jwt_tampered_payload()) == HTTP_UNAUTHORIZED,
    "a payload swapped under a valid signature is rejected");

    # The same valid token against a DIFFERENT key must fail. This is what
    # proves the signature is actually checked rather than merely parsed.
    var pem = str_builder_new();
    str_builder_add_cstr(pem, "-----BEGIN PUBLIC KEY-----\n");
    str_builder_add_cstr(pem, "MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAu1SU1LfVLPHCozMxH2Mo\n");
    str_builder_add_cstr(pem, "4lgOEePzNm0tRgeLezV6ffAt0gunVTLw7onLRnrq0/IzW7yWR7QkrmBL7jTKEn5u\n");
    str_builder_add_cstr(pem, "+qKhbwKfBstIs+bMY2Zkp18gnTxKLxoS2tFczGkPLPgizskuemMghRniWaoLcyeh\n");
    str_builder_add_cstr(pem, "kd3qqGElvW/VDL5AaWTg0nLVkjRo9z+40RQzuVaE8AkAFmxZzow3x+VJYKdjykkJ\n");
    str_builder_add_cstr(pem, "0iT9wCS0DRTXu269V264Vf/3jvredZiKRkgwlL9xNAwxXFg0x/XFw005UWVRIkdg\n");
    str_builder_add_cstr(pem, "cKWTjpBP2dPwVZ4WWC+9aGVd+Gyn1o0CLelf4rEjGoXbAAEgAqeGUxrcIlbjXfbc\n");
    str_builder_add_cstr(pem, "mwIDAQAB\n");
    str_builder_add_cstr(pem, "-----END PUBLIC KEY-----\n");
    var other = agnosai_jwt_config_new(str_builder_build(pem));
    var cwrong = agnosai_auth_config_with_jwt(other);
    assert(agnosai_jwt_config_prepare(other) == 1, "the other key parses");
    assert(_t_jwt_check(cwrong, _t_jwt_valid()) == HTTP_UNAUTHORIZED,
    "a valid token is rejected under a different key");
    return 0;
}

# --- Structure and base64url ---------------------------------------------

fn _t_jwt_structure(): i64 {
    var c = _t_jwt_cfg();
    assert(_t_jwt_check(c, _t_jwt_two_segments()) == HTTP_UNAUTHORIZED,
    "two segments rejected");
    assert(_t_jwt_check(c, _t_jwt_four_segments()) == HTTP_UNAUTHORIZED,
    "four segments rejected");
    assert(_t_jwt_check(c, _t_jwt_empty_payload()) == HTTP_UNAUTHORIZED,
    "empty payload segment rejected");
    assert(_t_jwt_check(c, str_from("..")) == HTTP_UNAUTHORIZED, "bare dots rejected");
    assert(_t_jwt_check(c, str_from("a.b.c")) == HTTP_UNAUTHORIZED,
    "short non-base64 segments rejected");
    return 0;
}

# bayan's decoder is lax in exactly these two ways, which is why this module
# carries its own: it strips trailing `=`, and it silently drops the stray
# character of a segment whose length is 1 mod 4.
fn _t_jwt_base64url_strictness(): i64 {
    var c = _t_jwt_cfg();
    assert(_t_jwt_check(c, _t_jwt_bad_b64_len()) == HTTP_UNAUTHORIZED,
    "a segment of length 1 mod 4 is rejected, not silently truncated");
    assert(_t_jwt_check(c, _t_jwt_padded_segment()) == HTTP_UNAUTHORIZED,
    "'=' is rejected — jsonwebtoken decodes URL_SAFE_NO_PAD");

    # And the decoder itself, directly.
    var out[64];
    assert(_agnosai_auth_b64u_decode(str_data(str_from("QQ")), 2, &out, 64) == 1,
    "2-char tail decodes to 1 byte");
    assert(load8(&out) == 65, "...and that byte is 'A'");
    assert(_agnosai_auth_b64u_decode(str_data(str_from("QUJD")), 4, &out, 64) == 3,
    "a full quad decodes to 3 bytes");
    assert(_agnosai_auth_b64u_decode(str_data(str_from("Q")), 1, &out, 64) == 0 - 1,
    "a 1-char tail is refused");
    assert(_agnosai_auth_b64u_decode(str_data(str_from("QQ==")), 4, &out, 64) == 0 - 1,
    "padding is refused");
    assert(_agnosai_auth_b64u_decode(str_data(str_from("QQ+/")), 4, &out, 64) == 0 - 1,
    "standard-base64 '+' and '/' are refused");
    assert(_agnosai_auth_b64u_decode(str_data(str_from("QR")), 2, &out, 64) == 0 - 1,
    "non-zero discarded trailing bits are refused");
    assert(_agnosai_auth_b64u_decode(str_data(str_from("QUJD")), 4, &out, 2) == 0 - 1,
    "a decode that would overrun the caller's buffer is refused");
    assert(_agnosai_auth_b64u_decode(str_data(str_from("-_-_")), 4, &out, 64) == 3,
    "'-' and '_' are the base64url alphabet");
    return 0;
}

# The disabled short-circuit and the header arms apply identically in JWT mode.
fn _t_jwt_mode_shares_the_header_path(): i64 {
    var c = _t_jwt_cfg();
    assert(agnosai_auth_check_at(c, 0, str_from(""), 1700000000) == HTTP_UNAUTHORIZED,
    "missing header is a 401 in jwt mode");
    assert(agnosai_auth_check_at(c, 1, str_from("Bearer "), 1700000000) == HTTP_UNAUTHORIZED,
    "empty bearer is a 401 in jwt mode");
    assert(agnosai_auth_check_at(c, 1, str_from("Basic xyz"), 1700000000) == HTTP_UNAUTHORIZED,
    "wrong scheme is a 401 in jwt mode");
    agnosai_auth_config_set_enabled(c, 0);
    assert(agnosai_auth_check_at(c, 1, _t_bearer(_t_jwt_garbage()), 1700000000) == HTTP_OK,
    "disabled short-circuits ahead of the jwt path");
    return 0;
}

# --- Regressions from the adversarial review (2026-07-30) ----------------
#
# Each of the five below was a real defect in the first cut of the JWT half,
# found by an adversarial review pass and confirmed by execution. They are
# grouped so it stays obvious that these are guards against known-real
# regressions, not speculative hardening.

# `exp` comes out of bayan's `_jp_atoi`, which computes `n = n * 10 + digit` in
# wrapping i64 with no overflow detection and still tags the result JTAG_INT —
# so `bayan_json_v_is_int` does not catch it. Both directions were wrong.
fn _t_jwt_exp_range_guard(): i64 {
    var c = _t_jwt_cfg();
    # FAIL-OPEN, and the one that mattered: 2e19 wrapped to 1553255926290448384
    # — a year-51-billion timestamp — and the token was ACCEPTED. The oracle
    # 401s, because the literal exceeds u64::MAX and `Option<u64>` fails to
    # deserialize before validation runs.
    assert(_t_jwt_check(c, _t_jwt_exp_overflow()) == HTTP_UNAUTHORIZED,
    "an exp above u64::MAX is rejected, not wrapped into the far future");
    # FAIL-CLOSED mirror: u64::MAX fits u64 (the oracle accepts) but wraps
    # negative in i64. Rejected here, deliberately — see Decision 2.
    assert(_t_jwt_check(c, _t_jwt_exp_u64_max()) == HTTP_UNAUTHORIZED,
    "exp = u64::MAX is rejected rather than read as a negative timestamp");
    # The control: the sentinel Decision 2 chose is still accepted.
    assert(_t_jwt_check(c, _t_jwt_valid()) == HTTP_OK,
    "the year-9999 sentinel is still inside the bound");
    return 0;
}

# The oracle deserializes the whole payload into a typed `Claims` before
# validating, so any type mismatch is a 401. The port reads the payload
# untyped, so without an explicit type pass it ACCEPTED all of these.
fn _t_jwt_claim_types(): i64 {
    var c = _t_jwt_cfg();
    assert(_t_jwt_check(c, _t_jwt_sub_number()) == HTTP_UNAUTHORIZED,
    "sub as a number is rejected");
    assert(_t_jwt_check(c, _t_jwt_iat_negative()) == HTTP_UNAUTHORIZED,
    "a negative iat against Option<u64> is rejected");
    # `scope` is never read by this module, so only the type pass catches it.
    assert(_t_jwt_check(c, _t_jwt_scope_number()) == HTTP_UNAUTHORIZED,
    "scope as a number is rejected even though nothing reads scope");
    # And with NO issuer configured, so the conditional iss comparison is
    # skipped entirely and the type pass is the only thing left.
    var bare = agnosai_auth_config_with_jwt(agnosai_jwt_config_new(_t_jwt_pubkey_pem()));
    assert(_t_jwt_check(bare, _t_jwt_iss_number()) == HTTP_UNAUTHORIZED,
    "iss as a number is rejected even when no issuer is configured");
    return 0;
}

# sigil enforces no minimum modulus — it checks only that the signature width
# matches, that the modulus fits 512 bytes, and that it is odd. The oracle
# verifies through ring's `RSA_PKCS1_2048_8192_SHA256`, which refuses anything
# under 2048 bits. Without an explicit floor a 512-bit key was accepted here
# and its tokens verified.
fn _t_jwt_weak_key_refused(): i64 {
    var weak = agnosai_jwt_config_new(_t_jwt_weak_pubkey_pem());
    assert(agnosai_jwt_config_prepare(weak) == 0,
    "a 512-bit key is refused at prepare");
    var c = agnosai_auth_config_with_jwt(weak);
    # And a token genuinely signed with it does not authenticate. 500, not 401:
    # the key is the server's problem, not the request's.
    assert(_t_jwt_check(c, _t_jwt_weak_key_token()) == HTTP_INTERNAL,
    "a token signed with a 512-bit key does not authenticate");
    assert(_t_jwt_check(c, _t_jwt_weak_key_token()) != HTTP_OK,
    "...and above all is never a 200");
    return 0;
}

# `prepare` memoized success but not failure, so a PEM that base64-decoded and
# then failed RSA parsing was re-decoded on every request — re-leaking 536
# bytes of never-freed global bump each time, from a request that returns 500
# and carries no credential. One mistyped env var was an unauthenticated
# memory-exhaustion channel.
fn _t_jwt_bad_key_failure_is_memoized(): i64 {
    var j = agnosai_jwt_config_new(_t_jwt_weak_pubkey_pem());
    assert(agnosai_jwt_config_prepare(j) == 0, "first prepare fails");
    var c = agnosai_auth_config_with_jwt(j);
    var header = _t_bearer(_t_jwt_valid());
    _t_jwt_check(c, _t_jwt_valid());

    var before = alloc_used();
    for (var i = 0; i < 64; i = i + 1) {
        agnosai_auth_check_at(c, 1, header, 1700000000);
    }
    var per = (alloc_used() - before) / 64;
    assert(per < 256, "a broken key is decided once, not re-parsed per request");
    return 0;
}

# `clock_epoch_secs()` is documented to return 0 when the RTC is unreadable —
# "unknown", not 1970. Fed straight through, the expiry test became
# `exp < -60`, false for every non-negative exp, and expiry enforcement
# silently switched off. `agnosai_auth_check` now refuses instead.
fn _t_jwt_zero_clock_does_not_disable_expiry(): i64 {
    var c = _t_jwt_cfg();
    # The behaviour that would have been wrong, driven explicitly through the
    # injectable seam: at now = 0 an expired token would sail through.
    assert(_t_jwt_at(c, _t_jwt_expired(), 0) == HTTP_OK,
    "at now=0 the raw check accepts an expired token — which is why 0 must never reach it");
    # The guard itself, driven with the sentinel. This host's clock works, so
    # without an injectable layer this branch would be unreachable from the
    # suite — and it was: deleting the guard failed no test until
    # `agnosai_auth_check_clocked` was split out.
    assert(agnosai_auth_check_clocked(c, 1, _t_bearer(_t_jwt_valid()), 0) == HTTP_INTERNAL,
    "a clock reading of 0 refuses the request rather than skipping expiry");
    assert(agnosai_auth_check_clocked(c, 1, _t_bearer(_t_jwt_expired()), 0) != HTTP_OK,
    "...and above all never passes an expired token");
    assert(agnosai_auth_check_clocked(c, 1, _t_bearer(_t_jwt_valid()), 0 - 5) == HTTP_INTERNAL,
    "a negative clock reading is refused too");
    assert(agnosai_auth_check_clocked(c, 1, _t_bearer(_t_jwt_valid()), 1700000000) == HTTP_OK,
    "a sane reading passes through");

    # And the wall-clock entry point, which is what a handler calls.
    assert(clock_epoch_secs() > 0, "this host's clock reads a sane epoch");
    assert(agnosai_auth_check(c, 1, _t_bearer(_t_jwt_expired())) == HTTP_UNAUTHORIZED,
    "the wall-clock path rejects the expired token");
    return 0;
}

# **The pre-auth allocation bound — a security regression test, not hygiene.**
#
# `bayan_json_v_parse_buf` builds its value tree on the no-free global bump, so
# any JSON parsed before the signature is verified is a permanent heap write an
# unauthenticated caller controls. An earlier revision of this module parsed the
# header first and leaked **62,248 bytes per rejected request** against a
# 1,164-byte header — ~53x amplification, on a path returning 401. A slow
# attacker with no credential eventually OOMs the process, and nothing reclaims
# it.
#
# The fix was to verify the signature before parsing anything. This pins it: a
# rejected token must cost a small CONSTANT, independent of how much JSON the
# attacker packs into the header. If someone reorders the header parse back
# ahead of the verify, this fails loudly rather than silently reintroducing the
# amplification.
fn _t_jwt_preauth_allocation_is_bounded(): i64 {
    var c = _t_jwt_cfg();
    agnosai_jwt_config_prepare(agnosai_auth_config_jwt(c));

    # A header segment stuffed with filler, so a pre-verify JSON parse would
    # allocate proportionally to it.
    var hdr = str_builder_new();
    str_builder_add_cstr(hdr, "{\"alg\":\"RS256\",\"typ\":\"JWT\"");
    for (var k = 0; k < 120; k = k + 1) {
        str_builder_add_cstr(hdr, ",\"k");
        str_builder_add_int(hdr, k);
        str_builder_add_cstr(hdr, "\":\"vvvvvvvv\"");
    }
    str_builder_add_cstr(hdr, "}");
    var big = _t_b64u(str_builder_build(hdr));

    var tok = str_builder_new();
    str_builder_add_str(tok, big);
    str_builder_add_cstr(tok, ".eyJhIjoxfQ.QUJD");
    var header = _t_bearer(str_builder_build(tok));

    # Warm every one-time path (key prep, sigil tables) before measuring.
    assert(agnosai_auth_check_at(c, 1, header, 1700000000) == HTTP_UNAUTHORIZED,
    "the oversized-header token is rejected");

    var before = alloc_used();
    for (var i = 0; i < 64; i = i + 1) {
        agnosai_auth_check_at(c, 1, header, 1700000000);
    }
    var per = (alloc_used() - before) / 64;

    # The header alone is ~1.5 KB on the wire. Anything proportional to it means
    # the JSON tree is being built before the signature check again.
    assert(per < 256, "a rejected token costs a small constant, not O(header)");
    return 0;
}

# `agnosai_auth_check` is `agnosai_auth_check_at` with the wall clock. The
# far-future vector is valid at any plausible reading of it.
fn _t_jwt_wallclock_wrapper(): i64 {
    var c = _t_jwt_cfg();
    assert(agnosai_auth_check(c, 1, _t_bearer(_t_jwt_valid())) == HTTP_OK,
    "the wall-clock wrapper accepts the far-future vector");
    assert(agnosai_auth_check(c, 1, _t_bearer(_t_jwt_expired())) == HTTP_UNAUTHORIZED,
    "the wall-clock wrapper rejects the expired vector");
    assert(clock_epoch_secs() < AGNOSAI_T_FAR_FUTURE,
    "the far-future exp really is in the future");
    return 0;
}

fn main(): i64 {
    alloc_init();
    sakshi_set_level(SK_FATAL);

    _t_passes_when_disabled();
    _t_rejects_missing_token();
    _t_rejects_wrong_token();
    _t_passes_with_correct_token();
    _t_rejects_empty_bearer();
    _t_bearer_extraction();
    _t_bearer_is_case_sensitive();
    _t_to_str_gate();
    _t_secret_compare();
    _t_secret_length_extremes();
    _t_config_surface();
    _t_jwt_config_builders();

    _t_jwt_key_prepare();
    _t_jwt_bad_key_is_500();
    _t_jwt_oracle_cases();
    _t_jwt_absent_iss_aud_rejected();
    _t_jwt_tightening_is_conditional();
    _t_jwt_array_aud_rejected();
    _t_jwt_exp_required();
    _t_jwt_leeway_boundary();
    _t_jwt_algorithm_confusion();
    _t_jwt_tampering();
    _t_jwt_structure();
    _t_jwt_base64url_strictness();
    _t_jwt_mode_shares_the_header_path();
    _t_jwt_exp_range_guard();
    _t_jwt_claim_types();
    _t_jwt_weak_key_refused();
    _t_jwt_bad_key_failure_is_memoized();
    _t_jwt_zero_clock_does_not_disable_expiry();
    _t_jwt_preauth_allocation_is_bounded();
    _t_jwt_wallclock_wrapper();

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
