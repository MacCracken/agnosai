# =========================================================================
# sandbox_process — tests for src/sandbox/process.cyr.
#
# All nine oracle tests (`rust-old/src/sandbox/process.rs:250-366`) are ported:
# echo_command, stdin_passthrough, nonzero_exit, stderr_captured,
# timeout_kills_process, clean_env, invalid_executable,
# execute_argv_no_shell_interpretation, execute_argv_empty_returns_error.
#
# What is asserted beyond them is the environment composition, which the oracle
# tests only through `clean_env` — one case out of an ordering that decides
# whether a sanitized variable can reach a sandboxed child.
# =========================================================================

include "src/units.cyr"
include "src/order.cyr"
include "src/id.cyr"
include "src/core/mod.cyr"
include "src/sandbox/mod.cyr"
include "tests/test_helpers.cyr"

# A shell sandbox with a generous deadline, as every oracle test builds.
fn _t_pr_shell(): i64 {
    return agnosai_process_config_shell(5000);
}

# --- The nine oracle tests -----------------------------------------------

fn _t_pr_echo_command(): i64 {
    var e[8];
    store64(&e, 0);
    var r = agnosai_process_execute(_t_pr_shell(), str_from("echo hello"), str_from(""), &e);
    assert(load64(&e) == 0, "a shell command succeeds");
    assert(str_contains_cstr(agnosai_process_result_stdout(r), "hello") == 1,
    "oracle echo_command: stdout carries the output");
    assert(agnosai_process_result_exit_code(r) == 0, "...and the exit code is 0");
    assert(agnosai_process_result_timed_out(r) == 0, "...and it did not time out");
    return 0;
}

fn _t_pr_stdin_passthrough(): i64 {
    var e[8];
    store64(&e, 0);
    var r = agnosai_process_execute(_t_pr_shell(), str_from("cat"), str_from("piped input"), &e);
    assert(load64(&e) == 0, "cat runs");
    assert(str_contains_cstr(agnosai_process_result_stdout(r), "piped input") == 1,
    "oracle stdin_passthrough: input reaches the child and comes back out");
    return 0;
}

fn _t_pr_nonzero_exit(): i64 {
    var e[8];
    store64(&e, 0);
    var r = agnosai_process_execute(_t_pr_shell(), str_from("exit 42"), str_from(""), &e);
    assert(load64(&e) == 0, "a non-zero exit is a RESULT, not an error");
    assert(agnosai_process_result_exit_code(r) == 42,
    "oracle nonzero_exit: the exit code is reported");
    return 0;
}

fn _t_pr_stderr_captured(): i64 {
    var e[8];
    store64(&e, 0);
    var r = agnosai_process_execute(_t_pr_shell(), str_from("echo oops >&2"), str_from(""), &e);
    assert(str_contains_cstr(agnosai_process_result_stderr(r), "oops") == 1,
    "oracle stderr_captured: stderr is captured");
    assert(str_contains_cstr(agnosai_process_result_stdout(r), "oops") == 0,
    "...on its own stream, not merged into stdout");
    return 0;
}

fn _t_pr_timeout_kills_process(): i64 {
    var e[8];
    store64(&e, 0);
    var t0 = clock_now_ms();
    var r = agnosai_process_execute(agnosai_process_config_shell(1000), str_from("sleep 60"),
    str_from(""), &e);
    var dt = clock_now_ms() - t0;

    assert(load64(&e) == 0, "oracle timeout_kills_process: 'should succeed even on timeout'");
    assert(agnosai_process_result_timed_out(r) == 1, "...timed_out is set");
    assert(agnosai_process_result_exit_code(r) == 0 - 1, "...and the exit code is -1");
    assert(dt < 10000, "...and it returned instead of waiting out the sleep");
    return 0;
}

fn _t_pr_clean_env(): i64 {
    var c = agnosai_process_config_shell(5000);
    agnosai_process_config_set_env(c, str_from("SANDBOX_VAR"), str_from("yes"));
    agnosai_process_config_set_clean_env(c, 1);

    var e[8];
    store64(&e, 0);
    var r = agnosai_process_execute(c, str_from("echo $SANDBOX_VAR"), str_from(""), &e);
    assert(load64(&e) == 0, "a clean-env sandbox runs");
    assert(str_contains_cstr(agnosai_process_result_stdout(r), "yes") == 1,
    "oracle clean_env: a configured variable reaches the child");
    return 0;
}

fn _t_pr_invalid_executable(): i64 {
    var c = agnosai_process_config_shell(5000);
    agnosai_process_config_set_executable(c, str_from("/nonexistent/binary"));
    agnosai_process_config_set_args(c, vec_new());

    var e[8];
    store64(&e, 0);
    var r = agnosai_process_execute(c, str_from("whatever"), str_from(""), &e);
    assert(r == 0, "oracle invalid_executable: a missing executable is an ERROR, not a result");
    assert(load64(&e) != 0, "...and the error is set");
    assert(agnosai_error_kind(load64(&e)) == AGNOSAI_ERR_SANDBOX, "...as a sandbox error");
    return 0;
}

fn _t_pr_execute_argv_no_shell_interpretation(): i64 {
    # The oracle's exact case: `echo` with a metacharacter-laden argument must
    # emit it LITERALLY, because no shell ever sees it.
    var argv = vec_new();
    vec_push(argv, str_from("/bin/echo"));
    vec_push(argv, str_from("hello; rm -rf /tmp/should-not-happen"));

    var e[8];
    store64(&e, 0);
    var r = agnosai_process_execute_argv(_t_pr_shell(), argv, str_from(""), &e);
    assert(load64(&e) == 0, "argv mode runs");
    assert(str_contains_cstr(agnosai_process_result_stdout(r), "; rm -rf") == 1,
    "oracle execute_argv_no_shell_interpretation: the metacharacters are ECHOED, not run");
    return 0;
}

fn _t_pr_execute_argv_empty_returns_error(): i64 {
    var e[8];
    store64(&e, 0);
    var r = agnosai_process_execute_argv(_t_pr_shell(), vec_new(), str_from(""), &e);
    assert(r == 0, "oracle execute_argv_empty_returns_error: an empty argv is an error");
    assert(load64(&e) != 0, "...with an error object");
    assert(str_contains_cstr(agnosai_error_message(load64(&e)), "empty argv") == 1,
    "...saying so");
    return 0;
}

# --- argv mode ignores config.executable and config.args -----------------

fn _t_pr_argv_ignores_config_command(): i64 {
    # `Command::new(argv[0])` — the oracle builds argv mode from argv ALONE
    # (process.rs:100-104). A version that prepended config.args would turn a
    # deliberate bypass-the-shell call back into `sh -c`, silently restoring
    # every metacharacter the caller chose argv mode to avoid.
    var c = agnosai_process_config_shell(5000);
    agnosai_process_config_set_executable(c, str_from("/nonexistent/should-not-be-used"));

    var argv = vec_new();
    vec_push(argv, str_from("/bin/echo"));
    vec_push(argv, str_from("direct"));

    var e[8];
    store64(&e, 0);
    var r = agnosai_process_execute_argv(c, argv, str_from(""), &e);
    assert(load64(&e) == 0,
    "argv mode runs argv[0], NOT config.executable - which here does not exist");
    assert(str_contains_cstr(agnosai_process_result_stdout(r), "direct") == 1, "...and it ran");
    assert(str_contains_cstr(agnosai_process_result_stdout(r), "-c") == 0,
    "...with no config.args prepended");
    return 0;
}

# --- Environment composition ---------------------------------------------

fn _t_pr_env_sanitizes_the_inherited_environment(): i64 {
    # **This cannot assert "LD_PRELOAD was stripped" by running a child.** The
    # test process has no way to put one in its OWN environment - there is no
    # `setenv` - so `echo [$LD_PRELOAD]` prints `[]` whether the filter runs or
    # not, and passes against a build with no sanitization at all. The filter
    # itself is proven in sandbox_spawn against a constructed environment; what
    # is checkable here is that `process` composes it in.
    var envp = _agnosai_process_envp(agnosai_process_config_default());

    var i = 0;
    var n = 0;
    while (load64(envp + i * 8) != 0) {
        assert(agnosai_env_entry_is_sanitized(load64(envp + i * 8)) == 0,
        "no entry the child inherits is one the filter removes");
        n = n + 1;
        i = i + 1;
    }
    assert(n > 0, "...over a base that was actually populated, not an empty array");
    assert(agnosai_envp_has(envp, str_from("PATH")) == 1,
    "...and an ordinary variable survived, so this is a filter and not a wipe");

    return 0;
}

fn _t_pr_env_entries_are_nul_terminated(): i64 {
    # **An inherited entry proves nothing here.** It points into `environ`, so
    # it is already NUL-terminated whether or not the builder terminates it. A
    # CONFIGURED entry is built by `str_cat`, and a `Str`'s bytes are followed
    # by whatever the arena allocated next - handing `execve` that pointer gives
    # the child a value with garbage stapled to the end.
    var c = agnosai_process_config_shell(5000);
    agnosai_process_config_set_env(c, str_from("AGNOSAI_PROBE"), str_from("yes"));

    var e[8];
    store64(&e, 0);
    var r = agnosai_process_execute(c, str_from("echo [$AGNOSAI_PROBE]"), str_from(""), &e);
    assert(load64(&e) == 0, "the child runs");
    assert(str_contains_cstr(agnosai_process_result_stdout(r), "[yes]") == 1,
    "a configured value arrives EXACTLY - bracketed, so a run-on value fails");
    return 0;
}

fn _t_pr_env_overrides_inherited(): i64 {
    # `cmd.env(k, v)` REPLACES rather than appending a duplicate. PATH exists in
    # any real environment, so overriding it proves replacement rather than
    # "the child picked the first of two".
    var c = agnosai_process_config_shell(5000);
    agnosai_process_config_set_env(c, str_from("PATH"), str_from("/sandbox-only"));

    var e[8];
    store64(&e, 0);
    var r = agnosai_process_execute(c, str_from("echo $PATH"), str_from(""), &e);
    assert(str_contains_cstr(agnosai_process_result_stdout(r), "/sandbox-only") == 1,
    "a configured variable overrides the inherited one");
    assert(str_contains_cstr(agnosai_process_result_stdout(r), "/usr/bin") == 0,
    "...replacing it rather than leaving both for the child to choose between");
    return 0;
}

fn _t_pr_env_without_clean_keeps_the_rest(): i64 {
    var c = agnosai_process_config_shell(5000);
    agnosai_process_config_set_env(c, str_from("SANDBOX_VAR"), str_from("yes"));

    var e[8];
    store64(&e, 0);
    var r = agnosai_process_execute(c, str_from("echo $SANDBOX_VAR:$PATH"), str_from(""), &e);
    assert(str_contains_cstr(agnosai_process_result_stdout(r), "yes:") == 1,
    "the configured variable is set");
    assert(str_contains_cstr(agnosai_process_result_stdout(r), "yes:/") == 1,
    "...and WITHOUT clean_env the inherited PATH is still there");
    return 0;
}

fn _t_pr_clean_env_drops_the_inherited_ones(): i64 {
    # **Not `echo $PATH`.** A POSIX shell assigns itself a default PATH when it
    # does not inherit one, so that check passes against a shell with no
    # environment at all - it tests `sh`, not `clean_env`. Counting what the
    # child can actually see does test it.
    var probe = str_from("n=$(env | wc -l); if [ \"$n\" -gt 8 ]; then echo MANY; else echo FEW; fi");

    var e[8];
    store64(&e, 0);
    var full = agnosai_process_execute(agnosai_process_config_shell(5000), probe, str_from(""), &e);
    assert(str_contains_cstr(agnosai_process_result_stdout(full), "MANY") == 1,
    "the parent HAS a real environment - otherwise the comparison below means nothing");

    var c = agnosai_process_config_shell(5000);
    agnosai_process_config_set_clean_env(c, 1);
    store64(&e, 0);
    var clean = agnosai_process_execute(c, probe, str_from(""), &e);
    assert(str_contains_cstr(agnosai_process_result_stdout(clean), "FEW") == 1,
    "clean_env leaves the child only what the shell invents for itself");
    return 0;
}

fn _t_pr_set_env_replaces_by_name(): i64 {
    var c = agnosai_process_config_default();
    agnosai_process_config_set_env(c, str_from("A"), str_from("1"));
    agnosai_process_config_set_env(c, str_from("B"), str_from("2"));
    agnosai_process_config_set_env(c, str_from("A"), str_from("3"));
    assert(vec_len(agnosai_process_config_env(c)) == 2,
    "setting a name twice replaces it - two entries, not three");
    assert(str_eq(vec_get(agnosai_process_config_env(c), 0), str_from("A=3")) == 1,
    "...and the LAST value is the one kept, as cmd.env does");
    return 0;
}

# --- Config -------------------------------------------------------------

fn _t_pr_config_defaults(): i64 {
    var c = agnosai_process_config_default();
    assert(str_eq(agnosai_process_config_executable(c), str_from("/bin/sh")) == 1,
    "the default executable is /bin/sh");
    assert(vec_len(agnosai_process_config_args(c)) == 1, "with one static argument");
    assert(str_eq(vec_get(agnosai_process_config_args(c), 0), str_from("-c")) == 1, "...which is -c");
    assert(agnosai_process_config_work_dir(c) == 0, "no work_dir - the parent's is inherited");
    assert(agnosai_process_config_timeout_ms(c) == 30000, "a 30-second deadline");
    assert(vec_len(agnosai_process_config_env(c)) == 0, "no configured variables");
    assert(agnosai_process_config_clean_env(c) == 0, "and the environment is inherited");

    var s = agnosai_process_config_shell(1234);
    assert(agnosai_process_config_timeout_ms(s) == 1234, "shell() sets the deadline");
    assert(str_eq(agnosai_process_config_executable(s), str_from("/bin/sh")) == 1,
    "...and changes nothing else");

    # Two configs must not share one env vec — the default builds a fresh one.
    var a = agnosai_process_config_default();
    var b = agnosai_process_config_default();
    agnosai_process_config_set_env(a, str_from("X"), str_from("1"));
    assert(vec_len(agnosai_process_config_env(b)) == 0,
    "one config's env does not leak into another's");
    return 0;
}

fn _t_pr_result_new_and_timeout_setter(): i64 {
    # `agnosai_process_result_new` is the constructor every path returns
    # through; built directly, its accessors must read back what went in.
    var r = agnosai_process_result_new(str_from("out"), str_from("err"), 7, 0);
    assert(str_eq(agnosai_process_result_stdout(r), str_from("out")) == 1, "stdout round-trips");
    assert(str_eq(agnosai_process_result_stderr(r), str_from("err")) == 1, "stderr round-trips");
    assert(agnosai_process_result_exit_code(r) == 7, "the exit code round-trips");
    assert(agnosai_process_result_timed_out(r) == 0, "and so does timed_out");

    # The fields are distinct slots, not aliases of one another.
    var t = agnosai_process_result_new(str_from("a"), str_from("b"), 0 - 1, 1);
    assert(agnosai_process_result_timed_out(t) == 1, "a timed-out result reports it");
    assert(agnosai_process_result_exit_code(t) == 0 - 1, "...alongside its own exit code");
    assert(str_eq(agnosai_process_result_stdout(t), str_from("a")) == 1,
    "...without the two string fields aliasing");

    # The deadline setter is the one the manager would use to override a
    # policy-derived timeout onto an existing config.
    var c = agnosai_process_config_default();
    agnosai_process_config_set_timeout_ms(c, 750);
    assert(agnosai_process_config_timeout_ms(c) == 750, "the deadline setter takes effect");

    var e[8];
    store64(&e, 0);
    var t0 = clock_now_ms();
    var slow = agnosai_process_execute(c, str_from("sleep 30"), str_from(""), &e);
    assert(agnosai_process_result_timed_out(slow) == 1,
    "...and the child is actually held to it, not to the 30s default");
    assert(clock_now_ms() - t0 < 10000, "...promptly");
    return 0;
}

fn _t_pr_work_dir(): i64 {
    var c = agnosai_process_config_shell(5000);
    agnosai_process_config_set_work_dir(c, str_from("/tmp"));

    var e[8];
    store64(&e, 0);
    var r = agnosai_process_execute(c, str_from("pwd"), str_from(""), &e);
    assert(load64(&e) == 0, "a work_dir sandbox runs");
    assert(str_contains_cstr(agnosai_process_result_stdout(r), "/tmp") == 1,
    "the child runs in the configured directory");

    agnosai_process_config_set_work_dir(c, str_from("/nonexistent/work/dir"));
    store64(&e, 0);
    var bad = agnosai_process_execute(c, str_from("pwd"), str_from(""), &e);
    assert(bad == 0, "a missing work_dir is an error, not a run somewhere else");
    assert(str_contains_cstr(agnosai_error_message(load64(&e)), "working directory") == 1,
    "...and the message says so, rather than blaming the executable");
    return 0;
}

# --- Timeout output ------------------------------------------------------

fn _t_pr_timeout_blanks_output(): i64 {
    # Parity, and the one place `process` deliberately throws information away:
    # the oracle's timeout arm returns String::new() for both streams
    # (process.rs:154-160) because cancelling wait_with_output discards them.
    # The spawn primitive HAS the partial output - this layer drops it.
    var e[8];
    store64(&e, 0);
    var r = agnosai_process_execute(agnosai_process_config_shell(500),
    str_from("echo early; sleep 60"), str_from(""), &e);

    assert(agnosai_process_result_timed_out(r) == 1, "the child timed out");
    assert(str_len(agnosai_process_result_stdout(r)) == 0,
    "stdout is EMPTY on timeout, matching ProcessResult - not the partial output");
    assert(str_len(agnosai_process_result_stderr(r)) == 0, "and so is stderr");
    return 0;
}

fn main(): i64 {
    alloc_init();
    sakshi_set_level(SK_FATAL);

    _t_pr_echo_command();
    _t_pr_stdin_passthrough();
    _t_pr_nonzero_exit();
    _t_pr_stderr_captured();
    _t_pr_timeout_kills_process();
    _t_pr_clean_env();
    _t_pr_invalid_executable();
    _t_pr_execute_argv_no_shell_interpretation();
    _t_pr_execute_argv_empty_returns_error();
    _t_pr_argv_ignores_config_command();
    _t_pr_env_sanitizes_the_inherited_environment();
    _t_pr_env_entries_are_nul_terminated();
    _t_pr_env_overrides_inherited();
    _t_pr_env_without_clean_keeps_the_rest();
    _t_pr_clean_env_drops_the_inherited_ones();
    _t_pr_set_env_replaces_by_name();
    _t_pr_config_defaults();
    _t_pr_result_new_and_timeout_setter();
    _t_pr_work_dir();
    _t_pr_timeout_blanks_output();

    return assert_summary();
}

var f = main();
if (f > 0) { f = 1; }
syscall(60, f);
