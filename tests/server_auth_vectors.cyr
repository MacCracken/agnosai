# A 512-bit RSA public key. The oracle verifies through ring's
# `RSA_PKCS1_2048_8192_SHA256`, which refuses any modulus under 2048 bits; sigil
# imposes no minimum at all, so without an explicit floor this key was accepted
# and its tokens verified — a straight security regression against the oracle.
fn _t_jwt_weak_pubkey_pem(): Str {
    return str_from("-----BEGIN PUBLIC KEY-----\nMFwwDQYJKoZIhvcNAQEBBQADSwAwSAJBALrral3bt2PMXkjH/Um5EA7DxeUQ/tWE\nprtNN0XDcbwstmtIxIBbxbHFh7JI/lVyXTKGNC0xIXlXUrTJMFIOm/UCAwEAAQ==\n-----END PUBLIC KEY-----\n");
}

# A structurally valid RS256 token signed with the 512-bit key above.
fn _t_jwt_weak_key_token(): Str {
    return str_from("eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJhdWQiOiJhZ25vc2FpIiwiZXhwIjoyNTM0MDIzMDA3OTksImlhdCI6MCwiaXNzIjoidGVzdC1pc3N1ZXIiLCJzdWIiOiJ1c2VyLTEyMyJ9.UWEIeBnfmENnKUlaetU7fSsPs59acb8VDxch8LX9IFc9-UA-m5DoplFp0q9v9v9QCE3nbl6Pwsrfeeey3y2JBg");
}
