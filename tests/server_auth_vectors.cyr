# Oracle `jwt_garbage_token_rejected` — asserts **401, not 500**, so it
# only passes if the PEM genuinely parsed.
fn _t_jwt_garbage(): Str {
    return str_from("not.a.jwt");
}

# Header and payload, no signature segment.
fn _t_jwt_two_segments(): Str {
