# Algorithm confusion: `alg:none`, **empty** signature segment. Note this
# is caught by the structural empty-signature check before `alg` is ever
# consulted — see `alg_missing` for a vector that isolates the alg check.
fn _t_jwt_alg_none(): Str {
    return str_from("eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJhdWQiOiJhZ25vc2FpIiwiZXhwIjoyNTM0MDIzMDA3OTksImlhdCI6MCwiaXNzIjoidGVzdC1pc3N1ZXIiLCJzdWIiOiJ1c2VyLTEyMyJ9.");
}

# `alg:none` with `kid:\"RS256-2024\"` — defeats any implementation that
# scans the header for the substring \"RS256\" instead of reading the parsed
# field. bote's HS256 verifier does exactly that substring scan; that shape must
# not be copied into a module exposing two auth paths on one endpoint.
fn _t_jwt_alg_none_kid_rs256(): Str {
    return str_from("eyJhbGciOiJub25lIiwia2lkIjoiUlMyNTYtMjAyNCJ9.eyJhdWQiOiJhZ25vc2FpIiwiZXhwIjoyNTM0MDIzMDA3OTksImlhdCI6MCwiaXNzIjoidGVzdC1pc3N1ZXIiLCJzdWIiOiJ1c2VyLTEyMyJ9.");
}

