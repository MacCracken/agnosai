# =========================================================================
# server_auth_vectors — frozen RS256 token vectors for tests/server_auth.tcyr.
#
# NOT a test file (`cyrius tests` only picks up .tcyr) and NOT part of the
# coverage corpus. Kept in a `.cyr` deliberately: the port plan caps total
# `.tcyr` bytes under tests/ at 1,048,575 before `cyrius coverage` silently
# under-reports, and ~16 KB of base64 does not belong in that budget.
#
# **Generated once, committed, never regenerated at test time.** Every token
# below was signed with `rust-old/tests/fixtures/test_rsa_private.pem` — the
# oracle's own 2048-bit test keypair — and the `valid` one was independently
# confirmed with `openssl dgst -sha256 -verify` against the public key before
# being baked in. agnosai therefore only ever VERIFIES: there is no RSA signing
# anywhere in the port, and no test depends on a private key. RSA PKCS#1 v1.5
# signing is deterministic, so regenerating reproduces these bytes exactly.
#
# Every symbol is `_t_`-prefixed so it can never shadow a src/ symbol and
# stays out of the coverage denominator.
# =========================================================================

# The oracle's public key, PEM-encoded (rust-old/tests/fixtures/test_rsa_public.pem).
fn _t_jwt_pubkey_pem(): Str {
    return str_from("-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA5Wu/jjUwgB2e1/Bn0jBo\nczAuTktZwACUz1PtlMmpuuOxKvfGjGbVOW+mQVzAn7BTCEdfNEDN19tHgYkMHjhn\nycj0oho63oGYtwmHUqka4pk+3Vk8Tif9Cnw2OTTx0ng4ntNwvl2FToLvq4RLyfpJ\no0D3M4g/wgjY5znUezqzJGq68f0BK/e5qldF0O842rK4bb+IkfPGJYoUL+LKqUEy\ne1doAJrUdOm/bQ+QeDV/26SyFGvLHx8CVfO2du79GvFGRrZKkWwLz3t5Z2r94RXG\n8lKMhsRSWu+BKEfzg1jnpF93E+4GrapNhQit5QkgQD4Eeazahbx18L6RinrQqCrw\nOQIDAQAB\n-----END PUBLIC KEY-----\n");
}

# Decision 2 (maintainer): the oracle's fixture uses `exp: u64::MAX`, which is
# 2*i64::MAX+1 and does not fit Cyrius's signed i64. This is
# 9999-12-31T23:59:59Z — the conventional JWT never-expires sentinel, ~27x
# below i64::MAX so no signed-boundary handling is in play.
var AGNOSAI_T_FAR_FUTURE = 253402300799;

# The `exp` carried by `_t_jwt_leeway()`. The suite drives `now` to base+30,
# +60, +61 and +90, which is the only way to test the 60s leeway boundary
# against a frozen vector.
var AGNOSAI_T_LEEWAY_EXP = 1000000000;

# The oracle's `valid_claims()`: sub=user-123, iss=test-issuer,
# aud=agnosai, exp=far-future, iat=0. Oracle test `jwt_valid_token_passes`.
fn _t_jwt_valid(): Str {
    return str_from("eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJhdWQiOiJhZ25vc2FpIiwiZXhwIjoyNTM0MDIzMDA3OTksImlhdCI6MCwiaXNzIjoidGVzdC1pc3N1ZXIiLCJzdWIiOiJ1c2VyLTEyMyJ9.O_d2RmELAJEGbJBAgHjmnPOtZa8omZyVMJOuVmi65kSQ3Q8pE-gUZEKoy43ADXrB6Gixgb3QLDFPXw29ZSjevTdrL_DyqnaIsDENM-PDPGGFADbEdlwG8Z8nfzGckTFWI4rNrcVtdTu9UtYoHP4PB8yWxGTebk3JBl8q7xRLuNs7tB9CmxmhaYX2uAFcXOYE9tlcmCE4W4gnEhGBsShns2cCl0b7IPYQ8o4wJKK6HEAs-euzekAcKnlF_i0ozTpOTTR7U2PZeUHf2BIQ3MrXK52GpxpePczd19DiRRZx2LzrdAPTdtDj1wAawlU-Pq_DKJF8I8elGcD9INb8aEcGYw");
