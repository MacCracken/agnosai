    return str_from("eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJhdWQiOiJhZ25vc2FpIiwiZXhwIjoyMDAwMDAwMDAwMDAwMDAwMDAwMCwiaWF0IjowLCJpc3MiOiJ0ZXN0LWlzc3VlciIsInN1YiI6InVzZXItMTIzIn0.0_xaku3FTCyxsCGSxt0oJ-fq5HgXD5VwWPIYc32DTgMlWv9aIWJ6JZK57D3O489zZH5EUalk0Mu3HbvYfIsIia0WuhkhPsulSLVvY-vSuSnYVwdSypCBfCYLUtPnU2Az0iB0iViro4T8jJuxy230b-ZceUIWwoRCetIqIVvjZxt_V3hqaNR18Sfvpc0s8OB-p13LCajJ5UK01wR1djXNOeQkr1-7ru52Q-Ho22-q-nPf4v_C6OsGAleos9aGk2TspMFJzGev9m7e3_u7dMEiPzJVfLh_hbPR4RoipkihD_nA7tUNDLuLQ0XJs92ToxRzRprz-8xEfgQnNvVe3GbEDg");
}

