#!/usr/bin/env bash
# pre-commit — refuse to commit a path-shaped cyrius.lock.
#
# ## Why
#
# CI's "Lockfile is honest" step compares the committed lock against a clean
# tag-only resolution. Locally the `path = "../NAME"` overrides win, so ANY
# `cyrius deps` / `cyrius build` / `cyrius tests` rewrites the lock with **zero
# commit pins** — and committing that breaks CI.
#
# That has now happened three times, each time because a full-suite run sat
# between `./scripts/lock-refresh.sh` and `git commit`. Documentation did not
# prevent it; this does.
#
# ## Enable
#
#     git config core.hooksPath scripts/hooks
#
# Opt-in, and repo-local. To bypass once (you almost never want to):
#
#     git commit --no-verify
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
LOCK="$REPO_ROOT/cyrius.lock"

# Only care when the commit actually touches the lock.
git diff --cached --name-only | grep -qx 'cyrius.lock' || exit 0

PINS="$(grep -c '^commit' "$LOCK" 2>/dev/null || true)"
if [ "${PINS:-0}" -eq 0 ]; then
    cat >&2 <<'MSG'
✗ cyrius.lock has NO commit pins — CI will reject it.

It was produced with the `path = "../NAME"` sibling overrides in effect. Any
`cyrius deps`, `cyrius build` or `cyrius tests` does that, so a full-suite run
after a refresh silently undoes it.

Fix, with nothing else building:

    ./scripts/lock-refresh.sh && git add cyrius.lock

Then commit again. (`git commit --no-verify` bypasses this, and you will spend
the next twenty minutes wondering why CI is red.)
MSG
    exit 1
fi

# The staged blob is what actually lands — check that, not just the worktree.
STAGED_PINS="$(git show :cyrius.lock | grep -c '^commit' || true)"
if [ "${STAGED_PINS:-0}" -eq 0 ]; then
    echo "✗ The STAGED cyrius.lock has no commit pins (the worktree one does)." >&2
    echo "  Run: git add cyrius.lock" >&2
    exit 1
fi

echo "cyrius.lock: ${STAGED_PINS} commit pins ✓"
