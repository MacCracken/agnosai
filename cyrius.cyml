[package]
name = "agnosai"
version = "${file:VERSION}"
description = "AgnosAI — provider-agnostic AI orchestration: crews, tasks, tools, agent delegation"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/agnosai"
language = "cyrius"
cyrius = "6.5.21"

[build]
entry = "src/main.cyr"
output = "build/agnosai"

[deps]
stdlib = [
    "syscalls", "alloc", "result", "tagged", "fmt", "io", "fs", "str", "string",
    "vec", "slice", "args", "process", "assert", "bench",
    "fnptr", "freelist", "hashmap", "hashmap_fast", "callback", "chrono", "math", "regex",
    "unicode",
    "bayan",
    "patra",
    "atomic", "sync", "thread", "thread_local", "ct", "keccak", "random", "sha1",
    "mmap", "dynlib", "fdlopen",
    "async",
    "net", "http", "tls", "ws", "sakshi", "sandhi",
    "sankoch",
]

[deps.sigil]
git = "https://github.com/MacCracken/sigil.git"
tag = "3.12.7"
modules = ["dist/sigil.cyr"]

[deps.bote]
git = "https://github.com/MacCracken/bote.git"
path = "../bote"
tag = "3.3.1"
modules = ["dist/bote-core.cyr"]

[deps.majra]
git = "https://github.com/MacCracken/majra.git"
path = "../majra"
tag = "2.6.6"
modules = ["dist/majra.cyr"]

[deps.kavach]
git = "https://github.com/MacCracken/kavach.git"
path = "../kavach"
tag = "3.11.13"
modules = ["dist/kavach.cyr"]

[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel.git"
path = "../ai-hwaccel"
tag = "2.3.16"
modules = ["dist/ai-hwaccel.cyr"]

[deps.tyche]
git = "https://github.com/MacCracken/tyche.git"
path = "../tyche"
tag = "1.0.0"
modules = ["dist/tyche.cyr"]

[release]
bins = ["agnosai"]
cross_bins = ["agnosai-aarch64"]
