[package]
name = "agnosai"
version = "${file:VERSION}"
description = "AgnosAI — provider-agnostic AI orchestration: crews, tasks, tools, agent delegation"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/agnosai"
language = "cyrius"
cyrius = "6.5.11"

[build]
entry = "src/main.cyr"
output = "build/agnosai"

# Array order is the auto-include order and resolution is single-pass.
# Rationale and constraints: docs/development/cyrius-port-plan.md
[deps]
stdlib = [
    "syscalls", "alloc", "result", "tagged", "fmt", "io", "fs", "str", "string",
    "vec", "slice", "args", "process", "assert", "bench",
    "fnptr", "freelist", "hashmap", "hashmap_fast", "callback", "chrono", "math", "regex",
    "unicode",
    "bayan",
    "patra",
    "atomic", "sync", "thread", "thread_local", "ct", "keccak", "random", "sha1",
    "mmap", "dynlib", "fdlopen",
    "async",
    "net", "http", "tls", "ws", "sakshi", "sandhi",
]

[deps.sigil]
git = "https://github.com/MacCracken/sigil.git"
path = "../sigil"
# ⚠ 3.12.2, not 3.12.3, DELIBERATELY. sigil 3.12.3 fixes the RSA-verify auth
# bypass this tree works around in `src/server/auth.cyr`, but agnosai does not
# get sigil from this dep — `sigil.cyr` is FOLDED INTO the cyrius stdlib
# snapshot, and `lib sync --full` (which the bump procedure runs *after*
# `deps`) overwrites the git-dep copy with the fold. So this pin moves when a
# cyrius release folds 3.12.3, not when sigil tags it. Naming 3.12.3 here while
# `lib/sigil.cyr` holds 3.12.2 would be a pin that lies about what is built.
tag = "3.12.2"
modules = ["dist/sigil.cyr"]

[deps.bote]
git = "https://github.com/MacCracken/bote.git"
path = "../bote"
tag = "3.3.0"
modules = ["dist/bote-core.cyr"]

[deps.majra]
git = "https://github.com/MacCracken/majra.git"
path = "../majra"
tag = "2.5.3"
modules = ["dist/majra.cyr"]

[deps.kavach]
git = "https://github.com/MacCracken/kavach.git"
path = "../kavach"
tag = "3.11.7"
modules = ["dist/kavach.cyr"]

[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel.git"
path = "../ai-hwaccel"
tag = "2.3.16"
modules = ["dist/ai-hwaccel.cyr"]

[deps.tyche]
git = "https://github.com/MacCracken/tyche.git"
path = "../tyche"
tag = "1.0.0"
modules = ["dist/tyche.cyr"]

# sakshi is a **transitive** requirement, and pinning it here is defensive.
#
# `sakshi` is already in `[deps].stdlib` above, so `cyrius lib sync --full`
# provisions whatever the toolchain pin ships. But sigil and bote declare
# `[deps.sakshi]` in *their* manifests, and `cyrius deps` overlays that
# resolution on top of the snapshot — so a sibling pinned behind the toolchain
# silently **downgrades** `lib/sakshi.cyr`, on every `cyrius build`, not just on
# `deps`. The only signal is an unnamed "1 bundled lib(s) differ" shadow
# warning, and `deps --verify` cannot catch it because the lock is written
# *from disk* and simply records the downgraded file's hash.
#
# That is not hypothetical: under the 6.5.10 bump the tree built **2.4.7** while
# the pin shipped 2.4.8, which silently reverted the `i64::MIN` integer-format
# fix (`n = 0 - n` is a no-op at i64::MIN). sigil and bote are now on 2.4.8 too,
# so this pin is redundant *today* — it exists so the next sibling that lags
# cannot reintroduce the same silent downgrade. majra carries the identical pin
# for the identical reason; see the comment on its `[deps.sakshi]`.
#
# **Keep this in step with the toolchain's bundled sakshi on every pin bump.**
[deps.sakshi]
git = "https://github.com/MacCracken/sakshi.git"
tag = "2.4.8"
modules = ["dist/sakshi.cyr"]

[release]
bins = ["agnosai"]
cross_bins = ["agnosai-aarch64"]
