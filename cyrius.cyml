[package]
name = "agnosai"
version = "${file:VERSION}"
description = "AgnosAI — provider-agnostic AI orchestration: crews, tasks, tools, agent delegation"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/agnosai"
language = "cyrius"
cyrius = "6.5.32"

[build]
entry = "src/main.cyr"
output = "build/agnosai"

# `[lib]` exists so `cyrius distlib` knows what to concatenate into
# dist/agnosai.cyr for downstream consumers (Agnostic 2.0.1). Order is
# `src/main.cyr`'s include order FULLY EXPANDED through the nine `mod.cyr`
# hubs — critical for Cyrius single-pass forward-reference resolution.
#
# Each hub is listed AFTER its own leaves: no hub defines anything before
# its first `include`, so its trailing definitions must land last. Verified
# for all nine.
#
# `src/main.cyr` is deliberately ABSENT. Its final two lines
# (`var _agnosai_exit_code = main(); _agnosai_exit_process(...)`) are
# top-level statements that run at include time — a consumer linking them
# would start a server on include. Consumers call the orchestrator directly
# (`agnosai_orchestrator_submit_crew`) or stand up their own serve loop.
#
# `cyrius distlib` strips every `include` directive (both `lib/` and `src/`)
# from each bundled module and records the `lib/` leaves in the
# dist/agnosai.deps sidecar, so the hubs' own include lines are harmless.
#
#   cyrius distlib          -> dist/agnosai.cyr + dist/agnosai.deps
#   cyrius distlib --check  -> regenerate into a temp and byte-compare
[lib]
modules = [
    "src/units.cyr",
    "src/order.cyr",
    "src/id.cyr",
    "src/strcase.cyr",
    "src/arena_pool.cyr",
    "src/telemetry/genai.cyr",
    "src/telemetry/otlp.cyr",
    "src/telemetry/mod.cyr",
    "src/core/error.cyr",
    "src/core/json.cyr",
    "src/core/message.cyr",
    "src/core/resource.cyr",
    "src/core/task.cyr",
    "src/core/agent.cyr",
    "src/core/crew.cyr",
    "src/core/mod.cyr",
    "src/definitions/versioning.cyr",
    "src/definitions/assembler.cyr",
    "src/definitions/k8s_crd.cyr",
    "src/definitions/presets_data.cyr",
    "src/definitions/loader.cyr",
    "src/definitions/packaging.cyr",
    "src/definitions/mod.cyr",
    "src/learning/capability.cyr",
    "src/learning/optimizer.cyr",
    "src/learning/profile.cyr",
    "src/learning/replay.cyr",
    "src/learning/strategy.cyr",
    "src/learning/mod.cyr",
    "src/fleet/cost_planning.cyr",
    "src/fleet/registry.cyr",
    "src/fleet/placement.cyr",
    "src/fleet/gpu.cyr",
    "src/fleet/state.cyr",
    "src/fleet/environment.cyr",
    "src/fleet/relay.cyr",
    "src/fleet/discovery.cyr",
    "src/fleet/coordinator.cyr",
    "src/fleet/federation.cyr",
    "src/fleet/topology.cyr",
    "src/fleet/mod.cyr",
    "src/llm/router.cyr",
    "src/llm/retry.cyr",
    "src/llm/hoosh.cyr",
    "src/llm/inference_queue.cyr",
    "src/llm/mod.cyr",
    "src/server/ssrf.cyr",
    "src/server/prompt_guard.cyr",
    "src/server/output_filter.cyr",
    "src/server/prometheus.cyr",
    "src/server/auth.cyr",
    "src/guarded_fetch.cyr",
    "src/chan_lossy.cyr",
    "src/server/sse.cyr",
    "src/sandbox/policy.cyr",
    "src/sandbox/kavach_bridge.cyr",
    "src/sandbox/spawn.cyr",
    "src/sandbox/oci.cyr",
    "src/sandbox/process.cyr",
    "src/sandbox/python.cyr",
    "src/sandbox/cx.cyr",
    "src/sandbox/wasm.cyr",
    "src/sandbox/manager.cyr",
    "src/sandbox/mod.cyr",
    "src/tools/native.cyr",
    "src/tools/python_tool.cyr",
    "src/tools/wasm_tool.cyr",
    "src/tools/wasm_loader.cyr",
    "src/tools/registry.cyr",
    "src/tools/builtin/basic.cyr",
    "src/tools/builtin/load_testing.cyr",
    "src/tools/agnos.cyr",
    "src/tools/builtin/security_audit.cyr",
    "src/tools/builtin/synapse.cyr",
    "src/tools/builtin/mneme.cyr",
    "src/tools/builtin/delta.cyr",
    "src/tools/remote_registry.cyr",
    "src/tools/mod.cyr",
    "src/orchestrator/output_validation.cyr",
    "src/orchestrator/pubsub.cyr",
    "src/orchestrator/multi_tenant.cyr",
    "src/orchestrator/ipc.cyr",
    "src/orchestrator/scoring.cyr",
    "src/orchestrator/scheduler.cyr",
    "src/orchestrator/budget.cyr",
    "src/orchestrator/approval.cyr",
    "src/orchestrator/plan_cache.cyr",
    "src/orchestrator/memory.cyr",
    "src/orchestrator/hierarchical.cyr",
    "src/orchestrator/audit.cyr",
    "src/orchestrator/durable_state.cyr",
    "src/orchestrator/crew_runner.cyr",
    "src/orchestrator/orchestrator.cyr",
    "src/orchestrator/mod.cyr",
    "src/server/state.cyr",
    "src/tools/builtin/delegate.cyr",
    "src/server/routes/mod.cyr",
    "src/server/routes/health.cyr",
    "src/server/routes/tools.cyr",
    "src/server/routes/definitions.cyr",
    "src/server/routes/agents.cyr",
    "src/server/routes/approval.cyr",
    "src/server/routes/dashboard.cyr",
    "src/server/routes/crews.cyr",
    "src/server/routes/a2a.cyr",
    "src/server/routes/mcp.cyr",
    "src/server/routes/sse.cyr",
    "src/server/hot_config.cyr",
    "src/server/rate_limit.cyr",
    "src/server/router.cyr",
    "src/server/serve.cyr",
]

[deps]
stdlib = [
    "syscalls", "alloc", "result", "tagged", "fmt", "io", "fs", "str", "string",
    "vec", "slice", "args", "process", "assert", "bench",
    "fnptr", "freelist", "hashmap", "hashmap_fast", "callback", "chrono", "math", "regex",
    "unicode",
    "bayan",
    "patra",
    "atomic", "sync", "thread", "thread_local", "ct", "keccak", "random", "sha1",
    "mmap", "dynlib", "fdlopen",
    "async",
    "net", "http", "tls", "ws", "sakshi", "sandhi",
    "sankoch",
]

[deps.sigil]
git = "https://github.com/MacCracken/sigil.git"
tag = "3.12.9"
modules = ["dist/sigil.cyr"]

[deps.bote]
git = "https://github.com/MacCracken/bote.git"
path = "../bote"
tag = "3.3.2"
modules = ["dist/bote-core.cyr"]

[deps.majra]
git = "https://github.com/MacCracken/majra.git"
path = "../majra"
tag = "2.6.7"
modules = ["dist/majra.cyr"]

[deps.kavach]
git = "https://github.com/MacCracken/kavach.git"
path = "../kavach"
tag = "3.11.15"
modules = ["dist/kavach.cyr"]

[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel.git"
path = "../ai-hwaccel"
tag = "2.3.18"
modules = ["dist/ai-hwaccel.cyr"]

[deps.tyche]
git = "https://github.com/MacCracken/tyche.git"
path = "../tyche"
tag = "1.0.1"
modules = ["dist/tyche.cyr"]

[release]
bins = ["agnosai"]
cross_bins = ["agnosai-aarch64"]
