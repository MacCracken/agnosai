[package]
name = "agnosai"
version = "${file:VERSION}"
description = "AgnosAI — provider-agnostic AI orchestration: crews, tasks, tools, agent delegation"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/agnosai"
language = "cyrius"
cyrius = "6.5.18"

[build]
entry = "src/main.cyr"
output = "build/agnosai"

# Array order is the auto-include order and resolution is single-pass.
# Rationale and constraints: docs/development/cyrius-port-plan.md
[deps]
stdlib = [
    "syscalls", "alloc", "result", "tagged", "fmt", "io", "fs", "str", "string",
    "vec", "slice", "args", "process", "assert", "bench",
    "fnptr", "freelist", "hashmap", "hashmap_fast", "callback", "chrono", "math", "regex",
    "unicode",
    "bayan",
    "patra",
    "atomic", "sync", "thread", "thread_local", "ct", "keccak", "random", "sha1",
    "mmap", "dynlib", "fdlopen",
    "async",
    "net", "http", "tls", "ws", "sakshi", "sandhi",
    "sankoch",
]

[deps.sigil]
git = "https://github.com/MacCracken/sigil.git"
path = "../sigil"
# 3.12.7 — what cyrius 6.5.18 folds, verified: `lib/sigil.cyr` reports
# `# Version: 3.12.7`. ⚠ agnosai does NOT get sigil from this dep — `sigil.cyr`
# is FOLDED INTO the cyrius stdlib snapshot, and `lib sync --full` (which the
# bump procedure runs *after* `deps`) overwrites the git-dep copy with the fold.
# So this pin tracks the fold, not sigil's tags: bumping it alone changes
# nothing, and naming a version the fold does not carry would be a pin that
# lies about what is built.
tag = "3.12.7"
modules = ["dist/sigil.cyr"]

[deps.bote]
git = "https://github.com/MacCracken/bote.git"
path = "../bote"
tag = "3.3.0"
modules = ["dist/bote-core.cyr"]

[deps.majra]
git = "https://github.com/MacCracken/majra.git"
path = "../majra"
# 2.6.1 fixes a **concurrent-`relay_receive` allocator race**: the result struct
# was allocated with `fl_alloc` *after* the mutex was released, and `fl_alloc` is
# not thread-safe, so two threads could be handed the same block. agnosai does
# not call `relay_receive` from more than one thread today, but bote does, and
# 2.6.1 also drops majra's `[deps.sakshi]` — see the sakshi note below.
tag = "2.6.1"
modules = ["dist/majra.cyr"]

[deps.kavach]
git = "https://github.com/MacCracken/kavach.git"
path = "../kavach"
# 3.11.9 is the WASM backend `src/sandbox/wasm.cyr` runs on: `confine_capture_input`
# (stdin as a third pipe) and `backend_is_available(Backend.WASM)`. ADR 019.
tag = "3.11.9"
modules = ["dist/kavach.cyr"]

[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel.git"
path = "../ai-hwaccel"
tag = "2.3.16"
modules = ["dist/ai-hwaccel.cyr"]

[deps.tyche]
git = "https://github.com/MacCracken/tyche.git"
path = "../tyche"
tag = "1.0.0"
modules = ["dist/tyche.cyr"]

# sakshi is a **transitive** requirement, and pinning it here is defensive.
#
# `sakshi` is already in `[deps].stdlib` above, so `cyrius lib sync --full`
# provisions whatever the toolchain pin ships. But sigil and bote declare
# `[deps.sakshi]` in *their* manifests, and `cyrius deps` overlays that
# resolution on top of the snapshot — so a sibling pinned behind the toolchain
# silently **downgrades** `lib/sakshi.cyr`, on every `cyrius build`, not just on
# `deps`. The only signal is an unnamed "1 bundled lib(s) differ" shadow
# warning, and `deps --verify` cannot catch it because the lock is written
# *from disk* and simply records the downgraded file's hash.
#
# That is not hypothetical: under the 6.5.10 bump the tree built **2.4.7** while
# the pin shipped 2.4.8, which silently reverted the `i64::MIN` integer-format
# fix (`n = 0 - n` is a no-op at i64::MIN).
#
# ⚠ **Still load-bearing, and the sibling that makes it so is BOTE.**
# Two of the three overlaying siblings have since dropped their `[deps.sakshi]`:
# **sigil at 3.12.7** (sakshi is folded into the stdlib now, so the git dep was
# downgrading every sigil consumer) and **majra at 2.6.1**. The one that still
# declares it is **bote 3.3.0, at sakshi 2.4.7** — verified by
# `git show 3.3.0:cyrius.cyml`, and bote's working tree, which `path = "../bote"`
# makes the live resolution here, says 2.4.8. Either way it is behind the
# snapshot's 2.4.10. Remove this pin and the tree silently builds bote's sakshi.
#
# ⚠ Re-verify the sibling by reading its manifest, not by trusting this line. It
# named "sigil and bote", then "majra 2.6.0", and was **wrong at the 6.5.18 bump**
# — it had written bote off on the strength of one of the two having dropped the
# dep. `grep -l '^\[deps\.sakshi\]' ../*/cyrius.cyml` is the whole check.
#
# ⚠ **The lib-snapshot gate can flap depending on whether a build ran since the
# last sync, and that is this pin's doing.** Observed on the 6.5.15 bump:
# `cyrius lib sync --full` writes the snapshot's sakshi into `lib/` and
# `check-clean` passes; the very next `cyrius build` performs an implicit
# resolve, overwrites `lib/sakshi.cyr` back to this tag, and `check-clean`
# fails. Neither result is wrong — the *built* artifact is always this tag. Do
# not "fix" the flap by re-syncing before the gate; that hides which sakshi the
# binary contains.
#
# ✅ **No flap as of 6.5.18**, because this tag and the snapshot are both 2.4.10:
# the overlay rewrites the same bytes. It returns the moment they diverge, which
# is the next time the toolchain moves sakshi and this pin does not.
#
# ✅ **The 2.4.9 hook change is done.** This note used to say the pin was itself
# the laggard at 2.4.8 while the snapshot shipped 2.4.9, and that bumping it had
# to land together with `_agnosai_telemetry_json_hook` — because on 2.4.9+ a hook
# ignoring the new sixth argument silently drops every `key=value` from the JSON
# rather than merely failing to structure it. Both shipped together; the tag is
# 2.4.10 and matches the 6.5.18 snapshot.
#
# **Keep this in step with the toolchain's bundled sakshi on every pin bump.**
[deps.sakshi]
git = "https://github.com/MacCracken/sakshi.git"
tag = "2.4.10"
modules = ["dist/sakshi.cyr"]

[release]
bins = ["agnosai"]
cross_bins = ["agnosai-aarch64"]
