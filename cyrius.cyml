[package]
name = "agnosai"
version = "${file:VERSION}"
description = "AgnosAI — provider-agnostic AI orchestration: crews, tasks, tools, agent delegation"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/agnosai"
language = "cyrius"
cyrius = "6.5.19"

[build]
entry = "src/main.cyr"
output = "build/agnosai"

# Array order is the auto-include order and resolution is single-pass.
# Rationale and constraints: docs/development/cyrius-port-plan.md
[deps]
stdlib = [
    "syscalls", "alloc", "result", "tagged", "fmt", "io", "fs", "str", "string",
    "vec", "slice", "args", "process", "assert", "bench",
    "fnptr", "freelist", "hashmap", "hashmap_fast", "callback", "chrono", "math", "regex",
    "unicode",
    "bayan",
    "patra",
    "atomic", "sync", "thread", "thread_local", "ct", "keccak", "random", "sha1",
    "mmap", "dynlib", "fdlopen",
    "async",
    "net", "http", "tls", "ws", "sakshi", "sandhi",
    "sankoch",
]

[deps.sigil]
git = "https://github.com/MacCracken/sigil.git"
path = "../sigil"
# 3.12.7 — what cyrius 6.5.19 folds, verified: `lib/sigil.cyr` reports
# `# Version: 3.12.7`. ⚠ agnosai does NOT get sigil from this dep — `sigil.cyr`
# is FOLDED INTO the cyrius stdlib snapshot, and `lib sync --full` (which the
# bump procedure runs *after* `deps`) overwrites the git-dep copy with the fold.
# So this pin tracks the fold, not sigil's tags: bumping it alone changes
# nothing, and naming a version the fold does not carry would be a pin that
# lies about what is built.
tag = "3.12.7"
modules = ["dist/sigil.cyr"]

[deps.bote]
git = "https://github.com/MacCracken/bote.git"
path = "../bote"
tag = "3.3.1"
modules = ["dist/bote-core.cyr"]

[deps.majra]
git = "https://github.com/MacCracken/majra.git"
path = "../majra"
# 2.6.2 fixes the priority queue twice over, both reported from here:
#
#   * **`pq_dequeue` was O(n) per pop**, so draining was O(n²) — it popped with
#     `vec_remove(tier, 0)`, which shifts every survivor. Now a read index per
#     tier, amortised O(1): **198.70 µs → 33 ns** at 200,000 deep, flat across a
#     100× range. `src/llm/inference_queue.cyr` drains through `cpq_dequeue`, and
#     the whole point of that module is that background work is ALLOWED to pile
#     up behind interactive work — so the deep-tier path is the design case.
#   * **`pq_enqueue` clamped over-range priorities but not negatives**, so a −1
#     reached `load64(pq + pri * 8)` — an OOB read before the struct, then a push
#     through the result. `agnosai_map_priority` is exactly the compute-a-priority
#     shape that could reach it; its ladder never emits one, which is why the
#     module header says the ladder IS the bounds check.
#
# 2.6.3 retires the `relay_receive` allocator workaround: 2.6.1 had pulled a
# 16-byte `fl_alloc` INSIDE the relay's critical section because `fl_alloc` was
# not thread-safe, and cyrius 6.5.19 fixes that properly, so the allocation moves
# back outside a lock that is held across a subscriber-list walk. 2.6.1 also
# dropped majra's own `[deps.sakshi]` — see the sakshi note below.
tag = "2.6.3"
modules = ["dist/majra.cyr"]

[deps.kavach]
git = "https://github.com/MacCracken/kavach.git"
path = "../kavach"
# 3.11.10 makes the WASM backend actually RUN. 3.11.9 gave it stdin, an exit code
# and stderr (`confine_capture_input`) plus `backend_is_available(Backend.WASM)`
# — but its argv was rejected by wasmtime outright:
#
#     error: unexpected argument '--max-memory-size' found
#
# `--max-memory-size` and `--fuel` were emitted as top-level `wasmtime run`
# flags; both live in wasmtime's `-W` group. ⚠ **Never a version skew — the
# spelling was never valid**, and `-W` has existed since wasmtime 14 (2023). It
# survived because nothing had run a real module: kavach's two WASM tests both
# fail before argv is assembled, and the backend was unreachable through the
# public API until 3.11.8. ADR 019.
tag = "3.11.10"
modules = ["dist/kavach.cyr"]

[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel.git"
path = "../ai-hwaccel"
tag = "2.3.16"
modules = ["dist/ai-hwaccel.cyr"]

[deps.tyche]
git = "https://github.com/MacCracken/tyche.git"
path = "../tyche"
tag = "1.0.0"
modules = ["dist/tyche.cyr"]

# ✅ **`[deps.sakshi]` is GONE (2026-08-12), after several releases as a
# defensive pin. Verified by measurement, not by reasoning: removed, full
# three-step, then `cyrius build` — `lib/sakshi.cyr` stays at the snapshot's
# 2.4.10 and `lib/` diffs clean. The check that matters is AFTER A BUILD; the
# three-step alone was never the failure mode.**
#
# The mechanism it guarded against is real and unchanged: `sakshi` is in
# `[deps].stdlib` above, so `lib sync --full` provisions whatever the toolchain
# folds — but `cyrius deps` overlays a git dep's resolution ON TOP of the
# snapshot, recursing through SIBLING manifests, on every `cyrius build` and not
# only on `deps`. A sibling pinned behind the toolchain therefore downgrades
# `lib/sakshi.cyr` silently. The only signal is an unnamed "1 bundled lib(s)
# differ" shadow warning, and `deps --verify` cannot catch it because the lock is
# written *from disk* and records the downgraded file's hash. Not hypothetical:
# under the 6.5.10 bump the tree built 2.4.7 while the pin shipped 2.4.8,
# silently reverting sakshi's `i64::MIN` integer-format fix.
#
# ⚠ **What actually changed is that the guard MOVED, not that the hazard did.**
# The real source was never a direct sibling — it is four links down:
#
#     agnosai -> bote -> [deps.libro] 2.8.4 -> [deps.patra] 1.12.12
#             -> [deps.sakshi] 2.4.2
#
# **patra is itself FOLDED INTO the cyrius stdlib** (`lib/patra.cyr`, v1.12.12 in
# the 6.5.19 snapshot) while carrying a git dep on a sakshi eight patch releases
# behind the sakshi that same snapshot ships. **bote 3.3.1 now pins sakshi
# forward at 2.4.10 to absorb it**, which is what makes this block removable
# here. That pin is documented at length in bote's manifest and should be deleted
# the moment patra is fixed and re-folded — at which point nothing in this chain
# needs a pin at all.
#
# ⚠ **So agnosai's correctness here now depends on bote's pin.** That is an
# acceptable trade only because the regression is DETECTED rather than trusted:
# `scripts/check-clean.sh` diffs `lib/` against the toolchain snapshot and fails
# on any drift, and CI runs it. If `lib/sakshi.cyr` ever moves off the snapshot
# again, that gate is what catches it — re-derive the chain with
# `grep -l '^\[deps\.sakshi\]' ../*/cyrius.cyml` and follow it DOWN, not just
# one level.
#
# ⚠ **Do not re-derive this note from one level of manifests.** Its predecessor
# was wrong twice for exactly that reason: it named "sigil and bote", then
# "majra 2.6.0", and at the 6.5.18 bump had written bote off on the strength of
# one of two siblings having dropped the dep. Sixteen repos in this workspace
# pin `[deps.sakshi]`, spanning 2.3.0 to 2.4.10.

[release]
bins = ["agnosai"]
cross_bins = ["agnosai-aarch64"]
